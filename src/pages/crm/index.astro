	@media (max-width: 860px) {
		.proof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (max-width: 480px) {
		.proof-grid { grid-template-columns: 1fr; }
	}

	/* ── 3. PROBLEM to OUTCOME ───────────────────────────── */
	.outcomes { padding: var(--space-2xl) 0; }
	.outcome-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-md);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.outcome-card {
		padding: var(--space-md);
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
	}
	.outcome-problem {
		position: relative;
		margin: 0 0 0.75rem;
		padding-left: 1.6rem;
		font-size: 0.92rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}
	.outcome-problem::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.9rem;
		height: 1px;
		background: var(--color-text-muted);
	}
	.outcome-answer {
		position: relative;
		margin: 0;
		padding-left: 1.6rem;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.75;
		color: var(--color-text);
	}
	.outcome-answer::before {
		content: '\2192';
		position: absolute;
		left: 0;
		top: 0;
		color: var(--color-primary);
		font-weight: 700;
	}
	@media (max-width: 720px) {
		.outcome-grid { grid-template-columns: 1fr; }
	}

	/* ── 3b. AI ──────────────────────────────────────────── */
	.ai-lead {
		max-width: 46rem;
		margin: 0 0 var(--space-lg);
		font-size: 1.05rem;
		line-height: 1.95;
		color: var(--color-text);
	}
	.ai-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
	}
	.ai-card {
		min-width: 0;
		padding: 1.35rem var(--space-md) 1.35rem 0;
		border-bottom: 1px solid var(--color-border);
	}
	.ai-card:nth-child(3n + 2),
	.ai-card:nth-child(3n + 3) {
		padding-left: var(--space-md);
		border-left: 1px solid var(--color-border);
	}
	.ai-act {
		display: block;
		margin-bottom: 0.6rem;
		font-size: 1.02rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}
	.ai-act::before {
		content: '';
		display: block;
		width: 1.75rem;
		height: 2px;
		margin-bottom: 0.7rem;
		background: var(--color-primary);
	}
	.ai-card p {
		margin: 0;
		font-size: 0.925rem;
		line-height: 1.85;
		color: var(--color-text-muted);
	}
	.ai-note {
		margin: var(--space-lg) 0 0;
		font-size: 0.82rem;
		line-height: 1.9;
		color: var(--color-text-muted);
	}
	@media (max-width: 860px) {
		.ai-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.ai-card:nth-child(3n + 2),
		.ai-card:nth-child(3n + 3) {
			padding-left: 0;
			border-left: 0;
		}
		.ai-card:nth-child(even) {
			padding-left: var(--space-md);
			border-left: 1px solid var(--color-border);
		}
	}
	@media (max-width: 560px) {
		.ai-grid { grid-template-columns: 1fr; }
		.ai-card,
		.ai-card:nth-child(even) {
			padding-left: 0;
			padding-right: 0;
			border-left: 0;
		}
	}

	/* ── 3c. SECURITY ────────────────────────────────────── */
	.safe-list {
		margin: 0;
		border-top: 1px solid var(--color-border);
	}
	.safe-row {
		display: grid;
		grid-template-columns: 14rem minmax(0, 1fr);
		gap: var(--space-md);
		padding: 1.15rem 0;
		border-bottom: 1px solid var(--color-border);
		align-items: baseline;
	}
	.safe-row dt {
		margin: 0;
		font-size: 0.975rem;
		font-weight: 700;
		color: var(--color-text);
	}
	.safe-row dd {
		margin: 0;
		font-size: 0.925rem;
		line-height: 1.85;
		color: var(--color-text-muted);
	}
	.safe-note {
		margin: var(--space-lg) 0 0;
		font-size: 0.82rem;
		line-height: 1.9;
		color: var(--color-text-muted);
	}
	.safe-note a {
		color: var(--color-primary);
		text-decoration: none;
		font-weight: 600;
	}
	.safe-note a:hover { text-decoration: underline; }
	@media (max-width: 720px) {
		.safe-row { grid-template-columns: 1fr; gap: 0.4rem; }
	}

	/* ── 7. PRICING ──────────────────────────────────────── */
	.pricing {
		padding: var(--space-2xl) 0;
		background: #fff;
		border-top: 1px solid var(--color-border);
	}
	.price-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr)) 1.4fr;
		gap: var(--space-md);
		align-items: stretch;
	}
	.price-card {
		padding: var(--space-md);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-bg);
	}
	.price-tier {
		margin: 0 0 0.5rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--color-primary);
	}
	.price-figure {
		margin: 0;
		font-size: clamp(1.8rem, 3.2vw, 2.4rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.price-yen { font-size: 0.6em; margin-right: 0.1em; }
	.price-unit {
		margin-left: 0.4em;
		font-size: 0.42em;
		font-weight: 500;
		color: var(--color-text-muted);
	}
	.price-note {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.75rem;
		padding: var(--space-md);
		border-left: 2px solid var(--color-border);
	}
	.price-note p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.8;
		color: var(--color-text-muted);
	}
	@media (max-width: 860px) {
		.price-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.price-note { grid-column: 1 / -1; border-left: 0; border-top: 1px solid var(--color-border); padding-left: 0; }
	}
	@media (max-width: 480px) {
		.price-grid { grid-template-columns: 1fr; }
	}

	/* ── 10. FAQ ─────────────────────────────────────────── */
	.faq-more { margin-top: 1.5rem; text-align: center; font-size: 0.925rem; }
	.faq-more a { color: var(--accent, #1f6f4a); text-decoration: none; font-weight: 600; }
	.faq-more a:hover { text-decoration: underline; }
	.faq { padding: var(--space-2xl) 0; }
	.faq-list { margin: 0; }
	.faq-item {
		padding: var(--space-md) 0;
		border-top: 1px solid var(--color-border);
	}
	.faq-item:last-child { border-bottom: 1px solid var(--color-border); }
	.faq-item dt {
		margin: 0 0 0.5rem;
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.7;
	}
	.faq-item dd {
		margin: 0;
		max-width: 60em;
		font-size: 0.95rem;
		line-height: 1.9;
		color: var(--color-text-muted);
	}

	/* ── 11. FINAL CTA ───────────────────────────────────── */
	.cta-head { max-width: 44em; margin-bottom: var(--space-lg); }
	.cta-head p {
		margin: 0;
		line-height: 1.9;
		color: var(--color-text-muted);
	}
	.cta-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-md);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.cta-card {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: var(--space-md);
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
	}
	.cta-card h3 { margin: 0; font-size: 1rem; }
	.cta-card p {
		margin: 0 0 auto;
		padding-bottom: var(--space-sm);
		font-size: 0.9rem;
		line-height: 1.75;
		color: var(--color-text-muted);
	}
	.cta-card .btn { width: 100%; }
	@media (max-width: 800px) {
		.cta-grid { grid-template-columns: 1fr; }
	}

	/* ── hero note ───────────────────────────────────────── */
	.hero-note {
		margin: var(--space-sm) 0 0;
		font-size: 0.85rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	/* ── SmartHR型の情報設計に合わせた表示調整 ─────────────── */
	h1,
	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		font-size: 2rem;
		font-weight: 600;
		line-height: 1.42;
	}

	.crm-hero,
	.product-view,
	.proof,
	.features,
	.outcomes,
	.editions,
	.ai,
	.safeguards,
	.media-proof,
	.pricing,
	.fit,
	.resources,
	.faq,
	.beta {
		padding: 5.25rem 0;
	}

	.crm-hero {
		padding-top: 6rem;
		background: linear-gradient(180deg, #f7f8fb 0%, #fff 78%);
	}

	.hero-grid {
		grid-template-columns: minmax(0, 1.2fr) minmax(340px, 0.8fr);
		gap: var(--space-lg);
		align-items: center;
	}

