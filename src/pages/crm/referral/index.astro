---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrmSubnav from '../../../components/CrmSubnav.astro';
import PartnerForm, { type PartnerField } from '../../../components/PartnerForm.astro';

// 紹介パートナー制度（Revenue CRMを契約していない紹介者向け・報酬は銀行振込）。
// 契約中のお客さま向けの「紹介プログラム」（利用料金から差し引く）とは別の制度。
// あちらは /crm/pricing/ と src/data/crm-faq.ts に書いてある。率と期間（20%・12ヶ月）は揃えている。
// 受け口は Revenue CRM の Consilegy合同会社の組織に作ったフォーム「紹介パートナー申込」。
const FORM_ID = '5cb8761e-094f-4ead-962d-d34fd4c6f26b';
// 1段目はメールアドレスだけ。フォーム「紹介パートナー登録（メールのみ）」。送信を配信同意として記録し、
// ワークフローがリスト「紹介パートナー」に入れる（制度のお知らせはこのリストに送る）。
const SIGNUP_FORM_ID = '92a9d771-1196-4fb1-a839-7d769bca43cf';
const signupFields: PartnerField[] = [
	{ key: 'email', label: 'メールアドレス', type: 'email', required: true, auto: 'email' },
];

// 「こんな会社、身近にありませんか」。左は紹介する人が思い浮かべる状況、右はそこで変わること。
// 右側は各製品ページに書いてあることだけを書く（新しい機能や約束を作らない）。
const fit = [
	{ who: '営業の記録や報告に、時間を取られている会社', change: '商談メモは貼るだけ、録音は上げるだけ。記録の下書きはAIが作り、人は確かめて保存します。' },
	{ who: '顧客管理が、Excelやスプレッドシートのままの会社', change: '顧客・商談・タスクを、一つの顧客データで管理できます。' },
	{ who: 'CRMを入れたのに、誰も入力しなくなった会社', change: '名刺は撮るだけ。入力の手間そのものを減らすので、続けやすくなります。' },
	{ who: '見積・稼働・納品を、Excelで追っている受託開発の会社', change: '受託開発版なら、案件・見積・稼働・納品を1か所で見て、空きから逆算して見積を出せます。' },
	{ who: '生徒の管理を、LINEとスプレッドシートで回している教室・スクール', change: 'スクール版なら、生徒とのやりとりは公式LINEのまま。課題はLINEで届き、生徒ごとに自動で残ります。' },
];

const promises = [
	'製品の知識は要りません。',
	'営業やクロージングも要りません。',
	'紹介先の同意がない限り、こちらから連絡はしません。',
	'紹介先に無理な営業はしません。合わない会社には、合わないと正直に伝えます。',
];

// 報酬の試算。各社ユーザープラン5人（月額15,000円・税抜）が12ヶ月続いた場合。
const scale = [1, 3, 5, 10].map((n) => ({ n, monthly: 3000 * n, total: 36000 * n }));
const yen = (v: number) => v.toLocaleString('ja-JP');

const steps = [
	{ title: '登録する', text: 'メールアドレスを登録し、続けてお名前と報酬の受け取り方を入力します。紹介文や資料をまとめた紹介キットをご案内します。' },
	{ title: '紹介する', text: '紹介文を転送し、紹介先の同意を得たうえで紹介フォームに登録します。3営業日以内に、対象になるかどうかをお知らせします。その後の説明と商談は当社が行います。' },
	{ title: '報酬を受け取る', text: '紹介先が30日間の無料期間を経て有料契約を始めたら、毎月の入金ごとに報酬を確定し、月末締め・翌月末に振り込みます。' },
];

const reward = [
	{ label: '報酬', text: ['紹介先の基本プランの月額利用料金（税抜・実際にお支払いいただいた額）の20%です。', '報酬額は消費税を含みます。'] },
	{ label: '期間', text: ['紹介先が有料契約を始めてから12ヶ月間です。'] },
	{ label: '対象のプラン', text: ['ユーザープランと生徒数プランです。', 'プリペイドプラン、追加の燃料、オプション、導入・定着・運用の支援は対象外です。'] },
	{ label: 'お支払い', text: ['月末締め・翌月末に、ご指定の口座へ銀行振込でお支払いします。', '振込手数料は、報酬から差し引きます。', 'その月の報酬が3,000円に満たない場合は翌月以降に繰り越し、3,000円以上になった月にまとめてお支払いします。', '振込先は、申込フォームで「受け取る」を選ぶと登録できます。変更はメールでご連絡ください。','請求書を作っていただく必要はありません。当社から支払通知書をお送りします。'] },
	{ label: '紹介の有効期間', text: ['受理から90日以内に初回の商談（または無料期間の開始）に至った場合に、紹介した方を確定します。', 'その後12ヶ月以内に有料契約が始まれば、報酬の対象です。'] },
	{ label: '受け取らない選択', text: ['報酬を受け取らない、という選択もできます。申込時にお選びください。'] },
];

const rules = [
	'報酬の対象は、当社が受理した紹介だけです。紹介先のご担当者が、紹介してくださった方を通じた当社からの連絡に応じた時点で受理します。',
	'当社がすでに接点を持っている会社は、対象外です。確認の連絡の際にお知らせします。',
	'同じ会社を複数の方が紹介した場合は、先に受理した方の紹介とします。',
	'紹介先の役員・従業員とそのご家族は、報酬の対象外です。',
	'報酬を紹介先と分け合うこと、当社の了承なく値引きを約束することはできません。',
	'士業・コンサルタントなど、紹介先から報酬を受けて助言する立場の方は、紹介先に報酬があることをお伝えください。紹介キットに開示文のひな形があります。',
	'紹介してくださった方に、当社を代理して契約を結ぶ権限はありません。',
	'SNSやブログで紹介する場合は、「広告」「PR」など、報酬を受けていることが分かる表示を入れてください。',
	'紹介先の情報は、紹介先の同意を得てから登録してください。当社は、商談のご案内以外の目的に使いません。',
	'紹介先の契約が取り消された場合、取り消しに対応する報酬は、次回以降の報酬と相殺します。',
	'反社会的勢力との関係がないこと、紹介を通じて知った情報を外に出さないことを、お互いに約束します。',
];

const faq = [
	{
		q: 'Revenue CRMを使っていなくても申し込めますか。',
		a: 'はい。この制度は、Revenue CRMを契約していない方のためのものです。すでにお使いの会社には、紹介した会社の利用料金の20%を自社の利用料金から差し引く紹介プログラムがあります（料金ページをご覧ください）。',
	},
	{
		q: '紹介先には、何を伝えればよいですか。',
		a: '紹介キットの紹介文をそのまま転送していただければ十分です。製品の説明や料金のご質問には、当社がお答えします。',
	},
	{
		q: '成約しなかった場合はどうなりますか。',
		a: '報酬は発生しません。費用もかかりません。',
	},
	{
		q: 'インボイスの登録をしていなくても申し込めますか。',
		a: 'はい。登録の有無は申込時に伺い、支払通知書の記載に使います。',
	},
];

const fields: PartnerField[] = [
	{ key: 'last_name', label: '姓', type: 'text', required: true, auto: 'family-name', half: true },
	{ key: 'first_name', label: '名', type: 'text', required: true, auto: 'given-name', half: true },
	{ key: 'company_name', label: '会社名・屋号', type: 'text', required: false, auto: 'organization', help: '個人の方は空欄で構いません。' },
	{ key: 'email', label: 'メールアドレス', type: 'email', required: true, auto: 'email' },
	{ key: 'phone', label: '電話番号', type: 'tel', required: false, auto: 'tel' },
	{ key: 'partner_audience', label: '紹介できそうな業界・相手', type: 'textarea', required: false, help: '例：顧問先の製造業、知り合いのスクール経営者など。' },
	{ key: 'partner_payout', label: '報酬の受け取り', type: 'select', required: true, options: ['受け取る', '受け取らない'] },
	{ key: 'partner_bank_name', label: '振込先の銀行名', type: 'text', required: true, half: true, showIf: { key: 'partner_payout', value: '受け取る' } },
	{ key: 'partner_bank_branch', label: '支店名', type: 'text', required: true, half: true, showIf: { key: 'partner_payout', value: '受け取る' } },
	{ key: 'partner_account_type', label: '口座の種類', type: 'select', required: true, options: ['普通', '当座'], half: true, showIf: { key: 'partner_payout', value: '受け取る' } },
	{ key: 'partner_account_number', label: '口座番号', type: 'text', required: true, half: true, showIf: { key: 'partner_payout', value: '受け取る' } },
	{ key: 'partner_account_holder', label: '口座名義（カナ）', type: 'text', required: true, help: '通帳やキャッシュカードの表記どおりにご記入ください。', showIf: { key: 'partner_payout', value: '受け取る' } },
	{ key: 'partner_invoice', label: 'インボイス（適格請求書発行事業者）の登録', type: 'select', required: true, options: ['登録している', '登録していない'] },
	{ key: 'partner_invoice_number', label: '登録番号', type: 'text', required: false, help: '登録している方だけご記入ください（T＋13桁）。', half: true },
	{ key: 'partner_terms', label: 'このページの「紹介の決まり」に同意します。', type: 'checkbox', required: true },
];
---

<BaseLayout
	title="紹介パートナー制度 | Revenue CRM | Consilegy"
	description="Revenue CRMを紹介してくださる方のための制度です。紹介文を転送していただければ、その後の説明と商談は当社が行います。紹介先が有料契約を始めてから12ヶ月間、月額利用料金の20%を銀行振込でお支払いします。"
	lang="ja"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/crm/"},
		{"@type": "ListItem", "position": 3, "name": "紹介パートナー制度", "item": "https://consilegy.com/crm/referral/"}
	]
})} />

<CrmSubnav lang="ja" />

<div class="rf-page">

<section class="rf-hero">
	<div class="container rf-hero-grid">
		<div class="rf-hero-copy">
			<p class="rf-eyebrow">
				<img src="/images/crm/logo/revenue-crm-logo-v3.svg" alt="" width="24" height="24" decoding="async" />
				Revenue CRM 紹介パートナー制度
			</p>
			<h1><span class="nb">「あの会社に教えて</span><span class="nb">あげたい」と</span><br /><span class="nb">思えるCRMです。</span></h1>
			<p class="rf-lead">Revenue CRMは、面倒な記録や管理をAIで減らすCRMです。あなたの紹介が、知り合いの会社の働き方を変えるきっかけになります。紹介先が有料契約を始めたら、月額利用料金の20%を12ヶ月間お支払いします。</p>
			<div class="rf-actions">
				<a href="#apply" class="btn btn--primary">紹介パートナーになる</a>
				<a href="#fit" class="btn btn--secondary">どんな会社に合うか見る</a>
			</div>
			<p class="rf-hero-note">申込は無料です。紹介先が契約しなかった場合も、費用はかかりません。</p>
		</div>
		<figure class="rf-hero-media">
			<div class="rf-shot">
				<img
					class="rf-shot-desktop"
					src="/images/crm/screen-dashboard-2026-09.webp"
					alt="Revenue CRMのダッシュボード。パイプライン総額、勝率、期限切れタスク、注目の商談を一画面に表示。"
					width="1600"
					height="1000"
					decoding="async"
					fetchpriority="high"
				/>
				<img
					class="rf-shot-phone"
					src="/images/crm/screen-mobile-deals-2026-09.webp"
					alt="スマートフォンで見たRevenue CRMの商談一覧。"
					width="390"
					height="844"
					decoding="async"
				/>
			</div>
			<figcaption>紹介していただくのは、この画面のCRMです。<a href="/crm/">製品ページを見る</a></figcaption>
		</figure>
	</div>
</section>

<section class="rf-section" id="fit">
	<div class="container">
		<h2>こんな会社、身近にありませんか。</h2>
		<div class="rf-fit">
			{fit.map((f) => (
				<div class="rf-fit-row">
					<p class="rf-fit-who">{f.who}</p>
					<p class="rf-fit-change">{f.change}</p>
				</div>
			))}
		</div>
		<p class="rf-fit-close">1社でも顔が浮かんだら、ぜひ紹介してください。<a href="/products/">画面を見る</a></p>
	</div>
</section>

<section class="rf-section">
	<div class="container rf-connect">
		<div>
			<h2>あなたがするのは、つなぐだけ。</h2>
			<p class="rf-connect-lead">紹介文はこちらで用意しています。転送していただいた後の説明・デモ・商談は、当社が行います。</p>
		</div>
		<div>
			<ul class="rf-promises">
				{promises.map((t) => <li>{t}</li>)}
			</ul>
			<p class="rf-connect-close">大切な人との信頼関係を守りながら紹介できるように、この仕組みにしています。</p>
		</div>
	</div>
</section>

<section class="rf-section" id="reward">
	<div class="container">
		<h2>報酬は、紹介先の月額利用料金の20%を12ヶ月間</h2>
		<div class="rf-scale-wrap">
			<table class="rf-scale">
				<thead>
					<tr><th scope="col">紹介して契約した会社</th><th scope="col">毎月の報酬</th><th scope="col">12ヶ月の合計</th></tr>
				</thead>
				<tbody>
					{scale.map((r) => (
						<tr><th scope="row">{r.n}社</th><td>{yen(r.monthly)}円</td><td><strong>{yen(r.total)}円</strong></td></tr>
					))}
				</tbody>
			</table>
		</div>
		<p class="rf-note">各社がユーザープラン5人（月額15,000円・税抜）を12ヶ月続けた場合の試算です。報酬は税込で、各社の有料契約開始から12ヶ月間です。</p>
		<table class="rf-table">
			<tbody>
				{reward.map((row) => (
					<tr>
						<th scope="row">{row.label}</th>
						<td>{row.text.map((line) => <p>{line}</p>)}</td>
					</tr>
				))}
			</tbody>
		</table>
		<p class="rf-note">料金の一覧は<a href="/crm/pricing/">料金ページ</a>にあります。</p>
	</div>
</section>

<section class="rf-section">
	<div class="container">
		<h2>登録から報酬まで、3ステップ</h2>
		<ol class="rf-steps">
			{steps.map((s, i) => (
				<li>
					<span class="rf-step-no">STEP {i + 1}</span>
					<h3>{s.title}</h3>
					<p>{s.text}</p>
				</li>
			))}
		</ol>
	</div>
</section>

<section class="rf-section" id="apply">
	<div class="container rf-narrow">
		<h2>紹介パートナーになる</h2>
		<p class="rf-sub">まずはメールアドレスだけ登録してください。続けて、お名前と報酬の受け取り方を伺います。</p>
		<div class="rf-form-panel">
			<PartnerForm
				formId={SIGNUP_FORM_ID}
				fields={signupFields}
				button="登録する"
				done="ご登録ありがとうございます。"
				consent
				notice="登録すると、紹介パートナー向けのお知らせ（制度の変更や、紹介に使える新しい資料など）をメールでお送りします。配信はいつでも停止できます。"
				next="apply-step2"
			/>
		</div>
		<div class="rf-form-panel rf-step2" id="apply-step2" hidden>
			<p class="rf-step2-head">登録しました。続けて、申込の内容を入力してください。</p>
			<PartnerForm
				formId={FORM_ID}
				fields={fields}
				button="申し込む"
				done="お申し込みありがとうございます。当社から確認のご連絡をします。紹介キットは次のページからお使いいただけます。"
				doneLink={{ href: '/crm/referral/kit/', label: '紹介キットを開く' }}
			/>
		</div>
	</div>
</section>

<section class="rf-section">
	<div class="container rf-narrow">
		<h2>よくあるご質問</h2>
		<dl class="rf-faq">
			{faq.map((item) => (
				<div>
					<dt>{item.q}</dt>
					<dd>{item.a}</dd>
				</div>
			))}
		</dl>
	</div>
</section>

<section class="rf-section" id="rules">
	<div class="container rf-narrow">
		<h2>紹介の決まり</h2>
		<p class="rf-sub">申し込む前にお読みください。</p>
		<ol class="rf-rules">
			{rules.map((r) => <li>{r}</li>)}
		</ol>
	</div>
</section>

</div>

</BaseLayout>

<style>
	:global(body:has(.rf-page)) { background: #fff; }
	.rf-page { background: #fff; }
	.rf-page h2 { margin: 0 0 var(--space-md); font-size: clamp(1.4rem, 2.6vw, 1.85rem); font-weight: 700; line-height: 1.45; color: var(--color-text); }
	.rf-page h3 { margin: 0 0 0.5rem; font-size: 1.05rem; line-height: 1.6; color: var(--color-text); }
	.rf-page p { color: var(--color-text); }

	.rf-hero { padding: var(--space-xl) 0 var(--space-xl); }
	.rf-hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: var(--space-xl); align-items: center; }
	.rf-eyebrow { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 var(--space-md); color: var(--color-primary); font-weight: 700; font-size: 0.9rem; }
	.rf-eyebrow img { width: 24px; height: 24px; border-radius: 5px; }
	.rf-hero h1 .nb { display: inline-block; }
	.rf-hero h1 { margin: 0; font-size: clamp(1.75rem, 2.7vw, 2.4rem); font-weight: 700; line-height: 1.35; letter-spacing: 0; color: var(--color-text); }
	.rf-lead { margin: var(--space-md) 0 0; font-size: 1.05rem; line-height: 1.95; max-width: 34em; }
	.rf-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--space-lg); }
	.rf-hero-note { margin: var(--space-sm) 0 0; font-size: 0.9rem; color: var(--color-text-muted) !important; }
	.rf-hero-media { margin: 0; min-width: 0; }
	.rf-shot { position: relative; padding: 0 0 2.5rem 0; }
	.rf-shot-desktop { display: block; width: 100%; height: auto; border: 1px solid var(--color-border); border-radius: 8px; box-shadow: 0 18px 40px rgba(28, 25, 23, 0.10); }
	.rf-shot-phone { position: absolute; right: -0.5rem; bottom: 0; width: 26%; height: auto; border: 6px solid #1C1917; border-radius: 20px; background: #fff; box-shadow: 0 14px 30px rgba(28, 25, 23, 0.18); }
	.rf-hero-media figcaption { margin-top: 0.75rem; font-size: 0.85rem; color: var(--color-text-muted); }
	.rf-hero-media figcaption a { color: var(--color-primary); margin-left: 0.4rem; }

	.rf-section { padding: var(--space-xl) 0; border-top: 1px solid var(--color-border); }
	.rf-narrow { max-width: 48rem; }
	.rf-sub { margin: calc(var(--space-md) * -0.6) 0 var(--space-md); color: var(--color-text-muted) !important; line-height: 1.8; }


	.rf-fit { border-top: 1px solid var(--color-border); }
	.rf-fit-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 0.5rem var(--space-lg); padding: 1.1rem 0; border-bottom: 1px solid var(--color-border); }
	.rf-fit-row p { margin: 0; line-height: 1.85; }
	.rf-fit-who { font-weight: 700; font-size: 1.05rem; }
