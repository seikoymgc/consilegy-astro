---
// 使い方メディアのヘッダー。タグライン → 名前 → ナビ（読者・カテゴリ）を中央揃えで。
// 会社サイトへの戻り口と言語切替は右上に小さく。
import { CATEGORIES, CATEGORY_ORDER, COPY, SEGMENTS, SEGMENT_ORDER, mediaPath, mediaRoot, type Lang, type Segment } from '../lib/crm-media';

interface Props { lang: Lang; alternateUrl: string }
const { lang, alternateUrl } = Astro.props;
const t = COPY[lang];
const path = Astro.url.pathname;
const root = mediaRoot(lang);
// 今いる読者。入口では b2b をカテゴリリンクの既定にする。
const currentSegment: Segment = SEGMENT_ORDER.find((s) => path.startsWith(mediaPath(lang, s))) ?? 'b2b';
const isCurrent = (href: string) => (path === href || (href !== root && path.startsWith(href)) ? 'page' : undefined);
---
<header class="mh">
  <div class="mh-top">
    <a class="mh-site" href={lang === 'ja' ? '/' : '/en/'}><img src="/images/common/consilegy-logo-2026b.svg" alt={t.backToSite} width="111" height="20" /></a>
    <span class="mh-sep" aria-hidden="true">/</span>
    <a class="mh-site" href={lang === 'ja' ? '/crm/' : '/en/crm/'}>{t.productPage}</a>
    <a class="mh-lang" href={alternateUrl} data-lang-switch data-target-lang={lang === 'ja' ? 'en' : 'ja'}>{lang === 'ja' ? 'EN' : '日本語'}</a>
  </div>
  <div class="mh-brand-row">
  <a class="mh-name" href={root} aria-current={isCurrent(root)}>
    <span class="mh-mark">Revenue CRM</span>
    <span class="mh-sub">{lang === 'ja' ? '使い方メディア' : 'Field Guide'}</span>
  </a>
  <p class="mh-tagline">{t.tagline}</p>
  </div>
  <nav class="mh-nav" aria-label={t.segmentLabel}>
    {SEGMENT_ORDER.map((s) => (
      <a href={mediaPath(lang, s)} aria-current={isCurrent(mediaPath(lang, s))}>{SEGMENTS[s][lang]}</a>
    ))}
    <span class="mh-nav-sep" aria-hidden="true"></span>
    {CATEGORY_ORDER.map((c) => (
      <a href={`${mediaPath(lang, currentSegment)}#${c}`}>{CATEGORIES[c][lang]}</a>
    ))}
  </nav>
</header>

<style>
  .mh { max-width:72rem; margin:0 auto; padding:0 1.25rem; border-bottom:1px solid var(--color-border); }
  .mh-top { display:flex; align-items:center; justify-content:flex-end; gap:.65rem; min-height:42px; font-size:.875rem; color:var(--color-text-muted); border-bottom:1px solid var(--color-border); }
  .mh-top img { display:block; width:111px; height:20px; }
  .mh-top a { color:inherit; text-decoration:none; } .mh-top a:hover { color:var(--color-primary); }
  .mh-top .mh-site:first-child { margin-right:auto; font-weight:700; color:var(--color-navy); }
  .mh-sep { display:none; } .mh-lang { margin-left:.5rem; font-weight:600; }
  .mh-brand-row { display:flex; justify-content:space-between; align-items:center; gap:2rem; padding:1.5rem 0; }
  .mh-name { display:flex; align-items:baseline; flex-wrap:wrap; gap:.4rem .8rem; text-decoration:none; color:var(--color-navy); }
  .mh-mark { font-size:1.7rem; line-height:1.2; font-weight:800; letter-spacing:-.045em; }
  .mh-sub { font-size:1rem; font-weight:600; letter-spacing:.02em; }
  .mh-tagline { max-width:22rem; margin:0; font-size:.875rem; line-height:1.6; color:var(--color-text-muted); }
  .mh-nav { display:flex; flex-wrap:wrap; align-items:center; gap:0 1.75rem; }
  .mh-nav a { padding:.85rem 0; text-decoration:none; color:var(--color-text-muted); font-size:.9375rem; font-weight:600; border-bottom:2px solid transparent; margin-bottom:-1px; }
  .mh-nav a:hover, .mh-nav a[aria-current='page'] { color:var(--color-primary); border-bottom-color:var(--color-primary); }
  .mh-nav-sep { width:1px; height:1rem; background:var(--color-border); }
  @media(max-width:700px) { .mh-brand-row { padding:1.25rem 0; } .mh-tagline { display:none; } .mh-mark { font-size:1.5rem; } .mh-sub { font-size:.875rem; } .mh-nav { gap:0 1rem; } .mh-nav a { font-size:.875rem; } .mh-nav-sep { display:block; flex-basis:100%; width:100%; height:0; } }

</style>
