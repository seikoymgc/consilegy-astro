---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CTA from '../../components/CTA.astro';
import { getCollection } from 'astro:content';

const cases = (await getCollection('caseStudies'))
	.filter((c) => c.data.lang === 'ja' && !c.data.draft)
	.sort((a, b) => (b.data.modified ?? '').localeCompare(a.data.modified ?? ''));
---

<BaseLayout
	title="導入事例 | Consilegy"
	description="症状・打ち手・結果の3段で整理した支援事例。医療テック・バックオフィスSaaS・グローバルDTC・新規AIプロダクト部門など、業種と規模を添えて掲載しています。"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "導入事例", "item": "https://consilegy.com/case-studies/"}
	]
})} />
	<PageHero
		eyebrow="Case Studies"
		title="導入事例"
		lede="どの事例も「症状 → 打ち手 → 結果」の順に整理しています。まず症状を読んで、自社と同じかどうかを確かめてください。"
	/>


	<section class="container cs-figure-wrap">
		<figure class="cs-figure" aria-labelledby="cs-figure-caption">
			<svg viewBox="0 0 1120 300" role="img" aria-label="3つの事例の結果。リードから商談への転換率が最大20%向上、データ業務の時間が約65%削減、3名の兼務チームで2ヶ月で仕組みを構築">
				<g font-family="inherit">
					<text x="40" y="34" font-size="14" fill="#64748b" letter-spacing="1.5">OUTCOMES</text>
					<rect x="40" y="56" width="330" height="220" rx="6" fill="#fff" stroke="#E2E8F0"/>
					<rect x="40" y="56" width="330" height="4" rx="2" fill="#8758C9"/>
					<text x="64" y="94" font-size="18" font-weight="600" fill="#0F172A">売上が伸びる</text>
					<text x="64" y="118" font-size="14" fill="#64748b">リードから商談への転換率</text>
					<text x="64" y="196" font-size="44" font-weight="700" fill="#7042ac">+20%<tspan font-size="16" font-weight="500" fill="#0F172A"> 最大</tspan></text>
					<text x="64" y="226" font-size="16" fill="#334155">見込み客の取りこぼしが減った</text>
					<text x="64" y="258" font-size="14" fill="#64748b">ITバックオフィスSaaS（約200名）</text>
					<rect x="395" y="56" width="330" height="220" rx="6" fill="#fff" stroke="#E2E8F0"/>
					<rect x="395" y="56" width="330" height="4" rx="2" fill="#8758C9"/>
					<text x="419" y="94" font-size="18" font-weight="600" fill="#0F172A">時間が戻る</text>
					<text x="419" y="118" font-size="14" fill="#64748b">データ管理・抽出にかかる時間</text>
					<text x="419" y="196" font-size="44" font-weight="700" fill="#7042ac">−65%<tspan font-size="16" font-weight="500" fill="#0F172A"> 約</tspan></text>
					<text x="419" y="226" font-size="16" fill="#334155">月に約100時間を創出</text>
					<text x="419" y="258" font-size="14" fill="#64748b">医療テック企業（約150名）</text>
					<rect x="750" y="56" width="330" height="220" rx="6" fill="#fff" stroke="#E2E8F0"/>
					<rect x="750" y="56" width="330" height="4" rx="2" fill="#8758C9"/>
					<text x="774" y="94" font-size="18" font-weight="600" fill="#0F172A">部門の摩擦が消える</text>
					<text x="774" y="118" font-size="14" fill="#64748b">仕組みができるまでの期間</text>
					<text x="774" y="196" font-size="44" font-weight="700" fill="#7042ac">2<tspan font-size="16" font-weight="500" fill="#0F172A"> ヶ月</tspan></text>
					<text x="774" y="226" font-size="16" fill="#334155">3名の兼務チームのまま構築</text>
					<text x="774" y="258" font-size="14" fill="#64748b">コンサル会社の新規AIプロダクト部門</text>
				</g>
			</svg>
			<figcaption id="cs-figure-caption">結果の一例。それぞれの症状と打ち手は、下の事例をご覧ください。</figcaption>
		</figure>
	</section>

	<section class="container case-list">
		{cases.map((c) => (
			<article class="cs-card">
				<header class="cs-card__head">
					<p class="cs-meta">
						{c.data.industry && <span class="cs-industry">{c.data.industry}</span>}
						{c.data.size && <span class="cs-size">{c.data.size}</span>}
					</p>
					<h2 class="cs-title">
						<a href={`/case-studies/${c.data.slug}/`}>{c.data.title}</a>
					</h2>
				</header>

				{c.data.symptom ? (
					<dl class="cs-stages">
						<div class="cs-stage cs-stage--symptom">
							<dt>症状</dt>
							<dd>{c.data.symptom}</dd>
						</div>
						<div class="cs-stage">
							<dt>打ち手</dt>
							<dd>{c.data.action}</dd>
						</div>
						<div class="cs-stage cs-stage--result">
							<dt>結果</dt>
							<dd>{c.data.result}</dd>
						</div>
					</dl>
				) : (
					<p class="cs-desc">{c.data.description}</p>
				)}

				<a class="cs-link" href={`/case-studies/${c.data.slug}/`}>事例を読む →</a>
			</article>
		))}
	</section>

	<CTA
		title="同じ症状かどうか、3分で確かめられます。"
		description="12〜14問・選択式。6つの「境目」のどこで売上を取りこぼしているかを可視化します。所要3分・無料。"
		href="/diagnostic/"
		label="収益を自己診断"
	/>
</BaseLayout>

<style>
	.case-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-lg);
		padding-block: var(--space-xl);
	}

	.cs-card {
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: var(--color-bg);
		padding: 2rem 2.25rem;
		transition: box-shadow 0.15s ease;
	}
	.cs-card:hover { box-shadow: var(--shadow-sm); }

	.cs-card__head { margin-bottom: 1.5rem; }

	.cs-meta {
		display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem;
		margin: 0 0 0.75rem;
	}
	.cs-industry {
		font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em;
		color: var(--color-primary); background: rgba(112,66,172,0.08);
		padding: 0.2rem 0.6rem; border-radius: 4px;
	}
	.cs-size { font-size: 0.75rem; color: var(--color-text-muted); }

	.cs-title { margin: 0; font-size: 1.1875rem; font-weight: 700; line-height: 1.55; }
	.cs-title a { color: var(--color-text); text-decoration: none; }
	.cs-title a:hover { color: var(--color-primary); }

	.cs-stages {
		margin: 0; display: flex; flex-direction: column;
		border-top: 1px solid var(--color-border);
	}
	.cs-stage {
		display: grid; grid-template-columns: 4.5rem 1fr; gap: 1.25rem;
		padding: 0.875rem 0; align-items: baseline;
		border-bottom: 1px solid var(--color-border);
	}
	.cs-stage dt {
		font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.1em;
		color: var(--color-text-muted);
	}
	.cs-stage dd { margin: 0; font-size: 0.9375rem; line-height: 1.75; color: var(--color-text-muted); }
	.cs-stage--symptom dd { color: var(--color-text); font-weight: 600; }
	.cs-stage--result dd { color: var(--color-primary); font-weight: 600; }

	.cs-desc { margin: 0; font-size: 0.9375rem; line-height: 1.8; color: var(--color-text-muted); }

	.cs-link {
		display: inline-block; margin-top: 1.25rem;
		font-size: 0.9375rem; font-weight: 700; color: var(--color-primary);
		text-decoration: none;
	}
	.cs-link:hover { text-decoration: underline; }

	@media (max-width: 640px) {
		.cs-card { padding: 1.5rem 1.375rem; }
		.cs-stage { grid-template-columns: 1fr; gap: 0.25rem; }
	}
.cs-figure-wrap { padding-top: var(--space-lg); }
.cs-figure { margin: 0; }
.cs-figure svg { display: block; width: 100%; height: auto; }
.cs-figure figcaption { margin-top: 0.75rem; font-size: 0.875rem; color: var(--color-text-muted); }
</style>
