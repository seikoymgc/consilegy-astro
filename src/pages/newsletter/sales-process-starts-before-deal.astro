---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = '案件化する前から、売上プロセスは始まっている';
const description = '営業と最初に会った時点で、買い手の85%はもう候補を絞り終えている。問い合わせから数え始める前の区間を、どう設計の対象にするか。';
const body = "<div style=\"margin:0;padding:0;background:#ffffff;\">\n<div style=\"max-width:600px;margin:0 auto;padding:32px 24px 40px;font-family:'IBM Plex Sans','Noto Sans JP','Hiragino Sans','Yu Gothic',system-ui,sans-serif;\">\n\n<p style=\"margin:0 0 24px;font-size:11px;font-weight:700;letter-spacing:.16em;color:#44403C;\">次世代B2Bレベニュー戦略バイブル</p>\n\n<h1 style=\"margin:0 0 28px;font-size:26px;line-height:1.55;font-weight:700;letter-spacing:.01em;color:#1C1917;\">案件化する前から、売上プロセスは始まっている</h1>\n\n<p style=\"margin:0 0 32px;\"><img src=\"https://kagzeeuqxeextyawoztb.supabase.co/storage/v1/object/public/guide-images/newsletter/nl02-ja-cover.png\" alt=\"案件化前も、売上プロセス。\" width=\"552\" style=\"width:100%;max-width:552px;height:auto;display:block;border-radius:6px;\"></p>\n\n<p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">営業と最初に会った時点で、買い手の85%はもう候補を絞り終えています。<br>そのうち29%は「ほぼ決まっている」［※1］。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">「問い合わせが来た時には、もう価格も事例も見られてるんですよね」</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">マーケティング担当者の方とよくこういうお話をします。数字が出るより先に、現場のほうが気づいていたことになります。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">ところが、売り手の側はたいてい問い合わせから数え始めます。<br>リードが入った日を起点に商談化率を見て受注率を見る。それより前は数字がないので見ていません。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">数字に映らないだけで売上プロセスはすでに始まっていて、見えていない区間は設計の対象から外れやすいままになります。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">前回、売上は部門の中ではなく境目で失われると書きました。<br>取りこぼしが起きる場所を6つに切り直して、そのうち3番目の商談ステージのズレを見ています。<br>今回はその6つよりさらに手前の話です。</p><p style=\"margin:28px 0;padding:18px 20px;background:#F5F5F4;border-radius:4px;font-size:17px;line-height:1.85;font-weight:700;letter-spacing:.01em;color:#1e40af;\">まだ案件がないのではなく、まだ見えていないだけです。</p><h2 style=\"margin:44px 0 18px;padding:0 0 0 14px;border-left:3px solid #1e40af;font-size:18px;line-height:1.6;font-weight:700;letter-spacing:.01em;color:#1C1917;\">先に要るのは、追うことではなく置くこと</h2><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">この区間を設計しようとすると、まず「見えるようにしよう」という話になりがちです。誰が何を見たかを追って、興味の強い人に次の材料を届ける。MAはその精度を上げるための有効な手段です。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">気持ちは分かります。見えないのは単純に不安ですから。<br>ただ、追跡より先にやることがあります。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">MAやアクセス解析で買い手の行動を見えるようにすることはできます。</p><p style=\"margin:28px 0;padding:18px 20px;background:#F5F5F4;border-radius:4px;font-size:17px;line-height:1.85;font-weight:700;letter-spacing:.01em;color:#1e40af;\">見えるようにすることと、買い手が判断できることは別です。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">価格も比較材料も事例も置いていない状態で行動だけを追ったところで、買い手の手元にある材料は増えないままです。<br>追いかけた先に何も置いていない会社は、実際にけっこうあります。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">だから順番はこうです。</p><p style=\"margin:28px 0;padding:18px 20px;background:#F5F5F4;border-radius:4px;font-size:17px;line-height:1.85;font-weight:700;letter-spacing:.01em;color:#1e40af;\">先に置く。見つけてもらう。それから行動を見て、当てにいく。</p><h2 style=\"margin:44px 0 18px;padding:0 0 0 14px;border-left:3px solid #1e40af;font-size:18px;line-height:1.6;font-weight:700;letter-spacing:.01em;color:#1C1917;\">何を置くか</h2><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">買い手が自分で意思決定するために必要なもので、大きく3つに分かれます。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">1つ目は買えるかどうかを判断する情報で、価格の考え方と導入条件、それに向いている会社と向いていない会社です。金額そのものを出せなくても、何で決まるかは書けます。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">2つ目は比べるための情報です。比較軸と、似た規模や業種の事例。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">3つ目は社内を通すための情報で、導入プロセスとそこにかかる自社側の工数、よくある質問、そして社内で説明するときに使える材料です。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">見落とされやすいのが3つ目。買い手は自分が納得しただけでは進めません。<br>上長や情報システム、購買、場合によっては役員にまで説明を通す必要があるからです。</p><p style=\"margin:28px 0;padding:18px 20px;background:#F5F5F4;border-radius:4px;font-size:17px;line-height:1.85;font-weight:700;letter-spacing:.01em;color:#1e40af;\">買い手本人を説得するだけでは足りない。買い手が社内を説得できる材料まで用意する。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">営業が商談で毎回説明していることは、たいていこの中にあります。<br>同じ話を何十回もしているなら、それはもう1本書けるということです。<br>それを一度だけ、買い手が自分で読める場所に置いておく。</p><h2 style=\"margin:44px 0 18px;padding:0 0 0 14px;border-left:3px solid #1e40af;font-size:18px;line-height:1.6;font-weight:700;letter-spacing:.01em;color:#1C1917;\">置きたくても、出せない会社がある</h2><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">ここまではやることが分かれば済む話に見えますが、たいていそこで止まってしまいます。<br>出すまでに時間がかかるからです。<br>苦しい工程だと思います。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">昨年、あるグローバルブランドではキャンペーンページ1本の公開に数週間かかっていました。<br>コンテンツがないのではなく、軽微な修正にも開発工程が必要だったからです。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">CMSとテンプレート、運用フローを組み直してマーケター自身で公開できるようにした結果、企画から公開までのリードタイムは約70〜80%短縮しました。<br>いまは即日から数営業日で出ています。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">B2Bの会社ではありませんが、ここで起きていたことは同じです。</p><p style=\"margin:28px 0;padding:18px 20px;background:#F5F5F4;border-radius:4px;font-size:17px;line-height:1.85;font-weight:700;letter-spacing:.01em;color:#1e40af;\">何を置くべきか決めても、出せなければ、買い手には存在しないのと同じです。</p><h2 style=\"margin:44px 0 18px;padding:0 0 0 14px;border-left:3px solid #1e40af;font-size:18px;line-height:1.6;font-weight:700;letter-spacing:.01em;color:#1C1917;\">見るべきは、公開までのリードタイム</h2><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">この工程で最初に見るべき数字は公開までのリードタイムです。<br>10日かかったコンテンツに10日分の作業があるとは限りません。<br>実作業は2日で、残りの8日は開発待ちかもしれない。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">だから見るのは公開リードタイムと、その中の待ち時間です。<br>短縮余地が大きいのは作業時間より待ち時間のほうになります。</p><h2 style=\"margin:44px 0 18px;padding:0 0 0 14px;border-left:3px solid #1e40af;font-size:18px;line-height:1.6;font-weight:700;letter-spacing:.01em;color:#1C1917;\">今週できること</h2><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">前回は失注案件を10件開いてみてくださいと書きましたが、今回はこちら。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\"><strong>直近に公開したコンテンツを3本選んで、3つ書き出してください。</strong></p><ul style=\"margin:0 0 20px;padding-left:20px;\"><li style=\"margin:0 0 10px;font-size:16px;line-height:1.9;letter-spacing:.02em;color:#1C1917;\">企画から公開まで、何日かかったか。</li><li style=\"margin:0 0 10px;font-size:16px;line-height:1.9;letter-spacing:.02em;color:#1C1917;\">そのうち、待っていた日が何日か。</li><li style=\"margin:0 0 10px;font-size:16px;line-height:1.9;letter-spacing:.02em;color:#1C1917;\">誰を、何を待っていたか。</li></ul><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">1本だと偶然に左右されるので、3本並べてください。<br>開発待ちなのか確認待ちなのか外注待ちなのか。<br>同じところで止まっているかどうかが見えてくるはずです。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">（結果がばらけてしまう場合は、本数を少し増やしてください）</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">そこが最初に見直す場所です。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">この区間の仕事は正直に言って地味で、派手な打ち手とも縁がありません。<br>私はこういう工程が好きです。ここが動くと後ろが軽くなるからです。</p><h2 style=\"margin:44px 0 18px;padding:0 0 0 14px;border-left:3px solid #1e40af;font-size:18px;line-height:1.6;font-weight:700;letter-spacing:.01em;color:#1C1917;\">次回：比較段階で、何が効くか</h2><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">今回は買い手が一人で調べている時間を見ました。次回は候補を絞り込む段階の話です。</p><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">機能差だけでは選びにくくなるほど「自社でも同じ成果を再現できるか」が判断材料になるので、似た規模や業種の事例が効いてきます。次回はそこから始めます。</p><hr style=\"border:0;border-top:1px solid #E7E5E4;margin:36px 0 36px;\"><p style=\"margin:0 0 20px;font-size:16px;line-height:2.0;letter-spacing:.02em;color:#1C1917;\">今回の手前の区間は、この診断には入っていません。<br>入っているのは問い合わせが来てからの6つの境目です。<br>3本並べてみて、詰まっているのがそこだけではなさそうなら、試してみてください！</p><div style=\"margin:24px 0 0;\"><p style=\"margin:0 0 8px;\"><a href=\"https://consilegy.com/diagnostic/\" style=\"display:inline-block;background:#1e40af;color:#ffffff;padding:15px 30px;border-radius:4px;text-decoration:none;font-size:16px;font-weight:700;letter-spacing:.02em;\">売上の取りこぼし診断</a></p><p style=\"margin:0 0 12px;font-size:13px;line-height:1.85;color:#44403C;\">無料。3分ほどで終わります。</p></div><hr style=\"border:0;border-top:1px solid #E7E5E4;margin:32px 0 20px;\"><p style=\"margin:0 0 12px;font-size:13px;line-height:1.85;color:#44403C;\">出典：<br>※1 ワンマーケティング「顧客企業の商品購入プロセスに関する調査（2025年度）」2025年9月30日〜10月1日調査。全国の経営者・役員・購買/契約担当者600名。営業担当者との初回面談時に「ほぼ決まっている」29%、「いくつかの候補に絞り込まれている」56%。</p>\n\n<div style=\"margin:40px 0 0;padding:24px;border:1px solid #E7E5E4;border-radius:6px;background:#ffffff;\"><p style=\"margin:0 0 16px;font-size:11px;font-weight:700;letter-spacing:.14em;color:#44403C;\">Consilegy について</p><p style=\"margin:0px 0 4px;font-size:15px;font-weight:700;line-height:1.6;\"><a href=\"https://consilegy.com/contact/\" style=\"color:#1e40af;text-decoration:none;\">ご相談・お問い合わせ &rarr;</a></p><p style=\"margin:0;font-size:13px;line-height:1.75;color:#44403C;\">収益設計、CRM/RevOpsの導入と定着について</p><p style=\"margin:18px 0 4px;font-size:15px;font-weight:700;line-height:1.6;\"><a href=\"https://consilegy.com/crm/\" style=\"color:#1e40af;text-decoration:none;\">Revenue CRM &rarr;</a></p><p style=\"margin:0;font-size:13px;line-height:1.75;color:#44403C;\">AIが入力を肩代わりするCRM。2026年9月28日 正式リリース</p></div>\n\n</div>\n</div>\n";
const schema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	datePublished: '2026-09-17',
	inLanguage: 'ja',
	author: { '@type': 'Person', name: '山口聖子' },
	publisher: { '@type': 'Organization', name: 'Consilegy合同会社' },
	mainEntityOfPage: 'https://consilegy.com/newsletter/sales-process-starts-before-deal/',
};
---

<BaseLayout title={`${title} | 次世代B2Bレベニュー戦略バイブル`} description={description} lang="ja" ogType="article">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
	</Fragment>
	<div class="nl-issue" style="padding:40px 0 64px;" set:html={body} />
	<p style="text-align:center;margin:0 0 64px;font-size:14px;"><a href="/newsletter/">&larr; バックナンバー一覧へ</a></p>
</BaseLayout>
