---
import JournalArticle from '../components/JournalArticle.astro';
import { eyecatchPath } from '../data/eyecatch.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { categories } from '../content.config';

export async function getStaticPaths() {
	const notes = await getCollection('notes', ({ data }) => !data.draft);
	const enIds = new Set((await getCollection('notesEn', ({ data }) => !data.draft)).map(n => n.id));
	return notes.map(note => ({
		params: { slug: note.id },
		props: { note, hasEn: enIds.has(note.id) },
	}));
}

const { note, hasEn } = Astro.props;
const { Content, headings } = await render(note);
const d = note.data;
const toc = headings.filter(h => h.depth === 2);

const all = (await getCollection('notes', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const related = all.filter(n => n.id !== note.id && n.data.category === d.category).slice(0, 3);

const formatDate = (date: Date) =>
	`${date.getFullYear()}年${date.getMonth() + 1}月${date.getDate()}日`;
---

<BaseLayout
	title={d.title.length > 44 ? d.title : `${d.title} | B2Bレベニュー戦略ジャーナル`}
	headline={d.title}
	description={d.description}
	ogType="article"
	publishedAt={d.publishedAt}
	updatedAt={d.updatedAt}
	ogImage={eyecatchPath(note.id, 'jpg')}
	section={categories[d.category]}
	jaPath={hasEn ? `/${note.id}/` : undefined}
	enPath={hasEn ? `/en/articles/${note.id}/` : undefined}
	breadcrumbs={[
		{ name: 'ホーム', url: '/' },
		{ name: '記事一覧', url: '/articles/' },
		{ name: categories[d.category], url: `/category/${d.category}/` },
		{ name: d.title },
	]}
>
	<JournalArticle note={note} headings={toc} related={related} lang="ja">
		<Content />
	</JournalArticle>
</BaseLayout>
