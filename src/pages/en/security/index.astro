---
import BaseLayout from '../../../layouts/BaseLayout.astro';

// English trust page for overseas buyers. Same facts as /security/ (checked against
// production settings and code on 2026-10-22), written for the questions overseas
// security reviews ask: certifications, data residency, cross-border transfers,
// subprocessors, GDPR, vulnerability reporting.
// Never imply that Consilegy itself holds SOC 2 / ISO 27001. Only the infrastructure
// providers do (Vercel: SOC 2 Type 2 + ISO 27001:2022, Supabase: SOC 2 Type 2).
// Items we do not offer (SAML/OIDC SSO, SLA, third-party pentest) are answered in the
// questionnaire, not listed on the page (same rule as the Japanese page).
const asOf = 'October 2026';
const questionnaireHref = '/downloads/consilegy-security-questionnaire-en-2026-10b.xlsx';

const assurance = [
	{ label: 'Information Security Policy', text: 'Our policy sets out management responsibility, organization, safeguards, customer information, training, compliance, incident response, and continual improvement.', link: { href: '/en/security-policy/', text: 'Read the policy' } },
	{ label: 'SECURITY ACTION (two stars)', text: 'A self-declaration program run by IPA, Japan’s Information-technology Promotion Agency. Two stars means we have run IPA’s self-assessment and published an information security policy. It is a self-declaration, not a third-party certification.' },
	{ label: 'CSA STAR Level 1 (self-assessment)', text: 'We have completed the Cloud Security Alliance (CSA) Consensus Assessments Initiative Questionnaire (CAIQ) for Revenue CRM, and our answers are published in the CSA STAR Registry (October 2026). Level 1 is a self-assessment, not a third-party audit or certification.', link: { href: 'https://cloudsecurityalliance.org/star/registry/consilegy-llc', text: 'View our STAR Registry listing' } },
	{ label: 'Security program', text: 'Our internal security rules cover incident response, business continuity and recovery, secure development and change and vulnerability management, people, devices, suppliers and data, and the use of AI. They are reviewed at least once a year. We have run a restore test from backup, an incident-response tabletop exercise, and security training for staff, and we keep records of each.' },
	{ label: 'Infrastructure certifications', text: 'Revenue CRM runs on Vercel (SOC 2 Type 2, ISO 27001:2022) and Supabase (SOC 2 Type 2). These certifications belong to those providers, not to Consilegy.' },
];

const controls = [
	{ title: 'Data residency', text: 'The database, file storage, and application runtime are all in Japan (Tokyo region). Text, audio, or images you send to AI features are processed by US AI providers (Anthropic, OpenAI, Google), and email sent from the service is processed by a US provider (Resend). You can switch AI features to an AI provider your company contracts with directly.' },
	{ title: 'Encryption', text: 'All traffic is encrypted with TLS, and HSTS tells browsers to use encrypted connections only. Stored data and files are encrypted at rest (AES-256) by our infrastructure provider, Supabase. Credentials for connected services (access tokens and API keys) are additionally encrypted with AES-256 by the application. Revenue CRM API keys are stored as hashes.' },
	{ title: 'Tenant isolation', text: 'Each company’s data is isolated by row-level security (RLS) in the database. Server-side processes that run outside RLS are required to scope every query to the customer’s company, and automated checks verify this on every change. Missing RLS on new tables is also detected automatically.' },
	{ title: 'Access control', text: 'Roles (owner, admin, member), per-object permissions to view, create, edit, delete, and export, and visibility scopes (everyone, team, own records).' },
	{ title: 'Authentication', text: 'Sign in with an email address and password, or a Google account. Multi-factor authentication with authenticator-app codes and backup codes is supported. If a user loses their device, an admin in the same company can reset it. The sign-in page is protected against automated attacks.' },
	{ title: 'Audit logging', text: 'Creating, changing, and deleting contacts, companies, and deals, and every data export, are recorded with the user and time. Logs are kept for the term of the contract and admins can view them in Settings.' },
	{ title: 'Backups', text: 'The database is backed up automatically every day, with the last 7 days retained. Uploaded files are copied daily to a separate storage area, also kept for 7 days.' },
	{ title: 'AI and your data', text: 'Your data is never used, by us or by our AI providers, to train AI models. Our contracts with AI providers exclude training. Providers may retain submitted content for a limited period to monitor abuse.' },
	{ title: 'AI safeguards', text: 'Customer data and search results passed to AI are clearly separated from instructions, and text that tries to manipulate the AI is detected and logged. AI-generated content is labeled as such. Admins can turn off all AI features for their company. AI inputs and outputs are logged and deleted automatically after 90 days.' },
	{ title: 'Vulnerability management', text: 'Vulnerabilities in the third-party software components we use are detected automatically and updated. We also accept reports from security researchers (see below).' },
	{ title: 'Retention and deletion', text: 'For 30 days after the contract ends, you can export your data to CSV from Settings. After that, data in the live environment is deleted, and copies in backups are deleted when the 7-day retention period ends.' },
];

// From the subprocessor list in the Revenue CRM Terms of Service (Japanese), version of 2026-10-28.
const subprocessors = [
	{ name: 'Supabase Pte. Ltd.', purpose: 'Database and file storage', data: 'All customer data', where: 'Japan (Tokyo)', hq: 'Singapore' },
	{ name: 'Vercel Inc.', purpose: 'Application runtime', data: 'Customer data passing through for processing', where: 'Japan (Tokyo)', hq: 'United States' },
	{ name: 'Anthropic, PBC', purpose: 'AI features', data: 'Text sent to AI features', where: 'United States', hq: 'United States' },
	{ name: 'OpenAI OpCo, LLC', purpose: 'AI features, transcription, text embeddings', data: 'Text and audio sent to AI features', where: 'United States', hq: 'United States' },
	{ name: 'Google LLC', purpose: 'AI features, image reading', data: 'Text and images sent to AI features', where: 'United States', hq: 'United States' },
	{ name: 'Plus Five Five, Inc. (Resend)', purpose: 'Email sent from the service', data: 'Email body and recipients', where: 'United States', hq: 'United States' },
];
---

<BaseLayout
	title="Security | Consilegy"
	description="How Consilegy LLC and Revenue CRM protect customer data: certifications, data residency in Tokyo, encryption, tenant isolation, subprocessors, GDPR, and a security questionnaire you can download."
	lang="en"
>
	<header class="page-head container">
		<p class="page-head__eyebrow">Security</p>
		<h1 class="page-head__title">Security at Consilegy</h1>
		<p class="page-head__lead">How we protect the information you entrust to us, as of {asOf}. Answers to the questions security reviews usually ask are available to download, no sign-up required.</p>
		<p class="page-head__actions">
			<a class="btn btn--primary" href={questionnaireHref} download>Download the security questionnaire (spreadsheet)</a>
		</p>
	</header>

	<section class="band band--subtle">
		<div class="container">
			<p class="section-eyebrow">Assurance</p>
			<h2 class="section-title">Policies and certifications</h2>
			<div class="cards cards--2">
				{assurance.map(a => (
					<div class="card">
						<h3>{a.label}</h3>
						<p>{a.text}</p>
						{a.link && <p><a href={a.link.href}>{a.link.text}</a></p>}
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="band">
		<div class="container">
			<p class="section-eyebrow">Company</p>
			<h2 class="section-title">How we work</h2>
			<div class="cards cards--2">
				<div class="card">
					<h3>Internal practices</h3>
					<p>Two-factor authentication on the cloud services we use for work, a password manager with no reused passwords, least-privilege access, prompt removal of access when a contract ends, encrypted work devices with antivirus, customer data kept in the cloud rather than on personal devices, and confidentiality agreements and regular training for staff and contractors.</p>
				</div>
				<div class="card">
					<h3>Incident response</h3>
					<p>We follow a defined procedure: report, initial response, impact assessment, notification, and prevention of recurrence. Under the Revenue CRM Terms of Service, we notify customers no later than 3 business days after we learn of a leak or other incident involving personal information they entrust to us, and we support the reports and notices they need to make.</p>
				</div>
			</div>
		</div>
	</section>

	<section class="band band--subtle" id="revenue-crm">
		<div class="container">
			<p class="section-eyebrow">Revenue CRM</p>
			<h2 class="section-title">Product security</h2>
			<div class="cards cards--3">
				{controls.map(c => (
					<div class="card">
						<h3>{c.title}</h3>
						<p>{c.text}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="band" id="privacy">
		<div class="container narrow">
			<p class="section-eyebrow">Privacy</p>
			<h2 class="section-title">Data protection and cross-border transfers</h2>
			<p>We act as a processor for the customer data you store in Revenue CRM. Your data belongs to you, and we handle it only to provide, maintain, and support the service, to meet legal obligations, and to produce statistics that cannot identify individuals or customers.</p>
			<p>We comply with Japan’s Act on the Protection of Personal Information (APPI). The European Commission has recognized Japan as providing an adequate level of data protection, and your data is stored in Japan. Where data is processed by providers outside Japan (listed below), we confirm in our contracts with them: purpose limitation including no model training, encryption and access control, flow-down obligations to their own providers, breach notification, and deletion after processing.</p>
			<p>If your organization needs a data processing agreement (DPA), the EU Standard Contractual Clauses, or answers in your own format, contact us at <a href="mailto:info@consilegy.com">info@consilegy.com</a>.</p>
		</div>
	</section>

	<section class="band band--subtle" id="subprocessors">
		<div class="container">
			<p class="section-eyebrow">Subprocessors</p>
			<h2 class="section-title">Providers that handle customer data</h2>
			<div class="table-wrap">
				<table>
					<thead>
						<tr><th>Provider</th><th>Purpose</th><th>Data</th><th>Processing location</th><th>Headquarters</th></tr>
					</thead>
					<tbody>
						{subprocessors.map(s => (
							<tr><td>{s.name}</td><td>{s.purpose}</td><td>{s.data}</td><td>{s.where}</td><td>{s.hq}</td></tr>
						))}
					</tbody>
				</table>
			</div>
			<p class="note">Payment (Stripe, PayPal), sign-in bot protection (Cloudflare), and rate limiting against abuse (Upstash, processed in Tokyo; temporary counters deleted within 15 minutes) handle only our own billing and technical connection data, not the customer data you store. Integrations you connect yourself (Zoom, Google Meet, LINE) are governed by your own agreements with those providers. We give customers 30 days’ notice before changing this list, and customers who object may cancel. The binding list is in the <a href="https://crm.consilegy.com/terms">Revenue CRM Terms of Service</a> (in Japanese).</p>
		</div>
	</section>

	<section class="band" id="report">
		<div class="container narrow">
			<p class="section-eyebrow">Vulnerability Reporting</p>
			<h2 class="section-title">Report a security issue</h2>
			<p>If you believe you have found a vulnerability in our website or Revenue CRM, email <a href="mailto:info@consilegy.com">info@consilegy.com</a> with the details and steps to reproduce it. We will acknowledge your report and keep you updated. Please do not access or change other people’s data, and do not run tests that could degrade the service. Testing beyond this requires our written permission in advance.</p>
		</div>
	</section>

	<section class="band band--subtle">
		<div class="container narrow">
			<p class="section-eyebrow">Download</p>
			<h2 class="section-title">Security questionnaire</h2>
			<p>Ready-to-paste answers to the questions security reviews usually ask, covering organization, people, access, devices, data, Revenue CRM, and data protection (as of {asOf}). No sign-up required.</p>
			<p><a class="btn btn--primary" href={questionnaireHref} download>Download the questionnaire (spreadsheet)</a></p>
			<p class="note">For questions not covered here, or answers in your own format, contact <a href="mailto:info@consilegy.com">info@consilegy.com</a>. We reply in English or Japanese.</p>
		</div>
	</section>
</BaseLayout>

<style>
.page-head {
	padding-block: var(--space-2xl) var(--space-lg);
}
.page-head__eyebrow, .section-eyebrow {
	margin: 0 0 var(--space-xs);
	font-size: 0.875rem; font-weight: 700;
	letter-spacing: 0.12em; text-transform: uppercase;
	color: var(--color-navy);
}
.page-head__title {
	margin: 0 0 1rem;
	font-size: clamp(1.75rem, 3vw, 2.25rem);
	font-weight: 600; letter-spacing: 0.01em;
}
.page-head__lead { max-width: 720px; margin: 0 0 1.5rem; font-size: 1rem; line-height: 1.85; color: var(--color-text-muted); }
.page-head__actions { margin: 0; }

.band { padding-block: var(--space-xl); }
.band--subtle { background: var(--color-bg-subtle); }
.narrow > p, .narrow > ul { max-width: 720px; }
.section-title { margin: 0 0 1.5rem; font-size: 1.5rem; font-weight: 600; }

.cards { display: grid; gap: 1rem; }
.cards--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
@media (max-width: 900px) { .cards--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 640px) { .cards--2, .cards--3 { grid-template-columns: 1fr; } }
.card {
	background: #fff;
	border: 1px solid var(--color-border);
	border-radius: 6px;
	box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
	padding: 1.25rem 1.5rem;
}
.card h3 { margin: 0 0 0.5rem; font-size: 1.0625rem; font-weight: 600; }
.card p { margin: 0 0 0.5rem; font-size: 1rem; line-height: 1.8; color: var(--color-text); }
.card p:last-child { margin-bottom: 0; }
.card a { color: var(--color-primary); }

.table-wrap {
	overflow-x: auto;
	background: #fff;
	border: 1px solid var(--color-border);
	border-radius: 6px;
	box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
}
table { width: 100%; min-width: 720px; border-collapse: collapse; font-size: 1rem; }
th, td { padding: 0.75rem 1rem; text-align: left; vertical-align: top; border-bottom: 1px solid var(--color-border); line-height: 1.6; }
th { color: var(--color-navy); font-weight: 600; background: var(--color-bg-subtle); }
tbody tr:last-child td { border-bottom: none; }

.band p { font-size: 1rem; line-height: 1.85; }
.band a { color: var(--color-primary); }
.band .note { margin-top: 1.25rem; font-size: 0.875rem; color: var(--color-text-muted); }
</style>
