---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrmSubnav from '../../../components/CrmSubnav.astro';
import CrmSupport from '../../../components/CrmSupport.astro';
import '../../../styles/school-brand.css';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// プロダクトの school shell（edition=b2c + shell='school'）に実装済みの機能のみ記載。
const screens = [
	{ src: 'students', title: '生徒管理', desc: '体験・受講中・休止・卒業・退会を、生徒ごとの状態で一覧にします。', alt: '生徒管理の画面。受講中・体験予定・卒業間近・課題が滞り・未確認・休止・卒業生・退会のフィルタと、生徒ごとの状態バッジが並ぶ。' },
	{ src: 'schedule', title: '週間スケジュール', desc: '1週間のレッスンを、休校日と合わせて確認できます。予約は講師ごとのGoogleカレンダーにも入ります。', alt: 'スケジュールの画面。予定数と未記録レッスン数、日付ごとの時刻・生徒・担当講師の一覧。' },
	{ src: 'lessons', title: 'レッスン記録', desc: 'レッスンの内容を生徒ごとに残せます。講師が替わっても、前回の内容から始められます。', alt: 'レッスン履歴の画面。レッスン種別ごとの担当講師と、生徒名・担当講師・実施日の履歴が並ぶ。' },
	{ src: 'hearing-ai', title: 'ヒアリング', desc: '体験レッスンの文字起こしを貼ると、AIがカルテの項目に振り分けます。講師はあとから直せます。', alt: '生徒詳細の初回ヒアリング欄。きっかけ・基本情報・英語レベル・テスト会話の所見・3か月後の目標が並び、右上に「テスト会話から自動入力」ボタンがある。' },
	{ src: 'report', ver: 'v5', title: '月次レポート', desc: '直近30日のレッスン記録から、AIが月次レポートを下書きします。講師が確認して、LINEで送れます。', alt: '進捗レポートの画面。直近30日のレッスン記録からAIが下書きした生徒のコメントに、再生成・コピー・LINEで送るのボタンが付いている。' },
	{ src: 'knowledge', title: 'ナレッジベース', desc: 'Googleドライブの講師マニュアルや振替のルールを取り込めます。AIが答えるときの根拠にも使います。', alt: 'ナレッジベースの画面。週1レッスンの進め方、文法添削の返し方、休講・振替のルールなどの記事一覧。' },
	{ src: 'billing', title: '請求管理', desc: '月謝の支払い状況を生徒ごとに確認できます。振込や現金の入金も記録でき、未入金の生徒にはLINEで催促できます。', alt: '請求の画面。MRR・決済失敗・未入金の件数と、生徒ごとの課金ステータス一覧に課金中・未入金・決済失敗のバッジ。' },
];

const highlights = [
	{
		title: '課題の提出も予約も、生徒のLINEから届く',
		text: '生徒はアプリを入れずに、LINEのメニューから課題を出し、レッスンを予約します。課題は文字・写真・動画・音声で出せて、生徒ごとに残ります。予約はGoogleカレンダーに入ります。3営業日出ていない生徒がいると事務局にタスクができ、生徒への声かけも自動で送れます（送るかどうかは生徒ごとに決められます）。',
	},
	{
		title: '月謝の未入金が、一覧で分かる',
		text: '未入金の生徒がいると、システムが知らせます。講師はLINEで催促を送れます。',
	},
	{
		title: '月末のレポートと講師報酬を、まとめて出せる',
		text: 'AIが直近30日のレッスン記録から月次レポートを下書きし、講師が確認してLINEで送れます。講師の報酬も、実施済みのレッスンから月次で集計します。',
	},
];

// 痛みは J300 PRシート（2026-10）の「導入前」の記述から。
const problems = [
	{
		title: '生徒ごとのLINEグループで回している',
		text: '生徒が数十人いれば、LINEグループも数十個。課題の確認も予約の調整も、講師が1つずつ開いて対応している。',
	},
	{
		title: '連絡・予約・課題確認が、バラバラ',
		text: '連絡はLINE、予約はカレンダー、課題は既読で確認。レッスン前に、どこまで返したかをさかのぼって探している。',
	},
	{
		title: '新しい生徒の募集を、止めている',
		text: '体験の申し込みが来ても、受けきれない。運営だけで手一杯で、募集を止めている。',
	},
];

const proofStats = [
	{ figure: 'LINE連携', label: '課題も予約も、生徒のいつものLINEから届く' },
	{ figure: 'Googleカレンダー', label: '予約が講師ごとのカレンダーに自動で入る' },
	{ figure: 'ホーム', label: '今日のレッスンと要対応の生徒が並ぶ' },
	{ figure: '講師の人数', label: '何人増えても料金は同じ' },
];

// /crm/ の safeguards をもとに、スクール版の実装（src/school-app）に合わせて変えている。
// 削除操作が無い・AIはAnthropicのみ・書き出しはマネージャーだけ、など。
const safeguards = [
	{
		label: '学習に使われない',
		text: 'レポートの下書きやAIへの質問には、Anthropic社のAIを使っています。送った内容を学習に使わない条件で利用しています。',
	},
	{
		label: '他社に見えない',
		text: 'データはスクールごとに分けて保存しています。ほかのスクールのデータは表示されません。',
	},
	{
		label: '見せる範囲を決められる',
		text: '見られるデータと操作できる範囲を、役割ごとに決められます。変更の記録は監査ログに残ります。',
	},
	{
		label: '記録が消えない',
		text: '生徒・レッスン・タスクには削除の操作がありません。生徒は「退会」、タスクは「対応済み」にして残します。データは毎日バックアップしています。',
	},
	{
		label: '東京に置いてある',
		text: 'データは東京リージョンに保存しています。AIの処理のみ、Anthropic（米国）を経由します。',
	},
	{
		label: '持ち出しは自由',
		text: '生徒・レッスンの記録・課題の提出・請求は、マネージャーがCSVで書き出せます。契約終了後も30日間は書き出せます。',
	},
];

// 料金・人数・デモ・導入は src/data/crm-faq.ts の desc と同じ文面（変えるときは両方直す）。
// スマホとAIの2問は、スクール版に名刺・手書きの読み取りが無いため、スクール版専用の答えにしている。
const faqs = [
	{ q: '料金はいくらですか', a: '在籍中の生徒の人数で決まります。50人までが月額9,800円、100人までが19,800円、300人までが39,800円です。301人以上は個別にお見積りします。講師やスタッフは何人増えても料金は変わりません。どのプランも30日間の無料トライアル付きで、カード登録なしで始められます。' },
	{ q: '生徒の人数はどう数えますか', a: '在籍中の生徒だけを数えます。体験中・休会中・卒業した生徒・問い合わせ段階の見込み客は数に入りません。何人いても無料で管理していただけます。' },
	{ q: 'スマートフォンで使えますか', a: '使えます。スマートフォンで使う前提で作っています。ブラウザから開くので、アプリは不要です。' },
	{ q: 'AIに読ませたデータは学習に使われますか', a: '使われません。レポートの下書きやヒアリングの振り分けに使う外部のAI（Anthropic）は、学習に利用しない条件で使っています。' },
	{ q: 'デモを見るのに登録は必要ですか', a: 'メールアドレスだけです。パスワードの登録も審査もありません。' },
	{ q: '導入にどれくらいかかりますか', a: '申し込みから使い始めるまでは即日です。データを入れて運用に乗せるまでが本番です。' },
];

const roles = [
	{ name: 'マネージャー', scope: '生徒・月謝・権限の設定まで' },
	{ name: '管理部・一般', scope: '生徒と日々の事務' },
	{ name: '講師', scope: '担当の生徒のタスクと課題が届く' },
];
---

<BaseLayout
	title="Revenue CRMスクール版 | LINEのやり取りはそのままに、運営の手間を減らす。オンラインスクールの顧客管理システム"
	description="LINE公式アカウントとつながる、オンラインスクールの顧客管理システム。生徒はLINEから課題を出し、レッスンを予約できます。予約はGoogleカレンダーに入り、月次レポートはAIが下書きします。2026年9月28日に正式リリース。どのプランも30日間無料で試せます。"
	lang="ja"
	alternateUrl="/en/crm/school/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/crm/"},
		{"@type": "ListItem", "position": 3, "name": "スクール版", "item": "https://consilegy.com/crm/school/"}
	]
})} />

<link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&display=swap" />

<CrmSubnav lang="ja" />

<div class="school-brand">

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">
				<img class="eyebrow-mark" src="/images/crm/logo/revenue-crm-school-logo-orange.svg" alt="" width="26" height="26" decoding="async" />
				Revenue CRMスクール版
			</p>
			<h1><span class="nw">LINEのやり取りは</span><span class="nw">そのままに、</span><br /><span class="nw">運営の手間を</span><span class="nw">減らす。</span></h1>
			<p class="hero-lead">
				オンラインスクールのための顧客管理システムです。LINE公式アカウントとつなぐと、課題の確認と予約の受付が自動になります。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href={SIGNUP_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">無料で始める</a>
			</div>
			<p class="hero-download"><a href="/crm/school/download/">資料をダウンロード</a></p>
		</div>
		<figure class="hero-media">
			<img
				src="/videos/school-demo-v3.gif"
				alt="Revenue CRMスクール版の操作デモ。ホーム・生徒管理・生徒詳細・レッスン履歴・スケジュール・請求の画面を順に確認できる。"
				width="960"
				height="600"
				decoding="async"
			/>
			<figcaption>操作画面：ホーム・生徒管理・生徒詳細・レッスン履歴・スケジュール・請求</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== PROOF ===================== -->
<section class="proof">
	<div class="container">
		<ul class="proof-grid">
			{proofStats.map((item) => (
				<li>
					<strong>{item.figure}</strong>
					<span>{item.label}</span>
				</li>
			))}
		</ul>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">生徒とのやり取りも、<br />スクール運営も、ひとつに。</p>
			<div class="pos-copy">
				<p>予約・課題・レッスン記録・月謝を、講師全員が同じ画面で確認できます。ホームには、今日のレッスン、連絡が必要な生徒、確認待ちの課題が並びます。</p>
				<p>画面はスマートフォンで使う前提です。講師はレッスンの合間に、その場で記録を残せます。</p>
				<a href="/revenue-architecture/" class="pos-link">この考え方について読む →</a>
			</div>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Common Problems</p>
			<h2 class="prob-title">生徒ごとのLINEグループを、手作業で回している。</h2>
		</div>
		<div class="prob-grid">
			{problems.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`項目 ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>

		<figure class="prob-shot">
			<img
				src="/images/common/school-student-detail-v3.webp"
				alt="スクール版の生徒詳細画面。1画面に状態と受講回数、開始日・卒業予定、デイリーコールの進み具合が並ぶ。LINEで送る・レッスン記録・進捗レポートのボタンと、初回ヒアリングの内容も同じ画面にある。"
				width="1200"
				height="813"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>
				生徒1人ぶんの画面です。状態、デイリーコールの進み具合、初回ヒアリング、Zoomの記録を1画面で確認できます。
			</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== HIGHLIGHTS ===================== -->
<section class="problem highlights">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Features</p>
			<h2 class="prob-title">課題の確認、月謝の催促、月末のレポートをシステムで。</h2>
		</div>
		<div class="prob-grid">
			{highlights.map((item) => (
				<article class="prob-item">
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">The screens</p>
			<h2 class="sc-title">講師が毎日開く画面</h2>
		</div>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img
							src={`/images/crm/school/screen-${s.src}-${s.ver ?? 'v3'}.webp`}
							alt={s.alt}
							width="1200"
							height="750"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== SUPPORT ===================== -->
<section class="support">
	<div class="container">
		<figure class="flow-figure" aria-labelledby="flow-figure-caption">
			<svg class="fig-pc" viewBox="0 0 1120 316" role="img" aria-label="生徒の流れ：体験、入会、受講、継続か休会。LINEで予約・課題・催促が届く">
				<defs><marker id="sc-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<g font-family="inherit">
				<rect x="40" y="100" width="236" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><rect x="40" y="100" width="236" height="4" rx="2" fill="#FF5C3E"/><text x="58" y="134" font-size="14" fill="#64748b" letter-spacing="1">Trial</text><text x="58" y="164" font-size="18" font-weight="600" fill="#0F172A">体験</text>
<text x="58" y="226" font-size="16" fill="#475569">LINEから予約</text>
<line x1="276" y1="148" x2="308" y2="148" stroke="#0F172A" stroke-width="2" marker-end="url(#sc-arr)"/>
<rect x="312" y="100" width="236" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><rect x="312" y="100" width="236" height="4" rx="2" fill="#FF5C3E"/><text x="330" y="134" font-size="14" fill="#64748b" letter-spacing="1">Join</text><text x="330" y="164" font-size="18" font-weight="600" fill="#0F172A">入会</text>
<text x="330" y="226" font-size="16" fill="#475569">生徒ページができる</text>
<line x1="548" y1="148" x2="580" y2="148" stroke="#0F172A" stroke-width="2" marker-end="url(#sc-arr)"/>
<rect x="584" y="100" width="236" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><rect x="584" y="100" width="236" height="4" rx="2" fill="#FF5C3E"/><text x="602" y="134" font-size="14" fill="#64748b" letter-spacing="1">Lessons</text><text x="602" y="164" font-size="18" font-weight="600" fill="#0F172A">受講</text>
<text x="602" y="226" font-size="16" fill="#475569">課題はLINEで届く・自動で残る</text>
<line x1="820" y1="148" x2="852" y2="148" stroke="#0F172A" stroke-width="2" marker-end="url(#sc-arr)"/>
<rect x="856" y="100" width="236" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><rect x="856" y="100" width="236" height="4" rx="2" fill="#FF5C3E"/><text x="874" y="134" font-size="14" fill="#64748b" letter-spacing="1">Continue</text><text x="874" y="164" font-size="18" font-weight="600" fill="#0F172A">継続／休会</text>
<text x="874" y="226" font-size="16" fill="#475569">未提出・未入金を自動で催促</text>
				<rect x="40" y="20" width="1052" height="56" rx="6" fill="#FF5C3E"/>
				<text x="60" y="42" font-size="14" fill="#fff" font-weight="700" letter-spacing="1">LINE</text>
				<text x="60" y="65" font-size="16" fill="#fff">生徒とのやりとりは、ずっと公式LINEのまま。予約・課題・催促・月謝の案内がここに届く</text>
				<g stroke="#FF5C3E" stroke-width="2" fill="none">
					<path d="M158 76 L158 100"/><path d="M702 76 L702 100"/><path d="M974 76 L974 100"/>
				</g>
				<rect x="40" y="252" width="1052" height="48" rx="6" fill="#0F172A"/>
				<text x="566" y="282" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">講師は画面を開けば今日やることが分かる。探す・まとめる・催促するはシステムが持つ</text>
				</g>
			</svg>
			<svg class="fig-sp" viewBox="0 0 360 830" role="img" aria-label="生徒の流れ：体験、入会、受講、継続か休会。LINEで予約・課題・催促が届く">
				<defs><marker id="sc-sp-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<g font-family="inherit">
				<rect x="16" y="16" width="328" height="142" rx="6" fill="#FF5C3E"/>
				<text x="32" y="42" font-size="14" font-weight="700" letter-spacing="1" fill="#fff">LINE</text>
				<text x="32" y="68" font-size="16" fill="#fff">生徒とのやりとりは、</text>
				<text x="32" y="92" font-size="16" fill="#fff">ずっと公式LINEのまま。</text>
				<text x="32" y="116" font-size="16" fill="#fff">予約・課題・催促・月謝の案内が</text>
				<text x="32" y="140" font-size="16" fill="#fff">ここに届く</text>
				<path d="M180 158 L180 182" stroke="#FF5C3E" stroke-width="2" marker-end="url(#sc-sp-arr)"/>
				<rect x="16" y="186" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<rect x="16" y="186" width="328" height="3" fill="#FF5C3E"/>
				<text x="32" y="214" font-size="14" letter-spacing="1.5" fill="#64748b">Trial</text>
