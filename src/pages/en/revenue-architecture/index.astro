		width: 100%;
		border-collapse: collapse;
		font-size: 0.85rem;
	}

	.metrics-table th,
	.metrics-table td {
		padding: 0.6rem 0.7rem;
		text-align: left;
		border-bottom: 1px solid var(--color-border, #e2e8f0);
		line-height: 1.6;
	}

