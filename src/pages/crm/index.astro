---
import BaseLayout from '../../layouts/BaseLayout.astro';

const DEMO_URL = 'https://crm.consilegy.com/crm#demo';

const featureGlyphs = {
	contacts: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="9" y="10" width="34" height="44" rx="3"></rect>
			<circle class="glyph-strong" cx="23" cy="25" r="6"></circle>
			<path class="glyph-line" d="M15 42c2.2-5.2 13.8-5.2 16 0"></path>
			<path class="glyph-line" d="M32 21h6M32 28h6M15 48h18"></path>
			<rect class="glyph-accent" x="38" y="18" width="17" height="23" rx="3"></rect>
			<path class="glyph-line" d="M42 27h9M42 33h6"></path>
		</svg>
	`,
	kanban: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="8" y="12" width="48" height="36" rx="3"></rect>
			<path class="glyph-line" d="M24 12v36M40 12v36"></path>
			<rect class="glyph-accent" x="13" y="19" width="8" height="8" rx="1.5"></rect>
			<rect class="glyph-strong-fill" x="29" y="25" width="7" height="11" rx="1.5"></rect>
			<rect class="glyph-accent" x="45" y="18" width="6" height="16" rx="1.5"></rect>
			<path class="glyph-strong" d="M13 55l10-8 8 4 10-11 10 5"></path>
		</svg>
	`,
	jade: `
		<svg viewBox="0 0 64 64" focusable="false">
			<path class="glyph-accent" d="M32 8l17 18-17 30-17-30L32 8Z"></path>
			<path class="glyph-line" d="M15 26h34M24 26l8 30 8-30M24 17h16"></path>
			<rect class="glyph-panel" x="10" y="40" width="27" height="14" rx="3"></rect>
			<path class="glyph-strong" d="M16 47h7M27 47h4"></path>
		</svg>
	`,
	workflow: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="8" y="12" width="18" height="14" rx="3"></rect>
			<rect class="glyph-panel" x="38" y="12" width="18" height="14" rx="3"></rect>
			<rect class="glyph-accent" x="23" y="39" width="18" height="14" rx="3"></rect>
			<path class="glyph-line" d="M26 19h12M17 26v8c0 3 2 5 5 5h10M47 26v8c0 3-2 5-5 5H32"></path>
			<path class="glyph-strong" d="M13 19h8M43 19h8M28 46h8"></path>
		</svg>
	`,
	mail: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="8" y="12" width="31" height="39" rx="3"></rect>
			<path class="glyph-line" d="M15 22h17M15 30h17M15 38h11"></path>
			<rect class="glyph-accent" x="32" y="24" width="24" height="17" rx="3"></rect>
			<path class="glyph-strong" d="M32 28l12 8 12-8"></path>
			<path class="glyph-line" d="M42 48h10"></path>
		</svg>
	`,
	language: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="7" y="13" width="15" height="30" rx="3"></rect>
			<rect class="glyph-accent" x="24.5" y="18" width="15" height="30" rx="3"></rect>
			<rect class="glyph-panel" x="42" y="13" width="15" height="30" rx="3"></rect>
			<path class="glyph-line" d="M12 22h5M12 28h4M12 34h6M29.5 27h5M29.5 33h4M47 22h5M47 28h4M47 34h6"></path>
			<path class="glyph-strong" d="M19 51h26"></path>
			<path class="glyph-strong" d="M38 46l7 5-7 5"></path>
		</svg>
	`,
};

const painPoints = [
	{
		title: '顧客情報が散らばる',
		text: 'Excel、メール、個人メモに分かれていて、最新情報が分からない。',
	},
	{
		title: 'リード対応が抜ける',
		text: '問い合わせ後の初動、担当者、次回連絡がチームで追えない。',
	},
	{
		title: '商談・売上見込みが読めない',
		text: '進捗、確度、金額、次アクションを毎回手作業で集計している。',
	},
	{
		title: 'フォロー・更新が後手になる',
		text: '受注後の対応、契約更新、追加提案のタイミングを逃してしまう。',
	},
];

const capabilities = [
	{
		icon: 'contacts',
		title: '顧客・会社・商談を一元管理',
		text: 'コンタクト、会社、商談、活動履歴、メモをひとつの画面で管理。',
	},
	{
		icon: 'kanban',
		title: '案件カンバンとフォーキャスト',
		text: '商談の進捗、確度、売上見込みをまとめて確認。',
	},
	{
		icon: 'jade',
		title: 'AIエージェント Jade',
		text: '日本語で検索、要約、分類、次アクション提案を実行。',
	},
	{
		icon: 'workflow',
		title: 'RevOpsワークフロー',
		text: '通知、タスク、フォロー、更新商談作成を自動化。',
	},
	{
		icon: 'mail',
		title: 'メール・フォーム・リスト',
		text: 'リード獲得からナーチャリングまで、基本機能を標準搭載。',
	},
	{
		icon: 'language',
		title: '3言語UI',
		text: '日本語、English、繁體中文を画面ごと切り替え。',
	},
];

const screens = [
	{
		src: '/images/crm/screen-dashboard.webp',
		alt: 'Revenue CRMのダッシュボード。パイプライン総額、加重フォーキャスト、勝率、期限切れタスク、ステージ別パイプライン、注目の商談を一画面に表示。',
		title: 'ダッシュボード',
		text: 'パイプライン総額、加重フォーキャスト、対応優先度を確認',
	},
	{
		src: '/images/crm/screen-deals.webp',
		alt: 'Revenue CRMの商談カンバン。アプローチ、ヒアリング、提案、見積のステージごとに商談カードと金額、確度、クローズ予定日を表示。',
		title: '商談カンバン',
		text: 'ステージ、確度、次アクションをドラッグ操作で更新',
	},
	{
		src: '/images/crm/screen-jade.webp',
		alt: 'AIエージェントJadeの画面。「今日やるべきことは？」と日本語で質問し、ファネルの集計と進行中の商談10件を表で返している。',
		title: 'AIエージェント Jade',
		text: '日本語で質問し、集計・要約・提案まで実行',
	},
	{
		src: '/images/crm/screen-dashboard-en.webp',
		alt: 'Revenue CRMの英語UI。同じダッシュボードをEnglishに切り替えた画面。サイドバーにJA / EN / 繁中の切替ボタンがある。',
		title: '多言語UI',
		text: '日本語、English、繁體中文を画面ごと切り替え',
	},
];

const editions = [
	{
		noun: '商談',
		title: '法人営業',
		text: '見込み客を商談として管理。パイプライン、見積、フォーキャスト、停滞アラートに対応。',
	},
	{
		noun: '案件',
		title: '支援会社・受託開発',
		text: '見積、受注、納品、請求、保守更新までを案件単位で管理。',
	},
	{
		noun: '契約',
		title: 'SaaS代理店・リセラー',
		text: '契約更新、解約リスク、更新商談、クロスセル候補を追跡。',
	},
	{
		noun: '在籍',
		title: '教室・スクール',
		text: '生徒の在籍、継続、休会、退会を管理。スクール版として別ページで提供。',
		href: '/crm/school/',
	},
];

const featureGroups = [
	{
		title: 'CRMコア',
		items: ['コンタクト / 会社 / ディール', 'チケット / タスク / アクティビティ / コール', 'ディールかんばん', 'パイプライン・ステージ管理', 'メモ・添付ファイル・検索'],
	},
	{
		title: 'AI / Jade',
		items: ['CRM検索・操作', '通話解析', 'Webリサーチ・要約・分類', '音声文字起こし', 'リードスコアリング'],
	},
	{
		title: 'マーケティング',
		items: ['フォームビルダー', 'メール配信', '開封・クリック計測', '配信停止管理', '静的 / 動的リスト'],
	},
	{
		title: 'セールス',
		items: ['フォーキャスト', 'メールシーケンス', '見積', '製品マスタ', 'コンタクトロール'],
	},
	{
		title: 'CS / RevOps',
		items: ['インボックス', 'ナレッジベース', 'NPS / CSAT / CES', 'SLAエスカレーション', '更新商談の自動作成'],
	},
	{
		title: '拡張',
		items: ['カスタムオブジェクト', 'REST API / GraphQL / MCPサーバー', 'Webhook', '権限管理・監査ログ', 'Stripe / Notion / Google / LinkedIn連携'],
	},
];
---

<BaseLayout
	title="Revenue CRM 法人向け（β版） | まだCRMがない会社のための、最初のCRM"
	description="顧客の一覧はExcel、やりとりはメール、案件の温度感は担当者の頭の中。そういう会社のために、Consilegyが自社で作った法人向けCRMです。AIエージェントJadeと営業・マーケ・CSの基本機能を備え、現在クローズドβとしてデモ依頼を受け付けています。"
	lang="ja"
	alternateUrl="/en/crm/"
>

<!-- ===================== HERO ===================== -->
<section class="crm-hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM 法人向け β版</p>
			<h1>まだCRMがない会社のための、最初のCRMを作りました。</h1>
			<p class="hero-lead">
				顧客の一覧はExcel。やりとりはメール。案件の温度感は担当者の頭の中。
				そういう会社に40社入ってきて、「ここに入れるCRMがない」と何度も思いました。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを依頼する</a>
				<a href="#features" class="btn btn--secondary">機能を見る</a>
			</div>
			<ul class="hero-points" aria-label="Revenue CRMの特徴">
				<li>40社以上の収益設計から開発</li>
				<li>日本語 / English / 繁體中文</li>
				<li>See News（花蓮視新聞）掲載</li>
			</ul>
		</div>
		<figure class="hero-media">
			<img
				src="/videos/revenue-crm-demo.gif"
				alt="Revenue CRM の操作デモ。ダッシュボード、商談カンバン、自動化ライブラリ、AIエージェントJade、3言語切替を確認できる。"
				width="800"
				height="585"
				decoding="async"
			/>
			<figcaption>操作画面：ダッシュボード、商談、ワークフロー、Jade、多言語切替</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== PAIN ===================== -->
<section class="pain">
	<div class="container">
		<div class="section-head">
			<p class="kicker">こんな課題に</p>
			<h2>顧客接点と売上の管理が、個人の記憶に頼っていませんか。</h2>
		</div>
		<div class="pain-grid">
			{painPoints.map((item, index) => (
				<article class="pain-card">
					<span class="issue-label" aria-label={`課題 ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== FEATURES ===================== -->
<section class="features" id="features">
	<div class="container">
		<div class="section-head">
			<p class="kicker">できること</p>
			<h2>営業・マーケ・CSの情報を、1つの収益基盤に。</h2>
		</div>
		<div class="feature-grid">
			{capabilities.map((item) => (
				<article class="feature-card">
					<span class="feature-glyph" aria-hidden="true">
						<Fragment set:html={featureGlyphs[item.icon]} />
					</span>
					<div>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== PRODUCT VIEW ===================== -->
<section class="product-view">
	<div class="container">
		<div class="section-head">
			<p class="kicker">画面イメージ</p>
			<h2>最初に見る数字と、次に動く相手を同じ画面で確認。</h2>
		</div>
		<ul class="view-grid">
			{screens.map((item) => (
				<li class="view-card">
					<figure>
						<img
							src={item.src}
							alt={item.alt}
							width="1600"
							height="1000"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div class="view-caption">
						<strong>{item.title}</strong>
						<span>{item.text}</span>
					</div>
				</li>
			))}
		</ul>
	</div>
</section>

<!-- ===================== EDITIONS ===================== -->
<section class="editions">
	<div class="container">
		<div class="section-head">
			<p class="kicker">事業タイプ別</p>
			<h2>商売の形に合わせて、最初から設定済み。</h2>
		</div>
		<div class="edition-grid">
			{editions.map((item) => (
				<article class:list={['edition-card', item.href && 'edition-card--muted']}>
					<span class="edition-noun">{item.noun}</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					{item.href && <a href={item.href}>スクール版を見る</a>}
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== FIT ===================== -->
<section class="fit">
	<div class="container fit-grid">
		<div class="fit-box">
			<p class="kicker">向いている会社</p>
			<h2>これからCRMを入れる会社</h2>
			<ul>
				<li>顧客情報がExcel、メール、個人メモに分かれている</li>
				<li>案件状況をチームで共有できていない</li>
				<li>売上見込みを毎回手作業で集計している</li>
				<li>受注後のフォローや更新タイミングを追えていない</li>
			</ul>
		</div>
		<div class="fit-box fit-box--subtle">
			<p class="kicker">別の支援が向いている会社</p>
			<h2>すでにCRMが動いている会社</h2>
			<p>
				Salesforce、HubSpot、kintone、Marketoなどを導入済みの場合は、
				既存ツールを活かした収益プロセスの再設計をおすすめします。
			</p>
			<a href="/services/" class="text-link">既存CRMの再設計を見る</a>
		</div>
	</div>
</section>

<!-- ===================== MEDIA ===================== -->
<section class="media-proof">
	<div class="container media-grid">
		<div class="media-copy">
			<p class="kicker">開発背景</p>
			<h2>台湾・花蓮のノマド拠点から生まれました。</h2>
			<ul>
				<li>Nomad Hualien 花蓮雲基地 第1期メンバーとして滞在</li>
				<li>各国の起業家・リモートワーカーとの協働から構想</li>
				<li>AIエージェント名「Jade」は、花蓮の翡翠に由来</li>
				<li>See News（花蓮視新聞）2026年6月25日掲載</li>
			</ul>
			<a
				href="https://www.seenews.com.tw/news_data.php?news_id=2325&amp;k_code=A"
				target="_blank"
				rel="noopener noreferrer"
				class="text-link"
			>掲載記事を読む</a>
		</div>
		<figure class="press-image">
			<img
				src="/images/common/seenews-hualien-2026.jpg"
				alt="See News（花蓮視新聞）2026年6月25日の掲載記事。花蓮雲基地でCRMとAIを組み合わせた新製品を開発したことが紹介されている。"
				width="1000"
				height="1026"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>See News（花蓮視新聞）2026年6月25日掲載</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== BETA ===================== -->
<section class="beta">
	<div class="container beta-grid">
		<div>
			<p class="kicker">クローズドβ</p>
			<h2>初期導入企業を募集しています。</h2>
			<p>
				現在は数社限定で、実際の業務に合わせながら開発を進めています。
				デモをご希望の方は、専用フォームからお申し込みください。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを依頼する</a>
				<a href="/services/" class="btn btn--secondary">既存CRMの相談を見る</a>
			</div>
		</div>
		<ul class="beta-list">
			<li>セットアップ支援</li>
			<li>初期データ投入支援</li>
			<li>収益オペレーション設計の助言</li>
			<li>機能要望の優先反映</li>
		</ul>
	</div>
</section>

<!-- ===================== ALL FEATURES ===================== -->
<section class="all-features">
	<div class="container">
		<details>
			<summary>
				<span>機能一覧を見る</span>
				<span class="summary-note">CRMコア / AI / マーケ / セールス / CS / API</span>
			</summary>
			<div class="feature-columns">
				{featureGroups.map((group) => (
					<div>
						<h3>{group.title}</h3>
						<ul>
							{group.items.map((item) => <li>{item}</li>)}
						</ul>
					</div>
				))}
			</div>
		</details>
	</div>
</section>

</BaseLayout>

<style>
	.kicker,
	.eyebrow {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		margin: 0;
		color: var(--color-text);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.4;
		text-wrap: balance;
	}

	.text-link {
		display: inline-flex;
		margin-top: var(--space-sm);
		color: var(--color-primary);
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0.8rem 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.25;
		text-decoration: none;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.btn--primary {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
	}

	.btn--primary:hover {
		background: var(--color-primary-dark);
		border-color: var(--color-primary-dark);
		color: #fff;
	}

	.btn--secondary {
		background: transparent;
		color: var(--color-text);
	}

	.btn--secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-lg);
	}

	.crm-hero {
		padding: calc(var(--space-2xl) + 0.5rem) 0 var(--space-xl);
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.78fr);
		gap: var(--space-xl);
		align-items: end;
	}

	.hero-copy {
		max-width: 720px;
	}

	.eyebrow {
		display: block;
		margin-bottom: var(--space-md);
		padding-top: 0.875rem;
		border-top: 1px solid var(--color-border);
	}

	.crm-hero h1 {
		max-width: 13em;
		margin: 0;
		color: var(--color-text);
		font-size: 3.375rem;
		font-weight: 500;
		line-height: 1.18;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.hero-lead {
		max-width: 43em;
		margin: var(--space-md) 0 0;
		color: var(--color-text);
