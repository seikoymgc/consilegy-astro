---
import { insightPhoto } from '../../../lib/editorial-photos';
import NewsletterSidebar from '../../../components/NewsletterSidebar.astro';
import InsightHead from '../../../components/InsightHead.astro';
import InsightByline from '../../../components/InsightByline.astro';
import InsightContents from '../../../components/InsightContents.astro';
import '../../../styles/insight-evidence.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'crm-comparison';
const pubDate = '2026-11-19';

const title = "CRM比較：5製品の違いと、顧客情報をつなぐ選び方";
const metaTitle = "CRM比較：5製品の違いと、顧客情報をつなぐ選び方 | Consilegy";
const metaDescription = "CRM（顧客管理システム）の比較。Salesforce、HubSpot、Zoho CRM、kintone、Revenue CRMを、営業だけで使うのか、マーケティングや受注後の対応までつなぐのかという条件で比べます。料金の見方とデモでの確かめ方も解説します。";
const category = 'CRM';

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: metaDescription,
	datePublished: pubDate,
	dateModified: '2026-11-20',
	author: { '@type': 'Organization', name: 'Consilegy メディア編集部', url: 'https://media.consilegy.com/about/' },
	publisher: { '@type': 'Organization', name: 'Consilegy', url: 'https://consilegy.com' },
	url: `https://consilegy.com/insights/${slug}/`,
	inLanguage: 'ja',
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://consilegy.com/' },
		{ '@type': 'ListItem', position: 2, name: 'コラム', item: 'https://consilegy.com/insights/' },
		{ '@type': 'ListItem', position: 3, name: title, item: `https://consilegy.com/insights/${slug}/` },
	],
};

const headings = [{"id": "顧客情報を使う部署と変更を維持する体制で5製品を比べる", "text": "顧客情報を使う部署と、変更を維持する体制で5製品を比べる"}, {"id": "一元管理できるだけでは製品を選べない", "text": "「一元管理できる」だけでは、製品を選べない"}, {"id": "salesforce大企業で厳しい要件に合わせて作り込みたい場合", "text": "Salesforce：大企業で、厳しい要件に合わせて作り込みたい場合"}, {"id": "hubspot親しみやすい画面で幅広い機能を使いたい場合", "text": "HubSpot：親しみやすい画面で、幅広い機能を使いたい場合"}, {"id": "zoho-crm基本の顧客管理を低予算で使いたい場合", "text": "Zoho CRM：基本の顧客管理を、低予算で使いたい場合"}, {"id": "kintone自分たちでアプリを作り今の項目や入力の様式が合う場合", "text": "kintone：自分たちでアプリを作り、今の項目や入力の様式が合う場合"}, {"id": "revenue-crmaiによる記録要約を普段の仕事で比較する場合", "text": "Revenue CRM：AIによる記録・要約を、普段の仕事で比較する場合"}, {"id": "料金は入口の単価と必要な仕事ができる総額を分ける", "text": "料金は入口の単価と、必要な仕事ができる総額を分ける"}, {"id": "顧客情報をつなぐためにすべてを同じ製品へ移す必要はない", "text": "顧客情報をつなぐために、すべてを同じ製品へ移す必要はない"}, {"id": "デモでは部署をまたぐ一つの顧客を追う", "text": "デモでは、部署をまたぐ一つの顧客を追う"}];
---

<BaseLayout
	title={metaTitle}
	description={metaDescription}
	hasTranslation={false}
	ogType="article"
	lang="ja"
>
	<Fragment slot="head">
		<InsightHead schema={articleSchema} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

<div class="article-wrap">

	<header class="article-head container">
		<nav class="breadcrumb" aria-label="パンくずリスト">
			<a href="/">ホーム</a>
			<span aria-hidden="true">›</span>
			<a href="/insights/">コラム</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">{title}</span>
		</nav>
		<div class="article-meta">
			<span class="article-cat">{category}</span>
		</div>
		<h1>{title}</h1>
		<InsightByline published={articleSchema.datePublished} modified={articleSchema.dateModified} />
		<p><a href="https://media.consilegy.com/about/">Consilegy メディア編集部</a></p>
	</header>

	<article class="article-body container" id="article">

		<InsightContents headings={headings} />
		<div class="article-eyecatch">
			<img src={insightPhoto(slug)} alt="" width="1200" height="630" class="article-eyecatch__img" loading="eager" aria-hidden="true" />
		</div>

<section class="article-section article-lead">
<p>CRM（顧客管理システム）の比較では、営業だけで使うのか、マーケティングや受注後の対応までつなぐのかを先に決めます。同じ「顧客管理」でも、担当者の連絡先を共有することと、問い合わせから契約更新まで扱うことでは、必要な構成も費用も変わるからです。</p>
<p>この記事では、Salesforce、HubSpot、Zoho CRM、kintone、Revenue CRMを比較します。対象は、B2B企業の顧客情報と対応履歴を部署間で使いたい会社です。消費者の購買分析や、大規模なコールセンターの専用システム選定は対象に含めません。</p>
<p><strong>編集方針・利害関係：</strong> ConsilegyはRevenue CRMを開発・提供しています。製品の記述は公式資料に基づき、選定条件は編集部による比較分析です。未検証の使いやすさや導入成果を、本人の経験として紹介するものではありません。全製品の実機検証や、利用者調査による順位付けはしていません。製品情報と価格の確認日は2026年11月20日です。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="顧客情報を使う部署と変更を維持する体制で5製品を比べる">顧客情報を使う部署と、変更を維持する体制で5製品を比べる</h2>
<p>顧客管理システムは、同じ顧客について別の部署が何を知り、何を更新する必要があるかで比較します。情報を集める範囲を広げるほど、機能だけでなく、権限・契約・設定を維持する体制の確認が重要になります。</p>



































<div class="insight-evidence-table" role="region" aria-label="顧客情報を使う部署と、変更を維持する体制で5製品を比べる" tabindex="0"><table><thead><tr><th>製品</th><th>比較する理由</th><th>契約前に確かめたい点</th></tr></thead><tbody><tr><td>Salesforce</td><td>大企業で、厳しい権限・セキュリティ要件に合わせて作り込みたい</td><td>ライセンス、カスタマイズ、追加の保護機能、導入後の管理に十分な予算を持てるか</td></tr><tr><td>HubSpot</td><td>画面の操作感と機能の幅を確かめ、部署間の情報をつなぎたい</td><td>現場の操作感、機能別製品（Hub）と利用者の契約枠（シート）の構成、自動化・利用量で変わる費用</td></tr><tr><td>Zoho CRM</td><td>高度なAI機能より、基本の顧客・商談管理を低予算で使いたい</td><td>必要な機能が低価格プランに収まるか。AIを使う場合のプラン・言語・人数条件</td></tr><tr><td>kintone</td><td>自分たちで業務アプリを作りたい。管理する項目や入力の様式がkintoneに合う</td><td>普段使う項目・一覧・入力画面を無理なく作れ、変更を維持できるか</td></tr><tr><td>Revenue CRM</td><td>AIによる記録・要約を、普段の業務で試して比較したい</td><td>自社業務との適合、既存連携、AI処理の利用枠・個別支援を含む総額</td></tr></tbody></table></div>
<p>同じ部署で情報を共有する場合と、次の部署へ顧客への約束を渡す場合では、重視する構成が変わります。その違いを、まず具体的な引き継ぎから考えます。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="一元管理できるだけでは製品を選べない">「一元管理できる」だけでは、製品を選べない</h2>
<p>連絡先、商談、問い合わせ履歴。これらを同じシステムに置けても、次の担当者が必要な情報を使えるとは限りません。</p>
<p>たとえば、営業が契約を受注した後、運用担当者へ引き継ぐ場面を考えます。会社名と契約金額だけでは、顧客が何を達成したくて契約したのか、営業がどの範囲を約束したのかが分かりません。反対に、商談のメモをすべて渡しても、必要な約束が見つからなければ、担当者への聞き直しが残ります。</p>
<p>比較したいのは、履歴を保存できるかに加え、その約束を顧客や案件に関連づけて残し、次の担当者が見つけ、更新できるかです。これは導入後の運用だけの話ではありません。情報の持ち方と閲覧・更新権限によって、必要な製品構成が変わるからです。</p>
<p>営業の案件だけを管理したいなら、ここまで範囲を広げず、営業支援システムとして比較する方が決めやすくなります。部署間の引き継ぎが問題なら、営業画面の使いやすさだけで選ぶと、その先の分断を残します。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="salesforce大企業で厳しい要件に合わせて作り込みたい場合">Salesforce：大企業で、厳しい要件に合わせて作り込みたい場合</h2>
<p>Salesforceを勧めたい代表的なケースは、企業規模が大きく、業務に合わせたカスタマイズへ投資し、厳しいセキュリティや権限の要件を満たしたい会社です。この使い方では、製品を買う費用に加え、設計・構築・導入後の管理に十分な予算を持つことが条件になります。</p>
<p>ただし、Salesforceには<a href="https://www.salesforce.com/jp/small-business/">中堅・中小企業向けの製品</a>もあります。大企業専用とは捉えず、自社に必要な構成と管理体制で比較してください。</p>
<p><a href="https://www.salesforce.com/jp/sales/pricing/">公式価格表</a>では、営業・サービス・マーケティングなどを含むスイートと、営業向けの上位構成が案内されています。<a href="https://www.salesforce.com/jp/platform/shield/">Shield</a>には監視・暗号化・監査を補う製品もあります。必要な保護が、今回の契約と設定に含まれるかを具体的に確認します。</p>
<p>選定時には「Salesforceならできるか」から、「今回の契約と設定でできるか」へ問いを具体化します。同じ取引先に複数の案件がある場合、案件ごとの記録と会社全体の情報をどう見せるか。営業と受注後の担当者のどちらが更新するか。こうした要件を、利用する構成に当てはめます。</p>
<p>業務の違いを整理し、設定を維持する人を確保できる会社には、比較する理由があります。逆に、導入時に項目を作った後は誰も変更を判断できないなら、自由に設計できることが、そのまま使いやすさになるとは限りません。</p>
<p>低予算で連絡先と案件の共有だけを始めたい会社では、必要な範囲がより小さく済む候補も比較してください。Salesforceを使えるかより、作り込む必要と、それを維持する予算があるかが選定の分かれ目です。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="hubspot親しみやすい画面で幅広い機能を使いたい場合">HubSpot：親しみやすい画面で、幅広い機能を使いたい場合</h2>
<p>画面の親しみやすさと機能の幅を両方重視するなら、HubSpotを操作して比較する候補に入れてください。Hubは営業やマーケティングなど、機能別の製品を指します。<a href="https://www.hubspot.jp/products/crm">顧客データの基盤と各Hub</a>を組み合わせ、営業に限らずマーケティングやサービスへ使う範囲を広げられます。画面の使いやすさは、実際の利用者が普段の仕事を試して判断します。</p>
<p>たとえば、Webサイトから問い合わせた人に営業が連絡した後、サポートへ相談が入る場面を考えます。その人の会社・商談・問い合わせを関連づけて確認できることが重要なら、営業単独のシステムより広い範囲を比較する意味があります。</p>
<p>ただし、一つの基盤に載ることと、全員が同じ費用で全機能を使えることは別です。<a href="https://www.hubspot.jp/pricing/sales">公式価格表</a>を起点に、必要なHub、利用者ごとの契約枠（シート）、導入支援、利用量の条件を揃えます。部門をまたぐ自動処理も、実行したい内容に合わせて対象機能を確認します。</p>
<p>営業だけに必要な機能が増えるのか、マーケティング側の配信や処理が増えるのかによって、見積もりの内容は変わります。最初の安いプランから始められることと、予定した業務をその費用で続けられることを分けて判断してください。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="zoho-crm基本の顧客管理を低予算で使いたい場合">Zoho CRM：基本の顧客管理を、低予算で使いたい場合</h2>
<p>Zoho CRMを勧めたいのは、AIの高度な機能に先に投資するより、まず基本の顧客・商談管理を低予算で使いたい会社です。低価格プランで必要な仕事ができるなら、その構成で始める理由があります。</p>
<p><a href="https://www.zoho.com/jp/crm/comparison.html">公式比較表</a>では、年間契約のスタンダードが1人月額換算1,760円、エンタープライズが5,660円、いずれも税別です。予測ビルダーなどのAI機能は上位プランが条件になります。基本機能を使う価格と、必要なAI機能まで使う価格を分けてください。</p>
<p>「AIが使える」という説明だけでは、必要な処理まで含まれるか判断できません。機能ごとにプラン、必要人数、言語の条件を確認します。比較表の冒頭には、日本データセンターとの機能差に関する注意書きもあるため、実際に使う評価環境で確かめてください。高度なAIが主目的なら、Zoho CRMを基本プランの低価格だけで評価しないでください。</p>
<p>上位プランが必要になることだけで、他社より高額とも判断できません。必要なAI処理と利用人数を揃えて見積もりを比べます。</p>
<p>部署をまたいで使うなら、価格に加えて引き継ぎも試します。たとえば、同じ顧客の商談と受注時の約束を、営業と受注後の担当者がそれぞれの権限で確認・更新できるかを見ます。必要な情報の関連づけや操作が候補プランに収まらなければ、低価格という理由だけで残す候補にはしません。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="kintone自分たちでアプリを作り今の項目や入力の様式が合う場合">kintone：自分たちでアプリを作り、今の項目や入力の様式が合う場合</h2>
<p>kintoneを勧めたいのは、自分たちで業務アプリを作りたい会社です。加えて、管理したい項目の持ち方や入力の様式が、kintoneのアプリに合っていることが選定の条件になります。</p>
<p><a href="https://kintone.cybozu.co.jp/feature/basic/">公式の基本機能</a>では、項目を配置してアプリを作る方法や、一覧表示、アプリ間の関連づけが案内されています。比較では、普段使っている表や入力項目を持ち込み、必要な情報を無理なく登録・確認できるかを見ます。</p>
<p>たとえば、顧客ごとに決まった項目を記録し、条件で一覧を切り替えて使いたい場面が考えられます。自分たちで項目や見せ方を変えながら使いたいなら、アプリを作れることが選定理由になります。一方、求める入力の様式を実現するために拡張や個別開発が重なるなら、その費用と維持の負担も比較します。</p>
<p>会社名の表記が違う二つの台帳をどう関連づけるかも、設計で決める必要があります。どのアプリを正しい情報の置き場所にするか。アプリを作り足すだけでは、この判断は済みません。</p>
<p><a href="https://kintone.cybozu.co.jp/price/">公式料金表</a>では、外部連携やプラグインなどの拡張機能にコース差があります。連携を前提にするなら、最も安いライトコースの単価で見積もらないでください。アプリ設計や拡張の費用と、その後の保守も含めて判断します。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="revenue-crmaiによる記録要約を普段の仕事で比較する場合">Revenue CRM：AIによる記録・要約を、普段の仕事で比較する場合</h2>
<p>Revenue CRMは、Consilegyが開発・提供する顧客管理・営業支援システムです。<a href="https://consilegy.com/crm/features/">公開機能一覧</a>では、顧客・案件・対応履歴の管理、日本語での検索・作成指示、記録や下書きを補うAI機能などを案内しています。AI機能の掲載だけで利用条件まで同じとは判断せず、処理ごとの利用枠と契約条件を確認します。</p>
<p>AIによる記録・要約が、自社の入力作業をどう変えるかを試す際の比較対象になります。これは公開機能からの編集上の整理であり、第三者が効果を検証したという意味ではありません。初心者に向くことや、他製品より使いやすいことも、この機能一覧だけでは判断できません。</p>
<p>要約した内容が顧客・案件・対応履歴のどこへ残り、次の担当者が顧客への約束として見つけられるかも試してください。記録を自動で作れても、引き継ぎで探せず聞き直すなら、この記事で重視する部署間の分断は残ります。</p>
<p>自社製品を、すべての会社の第一候補として勧めるわけではありません。既存環境が動いている会社では、移行で得られるものと失うものを比べます。大きな組織の細かな統制や複雑な既存システム連携などは、必要な要件に対する対応範囲を確認してください。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="料金は入口の単価と必要な仕事ができる総額を分ける">料金は入口の単価と、必要な仕事ができる総額を分ける</h2>
<p>以下は2026年11月20日に公式ページで確認した有料プランの表示例です。機能・税・契約条件が違うため、金額の小さい順が製品の優劣を示すものではありません。HubSpotは公式の米ドル表示を残し、為替換算による見かけの安さで比較しないようにしています。</p>



































<div class="insight-evidence-table" role="region" aria-label="料金は入口の単価と、必要な仕事ができる総額を分ける" tabindex="0"><table><thead><tr><th>製品・公式価格表</th><th>表示価格の例</th><th>総額を比べるときの条件</th></tr></thead><tbody><tr><td><a href="https://www.salesforce.com/jp/sales/pricing/">Salesforce</a></td><td>Starter Suite：1人月額3,000円。月払いまたは年払いの表示</td><td>高度な設計・自動化・保護機能は対象プランと追加契約を確認。入口価格で全要件を見積もらない</td></tr><tr><td><a href="https://www.hubspot.jp/pricing/sales">HubSpot Sales Hub</a></td><td>Starter：1シート月額US$7からの新規顧客向け割引表示、US$20も併記（値引きは新規顧客のみ）</td><td>契約・請求期間と割引適用を確認。Professionalには別途必須の導入支援費US$1,500。Hubとシートの構成も揃える</td></tr><tr><td><a href="https://www.zoho.com/jp/crm/comparison.html">Zoho CRM</a></td><td>スタンダード：1人月額換算1,760円、年間契約・税抜</td><td>エンタープライズは同条件で5,660円。必要なAI機能の対象プラン・人数・言語を確認</td></tr><tr><td><a href="https://kintone.cybozu.co.jp/price/">kintone</a></td><td>ライト：1人月額1,000円、スタンダード：1,800円、いずれも税抜</td><td>両コースとも最低10人。外部連携・プラグインを使うなら、ライトの単価だけで比べない</td></tr><tr><td><a href="https://consilegy.com/crm/pricing/">Revenue CRM</a></td><td>ユーザープラン：1人月額3,000円、税抜</td><td>1年契約・途中解約なし。AI処理の利用枠と追加購入、有償の個別支援を含めて比較する</td></tr></tbody></table></div>
<p>Revenue CRMのユーザープランには毎月1人30燃料、最低100燃料が付与され、追加は税抜3,000円で400燃料です。「燃料」はAI処理などに使う利用枠で、人が画面を操作するだけでは減りません。プリペイドプランでは追加単価や基本的な自動処理の扱いが異なるため、ユーザープランと混同しないでください。ソフトウェアの初期費用はなく、個別の初期設定支援は希望に応じて税抜120,000円からです。これらは<a href="https://consilegy.com/crm/pricing/">公式料金ページ</a>で区別されています。</p>
<p>たとえば、閲覧だけの上司と、案件を編集する営業では必要な契約枠が異なることがあります。HubSpotのシートは利用者に割り当てる契約枠で、種類によって使える機能・操作が異なります。人数だけでなく、誰が何をするかを揃えて見積もります。</p>
<p><a href="https://community.hubspot.com/t/can-i-restore-legacy-free-seats-after-upgrading-plans-in-hubspot/142891">HubSpot Communityの2025年11月19日の相談</a>では、旧無料契約から有料契約へ移った後、他のメンバーが閲覧専用になり業務に支障が出たと投稿されています。これは個別契約の利用者申告で、現行プラン全体の問題を示す調査ではありません。比較では、人数の合計だけを揃えても操作権限まで同じにならない例として読みます。</p>
<p>初年度の支払額に加えて、情報を移す作業、設定変更、現場への説明を誰が引き受けるかも確認します。外注費を抑えても、社内担当者の仕事が増える場合があります。その負担を引き受けられるかも、候補を選ぶ条件です。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="顧客情報をつなぐためにすべてを同じ製品へ移す必要はない">顧客情報をつなぐために、すべてを同じ製品へ移す必要はない</h2>
<p>すでに別のシステムで確定している請求や契約の情報を、顧客管理システムへもう一度手入力すると、どちらが正しいかを確認する仕事が生まれます。「一つにまとめたはずなのに、照合が増えた」という状態です。</p>
<p>請求は会計、対応履歴は顧客管理システムに置き、必要な情報を連携する方がよい場合もあります。この場合は、顧客をどう同一と判断し、どちらの変更をどこへ反映するかを比較します。連携機能があるだけで、この分担が決まるわけではありません。</p>
<p>反対に、別システムを残すことで転記や問い合わせが続くなら、業務をまとめる理由があります。統合する範囲は、製品が持つ機能数ではなく、情報を受け渡す際に何が失われ、誰の仕事が増えているかで決めます。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="デモでは部署をまたぐ一つの顧客を追う">デモでは、部署をまたぐ一つの顧客を追う</h2>
<p>候補を試すときは、問い合わせ、商談、受注後の対応を、同じサンプル顧客で見てください。担当者が替わるたびに、前の担当者へ聞き直したり、別の表へ書き直したりする必要があるかを確認します。</p>
<p>営業が説明しやすい画面だけで判断せず、受け取る側が、その情報を自分の仕事に使えるかまで見ます。同時に、見せてはいけない金額や社内メモが、必要な範囲に制限されているかも確認してください。</p>
<p>Consilegy代表の山口聖子は<a href="https://note.com/seiko_consilegy/n/n8d0fcb5ff641">導入時の変化についての公開文章</a>で、現場の慣れたやり方を理解し、新旧の共通点を残しながら不要な負担を減らす考えを述べています。比較段階から今の仕事を持ち込むと、完成したデモ画面の印象に加え、自社が使う場面で判断できます。</p>
<p>顧客への約束を、次に対応する人が使える状態で渡す。そのために変える業務と残すシステムを決めると、候補が絞れます。</p>
<p>まずは、いま引き継ぎで困っている顧客対応を一つ選び、どの情報が誰に渡らないのかを整理してください。既存システムを生かした改善を含めて検討したい場合は、<a href="https://consilegy.com/services/crm-revops-redesign/">Consilegyの顧客管理システム導入・改善支援</a>で、業務と情報のつながりから検討できます。</p>
</section>
