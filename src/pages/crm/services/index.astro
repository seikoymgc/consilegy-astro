				<rect x="472" y="110" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="490" y="144" font-size="14" fill="#64748b" letter-spacing="1">Review</text><text x="490" y="174" font-size="18" font-weight="600" fill="#0F172A">定例会</text>
