---
import SitePhoto from '../../../components/SitePhoto.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrmMobile from '../../../components/CrmMobile.astro';
import CrmSubnav from '../../../components/CrmSubnav.astro';
import CrmSupport from '../../../components/CrmSupport.astro';
import CrmCardFlow from '../../../components/CrmCardFlow.astro';

// デモ一覧のスタートアップ・中小企業（標準版）のカードを先頭に出して開く（2026-11-25）
const DEMO_URL = 'https://crm.consilegy.com/demos?edition=demo&lang=ja';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// CRM for Startups（2026-11-22 代表と決定）。中身は標準版（法人B2B版）と同じで、入口と訴求だけ分ける。
// 主役は「会った人（名刺）・つながった人（LinkedIn）を、そのまま商談に」。自動化はフォローを止めない役。
// LinkedIn は製品のコードで確かめたことだけ書く（2026-11-22 代表確認）：
//   書いてよい … メンバーごとの接続／本人・会社ページとしての投稿／メッセージを貼り付けて記録に取り込む／
//               AIの次の一手で LinkedIn の連絡を提案／連絡先に LinkedIn の URL
//   書かない   … つながり・連絡先の自動取り込み（LinkedIn がAPIで出していない）、
//               広告へのリスト送信（Marketing API が未承認）
// 機能は src/data/crm-features.ts に載っているものだけ。使わない表現は AGENTS.md のとおり。

const problems = [
	{ title: '交流会でもらった名刺が、翌週には誰だか分からない。', text: 'イベントや交流会が続くほど、入力は後回しになります。お礼を送るころには、相手の熱も冷めています。' },
	{ title: 'LinkedInでつながった人との話が、どこにも残っていない。', text: 'メッセージでのやり取りは個人のアカウントの中だけ。誰と何を話したか、チームからは見えません。' },
	{ title: '営業以外の作業に、創業者の時間が取られる。', text: '記録、フォローの連絡、止まった商談の確認。売る時間より、その周りの作業の時間が長くなっていきます。' },
	{ title: '仕組みを作る人も、高いシステムを入れる余裕もない。', text: '自動化を組むには専任の担当がいる。でも、まだその人を雇う段階ではない。' },
];

const values = [
	{
		title: '名刺は撮るだけ。1通目のメールまでAIが下書き',
		text: '10枚まで並べて撮れば、まとめて読み取って連絡先を作ります。どこで会ったかも残せます。新しい相手には1通目のメールを下書きし、承認するまで送りません。Sansan・Eightからの取り込みにも対応しています。',
	},
	{
		title: 'LinkedInでのやり取りも、同じ顧客の記録に',
		text: 'LinkedInのメッセージを貼り付けると、顧客ごとの記録にまとまります。AIが次の一手を出すときは、メール・電話と並んでLinkedInでの連絡も候補にします。接続は自分のアカウントで、メンバーごとに行います。',
	},
	{
		title: 'フォローは、豊富な自動化オプションに任せる',
		text: '止まっている商談の知らせ、対応期限の超過、休眠した見込み客の掘り起こし。175本の自動化から、必要なものを選んでONにするだけです。自分で組む必要はありません。',
	},
	{
		title: '高機能もAIも、手の届く価格で',
		text: '1人あたり月額3,000円から使えます。初期費用はなく、どのプランも30日間無料で試せます。',
	},
];

// LinkedIn でできること（コードで確認済みの範囲だけ）
const linkedin = [
	{ label: '取り込む', text: 'メッセージのやり取りを貼り付けて、顧客の記録に残す' },
	{ label: '提案する', text: 'AIが次の一手として、LinkedInでの連絡を候補に出す' },
	{ label: '発信する', text: '本人として、または管理している会社ページとして投稿する' },
	{ label: 'ひもづける', text: '連絡先ごとに、LinkedInのプロフィールURLを持てる' },
];

// 自動化の例（crm-features.ts の automation から）
const automations = [
	{ area: '営業', title: '止まっている商談の知らせ', text: '一定期間、メール・通話・会議・メモのどれもない商談を見つけて、担当者にタスクを立てます。' },
	{ area: '営業', title: '対応期限の超過チェック', text: '対応期限を過ぎた問い合わせを、担当者の優先タスクにします。' },
	{ area: 'マーケティング', title: '休眠した見込み客の掘り起こし', text: '見たコンテンツや反応のない期間をきっかけに、次の連絡を組み立てます。' },
	{ area: 'マーケティング', title: '新規の見込み客が減ったときの知らせ', text: '新しい見込み客が前の週の半分を下回ると、原因を見るためのタスクを立てます。' },
	{ area: '営業', title: '狙うべき会社の判定', text: '関心の高さと理想の顧客像への近さから、狙うべき会社に印を付けます。連絡が途切れたらタスクにします。' },
	{ area: 'カスタマーサクセス', title: '更新の商談を先に立てる', text: '契約の更新日から逆算して、更新の商談を前もって作ります。' },
];

const screens = [
	{
		src: '/images/crm/media/screens/business-cards-stay-in-the-drawer-2-2026-10.webp', w: 1456, h: 430,
		title: '名刺の読み取り',
		desc: '名刺を撮るか画像を選ぶと、読み取った内容が連絡先の下書きになります。担当者が確かめてから登録します。',
		alt: '名刺を読み取る画面。どこで会ったかの入力欄と、カメラで撮る・画像を選ぶのボタン。',
	},
	{
		src: '/images/crm/media/screens/which-automations-to-turn-on-first-1-2026-10.webp', w: 1456, h: 822,
		title: '自動化ライブラリ',
		desc: 'マーケティング、営業、カスタマーサクセスの自動化から、必要なものを選んでONにできます。',
		alt: '自動化ライブラリの画面。商談の抜け漏れ防止・更新リスク管理・メールフォロー自動化などのセットと、ONにできる自動化の件数。',
	},
	{
		src: '/images/crm/media/screens/waiting-on-the-customer-for-three-months-1-2026-10.webp', w: 1456, h: 822,
		title: '商談',
		desc: 'ステージ、金額、クローズ予定日、これまでのやり取りを同じ画面で確かめられます。止まっている商談は通知でお知らせします。',
		alt: '商談詳細の画面。アプローチから受注までのステージ表示、金額とクローズ予定日、アクティビティの履歴が並ぶ。',
	},
	{
		src: '/images/crm/screen-dashboard-2026-10c.webp', w: 2000, h: 1250,
		title: 'ダッシュボード',
		desc: 'パイプライン、売上予測、受注率を1画面で確かめられます。経営会議や投資家への報告の数字も、ここから拾えます。',
		alt: 'ダッシュボードの画面。進行中パイプライン・加重フォーキャスト・今月の受注・勝率のカードと、ステージ別の金額、担当者別の商談一覧が並ぶ。',
	},
];
---

<BaseLayout
	title="Revenue CRM for Startups | 会った人も、つながった人も、そのまま商談に。"
	description="営業に集中したいスタートアップのための顧客管理システム。交流会の名刺は撮るだけでAIが連絡先と1通目のメールを下書き。LinkedInでのやり取りも同じ顧客の記録に残せます。フォローは175本の自動化から選んでONにするだけ。1人あたり月額3,000円から、30日間無料。"
	lang="ja"
	alternateUrl="/en/crm/startups/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/crm/"},
		{"@type": "ListItem", "position": 3, "name": "スタートアップ", "item": "https://consilegy.com/crm/startups/"}
	]
})} />

<CrmSubnav lang="ja" />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM · CRM for Startups</p>
			<h1><span class="nw">会った人も、</span><span class="nw">つながった人も、</span><br /><span class="nw">そのまま商談に。</span></h1>
			<p class="hero-lead">
				交流会でもらった名刺は撮るだけ。LinkedInでのやり取りも、同じ顧客の記録に残ります。フォローは豊富な自動化オプションに任せて、営業に集中したいスタートアップのための顧客管理システムです。
			</p>
			<div class="hero-actions">
				<a href={SIGNUP_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">無料で始める</a>
				<a href={DEMO_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">デモを見る</a>
			</div>
			<p class="hero-download"><a href="/crm/download/">資料をダウンロード</a></p>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/media/screens/business-cards-stay-in-the-drawer-1-2026-10.webp"
				alt="ホーム画面「今日の営業状況」。進行中パイプライン・加重フォーキャスト・今月の受注・勝率のカードと、「今やること」のタスク一覧。"
				width="1456"
				height="822"
				decoding="async"
			/>
			<figcaption>ホーム画面：その日にやることが一覧で表示されます</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">
				スタートアップの営業は、<br />
				<span class="nw">「会う」と「つながる」から</span><span class="nw">始まります。</span>
			</p>
			<div class="pos-copy">
				<p>
					最初の顧客は、交流会やイベントで会った人、LinkedInでつながった人から生まれることがほとんどです。ところが、名刺は机に貯まり、メッセージは個人のアカウントの中に残ったまま。せっかくの出会いが、商談になる前に止まってしまいます。
				</p>
				<p>
					Revenue CRMは、この2つの入口をそのまま顧客の記録につなげます。記録はAIが下書きし、そのあとのフォローは自動化が止めずに回します。創業者とメンバーは、会うこと・話すことに時間を使えます。
				</p>
			</div>
		</div>
		<SitePhoto subject="sales" lang="ja" panorama />
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Common Problems</p>
			<h2 class="prob-title">こんなことはありませんか？</h2>
		</div>
		<div class="prob-grid prob-grid--4">
			{problems.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`項目 ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== VALUES ===================== -->
<section class="problem values">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Features</p>
			<h2 class="prob-title">出会いを記録に。記録を商談に。</h2>
		</div>
		<div class="prob-grid prob-grid--4">
			{values.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`項目 ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== BUSINESS CARDS ===================== -->
<CrmCardFlow />

<!-- ===================== LINKEDIN ===================== -->
<section class="support">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">LinkedIn</p>
			<h2 class="prob-title">LinkedInでつながった人とのやり取りも、チームの記録に。</h2>
		</div>
		<p class="intl-lead">
			メンバーそれぞれが自分のLinkedInアカウントを接続して使います。メッセージのやり取りを取り込めば、名刺で登録した相手と同じように、誰と何を話したかをチームで確かめられます。
		</p>
	</div>
	<div class="container">
		<div class="prob-grid prob-grid--4 li-grid">
			{linkedin.map((r) => (
				<article class="prob-item">
					<p class="section-eyebrow auto-area">{r.label}</p>
					<h3>{r.text}</h3>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== AUTOMATION ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Automation</p>
			<h2 class="prob-title">豊富な自動化オプションから、必要なものをONにするだけ。</h2>
		</div>
		<p class="intl-lead">
			マーケティング59本、営業59本、カスタマーサクセス57本。あわせて175本の自動化を用意しています。自動化を組む担当がいなくても、今のチームに必要なものから選んで使えます。
		</p>
		<div class="prob-grid prob-grid--3">
			{automations.map((item) => (
				<article class="prob-item">
					<p class="section-eyebrow auto-area">{item.area}</p>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
		<p class="pos-link-wrap"><a href="/crm/features/" class="pos-link">すべての機能を見る →</a></p>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">The screens</p>
			<h2 class="sc-title">よく使う4つの画面</h2>
		</div>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" />
					</figure>
					<div>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== INTERNATIONAL ===================== -->
<section class="intl">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">International Teams</p>
			<h2 class="prob-title">海外のメンバーとも、同じ顧客情報で働ける。</h2>
		</div>
		<p class="intl-lead">
			画面は日本語・English・繁體中文から、使う人ごとに選べます。データは共通なので、言語が違うメンバーも同じ顧客情報と商談の状況を確かめられます。名刺の画面から送る1通目のメールは、その場で翻訳もできます。
		</p>
		<div class="intl-grid">
			<figure>
				<img src="/images/crm/screen-dashboard-2026-10c.webp" alt="日本語で表示したダッシュボード。" width="2000" height="1250" loading="lazy" decoding="async" />
				<figcaption>日本語</figcaption>
			</figure>
			<figure>
				<img src="/images/crm/screen-dashboard-2026-10c-en.webp" alt="同じダッシュボードを英語で表示した画面。" width="2000" height="1250" loading="lazy" decoding="async" />
				<figcaption>English</figcaption>
			</figure>
		</div>
	</div>
</section>

<!-- ===================== AI ===================== -->
<section class="ai">
	<div class="container ai-inner">
		<div>
			<p class="section-eyebrow">AI</p>
			<h2>移動中でも、<br />聞けばその場で返ってきます。</h2>
			<p class="ai-lead">
				集計表を作らなくても、知りたいことをAIエージェントに聞けます。顧客・商談・活動の記録と添付した資料から探して答えます。
			</p>
			<p class="ai-lead">
				頼めば、AIエージェントが連絡先やタスクを登録します。AIが提案できる行動の種類はあらかじめ決めてあり、提案には必ず理由を表示します。
			</p>
		</div>
		<ul class="ai-examples">
						<li>今週、声をかけるべき見込み客は？</li>
			<li>止まっている商談は？</li>
			<li>この名刺の人を登録して</li>
			<li>今月の受注見込みは？</li>
			<li>Which deals are stalled this week?</li>
		</ul>
	</div>
</section>

<CrmMobile />

<!-- ===================== SUPPORT（導入支援。トップと同じ欄） ===================== -->
<CrmSupport />

<!-- ===================== FINAL CTA ===================== -->
<section class="final-cta">
	<div class="container cta-inner">
		<div>
			<p class="cta-eyebrow">30 days free</p>
			<h2>次の交流会の前に、<br />実際の画面で試してください。</h2>
			<p class="cta-lead">
				初期費用はかかりません。どのプランも30日間無料で、カードの登録は不要です。デモはメールアドレスを入れると、すぐに開けます。
			</p>
			<div class="cta-actions">
				<a href={SIGNUP_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">無料で始める</a>
				<a href={DEMO_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href="/crm/pricing/" class="btn btn--secondary">料金を見る</a>
			</div>
		</div>
		<div class="cta-card">
			<h4>デモでお見せする内容</h4>
			<ul class="cta-list">
				<li>名刺をまとめて撮って、連絡先と1通目のメールができる流れ</li>
				<li>自動化ライブラリから、必要な自動化をONにする方法</li>
				<li>止まっている商談の知らせ方</li>
				<li>話しかけて操作するAIエージェント</li>
			</ul>
		</div>
	</div>
</section>

</BaseLayout>

<style>
	.auto-area { margin-bottom: 0.5rem; }
	.pos-link-wrap { margin: var(--space-md) 0 0; }
	.support .section-head + .intl-lead { margin-bottom: var(--space-md); }
	.li-grid { grid-template-columns: repeat(4, minmax(0, 1fr)) !important; }
	@media (max-width: 760px) { .li-grid { grid-template-columns: 1fr !important; } }
	.section-eyebrow,
	.eyebrow,
	.cta-eyebrow {
		margin: 0;
		color: var(--color-text-muted);
		font-size: var(--fs-small);
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	/* uppercase はギリシャ文字も変えるので β が B になる。ラテン文字だけ大文字にしたいので、日本語まじりの語は除外する。 */
	.section-eyebrow .no-upper,
	.eyebrow .no-upper,
	.cta-eyebrow .no-upper {
		text-transform: none;
	}

	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		margin: 0;
		color: var(--color-text);
		font-size: var(--fs-h2);
		font-weight: 500;
		line-height: 1.4;
		text-wrap: balance;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0.8rem 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		font-size: var(--fs-small);
		font-weight: 600;
		line-height: 1.25;
		text-decoration: none;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.btn--primary {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
	}

	.btn--primary:hover {
		background: var(--color-primary-dark);
		border-color: var(--color-primary-dark);
		color: #fff;
	}

	.btn--secondary {
		background: transparent;
		color: var(--color-text);
	}

	.btn--secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	.hero-actions,
