---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrmMobile from '../../../components/CrmMobile.astro';
import CrmSubnav from '../../../components/CrmSubnav.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// プロダクトの services エディション（crm リポジトリ src/lib/editions/index.ts、PR #368）に
// 実装済みのものだけ記載。用語は商談→案件。coreNav は /deals・/companies・/resources・
// /delivery・/subscriptions、既定の自動化は sal-37/41 と cs-23/25/26/30/32/33/54。
// 支援会社版の画面写真は、デモ組織（demo-services）ができてから撮って足す。
// 受託版や代理店版の写真は、別の業態のデータが写っているので流用しない
// （空き枠カレンダーだけは画面が同じなのでヒーローに使う）。

// 痛みは 2026-10-26 の公開調査・導入事例の確認をもとに選んだ（市場で最も強い痛みとは確定していない）。
// 契約更新を中心の痛みにするのは裏付けが弱いため、稼働と案件の管理を軸にした。
// 画面写真は demo-services（支援会社版の公開デモ）で 2026-10-26 に撮影。
const screens = [
	{ src: 'deals', title: '案件', desc: '問い合わせから受注、更新までを1つのボードで追います。月額支援の更新も、案件として並びます。', alt: '案件のカンバン画面。問い合わせ・ヒアリング・提案・条件調整・受注のステージに、月額支援の案件と更新の案件が金額とクローズ予定日つきで並ぶ。' },
	{ src: 'resources', title: '空き枠カレンダー', desc: 'メンバー×週で、割り当てた人日とキャパを並べます。今週の稼働率と空き人日も、数字で出ます。', alt: '空き枠カレンダーの画面。今週の稼働率82%・空き人日3のカードと、メンバー4名×12週の割当人日／キャパの表。' },
	{ src: 'subscriptions', title: '月額契約', desc: '顧客ごとの月額契約と次回更新日を一覧で見られます。MRR・ARR・解約率も、ここから集計します。', alt: 'サブスクの画面。MRR・ARR・稼働中の件数・解約率・LTVのカードと、プラン・お客様・ステータス・次回更新日・金額の一覧。' },
	{ src: 'delivery', title: 'デリバリー', desc: '立ち上げ・定常支援・更新前レビューの工程を、案件ごとに持ちます。期限と想定人日も同じ行に出ます。', alt: 'デリバリーの画面。案件・会社・金額・デリバリー工程（定常支援・更新前レビュー）・滞留日数・期限・想定と実績の人日の一覧。' },
];

const problems = [
	{
		title: '受けすぎて、支援が薄くなる',
		text: 'メンバーの稼働を確かめないまま新しい月額契約を受け、始まってから定例会の準備や月次レポートが間に合わなくなる。',
	},
	{
		title: '断りすぎて、売上を逃す',
		text: '来月には空きが出るのに、新しい相談を「今は手一杯」と断っている。',
	},
	{
		title: '契約の見直しの時期に、成果をすぐに見せられない',
		text: '更新の打ち合わせの前に、これまでの支援内容と成果を、担当者のメールやスプレッドシートから集め直している。',
	},
];

// 既定でONになる9本。text は crm リポジトリ src/lib/revops/outcomes.ts と
// execution.ts・config.ts の既定値から。商談はこのエディションでは「案件」。
const engine = [
	{ label: '停滞', text: '動きが止まっている案件を検出して通知' },
	{ label: '受注後', text: '受注すると、受注処理のタスクを作成' },
	{ label: '健康度', text: '最後に連絡した日と未対応の問い合わせから、顧客ごとの健康度を毎晩計算' },
	{ label: '定例会', text: '60日連絡していない顧客に、定例会を設定するタスクを作成（日数は変更できます）' },
	{ label: '成果レポート', text: '顧客になって80日を過ぎ、健康度が良い・普通の顧客に、AIが成果レポートの骨子を下書き' },
	{ label: '更新準備', text: '契約終了の60日前に、更新準備のタスクを作成' },
	{ label: '更新アプローチ', text: '契約終了の90日前に、更新アプローチのタスクを作成' },
	{ label: '更新案件', text: '契約終了の90日前に、更新の案件を作成' },
	{ label: '追加提案', text: '更新まで90日以内で健康度が良い顧客に、追加提案を「今すぐ・更新と同時・見送り」のどれにするか、AIが理由と最初の一手をメモに残す' },
];

const roles = [
	{ name: 'オーナー', scope: '全案件・稼働・契約・権限設定' },
	{ name: '管理者', scope: '運用全般と権限設定' },
	{ name: 'マネージャー', scope: '担当チームの顧客と案件を閲覧・編集' },
	{ name: 'メンバー', scope: '自分が担当の顧客と案件のみ' },
];
---

<BaseLayout
	title="Revenue CRM支援会社版 | 受けすぎず、断りすぎず、更新を落とさない"
	description="コンサル・マーケ支援など、継続支援の会社向けの画面構成。メンバー×週の空き枠カレンダーで受けられるかを数字で判断し、月額の継続契約と更新を90日前から追えます。定例会・成果レポート・追加提案のタイミングも自動で知らせます。どのプランも30日間無料で試せます。"
	lang="ja"
	alternateUrl="/en/crm/services/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/crm/"},
		{"@type": "ListItem", "position": 3, "name": "支援会社版", "item": "https://consilegy.com/crm/services/"}
	]
})} />

<CrmSubnav lang="ja" />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM · Services edition</p>
			<h1><span class="nw">受けすぎず、</span><span class="nw">断りすぎず、</span><br />更新を落とさない。</h1>
			<p class="hero-lead">
				コンサルティング・マーケティング支援など、月額契約で支援を続ける会社向けの顧客管理システムです。メンバーの稼働、月額契約、契約の更新月を1つの画面で管理でき、更新の準備は契約終了の90日前から始められます。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href={SIGNUP_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">無料で始める</a>
			</div>
			<p class="hero-download"><a href="/crm/download/">資料をダウンロード</a></p>
			<p class="hero-download"><a href="/crm/updates/#current-editions">各エディションの対象業務と料金を確認する</a></p>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/services/screen-resources-2026-10d.webp"
				alt="空き枠カレンダーの画面。今週の稼働率82%・空き人日3のカードと、コンサルタントなど4名×12週の割当表。シニアコンサルタントは週5日のうち4.5日が埋まっている。"
				width="1568"
				height="766"
				decoding="async"
			/>
			<figcaption>空き枠カレンダー：誰がどれだけ埋まっていて、どこが空いているか</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">
				月額の支援は、<br />
				更新されて売上が積み上がります。
			</p>
			<div class="pos-copy">
				<p>
					支援会社版は、受注したあとの管理を中心にしています。案件に契約終了日を入れておくと、90日前に更新アプローチのタスクと更新の案件を、60日前に更新準備のタスクを作成します。
				</p>
				<p>
					メンバーの稼働は週単位の表で確認できます。マネージャーは新しい相談を受ける前に、どのメンバーにいつ空きがあるかを空き人日で確かめられます。
				</p>
				<p>
					月額契約はサブスクの画面でも管理できます。契約を登録すると、MRR・ARR・解約率を自動で集計します。
				</p>
				<a href="/revenue-architecture/" class="pos-link">この考え方について読む →</a>
			</div>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Problems</p>
			<h2 class="prob-title">営業中の案件と、担当者の稼働を別々に管理している。</h2>
		</div>
		<div class="prob-grid">
			{problems.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`項目 ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">The screens</p>
			<h2 class="sc-title">毎日開くのは、この4つの画面です。</h2>
		</div>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img src={`/images/crm/services/screen-${s.src}-2026-10d.webp`} alt={s.alt} width="1568" height="766" loading="lazy" decoding="async" />
					</figure>
					<div>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== 継続エンジン ===================== -->
