		width: 100%; height: auto; display: block;
		max-height: 360px; object-fit: cover;
	}
	/* ── Layout ────────────────────────────────────────────── */
	.article-wrap { background: #fff; }

	.container {
		max-width: 800px;
		margin-inline: auto;
		padding-inline: var(--space-md, 1.5rem);
	}

	.br-pc { display: inline; }

	/* ── Breadcrumb ────────────────────────────────────────── */
	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4em;
		font-size: 0.8rem;
