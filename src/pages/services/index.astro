---
import BaseLayout from '../../layouts/BaseLayout.astro';

// 機能別の個別ページ。ナビからは外し、このハブと記事からの内部リンクで到達させる。
const topics = [
	{
		href: '/services/revenue-architecture-design/',
		en: 'Revenue Architecture Design',
		title: 'レベニューアーキテクチャ設計',
		desc: '収益構造そのものを可視化し、獲得から継続までを一つの流れとして設計します。',
		step: 'Step 01〜02',
	},
	{
		href: '/services/b2b-marketing-gtm-design/',
		en: 'GTM & Marketing Strategy Design',
		title: 'マーケティング・GTM戦略設計',
		desc: '市場・顧客・導線を整理し、商談化につながるマーケティング戦略を設計します。',
		step: 'Step 02',
	},
	{
		href: '/services/crm-revops-redesign/',
		en: 'Multi-CRM RevOps Implementation',
		title: '主要CRM横断・RevOps実装支援',
		desc: 'Salesforce・HubSpot・Kintone・Marketoの連携と実装。ベンダーに縛られない横断設計。',
		step: 'Step 02',
		core: true,
	},
	{
		href: '/services/hubspot-implementation-operations/',
		en: 'HubSpot Implementation & Operations',
		title: 'HubSpot導入・運用改善支援',
		desc: 'HubSpotを利用中の企業向けに、設計・実装・運用改善を支援します。',
		step: 'Step 02〜03',
	},
	{
		href: '/services/adoption-growth-support/',
		en: 'Adoption & Growth Support',
		title: '運用定着・改善伴走支援',
		desc: '導入で終わらせず、データが蓄積し改善が回る状態まで伴走します。',
		step: 'Step 03',
	},
];
---

<BaseLayout
	title="サービス・料金 | Consilegy"
	description="収益構造の現状分析（10〜50万円）、収益プロセス再設計（300〜800万円）、伴走・顧問支援（月額30〜100万円）。現状把握から再設計、定着まで、フェーズに合わせて選べる3ステップ。"
	lang="ja"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "サービス・料金", "item": "https://consilegy.com/services/"}
	]
})} />
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "WebPage",
	"@id": "https://consilegy.com/services/#webpage",
	"url": "https://consilegy.com/services/",
	"name": "サービス・料金 | Consilegy",
	"description": "収益構造の現状分析（10〜50万円）、収益プロセス再設計（300〜800万円）、伴走・顧問支援（月額30〜100万円）",
	"publisher": { "@id": "https://consilegy.com/#organization" },
	"mainEntity": {
		"@type": "ItemList",
		"name": "Consilegy サービスプラン一覧",
		"itemListElement": [
			{
				"@type": "ListItem",
				"position": 1,
				"item": {
					"@type": "Service",
					"name": "簡易分析",
					"description": "現状のヒアリングと課題仮説の提示。オンラインMTG数回とレポート作成に絞った入口商品。",
					"provider": { "@id": "https://consilegy.com/#organization" },
					"offers": { "@type": "Offer", "priceCurrency": "JPY", "priceRange": "¥100,000〜¥150,000" }
				}
			},
			{
				"@type": "ListItem",
				"position": 2,
				"item": {
					"@type": "Service",
					"name": "詳細分析",
					"description": "CRM / SFA / MA運用とデータ構造のフルレビュー。ボトルネックの根拠と再設計ロードマップを提示。",
					"provider": { "@id": "https://consilegy.com/#organization" },
					"offers": { "@type": "Offer", "priceCurrency": "JPY", "priceRange": "¥300,000〜¥500,000" }
				}
			},
			{
				"@type": "ListItem",
				"position": 3,
				"item": {
					"@type": "Service",
					"name": "収益プロセス再設計プロジェクト",
					"description": "Salesforce / HubSpot / Kintone / Marketoなど複数ツールが混在する収益オペレーションを再設計。営業プロセス・データモデル・KPI基盤を一体で再構築。",
					"provider": { "@id": "https://consilegy.com/#organization" },
					"offers": { "@type": "Offer", "priceCurrency": "JPY", "priceRange": "¥3,000,000〜¥8,000,000" }
				}
			},
			{
				"@type": "ListItem",
				"position": 4,
				"item": {
					"@type": "Service",
					"name": "ライト伴走支援",
					"description": "月1〜2回の定例会とダッシュボード改善アドバイスを中心とした月額伴走支援。",
					"provider": { "@id": "https://consilegy.com/#organization" },
					"offers": { "@type": "Offer", "priceCurrency": "JPY", "priceRange": "¥300,000〜¥400,000/月" }
				}
			},
			{
				"@type": "ListItem",
				"position": 5,
				"item": {
					"@type": "Service",
					"name": "スタンダード伴走支援",
					"description": "営業・マーケ・CS各部門への定例伴走。KPIレビューからレポート改善・施策優先順位づけまで対応。",
					"provider": { "@id": "https://consilegy.com/#organization" },
					"offers": { "@type": "Offer", "priceCurrency": "JPY", "priceRange": "¥500,000〜¥800,000/月" }
				}
			},
			{
				"@type": "ListItem",
				"position": 6,
				"item": {
					"@type": "Service",
					"name": "フル伴走支援",
					"description": "施策の設計・実行まで入り込む最も深い関与。部門間調整や改善プロジェクトのリードまで担当。",
					"provider": { "@id": "https://consilegy.com/#organization" },
					"offers": { "@type": "Offer", "priceCurrency": "JPY", "priceRange": "¥800,000〜¥1,000,000/月" }
				}
			}
		]
	}
})} />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container">
		<span class="eyebrow"><span class="eyebrow__dot"></span>Services &amp; Pricing</span>
		<h1>現状を把握する。作り直す。<br /><span class="accent">現場で回るまで、離れない。</span></h1>
		<p class="hero-lead">
			Consilegyの支援は3つのステップに分かれます。どこから始めるかは、いま何が分かっていて何が分かっていないかで決まります。
		</p>
		<div class="hero-actions">
			<a href="/diagnostic/" class="btn btn--primary btn--lg">収益を自己診断</a>
			<a href="#guide" class="btn btn--ghost btn--lg">どこから始めるべきか</a>
		</div>
	</div>
</section>

<!-- ===================== PRODUCT（まだ仕組みがない会社へ） ===================== -->
<section class="svc-product">
	<div class="container svc-product__inner">
		<div class="svc-product__copy">
			<p class="section-eyebrow">まだ仕組みがない会社へ</p>
			<h2>CRMがまだない場合は、自社プロダクトから始められます。</h2>
			<p class="section-lead">
				40社以上の再設計で分かった「動くCRMの型」を製品にしたのが「Revenue CRM」です。移行作業なし。Excelの記録がそのまま残るところから始まります。現在クローズドβで、数社限定の開発パートナーを募集中です。
			</p>
			<p class="svc-product__note">以下のStep 01〜03は、すでにCRMが入っている会社向けの支援です。</p>
			<a href="/crm/" class="btn btn--outline-primary">Revenue CRM を見る →</a>
		</div>
		<a href="/crm/" class="svc-product__shot" aria-label="Revenue CRMのダッシュボード画面。詳細ページへ">
			<span class="svc-product__bar" aria-hidden="true"><i></i><i></i><i></i></span>
			<img
				src="/images/crm/screen-dashboard.webp"
				alt="Revenue CRMのダッシュボード。パイプライン総額、加重フォーキャスト、勝率、期限切れタスク、ステージ別パイプライン、注目の商談を一画面に表示。"
				width="1600"
				height="1000"
				loading="lazy"
				decoding="async"
			/>
		</a>
	</div>
</section>

<!-- ===================== STEP OVERVIEW ===================== -->
<section class="overview">
	<div class="container">
		<div class="overview-head">
			<p class="section-eyebrow">The Three Steps</p>
			<h2>支援の全体像</h2>
			<p class="section-lead">
				3つは独立したメニューではなく、ひとつの流れです。課題がはっきりしていればStep 02から入ることもあります。
			</p>
		</div>

		<div class="ov-flow">
			<a class="ov-step" href="#step-01">
				<span class="ov-step__badge">Step 01</span>
				<h3>収益構造の現状分析</h3>
				<p class="ov-step__goal">何が起きているかを、根拠のある形で特定する</p>
				<dl class="ov-step__meta">
					<div><dt>期間</dt><dd>2〜6週間</dd></div>
					<div><dt>費用</dt><dd>¥100,000〜500,000</dd></div>
				</dl>
			</a>
			<span class="ov-arrow" aria-hidden="true">→</span>
			<a class="ov-step ov-step--core" href="#step-02">
				<span class="ov-step__badge">Step 02</span>
				<h3>収益プロセス再設計</h3>
				<p class="ov-step__goal">収益構造を根本から作り直す</p>
				<dl class="ov-step__meta">
					<div><dt>期間</dt><dd>3〜6ヶ月</dd></div>
					<div><dt>費用</dt><dd>¥3,000,000〜8,000,000</dd></div>
				</dl>
			</a>
			<span class="ov-arrow" aria-hidden="true">→</span>
			<a class="ov-step" href="#step-03">
				<span class="ov-step__badge">Step 03</span>
				<h3>伴走・顧問支援</h3>
				<p class="ov-step__goal">現場で回る状態にし、内製化まで持っていく</p>
				<dl class="ov-step__meta">
					<div><dt>期間</dt><dd>月次／最低3ヶ月〜</dd></div>
					<div><dt>費用</dt><dd>月額 ¥300,000〜1,000,000</dd></div>
				</dl>
			</a>
		</div>

		<div class="pn-grid">
			<div class="pn-item">
				<span class="pn-type">プロジェクト型</span>
				<p>Step 01・02。期間と成果物が定められた単発支援です。</p>
			</div>
			<div class="pn-item">
				<span class="pn-type">月額型</span>
				<p>Step 03。継続的な改善と定着支援を行う月額プランです。</p>
			</div>
		</div>
		<p class="pn-custom-note">
			従業員50〜300名のB2B企業が中心です。表示価格は目安で、規模・期間・要件に応じて調整します。
		</p>
		<p class="pn-diag-note">
			<strong>無料の収益診断（3分）と、Step 01の現状分析は別のものです。</strong>
			診断は「どこで止まっているか」と「どのステップから入るべきか」を自分で判断するための無料ツールです。
			Step 01は、その先で原因を根拠つきで特定する有償のサービスです。
		</p>
	</div>
</section>

<!-- ===================== STEP 01 ===================== -->
<section class="plan-section" id="step-01">
	<div class="container">
		<div class="plan-group-head">
			<span class="step-badge">Step 01</span>
			<h2>収益構造の現状分析</h2>
			<p class="plan-group-sub">
				何が起きているかを、根拠のある形で特定します。予算と意思決定の前に置く入口です。
				「たぶんCRMの問題」を「この工程のこの定義が原因」に変えるところまでが範囲です。
			</p>
		</div>

		<div class="plan-grid plan-grid--2">

			<article class="plan-card">
				<p class="plan-tag">簡易分析</p>
				<p class="plan-sub">現状のヒアリングと課題仮説の提示。オンラインMTG数回とレポート作成に絞った入口商品。</p>
				<div class="plan-price">
					<div class="plan-price__amount">¥100,000〜150,000</div>
					<span class="plan-price__unit">オンラインMTG 2〜3回 + レポート提出</span>
				</div>
				<ul class="plan-features">
					<li><span class="check" aria-hidden="true">✓</span>現状ツール・業務フローのヒアリング</li>
					<li><span class="check" aria-hidden="true">✓</span>課題仮説と優先度の整理</li>
					<li><span class="check" aria-hidden="true">✓</span>改善の方向性レポート（10〜15ページ）</li>
				</ul>
				<a href="/revops-assessment/" class="btn btn--primary plan-cta">現状分析の内容を見る</a>
			</article>

			<article class="plan-card">
				<p class="plan-tag">詳細分析</p>
				<p class="plan-sub">CRM / SFA / MA運用とデータ構造のフルレビュー。ボトルネックの根拠と再設計ロードマップを提示します。</p>
				<div class="plan-price">
					<div class="plan-price__amount">¥300,000〜500,000</div>
					<span class="plan-price__unit">期間目安：4〜6週間 / 一括</span>
				</div>
				<ul class="plan-features">
					<li><span class="check" aria-hidden="true">✓</span>CRM / MA運用・データ構造の詳細レビュー</li>
					<li><span class="check" aria-hidden="true">✓</span>業務インタビュー（5〜10名）</li>
					<li><span class="check" aria-hidden="true">✓</span>ボトルネック分析と改善ロードマップ</li>
					<li><span class="check" aria-hidden="true">✓</span>経営報告会（1回）</li>
				</ul>
				<a href="/revops-assessment/" class="btn btn--primary plan-cta">現状分析の内容を見る</a>
			</article>

		</div>
		<p class="plan-foot">
			分析後に必ず契約する必要はありません。レポートと報告会をもって完結するサービスです。
			まず現在地だけ知りたい場合は、<a href="/diagnostic/">無料の収益診断</a>から始められます。
		</p>
	</div>
</section>

<!-- ===================== STEP 02 ===================== -->
<section class="plan-section plan-section--alt" id="step-02">
	<div class="container">
		<div class="plan-group-head">
			<span class="step-badge">Step 02</span>
			<h2>収益プロセス再設計</h2>
			<p class="plan-group-sub">
				収益構造を根本から作り直す中核プロジェクトです。
				最も相談が多く、Consilegyの支援の中心にあたります。
			</p>
		</div>

		<article class="plan-card plan-card--recommended">
			<span class="plan-sub-badge">中核プロジェクト</span>
			<p class="plan-tag">収益プロセス再設計プロジェクト</p>
			<p class="plan-sub">
				Salesforce / HubSpot / Kintone / Marketoなど複数ツールが混在する収益オペレーションを、
				ベンダー中立の立場で設計し直します。営業プロセス・データモデル・KPI基盤を一体で再構築します。
			</p>
			<div class="plan-price">
				<div class="plan-price__amount">¥3,000,000〜8,000,000</div>
				<span class="plan-price__unit">期間目安：3〜6ヶ月 / 一括または分割</span>
			</div>
			<ul class="plan-features plan-features--cols">
				<li><span class="check" aria-hidden="true">✓</span>To-Beデータモデル / オブジェクト設計</li>
				<li><span class="check" aria-hidden="true">✓</span>マルチCRM間の統合・移行設計</li>
				<li><span class="check" aria-hidden="true">✓</span>営業 / マーケ / CSプロセス再設計</li>
				<li><span class="check" aria-hidden="true">✓</span>KPI / レポーティング基盤の再構築</li>
				<li><span class="check" aria-hidden="true">✓</span>実装ベンダー選定支援（中立）</li>
				<li><span class="check" aria-hidden="true">✓</span>PMO / ステアリング運営</li>
			</ul>
			<a href="/diagnostic/" class="btn btn--primary plan-cta">収益を自己診断</a>
		</article>
	</div>
</section>

<!-- ===================== STEP 03 ===================== -->
<section class="plan-section" id="step-03">
	<div class="container">
		<div class="plan-group-head">
			<span class="step-badge">Step 03</span>
			<h2>伴走・顧問支援</h2>
			<p class="plan-group-sub">
				設計を現場で回る状態にし、最終的には自社でRevOpsを回せる状態まで持っていきます。
				関与度に応じて3プランから選択できます。
			</p>
		</div>

		<div class="plan-grid plan-grid--3">

			<article class="plan-card">
				<p class="plan-tag">ライト伴走</p>
				<p class="plan-sub">まず伴走から始めたい企業向け。月1〜2回の定例会とダッシュボード改善アドバイスを中心に支援。</p>
				<div class="plan-price">
					<div class="plan-price__amount">¥300,000〜400,000</div>
					<span class="plan-price__unit">月額 / 最低3ヶ月〜</span>
				</div>
				<ul class="plan-features">
					<li><span class="check" aria-hidden="true">✓</span>月次定例会（1〜2回）</li>
					<li><span class="check" aria-hidden="true">✓</span>KPIダッシュボードレビュー</li>
					<li><span class="check" aria-hidden="true">✓</span>課題整理・優先順位づけ</li>
				</ul>
				<a href="/diagnostic/" class="btn btn--primary plan-cta">収益を自己診断</a>
			</article>

			<article class="plan-card">
				<p class="plan-tag">スタンダード伴走</p>
				<p class="plan-sub">営業・マーケ・CS各部門への定例伴走。KPIレビューからレポート改善・施策優先順位づけまで対応。</p>
				<div class="plan-price">
					<div class="plan-price__amount">¥500,000〜800,000</div>
					<span class="plan-price__unit">月額 / 最低3ヶ月〜</span>
				</div>
				<ul class="plan-features">
					<li><span class="check" aria-hidden="true">✓</span>月次定例会（各部門 月1回）</li>
					<li><span class="check" aria-hidden="true">✓</span>KPIレビュー・レポート改善</li>
					<li><span class="check" aria-hidden="true">✓</span>施策の優先順位付け</li>
					<li><span class="check" aria-hidden="true">✓</span>Slack等での非同期相談対応</li>
				</ul>
				<a href="/diagnostic/" class="btn btn--primary plan-cta">収益を自己診断</a>
			</article>

			<article class="plan-card">
				<p class="plan-tag">フル伴走</p>
				<p class="plan-sub">施策の設計・実行まで入り込む、最も深い関与。部門間調整や改善プロジェクトのリードまで担当。</p>
				<div class="plan-price">
					<div class="plan-price__amount">¥800,000〜1,000,000</div>
					<span class="plan-price__unit">月額 / 最低6ヶ月〜</span>
				</div>
				<ul class="plan-features">
					<li><span class="check" aria-hidden="true">✓</span>施策設計・実行まで伴走</li>
					<li><span class="check" aria-hidden="true">✓</span>部門間調整・ステークホルダー管理</li>
					<li><span class="check" aria-hidden="true">✓</span>改善プロジェクトのリード</li>
					<li><span class="check" aria-hidden="true">✓</span>RevOpsチーム内製化支援</li>
				</ul>
				<a href="/diagnostic/" class="btn btn--primary plan-cta">収益を自己診断</a>
			</article>

		</div>
	</div>
</section>

<!-- ===================== WHERE TO START ===================== -->
<section class="guide" id="guide">
	<div class="container">
		<div class="guide-head">
			<p class="section-eyebrow">Where To Start</p>
			<h2>どこから始めるべきか</h2>
			<p class="section-lead">
				判断の基準は、予算でも会社の規模でもありません。
				「いま何が分かっていて、何が分かっていないか」です。
			</p>
		</div>
		<div class="guide-grid">
			<a class="guide-card" href="#step-01">
