---
// 記事1本。/crm/faq/[slug] と同じ骨格（パンくず → 本文 → 関連 → CTA）。
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CrmMediaCard from './CrmMediaCard.astro';
import { CATEGORIES, COPY, SEGMENTS, articlePath, crmMediaArticles, eyecatchPath, fmtDate, mediaPath, ogImagePath, type Article } from '../lib/crm-media';

interface Props { a: Article }
const { a } = Astro.props;
const lang = a.data.lang;
const t = COPY[lang];
const { Content } = await render(a);

const segment = a.data.segment;
// デモ一覧で、記事のエディションのカードを先頭に出して開く（2026-11-25）
const demoUrl = `https://crm.consilegy.com/demos?edition=${a.data.edition === 'school' ? 'demo-school' : 'demo'}&lang=${lang}`;
const others = (await crmMediaArticles(lang, segment)).filter((x) => x.data.slug !== a.data.slug);
const sameCat = others.filter((x) => x.data.category === a.data.category);
const next = (sameCat.length ? sameCat : others).slice(0, 2);

const site = Astro.site ?? new URL('https://consilegy.com');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: a.data.title,
  description: a.data.pain,
  inLanguage: lang,
  datePublished: a.data.date.toISOString(),
  dateModified: (a.data.updated ?? a.data.date).toISOString(),
  author: { '@type': 'Person', '@id': 'https://consilegy.com/company/#founder', name: t.author },
  publisher: { '@id': 'https://consilegy.com/#organization' },
  mainEntityOfPage: new URL(articlePath(a), site).href,
  about: { '@type': 'SoftwareApplication', name: 'Revenue CRM', url: 'https://consilegy.com/crm/' },
};
---

<BaseLayout chrome="media"
  title={`${a.data.title} | Revenue CRM | Consilegy`}
  description={a.data.pain}
  lang={lang}
  ogType="article"
  ogImage={ogImagePath(lang, a.data.slug)}
  alternateUrl={mediaPath(lang === 'ja' ? 'en' : 'ja', segment, a.data.slug)}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="media-layout">
  <article class="media-article">
    <nav class="crumbs" aria-label={lang === 'ja' ? 'パンくず' : 'Breadcrumb'}>
      <a href={lang === 'ja' ? '/crm/' : '/en/crm/'}>{t.crumbRoot}</a>
      <span aria-hidden="true">›</span>
      <a href={mediaPath(lang, segment)}>{SEGMENTS[segment][lang]}</a>
      <span aria-hidden="true">›</span>
      <span>{CATEGORIES[a.data.category][lang]}</span>
    </nav>

    <div class="meta">
      <span class="article-category">{CATEGORIES[a.data.category][lang]}</span>
      <span>{t.published} {fmtDate(a.data.date, lang)}</span>
      {a.data.updated && <span>{t.updated} {fmtDate(a.data.updated, lang)}</span>}
    </div>
    <h1>{a.data.title}</h1>
    <div class="byline">{t.author}<span>Consilegy</span></div>

    <img class="eyecatch" src={eyecatchPath(lang, a.data.slug)} alt="" width="1200" height="630" loading="eager" aria-hidden="true" />

    <div class="prose body">
      <Content />
    </div>

    <section class="cta">
      <p>{t.ctaText}</p>
      <div class="cta-links">
        <a class="btn" href={demoUrl} target="_blank" rel="noopener noreferrer">{t.demo}</a>
        <a class="btn ghost" href={lang === 'ja' ? '/free-consultation/' : '/en/contact/'}>{t.consult}</a>
      </div>
    </section>

    <div class="author">
      <b>{t.author}</b>
      <p>{t.authorBio}</p>
    </div>

    {next.length > 0 && (
      <section class="next">
        <h2>{t.readNext}</h2>
        <div class="cards">{next.map((x) => <CrmMediaCard a={x} />)}</div>
      </section>
    )}

    <p class="back"><a href={mediaPath(lang, segment)}>{t.backToList}</a></p>
  </article>
  </div>
</BaseLayout>

<style is:global>
  /* 使い方メディアは白地。サイト共通の stone-50 を使わない。 */
  html { background: #fff; }
</style>

<style>
  .media-layout { max-width:52.5rem; margin:0 auto; padding:2.5rem 1.25rem 6rem; }
  .media-article { width:100%; max-width:50rem; min-width:0; margin:0 auto; }
  .crumbs { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:2rem; font-size:.875rem; color:var(--color-text-muted); }
  .crumbs a { color:inherit; text-decoration:none; } .crumbs a:hover { color:var(--color-primary); }
  .meta { display:flex; flex-wrap:wrap; align-items:center; gap:.75rem 1rem; margin-bottom:1rem; font-size:.875rem; color:var(--color-text-muted); }
  .article-category { font-weight:700; color:var(--color-navy); }
  h1 { margin:0 0 1.25rem; font-size:clamp(1.8rem,3.2vw,2.5rem); line-height:1.45; letter-spacing:-.035em; font-weight:800; color:var(--color-navy); text-wrap:balance; }
  .byline { display:flex; align-items:center; gap:.75rem; font-size:.875rem; font-weight:600; margin-bottom:2rem; color:var(--color-text); }
  .byline span { padding-left:.75rem; border-left:1px solid var(--color-border-strong); color:var(--color-text-muted); font-weight:400; }
  .eyecatch { display:block; width:100%; height:auto; border-radius:6px; margin:0 0 2.5rem; }
  .body { max-width:none; }
  .body :global(h2) { margin:3rem 0 1.25rem; padding:0; border:0; font-size:clamp(1.5rem,2.4vw,1.75rem); line-height:1.5; font-weight:700; letter-spacing:-.02em; color:var(--color-navy); text-wrap:balance; }
  .body :global(h3) { margin:2rem 0 1rem; font-size:1.25rem; font-weight:700; color:var(--color-navy); }
  .body :global(p), .body :global(li) { line-height:2; color:var(--color-text); }
  .body :global(p) { margin-bottom:1.5rem; }
  .body :global(ol), .body :global(ul) { padding-left:1.5rem; margin-bottom:1.5rem; }
  .body :global(li + li) { margin-top:.75rem; }
  .body :global(img) { display:block; width:100%; height:auto; margin:2rem 0 .75rem; border:1px solid var(--color-border); border-radius:6px; }
  .body :global(img + em), .body :global(p:has(> img) + p > em:only-child) { display:block; font-size:.875rem; font-style:normal; line-height:1.7; color:var(--color-text-muted); }
  .cta { margin-top:3rem; padding:2rem; border:1px solid var(--color-border); border-radius:6px; background:var(--color-bg-subtle); }
  .cta p { margin:0 0 1rem; font-weight:600; color:var(--color-navy); }
  .cta-links { display:flex; flex-wrap:wrap; gap:.75rem; }
  .btn { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:.7rem 1.25rem; border:1px solid var(--color-primary); border-radius:4px; background:var(--color-primary); color:#fff; text-decoration:none; font-weight:600; }
  .btn.ghost { background:#fff; color:var(--color-primary); }
  .author { margin-top:3rem; padding:1.5rem 0; border-top:1px solid var(--color-border); }
  .author b { color:var(--color-navy); } .author p { margin:.5rem 0 0; line-height:1.8; color:var(--color-text-muted); }
  .next { margin-top:3rem; padding-top:2rem; border-top:1px solid var(--color-border); }
  .next h2 { font-size:1.5rem; margin:0 0 1.5rem; color:var(--color-navy); }
  .cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.25rem; }
  .back { margin:2rem 0 0; } .back a { color:var(--color-text-muted); }
  @media(max-width:600px) { .media-layout { padding-top:1.75rem; } .crumbs { margin-bottom:1.5rem; } .eyecatch { margin-bottom:2rem; } .cards { grid-template-columns:minmax(0,1fr); } .cta { padding:1.5rem; } .btn { flex:1 1 auto; } }

</style>
