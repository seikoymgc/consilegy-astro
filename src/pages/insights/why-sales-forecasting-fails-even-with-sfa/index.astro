---
import { insightPhoto } from '../../../lib/editorial-photos';
import NewsletterSidebar from '../../../components/NewsletterSidebar.astro';
import InsightHead from '../../../components/InsightHead.astro';
import InsightByline from '../../../components/InsightByline.astro';
import InsightEvidence from '../../../components/InsightEvidence.astro';
import evidenceGuides from '../../../data/insight-evidence.json';
import InsightContents from '../../../components/InsightContents.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const pubDate = '2026-05-07';
const readTime = '約10分';

const evidenceGuide = evidenceGuides["why-sales-forecasting-fails-even-with-sfa"];
const evidenceDescription = evidenceGuide.answer.split("。").slice(0, 2).join("。") + "。";

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: 'SFAを導入しても売上予測が当たらない理由',
	description: evidenceDescription,
	datePublished: pubDate,
	dateModified: '2026-10-30',
	citation: evidenceGuide.sources.map(source => new URL(source.url, 'https://consilegy.com').href),
	author: { '@type': 'Person', name: '山口聖子', alternateName: 'Seiko Yamaguchi', jobTitle: 'Revenue Architect', url: 'https://consilegy.com/company/', worksFor: { '@type': 'Organization', name: 'Consilegy', url: 'https://consilegy.com' } },
	publisher: { '@type': 'Organization', name: 'Consilegy', url: 'https://consilegy.com' },
	url: 'https://consilegy.com/insights/why-sales-forecasting-fails-even-with-sfa/',
	inLanguage: 'ja',
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://consilegy.com/' },
		{ '@type': 'ListItem', position: 2, name: 'コラム', item: 'https://consilegy.com/insights/' },
		{ '@type': 'ListItem', position: 3, name: 'SFAを導入しても売上予測が当たらない理由', item: 'https://consilegy.com/insights/why-sales-forecasting-fails-even-with-sfa/' },
	],
};

// 見出しの id と目次を揃える。公開後は既存の id を変更しない。
const headings = [
	{ id: "direct-answer", text: "最初に押さえる結論" },
	{ id: "decision-checklist", text: evidenceGuide.caption },
	{ id: "verification-steps", text: "自社で確かめる手順" },
	{ id: "evidence-scope", text: "根拠と、この解説の適用範囲" },
	{"id": "section-1", "text": "あなたの組織は大丈夫か。5つの確認項目"},
	{"id": "section-2", "text": "SFAがあっても予測が当たらない3つのパターン"},
	{"id": "section-3", "text": "予測の運用設計と、参照事例の違い"},
	{"id": "section-4", "text": "今週から始められる3つのアクション"},
	{"id": "section-5", "text": "まとめ：予測は時点と変更理由を残して検証する"},
];

---

<BaseLayout
	title="SFAを導入しても売上予測が当たらない理由 | Consilegy"
	description={evidenceDescription}
	hasTranslation={false}
	ogType="article"
	lang="ja"
>
	<Fragment slot="head">
		<InsightHead schema={articleSchema} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

<div class="article-wrap">

	<!-- ===== ARTICLE HEADER ===== -->
	<header class="article-head container">
		<nav class="breadcrumb" aria-label="パンくずリスト">
			<a href="/">ホーム</a>
			<span aria-hidden="true">›</span>
			<a href="/insights/">コラム</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">SFAを導入しても売上予測が当たらない理由</span>
		</nav>
		<div class="article-meta">
			<span class="article-cat">CRM・MA・SFA</span>
		</div>
		<h1>SFAを導入しても<br class="br-pc" />売上予測が当たらない理由</h1>
		<p class="article-desc">{evidenceDescription}</p>
		<InsightByline published={articleSchema.datePublished} modified={articleSchema.dateModified} />
	</header>

	<!-- ===== ARTICLE BODY ===== -->
	<div class="article-body container">

		<InsightContents headings={headings} />
		<div class="article-eyecatch">
			<img
				src={insightPhoto("why-sales-forecasting-fails-even-with-sfa")}
				alt=""
				width="1200"
				height="630"
				class="article-eyecatch__img"
				loading="eager"
				aria-hidden="true"
			/>
		</div>

		<InsightEvidence slug="why-sales-forecasting-fails-even-with-sfa" />

		<div class="article-section">
<p>営業支援システムの案件金額が合っていても、今月受注するかどうかは別の判断です。受注予定日の根拠や予測区分が揃わないと、同じ案件一覧から担当者ごとに異なる見通しが生まれます。</p>
<p>たとえば「提案済み」は営業側が行った作業を示しますが、顧客の決裁・調達・契約確認が終わったことまでは示しません。以下では、B2Bの営業案件について、予測時点の情報と変更を追う方法を解説します。</p>
</div>
<div class="article-section">
<h2 id="section-1">あなたの組織は大丈夫か。5つの確認項目</h2>
<ol class="article-numbered">
<li><strong>予測の基準日が決まっているか</strong><p>月初予測と月中予測を混ぜず、同じ締切の見通しを比較します。</p></li>
<li><strong>受注予定日に顧客側の根拠があるか</strong><p>社内目標の日付と、顧客と確認した意思決定予定を区別します。</p></li>
<li><strong>ステージと予測区分を使い分けているか</strong><p>進行段階と今期に見込む判断について、それぞれの条件を説明できるか確認します。</p></li>
<li><strong>前回からの変更が分かるか</strong><p>金額・日付・ステージ・予測区分のどれが動いたかを追います。</p></li>
<li><strong>予測の誤差を案件別に説明できるか</strong><p>合計の差額だけでなく、期ずれ、失注、金額変更、新規追加に分けます。</p></li>
</ol>
<p class="article-callout">この確認項目は、調査する箇所を選ぶためのものです。該当数で失敗を診断する基準ではありません。</p>
</div>
<div class="article-section">
<h2 id="section-2">SFAがあっても予測が当たらない3つのパターン</h2>
<ol class="article-numbered">
<li><strong>営業の作業完了を顧客の進行と取り違える</strong><p>提案書を送ったことと、顧客が比較・決裁を終えたことは異なります。ステージを進める条件に、顧客側で確認できた事実を含めます。事実がない場合は未確認として扱います。</p></li>
<li><strong>最新の案件一覧で過去の予測を上書きする</strong><p>月末の一覧だけでは、月初に今月受注すると考えていた案件が分かりません。基準日の見通しを保存し、後から追加された案件や翌月にずれた案件を区別します。</p></li>
<li><strong>大きな誤差を合計だけで振り返る</strong><p>一件の大型案件の延期と、多数の小口案件の金額変更では対応が異なります。予測誤差を生んだ案件と理由を確認し、まず直す判断条件を絞ります。</p></li>
</ol>
</div>
<div class="article-section">
<h2 id="section-3">予測の運用設計と、参照事例の違い</h2>
<p>Salesforceの公式資料では、ステージに対応する売上予測区分や、金額・完了予定日・ステージなどのパイプラインの変化を確認する方法が説明されています。これらは変更を調べる手段であり、入力した予測の正しさを自動で保証するものではありません。</p>
<p>一方、<a href="/case-studies/ec-subscription-ltv-data-architecture/">サブスクリプションECのLTVデータ基盤事例</a>は、顧客の継続とチャネル別収益性を投資判断へつなぐ支援です。営業案件の受注予定日や、営業支援システムの予測精度を改善した実績としては扱いません。</p>
<p>継続課金の新規・拡張・縮小・解約を含む見通しは、<a href="/insights/why-sales-forecasting-fails/">売上予測を事業の収益構成から見直す解説</a>で扱います。</p>
</div>
<div class="article-section">
<h2 id="section-4">今週から始められる3つのアクション</h2>
<ol class="article-numbered">
<li><strong>比較する時点を固定する</strong><p>今週の締切時点で、案件ID、見込金額、受注予定日、ステージ、予測区分を保存します。現在の値を更新しても、前回の見通しは残します。</p></li>
<li><strong>変更した案件から確認する</strong><p>前週との金額差と日付の変更を確認し、顧客の状況が変わったのか、入力を訂正したのかを分けて記録します。</p></li>
<li><strong>予測の前提を一つ修正する</strong><p>期ずれが多ければ、決裁予定の確認方法などを見直します。全項目を一度に変えず、翌週も同じ条件で比較します。</p></li>
</ol>
</div>
<div class="article-section">
<h2 id="section-5">まとめ：予測は時点と変更理由を残して検証する</h2>
<p>営業支援システムの導入後も、入力漏れ、設定、データ品質、判断基準、市場の変化は予測へ影響します。原因を一つに断定せず、同じ時点の予測と実績を案件別に照合します。</p>
<p>目指すのは、予測が外れないと言い切ることではありません。何を根拠に見込んで、どの前提が変わったかを説明し、次の見通しに反映できる状態です。</p>
</div>

<!-- ===== CTA ===== -->
		<div class="article-cta">
			<p class="article-cta__catch">案件の見通しと変更を追える予測運用へ</p>
			<p class="article-cta__body">Consilegyは商談ステージ・予測の判断基準・データ連携の設計を支援します。まずは予測と実績の乖離箇所を整理するところから始めましょう。</p>
			<a href="/diagnostic/" class="article-cta__btn">収益を自己診断</a>
		</div>

		<!-- ===== RELATED ===== -->
