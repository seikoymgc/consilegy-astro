---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrmMobile from '../../../components/CrmMobile.astro';
import CrmSubnav from '../../../components/CrmSubnav.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// プロダクトの reseller エディション（src/lib/editions/index.ts）に実装済みの
// ものだけ記載。coreNav は /deals・/companies・/subscriptions、既定で入る
// 自動化は cs-30/31/32/33/35 の5本。文言は src/lib/revops/outcomes.ts と揃える。
const screens = [
	{
		src: 'subscriptions',
		title: '契約と継続収益',
		desc: '契約ごとのマージン率、継続中と解約の件数、MRR・ARR・LTVを1つの画面に表示します。月末にスプレッドシートで集計し直す必要はありません。',
		alt: 'サブスクの画面。MRR ¥765,000・ARR ¥9,180,000・稼働中6件・解約率0.0%・LTV ¥3,060,000のカードが並び、その下にプラン（マージン率つき）・お客様・ステータス・金額・MRRの契約一覧が出ている。',
	},
	{
		src: 'automations',
		title: '更新・解約リスク監視',
		desc: '更新月、健康度の低下、解約の予兆、追加提案の候補を通知します。自動化はセット単位でONにできます。',
		alt: '自動化ライブラリの画面。「更新・解約リスク監視」のセットが4/7 ONで、ONの自動化29件・今すぐON可能138件・設定待ち8件のカード。ライブラリ全体は175件。',
	},
	{
		src: 'deals',
		title: '新規も増席も同じ場所で',
		desc: '新規導入と、増席・追加ライセンスの商談を同じパイプラインで管理できます。ステージごとの金額と件数も確認できます。',
		alt: '商談のカンバン画面。アプローチ・ヒアリング・提案・見積のステージに、トウカイ精機 GuardX 新規導入 ¥1,140,000・ヒカリ食品 DataLens 新規導入 ¥1,680,000・マルヰ商事 WorkCloud 増席（+10席）¥320,000のカードが確度とクローズ予定日つきで並ぶ。',
	},
];

// 痛みは 2026-10-26 の公開調査・導入事例の確認をもとに選んだ（市場で最も強い痛みとは確定していない）。
const problems = [
	{
		title: '顧客ごとの契約内容が、ばらばら',
		text: '顧客ごとの契約プラン、ライセンス数、更新月が、契約書とスプレッドシートに分かれている。',
	},
	{
		title: '更新月が直前に分かる',
		text: '更新月の1か月前に気づき、席数や条件を相談する時間が残っていない。',
	},
	{
		title: '継続売上を数える場所がない',
		text: '複数のSaaSを扱っていて、継続売上とマージンの合計を毎月手で集計し直している。',
	},
];

// 既定で入る更新まわり（reseller の defaultAutomations = cs-23/30/31/32/33/35。cs-23 は
// 健全度の計算で、cs-31/35 の材料。crm PR #299 で足した）。cs-30〜33 は契約の更新日
// （subscriptions.current_period_end）と商談の契約終了日の両方を読む（同じ PR）。
// ただし cs-31（リスク）と cs-33（更新商談）は顧客がつながった契約だけが対象。契約の
// 登録フォームで顧客を選べる（crm #301）。AIは契約・MRR・解約リスクを読める（crm #302）。
// text は src/lib/revops/outcomes.ts の日本語をそのまま使う。label は表示用で、
// 内部キーは出さない。
const renewalEngine = [
	{ label: '更新日', text: '契約の更新日を管理し、近づいたら通知' },
	{ label: '90日前', text: '更新の90日前に、更新アプローチを開始' },
	{ label: 'リスク', text: '更新されない可能性が高い顧客を判定' },
	{ label: '更新商談', text: '更新の時期が来たら、更新の商談を作成' },
	{ label: '解約予兆', text: '解約の予兆を検知して通知' },
];

const roles = [
	{ name: 'オーナー', scope: '全顧客・全契約・請求・権限設定' },
	{ name: '管理者', scope: '運用全般と権限設定' },
	{ name: 'マネージャー', scope: '担当チームの顧客・商談を閲覧・編集' },
	{ name: '営業担当', scope: '自分が担当する顧客と商談のみ' },
];
---

<BaseLayout
	title="Revenue CRM代理店版 | 次の更新が、いつも先に見えている"
	description="SaaS代理店・リセラー向けの画面構成。契約とマージン、MRR・ARR・LTV、更新90日前からの自動アプローチと解約予兆の検知まで。売った後の継続収益を1か所で見られます。2026年9月28日に正式リリース。どのプランも30日間無料で試せます。"
	lang="ja"
	alternateUrl="/en/crm/reseller/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/crm/"},
		{"@type": "ListItem", "position": 3, "name": "代理店版", "item": "https://consilegy.com/crm/reseller/"}
	]
})} />

<CrmSubnav lang="ja" />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM · Reseller edition</p>
			<h1>次の更新が、<br /><span class="nw">いつも先に</span><span class="nw">見えている。</span></h1>
			<p class="hero-lead">
				SaaSの販売代理店・リセラー向けの顧客管理システムです。顧客ごとの契約・ライセンス数・更新月・マージンを1つの画面で管理でき、更新の90日前から更新アプローチを自動で始めます。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href={SIGNUP_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">無料で始める</a>
			</div>
			<p class="hero-download"><a href="/crm/download/">資料をダウンロード</a></p>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/reseller/screen-subscriptions-2026-10c.webp"
				alt="サブスクの画面。MRR ¥765,000・ARR ¥9,180,000・稼働中6件・解約率0.0%・LTV ¥3,060,000のカードと、プランごとのマージン率つき契約一覧。"
				width="1432"
				height="840"
				decoding="async"
			/>
			<figcaption>契約画面：MRR・ARR・LTVと、プランごとのマージンつき契約一覧</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">
				代理店の売上は、<br />
				契約の更新で積み上がります。
			</p>
			<div class="pos-copy">
				<p>
					代理店版の中心は契約です。契約の画面で、契約が継続中か、更新月はいつか、マージンはいくらかを確認できます。
				</p>
				<p>
					新規導入と、増席・追加ライセンスの商談は、同じパイプラインで管理します。既存顧客への追加販売も、新規と同じ一覧で進み具合を確認できます。
				</p>
				<p>
					扱うSaaSごとに、マージン率は異なります。契約ごとに仕入れ額を登録すると、契約ごとのマージン額を確認できます。
				</p>
				<a href="/revenue-architecture/" class="pos-link">この考え方について読む →</a>
			</div>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Problems</p>
			<h2 class="prob-title">顧客ごとの契約・更新時期・継続売上を、まとめて把握できない。</h2>
		</div>
		<div class="prob-grid">
			{problems.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`項目 ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">The screens</p>
			<h2 class="sc-title">毎日開くのは、この3つの画面です。</h2>
		</div>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img
							src={`/images/crm/reseller/screen-${s.src}-2026-10c.webp`}
							alt={s.alt}
							width="1432"
							height="840"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== 更新エンジン ===================== -->
<section class="support">
	<div class="container">
		<figure class="flow-figure" aria-labelledby="flow-figure-caption">
			<svg class="fig-pc" viewBox="0 0 1120 262" role="img" aria-label="更新の流れ：契約、利用、更新90日前のアラート、更新商談、クロスセル">
				<defs><marker id="rs-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<g font-family="inherit">
				<rect x="40" y="60" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="58" y="94" font-size="14" fill="#64748b" letter-spacing="1">Contract</text><text x="58" y="124" font-size="18" font-weight="600" fill="#0F172A">契約</text>
<text x="58" y="184" font-size="16" fill="#475569">顧客・期間・金額</text>
<line x1="228" y1="108" x2="252" y2="108" stroke="#0F172A" stroke-width="2" marker-end="url(#rs-arr)"/>
<rect x="256" y="60" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="274" y="94" font-size="14" fill="#64748b" letter-spacing="1">In use</text><text x="274" y="124" font-size="18" font-weight="600" fill="#0F172A">利用</text>
<text x="274" y="184" font-size="16" fill="#475569">解約予兆を検知</text>
<line x1="444" y1="108" x2="468" y2="108" stroke="#0F172A" stroke-width="2" marker-end="url(#rs-arr)"/>
<rect x="472" y="60" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="490" y="94" font-size="14" fill="#64748b" letter-spacing="1">D-90</text><text x="490" y="124" font-size="18" font-weight="600" fill="#0F172A">更新90日前</text>
<text x="490" y="184" font-size="16" fill="#475569">アラートと担当タスク</text>
<line x1="660" y1="108" x2="684" y2="108" stroke="#0F172A" stroke-width="2" marker-end="url(#rs-arr)"/>
<rect x="688" y="60" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="706" y="94" font-size="14" fill="#64748b" letter-spacing="1">Renewal</text><text x="706" y="124" font-size="18" font-weight="600" fill="#0F172A">更新商談</text>
<text x="706" y="184" font-size="16" fill="#475569">自動作成・進捗を追う</text>
<line x1="876" y1="108" x2="900" y2="108" stroke="#0F172A" stroke-width="2" marker-end="url(#rs-arr)"/>
<rect x="904" y="60" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="922" y="94" font-size="14" fill="#64748b" letter-spacing="1">Expand</text><text x="922" y="124" font-size="18" font-weight="600" fill="#0F172A">クロスセル</text>
<text x="922" y="184" font-size="16" fill="#475569">候補を提案</text>
				<rect x="40" y="206" width="1052" height="40" rx="6" fill="#0F172A"/>
				<text x="566" y="232" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">更新日の管理から更新商談の作成まで、1日1回の自動処理が走る</text>
				</g>
			</svg>
			<svg class="fig-sp" viewBox="0 0 360 740" role="img" aria-label="更新の流れ：契約、利用、更新90日前のアラート、更新商談、クロスセル">
				<defs><marker id="rs-sp-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<g font-family="inherit">
				<rect x="16" y="16" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y="44" font-size="14" letter-spacing="1.5" fill="#64748b">Contract</text>
				<text x="32" y="72" font-size="18" font-weight="600" fill="#0F172A">契約</text>
				<text x="32" y="100" font-size="16" fill="#475569">顧客・期間・金額</text>
				<line x1="180" y1="118" x2="180" y2="140" stroke="#0F172A" stroke-width="2" marker-end="url(#rs-sp-arr)"/>
				<rect x="16" y="144" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y="172" font-size="14" letter-spacing="1.5" fill="#64748b">In use</text>
				<text x="32" y="200" font-size="18" font-weight="600" fill="#0F172A">利用</text>
				<text x="32" y="228" font-size="16" fill="#475569">解約予兆を検知</text>
				<line x1="180" y1="246" x2="180" y2="268" stroke="#0F172A" stroke-width="2" marker-end="url(#rs-sp-arr)"/>
				<rect x="16" y="272" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y="300" font-size="14" letter-spacing="1.5" fill="#64748b">D-90</text>
				<text x="32" y="328" font-size="18" font-weight="600" fill="#0F172A">更新90日前</text>
				<text x="32" y="356" font-size="16" fill="#475569">アラートと担当タスク</text>
				<line x1="180" y1="374" x2="180" y2="396" stroke="#0F172A" stroke-width="2" marker-end="url(#rs-sp-arr)"/>
				<rect x="16" y="400" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y="428" font-size="14" letter-spacing="1.5" fill="#64748b">Renewal</text>
				<text x="32" y="456" font-size="18" font-weight="600" fill="#0F172A">更新商談</text>
				<text x="32" y="484" font-size="16" fill="#475569">自動作成・進捗を追う</text>
				<line x1="180" y1="502" x2="180" y2="524" stroke="#0F172A" stroke-width="2" marker-end="url(#rs-sp-arr)"/>
				<rect x="16" y="528" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y="556" font-size="14" letter-spacing="1.5" fill="#64748b">Expand</text>
				<text x="32" y="584" font-size="18" font-weight="600" fill="#0F172A">クロスセル</text>
				<text x="32" y="612" font-size="16" fill="#475569">候補を提案</text>
				<rect x="16" y="648" width="328" height="76" rx="6" fill="#0F172A"/>
				<text x="180" y="678" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">更新日の管理から更新商談の作成まで、</text>
				<text x="180" y="702" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">1日1回の自動処理が走る</text>
				</g>
			</svg>
			<figcaption id="flow-figure-caption">契約を起点に、利用中の解約の予兆、更新90日前のアプローチ、更新の商談、クロスセルまでを1つの流れで管理します。</figcaption>
		</figure>
	</div>
	<div class="container support-inner">
		<div>
			<p class="section-eyebrow">Renewal engine</p>
			<h2>更新のアプローチと商談を、自動で作成します。</h2>
			<p class="support-lead">
				代理店版では、更新まわりの自動化がONの状態で使い始められます。更新日の管理、90日前のアプローチ、更新の商談の作成、解約の予兆の検知を、1日1回実行します。更新リスクの判定と更新の商談の作成は、契約に顧客をひも付けると動きます。
			</p>
			<p class="support-lead">
				自動化が作るのは、タスク・通知・下書きと、更新の商談です。顧客へのメールは、送る相手と文面を担当者が決めてONにした自動化だけが送ります。
			</p>
		</div>
		<div class="support-list">
			<h3>既定でONになるもの</h3>
			<ul>
				{renewalEngine.map((r) => (
					<li><span>{r.label}</span><strong>{r.text}</strong></li>
				))}
			</ul>
		</div>
	</div>
</section>

<!-- ===================== AI ===================== -->
<section class="ai">
	<div class="container ai-inner">
		<div>
			<p class="section-eyebrow">AI</p>
			<h2>日本語で聞けば、<br />その場で返ってきます。</h2>
			<p class="ai-lead">
				AIに質問すると、契約・顧客・商談の記録と、添付した資料から探して答えます。レポートを作る必要はありません。
			</p>
			<p class="ai-lead">
				更新月が近い契約や、マージン率の低い契約も、質問するだけで確認できます。
			</p>
			<p class="ai-lead">
				コンタクトやタスクの登録もAIに頼めます。AIが顧客へメールを送ることはありません。
			</p>
		</div>
		<ul class="ai-examples">
			<li>今月更新の契約は？</li>
			<li>MRRの内訳を教えて</li>
			<li>解約リスクが高い顧客は？</li>
			<li>利益率が低い契約は？</li>
		</ul>
	</div>
</section>

<CrmMobile />

<!-- ===================== ROLES ===================== -->
<section class="roles">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Permissions</p>
			<h2 class="ro-title">担当顧客の外は、見えないようにできます。</h2>
		</div>
		<p class="ro-lead">
			顧客・会社・商談ごとに、見える範囲を「全体・チーム・自分」から選べます。エクスポートの可否は別に設定できるので、閲覧だけを許可することもできます。下の表は設定の一例です。
		</p>
		<dl class="ro-list">
			{roles.map((r) => (
				<div class="ro-row">
					<dt>{r.name}</dt>
					<dd>{r.scope}</dd>
				</div>
			))}
		</dl>
		<p class="ro-note">契約の一覧は、範囲の設定に関係なく全員に見えます。顧客・会社・商談の変更履歴が残るので、誰がいつ何を変更したかを確認できます。</p>
	</div>
</section>

<!-- ===================== FINAL CTA ===================== -->
<section class="final-cta">
	<div class="container cta-inner">
		<div>
			<p class="cta-eyebrow">30 days free</p>
			<h2>今の業務に合うかは、<br />実際の画面で確かめてください。</h2>
			<p class="cta-lead">
				30日間無料・カード登録不要・初期費用なしで始められます。デモはメールアドレスを入力すると、すぐに開けます。
			</p>
			<div class="cta-actions">
				<a href={SIGNUP_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">無料で始める</a>
				<a href={DEMO_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href="/crm/download/" class="btn btn--secondary">資料をダウンロード</a>
			</div>
		</div>
		<div class="cta-card">
			<h4>デモでお見せする内容</h4>
