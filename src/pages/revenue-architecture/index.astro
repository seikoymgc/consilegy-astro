		letter-spacing: 0.06em;
		color: var(--color-accent, #c2410c);
		margin-bottom: 0.75rem;
	}

	.metrics-callout p:not(.metrics-callout__label) {
		font-size: 0.92rem;
		line-height: 1.9;
		color: var(--color-text, #334155);
	}

	.metrics-callout p + p {
		margin-top: 0.85rem;
	}

	.metrics-note {
		margin-top: 1.5rem;
		font-size: 0.76rem;
		line-height: 1.7;
		color: var(--color-text-muted, #64748b);
	}

	/* ── Japan market data ─────────────────────────────────── */
	.japan-data-lead {
		max-width: 720px;
		margin: 0 auto 2.5rem;
		text-align: center;
		font-size: 0.92rem;
		line-height: 1.9;
		color: var(--color-text, #334155);
	}

	.japan-data-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 1.25rem;
	}

	.japan-data-card {
		padding: 1.5rem;
		background: #fff;
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 8px;
		display: flex;
		flex-direction: column;
	}

	.japan-data-stat {
		font-size: 1.9rem;
		font-weight: 700;
		line-height: 1.1;
		color: var(--color-navy, #0f172a);
		font-feature-settings: 'tnum';
	}

	.japan-data-label {
		margin-top: 0.35rem;
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-accent, #c2410c);
	}

	.japan-data-body {
		margin-top: 0.85rem;
		font-size: 0.85rem;
		line-height: 1.8;
		color: var(--color-text, #334155);
		flex: 1;
	}

	.japan-data-source {
		margin-top: 1rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--color-border, #e2e8f0);
		font-size: 0.7rem;
		line-height: 1.6;
		color: var(--color-text-muted, #64748b);
	}

	.japan-data-caution {
		margin-top: 2rem;
		padding: 1.5rem;
		background: #fff;
		border: 1px dashed var(--color-border, #cbd5e1);
		border-radius: 8px;
	}

	.japan-data-caution__label {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--color-text-muted, #64748b);
		margin-bottom: 0.6rem;
	}

	.japan-data-caution p:not(.japan-data-caution__label) {
		font-size: 0.85rem;
		line-height: 1.9;
		color: var(--color-text, #334155);
	}

	/* ── Sources ───────────────────────────────────────────── */
	.sources-lead {
		max-width: 720px;
		margin: 0 auto 2rem;
		text-align: center;
		font-size: 0.88rem;
		line-height: 1.9;
		color: var(--color-text-muted, #64748b);
	}

	.sources-list {
		max-width: 820px;
		margin-inline: auto;
		padding-left: 1.5rem;
		display: grid;
		gap: 1rem;
	}

	.sources-item {
		font-size: 0.85rem;
		line-height: 1.7;
	}

	.sources-item a {
		color: var(--color-navy, #0f172a);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.sources-meta {
		display: block;
		margin-top: 0.25rem;
		font-size: 0.75rem;
		color: var(--color-text-muted, #64748b);
	}

	@media (max-width: 640px) {
		.metrics-table {
			font-size: 0.78rem;
		}

		.metrics-table th,
		.metrics-table td {
			padding: 0.5rem 0.4rem;
		}

		.japan-data-stat {
			font-size: 1.6rem;
		}
	}

	/* ── Shared utilities ──────────────────────────────────── */
	.container {
		max-width: 1100px;
		margin-inline: auto;
		padding-inline: var(--space-md, 1.5rem);
	}

	.section {
		padding-block: 5rem;
	}

	.section--soft {
		background: var(--color-bg-soft, #f8fafc);
	}

	.section-header {
		text-align: center;
		margin-bottom: 3rem;
	}

	.section-header h2 {
		font-size: clamp(1.4rem, 2.5vw, 2rem);
		font-weight: 600;
		color: var(--color-navy, #0f172a);
		margin-top: 0.5rem;
		line-height: 1.4;
	}

	.eyebrow {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-primary, #1e40af);
		margin: 0;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.75em 1.5em;
		font-size: 0.9rem;
		font-weight: 700;
		border-radius: 6px;
		text-decoration: none;
		transition: background 0.15s, color 0.15s, border-color 0.15s;
	}

	.btn--primary {
		background: var(--color-primary, #1e40af);
		color: #fff;
		border: 2px solid transparent;
	}

	.btn--primary:hover {
		background: var(--color-primary-dark, #1d4ed8);
	}

	.btn--ghost {
		background: transparent;
		color: var(--color-primary, #1e40af);
		border: 2px solid var(--color-primary, #1e40af);
	}

	.btn--ghost:hover {
		background: rgba(30, 64, 175, 0.05);
	}

	/* ── Breadcrumb ────────────────────────────────────────── */
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: 0.4em;
		font-size: 0.8rem;
		color: var(--color-muted, #64748b);
		margin-bottom: 2rem;
	}

	.breadcrumb a {
		color: inherit;
		text-decoration: none;
	}

	.breadcrumb a:hover { color: var(--color-primary, #1e40af); }

	/* ── HERO ──────────────────────────────────────────────── */
	.hero {
		padding-block: 4rem 3.5rem;
		background: #fff;
		border-bottom: 1px solid var(--color-border, #e2e8f0);
	}

	.hero-body {
		display: grid;
		grid-template-columns: 1fr 380px;
		gap: 3rem;
		align-items: start;
	}

	.hero-text .eyebrow { margin-bottom: 0.75rem; }

	.hero-text h1 {
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 600;
		color: var(--color-navy, #0f172a);
		line-height: 1.2;
		margin: 0 0 1.5rem;
	}

	.hero-lead {
		font-size: 1.05rem;
		line-height: 1.8;
		color: var(--color-charcoal, #334155);
		margin: 0 0 1rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	/* ── Hero def card ─────────────────────────────────────── */
	.hero-def-card {
		background: var(--color-navy, #0f172a);
		color: #fff;
		border-radius: 8px;
		padding: 1.75rem;
		position: sticky;
		top: 80px;
	}

	.def-card__label {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(255,255,255,0.5);
		margin: 0 0 0.75rem;
	}

	.def-card__text {
		font-size: 0.92rem;
		line-height: 1.75;
		color: rgba(255,255,255,0.9);
		margin: 0 0 1.25rem;
	}

	.def-card__divider {
		height: 1px;
		background: rgba(255,255,255,0.12);
		margin-bottom: 1.25rem;
	}

	.def-card__attrs {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.def-card__attrs li {
		font-size: 0.82rem;
		color: rgba(255,255,255,0.75);
		display: flex;
		gap: 0.75rem;
	}

	.def-card__attrs li span {
		font-weight: 700;
		color: rgba(255,255,255,0.45);
		min-width: 3em;
		flex-shrink: 0;
	}

	/* ── PROBLEM ───────────────────────────────────────────── */
	.problem-body {
		display: grid;
		grid-template-columns: 1fr;
		gap: 2.5rem;
		align-items: start;
	}

	.problem-text {
		max-width: 760px;
	}

	.problem-text p {
		line-height: 1.8;
		color: var(--color-charcoal, #334155);
		margin: 0 0 1rem;
	}

	.problem-list {
		list-style: none;
		padding: 0;
		margin: 0 0 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.problem-list li {
		padding-left: 1.25rem;
		position: relative;
		color: var(--color-charcoal, #334155);
		line-height: 1.6;
		font-size: 0.95rem;
	}

	.problem-list li::before {
		content: '—';
		position: absolute;
		left: 0;
		color: var(--color-muted, #64748b);
	}

	.problem-conclusion {
		font-weight: 600;
		color: var(--color-navy, #0f172a) !important;
		border-left: 3px solid var(--color-primary, #1e40af);
		padding-left: 1rem;
	}












	/* ── HERO H1 line break ────────────────────────────────── */
	.br-sp { display: none; }

	/* ── HERO直下 定義 ──────────────────────────────────────── */
	.section-def-quick {
		padding-block: 3rem 3.5rem;
		background: #fff;
		border-bottom: 1px solid var(--color-border, #e2e8f0);
	}

	.def-quick-inner {
		max-width: 780px;
		margin-inline: auto;
	}

	.def-quick-inner h2 {
		font-size: clamp(1.15rem, 2vw, 1.45rem);
		font-weight: 600;
		color: var(--color-navy, #0f172a);
		margin: 0 0 1.25rem;
		line-height: 1.45;
	}

	.def-quick-body {
		font-size: 1rem;
		line-height: 1.85;
		color: var(--color-charcoal, #334155);
		margin: 0 0 1.5rem;
	}

	.def-quick-oneline {
		background: var(--color-bg-soft, #f8fafc);
		border-left: 4px solid var(--color-primary, #1e40af);
		border-radius: 0 8px 8px 0;
		padding: 1.1rem 1.5rem;
		font-size: 0.95rem;
		line-height: 1.75;
		color: var(--color-navy, #0f172a);
	}

	/* ── (legacy, kept for other sections) ─────────────────── */
	.def-body {
		max-width: 780px;
		margin-inline: auto;
	}

	.def-long {
		font-size: 1.05rem;
		line-height: 1.85;
		color: var(--color-charcoal, #334155);
		margin: 0 0 2rem;
	}

	.def-oneline {
		background: var(--color-bg-soft, #f8fafc);
		border-left: 4px solid var(--color-primary, #1e40af);
		border-radius: 0 8px 8px 0;
		padding: 1.25rem 1.5rem;
		margin: 0 0 1.5rem;
	}

	.def-oneline p {
		margin: 0;
		font-size: 1rem;
		line-height: 1.7;
		color: var(--color-navy, #0f172a);
	}

	.def-note {
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 8px;
		padding: 1rem 1.25rem;
		font-size: 0.875rem;
		color: var(--color-muted, #64748b);
		line-height: 1.7;
	}

	.def-note p { margin: 0; }

	/* ── WHY / ISSUES ──────────────────────────────────────── */
	.issues-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.issue-card {
		background: #fff;
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 8px;
		padding: 1.25rem;
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
	}

	.issue-num {
		font-size: 0.72rem;
		font-weight: 700;
		color: var(--color-primary, #1e40af);
		opacity: 0.6;
		flex-shrink: 0;
		padding-top: 0.15rem;
	}

	.issue-card p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--color-charcoal, #334155);
		font-weight: 500;
	}

	.issues-note {
		text-align: center;
		font-size: 0.95rem;
		color: var(--color-charcoal, #334155);
		font-weight: 500;
		margin: 0;
	}

	/* ── 4 STRUCTURES ──────────────────────────────────────── */
	.structures-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
		gap: 1.5rem;
	}

	.structure-card {
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 8px;
		padding: 1.75rem 1.5rem;
		background: #fff;
	}

	.structure-num {
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: var(--color-primary, #1e40af);
		margin: 0 0 0.75rem;
	}

	.structure-en {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-navy, #0f172a);
		margin: 0 0 0.75rem;
		line-height: 1.3;
	}

	.structure-desc {
		font-size: 0.875rem;
		line-height: 1.75;
		color: var(--color-charcoal, #334155);
		margin: 0;
	}

	/* ── VS REVOPS ─────────────────────────────────────────── */
	.vs-body {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.vs-text p {
		line-height: 1.8;
		color: var(--color-charcoal, #334155);
		margin: 0 0 1rem;
	}

	.vs-relation {
		margin-top: 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
	}

	.vs-relation-box {
		width: 100%;
		border-radius: 8px;
		padding: 1rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
	}

	.vs-relation-box--top {
		background: var(--color-navy, #0f172a);
		color: #fff;
	}

	.vs-relation-box--top strong { color: #fff; font-size: 0.9rem; }
	.vs-relation-box--top span  { font-size: 0.78rem; color: rgba(255,255,255,0.6); }

	.vs-relation-box--bottom {
		background: var(--color-bg-soft, #f8fafc);
		border: 1px solid var(--color-border, #e2e8f0);
	}

	.vs-relation-box--bottom strong { font-size: 0.9rem; color: var(--color-navy, #0f172a); }
	.vs-relation-box--bottom span   { font-size: 0.78rem; color: var(--color-muted, #64748b); }

	.vs-relation-arrow {
		font-size: 1.25rem;
		color: var(--color-primary, #1e40af);
		line-height: 1;
	}

	.compare-table {
		background: #fff;
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 8px;
		overflow: hidden;
	}

	.compare-table table {
		width: 100%;
		border-collapse: collapse;
	}

	.compare-table thead th {
		padding: 0.875rem 1.25rem;
		font-size: 0.8rem;
		font-weight: 700;
		text-align: left;
		background: var(--color-navy, #0f172a);
		color: #fff;
	}

	.compare-table thead th:first-child {
		background: var(--color-primary, #1e40af);
	}

	.compare-table tbody td {
		padding: 0.7rem 1.25rem;
		font-size: 0.875rem;
		color: var(--color-charcoal, #334155);
		border-bottom: 1px solid var(--color-border, #e2e8f0);
	}

	.compare-table tbody tr:last-child td { border-bottom: none; }

	.compare-table tbody td:first-child {
		font-weight: 600;
		color: var(--color-navy, #0f172a);
		border-right: 1px solid var(--color-border, #e2e8f0);
	}

	.compare-cta {
		display: block;
		padding: 0.875rem 1.25rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--color-primary, #1e40af);
		text-decoration: none;
		border-top: 2px solid var(--color-border, #e2e8f0);
		text-align: right;
	}

	.compare-cta:hover { background: rgba(30, 64, 175, 0.03); }

	/* ── VS CRM ────────────────────────────────────────────── */
	.crm-body {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 3rem;
		align-items: start;
	}

	.crm-text p {
		line-height: 1.8;
		color: var(--color-charcoal, #334155);
		margin: 0 0 1rem;
	}

	.crm-note {
		background: var(--color-bg-soft, #f8fafc);
		border-left: 3px solid var(--color-primary, #1e40af);
		padding: 1rem 1.25rem;
		border-radius: 0 6px 6px 0;
	}

	.crm-note p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--color-charcoal, #334155);
	}

	.crm-compare {
		display: flex;
		align-items: center;
		gap: 1rem;
		background: #fff;
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 8px;
		padding: 1.5rem;
	}

	.crm-compare-col {
		flex: 1;
	}

	.crm-compare-label {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--color-muted, #64748b);
		margin: 0 0 0.75rem;
	}

	.crm-compare-col--ra .crm-compare-label {
		color: var(--color-primary, #1e40af);
	}

	.crm-compare-col ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.crm-compare-col li {
		font-size: 0.85rem;
		color: var(--color-charcoal, #334155);
		padding: 0.3rem 0.6rem;
		border-radius: 4px;
		background: var(--color-bg-soft, #f8fafc);
	}

	.crm-compare-col--ra li {
		background: rgba(30, 64, 175, 0.05);
		color: var(--color-navy, #0f172a);
		font-weight: 500;
	}

	.crm-compare-sep {
		font-size: 1.5rem;
		color: var(--color-primary, #1e40af);
		font-weight: 700;
		flex-shrink: 0;
		align-self: center;
	}

	/* ── FAILURES ──────────────────────────────────────────── */
	.failures-grid {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-bottom: 2rem;
	}

	.failure-tag {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		background: #fff;
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 4px;
		font-size: 0.875rem;
		color: var(--color-charcoal, #334155);
	}

	.failure-dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--color-primary, #1e40af);
		opacity: 0.5;
		flex-shrink: 0;
	}

	.failures-note {
		text-align: center;
		font-size: 0.9rem;
		color: var(--color-muted, #64748b);
		line-height: 1.7;
		max-width: 600px;
		margin-inline: auto;
	}

	/* ── OUTCOMES ──────────────────────────────────────────── */
	.outcomes-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 1.25rem;
	}

	.outcome-card {
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: 8px;
		padding: 1.5rem;
		background: #fff;
	}

	.outcome-num {
		font-size: 0.7rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		color: var(--color-primary, #1e40af);
		margin: 0 0 0.5rem;
		display: block;
	}

	.outcome-label {
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--color-navy, #0f172a);
		margin: 0 0 0.5rem;
		line-height: 1.4;
	}

	.outcome-desc {
		font-size: 0.82rem;
		line-height: 1.65;
		color: var(--color-muted, #64748b);
		margin: 0;
	}

	/* ── CONSILEGY APPROACH ────────────────────────────────── */
	.approach-body {
		max-width: 900px;
		margin-inline: auto;
	}

	.approach-lead {
		font-size: 1rem;
		line-height: 1.85;
		color: var(--color-charcoal, #334155);
		margin: 0 0 1rem;
		text-align: center;
	}

	.pillars {
