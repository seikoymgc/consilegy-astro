---
// /crm/media/<segment>/ の一覧。読者（法人営業 / スクール・教室）ごとに1ページ。カテゴリ3つの順に並べる。
import BaseLayout from '../layouts/BaseLayout.astro';
import CrmMediaCard from './CrmMediaCard.astro';
import CrmMediaSegmentTabs from './CrmMediaSegmentTabs.astro';
import CrmMediaSidebar from './CrmMediaSidebar.astro';
import { CATEGORIES, CATEGORY_ORDER, COPY, SEGMENTS, crmMediaArticles, mediaPath, type Lang, type Segment } from '../lib/crm-media';

interface Props { lang: Lang; segment: Segment }
const { lang, segment } = Astro.props;
const t = COPY[lang];
const sg = SEGMENTS[segment];
const title = lang === 'ja' ? sg.jaTitle : sg.enTitle;
const lead = lang === 'ja' ? sg.jaLead : sg.enLead;
const metaTitle = lang === 'ja' ? sg.jaMetaTitle : sg.enMetaTitle;
const metaDesc = lang === 'ja' ? sg.jaMetaDesc : sg.enMetaDesc;
const all = await crmMediaArticles(lang, segment);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: metaTitle,
  description: metaDesc,
  inLanguage: lang,
  url: new URL(mediaPath(lang, segment), Astro.site ?? 'https://consilegy.com').href,
  about: { '@type': 'SoftwareApplication', name: 'Revenue CRM', url: 'https://consilegy.com/crm/' },
};
---

<BaseLayout chrome="media" title={metaTitle} description={metaDesc} lang={lang} alternateUrl={mediaPath(lang === 'ja' ? 'en' : 'ja', segment)}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="media-page">
    <div class="main">
    <header class="media-head">
      <p class="kicker">{t.kicker}</p>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
    </header>

    <CrmMediaSegmentTabs lang={lang} current={segment} />

    {CATEGORY_ORDER.map((c) => {
      const list = all.filter((a) => a.data.category === c);
      if (list.length === 0) return null;
      return (
        <section class="media-group" id={c}>
          <h2>{CATEGORIES[c][lang]}</h2>
          <p class="group-lead">{CATEGORIES[c].lead[segment][lang]}</p>
          <div class="cards">{list.map((a) => <CrmMediaCard a={a} />)}</div>
        </section>
      );
    })}

    <p class="why"><a href="https://media.consilegy.com/">{t.why}</a></p>
    </div>
    <CrmMediaSidebar lang={lang} segment={segment} />
  </div>
</BaseLayout>

<style is:global>
  /* 使い方メディアは白地。サイト共通の stone-50 を使わない。 */
  html { background: #fff; }
</style>

<style>
  .media-page {
    max-width: 72rem; margin: 0 auto; padding: 2.5rem 1.25rem 5rem;
    display: grid; grid-template-columns: minmax(0, 1fr) 17rem; gap: 3.5rem; align-items: start;
  }
  .main { min-width: 0; }
  @media (max-width: 900px) { .media-page { grid-template-columns: minmax(0, 1fr); gap: 3rem; } }
  .media-head { max-width: 46rem; margin-bottom: 2.5rem; }
  .kicker { margin: 0 0 0.5rem; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-primary); }
  h1 { font-size: clamp(1.5rem, 3.5vw, 2.1rem); line-height: 1.4; margin: 0 0 1rem; letter-spacing: -0.02em; }
  .lead { margin: 0; color: var(--color-text-muted); line-height: 1.9; }
  .media-group { margin-top: 2.75rem; }
  .media-group h2 { font-size: 1.2rem; margin: 0 0 0.35rem; }
  .group-lead { margin: 0 0 1rem; font-size: 0.925rem; color: var(--color-text-muted); max-width: 46rem; line-height: 1.8; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; }
  .why { margin-top: 3.5rem; font-size: 0.875rem; }
  .why a { color: var(--color-text-muted); }
</style>
