---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrmMobile from '../../../components/CrmMobile.astro';
import CrmSubnav from '../../../components/CrmSubnav.astro';
import CrmSupport from '../../../components/CrmSupport.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// 標準版（スタートアップ・中小企業）。機能は src/data/crm-features.ts に載っているものだけ書く。
// 施策と商談のつながりの分析は、2026-10-26 に代表が「できる」と確認。
// 使わない表現（AGENTS.md）：フルAI機能・全部入り・追加料金なし・使い放題・設定済み・AIが学習。
const screens = [
	{
		src: '/images/crm/screen-dashboard-2026-10c.webp', w: 2000, h: 1250,
		title: 'ダッシュボード',
		desc: 'パイプライン、売上予測、受注率を1画面で確かめられます。前回から変わった点は、AIが文章でまとめます。',
		alt: 'ダッシュボードの画面。進行中パイプライン・加重フォーキャスト・今月の受注・勝率のカードと、ステージ別の金額、担当者別の商談一覧が並ぶ。',
	},
	{
		src: '/images/crm/media/screens/business-cards-stay-in-the-drawer-2-2026-10.webp', w: 1456, h: 430,
		title: '名刺の読み取り',
		desc: '名刺を撮るか画像を選ぶと、読み取った内容が連絡先の下書きになります。担当者が確かめてから登録します。',
		alt: '名刺を読み取る画面。どこで会ったかの入力欄と、カメラで撮る・画像を選ぶのボタン。',
	},
	{
		src: '/images/crm/media/screens/waiting-on-the-customer-for-three-months-1-2026-10.webp', w: 1456, h: 822,
		title: '商談',
		desc: 'ステージ、金額、クローズ予定日、これまでのやり取りを同じ画面で確かめられます。止まっている商談は通知でお知らせします。',
		alt: '商談詳細の画面。アプローチから受注までのステージ表示、金額とクローズ予定日、アクティビティの履歴が並ぶ。',
	},
	{
		src: '/images/crm/media/screens/which-automations-to-turn-on-first-1-2026-10.webp', w: 1456, h: 822,
		title: '自動化ライブラリ',
		desc: 'マーケティング、営業、カスタマーサクセスの自動化から、必要なものを選んでONにできます。',
		alt: '自動化ライブラリの画面。商談の抜け漏れ防止・更新リスク管理・メールフォロー自動化などのセットと、ONにできる自動化の件数。',
	},
];

// 4つの痛み（2026-10-26 代表の整理）
const problems = [
	{ title: '交換した名刺が、机に貯まっている。', text: '登録はあとでまとめて。その「あとで」が来ないまま、誰と会ったかが分からなくなる。', href: '/crm/media/b2b/business-cards-stay-in-the-drawer/' },
	{ title: '見込み客はいる。でも、誰から声をかければいい？', text: 'どの見込み客に連絡するか。どの商談を先に進めるか。決めたいのに、判断する材料が手元にない。' },
	{ title: '操作を覚えきれず、結局スプレッドシートに戻る。', text: 'メニューも項目も多すぎて、覚える前に元のやり方に戻ってしまう。' },
	{ title: 'うまくいった提案が、担当者の頭の中にしかない。', text: '顧客とのやり取りも、決まった提案の中身も、ほかのメンバーからは見えない。' },
];

const values = [
	{
		title: '名刺や会議の記録を、AIが下書き',
		text: '名刺は撮るだけで登録できます。手書きのメモやホワイトボード、会議の文字起こし、チャットを貼り付けると、AIが顧客ごとの記録にまとめます。チャットツールとの自動同期は有料オプションです。',
	},
	{
		title: '声をかける相手と止まった商談が分かる',
		text: '見込み客にはスコアが付き、メールの開封やクリックから声をかける相手が分かります。商談の候補になると、AIが次の一手と最初のメッセージ案を用意します。営業には、止まっている商談を通知します。',
	},
	{
		title: 'ふだんの言葉で話しかけて操作できる',
		text: '検索や集計、連絡先やタスクの登録を、AIエージェントに文章で頼めます。項目名やメニューの場所を覚える必要はありません。',
	},
	{
		title: '提案のコツをチームで共有できる',
		text: '顧客情報と活動の履歴は、チーム全員が同じものを見られます。社内のマニュアルや提案のコツは社内Wikiに置き、AIが答えるときの根拠にも使います。',
	},
];

const marketing = [
	{ label: '集める', text: 'フォーム・名刺・問い合わせが、同じ連絡先に入る' },
	{ label: '見極める', text: 'スコアと反応で、声をかける相手が分かる' },
	{ label: '育てる', text: '課題ごとの配信と、休眠した見込み客の掘り起こし' },
	{ label: '振り返る', text: 'どの施策が商談につながったかを見られる' },
];
const sales = [
	{ label: '渡す', text: '担当者を決めて、次の一手と最初のメッセージ案を用意' },
	{ label: '進める', text: '止まっている商談と、対応期限の超過を知らせる' },
	{ label: '見通す', text: '売上予測と、その精度を数字で確認できる' },
];

const roles = [
	{ name: 'オーナー', scope: '全データ・請求・権限の設定' },
	{ name: '管理者', scope: '運用全般と権限の設定' },
	{ name: 'マネージャー', scope: '担当チームの顧客と商談を閲覧・編集' },
	{ name: 'メンバー', scope: '自分が担当の顧客と商談' },
];
---

<BaseLayout
	title="Revenue CRM標準版 | 記録で終わらない顧客管理。マーケティングから営業まで、次の一手をAIと。"
	description="スタートアップ・中小企業のための顧客管理システム。名刺や会議の内容はAIが記録し、見込み客のスコアから止まっている商談まで、マーケティングと営業の次の一手を示します。日本語・英語・繁體中文に対応し、使い慣れた言語で話しかけて操作できます。どのプランも30日間無料で試せます。"
	lang="ja"
	alternateUrl="/en/crm/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/crm/"},
		{"@type": "ListItem", "position": 3, "name": "標準版", "item": "https://consilegy.com/crm/standard/"}
	]
})} />

<CrmSubnav lang="ja" />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM · Standard edition</p>
			<h1><span class="nw">記録で終わらない</span><span class="nw">顧客管理。</span><br /><span class="nw">マーケティングから</span><span class="nw">営業まで、</span><br /><span class="nw">次の一手をAIと。</span></h1>
			<p class="hero-lead">
				声をかけるべき見込み客も、止まっている商談も、システムが見つけて知らせます。名刺や会議の記録はAIが下書きします。スタートアップ・中小企業向けの顧客管理システムです。
			</p>
			<div class="hero-actions">
				<a href={SIGNUP_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">無料で始める</a>
				<a href={DEMO_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">デモを見る</a>
			</div>
			<p class="hero-download"><a href="/crm/download/">資料をダウンロード</a></p>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/media/screens/business-cards-stay-in-the-drawer-1-2026-10.webp"
				alt="ホーム画面「今日の営業状況」。進行中パイプライン・加重フォーキャスト・今月の受注・勝率のカードと、「今やること」のタスク一覧。"
				width="1456"
				height="822"
				decoding="async"
			/>
			<figcaption>ホーム画面：その日にやることが一覧で表示されます</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">
				入力の手間を減らし、<br />
				<span class="nw">次にやることが分かる</span><span class="nw">顧客管理システムです。</span>
			</p>
			<div class="pos-copy">
				<p>
					顧客管理システムが使われなくなる理由は、主に2つあります。入力に手間がかかることと、入力しても次にやることが分からないことです。標準版では、記録をAIが下書きし、入った情報をもとに次にやることを表示します。
				</p>
				<p>
					マーケティングと営業は、同じ連絡先と履歴を使います。フォームから入った見込み客が商談になり、受注するまでを1つの流れで追えるので、どの施策が商談につながったかも同じ画面で確かめられます。
				</p>
				<a href="/revenue-architecture/" class="pos-link">この考え方について読む →</a>
			</div>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Common Problems</p>
			<h2 class="prob-title">こんなことはありませんか？</h2>
		</div>
		<div class="prob-grid prob-grid--4">
			{problems.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`項目 ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					{item.href && <a class="prob-link" href={item.href}>記事を読む →</a>}
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== VALUES ===================== -->
<section class="problem values">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Features</p>
			<h2 class="prob-title">マーケティングから営業まで、次の一手が見える。</h2>
		</div>
		<div class="prob-grid prob-grid--4">
			{values.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`項目 ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== FLOW ===================== -->
<section class="support">
	<div class="container">
		<figure class="flow-figure" aria-labelledby="flow-figure-caption">
			<svg class="fig-pc" viewBox="0 0 1120 236" role="img" aria-label="導入後の仕事の流れ：名刺を撮る、AIが記録、見込み客を評価、次の一手、チームで共有">
				<defs><marker id="st-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<g font-family="inherit">
				<rect x="40" y="20" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="58" y="54" font-size="14" fill="#64748b" letter-spacing="1">Capture</text><text x="58" y="84" font-size="18" font-weight="600" fill="#0F172A">名刺を撮る</text>
				<text x="58" y="144" font-size="16" fill="#475569">カメラで撮るだけ</text>
				<line x1="228" y1="68" x2="252" y2="68" stroke="#0F172A" stroke-width="2" marker-end="url(#st-arr)"/>
				<rect x="256" y="20" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="274" y="54" font-size="14" fill="#64748b" letter-spacing="1">Record</text><text x="274" y="84" font-size="18" font-weight="600" fill="#0F172A">AIが記録</text>
				<text x="274" y="144" font-size="16" fill="#475569">顧客ごとに整理</text>
				<line x1="444" y1="68" x2="468" y2="68" stroke="#0F172A" stroke-width="2" marker-end="url(#st-arr)"/>
				<rect x="472" y="20" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="490" y="54" font-size="14" fill="#64748b" letter-spacing="1">Score</text><text x="490" y="84" font-size="18" font-weight="600" fill="#0F172A">見込み客を評価</text>
				<text x="490" y="144" font-size="16" fill="#475569">スコアと反応で</text>
				<line x1="660" y1="68" x2="684" y2="68" stroke="#0F172A" stroke-width="2" marker-end="url(#st-arr)"/>
				<rect x="688" y="20" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="706" y="54" font-size="14" fill="#64748b" letter-spacing="1">Next</text><text x="706" y="84" font-size="18" font-weight="600" fill="#0F172A">次の一手</text>
				<text x="706" y="144" font-size="16" fill="#475569">AIが提案と下書き</text>
				<line x1="876" y1="68" x2="900" y2="68" stroke="#0F172A" stroke-width="2" marker-end="url(#st-arr)"/>
				<rect x="904" y="20" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="922" y="54" font-size="14" fill="#64748b" letter-spacing="1">Share</text><text x="922" y="84" font-size="18" font-weight="600" fill="#0F172A">チームで共有</text>
				<text x="922" y="144" font-size="16" fill="#475569">同じ商談状況を見る</text>
				<rect x="40" y="180" width="1052" height="40" rx="6" fill="#0F172A"/>
				<text x="566" y="206" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">マーケティングと営業が、同じ連絡先とやり取りの記録の上で動く</text>
				</g>
			</svg>
			<svg class="fig-sp" viewBox="0 0 360 728" role="img" aria-label="導入後の仕事の流れ：名刺を撮る、AIが記録、見込み客を評価、次の一手、チームで共有">
				<defs><marker id="st-sp-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<g font-family="inherit">
				<rect x="16" y="16" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y="44" font-size="14" letter-spacing="1.5" fill="#64748b">Capture</text>
				<text x="32" y="72" font-size="18" font-weight="600" fill="#0F172A">名刺を撮る</text>
				<text x="32" y="100" font-size="16" fill="#475569">カメラで撮るだけ</text>
				<line x1="180" y1="118" x2="180" y2="140" stroke="#0F172A" stroke-width="2" marker-end="url(#st-sp-arr)"/>
				<rect x="16" y="144" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y="172" font-size="14" letter-spacing="1.5" fill="#64748b">Record</text>
				<text x="32" y="200" font-size="18" font-weight="600" fill="#0F172A">AIが記録</text>
				<text x="32" y="228" font-size="16" fill="#475569">顧客ごとに整理</text>
				<line x1="180" y1="246" x2="180" y2="268" stroke="#0F172A" stroke-width="2" marker-end="url(#st-sp-arr)"/>
				<rect x="16" y="272" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y="300" font-size="14" letter-spacing="1.5" fill="#64748b">Score</text>
				<text x="32" y="328" font-size="18" font-weight="600" fill="#0F172A">見込み客を評価</text>
				<text x="32" y="356" font-size="16" fill="#475569">スコアと反応で</text>
				<line x1="180" y1="374" x2="180" y2="396" stroke="#0F172A" stroke-width="2" marker-end="url(#st-sp-arr)"/>
				<rect x="16" y="400" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y="428" font-size="14" letter-spacing="1.5" fill="#64748b">Next</text>
				<text x="32" y="456" font-size="18" font-weight="600" fill="#0F172A">次の一手</text>
				<text x="32" y="484" font-size="16" fill="#475569">AIが提案と下書き</text>
				<line x1="180" y1="502" x2="180" y2="524" stroke="#0F172A" stroke-width="2" marker-end="url(#st-sp-arr)"/>
				<rect x="16" y="528" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y="556" font-size="14" letter-spacing="1.5" fill="#64748b">Share</text>
				<text x="32" y="584" font-size="18" font-weight="600" fill="#0F172A">チームで共有</text>
				<text x="32" y="612" font-size="16" fill="#475569">同じ商談状況を見る</text>
				<rect x="16" y="636" width="328" height="76" rx="6" fill="#0F172A"/>
				<text x="180" y="666" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">マーケティングと営業が、同じ</text>
				<text x="180" y="690" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">連絡先と記録の上で動く</text>
				</g>
			</svg>
			<figcaption id="flow-figure-caption">名刺の撮影から、商談をチームで共有するまでの流れです。記録はAIが下書きし、次の一手の候補はシステムが表示します。マーケティングが育てた見込み客は、そのまま営業へ引き継げます。</figcaption>
		</figure>
	</div>
	<div class="container support-inner">
		<div class="support-list">
			<h3>マーケティング</h3>
			<ul>
				{marketing.map((r) => (
					<li><span>{r.label}</span><strong>{r.text}</strong></li>
				))}
			</ul>
		</div>
		<div class="support-list">
			<h3>営業</h3>
			<ul>
				{sales.map((r) => (
					<li><span>{r.label}</span><strong>{r.text}</strong></li>
				))}
			</ul>
		</div>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">The screens</p>
			<h2 class="sc-title">よく使う4つの画面</h2>
		</div>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" />
					</figure>
					<div>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== INTERNATIONAL ===================== -->
<section class="intl">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">International Teams</p>
			<h2 class="prob-title">言語も商習慣も違うメンバーが、同じ顧客情報で働ける。</h2>
		</div>
		<p class="intl-lead">
			画面は日本語・English・繁體中文から、使う人ごとに選べます。データは共通なので、言語が違うメンバーも同じ顧客情報と商談の状況を確かめられます。AIの要約や提案も、見る人の言語で表示されます。稟議待ちの商談や、受注後に来期計上になる商談もそのまま管理できます。
		</p>
		<div class="intl-grid">
			<figure>
				<img src="/images/crm/screen-dashboard-2026-10c.webp" alt="日本語で表示したダッシュボード。" width="2000" height="1250" loading="lazy" decoding="async" />
				<figcaption>日本語</figcaption>
			</figure>
			<figure>
				<img src="/images/crm/screen-dashboard-2026-10c-en.webp" alt="同じダッシュボードを英語で表示した画面。" width="2000" height="1250" loading="lazy" decoding="async" />
				<figcaption>English</figcaption>
			</figure>
