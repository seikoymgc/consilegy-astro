		letter-spacing: 0.08em;
	}

	.view-grid {
		gap: 1.25rem;
	}

	.overview-flow {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 1px;
		margin: 0 0 var(--space-lg);
		padding: 0;
