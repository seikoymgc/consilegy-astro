---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrmSubnav from '../../../components/CrmSubnav.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// 料金の数字と条件は、2026-09-14に確定した料金体系（旧 /crm/#pricing）をそのまま移したもの。
// ここを変えるときは /crm/ の料金サマリー、/crm/school/、src/data/crm-faq.ts、英語版も合わせて直す。
const terms = [
	{ label: '初期費用', text: ['かかりません。'] },
	{
		label: '無料期間',
		text: [
			'どのプランも、初回のご利用開始日（最初にログインされた日）から30日間は月額が無料です。',
			'無料期間中も、各プランに含まれる燃料を付与します。',
		],
	},
	{ label: '契約期間', text: ['1ヶ月ごとの自動更新です。'] },
	{
		label: '解約',
		text: [
			'お客さまからは、14日前までにご連絡ください。',
			'当社から提供を終了する場合は、30日前までにお知らせします。',
		],
	},
	{
		label: 'お支払い',
		text: [
			'月額前払いです。クレジットカードでお支払いいただけます（請求書払いはご相談ください）。',
			'月の途中で解約しても、日割りの返金はありません。',
		],
	},
	{
		label: '料金の改定',
		text: [
			'月額料金や、契約期間ごとに付与する燃料を変更する場合は、3ヶ月前までにお知らせします。',
			'追加の燃料とオプションの料金を変更する場合も同じです。',
		],
	},
	{
		label: 'ユーザー数の数え方',
		text: [
			'ワークスペースに参加しているメンバーの数です。招待したまま使っていないアカウントも含みます。',
			'増減は次回のご請求から反映します。',
		],
	},
	{
		label: '生徒数の段が変わるとき',
		text: [
			'上限を超えた状態が14日間続いたら、その後の最初の契約更新日から上の段になります。途中で上限以下に戻ったら数え直します。',
			'契約更新日の時点で下の段の人数以下なら、その契約更新日から下の段になります。',
		],
	},
	{
		label: 'ご契約終了後のデータ',
		text: [
			'終了日から30日間は書き出せます。その後、通常の利用環境上のデータは消去します。',
			'バックアップは、当社所定の保存期間の経過後に消去します。',
		],
	},
	{ label: '消費税', text: ['10%（外税）です。', '適格請求書発行事業者の登録番号はT2010403035111です。'] },
];
---

<BaseLayout
	title="料金 | Revenue CRM | Consilegy"
	description="Revenue CRMの料金。ユーザープランは1人あたり月額3,000円、生徒数プランは月額9,800円から、プリペイドプランは月額3,000円（提供準備中）。AIの処理に使う燃料、オプション、導入支援の目安、ご契約・お支払いの条件をまとめています。"
	lang="ja"
	alternateUrl="/en/crm/pricing/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/crm/"},
		{"@type": "ListItem", "position": 3, "name": "料金", "item": "https://consilegy.com/crm/pricing/"}
	]
})} />

<CrmSubnav lang="ja" />

<section class="pricing pricing--page" id="pricing">
	<div class="container">
		<div class="section-head pricing-page-head">
			<p class="kicker">Revenue CRMの料金</p>
			<h1>使い方に合わせて、3つのプランから選ぶ。</h1>
		</div>
		<div class="price-grid">
			<div class="price-card">
				<p class="price-tier">ユーザープラン</p>
				<p class="plan-for">B2B版／毎日CRMを使う会社に</p>
				<p class="price-figure"><span class="price-yen">¥</span>3,000<span class="price-unit">/ 人 / 月</span></p>
				<dl class="plan-list">
					<div><dt>人数</dt><dd>契約した人数</dd></div>
					<div><dt>基本的な自動処理</dt><dd>月額に含む</dd></div>
					<div><dt>AIの処理</dt><dd>燃料を使う</dd></div>
					<div><dt>契約期間ごとの燃料</dt><dd>1人30（最低100）</dd></div>
					<div><dt>燃料の追加</dt><dd>3,000円で400<span class="price-status">提供準備中</span></dd></div>
					<div><dt>お問い合わせ</dt><dd>使い方・不具合</dd></div>
				</dl>
			</div>
			<div class="price-card">
				<p class="price-tier">生徒数プラン</p>
				<p class="plan-for">B2C（スクール）版／毎日運用しているスクール・教室に</p>
				<p class="price-figure"><span class="price-yen">¥</span>9,800<span class="price-unit">/ 月から</span></p>
				<p class="fuel-note">在籍生徒50人まで9,800円／100人まで19,800円／300人まで39,800円／301人以上は個別見積</p>
				<dl class="plan-list">
					<div><dt>人数</dt><dd>講師・スタッフは無制限</dd></div>
					<div><dt>基本的な自動処理</dt><dd>月額に含む</dd></div>
					<div><dt>AIの処理</dt><dd>燃料を使う</dd></div>
					<div><dt>契約期間ごとの燃料</dt><dd>300／600／1,200</dd></div>
					<div><dt>燃料の追加</dt><dd>3,000円で400<span class="price-status">提供準備中</span></dd></div>
					<div><dt>お問い合わせ</dt><dd>使い方・不具合</dd></div>
				</dl>
			</div>
			<div class="price-card">
				<p class="price-tier">プリペイドプラン<span class="price-status">提供準備中</span></p>
				<p class="plan-for">B2B版・B2C（スクール）版／使う頻度が低い会社や、月によって利用に波がある会社・スクールに</p>
				<p class="price-figure"><span class="price-yen">¥</span>3,000<span class="price-unit">/ 月</span></p>
				<p class="fuel-note">基本料金（燃料100付き）＋必要な分だけチャージ</p>
				<dl class="plan-list">
					<div><dt>人数</dt><dd>無制限</dd></div>
					<div><dt>基本的な自動処理</dt><dd>燃料を使う</dd></div>
					<div><dt>AIの処理</dt><dd>燃料を使う</dd></div>
					<div><dt>契約期間ごとの燃料</dt><dd>100</dd></div>
					<div><dt>燃料の追加</dt><dd>3,000円で100<span class="price-status">提供準備中</span></dd></div>
					<div><dt>お問い合わせ</dt><dd>不具合のみ</dd></div>
				</dl>
			</div>
			<div class="price-note">
				<p>初期費用はありません。どのプランも、初回のご利用開始日から30日間は月額無料です。</p>
				<p>契約は1ヶ月ごとの自動更新です。基本的な自動処理は、受付・送信・自動処理・外部連携を指します。</p>
				<p>プリペイドプランと燃料の追加購入は、提供準備中です。</p>
			</div>
		</div>
		<div class="fuel-block">
			<h3>AIの処理は、燃料で数えます。</h3>
			<p class="fuel-lead">人がCRMを操作する分には、燃料は減りません。代表的な例は次のとおりです。</p>
			<div class="fuel-table-wrap">
			<table class="fuel-table">
				<thead>
					<tr><th>燃料</th><th>代表的な例</th><th>対象プラン</th></tr>
				</thead>
				<tbody>
					<tr><td>1</td><td>名刺・手書きメモの読み取り、音声の書き起こし</td><td>すべてのプラン</td></tr>
					<tr><td>3</td><td>要約、メールの下書き、商談の分析、AIへの質問</td><td>すべてのプラン</td></tr>
					<tr><td>10</td><td>ダッシュボードの提案、添付ファイルの解析</td><td>すべてのプラン</td></tr>
					<tr><td>1件1</td><td>受付・自動送信</td><td>プリペイドプランのみ</td></tr>
					<tr><td>1件3</td><td>会議の取り込み</td><td>プリペイドプランのみ</td></tr>
				</tbody>
			</table>
			</div>
			<p class="fuel-fineprint">ユーザープランと生徒数プランでは、受付・自動送信・会議の取り込みは月額に含みます。燃料は利用開始時と各契約更新日に付与し、繰り越しません。追加分は購入から90日間有効です。処理ごとに使う燃料が増える変更は、30日前にお知らせします。</p>
		</div>
		<div class="fuel-block">
			<h3>オプション</h3>
			<div class="fuel-grid">
				<div class="price-card">
					<p class="price-tier">チャット連携</p>
					<p class="price-figure"><span class="price-yen">¥</span>5,000<span class="price-unit">/ 月</span></p>
					<p class="fuel-note">1ワークスペースあたり。人数に関係なく同じです。</p>
				</div>
				<div class="fuel-option-desc">
					<p>Chatwork・Slackの会話を自動で取り込み、要約して顧客・商談に記録します。</p>
					<p>取り込みでは燃料を使いません。AIによる要約には燃料を使います。</p>
				</div>
			</div>
		</div>
		<div class="fuel-block">
			<h3>導入・定着・運用の支援</h3>
			<p class="fuel-lead">料金の目安です。</p>
			<div class="fuel-grid fuel-grid--4">
				<div class="price-card">
					<p class="price-tier">操作動画・ヘルプ記事</p>
					<p class="price-figure">無料</p>
				</div>
				<div class="price-card">
					<p class="price-tier">導入支援</p>
					<p class="price-figure"><span class="price-yen">¥</span>120,000<span class="price-unit">〜</span></p>
				</div>
				<div class="price-card">
					<p class="price-tier">定着支援（3ヶ月）</p>
					<p class="price-figure"><span class="price-yen">¥</span>300,000<span class="price-unit">〜</span></p>
				</div>
				<div class="price-card">
					<p class="price-tier">運用支援</p>
					<p class="price-figure"><span class="price-yen">¥</span>30,000<span class="price-unit">/ 月〜</span></p>
				</div>
			</div>
			<p class="fuel-tail">データ移行・外部連携は別途お見積りします。各プランに、個別の設定代行・業務設計・運用コンサルティングは含みません。</p>
		</div>
		<div class="fuel-block">
			<h3>紹介プログラム</h3>
			<p class="fuel-lead">ご紹介いただいた会社が有料契約を始めてから12ヶ月間、その会社の基本プランの月額利用料金（税抜）の20%を紹介した側の利用料金からお引きします。</p>
		</div>
		<p class="proof-note">※価格はすべて税抜表示です。</p>
	</div>
</section>

<section class="terms" id="terms">
	<div class="container">
		<div class="section-head">
			<p class="kicker">ご契約・お支払い</p>
			<h2>ご契約・お支払いの条件</h2>
		</div>
		<div class="terms-table-wrap">
			<table class="terms-table">
				<tbody>
					{terms.map((row) => (
						<tr>
							<th scope="row">{row.label}</th>
							<td>{row.text.map((line) => <p>{line}</p>)}</td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</div>
</section>

<section class="pricing-cta">
	<div class="container">
		<h2>最初の30日間は、月額無料で使えます。</h2>
		<div class="hero-actions">
			<a href={SIGNUP_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">無料で始める</a>
			<a href={DEMO_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">デモを見る</a>
			<a href="/crm/faq/" class="btn btn--secondary">よくある質問</a>
		</div>
	</div>
</section>

</BaseLayout>

<style>
	.kicker {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: none;
	}

	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		margin: 0;
		color: var(--color-text);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.4;
		text-wrap: balance;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0.8rem 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.25;
		text-decoration: none;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.btn--primary {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
	}

	.btn--primary:hover {
		background: var(--color-primary-dark);
		border-color: var(--color-primary-dark);
		color: #fff;
	}

	.btn--secondary {
		background: transparent;
		color: var(--color-text);
	}

	.btn--secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-lg);
	}

	.section-head {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		gap: var(--space-lg);
		align-items: start;
		margin-bottom: var(--space-lg);
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	@media (max-width: 760px) {

		.section-head {
			grid-template-columns: 1fr;
		}

		.section-head {
			gap: 0.75rem;
		}

		h2 {
			font-size: 1.625rem;
		}

		.hero-actions {
			flex-direction: column;
		}

		.btn {
			width: 100%;
		}
	}

	/* ── 2. PROOF band ───────────────────────────────────── */
	.proof-note {
		margin: var(--space-md) 0 0;
		font-size: 0.78rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	/* ── 7. PRICING ──────────────────────────────────────── */
	.pricing {
		padding: var(--space-2xl) 0;
		background: #fff;
		border-top: 1px solid var(--color-border);
	}
	.price-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-md);
		align-items: stretch;
	}
	.price-card {
		min-width: 0;
		padding: var(--space-md);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-bg);
	}
	.price-tier {
		margin: 0 0 0.5rem;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--color-primary);
	}
	.price-figure {
		margin: 0;
		font-size: clamp(1.8rem, 3.2vw, 2.4rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.price-yen { font-size: 0.6em; margin-right: 0.1em; }
	.price-unit {
		margin-left: 0.4em;
		font-size: 0.42em;
		font-weight: 500;
		color: var(--color-text-muted);
	}
	.price-note {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.75rem;
		grid-column: 1 / -1;
		padding: var(--space-md) 0 0;
		border-top: 1px solid var(--color-border);
	}
	.plan-for {
		margin: 0 0 0.75rem;
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}
	.price-status {
		display: inline-block;
		margin-left: 0.5em;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-text-muted);
	}
	.plan-list {
		margin: var(--space-md) 0 0;
		border-top: 1px solid var(--color-border);
	}
	.plan-list div {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.1rem 0.75rem;
		padding: 0.55rem 0;
		border-bottom: 1px solid var(--color-border);
		font-size: 0.85rem;
		line-height: 1.5;
	}
	.plan-list dt { color: var(--color-text-muted); }
	.plan-list dd { margin: 0; font-weight: 700; text-align: right; }
	.plan-list .price-status { font-weight: 500; }
	.fuel-option-desc {
		grid-column: span 2;
		align-self: center;
	}
	.fuel-option-desc p { margin: 0 0 0.5rem; max-width: 62ch; }
	.fuel-option-desc p:last-child {
		margin: 0;
		font-size: 0.9rem;
		color: var(--color-text-muted);
	}
	.fuel-block {
		margin-top: var(--space-lg);
		padding-top: var(--space-lg);
		border-top: 1px solid var(--color-border);
	}
	.fuel-block h3 {
		margin: 0 0 0.75rem;
		font-size: clamp(1.2rem, 2.4vw, 1.5rem);
		letter-spacing: -0.01em;
	}
	.fuel-lead,
	.fuel-tail {
		margin: 0 0 var(--space-md);
		max-width: 62ch;
	}
	.fuel-tail { margin: var(--space-md) 0 0; }
	.fuel-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-md);
		align-items: stretch;
	}
	.fuel-table {
		width: 100%;
		border-collapse: collapse;
		margin: 0 0 var(--space-md);
		font-size: 0.95rem;
	}
	.fuel-table th,
	.fuel-table td {
		padding: 0.7rem 0.9rem;
		text-align: left;
		border-bottom: 1px solid var(--color-border);
		vertical-align: top;
	}
	.fuel-table th {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--color-primary);
		white-space: nowrap;
	}
	.fuel-table td:nth-child(1),
	.fuel-table td:nth-child(3) { white-space: nowrap; }
	.fuel-table td:nth-child(1) { font-weight: 700; }
	.fuel-table-wrap { overflow-x: auto; }
	.fuel-table { min-width: 34rem; }
	.fuel-fineprint {
		margin: 0 0 var(--space-md);
		font-size: 0.85rem;
		color: var(--color-text-muted);
	}
	.fuel-note {
		margin: 0.75rem 0 0;
		font-size: 0.9rem;
		color: var(--color-text-muted);
	}
	.price-note p {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.8;
		color: var(--color-text-muted);
	}
	.fuel-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	@media (max-width: 960px) {
		.price-grid { grid-template-columns: 1fr; }
		.fuel-grid,
		.fuel-grid--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.fuel-option-desc { grid-column: span 1; }
	}
	@media (max-width: 480px) {
		.fuel-grid,
		.fuel-grid--4 { grid-template-columns: 1fr; }
		.fuel-table { min-width: 0; font-size: 0.85rem; }
		.fuel-table th,
		.fuel-table td { padding: 0.6rem 0.45rem; }
	}

	/* ── SmartHR型の情報設計に合わせた表示調整 ─────────────── */
	h1,
	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		font-size: 2rem;
		font-weight: 600;
		line-height: 1.42;
	}

	.pricing {
		padding: 5.25rem 0;
	}

