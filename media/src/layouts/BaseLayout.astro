---
import '../styles/global.css';
import { editorialTeam } from '../data/editorial';
import { technicalTerms } from '../data/technical-terms.mjs';
import Analytics from '../components/Analytics.astro';
import { categories, categoriesEn, type CategoryKey } from '../content.config';
import { GTM_ID, PRIVACY_URL_JA, PRIVACY_URL_EN, MEDIA_TAGLINE_JA, MEDIA_TAGLINE_EN } from '../site-config';

interface Crumb {
	name: string;
	url?: string;
}

interface Props {
	title: string;
	description: string;
	ogType?: 'website' | 'article';
	noindex?: boolean;
	publishedAt?: Date;
	updatedAt?: Date;
	lang?: 'ja' | 'en';
	ogImage?: string;
	/** 対になる日本語ページのパス。無い場合は hreflang を出さない */
	jaPath?: string;
	/** 対になる英語ページのパス。無い場合は hreflang を出さない */
	enPath?: string;
	/** パンくず。先頭から順に並べる。最後の要素は url 省略可 */
	breadcrumbs?: Crumb[];
	/** Article schema の articleSection に入れるカテゴリ名 */
	section?: string;
	/** Article schema の headline。省略時は title（サイト名付き）を使う */
	headline?: string;
}

const {
	title,
	description,
	ogType = 'website',
	noindex = false,
	publishedAt,
	updatedAt,
	lang = 'ja',
	ogImage: ogImageProp,
	jaPath,
	enPath,
	breadcrumbs,
	section,
	headline,
} = Astro.props;
const isEn = lang === 'en';

const site = Astro.site ?? new URL('https://media.consilegy.com');
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(Astro.url.pathname);
const ogImage = abs(ogImageProp ?? '/images/og-default-2026-10.png');

// hreflang: 日英の対になるURLが両方揃っているときだけ出す。
// 片側しか無い状態で出すと相互参照にならず、Googleに無視される。
const hasPair = Boolean(jaPath && enPath);

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': 'https://consilegy.com/#organization',
	name: 'Consilegy合同会社',
	alternateName: 'Consilegy LLC',
	url: 'https://consilegy.com',
	sameAs: ['https://www.linkedin.com/company/consilegy', 'https://note.com/consilegy'],
};

const articleSchema =
	ogType === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'Article',
				headline: headline ?? title,
				description,
				url: canonical,
				mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
				image: [ogImage],
				inLanguage: isEn ? 'en' : 'ja',
				...(section ? { articleSection: section } : {}),
				datePublished: publishedAt?.toISOString(),
				dateModified: (updatedAt ?? publishedAt)?.toISOString(),
				author: editorialTeam(lang),
				publisher: { '@id': 'https://consilegy.com/#organization' },
				isPartOf: {
					'@type': 'Blog',
					'@id': isEn ? abs('/en/') : abs('/'),
					name: isEn ? 'B2B Revenue Strategy Journal' : 'B2Bレベニュー戦略ジャーナル',
				},
			}
		: null;

// 記事の isPartOf が指している Blog ノードを、トップページ側で実際に定義する。
// 定義しないと @id の参照先が存在せず、構造化データのグラフがつながらない。
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';
const blogSchema = isHome
	? {
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'WebSite',
					'@id': `${abs('/')}#website`,
					url: abs('/'),
					name: isEn ? 'B2B Revenue Strategy Journal' : 'B2Bレベニュー戦略ジャーナル',
					inLanguage: isEn ? 'en' : 'ja',
					publisher: { '@id': 'https://consilegy.com/#organization' },
				},
				{
					'@type': 'Blog',
					'@id': canonical,
					url: canonical,
					name: isEn ? 'B2B Revenue Strategy Journal' : 'B2Bレベニュー戦略ジャーナル',
					description,
					inLanguage: isEn ? 'en' : 'ja',
					isPartOf: { '@id': `${abs('/')}#website` },
					publisher: { '@id': 'https://consilegy.com/#organization' },
					author: editorialTeam(lang),
				},
			],
		}
	: null;

const breadcrumbSchema =
	breadcrumbs && breadcrumbs.length > 1
		? {
				'@context': 'https://schema.org',
				'@type': 'BreadcrumbList',
				itemListElement: breadcrumbs.map((crumb, i) => ({
					'@type': 'ListItem',
					position: i + 1,
					name: crumb.name,
					...(crumb.url ? { item: abs(crumb.url) } : {}),
				})),
			}
		: null;
import CookieBanner from '../components/CookieBanner.astro';
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>(function(){var v;try{v=localStorage.getItem('cslg_cookie_consent')}catch(e){}if(v!=='denied')return;var w=window;w.dataLayer=w.dataLayer||[];var g=function(){w.dataLayer.push(arguments)};g('consent','default',{analytics_storage:'denied',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied'});w.clarity=w.clarity||function(){(w.clarity.q=w.clarity.q||[]).push(arguments)};w.clarity('consent',false);})();</script>
		{
			GTM_ID && (
				<>
					<link rel="preconnect" href="https://www.googletagmanager.com" />
					<script
						is:inline
						set:html={`(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${GTM_ID}');`}
					/>
				</>
			)
		}
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{
			hasPair && (
				<>
					<link rel="alternate" hreflang="ja" href={abs(jaPath!)} />
					<link rel="alternate" hreflang="en" href={abs(enPath!)} />
					<link rel="alternate" hreflang="x-default" href={abs(jaPath!)} />
				</>
			)
		}

		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content={isEn ? 'en_US' : 'ja_JP'} />
		{hasPair && <meta property="og:locale:alternate" content={isEn ? 'ja_JP' : 'en_US'} />}
		<meta property="og:site_name" content={isEn ? 'B2B Revenue Strategy Journal' : 'B2Bレベニュー戦略ジャーナル'} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@600;700&display=swap"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon-2026b.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon-2026b.ico" />
		{
			isEn ? (
				<link rel="alternate" type="application/rss+xml" title="B2B Revenue Strategy Journal (English)" href="/en/rss.xml" />
			) : (
				<link rel="alternate" type="application/rss+xml" title="B2Bレベニュー戦略ジャーナル" href="/rss.xml" />
			)
		}

		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		{blogSchema && <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />}
		{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
		{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
		<slot name="head" />
	</head>
	<body>
		{
			GTM_ID && (
				<noscript>
					<iframe
						src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
						height="0"
						width="0"
						style="display:none;visibility:hidden"
						title="Google Tag Manager"
					/>
				</noscript>
			)
		}
		{GTM_ID && <Analytics />}
		<CookieBanner lang={lang} privacyUrl={isEn ? PRIVACY_URL_EN : PRIVACY_URL_JA} />
		<a class="skip-link" href="#main-content">{isEn ? 'Skip to content' : '本文へ移動'}</a>
		<div class="publication-bar"><div class="container"><span>{isEn ? 'INSIGHTS FOR REVENUE LEADERS' : MEDIA_TAGLINE_JA}</span><a href={isEn ? 'https://consilegy.com/en/' : 'https://consilegy.com/'}>Published by Consilegy ↗</a></div></div>
		<header class="site-header">
			<div class="container site-header__inner">
				<a href={isEn ? '/en/' : '/'} class="site-brand">
					<span class="site-brand__eyebrow">CONSILEGY / REVENUE INSIGHTS</span>
					<span class="site-brand__name">{isEn ? 'B2B Revenue Strategy Journal' : 'B2Bレベニュー戦略ジャーナル'}</span>
				</a>
				<nav class="site-nav" aria-label={isEn ? 'Site navigation' : 'サイト内ナビゲーション'}>
					{isEn ? (
						<>
							<a href="/en/">Articles</a>
							<a href="https://consilegy.com/en/">Consilegy ↗</a>
							<a href="/">日本語</a>
							<a href="https://consilegy.com/en/contact-en/" class="site-nav__btn">Talk to us</a>
						</>
					) : (
						<>
							<a href="/articles/">記事一覧</a>
							<a href="https://consilegy.com/" class="site-nav__ext">運営会社 ↗</a>
							<a href="/en/">EN</a>
							<a href="https://consilegy.com/contact/" class="site-nav__btn">お問い合わせ</a>
						</>
					)}
				</nav>
			</div>
			<div class="topic-nav"><nav class="container" aria-label={isEn ? 'Topics' : 'テーマ別ナビゲーション'}>
				<a href={isEn ? '/en/articles/' : '/articles/'} aria-current={Astro.url.pathname === (isEn ? '/en/articles/' : '/articles/') ? 'page' : undefined}>{isEn ? 'All articles' : 'すべての記事'}</a>
				{(Object.keys(categories) as CategoryKey[]).map(key => {
					const href = isEn ? `/en/category/${key}/` : `/category/${key}/`;
					return <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{isEn ? categoriesEn[key] : categories[key]}</a>;
				})}
			</nav></div>
		</header>

		<main id="main-content">
			<slot />
		</main>

		<footer class="site-footer">
			{isEn ? (
				<div class="container site-footer__cols">
					<div>
						<p class="site-footer__brand">B2B Revenue Strategy Journal</p>
						<p class="site-footer__desc">{MEDIA_TAGLINE_EN} Published by Consilegy LLC.</p>
					</div>
					<nav aria-label="Articles">
						<p class="site-footer__head">Read</p>
						<a href="/en/">Latest</a>
						<a href="/en/articles/">All articles</a>
						<a href="/en/about/">Editorial team</a>
						<a href="/en/rss.xml">RSS</a>
						<a href="/">日本語版</a>
					</nav>
					<nav aria-label="Company">
						<p class="site-footer__head">Consilegy</p>
						<a href="https://consilegy.com/en/">Corporate site</a>
						<a href="https://consilegy.com/en/services-en/japan-market-gtm-messaging/">Japan Market GTM</a>
						<a href="https://consilegy.com/en/contact-en/">Contact</a>
						<a href={PRIVACY_URL_EN}>Privacy policy</a>
					</nav>
				</div>
			) : (
				<div class="container site-footer__cols">
					<div>
						<p class="site-footer__brand">B2Bレベニュー戦略ジャーナル</p>
						<p class="site-footer__desc">{MEDIA_TAGLINE_JA} 運営はConsilegy合同会社。</p>
					</div>
					<nav aria-label="カテゴリ">
						<p class="site-footer__head">カテゴリ</p>
						<a href="/category/crm/">CRM・SFA</a>
						<a href="/category/sales/">営業・商談管理</a>
						<a href="/category/data/">データ・KPI</a>
						<a href="/category/japan-gtm/">日本市場・GTM</a>
						<a href="/category/adoption/">組織・運用定着</a>
						<a href="/category/marketing/">マーケティング</a>
					</nav>
					<nav aria-label="サイト">
						<p class="site-footer__head">サイト</p>
						<a href="/articles/">記事一覧</a>
						<a href="/about/">編集部について</a>
						<a href="/en/">English edition</a>
						<a href="/rss.xml">RSS</a>
					</nav>
					<nav aria-label="Consilegy">
						<p class="site-footer__head">Consilegy</p>
						<a href="https://consilegy.com/">本体サイト</a>
						<a href="https://consilegy.com/revenue-architecture/">レベニューアーキテクチャとは</a>
						<a href="https://consilegy.com/diagnostic/">収益構造の無料診断</a>
						<a href="https://consilegy.com/newsletter/">ニュースレター</a>
						<a href="https://consilegy.com/free-consultation/">無料相談</a>
						<a href={PRIVACY_URL_JA}>プライバシーポリシー</a>
					</nav>
				</div>
			)}
			<div class="container site-footer__bottom">
				{!isEn && ogType !== 'article' && <dl class="term-guide" aria-label="用語の説明">{Object.entries(technicalTerms).map(([term, label]) => <div><dt>{term}</dt><dd>（{label}）</dd></div>)}</dl>}
				<p>&copy; 2025 Consilegy LLC.</p>
			</div>
		</footer>
	</body>
</html>
