.fork-third {
	margin-top: 1.5rem; padding: 1.5rem 2rem;
	background: rgba(15, 23, 42, 0.04); border: 1px solid var(--color-border);
	border-radius: var(--radius-card);
	display: flex; align-items: center; justify-content: space-between;
	gap: 1.5rem; flex-wrap: wrap;
}
.fork-third p { margin: 0; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.75; }
.fork-third__btn {
	flex-shrink: 0; display: inline-flex; align-items: center;
	background: var(--color-primary); color: #fff;
	padding: 0.75rem 1.5rem; font-weight: 500; font-size: 0.875rem;
	text-decoration: none; border: none; transition: background 0.15s;
}
.fork-third__btn:hover { background: var(--color-primary-dark); }

/* ── Why ──────────────────────────────────────────── */
.why {
	background:
		radial-gradient(900px 480px at 88% 0%, rgba(124,92,191,0.08), transparent 60%),
		radial-gradient(720px 420px at 0% 100%, rgba(59,130,246,0.09), transparent 60%),
		linear-gradient(180deg, #F7F8FC 0%, #EFF2F9 100%);
	border-top: 1px solid var(--color-border);
	border-bottom: 1px solid var(--color-border);
}
.why-grid {
	display: grid; grid-template-columns: 1fr 1.1fr; gap: 5rem; align-items: start;
}
.why-head h2 {
	font-size: clamp(1.625rem, 2.4vw, 2.125rem); font-weight: 500;
	line-height: 1.2; letter-spacing: -0.02em; color: var(--color-text);
	margin: 0 0 1.75rem;
}

.why-claim {
	margin: 0 0 1.5rem; font-size: 1.125rem; font-weight: 500;
	line-height: 1.75; color: var(--color-text); letter-spacing: -0.01em;
}
.why-anecdote {
	margin: 0 0 1.75rem; padding: 1.25rem 1.5rem;
	background: rgba(15, 23, 42, 0.05); border-left: 3px solid var(--color-border-strong);
}
.why-anecdote p { margin: 0; font-size: 0.9375rem; line-height: 1.8; color: var(--color-text); }
.why-anecdote strong { font-weight: 600; color: var(--color-text); }
.why-stat {
	margin: 1.25rem 0 0; padding-top: 1.25rem; border-top: 1px solid var(--color-border);
	font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.8;
}
.why-stat strong { font-weight: 600; color: var(--color-text); font-size: 1rem; }
.why-stat__src { display: block; margin-top: 0.375rem; font-size: 0.75rem; color: var(--color-text-muted); }

.why-problems { display: flex; flex-direction: column; gap: 0.875rem; }
.why-problems__label {
	margin: 0 0 0.25rem; font-size: 0.8125rem; font-weight: 500;
	color: var(--color-text-muted); letter-spacing: 0.02em;
}
.why-close {
	margin: 0.75rem 0 0; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.85;
}
.why-close strong { color: var(--color-text); font-weight: 500; }
.layer-desc { margin: 0; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.75; }

/* Symptom layers */
.layer-card {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 1.5rem 1.75rem;
	transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.layer-card:hover {
	transform: translateY(-2px);
	background: var(--glass-bg-strong);
	box-shadow: var(--glass-shadow-hover);
}
.layer-tag {
	display: block; font-size: 0.5625rem; font-weight: 500;
	color: var(--color-text-muted); letter-spacing: 0.14em; text-transform: uppercase;
	border-top: 1.5px solid var(--color-border); padding-top: 0.75rem; margin-bottom: 0.75rem;
}
.layer-title {
	margin: 0 0 0.875rem; font-size: 1.125rem; font-weight: 500;
	letter-spacing: -0.01em; color: var(--color-text);
}
.layer-items { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-direction: column; gap: 0.375rem; }
.layer-items li {
	font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.65;
	padding-left: 1.125rem; position: relative;
}
.layer-items li::before {
	content: ""; position: absolute; left: 0; top: 0.6em;
	width: 5px; height: 5px; background: var(--color-navy); opacity: 0.4;
}
.layer-cause {
	margin: 0; padding-top: 0.75rem; border-top: 1px solid var(--color-border);
	font-size: 0.8125rem; color: var(--color-text); line-height: 1.65;
}
.layer-cause span {
	display: inline-block; margin-right: 0.625rem;
	font-size: 0.625rem; font-weight: 500; letter-spacing: 0.08em;
	color: var(--color-navy); background: rgba(15, 23, 42, 0.08);
	padding: 0.15rem 0.5rem; vertical-align: 0.1em;
}

/* ── How ──────────────────────────────────────────── */
.how {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
}
.how-grid {
	display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center;
}
.how-copy h2 {
	font-size: clamp(1.75rem, 2.6vw, 2.5rem); font-weight: 500;
	line-height: 1.2; letter-spacing: -0.02em; color: var(--color-text);
	margin: 0 0 1.75rem;
}

/* Flow diagram */
.flow-diagram {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 2rem;
	display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
}
.flow-step {
	width: 100%;
	background: rgba(255,255,255,0.5); border: 1px solid rgba(255,255,255,0.7);
	border-radius: var(--radius);
	padding: 0.875rem 1.25rem;
	display: flex; flex-direction: column; align-items: flex-start; gap: 0.25rem;
}
.flow-step--top { background: rgba(59,130,246,0.09); border-color: rgba(96,165,250,0.3); }
.flow-step--mid { background: rgba(59,130,246,0.06); border-color: rgba(96,165,250,0.22); }
.flow-step--bot { background: rgba(124,92,191,0.07); border-color: rgba(167,139,250,0.25); }
.flow-label { font-size: 0.625rem; font-weight: 500; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
.flow-tools { font-size: 0.8125rem; font-weight: 500; color: var(--color-text); }
.flow-arrow { font-size: 1rem; color: var(--color-primary); opacity: 0.35; line-height: 1; }
.flow-center {
	width: 100%;
	background: linear-gradient(135deg, rgba(112,66,172,0.92), rgba(29,78,216,0.88));
	backdrop-filter: blur(8px);
	-webkit-backdrop-filter: blur(8px);
	border-radius: var(--radius);
	box-shadow: 0 8px 24px rgba(112,66,172,0.25);
	padding: 1rem 1.25rem; text-align: center;
	display: flex; flex-direction: column; gap: 0.25rem;
}
.flow-center-label { font-size: 0.8125rem; font-weight: 500; color: #fff; }
.flow-center-sub { font-size: 0.6875rem; color: rgba(255,255,255,0.92); }
.flow-kpi {
	margin-top: 0.25rem; width: 100%;
	display: flex; align-items: center; gap: 0.5rem;
	font-size: 0.6875rem; color: var(--color-text-muted);
	background: rgba(255,255,255,0.45); padding: 0.625rem 1rem;
	border: 1px solid rgba(255,255,255,0.65);
	border-radius: var(--radius);
}
.flow-kpi-arrow { color: var(--color-primary); font-weight: 500; }

.how-points { list-style: none; padding: 0; margin: 1.75rem 0 2rem; display: flex; flex-direction: column; gap: 2rem; }
.how-points li { display: flex; gap: 1.5rem; align-items: flex-start; }
/* Editorial: ghosted large number as visual anchor */
.how-num {
	flex-shrink: 0; min-width: 3rem;
	color: var(--color-navy); opacity: 0.18;
	display: inline-flex; align-items: flex-start; justify-content: flex-end;
	font-size: 3rem; font-weight: 500; letter-spacing: -0.05em;
	line-height: 0.85; margin-top: 0.125rem; border: none;
}
.how-points strong { display: block; font-size: 0.9375rem; font-weight: 500; color: var(--color-text); margin-bottom: 0.25rem; }
.how-points p { margin: 0; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.75; }
.how-points .how-terms { margin-top: 0.5rem; font-size: 0.8125rem; color: var(--color-text-muted); letter-spacing: 0.01em; }

.btn--outline-primary {
	display: inline-flex; align-items: center;
	background: transparent; color: var(--color-primary);
	padding: 0.75rem 1.25rem;
	font-weight: 500; font-size: 0.875rem; text-decoration: none;
	border: 1px solid var(--color-primary);
	transition: all 0.15s ease;
}
.btn--outline-primary:hover { background: rgba(15, 23, 42, 0.05); }

/* ── After（動き出したあと） ─────────────────────────── */
.after {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
}
.after-head { max-width: 640px; }
.after-list {
	display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem;
}
.after-item {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 1.875rem;
}
/* 最初の2つは全員に共通する日常なので、幅を取って先に読ませる */
.after-item:first-child { grid-column: span 2; }
.after-item h3 {
	margin: 0 0 0.75rem; font-size: 1.0625rem; font-weight: 500;
	line-height: 1.5; letter-spacing: -0.01em; color: var(--color-text);
}
.after-item p { margin: 0; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.85; }
.after-item strong { font-weight: 600; color: var(--color-text); }
.after-item--metric { border-top: 2px solid rgba(112,66,172,0.25); }

.after-close {
	margin: var(--space-xl) 0 0; text-align: center;
	font-size: clamp(1.25rem, 2.2vw, 1.75rem); font-weight: 500;
	line-height: 1.5; letter-spacing: -0.02em; color: var(--color-text);
}
.after-close span { color: var(--color-text-muted); font-size: 0.9375rem; font-weight: 400; letter-spacing: 0; }

/* ── Assurance（担保） ─────────────────────────────── */
.assurance {
	background:
		radial-gradient(820px 460px at 100% 0%, rgba(59,130,246,0.07), transparent 60%),
		linear-gradient(180deg, #F4F6FB 0%, var(--color-bg) 100%);
	border-top: 1px solid var(--color-border);
}
.assurance-head { max-width: 760px; }
.assurance-tagline {
	font-size: clamp(1.75rem, 3.2vw, 3rem) !important;
	font-weight: 500; line-height: 1.15; letter-spacing: -0.02em;
	color: var(--color-navy); margin: 0 0 0.75rem !important;
}
.assurance-ja {
	margin: 0 0 1.5rem; font-size: 1rem; font-weight: 500;
	color: var(--color-text); letter-spacing: -0.01em;
}
.assurance-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: var(--space-xl); }
.as-card {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 2rem;
	transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.as-card:hover {
	transform: translateY(-3px);
	background: var(--glass-bg-strong);
	box-shadow: var(--glass-shadow-hover);
}
.as-num {
	display: block; font-size: 2.5rem; font-weight: 500;
	color: var(--color-navy); opacity: 0.18;
	letter-spacing: -0.05em; line-height: 0.9; margin-bottom: 0.875rem;
}
.as-card h3 {
	margin: 0 0 0.75rem; font-size: 1.0625rem; font-weight: 500;
	line-height: 1.45; letter-spacing: -0.01em; color: var(--color-text);
}
.as-card p { margin: 0; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.8; }

/* ── Track record（実績） ──────────────────────────── */
.track {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
}
.track-head { max-width: 680px; }
.track-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--color-border); }
.track-item {
	display: grid; grid-template-columns: 320px 1fr; gap: 2rem; align-items: baseline;
	padding: 1.5rem 0; border-bottom: 1px solid var(--color-border);
}
.track-who {
	display: flex; flex-direction: column; gap: 0.25rem;
	font-size: 0.9375rem; font-weight: 500; color: var(--color-text);
}
.track-size { font-size: 0.75rem; font-weight: 400; color: var(--color-text-muted); letter-spacing: 0.04em; }
.track-result { margin: 0; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.75; }
.track-result strong { font-weight: 600; color: var(--color-text); }
.track-foot { margin: 1.5rem 0 0; font-size: 0.875rem; color: var(--color-text-muted); }
.track-more { margin: var(--space-lg) 0 0; }

/* ── Founder（誰がやるか） ─────────────────────────── */
.founder {
	background:
		radial-gradient(700px 400px at 0% 0%, rgba(124,92,191,0.07), transparent 60%),
		linear-gradient(180deg, #F3F5FB 0%, #EEF2F9 100%);
	border-top: 1px solid var(--color-border);
}
.founder-inner { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 4rem; align-items: center; }
.founder-photo {
	border-radius: var(--radius-card); overflow: hidden;
	box-shadow: var(--glass-shadow); background: var(--color-bg-subtle);
}
.founder-photo img { width: 100%; height: auto; display: block; aspect-ratio: 4/5; object-fit: cover; }
.founder-copy h2 {
	font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 500;
	line-height: 1.2; letter-spacing: -0.02em; color: var(--color-text); margin: 0 0 1.5rem;
}
.founder-bio { margin: 0 0 1rem; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.9; }
.founder-quote {
	margin: 1.75rem 0; padding: 1.25rem 1.5rem;
	background: rgba(255,255,255,0.55); border-left: 3px solid var(--color-border-strong);
	font-size: 1rem; font-weight: 500; color: var(--color-text); line-height: 1.75;
}

/* ── Pricing（料金） ───────────────────────────────── */
.pricing {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
}
.pricing-head { max-width: 640px; margin-bottom: var(--space-lg); }
.pricing-block {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 2rem 2.25rem; margin-bottom: 1.25rem;
}
.pricing-for {
	margin: 0 0 1.25rem; padding-bottom: 0.875rem;
	border-bottom: 1px solid var(--color-border);
	font-size: 1rem; font-weight: 500; color: var(--color-text);
	display: flex; align-items: baseline; gap: 0.875rem; flex-wrap: wrap;
}
.pricing-for__note { font-size: 0.75rem; font-weight: 400; color: var(--color-text-muted); }
.price-rows { display: flex; flex-direction: column; }
.price-row {
	display: grid; grid-template-columns: 5rem 1fr auto; gap: 1rem;
	align-items: baseline; padding: 0.75rem 0;
}
.price-row + .price-row { border-top: 1px solid var(--color-border); }
.price-row--single { grid-template-columns: 1fr auto; padding-top: 0; }
.price-step {
	font-size: 0.625rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
	color: var(--color-navy);
}
.price-name { font-size: 0.9375rem; color: var(--color-text); }
.price-amount { font-size: 1rem; font-weight: 500; color: var(--color-text); white-space: nowrap; }
.pricing-note { margin: 0.5rem 0 0; font-size: 0.8125rem; color: var(--color-text-muted); }

.pricing-guide { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border); }
.pricing-guide__label { margin: 0 0 0.75rem; font-size: 0.8125rem; font-weight: 500; color: var(--color-text-muted); }
.pricing-guide ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
.pricing-guide li {
	display: flex; align-items: baseline; gap: 0.875rem; flex-wrap: wrap;
	font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.6;
}
.pricing-guide li::before { content: "→"; color: var(--color-navy); opacity: 0.5; }
.pricing-guide em {
	font-style: normal; font-size: 0.75rem; font-weight: 500; color: var(--color-navy);
	background: rgba(15, 23, 42, 0.08); padding: 0.15rem 0.5rem;
}
.pricing-diag {
	margin: 1.25rem 0 0; padding: 0.875rem 1.125rem;
	background: rgba(15, 23, 42, 0.05); border-left: 3px solid var(--color-border-strong);
	font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.75;
}
.pricing-diag strong { color: var(--color-text); font-weight: 500; }
.pricing-link {
	display: inline-block; margin-top: 1.25rem;
	font-size: 0.9375rem; font-weight: 500; color: var(--color-primary);
	text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px;
}
.pricing-link:hover { color: var(--color-primary-dark); }

/* ── Industries（業界） ────────────────────────────── */
.industries {
	background: linear-gradient(180deg, #F2F5FB 0%, #EDF1F9 100%);
	border-top: 1px solid var(--color-border);
}
.industries-head { max-width: 640px; }
.ind-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
.ind-card {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 2rem;
}
.ind-card h3 {
	margin: 0 0 1rem; font-size: 1.0625rem; font-weight: 500;
	color: var(--color-text); letter-spacing: -0.01em;
}
.ind-card p { margin: 0 0 0.875rem; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.85; }
.ind-card p:last-child { margin-bottom: 0; }

.fork-src, .ind-src {
	display: block; margin-top: 0.5rem;
	font-size: 0.75rem; color: var(--color-text-muted); line-height: 1.7;
}
.fork-body strong, .ind-stat strong { color: var(--color-text); font-weight: 600; }
.ind-stat {
	margin: 0 0 0.875rem; padding: 0.875rem 1rem;
	background: rgba(15, 23, 42, 0.05); border-left: 3px solid var(--color-border-strong);
	font-size: 0.875rem !important; color: var(--color-text) !important; line-height: 1.75;
}

/* ── Flag（旗） ────────────────────────────────────── */
.flag {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
}
.flag-inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: 4rem; align-items: start; }
.flag-inner h2 {
	font-size: clamp(1.625rem, 2.8vw, 2.5rem); font-weight: 500;
	line-height: 1.2; letter-spacing: -0.02em; color: var(--color-text); margin: 0;
}
.flag-body p { margin: 0 0 1rem; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.9; }
.flag-body strong { color: var(--color-text); font-weight: 600; }
.flag-claim {
	font-size: 1.125rem !important; font-weight: 500; color: var(--color-text) !important;
	letter-spacing: -0.01em; margin: 1.5rem 0 !important;
	padding-left: 1rem; border-left: 3px solid var(--color-border-strong);
}
.flag-body .btn--outline-primary { margin-top: 0.75rem; }

/* ── Blog ──────────────────────────────────────────── */
.blog-section {
	background:
		radial-gradient(820px 480px at 5% 100%, rgba(124,92,191,0.07), transparent 60%),
		radial-gradient(700px 400px at 100% 0%, rgba(59,130,246,0.07), transparent 55%),
		linear-gradient(180deg, #F3F5FB 0%, #EEF2F9 100%);
	border-top: 1px solid var(--color-border);
	border-bottom: 1px solid var(--color-border);
}
.blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
/* Editorial: first card is a featured wide card */
@media (min-width: 769px) {
	.blog-card:first-child { grid-column: span 2; }
	.blog-card:first-child .blog-card__link { flex-direction: row; }
	/* アイキャッチはタイトル文字を含むので、切ると読めなくなる。比率を維持する */
	.blog-card:first-child .blog-card__link { align-items: stretch; }
	.blog-card:first-child .blog-img { flex: 0 0 54%; aspect-ratio: 1200 / 630; align-self: center; }
	.blog-card:first-child .blog-body { padding: 2rem; justify-content: center; }
	.blog-card:first-child .blog-title { font-size: 1.25rem; line-height: 1.4; }
	.blog-card:first-child .blog-desc { -webkit-line-clamp: 3; }
}
.blog-card {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	overflow: hidden;
	display: flex; flex-direction: column;
	transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.blog-card:hover {
	transform: translateY(-3px);
	background: var(--glass-bg-strong);
	box-shadow: var(--glass-shadow-hover);
}
.blog-card__link {
	display: flex; flex-direction: column;
	height: 100%; text-decoration: none; color: inherit;
}
.blog-img {
	position: relative;
	aspect-ratio: 1200 / 630;
	overflow: hidden;
	background: #1C1917;
	flex-shrink: 0;
}
.blog-img__asset {
	width: 100%; height: 100%;
	object-fit: cover; display: block;
	transition: transform .3s ease;
}
.blog-card:hover .blog-img__asset { transform: scale(1.02); }
.blog-new {
	position: absolute; top: 10px; right: 10px;
	font-size: .5625rem; font-weight: 500; letter-spacing: .08em;
	background: var(--color-navy); color: #fff; padding: 3px 8px;
}
.blog-cat {
	display: inline-block; align-self: flex-start;
	margin-bottom: 0.5rem;
	font-size: .625rem; font-weight: 500; letter-spacing: .1em;
	color: var(--color-navy); background: rgba(15, 23, 42, 0.08);
	padding: 0.2rem 0.6rem;
}
.blog-body {
	display: flex; flex-direction: column; gap: 0;
	padding: 1.25rem 1.5rem; flex-grow: 1;
}
.blog-title {
	margin: 0 0 0.5rem; font-size: .9375rem; font-weight: 400;
	line-height: 1.55; color: var(--color-text); flex-grow: 1;
}
.blog-card:hover .blog-title { color: var(--color-primary); }
.blog-desc {
	margin: 0 0 0.875rem; font-size: .8125rem; color: var(--color-text-muted); line-height: 1.75;
	display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
	overflow: hidden;
}
.blog-foot {
	display: flex; align-items: center; gap: 10px;
	padding-top: 0.75rem; border-top: 1px solid var(--color-border);
	margin-top: auto;
}
.blog-arrow {
	margin-left: auto; font-size: .8125rem; color: var(--color-primary);
	transition: transform .18s ease;
}
.blog-card:hover .blog-arrow { transform: translateX(4px); }

/* ── Newsletter CTA strip ──────────────────────────── */
.nl-cta-strip {
	background:
		radial-gradient(600px 300px at 80% 50%, rgba(96,165,250,0.12), transparent 65%),
		linear-gradient(135deg, #F5F7FD 0%, #EDF2FB 100%);
	
	border-bottom: 1px solid var(--color-border);
	padding-block: 3rem;
}
.nl-cta-strip__inner {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 2rem;
	flex-wrap: wrap;
}
.nl-cta-strip__eyebrow {
	display: block; font-size: 0.5625rem; font-weight: 500; letter-spacing: 0.14em;
	text-transform: uppercase; color: var(--color-text-muted);
	margin: 0 0 0.875rem;
	border-top: 1.5px solid var(--color-border); padding-top: 0.75rem;
}
.nl-cta-strip__copy h2 {
	font-size: clamp(1.5rem, 2.5vw, 2.5rem); font-weight: 500;
	color: var(--color-text); margin: 0 0 0.5rem; line-height: 1.2; letter-spacing: -0.02em;
}
.nl-cta-strip__copy p {
	font-size: 0.875rem; color: var(--color-text-muted);
	margin: 0; line-height: 1.7;
}
.nl-cta-strip__btn {
	display: inline-flex; align-items: center; white-space: nowrap; flex-shrink: 0;
	background: var(--color-primary); color: #fff;
	padding: 0.75rem 1.5rem;
	font-weight: 500; font-size: 0.875rem; text-decoration: none;
	border: none; transition: background 0.15s;
}
.nl-cta-strip__btn:hover { background: var(--color-primary-dark); }
@media (max-width: 640px) {
	.nl-cta-strip__inner { flex-direction: column; align-items: flex-start; }
}

/* ── Final CTA ─────────────────────────────────────── */
.final-cta {
	background:
		radial-gradient(800px 400px at 85% -5%, rgba(167,139,250,0.35), transparent 60%),
		radial-gradient(600px 360px at 0% 100%, rgba(96,165,250,0.25), transparent 55%),
		linear-gradient(135deg, #1e40af 0%, #1d4ed8 100%);
	color: #fff;
}
.cta-inner {
	display: grid; grid-template-columns: 1.2fr 1fr;
	gap: 4rem; align-items: center;
}
.cta-eyebrow {
	display: block; font-size: 0.625rem; font-weight: 500; color: rgba(255,255,255,0.92);
	letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 1.25rem;
	border-top: 1px solid rgba(255,255,255,0.15); padding-top: 0.875rem;
}
.cta-copy h2 {
	color: #fff; font-size: clamp(2.5rem, 4.5vw, 5rem);
	line-height: 1.05; font-weight: 500; margin: 0 0 1.75rem; letter-spacing: -0.03em;
}
.cta-lead { color: rgba(255,255,255,0.92); font-size: 1rem; line-height: 1.8; margin: 0 0 1rem; }
.cta-lead--close { margin-bottom: 2rem; }
.cta-lead--close strong { color: #fff; font-weight: 500; }
.cta-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

.btn--cta-primary {
	display: inline-flex; align-items: center; justify-content: center;
	padding: 0.875rem 1.75rem;
	font-weight: 500; font-size: 0.9375rem; text-decoration: none;
	background: #fff; color: var(--color-primary); border: none;
	transition: background 0.15s ease; white-space: nowrap;
}
.btn--cta-primary:hover { background: #F5F5F4; color: var(--color-primary); }

.btn--cta-outline {
	display: inline-flex; align-items: center; justify-content: center;
	padding: 0.875rem 1.75rem;
	font-weight: 400; font-size: 0.9375rem; text-decoration: none;
	background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.38);
	transition: all 0.15s ease; white-space: nowrap;
}
.btn--cta-outline:hover { border-color: #fff; background: rgba(255,255,255,0.07); }

.cta-checklist {
	background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.22);
	border-radius: var(--radius-card);
	backdrop-filter: blur(16px) saturate(1.3);
	-webkit-backdrop-filter: blur(16px) saturate(1.3);
	box-shadow: 0 8px 32px rgba(0,0,0,0.12);
	padding: 2rem;
}
.cta-checklist h4 {
	margin: 0 0 1rem; font-size: 0.5625rem; color: rgba(255,255,255,0.78);
	letter-spacing: 0.1em; text-transform: uppercase; font-weight: 500;
}
.cta-checklist ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0; }
.cta-checklist li {
	display: flex; align-items: flex-start; gap: 0.75rem;
	padding: 0.5625rem 0; font-size: 0.875rem; color: rgba(255,255,255,0.92);
	border-bottom: 1px solid rgba(255,255,255,0.07); line-height: 1.55;
}
.cta-checklist li:last-child { border-bottom: none; }
.cta-checklist li::before {
	content: ""; flex-shrink: 0; margin-top: 9px;
	width: 4px; height: 4px; background: rgba(255,255,255,0.35);
}

/* ── Responsive ─────────────────────────────────────── */

/* ── 構成統合（2026-08-20）：サブ見出し・統合ブロック ── */
.proof { display: grid; gap: 0.75rem; }
.proof__row .tools-label { margin-bottom: 0.35rem; }
.tools-note { font-size: 0.6875rem; color: rgba(255,255,255,0.78); margin-left: 0.25rem; }
.sub-head { margin-bottom: var(--space-lg); }
.sub-head .section-eyebrow, .why-flag .section-eyebrow { border-top: 0; padding-top: 0; margin-bottom: 0.75rem; }
.sub-head h3 {
	font-size: clamp(1.375rem, 2.2vw, 1.875rem); font-weight: 500;
	line-height: 1.25; letter-spacing: -0.02em; color: var(--color-text); margin: 0;
}
.why-flag {
	display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 2rem 4rem; align-items: start;
	margin-top: var(--space-xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border);
}
.why-flag h3 {
	font-size: clamp(1.25rem, 1.8vw, 1.5rem); font-weight: 500;
	line-height: 1.25; letter-spacing: -0.02em; color: var(--color-text); margin: 0;
}
.how-after { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border); }
.after-list--three { grid-template-columns: repeat(3, 1fr); }
.after-list--three .after-item:first-child { grid-column: auto; }
.track-industries { margin-top: var(--space-xl); }
.track-more { margin-top: var(--space-xl); }
.founder-assurance { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border); }
.founder-assurance .assurance-grid { margin-top: var(--space-lg); }
.nl-cta-strip--inline { margin-top: var(--space-2xl); padding: 2rem 2rem; border-radius: var(--radius-card); }
.nl-cta-strip--inline h3 {
	font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 500;
	color: var(--color-text); margin: 0 0 0.5rem; line-height: 1.2; letter-spacing: -0.02em;
}

/* ── Design tuning: FV画像は残しつつ、過剰な光・ガラス表現を抑える ── */
.hero::before {
	content: "";
	position: absolute;
	inset: 0;
	z-index: 0;
	background: rgba(12, 17, 28, 0.62);
}
.hero-bg { display: none; }
.hero-inner { padding-block: 5.25rem 4.25rem; }
.hero-copy { max-width: 620px; }
.hero-copy h1 {
	font-size: clamp(2.25rem, 4.25vw, 4.125rem);
	line-height: 1.12;
	letter-spacing: 0;
	margin-bottom: 1.5rem;
}
.hero-symptoms {
	gap: 0;
	margin-bottom: 1.5rem;
	border-top: 1px solid rgba(255,255,255,0.18);
	border-bottom: 1px solid rgba(255,255,255,0.18);
}
.hero-symptoms li {
	padding: 0.58rem 0;
	border-left: 0;
	border-bottom: 1px solid rgba(255,255,255,0.14);
	color: rgba(255,255,255,0.92);
	font-size: 1rem;
}
.hero-symptoms li:last-child { border-bottom: 0; }
.hero-lead {
	max-width: 560px;
	margin-bottom: 1.55rem;
	color: rgba(255,255,255,0.92);
	font-size: 1rem;
	line-height: 1.78;
}
.hero-proof {
	margin-top: 1rem;
	color: rgba(255,255,255,0.78);
	letter-spacing: 0.06em;
}
.hero-inline-link {
	color: rgba(255,255,255,0.92);
	text-decoration-color: rgba(255,255,255,0.78);
}
.btn--hero-primary,
.btn--hero-outline,
.btn--cta,
.btn--outline-primary,
.btn--cta-primary,
.btn--cta-outline,
.fork-third__btn,
.nl-cta-strip__btn {
	border-radius: 4px;
}
.btn--hero-primary { color: #111827; }
.btn--hero-outline {
	border-color: rgba(255,255,255,0.78);
	color: rgba(255,255,255,0.92);
}
.hero-tools {
	background: rgba(18, 24, 36, 0.92);
	backdrop-filter: none;
	-webkit-backdrop-filter: none;
	border-top-color: rgba(255,255,255,0.14);
}
.tools-label { color: rgba(255,255,255,0.78); }
.tools-row { color: rgba(255,255,255,0.92); }
.tools-sep { color: rgba(255,255,255,0.4); }

.fork,
.why,
.how,
.after,
.assurance,
.track,
.pricing,
.industries,
.blog-section {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
	border-bottom: 0;
}
.why,
.assurance,
.industries,
.nl-cta-strip {
	background: var(--color-bg-subtle);
}
.fork-card,
.layer-card,
.flow-diagram,
.after-item,
.as-card,
.pricing-block,
.ind-card,
.blog-card {
	background: #fff;
	backdrop-filter: none;
	-webkit-backdrop-filter: none;
	border: 1px solid var(--color-border);
	border-radius: 6px;
	box-shadow: none;
}
.fork-card { border-top: 2px solid var(--color-border); }
.fork-card--consulting { border-top-color: var(--color-border-strong); }
.layer-card:hover,
.as-card:hover,
.blog-card:hover {
	transform: none;
	box-shadow: none;
	background: #fff;
}
.flow-center {
	background: var(--color-navy);
	backdrop-filter: none;
	-webkit-backdrop-filter: none;
	box-shadow: none;
}
.nl-cta-strip {
	border-top: 1px solid var(--color-border);
	background: var(--color-bg-subtle);
}
.final-cta {
	background: #0F172A;
}
.cta-copy h2 { letter-spacing: 0; }
.cta-checklist {
	background: rgba(255,255,255,0.08);
	backdrop-filter: none;
	-webkit-backdrop-filter: none;
	box-shadow: none;
	border-radius: 6px;
}

@media (max-width: 1024px) {
	.why-flag { grid-template-columns: 1fr; gap: 1.25rem; }
	.after-list--three { grid-template-columns: 1fr; }
}

@media (max-width: 1024px) {
	.why-grid { grid-template-columns: 1fr; gap: 2.5rem; }
	.how-grid { grid-template-columns: 1fr; gap: 2.5rem; }
	.fork-grid { grid-template-columns: 1fr; }
	.after-list { grid-template-columns: 1fr; }
	.after-item:first-child { grid-column: auto; }
	.founder-inner { grid-template-columns: 1fr; gap: 2.5rem; }
	.founder-photo { max-width: 320px; }
	.flag-inner { grid-template-columns: 1fr; gap: 2rem; }
}
@media (max-width: 768px) {
	.blog-grid { grid-template-columns: 1fr; }
	.blog-card:nth-child(n+4) { display: none; }
	.cta-inner { grid-template-columns: 1fr; gap: 2rem; }
	.tools-row { gap: 0.25rem 0.5rem; font-size: 0.75rem; }
	.assurance-grid { grid-template-columns: 1fr; }
	.ind-grid { grid-template-columns: 1fr; }
	.track-item { grid-template-columns: 1fr; gap: 0.5rem; }
	.price-row { grid-template-columns: 1fr auto; }
	.price-step { grid-column: 1 / -1; }
	.pricing-block { padding: 1.5rem 1.375rem; }
}
@media (max-width: 560px) {
	.hero-inner { padding-block: 4.5rem 3.25rem; }
	.hero-copy h1 { font-size: 2.25rem; line-height: 1.14; }
	.hero-lead { font-size: 0.9375rem; }
	.hero-actions, .cta-actions { flex-direction: column; }
	.btn--hero-primary, .btn--hero-outline,
	.btn--cta-primary, .btn--cta-outline { width: 100%; justify-content: center; }
}

@media (prefers-reduced-motion: reduce) {
	.layer-card, .as-card, .blog-card,
	.blog-img__asset, .blog-arrow { transition: none; }
	.layer-card:hover, .as-card:hover, .blog-card:hover { transform: none; }
}

/* ===== v2 追加（2026-10-18） ===== */
.hero-symptoms {
	list-style: none;
	padding: 0;
	margin: var(--space-md) 0 var(--space-sm);
	display: grid;
	gap: 0.35rem;
	font-size: 1.05rem;
	color: var(--color-text-muted, #475569);
}
.fork-price {
	margin: var(--space-sm) 0 var(--space-md);
	font-weight: 600;
	font-size: 0.95rem;
}
.fork-card { display: flex; flex-direction: column; }
.fork-price { margin-top: auto; padding-top: var(--space-md); }
.fork-btn { align-self: flex-start; }
.hero-lead--short { margin: 1.25rem 0 1.5rem; font-size: 1.1rem; }
/* 見出しの3行目が「る。」だけで折り返さないよう、句のまとまりで改行する。 */
.hero-phrase { display: inline-block; }
/* 行頭の「の空きを左に出し、ほかの行と文字の左端をそろえる。 */
.hero-phrase--hang { margin-left: -0.5em; }
/* スマホでは3行目の「が、」が行頭に来ないよう、見出しを少しだけ小さくする。 */
@media (max-width: 420px) { .hero-copy h1.hero-h1--v2 { font-size: 1.5rem !important; } }
.hero-actions .btn--cta { padding: 0.95rem 1.6rem; font-size: 1rem; }
.founder--slim { padding-block: var(--space-xl); }
.founder-assurance--solo { max-width: 52rem; margin: 0 auto; padding-top: 0; border-top: 0; text-align: left; }
.assurance-ja--main { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; line-height: 1.4; margin-top: var(--space-xs); }
.assurance-body { margin-top: var(--space-md); line-height: 1.9; }
.after-item .result-metric { display: flex; flex-direction: column; gap: 0.4rem; margin: 1.25rem 0; }
.result-metric strong { font-size: clamp(2.25rem, 3vw, 2.75rem); font-weight: 500; line-height: 1.2; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; color: var(--color-text); }
.result-metric strong span { font-size: 0.875rem; font-weight: 400; letter-spacing: 0; margin-inline: 0.2rem; }
.result-metric__note { font-size: 0.8125rem; font-weight: 500; color: var(--color-text-muted); }
.layer-fix { margin-top: 0.5rem; font-size: 0.95rem; font-weight: 600; color: var(--color-navy); }
.track-list--tags { display: flex; flex-wrap: wrap; gap: 0.6rem; border: 0; }
.track-list--tags .track-item { display: block; border-bottom: 1px solid var(--color-border, #e2e8f0); border: 1px solid var(--color-border, #e2e8f0); border-radius: 999px; padding: 0.5rem 1rem; background: #fff; }
.track-list--tags .track-who { display: inline-flex; align-items: baseline; gap: 0.5rem; font-size: 0.95rem; }
.track-list--tags .track-size { font-size: 0.8rem; }
.track-founder { margin-top: var(--space-lg); max-width: 52rem; line-height: 1.9; }
.track-founder a { font-weight: 600; }
.why--flag-only .why-flag { margin-top: 0; padding-top: 0; border-top: 0; }
.cta-inner--single { grid-template-columns: 1fr; max-width: 56rem; }
.cta-inner--single .cta-copy h2 { font-size: clamp(2rem, 3.6vw, 3.6rem); line-height: 1.2; }
.hero-copy h1.hero-h1--v2 { font-size: clamp(1.75rem, 3vw, 2.65rem); line-height: 1.3; }
.how--after-only { padding-top: var(--space-xl); }
.how--after-only .how-after { margin-top: 0; padding-top: 0; border-top: 0; }

/* ===== v2c: ファーストビューを左右に（左＝見出し、右＝入口2つ） ===== */
.hero-inner { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: 3rem; align-items: center; }
.hero-copy { max-width: none; }
.hero-entries { display: grid; gap: 1rem; max-width: 28rem; width: 100%; justify-self: end; }
.hero-entries__label { margin: 0 0 0.1rem; font-size: 0.8rem; letter-spacing: 0.08em; color: rgba(255,255,255,0.72); }
.hero-entry {
	display: grid; gap: 0.65rem; padding: 1.35rem 1.5rem; border-radius: 6px;
	background: #fff; color: var(--color-text); text-decoration: none;
	border: 1px solid #e5e7eb; transition: background 0.15s, border-color 0.15s;
}
.hero-entry:hover { background: #faf8fd; border-color: #c7b2e3; color: var(--color-text); }
.hero-entry:focus-visible { outline: 2px solid #d8c3ff; outline-offset: 4px; }
.hero-entry__tag { font-size: 1rem; font-weight: 600; line-height: 1.5; color: var(--color-text); }
.hero-entry__state { font-size: 1rem; line-height: 1.6; color: var(--color-text-muted, #475569); }
.hero-entry__answer { font-size: 1rem; font-weight: 600; line-height: 1.5; }
.hero-entry__answer small { display: block; font-size: 0.75rem; font-weight: 400; line-height: 1.7; color: #606573; margin-top: 0.4rem; }
.hero-entry__cta {
	justify-self: start; display: inline-flex; align-items: center; gap: 0.4rem;
	padding: 0.7rem 1.25rem; border-radius: 4px; background: var(--color-secondary); color: #fff;
	font-size: 1rem; font-weight: 700; line-height: 1.2; transition: background 0.15s;
}
.hero-entry:hover .hero-entry__cta { background: var(--color-primary-dark); }
.hero-entry__tools { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.35rem; padding-top: 0.85rem; border-top: 1px solid #ececf0; }
.hero-entry__tools > span { padding: 0.2rem 0.55rem; border-radius: 999px; background: #f3f3f6; color: #555b66; font-size: 0.6875rem; line-height: 1.5; }
.hero-proof strong { font-size: 0.9375rem; font-weight: 600; color: #fff; letter-spacing: 0; }
@media (max-width: 960px) { .hero-inner { grid-template-columns: 1fr; gap: 2rem; } .hero-entries { max-width: none; } }
/* 入口2つはファーストビューの外に出し、背景の階段を隠さない。 */
.entry-band { position: relative; z-index: 2; margin-top: -4.5rem; padding-block: 0 2.5rem; background: linear-gradient(to bottom, transparent 4.5rem, var(--color-bg-subtle, #F1F5F9) 4.5rem); border-bottom: 1px solid var(--color-border); }
/* カードを冒頭の下端に少し重ね、ファーストビューから入口が見えるようにする。 */
.hero-entries--band { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: none; justify-self: stretch; align-items: stretch; }
.hero-entries--band .hero-entry { box-shadow: 0 12px 32px rgb(15 23 42 / .18); align-content: start; padding: 1.75rem 2rem; }
.hero-entries--band .hero-entry__tag { font-size: 1.25rem; font-weight: 700; color: var(--color-navy); }
.hero:has(+ .entry-band) .hero-inner { padding-block: 3.5rem 6.5rem; }
@media (max-width: 768px) { .hero-entries--band { grid-template-columns: 1fr; } }

.hero-subject { display: inline-block; }
.service-summary { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
.service-summary h3 { font-size: 1rem; font-weight: 500; margin: 0 0 1rem; }
