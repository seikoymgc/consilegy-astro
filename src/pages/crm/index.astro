---
import { featureCount } from '../../data/crm-features';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrmSubnav from '../../components/CrmSubnav.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// 概要ページは8セクション。機能の詳細は /crm/features/、料金の詳細と契約条件は /crm/pricing/、
// 質問の全件は /crm/faq/、事業タイプ別の説明は各エディションのページに任せる。

const proofStats = [
	{ figure: '40社以上', label: 'Consilegyが設計してきたB2Bの収益プロセス' },
	{ figure: '175本', label: '標準搭載のRevOpsワークフロー' },
	{ figure: '3言語', label: '日本語 / English / 繁體中文をUIごと切替' },
	{ figure: '掲載', label: 'See News（花蓮視新聞）2026年6月25日' },
];

const outcomes = [
	{
		problem: '顧客リストがExcelとメールに散らばっている',
		answer: '顧客、会社、商談、やりとりが1本の履歴に集まります。',
	},
	{
		problem: '来月いくら入るかを毎回手で集計している',
		answer: 'パイプラインから加重フォーキャストが自動で出ます。',
	},
	{
		problem: '受注した後のフォローと契約更新が後手に回る',
		answer: '更新期日と停滞をワークフローが検知して、担当者に通知します。',
	},
];

const editions = [
	{
		noun: '商談',
		title: '法人営業',
		text: '見込み客を商談として管理。パイプライン、見積、フォーキャスト、停滞アラートに対応。',
		href: '/crm/features/',
		linkLabel: `機能一覧を見る（全${featureCount()}項目）`,
	},
	{
		noun: '案件',
		title: '支援会社・受託開発',
		text: '見積、受注、納品、請求、保守更新までを案件単位で管理。',
		href: '/crm/contractor/',
		linkLabel: '受託開発版を見る',
	},
	{
		noun: '契約',
		title: 'SaaS代理店・リセラー',
		text: '契約更新、解約リスク、更新商談、クロスセル候補を追跡。',
		href: '/crm/reseller/',
		linkLabel: '代理店版を見る',
	},
	{
		noun: '在籍',
		title: '教室・スクール',
		text: '生徒の在籍、継続、休会、退会を管理。',
		href: '/crm/school/',
		linkLabel: 'スクール版を見る',
	},
];

const plans = [
	{
		tier: 'ユーザープラン',
		for: 'B2B版／毎日CRMを使う会社に',
		figure: '3,000',
		unit: '/ 人 / 月',
	},
	{
		tier: '生徒数プラン',
		for: 'B2C（スクール）版／毎日運用しているスクール・教室に',
		figure: '9,800',
		unit: '/ 月から',
	},
	{
		tier: 'プリペイドプラン',
		status: '提供準備中',
		for: 'B2B版・B2C（スクール）版／使う頻度が低い会社や、月によって利用に波がある会社・スクールに',
		figure: '3,000',
		unit: '/ 月',
	},
];

// 文面は /crm/school/ の safeguards と同じ系統。全6項目のうち、導入前に聞かれる3つだけを出す。
const safeguards = [
	{
		label: '学習に使われない',
		text: '名刺や手書きの読み取り、文字起こしでは、送信した内容を学習に使わない条件のサービスを利用しています。',
	},
	{
		label: '他社に見えない',
		text: '会社ごとの隔離は、データベースの行単位のアクセス制御で行っています。アプリ側の絞り込みには頼りません。',
	},
	{
		label: '東京に置いてある',
		text: 'データは東京リージョンに保存しています。海外に出ることはありません。',
	},
];

// 全件は src/data/crm-faq.ts（/crm/faq/）。ここは購入前に最も聞かれる5問だけ。
const faqs = [
	{
		q: '料金はいくらですか。',
		a: 'プランは3つです。ユーザープランは1人あたり月額3,000円、スクール向けの生徒数プランは在籍生徒50人まで月額9,800円からです。使う頻度が低い会社には、月額3,000円（燃料100付き）に必要な分だけチャージするプリペイドプランがあります（提供準備中）。初期費用はありません。どのプランも初回のご利用開始日から30日間は月額無料です。価格はすべて税抜です。',
	},
	{
		q: 'ユーザー数はどう数えますか。',
		a: 'ワークスペースに参加しているメンバーの数です。招待したまま使っていないアカウントも含みます。人数の増減は、次回の請求から反映されます。',
	},
	{
		q: '解約はどうすればいいですか。',
		a: '契約は1ヶ月ごとの自動更新です。解約は、14日前までにご連絡ください。お支払いは月額前払いのため、月の途中で解約しても日割りの返金はありません。',
	},
	{
		q: 'データを取り出せますか。',
		a: 'コンタクト、会社、商談をCSVで書き出せます。ご契約終了日から30日間も書き出せます。自社のデータは自社のものです。',
	},
	{
		q: 'いま使っているCRMからデータを移行できますか。',
		a: 'Revenue CRMは、まだCRMを持っていない会社のために作っています。Salesforce・HubSpot・kintoneなどがすでに動いている場合は、乗り換えではなく、そのツールを活かした収益プロセスの再設計をご提案します。',
	},
];

const readings = [
	{ href: '/insights/why-crm-adoption-fails/', title: 'CRMが定着しない本当の理由' },
	{ href: '/insights/why-companies-cannot-stop-using-excel-after-crm/', title: 'CRMを導入してもExcelが止まらない理由' },
	{ href: '/insights/why-sfa-becomes-just-a-pipeline-sheet/', title: 'SFAがパイプライン管理表になってしまう理由' },
	{ href: '/insights/why-marketing-automation-does-not-improve-pipeline/', title: 'MAを導入しても商談化率が改善しない理由' },
	{ href: '/insights/why-sales-forecasting-fails/', title: 'なぜ売上予測は外れ続けるのか' },
	{ href: '/insights/what-changes-in-crm-design-when-ai-writes-records/', title: 'AIが記録を書くようになると、CRM設計は何が変わるか' },
];

---

<BaseLayout
	title="国産CRM「Revenue CRM」法人向けβ版 | まだCRMがない会社の最初の1つに"
	description="顧客の一覧はExcel、やりとりはメール、案件の温度感は担当者の頭の中。そういう会社のために、Consilegyが自社で開発した法人向けの国産CRMです。AIエージェントと175本のRevOpsワークフローを標準搭載。メールアドレスだけでデモをご覧いただけます。現在クローズドβ。2026年9月28日に正式リリース。"
	ogImage="/images/crm/og-crm.png"
	lang="ja"
	alternateUrl="/en/crm/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "Revenue CRM",
	"alternateName": ["Revenue CRM 法人向け", "レベニューCRM"],
	"applicationCategory": "BusinessApplication",
	"applicationSubCategory": "CRM / SFA（顧客管理・営業支援）",
	"operatingSystem": "Web",
	"url": "https://consilegy.com/crm/",
	"description": "まだCRMがない会社のための国産CRM / SFA。顧客・案件・パイプライン・売上予測・受注後の更新まで1か所で管理。AIエージェントと175本のRevOpsワークフローを標準搭載。Excelの営業管理からの最初の1つとして、法人営業・受託開発・SaaS代理店の3エディション。現在クローズドβ。2026年9月28日に正式リリース。",
	"inLanguage": ["ja", "en", "zh-Hant"],
	"offers": {
		"@type": "Offer",
		"price": "3000",
		"priceCurrency": "JPY",
		"description": "ユーザープラン1人あたり月額3,000円（税抜）。生徒数プランは月額9,800円から、プリペイドプランは月額3,000円（燃料100付き・提供準備中）。初期費用なし。どのプランも初回のご利用開始日から30日間は月額無料。"
	},
	"author": { "@type": "Organization", "name": "Consilegy合同会社", "url": "https://consilegy.com/" }
})} />

<CrmSubnav lang="ja" />

<!-- ===================== 1. HERO ===================== -->
<section class="crm-hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">
				<img class="eyebrow-mark" src="/images/crm/logo/revenue-crm-logo.svg" alt="" width="26" height="26" decoding="async" />
				Revenue CRM法人向けβ版
			</p>
			<h1>まだCRMがない会社のための、<br class="br-wide" />最初のCRMを作りました。</h1>
			<p class="hero-lead">
				顧客の一覧はExcel。やりとりはメール。案件の温度感は担当者の頭の中。
				そういう会社に40社以上入りました。そのたびに、ここに入れられるCRMがない。
				だから、自分たちで作りました。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href="/contact/" class="btn btn--secondary">β参加を相談する</a>
			</div>
			<p class="hero-note">メールアドレスだけで実際の画面に入れます。パスワード登録も営業連絡もありません。</p>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/screen-dashboard.webp"
				alt="Revenue CRMのダッシュボード。パイプライン総額、加重フォーキャスト、勝率、期限切れタスク、ステージ別パイプライン、注目の商談を一画面に表示。"
				width="1600"
				height="1000"
				decoding="async"
				fetchpriority="high"
			/>
			<figcaption>ダッシュボード：最初に見る数字と、次に動く相手を同じ画面で</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 2. 何を解決するか ===================== -->
<section class="crm-problems" id="problems">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">顧客とのやりとりを1か所に</p>
			<h2>最初のCRMで、まず解く課題。</h2>
		</div>
		<ol class="problem-table">
			{outcomes.map((item) => (
				<li>
					<strong>{item.problem}</strong>
					<span>{item.answer}</span>
				</li>
			))}
		</ol>
		<p class="section-foot">
			<a href="/crm/faq/what-is-crm/">CRMとは何か</a>と<a href="/crm/faq/crm-sfa-ma-difference/">SFA・MAとの違い</a>は、よくあるご質問にまとめています。
		</p>
	</div>
</section>

<!-- ===================== 3. 使い方 ===================== -->
<section class="crm-editions" id="use-cases">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">使い方</p>
			<h2>商売の形に合わせて、最初から設定済み。</h2>
		</div>
		<p class="section-lead">営業活動の入口から受注後の更新までを、同じ顧客の下に置いています。</p>
		<div class="edition-list">
			{editions.map((item) => (
				<article class="edition-item">
					<span>{item.noun}</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					<a href={item.href}>{item.linkLabel}</a>
				</article>
			))}
		</div>
		<figure class="hero-media usecase-media">
			<img
				src="/videos/revenue-crm-demo.gif"
				alt="Revenue CRMの操作デモ。ダッシュボード、商談カンバン、自動化ライブラリ、AIエージェント、3言語切替を順に操作している。"
				width="800"
				height="585"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>操作デモ：ダッシュボード、商談カンバン、自動化ライブラリ、AIエージェント、3言語切替</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 4. 入力が増えない ===================== -->
<section class="crm-proof" id="input-assist">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">現場に残る理由</p>
			<h2>入力を増やさず、記録を残す。</h2>
		</div>
		<div class="assist-panel">
			<div>
				<p class="kicker">AIエージェント</p>
				<h3>AIエージェントは、記録の入口です。</h3>
			</div>
			<p>
				日本語で聞く。名刺を撮る。会話を貼る。通話を残す。
				作成された文面やデータは、保存と送信の前に必ず人が確認します。
				APIキーは自社のもの（Anthropic / OpenAI / Gemini / Azure OpenAI）を持ち込めます。
			</p>
		</div>
		<ul class="proof-strip">
			{proofStats.map((item) => (
				<li>
					<strong>{item.figure}</strong>
					<span>{item.label}</span>
				</li>
			))}
		</ul>
		<p class="proof-note">
			※「40社以上」は、Consilegy合同会社がマーケティング・営業・カスタマーサクセス領域で設計支援を行った累計社数です。
			Revenue CRMはクローズドβのため、導入社数は公開していません。
		</p>
	</div>
</section>

<!-- ===================== 5. 料金 ===================== -->
<section class="crm-pricing" id="pricing">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">料金</p>
			<h2>使い方に合わせて、3つのプランから選ぶ。</h2>
		</div>
		<div class="plan-summary">
			{plans.map((plan) => (
				<div class="plan-summary__item">
					<p class="price-tier">{plan.tier}{plan.status && <span class="price-status">{plan.status}</span>}</p>
					<p class="price-figure"><span class="price-yen">¥</span>{plan.figure}<span class="price-unit">{plan.unit}</span></p>
					<p class="plan-for">{plan.for}</p>
				</div>
			))}
		</div>
		<div class="plan-summary__foot">
			<p>初期費用はありません。どのプランも、初回のご利用開始日から30日間は月額無料です。</p>
			<a href="/crm/pricing/" class="btn btn--secondary">料金の詳細</a>
		</div>
		<p class="proof-note">※価格はすべて税抜表示です。</p>
	</div>
</section>

<!-- ===================== 6. 安心して使える ===================== -->
<section class="crm-security" id="security">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">安心して導入・運用いただくために</p>
			<h2>データは会社ごとに分けて管理します。</h2>
		</div>
		<dl class="security-table">
			{safeguards.map((item) => (
				<div>
					<dt>{item.label}</dt>
					<dd>{item.text}</dd>
				</div>
			))}
		</dl>
		<p class="section-foot">
			詳しくは<a href="/crm/faq/">よくあるご質問</a>のデータとセキュリティをご覧ください。
			2要素認証とシングルサインオンは、現時点では提供していません。
		</p>
	</div>
</section>

<!-- ===================== 7. よくある質問 ===================== -->
<section class="crm-faq" id="faq">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">よくあるご質問</p>
			<h2>導入前に、よくいただく質問です。</h2>
		</div>
		<dl class="faq-list">
			{faqs.map((item) => (
				<div class="faq-item">
					<dt>{item.q}</dt>
					<dd>{item.a}</dd>
				</div>
			))}
		</dl>
		<p class="faq-more"><a href="/crm/faq/">よくあるご質問をすべて見る</a></p>
	</div>
</section>

<!-- ===================== 8. 申込み ===================== -->
<section class="crm-start" id="start">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">無料で始める</p>
			<h2>まだCRMがない会社の、最初の1つに。</h2>
		</div>
		<div class="start-body">
			<p>Excelの営業管理から、初めてSFA / CRMへ移る会社のために作りました。</p>
			<p>
				Salesforce・HubSpot・kintone・Marketoが既に動いているなら、乗り換えないほうがいいです。
				<a href="/services/">既存CRMの再設計</a>か、<a href="/services/sfa-adoption-support/">SFA定着支援</a>をご覧ください。
			</p>
			<div class="hero-actions">
				<a href={SIGNUP_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">無料で始める</a>
				<a href={DEMO_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href="/contact/" class="btn btn--secondary">β参加を相談する</a>
			</div>
		</div>
		<div class="reading">
			<p class="reading-head">入れる前に、失敗の型を知っておく</p>
			<ul class="reading-list">
				{readings.map((item) => (
					<li><a href={item.href}>{item.title}</a></li>
				))}
			</ul>
		</div>
	</div>
</section>

</BaseLayout>

<style>
	.kicker,
	.eyebrow {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: none;
	}

	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		margin: 0;
		color: var(--color-text);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.4;
		text-wrap: balance;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0.8rem 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.25;
		text-decoration: none;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.btn--primary {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
	}

	.btn--primary:hover {
		background: var(--color-primary-dark);
		border-color: var(--color-primary-dark);
		color: #fff;
	}

	.btn--secondary {
		background: transparent;
		color: var(--color-text);
	}

	.btn--secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-lg);
	}

	.crm-hero {
		padding: calc(var(--space-2xl) + 0.5rem) 0 var(--space-xl);
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(330px, 0.8fr);
		gap: var(--space-xl);
		align-items: end;
	}

	.hero-copy {
		max-width: 720px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: var(--space-md);
		padding-top: 0.875rem;
		border-top: 1px solid var(--color-border);
	}

	.eyebrow-mark {
		width: 26px;
		height: 26px;
		border-radius: 6px;
		flex-shrink: 0;
	}

	.crm-hero h1 {
		max-width: 100%;
		margin: 0;
		color: var(--color-text);
		font-size: clamp(2rem, 3vw, 2.625rem);
		font-weight: 500;
		line-height: 1.24;
		letter-spacing: -0.01em;
	}

	.hero-lead {
		max-width: 43em;
		margin: var(--space-md) 0 0;
		color: var(--color-text);
		font-size: 1.0625rem;
		line-height: 2;
	}

	.hero-media {
		margin: 0;
		min-width: 0;
	}

	.hero-media img {
		width: 100%;
		height: auto;
		border: 1px solid var(--color-border);
		border-radius: 0;
		background: #fff;
		box-shadow: none;
	}

	.hero-media figcaption {
