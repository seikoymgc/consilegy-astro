---
import { CATEGORIES, fmtDate, articlePath, eyecatchPath, type Article } from '../lib/crm-media';
interface Props { a: Article }
const { a } = Astro.props;
const lang = a.data.lang;
---
<a class="card" href={articlePath(a)}>
  <img class="thumb" src={eyecatchPath(lang, a.data.slug)} alt="" width="1200" height="630" loading="lazy" />
  <div class="card-copy">
    <div class="card-meta"><span>{CATEGORIES[a.data.category][lang]}</span><time datetime={a.data.date.toISOString()}>{fmtDate(a.data.date, lang)}</time></div>
    <span class="title">{a.data.title}</span>
  </div>
</a>

<style>
  .card { display:flex; flex-direction:column; min-width:0; overflow:hidden; border:1px solid var(--color-border); border-radius:6px; background:#fff; text-decoration:none; color:inherit; box-shadow:0 2px 8px rgb(15 23 42 / .035); transition:border-color .18s,box-shadow .18s; }
  .card:hover { border-color:var(--color-border-strong); box-shadow:0 6px 18px rgb(15 23 42 / .08); }
  .thumb { display:block; width:100%; height:auto; aspect-ratio:1200/630; object-fit:cover; }
  .card-copy { padding:1.25rem; }
  .card-meta { display:flex; flex-wrap:wrap; justify-content:space-between; gap:.4rem .75rem; margin-bottom:.75rem; font-size:.875rem; color:var(--color-text-muted); }
  .card-meta span { font-weight:600; color:var(--color-navy); }
  .title { display:block; font-weight:700; font-size:1.125rem; line-height:1.65; color:var(--color-navy); text-wrap:pretty; }
  .card:hover .title { color:var(--color-primary); }

</style>
