---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';

// プロダクトの reseller エディション（src/lib/editions/index.ts）に実装済みの
// ものだけ記載。coreNav は /deals・/companies・/subscriptions、既定で入る
// 自動化は cs-30/31/32/33/35 の5本。文言は src/lib/revops/outcomes.ts と揃える。
const screens = [
	{
		src: 'subscriptions',
		title: '契約と継続収益',
		desc: 'プランごとのマージン、稼働中と解約、MRR・ARR・LTVが1画面に出ます。月末に表計算で作り直す必要がありません。',
		alt: 'サブスクの画面。MRR ¥765,000、ARR ¥9,180,000、稼働中6件、解約率0.0%、LTV ¥3,060,000のカードが並び、その下にプラン（マージン率つき）・お客様・ステータス・金額・MRRの契約一覧が出ている。',
	},
	{
		src: 'automations',
		title: '更新・解約リスク監視',
		desc: '更新日、ヘルス低下、解約予兆、追加提案の候補を早めに知らせます。セット単位でONにできます。',
		alt: '自動化ライブラリの画面。「更新・解約リスク監視」のセットが4/7 ONで、ONの自動化29件、今すぐON可能138件、設定待ち8件のカード。ライブラリ全体は175件。',
	},
	{
		src: 'deals',
		title: '新規も増席も同じ場所で',
		desc: '新規導入と増席・追加ライセンスを同じパイプラインで扱います。ステージごとに金額と件数が出ます。',
		alt: '商談のカンバン画面。アプローチ・ヒアリング・提案・見積のステージに、トウカイ精機 GuardX 新規導入 ¥1,140,000、ヒカリ食品 DataLens 新規導入 ¥1,680,000、マルヰ商事 WorkCloud 増席（+10席）¥320,000 のカードが確度とクローズ予定日つきで並ぶ。',
	},
];

const problems = [
	{
		title: '更新月が直前に分かる',
		text: '契約書とスプレッドシートにしか無いので、更新の話を切り出すのが1か月前になる。条件を詰める時間が残っていない。',
	},
	{
		title: '解約の兆候が見えない',
		text: '使われていない、問い合わせが減った、担当者が替わった。気づくのは解約の連絡が来てからになっている。',
	},
	{
		title: '継続収益を数える場所がない',
		text: '今いくら積み上がっているのか、どの商材のマージンが厚いのか。毎月あらためて集計し直している。',
	},
];

// 既定で入る5本（reseller の defaultAutomations = cs-30/32/31/33/35）。
// text は src/lib/revops/outcomes.ts の日本語をそのまま使う。label は表示用で、
// 内部キーは出さない。
const renewalEngine = [
	{ label: '更新日', text: '契約更新日を自動で管理してリマインド' },
	{ label: '90日前', text: '更新90日前に、アプローチを自動で開始' },
	{ label: 'リスク', text: '更新できなそうな顧客を自動で判定' },
	{ label: '更新商談', text: '更新の時期が来たら、更新商談を自動で作成' },
	{ label: '解約予兆', text: '解約の予兆を自動で検知' },
];

const roles = [
	{ name: 'オーナー', scope: '全顧客・全契約・請求・権限設定' },
	{ name: '管理者', scope: '運用全般と権限設定' },
	{ name: 'マネージャー', scope: '担当チームの顧客・商談・契約を閲覧・編集' },
	{ name: '営業担当', scope: '自分が担当する顧客と商談のみ' },
];
---

<BaseLayout
	title="Revenue CRM 代理店版（β版） | 次の更新が、いつも先に見えている"
	description="SaaS代理店・リセラー向けの画面構成。契約とマージン、MRR・ARR・LTV、更新90日前からの自動アプローチ、解約予兆の検知まで。売った後の継続収益を1か所で見られます。現在クローズドβ。"
	lang="ja"
	alternateUrl="/en/crm/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/crm/"},
		{"@type": "ListItem", "position": 3, "name": "代理店版", "item": "https://consilegy.com/crm/reseller/"}
	]
})} />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM 代理店版 <span class="no-upper">β版</span></p>
			<h1>次の更新が、<br />いつも先に見えている。</h1>
			<p class="hero-lead">
				販売した契約はスプレッドシート。更新月は担当者の記憶。マージンは別表。
				代理店版は、<strong>契約・更新・継続収益を1か所で見て、更新の90日前から自動で動く</strong>構成です。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href="#screens" class="btn btn--secondary">画面を見る</a>
			</div>
			<ul class="hero-points" aria-label="代理店版の特徴">
				<li>契約・更新・マージンを一元管理</li>
				<li>更新90日前から自動で追跡</li>
				<li>クローズドβで開発中</li>
			</ul>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/reseller/screen-subscriptions.webp"
				alt="サブスクの画面。MRR ¥765,000、ARR ¥9,180,000、稼働中6件、解約率0.0%、LTV ¥3,060,000のカードと、プランごとのマージン率つき契約一覧。"
				width="1432"
				height="840"
				decoding="async"
			/>
			<figcaption>契約画面：MRR・ARR・LTVと、プランごとのマージンつき契約一覧</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">
				追いかけるのは「今月いくら売ったか」ではなく、<br />
				「来月も残っているか」です。
			</p>
			<div class="pos-copy">
				<p>
					だから中心に置いたのは<strong>契約</strong>です。商談は受注した時点で終わりますが、
					代理店の売上はそこから始まります。契約が生きているか、いつ更新か、いくらのマージンか。
					その3つが商談と同じ画面から地続きで見えます。
				</p>
				<p>
					新規導入も増席・追加ライセンスも、同じパイプラインで扱います。
					既存顧客からの追加が売上の大半を占める事業では、この2つを分けて管理する意味がありません。
				</p>
				<p>
					複数の商材を扱う場合、商材ごとにマージン率が違います。
					契約に率を持たせているので、売上ではなく<strong>手元に残る額</strong>で並べ替えられます。
				</p>
				<a href="/revenue-architecture/" class="pos-link">この考え方について読む →</a>
			</div>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">こんな課題に</p>
			<h2 class="prob-title">売った後の情報が、契約書とスプレッドシートに閉じていませんか。</h2>
		</div>
		<div class="prob-grid">
			{problems.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`項目 ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">画面構成</p>
			<h2 class="sc-title">契約を軸に、日々見る画面を揃えています。</h2>
		</div>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img
							src={`/images/crm/reseller/screen-${s.src}.webp`}
							alt={s.alt}
							width="1432"
							height="840"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== 更新エンジン ===================== -->
<section class="support">
	<div class="container support-inner">
		<div>
			<p class="section-eyebrow">更新エンジン</p>
			<h2>更新の準備を、人の記憶から外します。</h2>
			<p class="support-lead">
				代理店版を作ると、更新まわりの自動化が最初からONになっています。
				更新日の管理、90日前のアプローチ開始、更新商談の作成、解約予兆の検知まで、
				毎晩の処理として走ります。
			</p>
			<p class="support-lead">
				自動化が作るのはタスクと通知と下書きです。顧客に何かが自動で送られることはありません。
				担当者が中身を見て、直してから動かします。
			</p>
		</div>
		<div class="support-list">
			<h3>既定でONになるもの</h3>
			<ul>
				{renewalEngine.map((r) => (
					<li><span>{r.label}</span><strong>{r.text}</strong></li>
				))}
			</ul>
		</div>
	</div>
</section>

<!-- ===================== AI ===================== -->
<section class="ai">
	<div class="container ai-inner">
		<div>
			<p class="section-eyebrow">AI</p>
			<h2>日本語で聞けば、<br />その場で返ってきます。</h2>
			<p class="ai-lead">
				知りたいことのために、レポートを組み立てる必要はありません。
				話すとおりに聞けば、契約と商談のデータを探して答えます。
			</p>
			<p class="ai-lead">
				更新の近い契約、マージンの薄い商材、反応の落ちた顧客。
				どれも集計を作らずに、その場で確認できます。
			</p>
			<p class="ai-lead">
				AIが書いたものは、すべて下書きのまま止まります。
				担当者が確認して確定するまで、顧客には出ません。
			</p>
		</div>
		<ul class="ai-examples">
			<li>今月更新の契約は？</li>
			<li>MRRの内訳を教えて</li>
			<li>解約リスクが高い顧客は？</li>
			<li>マージン率が低い契約は？</li>
		</ul>
	</div>
</section>

<!-- ===================== ROLES ===================== -->
<section class="roles">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">権限管理</p>
			<h2 class="ro-title">担当顧客の外は、見えないようにできます。</h2>
		</div>
		<p class="ro-lead">
			顧客・会社・商談のそれぞれについて、見える範囲を「全体・チーム・自分」から選べます。
			エクスポートの可否も別に設定できるので、顧客リストの持ち出しを閲覧と切り離して止められます。
			下は設定例です。
		</p>
		<dl class="ro-list">
			{roles.map((r) => (
				<div class="ro-row">
					<dt>{r.name}</dt>
					<dd>{r.scope}</dd>
				</div>
			))}
		</dl>
		<p class="ro-note">操作ログが残るので、誰がいつ何を変更したかを後から追えます。</p>
	</div>
</section>

<!-- ===================== FINAL CTA ===================== -->
<section class="final-cta">
	<div class="container cta-inner">
		<div>
			<p class="cta-eyebrow"><span class="no-upper">クローズドβ</span></p>
			<h2>一緒に育てていただける<br />代理店を探しています。</h2>
			<p class="cta-lead">
				クローズドβは、完成品を売る段階ではありません。
				実際の商流で使っていただき、足りないものを教えていただきながら仕上げていく段階です。
				デモはメールアドレスだけで、その場でご覧いただけます。
			</p>
			<div class="cta-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href="/crm/" class="btn btn--secondary">法人向けを見る</a>
			</div>
		</div>
		<div class="cta-card">
			<h4>デモでお見せする内容</h4>
			<ul class="cta-list">
				<li>契約一覧とMRR・ARR・LTVの見え方</li>
				<li>プランごとのマージン管理</li>
				<li>更新・解約リスク監視の設定</li>
				<li>新規と増席を同じパイプラインで扱う流れ</li>
				<li>担当者向けの権限設定と操作ログ</li>
			</ul>
		</div>
	</div>
</section>

</BaseLayout>

<style>
	.section-eyebrow,
	.eyebrow,
	.cta-eyebrow {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	/* uppercase はギリシャ文字も変えるので β が B になる。
	   ラテン文字だけ大文字にしたいので、日本語まじりの語は除外する。 */
	.section-eyebrow .no-upper,
	.eyebrow .no-upper,
	.cta-eyebrow .no-upper {
		text-transform: none;
	}

	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		margin: 0;
		color: var(--color-text);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.4;
		text-wrap: balance;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0.8rem 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.25;
		text-decoration: none;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.btn--primary {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
	}

	.btn--primary:hover {
		background: var(--color-primary-dark);
		border-color: var(--color-primary-dark);
		color: #fff;
	}

	.btn--secondary {
		background: transparent;
		color: var(--color-text);
	}

	.btn--secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	.hero-actions,
	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-md);
	}

	.hero {
		padding: var(--space-lg) 0 var(--space-md);
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.78fr);
		gap: var(--space-xl);
		align-items: start;
	}

	.hero-copy {
		max-width: 720px;
	}

	.eyebrow {
		display: block;
		margin-bottom: var(--space-md);
		padding-top: 0.875rem;
		border-top: 1px solid var(--color-border);
	}

	.hero h1 {
		max-width: 13em;
		margin: 0;
		color: var(--color-text);
		font-size: 3.125rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.hero-lead {
		max-width: 43em;
		margin: var(--space-md) 0 0;
		color: var(--color-text);
		font-size: 1.0625rem;
		line-height: 2;
	}

	.hero-lead strong {
		font-weight: 700;
	}

	.hero-points {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
		margin: var(--space-md) 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-points li {
		min-width: 0;
		padding: 0.85rem 1rem;
		color: var(--color-text-muted);
		font-size: 0.8125rem;
		line-height: 1.6;
	}

	.hero-points li + li {
		border-left: 1px solid var(--color-border);
	}

	.pos-link {
		color: var(--color-primary);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
	}

	.hero-media {
		margin: 0;
		min-width: 0;
	}

	.hero-media img,
	.prob-shot img {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid var(--color-border);
		border-radius: 0;
		background: #fff;
		box-shadow: none;
	}

	.hero-media figcaption,
	.prob-shot figcaption {
		margin-top: 0.65rem;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.positioning,
	.problem,
	.screens,
	.support,
	.ai,
	.roles,
	.final-cta {
		padding: var(--space-2xl) 0;
		background: var(--color-bg);
	}

	.screens,
	.roles {
		background: var(--color-bg-subtle);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.prob-shot {
		max-width: 900px;
		margin: 0;
		background: transparent;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}

	.positioning {
		border-bottom: 1px solid var(--color-border);
	}

	.pos-body {
		display: grid;
		grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
		gap: var(--space-xl);
		align-items: start;
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	.pos-lead {
		margin: 0;
		color: var(--color-text);
		font-size: 1.375rem;
		font-weight: 500;
		line-height: 1.7;
		text-wrap: balance;
	}

	.pos-copy p {
		margin: 0 0 1rem;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.9;
	}

	.pos-body strong {
		color: var(--color-text);
		font-weight: 700;
	}

	.pos-link {
		display: inline-flex;
		margin-top: 0.25rem;
		font-size: 0.9375rem;
	}

	.section-head {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		gap: var(--space-lg);
		align-items: start;
		margin-bottom: var(--space-lg);
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	.prob-grid,
	.sc-grid {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--color-border);
	}

	.prob-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.prob-item,
	.sc-card {
		min-width: 0;
		padding: 1.35rem 1.5rem 1.35rem 0;
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--color-border);
		border-radius: 0;
	}

	.prob-item:nth-child(2),
	.prob-item:nth-child(3) {
		padding-left: var(--space-md);
		border-left: 1px solid var(--color-border);
	}

	.issue-label {
		display: flex;
		align-items: flex-end;
		gap: 0.85rem;
		margin-bottom: 0.9rem;
		color: var(--color-primary);
	}

	.issue-label::after {
		content: "";
		flex: 1;
		height: 1px;
		margin-bottom: 0.34rem;
		background: var(--color-border);
	}

