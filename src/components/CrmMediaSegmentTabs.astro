---
// 一覧の上に出す読者の切り替え（法人営業 / スクール・教室）。
import { COPY, SEGMENTS, SEGMENT_ORDER, mediaPath, type Lang, type Segment } from '../lib/crm-media';
interface Props { lang: Lang; current: Segment }
const { lang, current } = Astro.props;
const t = COPY[lang];
---
<nav class="seg" aria-label={t.segmentLabel}>
  <span class="seg-label">{t.segmentLabel}</span>
  {SEGMENT_ORDER.map((s) => (
    <a href={mediaPath(lang, s)} aria-current={s === current ? 'page' : undefined}>{SEGMENTS[s][lang]}</a>
  ))}
</nav>

<style>
  .seg { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0 0 0.5rem; }
  .seg-label { font-size: 0.8rem; color: var(--color-text-muted); margin-right: 0.25rem; }
  .seg a {
    font-size: 0.9rem; font-weight: 600; text-decoration: none; color: var(--color-text-muted);
    padding: 0.35rem 0.9rem; border: 1px solid var(--color-border); border-radius: 999px; background: #fff;
  }
  .seg a:hover { border-color: var(--color-primary); color: var(--color-primary); }
  .seg a[aria-current='page'] { background: var(--color-primary); border-color: var(--color-primary); color: #fff; }
</style>
