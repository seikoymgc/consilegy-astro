---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CTA from '../../../components/CTA.astro';

const services = [
  {
    number: '01',
    title: 'Revenue Architecture Design',
    description: 'Design the structure behind Japan-facing revenue: funnel logic, lifecycle definitions, handoff rules, and KPIs.',
    href: '/en/services/revenue-architecture-design/',
  },
  {
    number: '02',
    title: 'Japan Market GTM & Messaging',
    description: 'Adapt positioning, offers, and conversion paths to how Japanese buyers evaluate trust and risk.',
    href: '/en/services/japan-market-gtm-messaging/',
  },
  {
    number: '03',
    title: 'CRM / RevOps Implementation',
    description: 'Turn revenue architecture into CRM configuration, workflows, automation, and reporting the team will use.',
    href: '/en/services/crm-revops-implementation/',
  },
  {
    number: '04',
    title: 'HubSpot Implementation & Operations Support',
    description: 'Set up and operate HubSpot as part of your revenue system, not a standalone tool project.',
    href: '/en/services/hubspot-implementation-operations-support/',
  },
  {
    number: '05',
    title: 'Adoption & Growth Support',
    description: 'Support the operating habits, reporting cycles, and documentation needed after CRM or GTM changes launch.',
    href: '/en/services/adoption-growth-support/',
  },
];
---

<BaseLayout
  title="Services | Consilegy"
  description="Consilegy builds revenue operations that work for how Japan actually moves: GTM, CRM, RevOps, and adoption."
  lang="en"
  alternateUrl="/services/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://consilegy.com/en/"},
    {"@type": "ListItem", "position": 2, "name": "Services", "item": "https://consilegy.com/en/services/"}
  ]
})} />

  <section class="sv-hero">
    <div class="container sv-hero__inner">
      <p class="sv-hero__eyebrow">Services</p>
      <h1 class="sv-hero__title">Revenue operations for Japan, built to work in both languages.</h1>
      <p class="sv-hero__sub">We build the messaging, CRM structure, and operating systems that make Japan revenue execution visible to you, your team, and your HQ.</p>
    </div>
  </section>

  <section class="sv-product">
    <div class="container sv-product__inner">
      <div class="sv-product__copy">
        <p class="sv-product__eyebrow">If you have no CRM yet</p>
        <h2 class="sv-product__title">You can start from our own product.</h2>
        <p class="sv-product__body">
          Revenue CRM is what 40+ CRM rebuilds taught us about a CRM that gets used, turned into a product.
          No migration: start from what you already track in spreadsheets. English, Japanese, and Traditional Chinese UI.
          Currently in closed beta with a limited number of development partners.
        </p>
        <p class="sv-product__note">The services below are for teams that already have a CRM in place.</p>
        <a href="/en/crm/" class="sv-product__link">See Revenue CRM →</a>
      </div>
      <a href="/en/crm/" class="sv-product__shot" aria-label="Revenue CRM dashboard. Go to the product page">
        <span class="sv-product__bar" aria-hidden="true"><i></i><i></i><i></i></span>
        <img
          src="/images/crm/screen-dashboard-en.webp"
          alt="Revenue CRM dashboard: open pipeline, weighted forecast, win rate, overdue tasks, and an insights list with suggested next actions."
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </section>

  <section class="sv-list">
    <div class="container sv-list__inner">
      {services.map((s) => (
        <a class="sv-item" href={s.href}>
          <span class="sv-item__number">{s.number}</span>
          <div class="sv-item__content">
            <h2 class="sv-item__title">{s.title}</h2>
            <p class="sv-item__desc">{s.description}</p>
          </div>
          <span class="sv-item__arrow">→</span>
        </a>
      ))}
    </div>
  </section>

  <CTA
    title="Not sure which layer applies to your situation?"
    href="/en/contact/"
    label="Contact Us"
  />

</BaseLayout>

<style>
  /* Hero */
  .sv-hero {
    background: var(--color-bg-subtle);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-2xl);
  }

  .sv-hero__inner {
    max-width: 700px;
  }

  .sv-hero__eyebrow {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin: 0 0 var(--space-md);
  }

  .sv-hero__title {
    font-size: clamp(1.55rem, 3vw, 2.2rem);
    font-weight: 600;
    letter-spacing: 0.01em;
    line-height: 1.25;
    color: var(--color-text);
    margin: 0 0 var(--space-lg);
  }

  .sv-hero__sub {
    font-size: var(--text-lead);
    color: var(--color-text-muted);
    line-height: 1.75;
    margin: 0;
    max-width: 60ch;
  }

  /* List */
  .sv-product {
    padding-block: var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }
  .sv-product__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: var(--space-xl);
    align-items: center;
    max-width: 1120px;
  }
  .sv-product__eyebrow {
    display: block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: var(--color-primary); margin: 0 0 0.75rem;
  }
  .sv-product__title {
    font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 600; line-height: 1.3;
    color: var(--color-text); margin: 0 0 1rem;
  }
  .sv-product__body { font-size: 0.9375rem; line-height: 1.8; color: var(--color-text-muted); margin: 0; max-width: 46ch; }
  .sv-product__note {
    margin: 1rem 0 1.25rem; font-size: 0.8125rem; line-height: 1.7; color: var(--color-text-muted);
    padding-left: 0.85rem; border-left: 2px solid var(--color-border);
  }
  .sv-product__link {
    display: inline-block; font-weight: 700; color: var(--color-primary); text-decoration: none;
    border-bottom: 1px solid currentColor; padding-bottom: 1px;
  }
  .sv-product__shot {
    display: block; position: relative; overflow: hidden; justify-self: end;
    width: 100%; max-width: 600px;
    border: 1px solid var(--color-border); border-radius: 12px; background: #fff;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
  }
  .sv-product__bar {
    display: flex; gap: 6px; align-items: center; height: 30px; padding: 0 12px;
    background: #f3f4f6; border-bottom: 1px solid var(--color-border);
  }
  .sv-product__bar i { width: 8px; height: 8px; border-radius: 50%; background: #d6d9de; }
  .sv-product__shot img { display: block; width: 100%; height: auto; }
  @media (max-width: 900px) {
    .sv-product__inner { grid-template-columns: 1fr; gap: var(--space-lg); }
    .sv-product__shot { justify-self: start; max-width: 560px; }
  }

  .sv-list {
    padding-block: var(--space-2xl);
  }

  .sv-list__inner {
    max-width: 820px;
    display: flex;
    flex-direction: column;
    gap: 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }

  .sv-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-lg);
    padding: var(--space-xl) var(--space-xl);
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    transition: background 0.15s;
  }

  .sv-item:last-child {
    border-bottom: none;
  }

  .sv-item:hover {
    background: var(--color-bg-subtle);
  }

  .sv-item__number {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    padding-top: 0.25rem;
    flex-shrink: 0;
    width: 2rem;
  }

  .sv-item__content {
    flex: 1;
    min-width: 0;
  }

  .sv-item__title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-sm);
    letter-spacing: 0.01em;
    line-height: 1.35;
  }

  .sv-item__desc {
    margin: 0;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .sv-item__arrow {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    flex-shrink: 0;
    padding-top: 0.15rem;
    transition: color 0.15s, transform 0.15s;
  }

  .sv-item:hover .sv-item__arrow {
    color: var(--color-primary);
    transform: translateX(3px);
  }

  @media (max-width: 600px) {
    .sv-item {
      padding: var(--space-lg);
      gap: var(--space-md);
    }

    .sv-item__arrow {
      display: none;
    }
  }
</style>
