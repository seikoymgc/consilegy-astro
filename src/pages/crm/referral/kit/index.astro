---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CrmSubnav from '../../../../components/CrmSubnav.astro';
import PartnerForm, { type PartnerField } from '../../../../components/PartnerForm.astro';

// 紹介キット＋紹介フォーム。申込後にだけ案内するページなので noindex にし、ナビゲーションからも張らない。
// URL を知っていれば誰でも開ける（ログインはない）。中身は公開しても困らないものだけを置く。
// 受け口は Revenue CRM の Consilegy合同会社の組織に作ったフォーム「紹介先の登録」。
// 紹介先のメールアドレスは text 型で受ける（PartnerForm.astro の冒頭を参照）。
const FORM_ID = '12ff624d-6904-4511-8bcc-7bd53b03ef96';
const DEMO_URL = 'https://crm.consilegy.com/demos';

const oneLiner = 'Revenue CRMは、入力がめんどくさくない中小企業向けのCRMです。名刺は撮るだけ、商談メモは貼るだけで、記録の下書きはAIが作ります。CRM・MA・SFAの導入を40社以上支援してきた山口聖子さんが作っています。';

const messages = [
	{
		id: 'mail',
		label: 'メール用',
		text: `件名：顧客管理（CRM）のご紹介

〇〇さん

先日お話しした顧客管理の件で、知り合いの山口聖子さんをご紹介させてください。

山口さんは、CRM・MA・SFAの導入を40社以上支援してきた方で、中小企業向けのCRM「Revenue CRM」を自社で作っています。名刺は撮るだけ、商談メモは貼るだけで、記録の下書きはAIが作るという、入力の手間を減らすことに振り切った作りです。

メールアドレスだけで、実際の画面を触れるデモがあります。
${DEMO_URL}

話を聞いてみたいと思ったら、このメールにご返信ください。山口さんにおつなぎします。合わなければ合わないと言ってくれる人なので、気軽に話してみてください。`,
	},
	{
		id: 'chat',
		label: 'LINE・Messenger用',
		text: `この前話してた顧客管理の件、知り合いの山口聖子さんが作ってるCRMが合いそうだったので共有します。名刺は撮るだけ、メモは貼るだけで、記録はAIが下書きしてくれるやつです。
デモはメールアドレスだけで触れます：${DEMO_URL}
話を聞いてみたかったら言ってください。山口さんにつなぎます。`,
	},
];

const disclosure = 'なお、私はConsilegy合同会社の紹介パートナー制度に登録しており、ご契約に至った場合は同社から紹介料を受け取ります。ご判断の材料としてお伝えしておきます。';

const materials = [
	{ title: 'サービス紹介資料（PDF）', text: 'B2B・受託開発・代理店版の紹介資料です。', href: '/downloads/revenue-crm-service-guide.pdf' },
	{ title: 'スクール版の紹介資料（PDF）', text: '教室・スクール向けの紹介資料です。', href: '/downloads/revenue-crm-school-guide.pdf' },
	{ title: 'デモ', text: 'メールアドレスだけで実際の画面に入れます。パスワード登録も営業連絡もありません。', href: DEMO_URL },
	{ title: '製品ページ', text: 'B2B向けの概要です。', href: '/crm/' },
	{ title: 'スクール版のページ', text: '教室・スクール向けの概要です。', href: '/crm/school/' },
	{ title: '料金', text: '3つのプランと、契約・お支払いの条件です。', href: '/crm/pricing/' },
];

const screens = [
	{ src: '/images/crm/screen-dashboard-2026-09.webp', alt: 'B2B版のダッシュボード。パイプライン総額、勝率、期限切れタスク、注目の商談を一画面に表示。', width: 1600, height: 1000, caption: 'B2B版：ダッシュボード' },
	{ src: '/images/crm/school/screen-lessons-v2.webp', alt: 'スクール版のレッスン履歴の画面。レッスン種別ごとの担当コーチと、生徒名・担当コーチ・実施日の履歴が並ぶ。', width: 1200, height: 750, caption: 'スクール版：レッスン記録' },
];

const pricing = [
	'ユーザープラン：1人あたり月額3,000円（B2B・受託開発・代理店版）',
	'生徒数プラン：在籍生徒50人まで月額9,800円から（スクール版。講師・スタッフは何人でも同じ料金）',
	'プリペイドプラン：月額3,000円から（使う頻度が低い会社・スクール向け）',
	'初期費用はありません。どのプランも、最初のログインから30日間は月額無料です。',
	'ユーザープランと生徒数プランの契約期間は1年です。個別の初期設定支援は12万円からの有償です。',
];

const fit = [
	'営業担当がいて、顧客や商談をExcel・スプレッドシートで管理している会社',
	'CRMを入れたが、入力が続かずに止まっている会社',
	'見積・受注・納品・請求までを案件ごとに追いたい制作会社・受託開発の会社',
	'SaaSを再販していて、契約更新や解約の兆しを見落としたくない代理店',
	'生徒の在籍・継続・休会・退会を、LINEやスプレッドシートで追っている教室・スクール',
];

const answers = [
	{
		q: '導入実績は？ 何社が使っているの？',
		a: '2026年9月に正式リリースしたばかりの製品です。導入企業名は、各社の了承を得たものから公開しています。作っている山口聖子さんは、個人事業の時代を含めて40社以上のCRM・MA・SFAの導入を支援してきた人で、その経験から作った製品です。まずデモで画面を触って判断してみてください、と答えてください。',
	},
	{
		q: '他のCRMと何が違うの？',
		a: '入力の手間を減らすことに振り切っている点です。名刺は撮るだけ、商談メモは貼るだけ、録音は上げるだけで、記録の下書きをAIが作ります。業務別のひな形が入った状態から始まるので、項目とパイプラインの設計から始める必要もありません。',
	},
	{
		q: 'いくらかかるの？',
		a: '上の「料金の要点」のとおりです。初期費用はなく、30日間は月額無料で試せます。細かいご質問は、山口さんにつなぐ形で構いません。',
	},
	{
		q: 'データは安全？',
		a: 'データは会社ごとに分けて管理しています。詳しい仕組みは山口さんから説明します。',
	},
	{
		q: '売り込まれない？',
		a: '紹介先の同意がない限り、山口さんから連絡はしません。話を聞いて合わないと判断したら、契約は勧めずにそう伝えます。',
	},
];

const fields: PartnerField[] = [
	{ key: 'last_name', label: 'あなたの姓', type: 'text', required: true, auto: 'family-name', half: true },
	{ key: 'first_name', label: 'あなたの名', type: 'text', required: true, auto: 'given-name', half: true },
	{ key: 'email', label: 'あなたのメールアドレス', type: 'email', required: true, auto: 'email', help: 'パートナーの申し込みに使ったアドレスをご記入ください。' },
	{ key: 'referral_company', label: '紹介先の会社名', type: 'text', required: true },
	{ key: 'referral_person', label: '紹介先のご担当者名', type: 'text', required: true, half: true },
	{ key: 'referral_role', label: 'ご担当者の役職', type: 'text', required: false, half: true },
	{ key: 'referral_contact', label: '紹介先の連絡先（メールアドレスまたは電話番号）', type: 'text', required: false, help: '「山口から直接連絡」を選ぶ場合だけ必要です。それ以外は空欄で構いません。' },
	{ key: 'referral_route', label: 'つなぎ方', type: 'select', required: true, options: ['私からメール・チャットでつなぐ', '三者で会う・オンラインで話す', '山口から直接連絡してよいと、紹介先の了承を得ている'] },
	{ key: 'referral_note', label: '紹介先の状況・お困りごと', type: 'textarea', required: false, help: '例：営業5名、顧客管理はスプレッドシート、入力が続かない。' },
	{ key: 'referral_consent', label: '紹介先から、Consilegy合同会社に会社名と連絡先を伝えることの了承を得ています。', type: 'checkbox', required: true },
];
---

<BaseLayout
	title="紹介キット | 紹介パートナー制度 | Revenue CRM | Consilegy"
	description="Revenue CRMの紹介パートナー向けの紹介キットです。転送用の紹介文、資料、よくある質問への答え方、紹介先の登録フォームをまとめています。"
	lang="ja"
	noindex
>

<CrmSubnav lang="ja" />

<section class="rf-hero">
	<div class="container">
		<p class="kicker"><a href="/crm/referral/">紹介パートナー制度</a> ／ 紹介キット</p>
		<h1>紹介に必要なものは、ここにそろっています。</h1>
		<p class="lead">紹介文をコピーして転送し、紹介先の了承を得たら、このページの下のフォームで登録してください。その先は、山口聖子がすべて担当します。</p>
		<div class="hero-actions">
			<a href="#messages" class="btn btn--primary">紹介文をコピーする</a>
			<a href="#register" class="btn btn--secondary">紹介先を登録する</a>
		</div>
	</div>
</section>

<section class="rf-section" id="messages">
	<div class="container">
		<div class="section-head">
			<p class="kicker">紹介文</p>
			<h2>そのまま転送できる紹介文</h2>
		</div>
		<div class="kit-block">
			<h3>一言で紹介するなら</h3>
			<p class="kit-oneliner">{oneLiner}</p>
		</div>
		<div class="kit-messages">
			{messages.map((m) => (
				<div class="kit-block">
					<div class="kit-block-head">
						<h3>{m.label}</h3>
						<button type="button" class="kit-copy" data-copy-target={`msg-${m.id}`}>コピー</button>
					</div>
					<pre id={`msg-${m.id}`} class="kit-text">{m.text}</pre>
				</div>
			))}
		</div>
		<div class="kit-block">
			<div class="kit-block-head">
				<h3>士業・コンサルタントの方へ：報酬の開示文</h3>
				<button type="button" class="kit-copy" data-copy-target="msg-disclosure">コピー</button>
			</div>
			<p class="kit-sub">顧問先など、報酬を受けて助言している相手に紹介する場合は、紹介文の最後にこの一文を添えてください。</p>
			<pre id="msg-disclosure" class="kit-text">{disclosure}</pre>
		</div>
	</div>
</section>

<section class="rf-section rf-section--subtle">
	<div class="container">
		<div class="section-head">
			<p class="kicker">資料とリンク</p>
			<h2>紹介先に渡せる資料</h2>
		</div>
		<ul class="kit-materials">
			{materials.map((m) => (
				<li>
					<a href={m.href} target={m.href.startsWith('http') ? '_blank' : undefined} rel={m.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{m.title}</a>
					<p>{m.text}</p>
				</li>
			))}
		</ul>
		<div class="kit-screens">
			{screens.map((s) => (
				<figure>
					<a href={s.src} target="_blank" rel="noopener"><img src={s.src} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" /></a>
					<figcaption>{s.caption}（画像を開くと保存できます）</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>

<section class="rf-section">
	<div class="container kit-two">
		<div>
			<div class="section-head">
				<p class="kicker">料金の要点</p>
				<h2>聞かれたら、ここまで答えられれば十分です。</h2>
			</div>
			<ul class="kit-list">
				{pricing.map((p) => <li>{p}</li>)}
			</ul>
			<p class="kit-sub">価格は税抜です。詳しくは<a href="/crm/pricing/">料金ページ</a>をご覧ください。</p>
		</div>
		<div>
			<div class="section-head">
				<p class="kicker">合う会社</p>
				<h2>こんな会社に合います。</h2>
			</div>
			<ul class="kit-list">
				{fit.map((p) => <li>{p}</li>)}
			</ul>
		</div>
	</div>
</section>

<section class="rf-section rf-section--subtle">
	<div class="container">
		<div class="section-head">
			<p class="kicker">よく聞かれること</p>
			<h2>紹介先に聞かれたときの答え方</h2>
		</div>
		<dl class="rf-faq">
			{answers.map((item) => (
				<div>
					<dt>{item.q}</dt>
					<dd>{item.a}</dd>
				</div>
			))}
		</dl>
		<p class="kit-sub">ここにない質問は、無理に答えずに「山口さんに聞いてみます」で構いません。</p>
	</div>
</section>

<section class="rf-section" id="register">
	<div class="container rf-apply">
		<div class="section-head">
			<p class="kicker">紹介先の登録</p>
			<h2>紹介先を登録する</h2>
			<p class="rf-apply-lead">送信後3営業日以内に、当社との既存の接点の有無と、対象になるかどうかをお知らせします。報酬の決まりは<a href="/crm/referral/#rules">紹介の決まり</a>をご覧ください。</p>
		</div>
		<PartnerForm
			formId={FORM_ID}
			fields={fields}
			button="紹介先を登録する"
			done="ご紹介ありがとうございます。3営業日以内に、山口からご連絡します。"
		/>
	</div>
</section>

</BaseLayout>

<script is:inline>
	document.querySelectorAll('[data-copy-target]').forEach(function (btn) {
		btn.addEventListener('click', function () {
			var el = document.getElementById(btn.dataset.copyTarget);
			if (!el || !navigator.clipboard) return;
			navigator.clipboard.writeText(el.textContent).then(function () {
				var label = btn.textContent;
				btn.textContent = 'コピーしました';
				setTimeout(function () { btn.textContent = label; }, 1800);
			});
		});
	});
</script>

<style>
	.kicker {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
	}
	.kicker a { color: inherit; }
	.rf-hero { padding: var(--space-xl) 0 var(--space-lg); }
	.rf-hero h1 { margin: 0.75rem 0 1.25rem; font-size: clamp(1.6rem, 3.6vw, 2.3rem); line-height: 1.45; }
	.rf-hero .lead { max-width: 44rem; margin: 0 0 var(--space-md); color: var(--color-text); font-size: 1.05rem; line-height: 1.9; }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
	.rf-section { padding: var(--space-xl) 0; }
	.rf-section--subtle { background: var(--color-bg-subtle); }
	.section-head { margin-bottom: var(--space-md); }
	.section-head h2 { margin: 0.5rem 0 0; font-size: clamp(1.3rem, 3vw, 1.7rem); line-height: 1.5; }
	.kit-block { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius); padding: var(--space-md); margin-bottom: var(--space-sm); }
	.kit-block h3 { margin: 0; font-size: 1rem; }
	.kit-block-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 0.75rem; }
	.kit-oneliner { margin: 0.75rem 0 0; line-height: 1.9; }
	.kit-messages { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); margin-bottom: var(--space-sm); }
	.kit-messages .kit-block { margin-bottom: 0; }
	.kit-text { margin: 0; white-space: pre-wrap; word-break: break-word; font-family: inherit; font-size: 0.95rem; line-height: 1.85; background: var(--color-bg-subtle); border-radius: 0.5rem; padding: 1rem; }
	.kit-copy { flex: none; padding: 0.45rem 0.9rem; border: 1px solid var(--color-primary); border-radius: 0.4rem; background: #fff; color: var(--color-primary); font-weight: 700; font-size: 0.85rem; cursor: pointer; }
	.kit-copy:hover { background: #eff6ff; }
	.kit-copy:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
	.kit-sub { margin: 0.5rem 0 0.75rem; color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.8; }
	.kit-sub a { color: var(--color-primary); }
	.kit-materials { list-style: none; margin: 0 0 var(--space-md); padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-sm); }
	.kit-materials li { background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius); padding: 1rem 1.1rem; }
	.kit-materials a { color: var(--color-primary); font-weight: 700; }
	.kit-materials p { margin: 0.35rem 0 0; color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.7; }
	.kit-screens { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-sm); }
	.kit-screens figure { margin: 0; }
	.kit-screens img { width: 100%; height: auto; border: 1px solid var(--color-border); border-radius: var(--radius); display: block; }
	.kit-screens figcaption { margin-top: 0.4rem; color: var(--color-text-muted); font-size: 0.85rem; }
	.kit-two { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-lg); }
	.kit-list { margin: 0; padding-left: 1.3rem; display: grid; gap: 0.5rem; }
	.kit-list li { line-height: 1.8; }
	.rf-faq { margin: 0; display: grid; gap: var(--space-sm); max-width: 48rem; }
	.rf-faq dt { font-weight: 700; line-height: 1.7; }
	.rf-faq dd { margin: 0.3rem 0 0; color: var(--color-text-muted); line-height: 1.85; }
	.rf-apply { max-width: 44rem; }
	.rf-apply-lead { margin: 0.75rem 0 0; color: var(--color-text-muted); line-height: 1.8; }
	.rf-apply-lead a { color: var(--color-primary); }
	@media (max-width: 860px) {
		.kit-messages, .kit-two, .kit-screens { grid-template-columns: 1fr; }
		.kit-materials { grid-template-columns: 1fr; }
	}
</style>
