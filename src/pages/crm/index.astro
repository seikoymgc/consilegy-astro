---
import { featureCount } from '../../data/crm-features';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrmSubnav from '../../components/CrmSubnav.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// 概要ページは9セクション（スマートフォンを2026-09-29に追加）。機能の詳細は /crm/features/、料金の詳細と契約条件は /crm/pricing/、
// 質問の全件は /crm/faq/、事業タイプ別の説明は各エディションのページに任せる。

const supports = [
	{ tier: '操作動画・ヘルプ記事', figure: '無料', text: '画面の使い方を動画と記事で（1年契約が必要）。操作動画は順次公開します。' },
	{ tier: '初期設定', figure: '120,000円〜', text: 'ヒアリング、初期設定と権限の設計、操作説明会3回。' },
	{ tier: '定着支援（3ヶ月）', figure: '300,000円〜', text: '週1回の定例、設定の見直し、入力が止まっている方へのフォロー。' },
	{ tier: '運用支援', figure: '月額30,000円〜', text: '設定変更の代行と、ご質問への対応（月2時間まで）。' },
	{ tier: '追加開発', figure: '要見積', text: 'その会社の運用に合わせて、追加機能を開発します。' },
];

const proofStats = [
	{ figure: '40社以上', label: 'CRM / MA / SFAの導入支援' },
	{ figure: '175本', label: '収録している自動化（4エディション共通）' },
	{ figure: '3言語', label: '日本語 / English / 繁體中文をUIごと切替' },
	{ figure: '掲載', label: 'See News（花蓮視新聞）2026年6月25日' },
];

const mobilePoints = [
	{ title: '専用アプリは不要', text: 'ブラウザで開くだけです。画面はスマートフォンの幅に合わせて切り替わります。' },
	{ title: '名刺はその場で撮る', text: 'ボタンを押すとカメラが開き、撮った名刺をAIが読み取ります。訪問先や展示会でそのまま登録できます。' },
	{ title: '外出先で商談を確認', text: '金額・ステージ・次の予定まで、移動中に確かめられます。' },
	{ title: 'パソコンと同じデータ', text: '見ているのは同じ顧客データです。スマートフォンで直した内容は、そのままパソコンにも反映されます。' },
];

const outcomes = [
	{
		problem: '入力：名刺、メモ、録音の中身が、担当者の手元に残る',
		answer: 'AIが読み取り・文字起こしをして、顧客と商談の記録の下書きにします。',
	},
	{
		problem: '設定：CRMを入れても、項目とパイプラインの設計から始まる',
		answer: '業務に合わせた初期設定を済ませた状態で、使い始められます。',
	},
	{
		problem: '運用：フォローや更新の抜け漏れを、人が見張っている',
		answer: '175本の自動化が停滞や期日を検知して、担当者に知らせます。',
	},
];

const editions = [
	{
		noun: '商談',
		title: 'B2B',
		text: '法人営業向け。見込み客を商談として管理し、パイプライン、見積、フォーキャスト、停滞アラートに対応。',
		href: '/crm/features/',
		linkLabel: `機能一覧を見る（全${featureCount()}項目）`,
	},
	{
		noun: '案件',
		title: '受託開発',
		text: '支援会社・受託開発向け。見積、受注、納品、請求、保守更新までを案件単位で管理。',
		href: '/crm/contractor/',
		linkLabel: '受託開発版を見る',
	},
	{
		noun: '契約',
		title: '代理店',
		text: 'SaaSリセラー向け。契約更新、解約リスク、更新商談、クロスセル候補を追跡。',
		href: '/crm/reseller/',
		linkLabel: '代理店版を見る',
	},
	{
		noun: '在籍',
		title: 'スクール',
		text: 'B2Cの教室・スクール向け。生徒の在籍、継続、休会、退会を管理。',
		href: '/crm/school/',
		linkLabel: 'スクール版を見る',
	},
];

const plans = [
	{
		tier: 'ユーザープラン',
		for: 'B2B・受託開発・代理店版／毎日CRMを使う会社に',
		figure: '3,000',
		unit: '/ 人 / 月',
	},
	{
		tier: '生徒数プラン',
		for: 'B2C（スクール）版／毎日運用しているスクール・教室に',
		figure: '9,800',
		unit: '/ 月から',
	},
	{
		tier: 'プリペイドプラン',
		for: '全エディション／使う頻度が低い会社や、月によって利用に波がある会社・スクールに',
		figure: '3,000',
		unit: '/ 月',
	},
];

// 文面は /crm/school/ の safeguards と同じ系統。全6項目のうち、導入前に聞かれる3つだけを出す。
const safeguards = [
	{
		label: '学習に使われない',
		text: '名刺や手書きの読み取り、文字起こしでは、送信した内容を学習に使わない条件のサービスを利用しています。',
	},
	{
		label: '他社に見えない',
		text: '会社ごとの隔離は、データベースの行単位のアクセス制御で行っています。アプリ側の絞り込みには頼りません。',
	},
	{
		label: '東京に置いてある',
		text: 'データは東京リージョンに保存しています。AIの処理は Anthropic・OpenAI・Google（米国）を経由しますが、送った内容を学習に使わせない契約です。',
	},
];

// 全件は src/data/crm-faq.ts（/crm/faq/）。ここは購入前に最も聞かれる5問だけ。
const faqs = [
	{
		q: '料金はいくらですか。',
		a: 'プランは3つです。ユーザープランは1人あたり月額3,000円、スクール向けの生徒数プランは在籍生徒50人まで月額9,800円からです。使う頻度が低い会社には、月額3,000円（燃料100付き）に必要な分だけ追加するプリペイドプランがあります。初期費用はありません。どのプランも30日間の無料トライアル付きで、カード登録なしで始められます。価格はすべて税抜です。',
	},
	{
		q: 'ユーザー数はどう数えますか。',
		a: 'ワークスペースに参加しているメンバーの数です。招待したまま使っていないアカウントも含みます。人数の増減は、次回の請求から反映されます。',
	},
	{
		q: '解約はどうすればいいですか。',
		a: 'ユーザープランと生徒数プランの契約期間は1年で、以後1年ごとに自動更新します。契約期間の途中で解約することはできません。終了する場合は、契約期間の満了日の1ヶ月前までにご連絡ください。プリペイドプランは1ヶ月ごとの自動更新で、次の契約更新日の14日前までのご連絡で終了できます。お支払いは毎月の前払いで、お支払い済みの料金は返金しません。',
	},
	{
		q: 'データを取り出せますか。',
		a: 'コンタクト、会社、商談をCSVで書き出せます。ご契約終了日から30日間も書き出せます。自社のデータは自社のものです。',
	},
	{
		q: 'いま使っているCRMからデータを移行できますか。',
		a: 'Revenue CRMは、CRMの運用に専任の担当者を置きにくい組織のために作っています。Salesforce・HubSpotなどを専任の担当者が運用している場合は、乗り換えではなく、そのツールを活かした導入・運用支援をご提案します。HubSpotのデータは、置き換えずに読み取って取り込めます。',
	},
];

const readings = [
	{ href: '/insights/why-crm-adoption-fails/', title: 'CRMが定着しない本当の理由' },
	{ href: '/insights/why-companies-cannot-stop-using-excel-after-crm/', title: 'CRMを導入してもExcelが止まらない理由' },
	{ href: '/insights/why-sfa-becomes-just-a-pipeline-sheet/', title: 'SFAがパイプライン管理表になってしまう理由' },
	{ href: '/insights/why-marketing-automation-does-not-improve-pipeline/', title: 'MAを導入しても商談化率が改善しない理由' },
	{ href: '/insights/why-sales-forecasting-fails/', title: 'なぜ売上予測は外れ続けるのか' },
	{ href: '/insights/what-changes-in-crm-design-when-ai-writes-records/', title: 'AIが記録を書くようになると、CRM設計は何が変わるか' },
];

---

<BaseLayout
	title="国産CRM「Revenue CRM」| CRMを入れて、仕事を増やさない。中小企業向けCRM/SFA"
	description="マーケティング・営業・顧客管理を一つの顧客データでつなぐ中小企業向けのCRM/SFA（顧客管理・営業管理ツール）。入力・設定・運用という「CRMのための仕事」を、AIによる記録、175本の自動化、業務別の初期設定で減らします。B2B・支援会社／受託開発・代理店・スクールの4エディション。1アカウント月額3,000円（税抜）、30日間無料。"
	ogImage="/images/crm/og-crm.png"
	lang="ja"
	alternateUrl="/en/crm/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "Revenue CRM",
	"alternateName": ["レベニューCRM"],
	"applicationCategory": "BusinessApplication",
	"applicationSubCategory": "CRM/SFA（顧客管理・営業管理ツール）",
	"operatingSystem": "Web",
	"url": "https://consilegy.com/crm/",
	"description": "マーケティング（MA）・営業（SFA）・顧客管理（CRM）を一つの顧客データでつなぐ中小企業向けのCRM/SFA（顧客管理・営業管理ツール）。入力・設定・運用という「CRMのための仕事」を、AIによる記録、175本の自動化、業務別の初期設定で減らす。B2B、支援会社・受託開発、代理店（SaaSリセラー）、スクール（B2C）の4エディション。2026年9月28日正式提供開始。",
	"inLanguage": ["ja", "en", "zh-Hant"],
	"offers": {
		"@type": "Offer",
		"price": "3000",
		"priceCurrency": "JPY",
		"description": "ユーザープラン1人あたり月額3,000円（税抜）。生徒数プランは月額9,800円から、プリペイドプランは月額3,000円（燃料100付き）。初期費用なし。30日間の無料トライアル（カード登録不要）。"
	},
	"author": { "@type": "Organization", "name": "Consilegy合同会社", "url": "https://consilegy.com/" }
})} />

<CrmSubnav lang="ja" />

<!-- ===================== 1. HERO ===================== -->
<section class="crm-hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">
				<img class="eyebrow-mark" src="/images/crm/logo/revenue-crm-logo-teal.svg" alt="" width="26" height="26" decoding="async" />
				Revenue CRM
			</p>
			<h1>CRMを入れて、<br />仕事を増やさない。</h1>
			<p class="hero-lead">
				マーケティング・営業・顧客管理を、一つの顧客データでつなぐ中小企業向けのCRM/SFA（顧客管理・営業管理ツール）です。
				入力・設定・運用という「CRMのための仕事」を、AIによる記録、175本の自動化、業務別の初期設定で減らします。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href={SIGNUP_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">無料で始める</a>
			</div>
			<p class="hero-note">メールアドレスだけで実際の画面に入れます。パスワード登録も営業連絡もありません。<br /><a href="/crm/download/">サービス紹介資料（PDF）をダウンロード</a></p>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/screen-dashboard-2026-09.webp"
				alt="Revenue CRMのダッシュボード。パイプライン総額、加重フォーキャスト、勝率、期限切れタスク、ステージ別パイプライン、注目の商談を一画面に表示。"
				width="1600"
				height="1000"
				decoding="async"
				fetchpriority="high"
			/>
			<figcaption>ダッシュボード：最初に見る数字と、次に動く相手を同じ画面で</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 2. 何を解決するか ===================== -->
<section class="crm-problems" id="problems">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">課題</p>
			<h2>つなごうとすると、<br />仕事が増える。</h2>
		</div>
		<p class="section-lead">顧客との関係は、マーケティング、営業、顧客対応という部署とツールの境界で切れます。つなごうとしてツールを入れると、今度は入力・設定・運用という「CRMのための仕事」が生まれます。</p>
		<ol class="problem-table">
			{outcomes.map((item) => (
				<li>
					<strong>{item.problem}</strong>
					<span>{item.answer}</span>
				</li>
			))}
		</ol>
		<p class="section-foot">
			<a href="/crm/faq/what-is-crm/">CRMとは何か</a>と<a href="/crm/faq/crm-sfa-ma-difference/">SFA・MAとの違い</a>は、よくあるご質問にまとめています。
		</p>
	</div>
</section>

<!-- ===================== 3. 使い方 ===================== -->
<section class="crm-editions" id="use-cases">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">使い方</p>
			<h2>空のCRMは渡しません。</h2>
		</div>
		<p class="section-lead">用途を選ぶと、初期設定済みの状態で使い始められます。管理する単位が違うため、B2B（案件）とB2C（生徒）は最初から別に設計しています。</p>
		<div class="edition-list">
			{editions.map((item) => (
				<article class="edition-item">
					<span>{item.noun}</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					<a href={item.href}>{item.linkLabel}</a>
				</article>
			))}
		</div>
		<figure class="hero-media usecase-media">
			<img
				src="/videos/revenue-crm-demo-2026-09.gif"
				alt="Revenue CRMの操作デモ。ダッシュボード、商談カンバン、自動化ライブラリ、AIエージェント、3言語切替を順に操作している。"
				width="800"
				height="585"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>操作デモ：ダッシュボード、商談カンバン、自動化ライブラリ、AIエージェント、3言語切替</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 4. 入力が増えない ===================== -->
<section class="crm-proof" id="input-assist">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">設計の考え方</p>
			<h2>人をCRMに合わせるのではなく、<br class="br-narrow" />CRMを人の仕事に合わせる。</h2>
		</div>
		<p class="section-lead">
			入力はAIが下書きし、設定は済ませてあり、運用は自動化が回します。<br />
			人は撮る・上げる・確かめるだけです。
		</p>
		<div class="assist-panel">
			<div>
				<p class="kicker">AIエージェント</p>
				<h3>AIエージェントは、記録の入口です。</h3>
			</div>
			<p>
				日本語で聞く。名刺を撮る。会話を貼る。録音を上げる。
				作成された文面やデータは、保存と送信の前に必ず人が確認します。
				APIキーは自社のもの（Anthropic / OpenAI / Gemini / Azure OpenAI）を持ち込めます。
			</p>
		</div>
		<ul class="proof-strip">
			{proofStats.map((item) => (
				<li>
					<strong>{item.figure}</strong>
					<span>{item.label}</span>
				</li>
			))}
		</ul>
		<p class="proof-note">
			※「40社以上」は、代表 山口聖子が個人事業時代を含めてCRM / MA / SFAの導入を支援した累計社数です。
			導入企業名は、各社の了承を得たものから公開します。
		</p>
	</div>
</section>

<!-- ===================== スマートフォン（他のLPは components/CrmMobile.astro。文言を変えるときは両方直す） ===================== -->
<section class="crm-mobile" id="mobile">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">スマートフォン</p>
			<h2>スマートフォンでも、<br class="br-narrow" />そのまま使えます。</h2>
		</div>
		<div class="mobile-inner">
			<ul class="mobile-points">
				{mobilePoints.map((item) => (
					<li>
						<strong>{item.title}</strong>
						<span>{item.text}</span>
					</li>
				))}
			</ul>
			<div class="mobile-shots">
				<img src="/images/crm/screen-mobile-dashboard-2026-09.webp" alt="スマートフォンで開いたRevenue CRMのダッシュボード" width="390" height="844" loading="lazy" decoding="async" />
				<img src="/images/crm/screen-mobile-deals-2026-09.webp" alt="スマートフォンで開いたRevenue CRMの商談一覧（カンバン表示）" width="390" height="844" loading="lazy" decoding="async" />
			</div>
		</div>
	</div>
</section>

<!-- ===================== 開発背景 ===================== -->
<section class="crm-origin" id="origin">
	<div class="container origin-inner">
		<div class="origin-copy">
			<p class="kicker">開発背景</p>
			<h2>台湾・花蓮の拠点から生まれました。</h2>
			<p>
				構想が形になったのは、台湾・花蓮県が運営する「花蓮雲基地 Hualien Cloud Hub」です。
				代表の山口聖子が第1期メンバーとして滞在し、各国の起業家やリモートワーカーとの協働から
				CRMとAIを組み合わせたこのプロダクトの形が固まりました。
			</p>
			<p>この経緯は、See News（花蓮視新聞）2026年6月25日の記事で紹介されています。</p>
			<a
				href="https://www.seenews.com.tw/news_data.php?news_id=2325&amp;k_code=A"
				target="_blank"
				rel="noopener noreferrer"
				class="origin-link"
			>掲載記事を読む</a>
		</div>
		<figure class="origin-press">
			<img
				src="/images/common/seenews-hualien-2026-photo.jpg"
				alt="See News（花蓮視新聞）2026年6月25日の掲載記事。花蓮雲基地の看板の前に立つ代表 山口聖子の写真と、花蓮雲基地でCRMとAIを組み合わせた新製品を開発したことを紹介する本文。"
				width="1000"
				height="1760"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>See News（花蓮視新聞）2026年6月25日掲載</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 5. 料金 ===================== -->
<section class="crm-pricing" id="pricing">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">料金</p>
			<h2>使い方に合わせて、3つのプランから選ぶ。</h2>
		</div>
		<div class="plan-summary">
			{plans.map((plan) => (
				<div class="plan-summary__item">
					<p class="price-tier">{plan.tier}{plan.status && <span class="price-status">{plan.status}</span>}</p>
					<p class="price-figure"><span class="price-yen">¥</span>{plan.figure}<span class="price-unit">{plan.unit}</span></p>
					<p class="plan-for">{plan.for}</p>
				</div>
			))}
		</div>
		<div class="plan-summary__foot">
			<p>初期費用はありません。どのプランも30日間の無料トライアル付きで、カード登録なしで始められます。</p>
			<a href="/crm/pricing/" class="btn btn--secondary">料金の詳細</a>
		</div>
		<p class="proof-note">※価格はすべて税抜表示です。</p>
	</div>
</section>

