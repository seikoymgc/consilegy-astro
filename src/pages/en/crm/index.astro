---
import { featureCount } from '../../../data/crm-features';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrmSubnav from '../../../components/CrmSubnav.astro';
import CrmLanguages from '../../../components/CrmLanguages.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos?lang=en';
const SIGNUP_URL = 'https://crm.consilegy.com/signup?lang=en';

// Mirrors /crm/ section for section (hero split, assurance, problems, after + pricing, editions,
// mobile, support + security, FAQ, final CTA). Feature detail lives on /en/crm/features/,
// pricing detail and terms on /en/crm/pricing/, the school edition on /en/crm/school/.
// There is no English download page yet, so the PDF links on /crm/ are left out here.

const supports = [
	{ tier: 'Videos & help articles', figure: 'Free', text: 'Free on every plan. Where teams that set it up themselves start.' },
	{ tier: 'Initial setup', figure: '¥120,000 and up', text: 'Fields, deal stages, and automations set to how your team works. 3 walkthrough sessions.' },
	{ tier: 'Adoption support (3 months)', figure: '¥300,000 and up', text: 'A weekly meeting, review of settings, and one-on-one help with how to use it.' },
	{ tier: 'Operations support', figure: '¥30,000 / month and up', text: 'We make settings changes for you and answer your questions (up to 2 hours a month).' },
	{ tier: 'Custom development', figure: 'Quoted', text: 'We add features to fit the way your company runs.' },
];

const mobilePoints = [
	{ title: 'No app to install', text: 'Open it in the browser. The screens switch to fit the width of your phone.' },
	{ title: 'Scan cards on the spot', text: 'Photograph a business card and AI reads it, so you can add contacts at a client site or a trade show.' },
	{ title: 'Check deals on the go', text: 'Amount, stage, and the next appointment, all checkable between meetings.' },
	{ title: 'Same data as your PC', text: 'What you change on your phone shows up on your computer straight away.' },
];

// Left: how a rollout usually slides back. Right: what Revenue CRM does about it.
const problems = [
	{ topic: 'Data entry', problem: 'Typing it all in<br />is painful.', answer: 'Speak and it becomes a record. Photograph a card and the contact is in. Paste meeting notes and you get tasks and contacts. People only check and save.' },
	{ topic: 'Getting started', problem: 'Learning the system<br />takes too long.', answer: "We don't hand you an empty system. Pick your use case and you start with deal stages and the automations teams use most already in place." },
	{ topic: 'Knowledge silos', problem: 'The one person who ran it<br />leaves.', answer: 'Settings stay visible in the screens, and automations are picked from a library of 175. How-to videos and help articles are free on every plan.' },
];

const afters = [
	{ title: 'Revenue grows', figure: '175', unit: 'automations', note: 'Watching for stalled deals and due dates', text: 'AI suggests the next action for each customer. Leads no longer get handed over and forgotten.' },
	{ title: 'Time comes back', figure: '3', unit: 'ways in', note: 'Snap, speak, paste. AI drafts the record', text: "No more chasing people with “Did anyone call them?” or “Who owns this account?”" },
	{ title: 'Friction between teams fades', figure: '1', unit: 'record', note: 'Marketing, sales, and success on one customer record', text: 'Everyone sees the same customer, so teams work together instead of passing the blame.' },
];

const editions = [
	{ noun: 'Deals', title: 'B2B sales', href: '/en/crm/features/' },
	{ noun: 'Projects', title: 'Agencies & contract work', href: '/en/crm/contractor/' },
	{ noun: 'Contracts', title: 'SaaS resellers', href: '/en/crm/reseller/' },
	{ noun: 'Enrollment', title: 'Schools', href: '/en/crm/school/' },
];

const plans = [
	{ tier: 'User plan', figure: '¥3,000', unit: '/ user / month', for: 'B2B, agency, and reseller editions. For teams that use it every day' },
	{ tier: 'Student plan', figure: '¥9,800', unit: '/ month and up', for: 'School edition. Up to 50 enrolled students' },
	{ tier: 'Prepaid plan', figure: '¥3,000', unit: '/ month', for: 'All editions. For teams that use it less often' },
];

// Same family as the safeguards on /en/crm/school/. Only the three asked about before buying.
const safeguards = [
	{ label: 'Never trained on', text: 'Card scanning, handwriting recognition, and transcription run on services under terms that exclude what you send from training.' },
	{ label: 'Invisible to other companies', text: 'Each company is isolated by row-level access control in the database, not by filtering in the application.' },
	{ label: 'Held in Tokyo', text: 'Data is stored in the Tokyo region. AI processing goes through Anthropic, OpenAI, and Google (US), under contracts that exclude what you send from training.' },
];

const faqs = [
	{ q: 'What does it cost?', a: 'There are three plans. The User plan is ¥3,000 per user per month. The Student plan for schools starts at ¥9,800 per month for up to 50 enrolled students. For teams that use it less often, the Prepaid plan is ¥3,000 per month with 100 Fuel, topped up as needed. No setup fee. Every plan comes with a 30-day free trial, no card required. All prices exclude tax.' },
	{ q: 'How are users counted?', a: 'By the members who have joined the workspace, including accounts that were invited but are not in use. Changes apply from the next invoice.' },
	{ q: 'How do we cancel?', a: 'The User and Student plans run for 1 year and renew automatically each year. They cannot be cancelled mid-term; to end one, let us know at least 1 month before the term ends. The Prepaid plan renews monthly and ends if you tell us at least 14 days before the next renewal date. Payment is monthly in advance, and fees already paid are not refunded.' },
	{ q: 'Can we take our data out?', a: 'Export contacts, companies, and deals, plus activities, notes, tasks, emails, and attachments, to CSV from Settings at any time, and for 30 days after the contract ends. Your data is yours.' },
	{ q: 'Can we migrate from the system we use today?', a: 'Revenue CRM is built for teams that cannot dedicate someone to running a CRM. If a dedicated admin already runs Salesforce or HubSpot, we suggest keeping it and support implementation and operations on that tool instead. HubSpot data can be read in without replacing it.' },
];

const readings = [
	{ href: '/en/insights/why-crm-implementation-fails-without-revenue-architecture/', title: 'Why CRM implementation fails without revenue architecture' },
	{ href: '/en/insights/where-japan-gtm-breaks-after-lead-generation/', title: 'Where Japan GTM breaks after lead generation' },
	{ href: '/en/insights/lead-handoff-rules-for-japan-gtm-teams/', title: 'Lead handoff rules for Japan GTM teams' },
];
---

<BaseLayout
	title="AI and automation do the work. A CRM your team won't hate updating | Revenue CRM"
	description="AI and automation do the work: Revenue CRM is a CRM your team won't hate updating. Photograph a business card, or speak or paste your meeting notes, and AI drafts the record for a person to check. One customer record across marketing, sales, and customer success, for small and mid-sized companies. Editions for B2B sales, agencies and contract work, SaaS resellers, and schools. From ¥3,000 per user per month, with a 30-day free trial."
	ogImage="/images/og/crm-en-2026c.png"
	lang="en"
	alternateUrl="/crm/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "Revenue CRM",
	"applicationCategory": "BusinessApplication",
	"applicationSubCategory": "CRM / SFA (customer relationship management and sales force automation)",
	"keywords": "CRM, SFA, sales CRM, small business CRM, AI CRM, business card scanning, meeting notes",
	"operatingSystem": "Web",
	"url": "https://consilegy.com/en/crm/",
	"description": "Revenue CRM: AI and automation do the work, in a CRM your team won't hate updating. Photograph a business card, or speak or paste meeting notes, and AI drafts the record for a person to check. Marketing, sales, and customer success share one customer record. Built for small and mid-sized companies, with editions for B2B sales, agencies and contract work, SaaS resellers, and schools (B2C). The B2B, agency, and reseller editions ship with 175 automations and use-case defaults. Generally available since 28 September 2026.",
	"inLanguage": ["ja", "en", "zh-Hant"],
	"offers": {
		"@type": "Offer",
		"price": "3000",
		"priceCurrency": "JPY",
		"description": "User plan ¥3,000 per user per month (excl. tax). Student plan from ¥9,800 per month; Prepaid plan ¥3,000 per month with 100 Fuel. No setup fee. 30-day free trial, no card required."
	},
	"author": { "@type": "Organization", "name": "Consilegy LLC", "url": "https://consilegy.com/en/" }
})} />

<CrmSubnav lang="en" />

<!-- ===================== HERO (same pattern as /crm/: left = B2B sales, right = schools; headline and CTA below) ===================== -->
<section class="hero">
	<div class="hero-split">
		<div class="hero-half hero-half--b2b">
			<div class="hero-half__inner">
				<p class="hero-half__tag">B2B sales</p>
				<p class="hero-half__title">For teams losing hours<br />to sales notes and reports.</p>
				<p class="hero-half__text">Paste the meeting notes, and transcripts come in on their own. AI drafts the record; a person checks it and saves.</p>
				<a class="btn hero-half__btn" href="/en/crm/features/">See the B2B edition →</a>
				<img
					class="hero-half__shot"
					src="/images/crm/screen-dashboard-2026-10c-en.webp"
					alt="The Revenue CRM dashboard: open pipeline, weighted forecast, win rate, overdue tasks, pipeline by stage, and deals to watch, on one screen."
					width="1600"
					height="1000"
					decoding="async"
					fetchpriority="high"
				/>
			</div>
		</div>
		<div class="hero-half hero-half--school">
			<div class="hero-half__inner">
				<p class="hero-half__tag">Schools</p>
				<p class="hero-half__title">For schools running students<br />on LINE and spreadsheets.</p>
				<p class="hero-half__text">Students keep messaging you on your LINE official account. Assignments arrive on LINE and are filed to each student automatically.</p>
				<a class="btn hero-half__btn" href="/en/crm/school/">See the school edition →</a>
				<img
					class="hero-half__shot"
					src="/images/common/school-student-detail-en.jpg"
					alt="Revenue CRM school edition: a student's record with assignment submissions and LINE messages in one place."
					width="1100"
					height="744"
					decoding="async"
				/>
			</div>
		</div>
	</div>
	<div class="container hero-base">
		<div class="hero-copy">
			<p class="hero-eyebrow"><img src="/images/crm/logo/revenue-crm-logo-v3.svg" alt="" width="22" height="22" decoding="async" />Revenue CRM</p>
			<h1><span class="hero-h1__lead">AI and automation do the work.</span><br />A CRM your team won't hate updating.</h1>
			<p class="hero-lead">Snap a business card, speak, or paste the meeting notes. AI writes the record.</p>
		</div>
		<div class="hero-cta">
			<div class="hero-actions">
				<a href={SIGNUP_URL} class="btn btn--cta btn--lg" target="_blank" rel="noopener noreferrer">Start free</a>
				<a href={DEMO_URL} class="btn btn--outline-dark btn--lg" target="_blank" rel="noopener noreferrer">See the demo</a>
			</div>
			<p class="hero-proof">From <strong>¥3,000</strong> per user / month<span class="hero-proof__sep">·</span>30-day free trial<span class="hero-proof__sep">·</span>No card required</p>
		</div>
	</div>
</section>

<!-- ===================== ASSURANCE (the system works for people) ===================== -->
<section class="assurance">
	<div class="container">
		<div class="assurance-inner">
			<p class="section-eyebrow">Why It Works</p>
			<h2>People shouldn't work for the system.<br />AI works for the people.</h2>
			<p class="assurance-body">
A CRM for people who don't like opening their CRM. AI writes the records; people check them and save.
Marketing, sales, and customer success share one customer record, in a CRM and sales system (CRM / SFA) built for small and mid-sized companies.
			</p>
			<ul class="assurance-ways" aria-label="Ways to add a record">
				<li><span class="assurance-ways__k">Snap</span>Business cards, by camera</li>
				<li><span class="assurance-ways__k">Speak</span>Meeting notes, by voice</li>
				<li><span class="assurance-ways__k">Paste</span>Meeting transcripts, as they are</li>
			</ul>
		</div>
	</div>
</section>

<!-- ===================== PROBLEMS (three months in, back to spreadsheets) ===================== -->
<section class="why" id="problems">
	<div class="container">
		<p class="section-eyebrow">How a Record Gets Made</p>
		<figure class="input-figure" aria-labelledby="input-figure-caption">
			<svg viewBox="0 0 1120 256" role="img" aria-label="How a record gets made: snap, speak, or paste; AI drafts it; a person checks it; the next step is suggested">
				<defs><marker id="in-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<g font-family="inherit">
<rect x="40" y="20" width="236" height="140" rx="6" fill="#fff" stroke="#E2E8F0"/><rect x="40" y="20" width="236" height="4" rx="2" fill="#8758C9"/><text x="58" y="56" font-size="14" fill="#64748b" letter-spacing="1">INPUT</text><text x="58" y="90" font-size="18" font-weight="600" fill="#0F172A">Snap, speak, paste</text>
<text x="58" y="130" font-size="16" fill="#475569">Cards, voice, notes</text>
<line x1="276" y1="90" x2="308" y2="90" stroke="#0F172A" stroke-width="2" marker-end="url(#in-arr)"/>
<rect x="312" y="20" width="236" height="140" rx="6" fill="#fff" stroke="#E2E8F0"/><rect x="312" y="20" width="236" height="4" rx="2" fill="#8758C9"/><text x="330" y="56" font-size="14" fill="#64748b" letter-spacing="1">AI</text><text x="330" y="90" font-size="18" font-weight="600" fill="#0F172A">AI drafts the record</text>
<text x="330" y="130" font-size="16" fill="#475569">Contacts, deals, tasks</text>
<line x1="548" y1="90" x2="580" y2="90" stroke="#0F172A" stroke-width="2" marker-end="url(#in-arr)"/>
<rect x="584" y="20" width="236" height="140" rx="6" fill="#fff" stroke="#E2E8F0"/><rect x="584" y="20" width="236" height="4" rx="2" fill="#8758C9"/><text x="602" y="56" font-size="14" fill="#64748b" letter-spacing="1">CHECK</text><text x="602" y="90" font-size="18" font-weight="600" fill="#0F172A">A person checks it</text>
<text x="602" y="130" font-size="16" fill="#475569">Fix only what's off</text>
<line x1="820" y1="90" x2="852" y2="90" stroke="#0F172A" stroke-width="2" marker-end="url(#in-arr)"/>
<rect x="856" y="20" width="236" height="140" rx="6" fill="#fff" stroke="#E2E8F0"/><rect x="856" y="20" width="236" height="4" rx="2" fill="#8758C9"/><text x="874" y="56" font-size="14" fill="#64748b" letter-spacing="1">NEXT</text><text x="874" y="90" font-size="18" font-weight="600" fill="#0F172A">Next step suggested</text>
<text x="874" y="130" font-size="16" fill="#475569">175 automations watch</text>
				<rect x="40" y="190" width="1052" height="50" rx="6" fill="#0F172A"/>
				<text x="566" y="221" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">AI takes on the typing. People make the calls.</text>
				</g>
			</svg>
			<figcaption id="input-figure-caption">AI writes the record and a person only checks it. From each saved record, the next step comes up on its own.</figcaption>
		</figure>
		<header class="problems-overview">
			<div class="why-head">
				<p class="section-eyebrow">Common Problems</p>
				<h2>Three months after rollout,<br /><span class="text-emph">the team is back in spreadsheets.</span></h2>
				<p class="section-lead">Launching a system is easy. Getting people to keep using it is the hard part.</p>
			</div>
			<blockquote class="problem-example">
				<p>A CRM is not cheap.<br />Paying for a system nobody uses is <strong>money thrown away</strong>.</p>
			</blockquote>
		</header>
		<div class="problem-rows">
			{problems.map((item, i) => (
				<article class="problem-row">
					<div><p class="problem-topic"><span class="problem-num">0{i + 1}</span>{item.topic}</p><h3 set:html={item.problem} /></div>
					<div class="problem-response"><p class="problem-topic">With Revenue CRM</p><p>{item.answer}</p></div>
				</article>
			))}
		</div>
		<p class="problems-more"><a href="/en/crm/features/" class="btn btn--outline-primary">See all {featureCount()} features →</a></p>
	</div>
</section>

<!-- ===================== AFTER (what changes once it's used) + pricing at a glance ===================== -->
<section class="how" id="benefits">
	<div class="container">
		<header class="sub-head">
			<p class="section-eyebrow">After</p>
			<h2>What changes once it's actually used.</h2>
		</header>
		<div class="after-list">
			{afters.map((item) => (
				<article class="after-item">
					<h3>{item.title}</h3>
					<p class="result-metric"><strong>{item.figure}<span>{item.unit}</span></strong><span class="result-metric__note">{item.note}</span></p>
					<p>{item.text}</p>
				</article>
			))}
		</div>
		<div class="service-summary" id="pricing">
			<h3>Pricing at a glance</h3>
			<dl>
				{plans.map((plan) => (
					<div><dt>{plan.tier}</dt><dd><strong>{plan.figure}</strong> {plan.unit}<br />{plan.for}</dd></div>
				))}
			</dl>
			<p>No setup fee. Every plan comes with a 30-day free trial, no card required. All prices exclude tax.</p>
			<p class="service-summary__links"><a href="/en/crm/pricing/">Pricing details →</a></p>
		</div>
	</div>
</section>

<!-- ===================== EDITIONS (no empty system) + API + numbers ===================== -->
<section class="track" id="use-cases">
	<div class="container">
		<header class="section-head track-head">
			<p class="section-eyebrow">Editions</p>
			<h2>We don't hand you an empty system.</h2>
			<p class="section-lead">Pick your use case and you start with deal stages and the automations teams use most already in place. The school edition connects to LINE, so students can book a lesson in one tap.</p>
		</header>
		<ul class="track-list">
			{editions.map((item) => (
				<li class="track-item"><a href={item.href} class="track-who"><span class="track-noun">{item.noun}</span><span class="track-title">{item.title}</span><span class="track-size">Manage {item.noun.toLowerCase()} →</span></a></li>
			))}
		</ul>
		<figure class="demo-media">
			<img
				src="/videos/revenue-crm-demo-2026-09-en.gif"
				alt="A walkthrough of Revenue CRM, moving through the dashboard, the deal kanban, the automation library, the AI agent, and the three-language switch."
				width="800"
				height="585"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>Walkthrough: dashboard, deal kanban, automation library, AI agent, language switch</figcaption>
		</figure>
		<div class="track-founder">
			<p>
				<strong>An API that connects to almost anything.</strong>
				Many business tools are closed boxes that don't talk to anything else. Revenue CRM has an API, so you can work with it directly from Claude Code and other tools. Bring your own API key for the AI (Anthropic / OpenAI / Gemini / Azure OpenAI).
			</p>
		</div>
		<p class="supported-tools"><span>By the numbers</span>40+ CRM, MA, and SFA rollouts supported by our founder (including her years as an independent consultant) · 175 automations · 3 languages (日本語 / English / 繁體中文) · <a href="https://www.seenews.com.tw/news_data.php?news_id=2325&amp;k_code=A" target="_blank" rel="noopener noreferrer">Covered by See News (花蓮視新聞)</a></p>
	</div>
</section>

<!-- ===================== MOBILE ===================== -->
<section class="mobile" id="mobile">
	<div class="container mobile-inner">
		<div>
			<header class="sub-head">
				<p class="section-eyebrow">Mobile</p>
				<h2>Works on your phone,<br />just as it is.</h2>
			</header>
			<dl class="row-list">
				{mobilePoints.map((item) => (
					<div><dt>{item.title}</dt><dd>{item.text}</dd></div>
				))}
			</dl>
		</div>
		<div class="mobile-shots">
			<img src="/images/crm/screen-mobile-dashboard-2026-10c-en.webp" alt="The Revenue CRM dashboard opened on a smartphone" width="390" height="844" loading="lazy" decoding="async" />
			<img src="/images/crm/screen-mobile-contacts-2026-10c-en.webp" alt="The Revenue CRM contact list opened on a smartphone" width="390" height="844" loading="lazy" decoding="async" />
		</div>
	</div>
</section>

<!-- ===================== LANGUAGES (switch on the same screen; shared with /crm/ via components/CrmLanguages.astro) ===================== -->
<CrmLanguages lang="en" />

<!-- ===================== SUPPORT (setup to adoption) + SECURITY ===================== -->
<section class="why" id="support">
	<div class="container two-col">
		<div>
			<header class="sub-head">
				<p class="section-eyebrow">Support</p>
				<h2>From setup to adoption,<br />we run it with you.</h2>
				<p class="section-lead">We bring the approach that has made CRM stick at 40+ companies. If you'd rather set it up yourself, the how-to videos and help articles are free.</p>
			</header>
			<dl class="row-list row-list--figure">
				{supports.map((item) => (
					<div><dt>{item.tier}<span>{item.figure}</span></dt><dd>{item.text}</dd></div>
				))}
			</dl>
			<p class="row-list__foot">Data migration and integrations with outside services are quoted separately. All prices exclude tax.<a href="/en/crm/pricing/#support">Support details →</a></p>
		</div>
		<div id="security">
			<header class="sub-head">
				<p class="section-eyebrow">Security</p>
				<h2>Every company's data<br />is kept separate.</h2>
			</header>
			<dl class="row-list">
				{safeguards.map((item) => (
					<div><dt>{item.label}</dt><dd>{item.text}</dd></div>
				))}
			</dl>
			<p class="row-list__foot">Sign in with your email address or Google account. Multi-factor authentication (6-digit authenticator codes) is supported. SAML and OIDC single sign-on are not offered yet.</p>
		</div>
	</div>
</section>

<!-- ===================== FAQ ===================== -->
<section class="faq" id="faq">
	<div class="container">
		<header class="sub-head">
			<p class="section-eyebrow">FAQ</p>
			<h2>What people ask before they start.</h2>
		</header>
		<dl class="faq-list">
			{faqs.map((item) => (
				<div class="faq-item"><dt>{item.q}</dt><dd>{item.a}</dd></div>
			))}
		</dl>
		<p class="faq-more"><a href="/en/crm/pricing/" class="btn btn--outline-primary">See pricing and contract terms →</a></p>
		<p class="readings"><span>Know how rollouts fail before you start</span>{readings.map((item) => (<a href={item.href}>{item.title}</a>))}</p>
	</div>
</section>

<!-- ===================== FINAL CTA ===================== -->
<section class="final-cta" id="start">
	<div class="container cta-inner">
		<div class="cta-copy">
			<p class="cta-eyebrow">Get Started</p>
			<h2>Try the product first.</h2>
			<p class="cta-lead">
				Enter an email address and a demo workspace opens, with no password to set. See the records, the automations, and the defaults it starts with, on the real screens.
			</p>
			<p class="cta-lead cta-lead--close">
				If a dedicated admin already runs Salesforce or HubSpot, don't switch.<br />
				Instead, see <a href="/en/services/">how we redesign the system you already have</a>.
			</p>
			<div class="cta-actions">
				<a href={SIGNUP_URL} class="btn btn--cta-primary btn--lg" target="_blank" rel="noopener noreferrer">Start free</a>
				<a href={DEMO_URL} class="btn btn--cta-outline btn--lg" target="_blank" rel="noopener noreferrer">See the demo</a>
			</div>
			<p class="cta-note">Revenue CRM was built at Hualien Cloud Hub (花蓮雲基地) in Hualien, Taiwan, alongside digital nomads from around the world.</p>
		</div>
	</div>
</section>

</BaseLayout>

<style>
