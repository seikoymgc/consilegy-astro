---
import { serviceGuides } from '../data/service-guide';
import NewsletterForm from './NewsletterForm.astro';
const pathname = Astro.url.pathname;
const isEN = pathname.startsWith('/en');
// ニュースレター登録はフッターの上に全ページで出す。登録ページ自体ではフォームが二重になるので出さない。
const showNewsletter = !/^\/(en\/)?newsletter\//.test(pathname);
const nl = isEN
	? { eyebrow: 'Newsletter', title: 'B2B Revenue Strategy, every other week', text: 'Practical notes on Revenue Architecture, RevOps and CRM. Free, unsubscribe anytime.' }
	: { eyebrow: 'Newsletter', title: '次世代B2Bレベニュー戦略バイブル', text: '売上を伸ばすための考え方と、現場での実践例をお届けします。登録は無料です。' };

const services = isEN
	? [
		{ label: 'Japan Market GTM & Messaging',          href: '/en/services/japan-market-gtm-messaging/' },
		{ label: 'Revenue Architecture Design',           href: '/en/services/revenue-architecture-design/' },
		{ label: 'CRM / RevOps Implementation',           href: '/en/services/crm-revops-implementation/' },
		{ label: 'Development & Automation',               href: '/en/services/business-system-development/' },
		{ label: 'HubSpot Implementation & Ops',          href: '/en/services/hubspot-implementation-operations-support/' },
		{ label: 'Adoption & Growth Support',             href: '/en/services/adoption-growth-support/' },
	]
	: serviceGuides.map(service => ({ label: service.name, href: `/services/${service.slug}/` }));

// サービス以外のリンクは用途ごとに束ねる。1列に詰めると17行になり、どこに何があるか分からなかった。
const groups = isEN
	? [
		{ heading: 'Revenue CRM', links: [
			{ label: 'Revenue CRM',          href: '/en/crm/' },
			{ label: 'Revenue CRM (School)', href: '/en/crm/school/' },
			{ label: 'Revenue CRM Guides',   href: '/en/crm/media/' },
		] },
		{ heading: 'Learn', links: [
			{ label: 'Case Studies', href: '/en/case-studies/' },
			{ label: 'Insights',     href: '/en/insights/' },
			{ label: 'B2B Revenue Strategy Journal', href: 'https://media.consilegy.com/en/' },
			{ label: 'Newsletter',   href: '/en/newsletter/' },
		] },
		{ heading: 'Company', links: [
			{ label: 'About',    href: '/en/company/' },
			{ label: 'Security', href: '/en/security/' },
			{ label: 'News',     href: '/en/news/' },
			{ label: 'Contact',  href: '/en/contact/' },
		] },
	]
	: [
		{ heading: 'Revenue CRM', links: [
			{ label: '法人向け',           href: '/crm/' },
			{ label: 'スクール版',         href: '/crm/school/' },
			{ label: '代理店版',           href: '/crm/reseller/' },
			{ label: '受託開発・制作版',    href: '/crm/contractor/' },
			{ label: '支援会社版',         href: '/crm/services/' },
			{ label: '紹介パートナー制度',  href: '/crm/referral/' },
			{ label: '使い方',             href: '/crm/media/' },
			{ label: '製品一覧',           href: '/products/' },
		] },
		{ heading: '読む', links: [
			{ label: 'インサイト',                  href: '/insights/' },
			{ label: '導入事例',                   href: '/case-studies/' },
			{ label: 'B2Bレベニュー戦略ジャーナル',  href: 'https://media.consilegy.com/' },
			{ label: 'レベニューアーキテクチャとは', href: '/revenue-architecture/' },
			{ label: 'RevOpsとは',                 href: '/about-revops/' },
			{ label: 'ニュースレター',              href: '/newsletter/' },
		] },
		{ heading: '相談する', links: [
			{ label: '収益を自己診断（3分）',      href: '/diagnostic/' },
			{ label: '30分無料相談',              href: '/free-consultation/' },
			{ label: '収益構造の現状分析（有償）', href: '/revops-assessment/' },
			{ label: '資料ダウンロード',           href: '/download/' },
			{ label: 'お問い合わせ',              href: '/contact/' },
		] },
		{ heading: '会社', links: [
			{ label: '会社概要',     href: '/company/' },
			{ label: 'セキュリティ', href: '/security/' },
			{ label: 'ニュース',     href: '/news/' },
			{ label: 'English site', href: '/en/' },
		] },
	];

const starRegistryHref = 'https://cloudsecurityalliance.org/star/registry/consilegy-llc';

const privacyHref = isEN ? '/en/privacy-policy/' : '/privacy-policy/';
---

{showNewsletter && (
	<section class="footer-newsletter" aria-label={nl.eyebrow}>
		<div class="container footer-newsletter__inner">
			<div class="footer-newsletter__copy">
				<p class="footer-newsletter__eyebrow">{nl.eyebrow}</p>
				<p class="footer-newsletter__title">{nl.title}</p>
				<p class="footer-newsletter__text">{nl.text}</p>
			</div>
			<div class="footer-newsletter__form">
				<NewsletterForm lang={isEN ? 'en' : 'ja'} compact />
			</div>
		</div>
	</section>
)}

<footer class={`site-footer${isEN ? ' site-footer--en' : ''}`}>
	<div class="container site-footer__grid">

		<!-- Brand -->
		<div class="site-footer__brand">
			<a class="site-footer__logo-link" href={isEN ? '/en/' : '/'}>
				<img
					src="/images/common/consilegy-logo-white.svg"
					alt="Consilegy"
					height="28"
					width="155"
					class="site-footer__logo"
				/>
			</a>
			<!-- 会社のミッション（会社ページの見出しと同じ言葉）。説明文は置かない -->
			<p class="site-footer__tagline">{isEN ? 'Give society more choices.' : '社会に、選択肢を増やす。'}</p>
			<!-- IPA の規約で、ロゴは背景色の上に直接置かない（視認性）。CSA も同じ白い台に載せる -->
			<div class="site-footer__badges">
				<a
					class="site-footer__security"
					href="https://www.ipa.go.jp/security/security-action/"
					target="_blank"
					rel="noopener noreferrer"
				>
					<img
						src="/images/common/security-action-futatsuboshi-2026.png"
						alt={isEN ? 'SECURITY ACTION: Self-declared information security (two stars)' : 'SECURITY ACTION セキュリティ対策自己宣言 二つ星'}
						width="72"
						height="72"
						loading="lazy"
					/>
				</a>
				<a
					class="site-footer__security"
					href={starRegistryHref}
					target="_blank"
					rel="noopener noreferrer"
				>
					<img
						src="/images/common/csa-star-level1-2026.png"
						alt="CSA STAR Level One: Self-Assessment"
						width="72"
						height="72"
						loading="lazy"
					/>
				</a>
			</div>
			<ul class="site-footer__follow" aria-label={isEN ? 'Follow Us' : 'フォロー'}>
				<li>
					<a
						href="https://www.linkedin.com/company/consilegy"
						target="_blank"
						rel="noopener noreferrer"
						class="site-footer__social"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
						</svg>
						LinkedIn
					</a>
				</li>
				<li>
					<a
						href="https://note.com/consilegy"
						target="_blank"
						rel="noopener noreferrer"
						class="site-footer__social"
					>
						<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path d="M0 .279c4.623 0 10.953-.235 15.498-.117 6.099.156 8.39 2.813 8.468 9.374.077 3.71 0 14.335 0 14.335h-6.598c0-9.296.04-10.83 0-13.759-.078-2.578-.814-3.807-2.795-4.041-2.097-.235-7.975-.04-7.975-.04v17.84H0Z"/>
						</svg>
						note
					</a>
				</li>
			</ul>
		</div>

		<div class="site-footer__nav">
			<!-- Services -->
			<div>
				<p class="site-footer__heading">{isEN ? 'Services' : 'サービス'}</p>
				<ul class="site-footer__links">
					{services.map(({ label, href }) => (
						<li><a href={href}>{label}</a></li>
					))}
				</ul>
			</div>

			{groups.map(({ heading, links }) => (
				<div>
					<p class="site-footer__heading">{heading}</p>
					<ul class="site-footer__links">
						{links.map(({ label, href }) => (
							<li><a href={href}>{label}</a></li>
						))}
					</ul>
				</div>
			))}
		</div>

	</div>

	<!-- Bottom bar -->
	<div class="site-footer__bottom">
		<div class="container site-footer__bottom-inner">
			<p>(c) 2026 Consilegy LLC.</p>
			<span class="site-footer__legal">
				<a href={isEN ? '/en/security-policy/' : '/security-policy/'} class="site-footer__privacy">Security Policy</a>
				<a href={privacyHref} class="site-footer__privacy">Privacy Policy</a>
			</span>
		</div>
	</div>
</footer>

<style>
	.footer-newsletter { background: #f1f5f9; border-top: 1px solid #e2e8f0; padding: 2.5rem 0; }
	.footer-newsletter__inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 1.5rem 3rem; align-items: center; }
	.footer-newsletter__eyebrow { margin: 0 0 0.3rem; font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: #64748b; }
	.footer-newsletter__title { margin: 0 0 0.35rem; font-size: 1.15rem; font-weight: 700; color: #0f172a; }
	.footer-newsletter__text { margin: 0; font-size: 0.9rem; line-height: 1.7; color: #475569; }
	@media (max-width: 760px) { .footer-newsletter__inner { grid-template-columns: 1fr; } }

	.site-footer {
		background: #111827;
		color: #CBD5E1;
		margin-top: 0;
	}

	.site-footer__grid {
		/* Reset --container: html[lang="en"] sets 72ch which would narrow the footer */
		--container: 1200px;
		display: grid;
		/* ロゴ・認証バッジの段を上に置き、メニューは全幅で並べる（横に並べると日本語が1語ずつ折り返した） */
		grid-template-columns: minmax(0, 1fr);
		gap: var(--space-xl);
		padding-block: var(--space-2xl) var(--space-xl);
		align-items: start;
	}

	/* リンクは見出しごとの列。列の間に細い縦線を引いて塊を分ける */
	.site-footer__nav {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: var(--space-lg) 0;
	}

	.site-footer--en .site-footer__nav {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.site-footer__nav > div {
		padding-inline: 1.25rem;
		border-left: 1px solid #1f2937;
	}

	.site-footer__nav > div:first-child {
		padding-left: 0;
		border-left: 0;
	}

	/* Brand：左にロゴとミッション、右に認証バッジとSNS */
	.site-footer__brand {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		grid-template-areas:
			"logo badges"
			"tagline badges"
			". follow";
		column-gap: var(--space-xl);
		align-items: start;
		padding-bottom: var(--space-xl);
		border-bottom: 1px solid #1f2937;
	}

	.site-footer__logo-link { grid-area: logo; justify-self: start; }
	.site-footer__tagline {
		grid-area: tagline;
		margin: 0;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		color: #fff;
	}

	.site-footer__badges { grid-area: badges; justify-self: end; }
	.site-footer__follow { grid-area: follow; justify-self: end; }

	/* Brand */
	.site-footer__logo-link {
		display: inline-block;
		margin-bottom: 0.85rem;
		text-decoration: none;
	}

	.site-footer__logo {
		height: 28px;
		width: auto;
		display: block;
	}

	.site-footer__badges {
		display: flex;
		gap: 0.6rem;
	}

	.site-footer__security {
		display: inline-block;
		padding: 6px;
		background: #fff;
		border-radius: 6px;
		line-height: 0;
	}

	.site-footer__security img {
		width: 72px;
		height: 72px;
		display: block;
	}

	/* Column headings */
	.site-footer__heading {
		margin: 0 0 0.75rem;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.78);
	}

	/* Link lists */
	.site-footer__links {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
	}

	.site-footer__links a {
		font-size: 0.85rem;
		font-weight: 500;
		color: #E2E8F0;
		text-decoration: none;
		line-height: 1.4;
		transition: color 0.15s;
	}

	.site-footer__links a:hover { color: #fff; }

	.site-footer__follow {
		list-style: none;
		margin: 1.25rem 0 0;
		padding: 0;
		display: flex;
		gap: 1.25rem;
	}

	.site-footer__follow a {
		font-size: 0.85rem;
		font-weight: 500;
		color: #E2E8F0;
		text-decoration: none;
	}

	.site-footer__follow a:hover { color: #fff; }

	.site-footer__social {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
	}

	/* Bottom bar */
	.site-footer__bottom {
		border-top: 1px solid #1e293b;
	}

	.site-footer__bottom-inner {
		--container: 1200px; /* 上のメニュー段と端を揃える */
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1rem;
		font-size: 0.78rem;
		color: #CBD5E1;
	}

	.site-footer__bottom-inner p { margin: 0; }

	.site-footer__privacy {
		font-size: 0.78rem;
		color: #CBD5E1;
		text-decoration: none;
		transition: color 0.15s;
	}

	.site-footer__privacy:hover { color: #fff; }

	.site-footer__legal { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }

	/* Tablet */
	@media (max-width: 1080px) {
		.site-footer__nav,
		.site-footer--en .site-footer__nav {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}

		.site-footer__nav > div,
		.site-footer__nav > div:first-child {
			padding: 0 1.25rem 0 0;
			border-left: 0;
		}
	}

	@media (max-width: 720px) {
		.site-footer__brand {
			grid-template-columns: minmax(0, 1fr);
			grid-template-areas: "logo" "tagline" "badges" "follow";
		}

		.site-footer__badges,
		.site-footer__follow { justify-self: start; }

		.site-footer__badges { margin-top: 1.25rem; }

		.site-footer__nav,
		.site-footer--en .site-footer__nav {
			grid-template-columns: 1fr 1fr;
		}
	}

	/* SP */
	@media (max-width: 560px) {
		.site-footer__grid {
			padding-block: var(--space-xl) var(--space-lg);
		}

		.site-footer__nav,
		.site-footer--en .site-footer__nav {
			grid-template-columns: 1fr;
			gap: var(--space-md);
		}
	}
</style>
