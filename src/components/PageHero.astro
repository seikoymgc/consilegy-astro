---
import SitePhoto from './SitePhoto.astro';
import type { PhotoSubject } from '../lib/editorial-photos';
interface Props {
	eyebrow?: string;
	title: string;
	lede?: string;
	photo?: PhotoSubject;
	photoCaption?: string;
}

const { eyebrow, title, lede, photo, photoCaption } = Astro.props;
---

<div class="page-hero">
	<div class:list={['container', 'page-hero__inner', { 'page-hero__inner--photo': photo }]}>
		<div>
			{eyebrow && <p class="page-hero__eyebrow">{eyebrow}</p>}
			<h1 class="page-hero__title">{title}</h1>
			{lede && <p class="page-hero__lede">{lede}</p>}
			<slot />
		</div>
		{photo && <SitePhoto subject={photo} lang={Astro.url.pathname.startsWith('/en/') ? 'en' : 'ja'} caption={photoCaption} priority />}
	</div>
</div>

<style>
	.page-hero__inner--photo { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
	@media (max-width: 900px) { .page-hero__inner--photo { grid-template-columns: minmax(0, 1fr); } }

	.page-hero {
		background: var(--color-bg);
		padding-block: var(--space-2xl) var(--space-xl);
	}

	.page-hero__eyebrow {
		margin: 0 0 var(--space-sm);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-navy);
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
	}

	.page-hero__title {
		margin: 0 0 var(--space-md);
		font-size: clamp(1.85rem, 3.5vw, 2.5rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.2;
		color: var(--color-text);
		max-width: 680px;
	}

	.page-hero__lede {
		margin: 0;
		font-size: var(--text-lead);
		line-height: 1.8;
		color: var(--color-text-muted);
		max-width: 58ch;
	}
</style>
