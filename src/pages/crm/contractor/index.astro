---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrmMobile from '../../../components/CrmMobile.astro';
import CrmSubnav from '../../../components/CrmSubnav.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// プロダクトの contractor エディション（src/lib/editions/index.ts）に実装済みの
// ものだけ記載。用語は商談→案件に差し替わる。coreNav は /deals・/companies・
// /quotes・/delivery・/resources、既定の自動化は sal-31/37/39/41 と cs-30。
const screens = [
	{
		src: 'resources',
		title: '空き枠カレンダー',
		desc: 'メンバーごとに、週単位でアサイン済みの人日とキャパを表示します。来月どのメンバーに何人日の空きがあるかを確認できます。',
		alt: '空き枠カレンダーの画面。今週の稼働率62%・今週の空き人日6.4・逼迫週0・余剰週11のカード。その下にメンバー4名×12週の表があり、各セルに割当人日／キャパが入っている。',
	},
	{
		src: 'delivery',
		title: 'デリバリー',
		desc: 'キックオフから検収まで、案件ごとの工程を一覧で確認できます。滞留日数、納期、想定工数と実績工数も同じ行に表示します。',
		alt: 'デリバリーの画面。案件・会社・金額・デリバリー工程・滞留・期限・想定/実績（人日）の列が並び、6件の受注案件が工程ごとに表示されている。',
	},
	{
		src: 'quotes',
		title: '見積書',
		desc: '見積書を下書き・送付済み・承認のステータスで管理できます。明細の数量に人日を入れると、人日×単価で見積額を計算します。',
		alt: '見積書の一覧画面。4件の見積が、承認・下書き・送付済みのステータスバッジとコンタクト・会社・合計金額・有効期限つきで並んでいる。',
	},
	{
		src: 'deals',
		title: '案件',
		desc: '受託開発・制作版では、商談を「案件」と呼びます。アプローチから見積提出まで、ステージごとの金額と件数を確認できます。',
		alt: '案件のカンバン画面。アプローチ・ヒアリング・提案・見積のステージに案件カードが並び、各ステージの合計金額と確度、案件ごとの金額とクローズ予定日が出ている。',
	},
];

// 痛みは 2026-10-26 の公開調査・導入事例の確認をもとに選んだ（市場で最も強い痛みとは確定していない）。
// 原価・収支の管理は製品の範囲外なので、利益の話は痛みに置かない。
const problems = [
	{
		title: '案件が増えるほど、誰が何を持っているか分からない',
		text: '担当者がいないと、その案件がいまどうなっているかを確かめられない。',
	},
	{
		title: '案件・見積・進み具合が、別々の場所にある',
		text: '案件はスプレッドシート、見積はファイル、進み具合はチャット。確かめるたびに探し回っている。',
	},
	{
		title: '見積を出すとき、誰がいつ空くか分からない',
		text: '稼働の見通しがPMの頭の中にしかない。受注してから、回せないと気づく。',
	},
];

// 既定で入る5本（contractor の defaultAutomations = sal-31/37/39/41 と cs-30）。
// text は src/lib/revops/outcomes.ts の日本語。ただしこのエディションでは
// 商談を「案件」と呼ぶので、そこだけ用語を合わせている。
const projectEngine = [
	{ label: '見積', text: '案件が見積のステージに入ると、見積作成のタスクを作成' },
	{ label: '停滞', text: '動きが止まっている案件を検出して通知' },
	{ label: '予測', text: '案件の金額や時期を変更すると、売上予測に反映' },
	{ label: '受注後', text: '受注すると、受注処理のタスクを作成' },
	{ label: '保守更新', text: '保守契約の終了60日前に、更新準備のタスクを作成' },
];

const roles = [
	{ name: 'オーナー', scope: '全案件・稼働・請求・権限設定' },
	{ name: '管理者', scope: '運用全般と権限設定' },
	{ name: 'マネージャー（PM）', scope: '担当チームの案件・見積を閲覧・編集' },
	{ name: 'メンバー', scope: '自分が担当の案件と、その見積のみ' },
];
---

<BaseLayout
	title="Revenue CRM受託開発・制作版 | 見積を出す前に、空きが見えている"
	description="受託開発・制作会社向けの画面構成。案件・見積・稼働・納品を1か所で管理。メンバー×週の空き枠カレンダー、工程ごとの滞留と期限、保守契約の更新リマインドまで。2026年9月28日に正式リリース。どのプランも30日間無料で試せます。"
	lang="ja"
	alternateUrl="/en/crm/contractor/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/crm/"},
		{"@type": "ListItem", "position": 3, "name": "受託開発・制作版", "item": "https://consilegy.com/crm/contractor/"}
	]
})} />

<CrmSubnav lang="ja" />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM · Contractor edition</p>
			<h1>見積を出す前に、<br />空きが見えている。</h1>
			<p class="hero-lead">
				受託開発・Web制作会社向けの顧客管理システムです。案件・見積・メンバーのアサイン・納品を1つの画面で管理でき、見積を出す前に着手できる時期を確認できます。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href={SIGNUP_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">無料で始める</a>
			</div>
			<p class="hero-download"><a href="/crm/download/">資料をダウンロード</a></p>
			<p class="hero-download"><a href="/crm/updates/#current-editions">各エディションの対象業務と料金を確認する</a></p>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/contractor/screen-resources-2026-10c.webp"
				alt="空き枠カレンダーの画面。今週の稼働率62%・空き人日6.4・逼迫週0・余剰週11のカードと、メンバー4名×12週の割当表。"
				width="1432"
				height="840"
				decoding="async"
			/>
			<figcaption>空き枠カレンダー：誰がどれだけ埋まっていて、どこが空いているか</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">
				受託の案件は、受注したあとの<br />
				アサインで粗利が決まります。
			</p>
			<div class="pos-copy">
				<p>
					受託開発・制作版の中心は案件です。見積、受注、納品、検収、保守契約の更新までを、1つの案件の記録として管理できます。
				</p>
				<p>
					メンバーの稼働は、週単位の表で確認できます。PMは見積を出す前に、どのメンバーをいつからアサインできるかを確かめられます。前倒しで受けられる案件や、納期を相談すべき案件の判断にも使えます。
				</p>
				<p>
					保守契約は、納品後も続く売上です。案件に契約終了日を入れておくと、終了60日前に更新準備のタスクを作成します。
				</p>
				<a href="/revenue-architecture/" class="pos-link">この考え方について読む →</a>
			</div>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Problems</p>
			<h2 class="prob-title">商談中の案件と、メンバーの稼働予定がつながっていない。</h2>
		</div>
		<div class="prob-grid">
			{problems.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`項目 ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">The screens</p>
			<h2 class="sc-title">毎日開くのは、この4つの画面です。</h2>
		</div>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img
							src={`/images/crm/contractor/screen-${s.src}-2026-10c.webp`}
							alt={s.alt}
							width="1432"
							height="840"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== 案件エンジン ===================== -->
