---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CrmSubnav from '../../../../components/CrmSubnav.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// Mirrors /crm/reseller/. Only what the reseller edition actually ships
// (src/lib/editions/index.ts in the product).
const screens = [
	{ src: 'subscriptions', title: 'Contracts and recurring revenue', desc: 'Margin per plan, active and churned contracts, MRR, ARR, and LTV on one screen. No rebuilding the spreadsheet at month end.', alt: 'The subscriptions screen: MRR, ARR, active contracts, churn rate, and LTV cards above a contract list with plan, margin rate, customer, status, amount, and MRR.' },
	{ src: 'automations', title: 'Renewal and churn watch', desc: 'Early warning on renewal dates, falling health, churn signals, and upsell candidates. Turned on as a set.', alt: 'The automation library with the renewal and churn watch set switched on, out of 175 automations in total.' },
	{ src: 'deals', title: 'New and add-on in one place', desc: 'New deployments and extra seats or licenses in the same pipeline, with amounts and counts by stage.', alt: 'The deal kanban with new-deployment and seat-expansion deals across approach, hearing, proposal, and quote stages.' },
];

const problems = [
	{ title: 'Renewal dates surface too late', text: 'They live only in contracts and spreadsheets, so the renewal conversation starts a month out, with no time left to negotiate.' },
	{ title: 'Churn signals go unseen', text: 'Low usage, fewer questions, a new contact on their side. You notice once the cancellation notice arrives.' },
	{ title: 'No place to count recurring revenue', text: 'How much is stacked up now, and which products carry the thicker margin, gets recounted every month.' },
];

const engine = [
	{ label: 'Renewal date', text: 'Track contract renewal dates and send reminders' },
	{ label: '90 days out', text: 'Start the renewal approach 90 days before the date' },
	{ label: 'Risk', text: 'Flag customers unlikely to renew' },
	{ label: 'Renewal deal', text: 'Create the renewal deal when the time comes' },
	{ label: 'Churn signal', text: 'Detect signs of churn' },
];

const roles = [
	{ name: 'Owner', scope: 'Every customer, contract, billing, and permissions' },
	{ name: 'Admin', scope: 'Day-to-day operations and permissions' },
	{ name: 'Manager', scope: 'View and edit customers, deals, and contracts for their team' },
	{ name: 'Sales rep', scope: 'Only their own customers and deals' },
];
---

<BaseLayout
	title="Revenue CRM | CRM for SaaS resellers"
	description="CRM for SaaS resellers. Contracts and margin, MRR, ARR, and LTV, a renewal approach that starts 90 days out, and churn signal detection. Recurring revenue after the sale, in one place. 30-day free trial."
	lang="en"
	alternateUrl="/crm/reseller/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://consilegy.com/en/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/en/crm/"},
		{"@type": "ListItem", "position": 3, "name": "SaaS resellers", "item": "https://consilegy.com/en/crm/reseller/"}
	]
})} />

<CrmSubnav lang="en" />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM for SaaS resellers</p>
			<h1>CRM for<br />SaaS resellers.</h1>
			<p class="hero-lead">
				Contracts in a spreadsheet, renewal months in someone’s memory, margin in a separate sheet. This edition <strong>puts contracts, renewals, and recurring revenue in one place, and starts moving 90 days before each renewal</strong>.
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">See the demo</a>
				<a href={SIGNUP_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">Start free</a>
			</div>
			<ul class="hero-points" aria-label="What this edition does">
				<li>Contracts, renewals, and margin together</li>
				<li>Renewals tracked from 90 days out</li>
				<li>Starts set up for reselling</li>
			</ul>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/reseller/screen-subscriptions.webp"
				alt="The subscriptions screen: MRR, ARR, active contracts, churn rate, and LTV, with a contract list showing margin per plan."
				width="1432"
				height="840"
				decoding="async"
			/>
			<figcaption>Contracts: MRR, ARR, LTV, and margin per plan</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">
				The question is not “how much did we sell this month.”<br />It is “will it still be here next month.”
			</p>
			<div class="pos-copy">
					<p>
						So the center is the <strong>contract</strong>. A deal ends when it is won; a reseller’s revenue starts there. Whether the contract is live, when it renews, and what margin it carries sit on the same screen as the deal.
					</p>
					<p>
						New deployments and extra seats or licenses run in the same pipeline. When most revenue comes from existing customers, there is no reason to track them apart.
					</p>
					<p>
						When you carry several products, margin rates differ. Each contract holds its rate, so you can sort by <strong>what you keep</strong>, not by revenue.
					</p>
			</div>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">The problem</p>
			<h2 class="prob-title">Is what happens after the sale locked in contracts and spreadsheets?</h2>
		</div>
		<div class="prob-grid">
			{problems.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`Item ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">The screens</p>
			<h2 class="sc-title">Everything you open daily, organized around the contract.</h2>
		</div>
		<p class="sc-note">Screenshots show the Japanese interface. The product switches to English, Japanese, or Traditional Chinese in one click.</p>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img
							src={`/images/crm/reseller/screen-${s.src}.webp`}
							alt={s.alt}
							width="1432"
							height="840"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== ENGINE ===================== -->
<section class="support">
	<div class="container support-inner">
		<div>
			<p class="section-eyebrow">Renewal engine</p>
			<h2>Take renewal prep out of people’s memory.</h2>
				<p class="support-lead">
					When you create this edition, the renewal automations are already on. Renewal date tracking, the 90-day approach, renewal deals, and churn signal detection run as a nightly job.
				</p>
				<p class="support-lead">
					Automations create tasks, notifications, and drafts. Nothing is sent to a customer on its own; the owner reviews it first.
				</p>
		</div>
		<div class="support-list">
			<h3>On by default</h3>
			<ul>
				{engine.map((r) => (
					<li><span>{r.label}</span><strong>{r.text}</strong></li>
				))}
			</ul>
		</div>
	</div>
</section>

<!-- ===================== AI ===================== -->
<section class="ai">
	<div class="container ai-inner">
		<div>
			<p class="section-eyebrow">AI</p>
			<h2>Ask in plain language,<br />get the answer back.</h2>
				<p class="ai-lead">
					You do not have to build a report to find something out. Ask it the way you would say it, and it searches contract and deal data.
				</p>
				<p class="ai-lead">
					Contracts renewing soon, products with thin margins, customers whose activity has dropped. All checked on the spot.
				</p>
				<p class="ai-lead">
					What the AI drafts stays a draft. Nothing reaches a customer until the owner has checked and confirmed it.
				</p>
		</div>
		<ul class="ai-examples">
				<li>Which contracts renew this month?</li>
				<li>Break down our MRR</li>
				<li>Which customers are at churn risk?</li>
				<li>Which contracts have low margin?</li>
		</ul>
	</div>
</section>

<!-- ===================== ROLES ===================== -->
<section class="roles">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Permissions</p>
			<h2 class="ro-title">Keep people out of customers that are not theirs.</h2>
		</div>
		<p class="ro-lead">
			For contacts, companies, and deals, choose what each role can see: everything, the team, or only their own. Export rights are set separately, so viewing and taking the customer list out can be separated. An example setup:
		</p>
		<dl class="ro-list">
			{roles.map((r) => (
				<div class="ro-row">
					<dt>{r.name}</dt>
					<dd>{r.scope}</dd>
				</div>
			))}
		</dl>
		<p class="ro-note">Actions are logged, so you can trace who changed what, and when.</p>
	</div>
</section>

<!-- ===================== FINAL CTA ===================== -->
<section class="final-cta">
	<div class="container cta-inner">
		<div>
			<p class="cta-eyebrow">30 days free</p>
			<h2>Try the product first.</h2>
			<p class="cta-lead">
				An email address opens a demo workspace with sample data. No password to set.
				This edition starts with contracts, renewals, and recurring revenue already set up.
				Every plan comes with a 30-day free trial, no card required.
			</p>
			<div class="cta-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">See the demo</a>
				<a href={SIGNUP_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">Start free</a>
			</div>
		</div>
		<div class="cta-card">
			<h4>What we show you</h4>
			<ul class="cta-list">
				<li>The contract list and how MRR, ARR, and LTV read</li>
				<li>Margin per plan</li>
				<li>Setting up renewal and churn watch</li>
				<li>New and add-on deals in one pipeline</li>
				<li>Rep permissions and the audit log</li>
			</ul>
		</div>
	</div>
</section>

</BaseLayout>

<style>
	/* html[lang="en"] の --container は 72ch（記事の読み物幅）。LPなのでページ内だけ 1120px に戻す。 */
	.container {
		max-width: 1120px;
	}
	.section-eyebrow,
	.eyebrow,
	.cta-eyebrow {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	/* uppercase はギリシャ文字も変えるので β が B になる。
	   ラテン文字だけ大文字にしたいので、日本語まじりの語は除外する。 */
	.section-eyebrow .no-upper,
	.eyebrow .no-upper,
	.cta-eyebrow .no-upper {
		text-transform: none;
	}

	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		margin: 0;
		color: var(--color-text);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.4;
		text-wrap: balance;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0.8rem 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.25;
		text-decoration: none;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.btn--primary {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
	}

	.btn--primary:hover {
		background: var(--color-primary-dark);
		border-color: var(--color-primary-dark);
		color: #fff;
	}

	.btn--secondary {
		background: transparent;
		color: var(--color-text);
	}

	.btn--secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	.hero-actions,
	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-md);
	}

	.hero {
		padding: var(--space-lg) 0 var(--space-md);
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.78fr);
		gap: var(--space-xl);
		align-items: start;
	}

	.hero-copy {
		max-width: 720px;
	}

	.eyebrow {
		display: block;
		margin-bottom: var(--space-md);
		padding-top: 0.875rem;
		border-top: 1px solid var(--color-border);
	}

	.hero h1 {
		max-width: 13em;
		margin: 0;
		color: var(--color-text);
		font-size: 3.125rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.hero-lead {
		max-width: 43em;
		margin: var(--space-md) 0 0;
		color: var(--color-text);
		font-size: 1.0625rem;
		line-height: 2;
	}

	.hero-lead strong {
		font-weight: 700;
	}

	.hero-points {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
		margin: var(--space-md) 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-points li {
		min-width: 0;
		padding: 0.85rem 1rem;
		color: var(--color-text-muted);
		font-size: 0.8125rem;
		line-height: 1.6;
	}

	.hero-points li + li {
		border-left: 1px solid var(--color-border);
	}

	.pos-link {
		color: var(--color-primary);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
	}

	.hero-media {
		margin: 0;
		min-width: 0;
	}

	.hero-media img,
	.prob-shot img {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid var(--color-border);
		border-radius: 0;
		background: #fff;
		box-shadow: none;
	}

	.hero-media figcaption,
	.prob-shot figcaption {
		margin-top: 0.65rem;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.positioning,
	.problem,
	.screens,
	.support,
	.ai,
	.roles,
	.final-cta {
		padding: var(--space-2xl) 0;
		background: var(--color-bg);
	}

	.screens,
	.roles {
		background: var(--color-bg-subtle);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.prob-shot {
		max-width: 900px;
		margin: 0;
		background: transparent;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}

	.positioning {
		border-bottom: 1px solid var(--color-border);
	}

	.pos-body {
		display: grid;
		grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
		gap: var(--space-xl);
		align-items: start;
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	.pos-lead {
		margin: 0;
		color: var(--color-text);
		font-size: 1.375rem;
		font-weight: 500;
		line-height: 1.7;
		text-wrap: balance;
	}

	.pos-copy p {
		margin: 0 0 1rem;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.9;
	}

	.pos-body strong {
		color: var(--color-text);
		font-weight: 700;
	}

	.pos-link {
		display: inline-flex;
		margin-top: 0.25rem;
		font-size: 0.9375rem;
	}

	.section-head {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		gap: var(--space-lg);
		align-items: start;
		margin-bottom: var(--space-lg);
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	.prob-grid,
	.sc-grid {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--color-border);
	}

	.prob-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.prob-item,
	.sc-card {
		min-width: 0;
		padding: 1.35rem 1.5rem 1.35rem 0;
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--color-border);
		border-radius: 0;
	}

	.prob-item:nth-child(2),
	.prob-item:nth-child(3) {
		padding-left: var(--space-md);
		border-left: 1px solid var(--color-border);
	}

	.issue-label {
		display: flex;
		align-items: flex-end;
		gap: 0.85rem;
		margin-bottom: 0.9rem;
		color: var(--color-primary);
	}

	.issue-label::after {
		content: "";
		flex: 1;
		height: 1px;
		margin-bottom: 0.34rem;
		background: var(--color-border);
	}

	.issue-label__number {
		color: rgba(30, 64, 175, 0.24);
		font-size: 2.45rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		line-height: 0.82;
		letter-spacing: 0;
	}

	.prob-item h3,
	.sc-card h3 {
		margin: 0;
		color: var(--color-text);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.55;
	}

	.prob-item p,
	.sc-card p {
		margin: 0.6rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.85;
	}

	.prob-shot {
		margin-top: var(--space-xl);
	}

	.prob-shot strong {
		color: var(--color-text);
		font-weight: 700;
	}

	.screens {
		scroll-margin-top: 120px;
	}

	.sc-grid {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.sc-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.9rem;
		align-content: start;
		padding-right: var(--space-md);
	}

	.sc-shot {
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: #fff;
		box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
	}

	.sc-shot img {
		display: block;
		width: 100%;
		height: auto;
	}

	.sc-card:nth-child(4n + 2),
	.sc-card:nth-child(4n + 3),
	.sc-card:nth-child(4n + 4) {
		padding-left: var(--space-md);
		border-left: 1px solid var(--color-border);
	}

	.support {
		border-bottom: 1px solid var(--color-border);
	}

	.support-inner,
	.ai-inner,
	.cta-inner {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: var(--space-xl);
		align-items: start;
	}

	.support-inner > div:first-child,
	.ai-inner > div:first-child,
	.cta-inner > div:first-child {
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	.support .section-eyebrow,
	.ai .section-eyebrow,
	.cta-eyebrow {
		margin-bottom: var(--space-sm);
	}

	.support-lead,
	.ai-lead,
	.ro-lead,
	.cta-lead {
		margin: 1rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.85;
	}

	.support-list {
		border-top: 1px solid var(--color-border);
	}

	.support-list h3,
	.cta-card h4 {
		margin: 0;
		padding: 0.95rem 0;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-primary);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.5;
	}

	.support-list ul,
	.cta-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.support-list li {
		display: grid;
		grid-template-columns: 6rem minmax(0, 1fr);
		gap: var(--space-md);
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--color-border);
	}

	.support-list span {
		color: var(--color-text-muted);
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1.7;
	}

	.support-list strong {
		color: var(--color-text);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.7;
	}

	.ai-examples {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
	}

	.ai-examples li {
		padding: 0.9rem 0;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-text);
		font-size: 0.9375rem;
		line-height: 1.7;
	}

	.ai-examples li::before {
		content: '\201C';
