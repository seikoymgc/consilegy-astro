		margin: 0;
	}

	.bowtie-figure img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--color-border, #e2e8f0);
		border-radius: var(--radius, 8px);
		background: #fff;
	}

	.bowtie-figure figcaption {
		margin-top: 0.75rem;
		font-size: 0.78rem;
		line-height: 1.8;
		color: var(--color-text-muted);
	}

	/* ── Metrics (CR / Δt) ─────────────────────────────────── */
