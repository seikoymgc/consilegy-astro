---
// 「3部門の流れ＋共有する顧客データの土台」の正典図。
// サービス・レベニューアーキテクチャ関連のページで共通に使う（ページごとに描き直さない）。
// steps: 上に Step 01〜03 の帯を出す（サービスページ用）。boundaries: 'two'（①②）か 'six'（6つの境目）。
interface Props {
	id: string;
	caption: string;
	steps?: boolean;
	boundaries?: 'two' | 'six';
	label?: string;
	lang?: 'ja' | 'en';
}
const { id, caption, steps = false, boundaries = 'two', label = 'Revenue flow', lang = 'ja' } = Astro.props;
const T = lang === 'en' ? {
	aria: 'The flow from marketing to sales to customer success, on one shared customer data foundation',
	s1: 'Find where it stalls', s2: 'Redesign the flow and data', s3: 'Run it with the team',
	mk: 'MARKETING', mkT: 'Leads, to sales.', sl: 'SALES', slT: 'Deals, to closed.', cs: 'CUSTOMER SUCCESS', csT: 'Customers, to renewal.',
	base: 'One shared customer data and operating rules (CRM, SFA, marketing automation)',
	back: 'Sales and customer outcomes flow back to marketing',
	legend: '1 Marketing → Sales handoff / 2 Sales key-person dependence / 3 Deal-stage misalignment / 4 Data silos / 5 System non-adoption / 6 Post-sale retention & expansion',
} : {
	aria: 'マーケティング、営業、カスタマーサクセスの流れと、全部門で共有する顧客データの土台',
	s1: '境目を見つける', s2: '流れとデータを作り直す', s3: '現場で回るまで',
	mk: 'マーケティング', mkT: '見込み客を、営業へ。', sl: '営業', slT: '商談を、受注へ。', cs: 'カスタマーサクセス', csT: '受注を、次の取引へ。',
	base: '全部門で共有する顧客データと運用（顧客管理・営業支援・マーケティング自動化）',
	back: '営業・顧客対応の結果を、マーケティングへ返す',
	legend: '1 マーケ→営業の受け渡し ／ 2 営業の属人化 ／ 3 商談ステージのズレ ／ 4 データの分断 ／ 5 システムの非定着 ／ 6 受注後の継続・拡大',
};
const six = boundaries === 'six';
// 英語の凡例は1行に収まらないので2行に分ける（日本語は1行）
const legendLines = six ? (lang === 'en' ? [T.legend.split(' / 4 ')[0], '4 ' + T.legend.split(' / 4 ')[1]] : [T.legend]) : [];
const H = (steps ? 400 : 340) + (legendLines.length > 1 ? 24 : 0);
const top = steps ? 110 : 50;

// ── スマホ用（縦長・幅360）の座標 ──
const SPB = lang === 'en'
	? ['One shared customer data and', 'operating rules (CRM, SFA,', 'marketing automation)']
	: ['全部門で共有する顧客データと運用', '（顧客管理・営業支援・', 'マーケティング自動化）'];
const SPBACK = lang === 'en' ? ['Sales and customer outcomes', 'flow back to marketing'] : ['営業・顧客対応の結果を、', 'マーケティングへ返す'];
const SPLEG = six ? T.legend.split(lang === 'en' ? ' / ' : ' ／ ') : [];
const SPS = [T.s1, T.s2, T.s3];
let sy = 36;
const spStepsY = sy;
if (steps) sy += 100 + 20;
const bh = 76, gap = 44;
const mkY = sy, slY = mkY + bh + gap, csY = slY + bh + gap;
const baseY = csY + bh + 32;
const baseH = SPB.length * 24 + 24;
const backY = baseY + baseH + 32;
const legY = backY + SPBACK.length * 22 + 20;
const HSP = (six ? legY + SPLEG.length * 26 : backY + SPBACK.length * 22) + 8;
---
<figure class="rf-fig" aria-labelledby={`${id}-caption`}>
	<svg class="fig-pc" viewBox={`0 0 1120 ${H}`} role="img" aria-label={T.aria} font-family="inherit">
		<defs>
			<marker id={`${id}-arr`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker>
			<marker id={`${id}-arr2`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#94A3B8"/></marker>
		</defs>
		<text x="40" y="24" font-size="14" letter-spacing="1.5" fill="#64748b">{label.toUpperCase()}</text>
		{steps && (
			<g font-size="16">
				<rect x="40" y="40" width="1040" height="44" rx="6" fill="#F1F5F9"/>
				<text x="60" y="68" fill="#2563EB" font-weight="700">Step 01</text><text x="140" y="68" fill="#334155">{T.s1}</text>
				<text x="430" y="68" fill="#2563EB" font-weight="700">Step 02</text><text x="510" y="68" fill="#334155">{T.s2}</text>
				<text x="820" y="68" fill="#2563EB" font-weight="700">Step 03</text><text x="900" y="68" fill="#334155">{T.s3}</text>
			</g>
		)}
		<g>
			<rect x="40" y={top} width="300" height="104" rx="6" fill="#fff" stroke="#E2E8F0"/>
			<text x="60" y={top + 32} font-size="14" fill="#64748b" letter-spacing="1">{T.mk}</text>
			<text x="60" y={top + 70} font-size="20" font-weight="600" fill="#0F172A">{T.mkT}</text>
			<rect x="410" y={top} width="300" height="104" rx="6" fill="#fff" stroke="#E2E8F0"/>
			<text x="430" y={top + 32} font-size="14" fill="#64748b" letter-spacing="1">{T.sl}</text>
			<text x="430" y={top + 70} font-size="20" font-weight="600" fill="#0F172A">{T.slT}</text>
			<rect x="780" y={top} width="300" height="104" rx="6" fill="#fff" stroke="#E2E8F0"/>
			<text x="800" y={top + 32} font-size="14" fill="#64748b" letter-spacing="1">{T.cs}</text>
			<text x="800" y={top + 70} font-size="20" font-weight="600" fill="#0F172A">{T.csT}</text>
			<line x1="340" y1={top + 52} x2="406" y2={top + 52} stroke="#0F172A" stroke-width="2" marker-end={`url(#${id}-arr)`}/>
			<line x1="710" y1={top + 52} x2="776" y2={top + 52} stroke="#0F172A" stroke-width="2" marker-end={`url(#${id}-arr)`}/>
			<circle cx="373" cy={top + 52} r="15" fill="#2563EB"/><text x="373" y={top + 57} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">1</text>
			{six ? (
				<>
					<circle cx="743" cy={top + 52} r="15" fill="#2563EB"/><text x="743" y={top + 57} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">6</text>
					<circle cx="560" cy={top + 119} r="15" fill="#2563EB"/><text x="560" y={top + 124} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">2</text>
					<circle cx="596" cy={top + 119} r="15" fill="#2563EB"/><text x="596" y={top + 124} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">3</text>
				</>
			) : (
				<>
					<circle cx="743" cy={top + 52} r="15" fill="#2563EB"/><text x="743" y={top + 57} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">2</text>
				</>
			)}
		</g>
		<rect x="40" y={top + 134} width="1040" height="56" rx="6" fill="#0F172A"/>
		<text x="560" y={top + 169} font-size="16" font-weight="600" fill="#fff" text-anchor="middle">{T.base}</text>
		{six && (
			<>
				<circle cx="960" cy={top + 162} r="15" fill="#2563EB"/><text x="960" y={top + 167} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">4</text>
				<circle cx="994" cy={top + 162} r="15" fill="#2563EB"/><text x="994" y={top + 167} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">5</text>
			</>
		)}
		<path d={`M1080 ${top + 104} L1080 ${top + 118} Q1080 ${top + 212} 990 ${top + 212} L130 ${top + 212} Q40 ${top + 212} 40 ${top + 118} L40 ${top + 104}`} fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-dasharray="4 4" marker-end={`url(#${id}-arr2)`}/>
		<text x="560" y={top + 236} font-size="14" fill="#64748b" text-anchor="middle">{T.back}</text>
		{six && (
			legendLines.map((l, i) => <text x="40" y={top + 268 + i * 22} font-size="14" fill="#64748b">{l}</text>)
		)}
	</svg>
	<svg class="fig-sp" viewBox={`0 0 360 ${HSP}`} role="img" aria-label={T.aria} font-family="inherit">
		<defs>
			<marker id={`${id}-arr-sp`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker>
			<marker id={`${id}-arr2-sp`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#94A3B8"/></marker>
		</defs>
		<text x="16" y="20" font-size="14" letter-spacing="1.5" fill="#64748b">{label.toUpperCase()}</text>
		{steps && (
			<g font-size="16">
				<rect x="16" y={spStepsY} width="328" height="100" rx="6" fill="#F1F5F9"/>
				{SPS.map((t, i) => (
					<>
						<text x="32" y={spStepsY + 30 + i * 28} fill="#2563EB" font-weight="700">{`Step 0${i + 1}`}</text>
						<text x="112" y={spStepsY + 30 + i * 28} fill="#334155">{t}</text>
					</>
				))}
			</g>
		)}
		{[[mkY, T.mk, T.mkT], [slY, T.sl, T.slT], [csY, T.cs, T.csT]].map(([y, l, t]) => (
			<>
				<rect x="16" y={y} width="328" height={bh} rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y={Number(y) + 28} font-size="14" fill="#64748b" letter-spacing="1">{l}</text>
				<text x="32" y={Number(y) + 58} font-size="18" font-weight="600" fill="#0F172A">{t}</text>
			</>
		))}
		<line x1="180" y1={mkY + bh + 4} x2="180" y2={slY - 4} stroke="#0F172A" stroke-width="2" marker-end={`url(#${id}-arr-sp)`}/>
		<line x1="180" y1={slY + bh + 4} x2="180" y2={csY - 4} stroke="#0F172A" stroke-width="2" marker-end={`url(#${id}-arr-sp)`}/>
		<circle cx="212" cy={mkY + bh + gap / 2} r="13" fill="#2563EB"/><text x="212" y={mkY + bh + gap / 2 + 5} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">1</text>
		<circle cx="212" cy={slY + bh + gap / 2} r="13" fill="#2563EB"/><text x="212" y={slY + bh + gap / 2 + 5} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">{six ? '6' : '2'}</text>
		{six && (
			<>
				<circle cx="296" cy={slY + 24} r="13" fill="#2563EB"/><text x="296" y={slY + 29} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">2</text>
				<circle cx="326" cy={slY + 24} r="13" fill="#2563EB"/><text x="326" y={slY + 29} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">3</text>
			</>
		)}
		<rect x="16" y={baseY} width="328" height={baseH} rx="6" fill="#0F172A"/>
		{SPB.map((l, i) => <text x="32" y={baseY + 34 + i * 24} font-size="16" font-weight="600" fill="#fff">{l}</text>)}
		{six && (
			<>
				<circle cx="294" cy={baseY} r="13" fill="#2563EB" stroke="#fff" stroke-width="2"/><text x="294" y={baseY + 5} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">4</text>
				<circle cx="326" cy={baseY} r="13" fill="#2563EB" stroke="#fff" stroke-width="2"/><text x="326" y={baseY + 5} font-size="14" font-weight="700" fill="#fff" text-anchor="middle">5</text>
			</>
		)}
		<path d={`M344 ${csY + bh / 2} L354 ${csY + bh / 2} L354 ${mkY + bh / 2} L348 ${mkY + bh / 2}`} fill="none" stroke="#94A3B8" stroke-width="1.5" stroke-dasharray="4 4" marker-end={`url(#${id}-arr2-sp)`}/>
		{SPBACK.map((l, i) => <text x="16" y={backY + i * 22} font-size="16" fill="#64748b">{i === 0 ? '↺ ' + l : l}</text>)}
		{six && SPLEG.map((l, i) => <text x="16" y={legY + i * 26} font-size="16" fill="#475569">{l}</text>)}
	</svg>
	<figcaption id={`${id}-caption`}>{caption}</figcaption>
</figure>
