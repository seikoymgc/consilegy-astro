---
import BaseLayout from '../../layouts/BaseLayout.astro';

const FORM_ID = 'd7fc0346-08a1-41bd-9835-984a426da068';
const SUBMIT_URL = `https://crm.consilegy.com/api/forms/${FORM_ID}/submit`;
const PDF_URL = '/downloads/consilegy-company-profile-2026-08.pdf';

const chapters = [
	{ num: '01', title: '課題と解決', text: '売上が読めない状態の正体、収益診断で分かること、整えたあとに実現できること。' },
	{ num: '02', title: 'Consilegyの支援', text: '他社との違い、強み、サービスの内容、Revenue CRM、支援体制と進め方。' },
	{ num: '03', title: '導入事例と成果', text: '5社の導入事例、成果物のイメージ、費用対効果の考え方。' },
	{ num: '04', title: '料金とご契約', text: 'プロジェクト開始までの流れ、料金、よくあるご質問。' },
	{ num: '05', title: '会社情報', text: '代表者紹介、会社概要、お問い合わせ先。' },
];

const previews = [
	{ page: 5, label: '売上が読めない状態の正体' },
	{ page: 8, label: '他社との違い' },
	{ page: 13, label: 'サービスの全体像' },
	{ page: 18, label: '導入事例' },
];

const faqItems = [
	{
		q: '資料は無料ですか？',
		a: 'はい、無料でご覧いただけます。フォームにお名前・会社名・メールアドレスをご入力いただくと、その場で資料が開き、同じリンクをメールでもお送りします。',
	},
	{
		q: '営業連絡は来ますか？',
		a: '資料のリンクをお送りするメール以外に、自動で営業連絡をお送りすることはありません。ご相談をご希望の場合は、30分の無料相談やお問い合わせフォームからご連絡ください。',
	},
	{
		q: '小規模企業でも参考になりますか？',
		a: 'はい。「CRMを導入したが定着しない」「営業とマーケの連携が取れない」「KPIが部門ごとに異なる」といった課題は、20名〜300名規模の企業でも頻繁に起きます。資料では、規模ごとの進め方もご紹介しています。',
	},
	{
		q: '特定のツールを前提にしていますか？',
		a: 'いいえ。Salesforce・HubSpot・Kintone・Marketoなど、主要なCRM / SFA / MAを対象にしています。Consilegyはベンダーフリーの立場で、ツールを選ぶ前の収益構造の設計からご支援します。',
	},
	{
		q: 'Revenue Architectureとは何ですか？',
		a: '営業・マーケティング・カスタマーサクセスなど、収益に関わる部門のプロセス・データ・KPI・ツール・会議体をまとめて設計する考え方です。CRMやSFAの設定にとどまらず、収益構造全体を俯瞰して設計します。',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map(({ q, a }) => ({
		'@type': 'Question',
		name: q,
		acceptedAnswer: { '@type': 'Answer', text: a },
	})),
};
---

<BaseLayout
	title="会社説明資料｜資料ダウンロード | Consilegy"
	description="マーケティング・営業・カスタマーサクセスの分断をなくし、売上が読める状態をつくる。Consilegyの支援内容、導入事例、料金、会社情報をまとめた会社説明資料を無料でご覧いただけます。"
	lang="ja"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	</Fragment>

<!-- ===== HERO ===== -->
<section class="hero">
	<div class="container">
		<div class="hero-inner">
			<div class="hero-text">
				<p class="eyebrow">Company Profile</p>
				<h1>会社説明資料</h1>
				<p class="hero-sub">
					マーケティング・営業・カスタマーサクセスの分断をなくし、売上が読める状態をつくる。設計から実装、定着まで。
				</p>
				<div class="hero-tags">
					<span class="hero-tag">課題と解決</span>
					<span class="hero-tag">支援内容</span>
					<span class="hero-tag">導入事例</span>
					<span class="hero-tag">料金</span>
					<span class="hero-tag">会社情報</span>
				</div>
				<a href="#download-form" class="btn btn--primary btn--lg">資料を見る →</a>
			</div>
			<div class="hero-mock">
				<img class="deck-cover" src="/images/download/company-profile-2026-08-p1.jpg" alt="Consilegy 会社説明資料の表紙" width="1334" height="750" decoding="async" />
			</div>
		</div>
	</div>
</section>

<!-- ===== 資料内容 ===== -->
<section class="contents">
	<div class="container">
		<div class="section-header">
			<p class="eyebrow">Contents</p>
			<h2>資料内容</h2>
		</div>
		<div class="contents-grid">
			{chapters.map((c) => (
				<div class="content-card">
					<div class="content-card__num">{c.num}</div>
					<h3>{c.title}</h3>
					<p>{c.text}</p>
				</div>
			))}
		</div>
	</div>
</section>

<!-- ===== おすすめ企業 ===== -->
<section class="fit">
	<div class="container">
		<div class="section-header">
			<p class="eyebrow">Good Fit</p>
			<h2>こんな企業向けの資料です</h2>
		</div>
		<div class="fit-grid">
			<div class="fit-item"><span class="fit-check">✓</span>CRMを導入したが定着しない</div>
			<div class="fit-item"><span class="fit-check">✓</span>営業とマーケが分断している</div>
			<div class="fit-item"><span class="fit-check">✓</span>KPIが部門ごとに異なる</div>
			<div class="fit-item"><span class="fit-check">✓</span>売上の見込みが読めない</div>
			<div class="fit-item"><span class="fit-check">✓</span>支援会社を比較・検討している</div>
			<div class="fit-item"><span class="fit-check">✓</span>社内の稟議に使う資料が欲しい</div>
		</div>
	</div>
</section>

<!-- ===== 資料イメージ ===== -->
<section class="preview">
	<div class="container">
		<div class="section-header">
			<p class="eyebrow">Preview</p>
			<h2>資料イメージ</h2>
		</div>
		<div class="deck-previews">
			{previews.map((pv) => (
				<figure>
					<img src={`/images/download/company-profile-2026-08-p${pv.page}.jpg`} alt={`会社説明資料のページ：${pv.label}`} width="1334" height="750" loading="lazy" decoding="async" />
					<figcaption>{pv.label}</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>

<!-- ===== FORM ===== -->
<section class="form-section" id="download-form">
	<div class="container">
		<div class="form-layout">
			<div class="form-text">
				<p class="eyebrow">Download</p>
				<h2>資料を見る</h2>
				<p class="form-lead">
					以下のフォームにご入力いただくと、その場で資料が開きます。同じリンクをメールでもお送りします。
				</p>
				<ul class="form-note-list">
					<li>無料でご覧いただけます</li>
					<li>自動的な営業連絡はありません</li>
					<li>PDF形式です</li>
				</ul>
			</div>
			<div class="form-embed">
				<div id="dl-form-wrap">
					<form id="dl-form" class="dlf" novalidate>
						<label class="dlf-field"><span>会社名<em>必須</em></span><input name="company_name" type="text" autocomplete="organization" required /></label>
						<div class="dlf-row">
							<label class="dlf-field"><span>部署</span><input name="department" type="text" /></label>
							<label class="dlf-field"><span>役職・職種</span><input name="job_title" type="text" autocomplete="organization-title" /></label>
						</div>
						<div class="dlf-row">
							<label class="dlf-field"><span>姓<em>必須</em></span><input name="last_name" type="text" autocomplete="family-name" required /></label>
							<label class="dlf-field"><span>名<em>必須</em></span><input name="first_name" type="text" autocomplete="given-name" required /></label>
						</div>
						<label class="dlf-field"><span>メールアドレス<em>必須</em></span><input name="email" type="email" autocomplete="email" required /></label>
						<div class="dlf-row">
							<label class="dlf-field"><span>電話番号</span><input name="phone" type="tel" autocomplete="tel" /></label>
							<label class="dlf-field"><span>従業員数</span>
								<select name="employee_range">
									<option value="">選択してください</option>
									<option>1-10</option><option>11-50</option><option>51-100</option><option>101-300</option><option>301-1000</option><option>1001以上</option>
								</select>
							</label>
						</div>
						<label class="dlf-field"><span>メッセージ（任意）</span><textarea name="message" rows="3"></textarea></label>
						<label class="dlf-hp" aria-hidden="true"><span>このフィールドは空のままにしてください</span><input name="hp" type="text" tabindex="-1" autocomplete="off" /></label>
						<p class="dlf-error" id="dl-error" role="alert" hidden></p>
						<p class="dlf-privacy">ご入力いただいた情報は、<a href="/privacy-policy/">プライバシーポリシー</a>に沿って取り扱います。</p>
						<button type="submit" class="btn btn--primary btn--lg">資料を見る</button>
					</form>
				</div>
				<div id="dl-done" class="dlf-done" hidden>
					<h3>ありがとうございます</h3>
					<p>新しいタブで資料が開きます。開かない場合は、下のボタンから開いてください。</p>
					<a class="btn btn--primary" href={PDF_URL} target="_blank" rel="noopener">資料を開く</a>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- ===== 診断導線 ===== -->
<section class="next-section">
	<div class="container">
		<div class="next-box">
			<div class="next-text">
				<p class="eyebrow">Next Step</p>
				<h2>具体的な課題整理をご希望の場合</h2>
				<p>
					CRM / RevOps / 営業マーケ連携 / KPI設計に課題がある場合は、専用の診断ページから現状整理をご相談いただけます。
				</p>
			</div>
			<a href="/diagnostic/" class="btn btn--primary">収益を自己診断</a>
		</div>
	</div>
</section>

<!-- ===== FAQ ===== -->
<section class="faq-section">
	<div class="container">
		<div class="section-header">
			<p class="eyebrow">FAQ</p>
			<h2>よくある質問</h2>
		</div>
		<div class="faq-list">
			{faqItems.map(({ q, a }) => (
				<details class="faq-item">
					<summary class="faq-q">{q}</summary>
					<div class="faq-a"><p>{a}</p></div>
				</details>
			))}
		</div>
	</div>
</section>

<!-- ===== FINAL CTA ===== -->
<section class="cta-final">
	<div class="container">
		<p class="cta-final__eyebrow">Document Download</p>
		<h2>
			Consilegyの支援内容を、<br />
			まず資料で確認しませんか。
		</h2>
		<p class="cta-final__body">
			課題の見立て、支援の進め方、導入事例、料金を、<br />
			1冊の資料にまとめています。
		</p>
		<div class="cta-final__btns">
			<a href="#download-form" class="btn btn--white btn--lg">資料を見る →</a>
			<a href="/diagnostic/" class="btn btn--outline-white btn--lg">収益を自己診断</a>
		</div>
	</div>
</section>

</BaseLayout>

<script is:inline define:vars={{ SUBMIT_URL, PDF_URL }}>
	(function () {
		var form = document.getElementById('dl-form');
		var errorBox = document.getElementById('dl-error');
		if (!form) return;
		form.addEventListener('submit', function (e) {
			e.preventDefault();
			var fd = new FormData(form);
			var values = {};
			['company_name', 'department', 'job_title', 'last_name', 'first_name', 'email', 'phone', 'employee_range', 'message'].forEach(function (k) {
				values[k] = String(fd.get(k) || '').trim();
			});
			var emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email);
			if (!values.company_name || !values.last_name || !values.first_name || !emailOk) {
				errorBox.textContent = !emailOk && values.email ? 'メールアドレスの形式をご確認ください。' : '必須の項目をすべて入力してください。';
				errorBox.hidden = false;
				return;
			}
			errorBox.hidden = true;
			var params = new URLSearchParams(location.search);
			var utm = {};
			['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) {
				if (params.get(k)) utm[k] = params.get(k);
			});
			if (!utm.utm_source) utm.utm_source = 'consilegy.com/download';
			var button = form.querySelector('button[type="submit"]');
			button.disabled = true;
			button.textContent = '送信しています…';
			// 送信ボタンを押した操作の中で開かないと、ポップアップとしてブロックされる。
			window.open(PDF_URL, '_blank', 'noopener');
			var done = function () {
				document.getElementById('dl-form-wrap').hidden = true;
				document.getElementById('dl-done').hidden = false;
			};
			fetch(SUBMIT_URL, {
				method: 'POST',
				mode: 'no-cors',
				headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
				body: JSON.stringify({ values: values, utm: utm, referrer: document.referrer || location.href, hp: String(fd.get('hp') || '') }),
				keepalive: true,
			}).then(done, done);
			setTimeout(done, 1500);
		});
	})();
</script>

<style>
	.deck-cover { width: 100%; height: auto; display: block; border-radius: 8px; box-shadow: 0 20px 40px rgba(15, 23, 42, 0.18); }
	.deck-previews { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem; }
	.deck-previews figure { margin: 0; }
	.deck-previews img { width: 100%; height: auto; display: block; border: 1px solid #e2e8f0; border-radius: 6px; background: #fff; }
	.deck-previews figcaption { margin-top: 0.5rem; font-size: 0.85rem; color: #475569; }
	.dlf { display: grid; gap: 0.85rem; background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 1.5rem; }
	.dlf-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
	.dlf-field { display: grid; gap: 0.3rem; font-size: 0.85rem; color: #334155; }
	.dlf-field em { font-style: normal; font-size: 0.7rem; color: #fff; background: #1e40af; border-radius: 0.25rem; padding: 0.05rem 0.35rem; margin-left: 0.5rem; }
	.dlf-field input, .dlf-field select, .dlf-field textarea { width: 100%; padding: 0.6rem 0.7rem; border: 1px solid #cbd5e1; border-radius: 0.4rem; font-size: 1rem; background: #fff; font-family: inherit; }
	.dlf-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
	.dlf-error { color: #b42318; font-size: 0.85rem; }
	.dlf-error[hidden], #dl-done[hidden], #dl-form-wrap[hidden] { display: none; }
	.dlf-privacy { font-size: 0.78rem; color: #64748b; }
	.dlf-privacy a { color: inherit; }
	.dlf .btn { width: 100%; justify-content: center; }
	.dlf-done { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 1.5rem; display: grid; gap: 0.75rem; }
	.dlf-done h3 { font-size: 1.1rem; }
	@media (max-width: 640px) {
		.deck-previews { grid-template-columns: 1fr; }
		.dlf-row { grid-template-columns: 1fr; }
	}
</style>

<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
	--color-primary: #1e40af;
	--color-primary-dark: #1d4ed8;
	--color-navy: #0f172a;
	--color-slate: #1e293b;
	--color-charcoal: #334155;
	--color-muted: #44403C;
	--color-border: #e2e8f0;
	--color-border-mid: #cbd5e1;
	--color-bg-soft: #f8fafc;
	--font-serif: var(--font-sans);
	--font-sans: 'Inter', 'Noto Sans JP', system-ui, sans-serif;
	--container: 1100px;
	--radius: 8px;
}

body { font-family: var(--font-sans); color: var(--color-navy); line-height: 1.7; }
.container { max-width: var(--container); margin: 0 auto; padding: 0 2rem; }

.eyebrow { display: block; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-primary); margin-bottom: 0.625rem; }
.section-header { text-align: center; margin-bottom: 3rem; }
.section-header h2 { font-family: var(--font-serif); font-size: clamp(1.5rem, 3vw, 2rem); color: var(--color-navy); }
.section-desc { margin-top: 0.75rem; color: var(--color-text-muted); font-size: 0.9375rem; }

.btn { display: inline-flex; align-items: center; justify-content: center; font-weight: 600; border-radius: 5px; text-decoration: none; transition: all 0.18s; font-size: 0.9375rem; padding: 0.75rem 1.5rem; }
.btn--lg { padding: 0.9rem 2rem; font-size: 1rem; }
.btn--primary { background: var(--color-primary); color: #fff; border: 2px solid transparent; }
.btn--primary:hover { background: var(--color-primary-dark); }
.btn--white { background: #fff; color: var(--color-primary); border: 2px solid transparent; }
.btn--white:hover { background: #f1f5f9; }
.btn--outline-white { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,0.55); }
.btn--outline-white:hover { background: rgba(255,255,255,0.12); }

/* ===== HERO ===== */
.hero {
	padding: 5rem 0 4.5rem;
	background: #fff;
	border-bottom: 1px solid var(--color-border);
}
.hero-inner {
	display: grid;
	grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
	gap: 4rem;
	align-items: center;
}
.hero h1 {
	font-family: var(--font-serif);
	font-size: clamp(2rem, 4vw, 2.875rem);
	color: var(--color-navy);
	line-height: 1.3;
	margin-bottom: 1.25rem;
}
.hero-sub {
	font-size: 1rem;
	color: var(--color-charcoal);
	line-height: 1.9;
	margin-bottom: 1.5rem;
	max-width: 48ch;
}
.hero-tags {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5rem;
	margin-bottom: 2rem;
}
.hero-tag {
	font-size: 0.8125rem;
	font-weight: 600;
	background: var(--color-bg-soft);
	color: var(--color-charcoal);
	border: 1px solid var(--color-border-mid);
	border-radius: 4px;
	padding: 0.25rem 0.75rem;
}

/* PDF Mock */
.hero-mock { min-width: 0; }
.pdf-mock {
	position: relative;
	width: 220px;
}
.pdf-mock__cover {
	width: 200px;
	height: 280px;
	background: var(--color-navy);
	border-radius: 3px 6px 6px 3px;
	padding: 2rem 1.5rem;
	display: flex;
	flex-direction: column;
	justify-content: space-between;
	box-shadow: 4px 4px 24px rgba(0,0,0,0.25), 0 0 0 1px rgba(0,0,0,0.1);
	position: relative;
	z-index: 2;
}
.pdf-mock__logo {
	font-size: 0.6875rem;
	font-weight: 700;
	letter-spacing: 0.16em;
	color: rgba(255,255,255,0.5);
}
.pdf-mock__rule {
	height: 1px;
	background: rgba(255,255,255,0.15);
	margin: 0.75rem 0;
}
.pdf-mock__rule--bottom { margin-top: auto; margin-bottom: 0.5rem; }
.pdf-mock__title {
	font-family: var(--font-serif);
	font-size: 1rem;
	color: #fff;
	line-height: 1.5;
	font-weight: 600;
}
.pdf-mock__subtitle {
	font-size: 0.6875rem;
	color: rgba(255,255,255,0.6);
	line-height: 1.6;
}
.pdf-mock__meta {
	font-size: 0.6875rem;
	color: rgba(255,255,255,0.4);
	letter-spacing: 0.06em;
}
.pdf-mock__spine {
	position: absolute;
	left: 0;
	top: 0;
	width: 8px;
	height: 100%;
	background: #1e3a8a;
	border-radius: 2px 0 0 2px;
	z-index: 3;
}
.pdf-mock__shadow {
	position: absolute;
	right: -12px;
	bottom: -8px;
	width: 200px;
	height: 280px;
	background: rgba(0,0,0,0.08);
	border-radius: 3px 6px 6px 3px;
	z-index: 1;
}

/* ===== CONTENTS ===== */
.contents { padding: 5rem 0; background: var(--color-bg-soft); }
.contents-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
.content-card {
	background: #fff;
	border: 1px solid var(--color-border);
	border-radius: var(--radius);
	padding: 1.75rem;
}
.content-card__num {
	font-size: 0.72rem;
	font-weight: 700;
	color: var(--color-text-muted);
