---
import { CRM_FEATURES, featureCount } from '../../../data/crm-features';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';

const featureGlyphs = {
	contacts: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="9" y="10" width="34" height="44" rx="3"></rect>
			<circle class="glyph-strong" cx="23" cy="25" r="6"></circle>
			<path class="glyph-line" d="M15 42c2.2-5.2 13.8-5.2 16 0"></path>
			<path class="glyph-line" d="M32 21h6M32 28h6M15 48h18"></path>
			<rect class="glyph-accent" x="38" y="18" width="17" height="23" rx="3"></rect>
			<path class="glyph-line" d="M42 27h9M42 33h6"></path>
		</svg>
	`,
	kanban: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="8" y="12" width="48" height="36" rx="3"></rect>
			<path class="glyph-line" d="M24 12v36M40 12v36"></path>
			<rect class="glyph-accent" x="13" y="19" width="8" height="8" rx="1.5"></rect>
			<rect class="glyph-strong-fill" x="29" y="25" width="7" height="11" rx="1.5"></rect>
			<rect class="glyph-accent" x="45" y="18" width="6" height="16" rx="1.5"></rect>
			<path class="glyph-strong" d="M13 55l10-8 8 4 10-11 10 5"></path>
		</svg>
	`,
	jade: `
		<svg viewBox="0 0 64 64" focusable="false">
			<path class="glyph-accent" d="M32 8l17 18-17 30-17-30L32 8Z"></path>
			<path class="glyph-line" d="M15 26h34M24 26l8 30 8-30M24 17h16"></path>
			<rect class="glyph-panel" x="10" y="40" width="27" height="14" rx="3"></rect>
			<path class="glyph-strong" d="M16 47h7M27 47h4"></path>
		</svg>
	`,
	workflow: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="8" y="12" width="18" height="14" rx="3"></rect>
			<rect class="glyph-panel" x="38" y="12" width="18" height="14" rx="3"></rect>
			<rect class="glyph-accent" x="23" y="39" width="18" height="14" rx="3"></rect>
			<path class="glyph-line" d="M26 19h12M17 26v8c0 3 2 5 5 5h10M47 26v8c0 3-2 5-5 5H32"></path>
			<path class="glyph-strong" d="M13 19h8M43 19h8M28 46h8"></path>
		</svg>
	`,
	mail: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="8" y="12" width="31" height="39" rx="3"></rect>
			<path class="glyph-line" d="M15 22h17M15 30h17M15 38h11"></path>
			<rect class="glyph-accent" x="32" y="24" width="24" height="17" rx="3"></rect>
			<path class="glyph-strong" d="M32 28l12 8 12-8"></path>
			<path class="glyph-line" d="M42 48h10"></path>
		</svg>
	`,
	language: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="7" y="13" width="15" height="30" rx="3"></rect>
			<rect class="glyph-accent" x="24.5" y="18" width="15" height="30" rx="3"></rect>
			<rect class="glyph-panel" x="42" y="13" width="15" height="30" rx="3"></rect>
			<path class="glyph-line" d="M12 22h5M12 28h4M12 34h6M29.5 27h5M29.5 33h4M47 22h5M47 28h4M47 34h6"></path>
			<path class="glyph-strong" d="M19 51h26"></path>
			<path class="glyph-strong" d="M38 46l7 5-7 5"></path>
		</svg>
	`,
};

const proofStats = [
	{ figure: '40+', label: 'B2B revenue processes Consilegy has designed' },
	{ figure: '175', label: 'RevOps workflows shipped with the product' },
	{ figure: '3', label: 'Languages: 日本語 / English / 繁體中文, UI and all' },
	{ figure: 'Press', label: 'See News (花蓮視新聞), 25 June 2026' },
];

const outcomes = [
	{
		problem: 'The customer list is spread across spreadsheets and inboxes',
		answer: 'Contacts, companies, deals, and correspondence collect into one history.',
	},
	{
		problem: 'Where a deal stands lives in one person’s head',
		answer: 'Stage, probability, and next action sit on a screen the whole team reads.',
	},
	{
		problem: 'Next month’s number gets added up by hand every time',
		answer: 'A weighted forecast comes straight off the pipeline.',
	},
	{
		problem: 'Follow-up and renewals slip once the deal is won',
		answer: 'Workflows catch renewal dates and stalled work, and tell the owner.',
	},
];

const aiMoves = [
	{
		act: 'Ask it',
		text: 'Search and aggregate contacts, deals, and your funnel. Create contacts and tasks on the spot. ⌘J opens it from any screen.',
	},
	{
		act: 'Photograph a card',
		text: 'Seventeen fields read from one photo. A confirmation screen always comes before anything is saved.',
	},
	{
		act: 'Paste a conversation',
		text: 'From LINE, Slack, or Chatwork threads: a summary, the next actions, and early signals on amount and stage.',
	},
	{
		act: 'Log a call',
		text: 'The transcript is structured under MEDDPICC / BANT / CHAMP / SPIN and written back onto the deal.',
	},
	{
		act: 'Shoot your handwriting',
		text: 'Whiteboards and paper notes become text, with candidate tasks. A person picks which ones count.',
	},
	{
		act: 'Correct it once',
		text: 'Correct it once and the correction sticks. Next time the same question comes up, your judgement is what it works from. ICP tier first.',
	},
];

const safeguards = [
	{
		label: 'Never trained on',
		text: 'The outside AI services behind card scanning, handwriting, and transcription are used under terms that exclude what you send from training. You can also bring your own API key and send it to your own account instead.',
	},
	{
		label: 'Invisible to other tenants',
		text: 'Companies are separated by row-level access control in the database, not by filtering in the application. A new table that forgets it is caught by an automated check before release.',
	},
	{
		label: 'Scoped per role',
		text: 'Set who can see and act on which data, by role. Who changed what, and when, stays in the audit log.',
	},
	{
		label: 'Deletion is reversible',
		text: 'Deleted records go to a trash you can restore from. The database is backed up daily.',
	},
	{
		label: 'Held in Tokyo',
		text: 'Data is stored in the Tokyo region. It does not leave the country.',
	},
	{
		label: 'Yours to take',
		text: 'Export contacts, companies, and deals to CSV at any time. Cancelling does not lock your data in. It is your data.',
	},
];

const capabilities = [
	{
		icon: 'contacts',
		title: 'Customer history stops belonging to one person',
		text: 'Contacts, companies, deals, activity, and notes on one screen. The context survives a change of owner.',
	},
	{
		icon: 'kanban',
		title: 'Read the number instead of assembling it',
		text: 'Move a card and update the probability; pipeline total and weighted forecast update with it.',
	},
	{
		icon: 'jade',
		title: 'Used by asking, not by typing',
		text: 'Ask Jade in plain language and it searches, counts, summarizes, classifies, and proposes the next action.',
	},
	{
		icon: 'workflow',
		title: 'Nothing slips because someone remembered',
		text: 'Notifications, tasks, follow-up, and renewal deals run on their own. Switch on the ones you need from 175 workflows.',
	},
	{
		icon: 'mail',
		title: 'Capture and follow-up in the same place',
		text: 'Forms, email, lists, and sequences ship with the product. There is no separate marketing tool to add.',
	},
	{
		icon: 'language',
		title: 'The same data, in each member’s own language',
		text: 'Switch between 日本語, English, and 繁體中文 with one button. Everyone works the same records.',
	},
];

const screens = [
	{
		src: '/images/crm/screen-dashboard-en.webp',
		alt: 'The Revenue CRM dashboard: open pipeline, weighted forecast, win rate, overdue tasks, pipeline by stage, and the deals that need attention, on one screen.',
		title: 'Dashboard',
		text: 'Open pipeline, weighted forecast, and what to handle first',
	},
	{
		src: '/images/crm/screen-deals-en.webp',
		alt: 'The Revenue CRM deal kanban, with Prospecting, Discovery, Proposal, and Quote columns; each card carries amount, probability, and close date.',
		title: 'Deal kanban',
		text: 'Update stage, probability, and next action by dragging',
	},
	{
		src: '/images/crm/screen-jade-en.webp',
		alt: 'Jade, the AI agent, answering the question "What should I do today?" with a funnel breakdown and a table of ten open deals.',
		title: 'Jade, the AI agent',
		text: 'Ask in plain language; it aggregates, summarizes, and proposes',
	},
	{
		src: '/images/crm/screen-dashboard.webp',
		alt: 'The Revenue CRM Japanese UI. The same dashboard switched to 日本語, with the JA / EN / 繁中 buttons in the sidebar.',
		title: 'Multilingual UI',
		text: 'Switch the whole interface between 日本語, English, and 繁體中文',
	},
];

const editions = [
	{
		noun: 'Deals',
		title: 'B2B sales',
		text: 'Manage prospects as deals. Pipeline, quotes, forecast, and stalled-deal alerts.',
	},
	{
		noun: 'Projects',
		title: 'Agencies & contract work',
		text: 'Quote, win, deliver, invoice, and renew maintenance, tracked per project.',
	},
	{
		noun: 'Contracts',
		title: 'SaaS resellers',
		text: 'Track renewals, churn risk, renewal deals, and cross-sell candidates.',
	},
	{
		noun: 'Enrollment',
		title: 'Schools & studios',
		text: 'Manage enrollment, retention, holds, and withdrawals. Offered as a separate school edition.',
		href: '/en/crm/school/',
	},
];

const faqs = [
	{
		q: 'Can we migrate from the CRM we use today?',
		a: 'Revenue CRM is built for companies that do not have a CRM yet. If Salesforce, HubSpot, or kintone is already running, we do not recommend switching. We would redesign the revenue process around the tool you already pay for.',
	},
	{
		q: 'Do we need to register to see the demo?',
		a: 'An email address, nothing else. No password, no screening. Pick whichever of the three is closest to you: B2B sales, agency and contract work, or SaaS reseller.',
	},
	{
		q: 'Can we use it in languages other than Japanese?',
		a: 'Japanese, English, and Traditional Chinese, switched with one button. The same data, read by each member in their own language.',
	},
	{
		q: 'What does it cost?',
		a: '¥3,000 per seat per month, and ¥2,500 per seat from the tenth. Terms during the closed beta are agreed case by case.',
	},
];

const featureGroups = CRM_FEATURES.map((g) => ({ title: g.title.en }));
---

<BaseLayout
	title="Revenue CRM for B2B (beta) | The first CRM for companies that don't have one yet"
	description="The customer list is a spreadsheet, the correspondence is in an inbox, and where a deal stands lives in one person's head. Revenue CRM is the CRM Consilegy built for those companies. Jade, the AI agent, and 175 RevOps workflows ship with it. An email address is enough to open the demo. Currently in closed beta."
	lang="en"
	alternateUrl="/crm/"
>

<!-- ===================== 1. HERO ===================== -->
<section class="crm-hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM for B2B, in beta</p>
			<h1>The first CRM for companies<br class="br-wide" />that don't have one yet.</h1>
			<p class="hero-lead">
				The customer list is a spreadsheet. The correspondence is in an inbox. Where a deal stands
				lives in one person's head. We have been inside more than 40 companies like that.
				Every time, there was no CRM we could honestly put in. So we built one.
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">See the demo</a>
				<a href="/en/contact/" class="btn btn--secondary">Talk to us about the beta</a>
			</div>
			<p class="hero-note">An email address opens the real product. No password to set, no sales call.</p>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/screen-dashboard-en.webp"
				alt="The Revenue CRM dashboard: open pipeline, weighted forecast, win rate, overdue tasks, pipeline by stage, and the deals that need attention, on one screen."
				width="1600"
				height="1000"
				decoding="async"
				fetchpriority="high"
			/>
			<figcaption>Dashboard: the number you read first and the person you move on next, together</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 2. PROOF ===================== -->
<section class="proof">
	<div class="container">
		<ul class="proof-grid">
			{proofStats.map((item) => (
				<li>
					<strong>{item.figure}</strong>
					<span>{item.label}</span>
				</li>
			))}
		</ul>
		<p class="proof-note">
			"40+" is the number of companies Consilegy LLC has supported on marketing, sales, and customer
			success design. Revenue CRM is in closed beta, so we do not publish a customer count for it.
		</p>
	</div>
</section>

<!-- ===================== 3. PROBLEM → OUTCOME ===================== -->
<section class="outcomes">
	<div class="container">
		<div class="section-head">
			<p class="kicker">What changes</p>
			<h2>What you do in a spreadsheet today becomes the team's record.</h2>
		</div>
		<ul class="outcome-grid">
			{outcomes.map((item) => (
				<li class="outcome-card">
					<p class="outcome-problem">{item.problem}</p>
					<p class="outcome-answer">{item.answer}</p>
				</li>
			))}
		</ul>
	</div>
</section>

<!-- ===================== 3b. AI ===================== -->
<section class="ai" id="ai">
	<div class="container">
		<div class="section-head">
			<p class="kicker">AI / Jade</p>
			<h2>Not a CRM you type into. One you ask, photograph, and paste into.</h2>
		</div>
		<p class="ai-lead">
			CRMs stop being used for one reason. Entering data is always the last thing on the list.
			So we took the typing out. Jade, the AI inside, answers when you ask in plain language.
			Cards get photographed, threads get pasted, calls get spoken.
		</p>
		<ul class="ai-grid">
			{aiMoves.map((item) => (
				<li class="ai-card">
					<span class="ai-act">{item.act}</span>
					<p>{item.text}</p>
				</li>
			))}
		</ul>
		<p class="ai-note">
			Anything AI writes waits for a person before it is saved or sent. Nothing goes out on its own.
			You can bring your own API key (Anthropic / OpenAI / Gemini / Azure OpenAI),
			and an MCP server ships with the product so outside AI tools can work against your CRM.
		</p>
	</div>
</section>

<!-- ===================== 3c. SECURITY ===================== -->
<section class="safeguards">
	<div class="container">
		<div class="section-head">
			<p class="kicker">Your data</p>
			<h2>Read by AI, still yours alone.</h2>
		</div>
		<dl class="safe-list">
			{safeguards.map((item) => (
				<div class="safe-row">
					<dt>{item.label}</dt>
					<dd>{item.text}</dd>
				</div>
			))}
		</dl>
		<p class="safe-note">
			Two-factor authentication and single sign-on are not offered at this stage.
		</p>
	</div>
</section>

<!-- ===================== 4. PRODUCT VIEW ===================== -->
<section class="product-view">
	<div class="container">
		<div class="section-head">
			<p class="kicker">Screens</p>
			<h2>The number you read first and the person you move on next, on one screen.</h2>
		</div>
		<ul class="view-grid">
			{screens.map((item) => (
				<li class="view-card">
					<figure>
						<img
							src={item.src}
							alt={item.alt}
							width="1600"
							height="1000"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div class="view-caption">
						<strong>{item.title}</strong>
						<span>{item.text}</span>
					</div>
				</li>
			))}
		</ul>

		<figure class="view-demo">
			<img
				src="/videos/revenue-crm-demo-en.gif"
				alt="A walkthrough of Revenue CRM, moving through the dashboard, the deal kanban, the automation library, Jade the AI agent, and the three-language switch."
				width="800"
				height="585"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>Walkthrough: dashboard → deal kanban → automation library → Jade → language switch</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 5. CAPABILITIES ===================== -->
<section class="features" id="features">
	<div class="container">
		<div class="section-head">
			<p class="kicker">What it does</p>
			<h2>Sales, marketing, and CS on one revenue base.</h2>
		</div>
		<div class="feature-grid">
			{capabilities.map((item) => (
				<article class="feature-card">
					<span class="feature-glyph" aria-hidden="true">
						<Fragment set:html={featureGlyphs[item.icon]} />
					</span>
					<div>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</div>
				</article>
			))}
		</div>
		<div class="feature-more">
			<p class="feature-more-note">{featureGroups.map((group) => group.title).join(' / ')}</p>
			<a class="feature-more-link" href="/en/crm/features/">See all {featureCount()} features</a>
		</div>
	</div>
</section>

<!-- ===================== 6. EDITIONS ===================== -->
<section class="editions">
	<div class="container">
		<div class="section-head">
			<p class="kicker">By business type</p>
			<h2>Set up for the shape of your business from the start.</h2>
		</div>
		<div class="edition-grid">
			{editions.map((item) => (
				<article class:list={['edition-card', item.href && 'edition-card--muted']}>
					<span class="edition-noun">{item.noun}</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					{item.href && <a href={item.href}>See the school edition</a>}
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== 7. PRICING ===================== -->
<section class="pricing">
	<div class="container">
		<div class="section-head">
			<p class="kicker">Pricing</p>
			<h2>Add a seat for each person who uses it.</h2>
		</div>
		<div class="price-grid">
			<div class="price-card">
				<p class="price-tier">Seats 1&ndash;9</p>
				<p class="price-figure"><span class="price-yen">&yen;</span>3,000<span class="price-unit">/ seat / month</span></p>
			</div>
			<div class="price-card">
				<p class="price-tier">From the 10th seat</p>
				<p class="price-figure"><span class="price-yen">&yen;</span>2,500<span class="price-unit">/ seat / month</span></p>
			</div>
			<div class="price-note">
				<p>Graduated: only seats from the tenth onward are billed at &yen;2,500. The first nine stay at &yen;3,000.</p>
				<p>There is no setup fee. Terms during the closed beta are agreed case by case.</p>
			</div>
		</div>
		<p class="proof-note">All prices exclude consumption tax.</p>
	</div>
</section>

<!-- ===================== 8. FIT ===================== -->
<section class="fit">
	<div class="container fit-grid">
		<div class="fit-box">
			<p class="kicker">A good fit</p>
			<h2>Companies about to adopt a CRM</h2>
			<ul>
				<li>Customer information is split across spreadsheets, inboxes, and personal notes</li>
				<li>Deal status is not shared across the team</li>
				<li>The revenue outlook is added up by hand every time</li>
				<li>Follow-up and renewal timing go untracked once a deal is won</li>
			</ul>
		</div>
		<div class="fit-box fit-box--subtle">
			<p class="kicker">Better served another way</p>
			<h2>Companies already running a CRM</h2>
			<p>
				If Salesforce, HubSpot, kintone, or Marketo is already running, don't switch.
				You paid for it, and it can be made to work. We would rather redesign the revenue
				process around what you have than sell you a replacement.
			</p>
			<a href="/en/services/" class="text-link">See how we redesign an existing CRM</a>
		</div>
	</div>
</section>

<!-- ===================== 9. ORIGIN ===================== -->
<section class="media-proof">
	<div class="container media-grid">
		<div class="media-copy">
			<p class="kicker">Where it came from</p>
			<h2>Built at a nomad hub in Hualien, Taiwan.</h2>
			<p>
				The product took shape at Nomad Hualien (花蓮雲基地), the digital nomad hub run by Hualien
				County. Seiko Yamaguchi, Consilegy's founder, stayed there with the first cohort, and the
				shape of this product, CRM and AI together, came out of working alongside founders and
				remote workers from several countries.
			</p>
			<p>
				The AI agent is called Jade because jade is what Hualien is known for.
				See News (花蓮視新聞) covered this in its 25 June 2026 edition.
			</p>
			<a
				href="https://www.seenews.com.tw/news_data.php?news_id=2325&amp;k_code=A"
				target="_blank"
				rel="noopener noreferrer"
				class="text-link"
			>Read the article</a>
		</div>
		<figure class="press-image">
			<img
				src="/images/common/seenews-hualien-2026.jpg"
				alt="The See News (花蓮視新聞) article of 25 June 2026, covering the development of a CRM and AI product at Nomad Hualien."
				width="1000"
				height="1026"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>See News (花蓮視新聞), 25 June 2026</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 10. FAQ ===================== -->
<section class="faq">
	<div class="container">
		<div class="section-head">
			<p class="kicker">Questions</p>
			<h2>What people ask before they start.</h2>
		</div>
		<dl class="faq-list">
			{faqs.map((item) => (
				<div class="faq-item">
					<dt>{item.q}</dt>
					<dd>{item.a}</dd>
				</div>
			))}
		</dl>
	</div>
</section>

<!-- ===================== 11. FINAL CTA ===================== -->
<section class="beta">
	<div class="container">
		<div class="cta-head">
			<p class="kicker">Closed beta</p>
			<h2>The first CRM for a company that has none.</h2>
			<p>
				We are working with a handful of companies right now, building against how they
				actually operate. We do the setup and load the first data ourselves. What gets built
				next is decided by their work, not by our roadmap.
			</p>
		</div>
		<ul class="cta-grid">
			<li class="cta-card">
				<h3>Try it first</h3>
				<p>An email address opens the real product.</p>
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">See the demo</a>
			</li>
			<li class="cta-card">
				<h3>Ask about the beta</h3>
				<p>We start from whether it fits how you work.</p>
				<a href="/en/contact/" class="btn btn--secondary">Get in touch</a>
			</li>
			<li class="cta-card">
