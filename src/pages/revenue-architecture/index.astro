	url: 'https://consilegy.com/revenue-architecture/',
	inDefinedTermSet: {
		'@type': 'DefinedTermSet',
		name: 'Consilegy Revenue Architecture用語集',
		url: 'https://consilegy.com/revenue-architecture/',
	},
};

