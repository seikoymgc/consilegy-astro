---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import Card from '../../../components/Card.astro';
import CardGrid from '../../../components/CardGrid.astro';
import CTA from '../../../components/CTA.astro';
import { getCollection } from 'astro:content';

const cases = (await getCollection('caseStudies'))
	.filter((c) => c.data.lang === 'en')
	.sort((a, b) => (b.data.modified ?? '').localeCompare(a.data.modified ?? ''));

function slugFor(entry: (typeof cases)[number]) {
	if (entry.data.sourceUrl) {
		const last = entry.data.sourceUrl.replace(/\/$/, '').split('/').pop();
		if (last) return last;
	}
	return entry.data.slug;
}
---

<BaseLayout
	title="Case Studies | Consilegy"
	description="Revenue operations and go-to-market execution case studies. We help global B2B teams design and implement structures that actually work in Japan."
	lang="en"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://consilegy.com/en/"},
		{"@type": "ListItem", "position": 2, "name": "Case Studies", "item": "https://consilegy.com/en/case-studies/"}
	]
})} />
	<PageHero
		eyebrow="Case Studies"
		title="Case Studies"
		lede="From market entry to CRM implementation and operational adoption: here's how we've helped global teams build revenue operations in Japan."
	/>

	<section class="container cs-fig-wide" style="margin-block:2.5rem">
		<figure class="en-fig" aria-labelledby="en-cs-caption">
			<svg viewBox="0 0 1120 206" role="img" aria-label="Outcomes: up to 20 percent higher conversion, about 65 percent less data work, about 100 hours freed per month, built in 2 months by 3 people" font-family="inherit">
				<defs><marker id="en-cs-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<text x="40" y="26" font-size="14" letter-spacing="1.5" fill="#64748b">OUTCOMES</text>
				<rect x="40" y="50" width="314" height="136" rx="6" fill="#fff" stroke="#E2E8F0"/>
		<rect x="40" y="50" width="314" height="3" fill="#8758C9"/>
		<text x="56" y="80" font-size="14" letter-spacing="1.5" fill="#64748b">REVENUE</text>
		<text x="56" y="108" font-size="18" font-weight="600" fill="#0F172A">Up to +20%</text>
		<text x="56" y="136" font-size="16" fill="#475569">MQL-to-SQL conversion</text>
		<text x="56" y="160" font-size="16" fill="#475569">IT back-office SaaS, ~200 staff</text>
		<rect x="402" y="50" width="314" height="136" rx="6" fill="#fff" stroke="#E2E8F0"/>
		<rect x="402" y="50" width="314" height="3" fill="#8758C9"/>
		<text x="418" y="80" font-size="14" letter-spacing="1.5" fill="#64748b">TIME</text>
		<text x="418" y="108" font-size="18" font-weight="600" fill="#0F172A">~65% less data work</text>
		<text x="418" y="136" font-size="16" fill="#475569">~100 hours freed per month</text>
		<text x="418" y="160" font-size="16" fill="#475569">Healthtech, ~150 staff</text>
		<rect x="764" y="50" width="314" height="136" rx="6" fill="#fff" stroke="#E2E8F0"/>
		<rect x="764" y="50" width="314" height="3" fill="#8758C9"/>
		<text x="780" y="80" font-size="14" letter-spacing="1.5" fill="#64748b">SPEED</text>
		<text x="780" y="108" font-size="18" font-weight="600" fill="#0F172A">2 months</text>
		<text x="780" y="136" font-size="16" fill="#475569">To build with a 3-person team</text>
		<text x="780" y="160" font-size="16" fill="#475569">Consulting firm, AI unit</text>
			</svg>
			<figcaption id="en-cs-caption">Selected outcomes from the case studies below. Figures are as reported by each client.</figcaption>
		</figure>
	</section>

	<section class="container case-grid">
		<CardGrid columns={2}>
			{cases.map((c) => (
				<Card
					href={`/en/case-studies/${slugFor(c)}/`}
					title={c.data.title}
					description={c.data.description}
					imageSrc={c.data.featuredImage || undefined}
					imageAlt={c.data.featuredImageAlt || c.data.alt || ''}
					moreLabel="Read case study"
				/>
			))}
		</CardGrid>
	</section>

	<CTA
		title="Ready to build your revenue operations?"
		href="/en/contact/"
		label="Contact"
	/>
</BaseLayout>

<style>
	.cs-fig-wide {
		max-width: calc(1120px + 2 * var(--space-md));
	}
	.cs-fig-wide figcaption { padding-inline: calc(40 / 1120 * 100%); }
	.case-grid {
		padding-block: var(--space-xl);
	}
</style>
