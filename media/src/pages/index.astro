---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, categoryColors, type CategoryKey } from '../content.config';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const featured = notes[0];
const latest = notes.slice(1);

const byCategory = (Object.keys(categories) as CategoryKey[])
	.map(key => ({
		key,
		label: categories[key],
		color: categoryColors[key],
		items: notes.filter(n => n.data.category === key).slice(0, 3),
	}))
	.filter(c => c.items.length > 0);

// 人気記事。閲覧データが溜まるまでは編集部の選定順
const popular = notes.slice(0, 5);

const keywords = [
	{ label: '稟議・社内合意', href: '/notes/category/sales/' },
	{ label: 'SFAの入力率', href: '/notes/category/crm/' },
	{ label: 'リードの定義', href: '/notes/category/data/' },
	{ label: '商談ステージ設計', href: '/notes/category/sales/' },
	{ label: '海外本社への説明', href: '/notes/category/japan-gtm/' },
	{ label: 'オンボーディング', href: '/notes/category/adoption/' },
	{ label: 'MAの活用', href: '/notes/category/marketing/' },
];

const fmt = (d: Date) =>
	`${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
	title="Consilegy Media | B2Bの収益のつまずきを、構造から解決する"
	description="CRMが定着しない、商談が読めない、数字が合わない、MAが成果につながらない。B2Bの収益にまつわる悩みを、原因の構造から解決手順まで解説する教育メディアです。"
>
	<div class="cat-bar">
		<div class="wrap">
			<nav class="cat-nav" aria-label="カテゴリ">
				{
					(Object.keys(categories) as CategoryKey[]).map(key => (
						<a href={`/notes/category/${key}/`} style={`--c: ${categoryColors[key]};`}>
							{categories[key]}
						</a>
					))
				}
			</nav>
		</div>
	</div>

	<div class="kw-bar">
		<div class="wrap kw-inner">
			<span class="kw-label">よく読まれるテーマ</span>
			{keywords.map(k => <a href={k.href} class="kw-chip">{k.label}</a>)}
		</div>
	</div>

	<div class="wrap layout">
		<main class="main">
			{
				featured && (
					<section class="block">
						<h2 class="block-title"><span>ピックアップ</span></h2>
						<a href={`/notes/${featured.id}/`} class="feature">
							<img
								src={`/images/eyecatch/${featured.id}.png`}
								alt=""
								width="1200"
								height="630"
								decoding="async"
							/>
							<div class="feature-body">
								<span class="cat-tag" style={`--c: ${categoryColors[featured.data.category]};`}>
									{categories[featured.data.category]}
								</span>
								<p class="feature-title">{featured.data.title}</p>
								<p class="feature-desc">{featured.data.description}</p>
								<time class="meta" datetime={featured.data.publishedAt.toISOString()}>
									{fmt(featured.data.publishedAt)}
								</time>
							</div>
						</a>
					</section>
				)
			}

			<section class="block">
				<h2 class="block-title"><span>新着記事</span><a href="/notes/" class="block-more">記事一覧へ →</a></h2>
				<ul class="rows">
					{
						latest.map(n => (
							<li>
								<a href={`/notes/${n.id}/`} class="row">
									<img
										src={`/images/eyecatch/${n.id}.png`}
										alt=""
										width="1200"
										height="630"
										loading="lazy"
										decoding="async"
									/>
									<div class="row-body">
										<p class="row-title">{n.data.title}</p>
										<p class="row-desc">{n.data.description}</p>
										<p class="row-meta">
											<span class="cat-tag" style={`--c: ${categoryColors[n.data.category]};`}>
												{categories[n.data.category]}
											</span>
											<time datetime={n.data.publishedAt.toISOString()}>{fmt(n.data.publishedAt)}</time>
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			{
				byCategory.map(c => (
					<section class="block">
						<h2 class="block-title" style={`--c: ${c.color};`}>
							<span class="with-bar">{c.label}</span>
							<a href={`/notes/category/${c.key}/`} class="block-more">一覧へ →</a>
						</h2>
						<ul class="rows">
							{c.items.map(n => (
								<li>
									<a href={`/notes/${n.id}/`} class="row row--compact">
										<img
											src={`/images/eyecatch/${n.id}.png`}
											alt=""
											width="1200"
											height="630"
											loading="lazy"
											decoding="async"
										/>
										<div class="row-body">
											<p class="row-title">{n.data.title}</p>
											<p class="row-meta">
												<time datetime={n.data.publishedAt.toISOString()}>{fmt(n.data.publishedAt)}</time>
											</p>
										</div>
									</a>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</main>

		<aside class="side">
			<section class="side-box">
				<h2 class="side-title">人気記事</h2>
				<ol class="rank">
					{
						popular.map(n => (
							<li>
								<a href={`/notes/${n.id}/`}>
									<span class="rank-num" />
									<span class="rank-title">{n.data.title}</span>
								</a>
							</li>
						))
					}
				</ol>
			</section>

			<section class="side-box side-box--cta">
				<p class="side-cta-label">収益構造の無料診断</p>
				<p class="side-cta-text">
					CRM・商談プロセス・データの現状から、売上の取りこぼしがどこで起きているかを3分で診断します。
				</p>
				<a href="https://consilegy.com/diagnostic/" class="side-cta-btn">無料で診断する</a>
			</section>

			<section class="side-box">
				<h2 class="side-title">カテゴリ</h2>
				<ul class="side-cats">
					{
						(Object.keys(categories) as CategoryKey[]).map(key => (
							<li>
								<a href={`/notes/category/${key}/`}>
									<span class="dot" style={`--c: ${categoryColors[key]};`} />
									{categories[key]}
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="side-box">
				<h2 class="side-title">土台になる考え方</h2>
				<ul class="side-links">
					<li><a href="https://consilegy.com/revenue-architecture/">レベニューアーキテクチャとは ↗</a></li>
					<li><a href="https://consilegy.com/about-revops/">RevOps再設計とは ↗</a></li>
				</ul>
			</section>

			<section class="side-box">
				<h2 class="side-title">運営</h2>
				<p class="side-author-name">山口 聖子</p>
				<p class="side-author-bio">
					Consilegy合同会社 代表。B2BのRevOps、Revenue Architecture設計、HubSpot・CRM実装と定着支援。
				</p>
				<a href="/about/" class="side-author-link">プロフィール →</a>
			</section>
		</aside>
	</div>
</BaseLayout>

<style>
	.wrap {
		max-width: 1080px;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	/* ── カテゴリバー（ヘッダー直下） ── */
	.cat-bar {
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
	}

	.cat-nav {
		display: flex;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.cat-nav::-webkit-scrollbar {
		display: none;
	}

	.cat-nav a {
		flex-shrink: 0;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--color-text);
		padding: 0.65rem 0.9rem;
		border-bottom: 2px solid transparent;
	}

	.cat-nav a:hover {
		text-decoration: none;
		border-bottom-color: var(--c);
		color: var(--c);
	}

	/* ── キーワードバー ── */
	.kw-bar {
		border-bottom: 1px solid var(--color-border);
		background: var(--color-bg);
	}

	.kw-inner {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-block: 0.6rem;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.kw-inner::-webkit-scrollbar {
		display: none;
	}

	.kw-label {
		flex-shrink: 0;
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--color-text-muted);
	}

	.kw-chip {
		flex-shrink: 0;
		font-size: 0.75rem;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 999px;
		padding: 0.2rem 0.7rem;
	}

	.kw-chip:hover {
		text-decoration: none;
		border-color: var(--color-border-strong);
	}

	/* ── 2カラムレイアウト ── */
	.layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 300px;
		gap: 2.5rem;
		padding-block: 1.75rem 3rem;
		align-items: start;
	}

	/* ── セクション共通 ── */
	.block {
		margin-bottom: 2.25rem;
	}

	.block-title {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		font-size: 1.02rem;
		font-weight: 700;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--color-text);
		margin-bottom: 0;
	}

	.with-bar {
		padding-left: 0.6rem;
		border-left: 4px solid var(--c, var(--color-text));
	}

	.block-more {
		font-size: 0.75rem;
		font-weight: 500;
	}

	/* ── ピックアップ ── */
	.feature {
		display: grid;
		grid-template-columns: 300px minmax(0, 1fr);
		gap: 1.1rem;
		padding-block: 1rem;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-text);
	}

	.feature:hover {
		text-decoration: none;
	}

	.feature:hover .feature-title {
		color: var(--color-primary);
	}

	.feature img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--color-border);
	}

	.feature-title {
		font-size: 1.08rem;
		font-weight: 700;
		line-height: 1.55;
		margin-top: 0.4rem;
	}

	.feature-desc {
		margin-top: 0.45rem;
		font-size: 0.8rem;
		line-height: 1.75;
		color: var(--color-text-muted);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ── 記事リスト行 ── */
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.rows li {
		border-bottom: 1px solid var(--color-border);
	}

	.row {
		display: grid;
		grid-template-columns: 168px minmax(0, 1fr);
		gap: 1rem;
		padding-block: 0.9rem;
		color: var(--color-text);
	}

	.row--compact {
		grid-template-columns: 128px minmax(0, 1fr);
		padding-block: 0.7rem;
	}

	.row:hover {
		text-decoration: none;
	}

	.row:hover .row-title {
		color: var(--color-primary);
	}

	.row img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--color-border);
		align-self: start;
	}

	.row-title {
		font-size: 0.92rem;
		font-weight: 700;
		line-height: 1.55;
	}

	.row--compact .row-title {
		font-size: 0.85rem;
		font-weight: 600;
	}

	.row-desc {
		margin-top: 0.35rem;
		font-size: 0.76rem;
		line-height: 1.7;
		color: var(--color-text-muted);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.row-meta {
		margin-top: 0.45rem;
		display: flex;
		align-items: center;
		gap: 0.7rem;
		font-size: 0.7rem;
		color: var(--color-text-muted);
	}

	.row--compact .row-meta {
		margin-top: 0.3rem;
	}

	.meta {
		display: block;
		margin-top: 0.5rem;
		font-size: 0.7rem;
		color: var(--color-text-muted);
	}

	.cat-tag {
		font-size: 0.68rem;
		font-weight: 600;
		color: var(--c);
		border: 1px solid color-mix(in srgb, var(--c) 45%, #fff);
		padding: 0.1rem 0.5rem;
		border-radius: 2px;
		background: color-mix(in srgb, var(--c) 6%, #fff);
	}

	/* ── サイドバー ── */
	.side {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		position: sticky;
		top: 80px;
	}

	.side-box {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		padding: 1rem 1.1rem 1.1rem;
	}

	.side-title {
		font-size: 0.88rem;
		font-weight: 700;
		padding-bottom: 0.5rem;
		border-bottom: 2px solid var(--color-text);
		margin-bottom: 0.4rem;
	}

	.rank {
		list-style: none;
		margin: 0;
		padding: 0;
		counter-reset: rank;
	}

	.rank li {
		border-bottom: 1px solid var(--color-border);
	}

	.rank li:last-child {
		border-bottom: 0;
	}

	.rank a {
		display: flex;
		gap: 0.7rem;
		padding-block: 0.65rem;
		color: var(--color-text);
		align-items: baseline;
	}

	.rank a:hover {
		text-decoration: none;
		color: var(--color-primary);
	}

	.rank-num::before {
		counter-increment: rank;
		content: counter(rank);
		display: inline-block;
		font-size: 0.95rem;
		font-weight: 700;
		font-style: italic;
		color: var(--color-primary);
		min-width: 1.1rem;
	}

	.rank-title {
		font-size: 0.8rem;
		font-weight: 500;
		line-height: 1.6;
	}

	.side-box--cta {
		background: #f0f4ff;
		border-color: #d6e0f5;
		text-align: center;
	}

	.side-cta-label {
		font-size: 0.92rem;
		font-weight: 700;
	}

	.side-cta-text {
		margin-top: 0.5rem;
		font-size: 0.76rem;
		line-height: 1.75;
		color: var(--color-text-muted);
		text-align: left;
	}

	.side-cta-btn {
		display: block;
		margin-top: 0.8rem;
		background: var(--color-primary);
		color: #fff;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.65rem;
		border-radius: 4px;
	}

	.side-cta-btn:hover {
		background: var(--color-primary-dark);
		text-decoration: none;
	}

	.side-cats,
	.side-links {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.side-cats li,
	.side-links li {
		border-bottom: 1px solid var(--color-border);
	}

	.side-cats li:last-child,
	.side-links li:last-child {
		border-bottom: 0;
	}

	.side-cats a,
	.side-links a {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-block: 0.55rem;
		font-size: 0.8rem;
		color: var(--color-text);
	}

	.side-cats a:hover,
	.side-links a:hover {
		color: var(--color-primary);
		text-decoration: none;
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--c);
		flex-shrink: 0;
	}

	.side-author-name {
		font-size: 0.85rem;
		font-weight: 700;
		margin-top: 0.4rem;
	}

	.side-author-bio {
		margin-top: 0.3rem;
		font-size: 0.74rem;
		line-height: 1.7;
		color: var(--color-text-muted);
	}

	.side-author-link {
		display: inline-block;
		margin-top: 0.5rem;
		font-size: 0.78rem;
	}

	/* ── レスポンシブ ── */
	@media (max-width: 900px) {
		.layout {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.side {
			position: static;
		}

		.feature {
			grid-template-columns: 1fr;
		}

		.row {
			grid-template-columns: 128px minmax(0, 1fr);
		}

		.row--compact {
			grid-template-columns: 104px minmax(0, 1fr);
		}
	}
</style>
