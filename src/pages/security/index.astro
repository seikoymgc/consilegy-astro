---
import BaseLayout from '../../layouts/BaseLayout.astro';

// 公開している内容の時点。チェックシートの版と揃える。変えたらファイル名の接尾辞も上げる
// （同名で差し替えると Cloudflare が旧ファイルを返す）。
const asOf = '2026年10月';
const starRegistryHref = 'https://cloudsecurityalliance.org/star/registry/consilegy-llc';
const checklistHref = '/downloads/consilegy-security-checklist-2026-10e.xlsx';

// Revenue CRM の対策。どれも本番の設定かコードで確かめたことだけを書く（2026-10-22）。
// 対応していないこと（SAML、SLA、第三者の脆弱性診断）はページに置かず、チェックシートの回答で正直に答える（2026-10-22 代表の判断）。
const crmMeasures = [
	{ title: 'データの保管場所', text: 'データベース、ファイル、アプリケーションの実行環境は、いずれも日本（東京リージョン）にあります。AI機能で扱うデータ（入力した文章のほか、AI機能が参照するコンタクト・商談・会議の記録などの登録データを含みます）は、米国のAI事業者（Anthropic・OpenAI・Google）が処理します。本サービスから送るメールは、米国の事業者（Resend）が処理します。AI機能は、契約者が自ら契約するAI事業者に切り替えられます。' },
	{ title: '通信と保存の暗号化', text: '通信はすべてTLSで暗号化しています。HSTSを設定しているため、ブラウザからは暗号化された接続でしかアクセスできません。保存したデータとファイルは、基盤として使っているSupabaseの機能で暗号化（AES-256）しています。外部サービスと連携するための認証情報（アクセストークンやAPIキー）は、アプリケーション側でもAES-256で暗号化してから保存しています。' },
	{ title: '会社ごとのデータの分離', text: '会社ごとのデータは、データベースの行単位のアクセス制御（RLS）で分けて管理しています。RLSを通らないサーバー側の処理についても、会社をまたいでデータを扱う処理がないかを変更のたびに自動で検査しています（意図して会社をまたぐ処理は、理由を残したものだけを認めています）。新しく作るテーブルにRLSの設定漏れがないかも、自動で検出しています。' },
	{ title: '権限', text: '役割（オーナー・管理者・メンバー）ごとに、データの種類別の閲覧・作成・編集・削除・書き出しの権限と、見える範囲（全体・チーム・自分）を設定できます。' },
	{ title: 'ログイン', text: 'メールアドレスとパスワード、またはGoogleアカウントでログインできます。認証アプリを使った多要素認証とバックアップコードに対応しており、端末をなくしたときは、同じ会社の管理者が多要素認証の設定を解除できます。解除した記録は監査ログに残ります。' },
	{ title: '操作の記録', text: 'コンタクト・会社・商談の登録・変更・削除と、データの書き出しを、操作した人と日時つきで記録しています。記録は契約期間中保管し、管理者が設定画面で確認できます。' },
	{ title: 'バックアップ', text: 'データベースは毎日自動でバックアップを取り、直近7日分を保管しています。添付ファイルも毎日、同じ基盤の中の別の保管領域へ複製し、7日分を残しています。' },
	{ title: 'AIとデータ', text: '入力されたデータを、AIモデルの学習に使うことも、使わせることもありません。当社が利用するAI事業者とは、モデルの学習に使わせない条件で契約しています。契約者が自ら契約したAI事業者に切り替えた場合は、その事業者の利用条件によります。なお、各事業者は不正利用の監視のため、送信された内容を一定期間保持することがあります。' },
	{ title: 'AIの安全対策', text: 'AIに渡すお客様のデータや検索結果は、原則としてAIへの指示と分けて渡しています。データの中にAIへの不正な指示らしい文がないかも確かめ、見つけたものはサーバーのログに残しています。AIが作成した内容には、主な画面で「AI生成」と表示します。AI機能は、管理者が会社ごとにまとめて止められます。AIとのやり取りは記録に残し、その記録は90日たつと自動で削除します。' },
	{ title: '脆弱性への対応', text: 'システムで使っている外部のソフトウェアの更新や脆弱性の情報が自動で届くようにしており、内容を確かめたうえで、深刻度に応じて更新しています。脆弱性に気づいた方からの報告も受け付けています。' },
	{ title: '契約終了後のデータ', text: '契約終了日から30日間は、設定画面からデータをCSVで書き出せます。その後、サービス上のデータは当社が消去します。バックアップに残っているデータも、保存期間（7日間）が過ぎた時点で消去されます。' },
];

---

<BaseLayout
	title="セキュリティ | Consilegy"
	description="Consilegy合同会社と、顧客管理システム「Revenue CRM」のセキュリティへの取り組みをまとめています。データの保管場所、暗号化、権限、バックアップ、AIの扱いのほか、セキュリティチェックシートの回答も掲載しています。"
	lang="ja"
>
	<header class="page-head container">
		<p class="page-head__eyebrow">Security</p>
		<h1 class="page-head__title">セキュリティへの取り組み</h1>
		<p class="page-head__lead">お客様からお預かりする情報をどう守っているかを、{asOf}時点の内容でまとめています。取引先の審査でよく聞かれる質問への回答も、登録なしでダウンロードできます。</p>
		<p class="page-head__actions">
			<a class="btn btn--primary" href={checklistHref} download>チェックシートの回答をダウンロード（Excel）</a>
		</p>
	</header>

	<section class="band band--subtle">
		<div class="container">
			<p class="section-eyebrow">Company</p>
			<h2 class="section-title">会社としての取り組み</h2>
			<div class="cards cards--2">
				<div class="card">
					<h3>情報セキュリティ基本方針</h3>
					<p>経営者の責任、社内体制、対策、お客様の情報の取扱い、教育、法令の遵守、事故への対応、継続的な改善を定めています。</p>
					<p><a href="/security-policy/">情報セキュリティ基本方針を読む</a></p>
				</div>
				<div class="card card--badge">
					<img src="/images/common/security-action-futatsuboshi-2026.png" alt="SECURITY ACTION セキュリティ対策自己宣言 二つ星" width="72" height="72" loading="lazy" />
					<div>
						<h3>SECURITY ACTION 二つ星</h3>
						<p>独立行政法人情報処理推進機構（IPA）の制度「SECURITY ACTION」で、二つ星を宣言しています（2026年10月）。二つ星は、「情報セキュリティ5か条」に取り組んだうえで、自社診断で状況を確かめ、情報セキュリティ基本方針を定めて公開していることを示すものです。</p>
					</div>
				</div>
				<div class="card card--badge">
					<a href={starRegistryHref} target="_blank" rel="noopener"><img src="/images/common/csa-star-level1-2026.png" alt="CSA STAR Level One: Self-Assessment" width="72" height="72" loading="lazy" /></a>
					<div>
						<h3>CSA STAR Level 1（自己評価）</h3>
						<p>クラウドセキュリティの国際団体であるCloud Security Alliance（CSA）の質問票に、Revenue CRMの対策について回答しました。回答はCSAの「STAR Registry」に掲載されており（2026年10月掲載）、どなたでもご覧いただけます。第三者の監査や認証を受けたものではなく、当社が自ら評価したものです。</p>
						<p><a href={starRegistryHref} target="_blank" rel="noopener">STAR Registryで回答を見る</a></p>
					</div>
				</div>
				<div class="card">
					<h3>情報セキュリティ規程</h3>
					<p>事故が起きたときの対応、事業の継続と復旧、開発やシステム変更の管理、脆弱性への対応、スタッフ・端末・委託先・データの扱い、AIの使い方について、社内の規程を定めています。規程は年に1回見直すことにしています。これまでに、バックアップからの復旧テスト、事故を想定した机上訓練、スタッフ向けの研修を行い、いずれも記録を残しています。</p>
				</div>
				<div class="card">
					<h3>社内の運用</h3>
					<p>業務で使うクラウドサービスでは2段階認証を設定し、パスワードは管理ツールで管理しています。権限は必要最小限にとどめ、端末にはディスクの暗号化とウイルス対策を施しています。スタッフ・業務委託先には秘密保持を義務づけ、定期的に教育を行っています。</p>
				</div>
				<div class="card">
					<h3>事故が起きたとき</h3>
					<p>対応手順を定めており、報告・初動・影響の確認・通知・再発防止の順に対応します。Revenue CRMでお預かりした個人情報の漏えいなどを当社が知ったときは、速やかに、遅くとも3営業日以内に契約者へ通知します。</p>
				</div>
			</div>
		</div>
	</section>

	<section class="band" id="revenue-crm">
		<div class="container">
			<p class="section-eyebrow">Revenue CRM</p>
			<h2 class="section-title">Revenue CRMの対策</h2>
			<div class="cards cards--3">
				{crmMeasures.map(m => (
					<div class="card">
						<h3>{m.title}</h3>
						<p>{m.text}</p>
					</div>
				))}
			</div>
			<p class="note">外部委託先（データベース、実行環境、AI機能、メール送信など）の一覧は、<a href="https://crm.consilegy.com/terms">Revenue CRM利用規約</a>に掲載しています。</p>
			<p class="note">当社とお客様の責任分担、脆弱性の報告方法、捜査機関などからの開示の求めへの対応は、<a href="/security/shared-responsibility/">セキュリティと責任分担</a>にまとめています。</p>
		</div>
	</section>


	<section class="band band--subtle">
		<div class="container narrow">
			<p class="section-eyebrow">Download</p>
			<h2 class="section-title">セキュリティチェックシートの回答</h2>
			<p>組織、人、アクセス管理、端末、データ、Revenue CRMの6分類・33問に、そのまま貼れる文章で答えています（{asOf}時点）。取引先のチェックシートへの記入にお使いください。登録は要りません。</p>
			<p><a class="btn btn--primary" href={checklistHref} download>回答をダウンロード（Excel）</a></p>
			<p class="note">ここにない質問や、貴社の様式での回答が必要な場合は、<a href="mailto:info@consilegy.com">info@consilegy.com</a> までご連絡ください。</p>
		</div>
	</section>
</BaseLayout>

<style>
.page-head {
	padding-block: var(--space-2xl) var(--space-lg);
}
.page-head__eyebrow, .section-eyebrow {
	margin: 0 0 var(--space-xs);
	font-size: 0.875rem; font-weight: 700;
	letter-spacing: 0.12em; text-transform: uppercase;
	color: var(--color-navy);
}
.page-head__title {
	margin: 0 0 1rem;
	font-size: clamp(1.75rem, 3vw, 2.25rem);
	font-weight: 600; letter-spacing: 0.01em;
}
.page-head__lead { max-width: 720px; margin: 0 0 1.5rem; font-size: 1rem; line-height: 1.85; color: var(--color-text-muted); }
.page-head__actions { margin: 0; }

.band { padding-block: var(--space-xl); }
.band--subtle { background: var(--color-bg-subtle); }
.narrow > p, .narrow > ul { max-width: 720px; }
.section-title { margin: 0 0 1.5rem; font-size: 1.5rem; font-weight: 600; }

.cards { display: grid; gap: 1rem; }
.cards--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
@media (max-width: 900px) { .cards--3 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 640px) { .cards--2, .cards--3 { grid-template-columns: 1fr; } }
.card {
	background: #fff;
	border: 1px solid var(--color-border);
	
	border-radius: 6px;
	box-shadow: 0 1px 3px rgba(15, 23, 42, 0.06);
	padding: 1.25rem 1.5rem;
}
.card h3 { margin: 0 0 0.5rem; font-size: 1.0625rem; font-weight: 600; }
.card p { margin: 0 0 0.5rem; font-size: 1rem; line-height: 1.8; color: var(--color-text); }
.card p:last-child { margin-bottom: 0; }
.card a { color: var(--color-primary); }
.card--badge { display: flex; gap: 1rem; align-items: flex-start; }
.card--badge img { width: 72px; height: 72px; flex-shrink: 0; }

.band p { font-size: 1rem; line-height: 1.85; }
.band .note { margin-top: 1.25rem; font-size: 0.875rem; color: var(--color-text-muted); }
.band .note a { color: var(--color-primary); }
</style>
