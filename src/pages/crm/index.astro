---
import { featureCount } from '../../data/crm-features';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrmSubnav from '../../components/CrmSubnav.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// 概要ページは9セクション（スマートフォンを2026-09-29に追加）。機能の詳細は /crm/features/、料金の詳細と契約条件は /crm/pricing/、
// 質問の全件は /crm/faq/、事業タイプ別の説明は各エディションのページに任せる。

const supports = [
	{ tier: '操作動画・ヘルプ記事', figure: '無料', text: 'すべてのプランで無料。自分で進める会社はここから。' },
	{ tier: '初期設定', figure: '120,000円〜', text: '項目・商談の段階・自動化を自社の業務に合わせて設定。操作説明会3回。' },
	{ tier: '定着支援（3ヶ月）', figure: '300,000円〜', text: '週1回の定例、設定の見直し、使い方の個別相談。' },
	{ tier: '運用支援', figure: '月額30,000円〜', text: '設定変更の代行と、ご質問への対応（月2時間まで）。' },
	{ tier: '追加開発', figure: '要見積', text: 'その会社の運用に合わせて、機能を足します。' },
];

const mobilePoints = [
	{ title: '専用アプリは不要', text: 'ブラウザで開くだけ。画面はスマートフォンの幅に合わせて切り替わります。' },
	{ title: '名刺はその場で撮る', text: 'カメラで撮った名刺をAIが読み取り、訪問先や展示会でそのまま登録できます。' },
	{ title: '外出先で商談を確認', text: '金額・段階・次の予定まで、移動中に確かめられます。' },
	{ title: 'パソコンと同じデータ', text: 'スマートフォンで直した内容は、そのままパソコンにも反映されます。' },
];

// 課題は左右で対応させる。左＝よくある戻り方、右＝Revenue CRMではどうなるか。
const problems = [
	{ topic: '入力', problem: '入力が、辛い。', answer: '声で話せば記録になる。名刺を撮れば入る。議事録を貼れば、タスクと連絡先ができる。人は確かめて保存するだけです。' },
	{ topic: '立ち上げ', problem: 'ツールを覚えるのに、<br />時間がかかる。', answer: '空のCRMは渡しません。用途を選ぶと、商談の段階と、よく使う自動化が入った状態から始まります。' },
	{ topic: '属人化', problem: '運用していた一人が、<br />辞める。', answer: '設定は画面に残り、自動化は175本の中から選ぶだけ。操作動画とヘルプ記事は、すべてのプランで無料です。' },
];

const afters = [
	{ title: '売上が伸びる', figure: '175', unit: '本', note: '停滞や期日を見張って知らせる自動化', text: '顧客ごとにAIが次の行動を提案します。渡したきり追えない、は起きません。' },
	{ title: '時間が戻る', figure: '3', unit: 'つ', note: '撮る・話す・貼る。記録はAIが下書き', text: '「あの件、電話した？」「誰が持ってる？」と人を追いかける時間がなくなります。' },
	{ title: '部門の摩擦が消える', figure: '1', unit: 'つ', note: 'マーケ・営業・顧客管理を一つの顧客データに', text: '全員が同じ顧客の情報を見るので、押し付け合いではなく、一緒に動けます。' },
];

const editions = [
	{ noun: '商談', title: 'B2B', href: '/crm/features/' },
	{ noun: '案件', title: '受託開発', href: '/crm/contractor/' },
	{ noun: '契約', title: '代理店', href: '/crm/reseller/' },
	{ noun: '在籍', title: 'スクール', href: '/crm/school/' },
];

const plans = [
	{ tier: 'ユーザープラン', figure: '3,000円', unit: '/ 人 / 月', for: 'B2B・受託開発・代理店版。毎日CRMを使う会社に' },
	{ tier: '生徒数プラン', figure: '9,800円', unit: '/ 月〜', for: 'スクール版。在籍生徒50人まで' },
	{ tier: 'プリペイドプラン', figure: '3,000円', unit: '/ 月', for: '全エディション。使う頻度が低い会社に' },
];

// 文面は /crm/school/ の safeguards と同じ系統。全6項目のうち、導入前に聞かれる3つだけを出す。
const safeguards = [
	{ label: '学習に使われない', text: '名刺や手書きの読み取り、文字起こしでは、送信した内容を学習に使わない条件のサービスを利用しています。' },
	{ label: '他社に見えない', text: '会社ごとの隔離は、データベースの行単位のアクセス制御で行っています。アプリ側の絞り込みには頼りません。' },
	{ label: '東京に置いてある', text: 'データは東京リージョンに保存。AIの処理はAnthropic・OpenAI・Google（米国）を経由しますが、送った内容を学習に使わせない契約です。' },
];

// 全件は src/data/crm-faq.ts（/crm/faq/）。ここは購入前に最も聞かれる5問だけ。
const faqs = [
	{ q: '料金はいくらですか。', a: 'プランは3つです。ユーザープランは1人あたり月額3,000円、スクール向けの生徒数プランは在籍生徒50人まで月額9,800円からです。使う頻度が低い会社には、月額3,000円（燃料100付き）に必要な分だけ追加するプリペイドプランがあります。初期費用はありません。どのプランも30日間の無料トライアル付きで、カード登録なしで始められます。価格はすべて税抜です。' },
	{ q: 'ユーザー数はどう数えますか。', a: 'ワークスペースに参加しているメンバーの数です。招待したまま使っていないアカウントも含みます。人数の増減は、次回の請求から反映されます。' },
	{ q: '解約はどうすればいいですか。', a: 'ユーザープランと生徒数プランの契約期間は1年で、以後1年ごとに自動更新します。契約期間の途中で解約することはできません。終了する場合は、契約期間の満了日の1ヶ月前までにご連絡ください。プリペイドプランは1ヶ月ごとの自動更新で、次の契約更新日の14日前までのご連絡で終了できます。お支払いは毎月の前払いで、お支払い済みの料金は返金しません。' },
	{ q: 'データを取り出せますか。', a: 'コンタクト、会社、商談をCSVで書き出せます。ご契約終了日から30日間も書き出せます。自社のデータは自社のものです。' },
	{ q: 'いま使っているCRMからデータを移行できますか。', a: 'Revenue CRMは、CRMの運用に専任の担当者を置きにくい組織のために作っています。Salesforce・HubSpotなどを専任の担当者が運用している場合は、乗り換えではなく、そのツールを活かした導入・運用支援をご提案します。HubSpotのデータは、置き換えずに読み取って取り込めます。' },
];

const readings = [
	{ href: '/insights/why-crm-adoption-fails/', title: 'CRMが定着しない本当の理由' },
	{ href: '/insights/why-companies-cannot-stop-using-excel-after-crm/', title: 'CRMを導入してもExcelが止まらない理由' },
	{ href: '/insights/why-sfa-becomes-just-a-pipeline-sheet/', title: 'SFAがパイプライン管理表になってしまう理由' },
	{ href: '/insights/what-changes-in-crm-design-when-ai-writes-records/', title: 'AIが記録を書くようになると、CRM設計は何が変わるか' },
];

---

<BaseLayout
	title="AIが代わりに働く。入力がめんどくさくない顧客管理ツール（CRM・SFA）| Revenue CRM"
	description="AIが代わりに働く、入力がめんどくさくない顧客管理ツール「Revenue CRM」。名刺は撮るだけ、商談メモは貼るだけ、議事録は自動で入る。AIが記録の下書きを作ります。マーケティング・営業・顧客管理を一つの顧客データでつなぐ中小企業向けのCRM/SFA（顧客管理・営業支援・営業管理ツール）。B2B・支援会社／受託開発・代理店・スクールの4エディション。1アカウント月額3,000円（税抜）、30日間無料。"
	ogImage="/images/og/crm-ja-2026b.png"
	lang="ja"
	alternateUrl="/en/crm/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "Revenue CRM",
	"alternateName": ["レベニューCRM"],
	"applicationCategory": "BusinessApplication",
	"applicationSubCategory": "CRM/SFA（顧客管理・営業支援ツール）",
	"keywords": "CRM, SFA, 顧客管理ツール, 営業支援ツール, 営業管理, 中小企業, 入力しない, AI",
	"operatingSystem": "Web",
	"url": "https://consilegy.com/crm/",
	"description": "入力がめんどくさくない顧客管理ツール「Revenue CRM」。名刺は撮るだけ、商談メモは貼るだけ、議事録は自動で入る。AIが記録の下書きを作る。マーケティング（MA）・営業（SFA）・顧客管理（CRM）を一つの顧客データでつなぐ中小企業向けのCRM/SFA（顧客管理・営業支援ツール）。B2B、支援会社・受託開発、代理店（SaaSリセラー）とスクール（B2C）の4エディション。B2B・受託開発・代理店には175本の自動化と用途別の初期設定付き。2026年9月28日正式提供開始。",
	"inLanguage": ["ja", "en", "zh-Hant"],
	"offers": {
		"@type": "Offer",
		"price": "3000",
		"priceCurrency": "JPY",
		"description": "ユーザープラン1人あたり月額3,000円（税抜）。生徒数プランは月額9,800円から、プリペイドプランは月額3,000円（燃料100付き）。初期費用なし。30日間の無料トライアル（カード登録不要）。"
	},
	"author": { "@type": "Organization", "name": "Consilegy合同会社", "url": "https://consilegy.com/" }
})} />

<CrmSubnav lang="ja" />

<!-- ===================== HERO（紹介パートナーページと同じ型：左＝法人営業、右＝教室・スクール。下に見出しとCTA） ===================== -->
<section class="hero">
	<div class="hero-split">
		<div class="hero-half hero-half--b2b">
			<div class="hero-half__inner">
				<p class="hero-half__tag">法人営業</p>
				<p class="hero-half__title">営業の記録や報告に、<br />時間を取られている会社に。</p>
				<p class="hero-half__text">商談メモは貼るだけ、議事録は自動で入る。記録の下書きはAIが作り、人は確かめて保存します。</p>
				<a class="btn hero-half__btn" href="/crm/features/">法人営業版を見る →</a>
				<img
					class="hero-half__shot"
					src="/images/crm/screen-dashboard-2026-10c.webp"
					alt="Revenue CRMのダッシュボード。パイプライン総額・加重フォーキャスト・勝率・期限切れタスク・ステージ別パイプライン・注目の商談を一画面に表示。"
					width="1600"
					height="1000"
					decoding="async"
					fetchpriority="high"
				/>
			</div>
		</div>
		<div class="hero-half hero-half--school">
			<div class="hero-half__inner">
				<p class="hero-half__tag">教室・スクール</p>
				<p class="hero-half__title">生徒の管理を、LINEと<br />スプレッドシートで回している教室に。</p>
				<p class="hero-half__text">生徒とのやりとりは公式LINEのまま。課題はLINEで届き、生徒ごとに自動で残ります。</p>
				<a class="btn hero-half__btn" href="/crm/school/">スクール版を見る →</a>
				<img
					class="hero-half__shot"
					src="/images/crm/school/screen-students-v3.webp"
					alt="Revenue CRMスクール版の生徒管理。生徒ごとの課題の提出状況とLINEの返信状況を一覧で表示。"
					width="1200"
					height="750"
					decoding="async"
				/>
			</div>
		</div>
	</div>
	<div class="container hero-base">
		<div class="hero-copy">
			<p class="hero-eyebrow"><img src="/images/crm/logo/revenue-crm-logo-v3.svg" alt="" width="22" height="22" decoding="async" />Revenue CRM</p>
			<h1><span class="hero-h1__lead">AIが代わりに働く。</span><br />入力がめんどくさくない顧客管理ツール。</h1>
			<p class="hero-lead">名刺を撮る、声で話す、議事録を貼る。記録はAIが作ります。</p>
		</div>
		<div class="hero-cta">
			<div class="hero-actions">
				<a href={SIGNUP_URL} class="btn btn--cta btn--lg" target="_blank" rel="noopener noreferrer">無料で始める</a>
				<a href={DEMO_URL} class="btn btn--outline-dark btn--lg" target="_blank" rel="noopener noreferrer">デモを見る</a>
			</div>
			<p class="hero-download"><a href="/crm/download/" class="btn btn--outline-dark btn--lg">資料をダウンロード</a></p>
			<p class="hero-proof">1人あたり月額<strong>3,000円〜</strong><span class="hero-proof__sep">・</span>30日間無料<span class="hero-proof__sep">・</span>カード登録不要</p>
		</div>
	</div>
</section>

<!-- ===================== ASSURANCE（一文：CRMが人のために働く） ===================== -->
<section class="assurance">
	<div class="container">
		<div class="assurance-inner">
			<p class="section-eyebrow">Why It Works</p>
			<h2>人がCRMのために働くのではなく、<br />CRMが人のために働く。</h2>
			<p class="assurance-body">
CRMを開きたくない人のためのCRMです。記録はAIが作り、人は確かめて保存するだけ。
マーケティング・営業・顧客管理を一つの顧客データでつなぐ、中小企業向けのCRM／SFA（顧客管理・営業支援ツール）です。
			</p>
		</div>
	</div>
</section>

<!-- ===================== PROBLEMS（3か月後、スプレッドシートに戻る） ===================== -->
<section class="why" id="problems">
	<div class="container">
		<header class="problems-overview">
			<div class="why-head">
				<p class="section-eyebrow">Common Problems</p>
				<h2>CRMを入れて3か月。<br /><span class="text-primary">チームは、Excelに戻る。</span></h2>
				<p class="section-lead">立ち上げるのは簡単。難しいのは、使い続けてもらうこと。</p>
			</div>
			<blockquote class="problem-example">
				<p>CRMは安くありません。<br />誰も使わないCRMに払い続けるのは、<strong>大きな無駄</strong>です。</p>
			</blockquote>
		</header>
		<div class="problem-rows">
			{problems.map((item) => (
				<article class="problem-row">
					<div><p class="problem-topic">{item.topic}</p><h3 set:html={item.problem} /></div>
					<div class="problem-response"><p class="problem-topic">Revenue CRMでは</p><p>{item.answer}</p></div>
				</article>
			))}
		</div>
		<p class="problems-more"><a href="/crm/features/" class="btn btn--outline-primary">機能一覧を見る（全{featureCount()}項目）→</a></p>
	</div>
</section>

<!-- ===================== AFTER（使われると、こう変わる）＋費用の目安 ===================== -->
<section class="how" id="benefits">
	<div class="container">
		<header class="sub-head">
			<p class="section-eyebrow">After</p>
			<h2>使われると、こう変わります。</h2>
		</header>
		<div class="after-list">
			{afters.map((item) => (
				<article class="after-item">
					<h3>{item.title}</h3>
					<p class="result-metric"><strong>{item.figure}<span>{item.unit}</span></strong><span class="result-metric__note">{item.note}</span></p>
					<p>{item.text}</p>
				</article>
			))}
		</div>
		<div class="service-summary" id="pricing">
			<h3>費用の目安</h3>
			<dl>
				{plans.map((plan) => (
					<div><dt>{plan.tier}</dt><dd><strong>{plan.figure}</strong> {plan.unit}<br />{plan.for}</dd></div>
				))}
			</dl>
			<p>初期費用なし。どのプランも30日間の無料トライアル付きで、カード登録なしで始められます。価格は税抜です。</p>
			<p class="service-summary__links"><a href="/crm/pricing/">料金の詳細 →</a><a href="/crm/download/">サービス紹介資料（PDF）</a></p>
		</div>
	</div>
</section>

<!-- ===================== EDITIONS（空のCRMは渡さない）＋API＋数字 ===================== -->
<section class="track" id="use-cases">
	<div class="container">
		<header class="section-head track-head">
			<p class="section-eyebrow">Editions</p>
			<h2>空のCRMは渡しません。</h2>
			<p class="section-lead">用途を選ぶと、商談の段階と、よく使う自動化が入った状態から始まります。スクール版はLINEとつながり、生徒はワンタップでレッスンを予約できます。</p>
		</header>
		<ul class="track-list">
			{editions.map((item) => (
				<li class="track-item"><a href={item.href} class="track-who">{item.title}<span class="track-size">{item.noun}を管理 →</span></a></li>
			))}
		</ul>
		<figure class="demo-media">
			<img
				src="/videos/revenue-crm-demo-2026-09.gif"
				alt="Revenue CRMの操作デモ。ダッシュボード・商談カンバン・自動化ライブラリ・AIエージェント・3言語切替を順に操作している。"
				width="800"
				height="585"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>操作デモ：ダッシュボード・商談カンバン・自動化ライブラリ・AIエージェント・3言語切替</figcaption>
		</figure>
		<div class="track-founder">
			<p>
				<strong>APIで、ほぼ何にでもつながります。</strong>
				日本の業務ツールには、外とつながらない「閉じた箱」が多い。Revenue CRMにはAPIがあり、Claude Codeや他のツールから直接操作できます。AIに使うAPIキーは自社のもの（Anthropic / OpenAI / Gemini / Azure OpenAI）を持ち込めます。
			</p>
		</div>
		<p class="supported-tools"><span>数字で見る</span>代表の導入支援 40社以上（個人事業時代からの累計）・自動化 175本・3言語（日本語 / English / 繁體中文）・<a href="https://www.seenews.com.tw/news_data.php?news_id=2325&amp;k_code=A" target="_blank" rel="noopener noreferrer">See News（花蓮視新聞）掲載</a></p>
	</div>
</section>

<!-- ===================== MOBILE（他のLPは components/CrmMobile.astro。文言を変えるときは両方直す） ===================== -->
<section class="mobile" id="mobile">
	<div class="container mobile-inner">
		<div>
			<header class="sub-head">
				<p class="section-eyebrow">Mobile</p>
				<h2>スマートフォンでも、<br />そのまま使えます。</h2>
			</header>
			<dl class="row-list">
				{mobilePoints.map((item) => (
					<div><dt>{item.title}</dt><dd>{item.text}</dd></div>
				))}
			</dl>
		</div>
		<div class="mobile-shots">
			<img src="/images/crm/screen-mobile-dashboard-2026-10c.webp" alt="スマートフォンで開いたRevenue CRMのダッシュボード" width="390" height="844" loading="lazy" decoding="async" />
			<img src="/images/crm/screen-mobile-deals-2026-10c.webp" alt="スマートフォンで開いたRevenue CRMの商談一覧（カンバン表示）" width="390" height="844" loading="lazy" decoding="async" />
		</div>
	</div>
</section>

<!-- ===================== SUPPORT（設定から定着まで）＋SECURITY ===================== -->
<section class="why" id="support">
	<div class="container two-col">
		<div>
			<header class="sub-head">
				<p class="section-eyebrow">Support</p>
				<h2>設定から定着まで、<br />一緒に回します。</h2>
				<p class="section-lead">40社以上のCRMを定着させてきたやり方で入ります。自分で進めるなら、操作動画とヘルプ記事は無料です。</p>
			</header>
			<dl class="row-list row-list--figure">
				{supports.map((item) => (
					<div><dt>{item.tier}<span>{item.figure}</span></dt><dd>{item.text}</dd></div>
				))}
			</dl>
			<p class="row-list__foot">データ移行や外部サービスとの連携は別途お見積り。価格は税抜です。<a href="/crm/pricing/#support">支援の詳細 →</a></p>
		</div>
		<div id="security">
			<header class="sub-head">
				<p class="section-eyebrow">Security</p>
