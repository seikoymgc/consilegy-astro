---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { categories, categoryColors, type CategoryKey } from '../content.config';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const featured = notes[0];
const latest = notes.slice(1, 7);

const byCategory = (Object.keys(categories) as CategoryKey[]).map(key => ({
	key,
	label: categories[key],
	color: categoryColors[key],
	items: notes.filter(n => n.data.category === key).slice(0, 3),
}));
---

<BaseLayout
	title="Consilegy Media | B2Bの収益のつまずきを、構造から解決する"
	description="CRMが定着しない、商談が読めない、数字が合わない、MAが成果につながらない。B2Bの収益にまつわる悩みを、原因の構造から解決手順まで解説する教育メディアです。"
>
	<div class="masthead">
		<div class="container">
			<p class="masthead__copy">B2Bの収益のつまずきを、構造から解決する</p>
			<nav class="cat-nav" aria-label="カテゴリ">
				{
					(Object.keys(categories) as CategoryKey[]).map(key => (
						<a href={`/notes/category/${key}/`} style={`--cat-color: ${categoryColors[key]};`}>
							{categories[key]}
						</a>
					))
				}
			</nav>
		</div>
	</div>

	{
		notes.length === 0 ? (
			<section class="section">
				<div class="container">
					<p class="empty">最初の記事を準備中です。公開までしばらくお待ちください。</p>
				</div>
			</section>
		) : (
			<>
				<section class="section">
					<div class="container">
						<div class="top-grid">
							{featured && (
								<div class="top-grid__featured">
									<p class="section-label">Pickup</p>
									<ArticleCard
										href={`/notes/${featured.id}/`}
										title={featured.data.title}
										description={featured.data.description}
										categoryLabel={categories[featured.data.category]}
										color={categoryColors[featured.data.category]}
										date={featured.data.publishedAt}
										large
									/>
								</div>
							)}
							<div class="top-grid__latest">
								<p class="section-label">新着記事</p>
								<div class="card-grid card-grid--dense">
									{latest.map(n => (
										<ArticleCard
											href={`/notes/${n.id}/`}
											title={n.data.title}
											categoryLabel={categories[n.data.category]}
											color={categoryColors[n.data.category]}
											date={n.data.publishedAt}
										/>
									))}
								</div>
							</div>
						</div>
					</div>
				</section>

				{byCategory
					.filter(c => c.items.length > 0)
					.map(c => (
						<section class="section section--cat">
							<div class="container">
								<div class="cat-head">
									<h2 style={`--cat-color: ${c.color};`}>{c.label}</h2>
									<a href={`/notes/category/${c.key}/`}>一覧へ →</a>
								</div>
								<div class="card-grid">
									{c.items.map(n => (
										<ArticleCard
											href={`/notes/${n.id}/`}
											title={n.data.title}
											description={n.data.description}
											categoryLabel={c.label}
											color={c.color}
											date={n.data.publishedAt}
										/>
									))}
								</div>
							</div>
						</section>
					))}
			</>
		)
	}

	<section class="section">
		<div class="container">
			<div class="foundation">
				<div>
					<p class="section-label">土台になる考え方</p>
					<p class="foundation__text">
						個別の解決策の土台には、収益を構造として設計する考え方があります。全体像は本体サイトで解説しています。
					</p>
				</div>
				<div class="foundation__links">
					<a href="https://consilegy.com/revenue-architecture/">レベニューアーキテクチャとは ↗</a>
					<a href="https://consilegy.com/about-revops/">RevOps再設計とは ↗</a>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.masthead {
		background: var(--color-surface);
		border-bottom: 1px solid var(--color-border);
		padding-block: 1.25rem 0;
	}

	.masthead__copy {
		font-size: 0.82rem;
		color: var(--color-text-muted);
	}

	.cat-nav {
		margin-top: 0.9rem;
		display: flex;
		gap: 1.5rem;
		overflow-x: auto;
		padding-bottom: 0;
		-ms-overflow-style: none;
		scrollbar-width: none;
	}

	.cat-nav::-webkit-scrollbar {
		display: none;
	}

	.cat-nav a {
		flex-shrink: 0;
		font-size: 0.82rem;
		font-weight: 500;
		color: var(--color-text);
		padding-block: 0.6rem 0.75rem;
		border-bottom: 2px solid transparent;
	}

	.cat-nav a:hover {
		text-decoration: none;
		border-bottom-color: var(--cat-color);
	}

	.section {
		padding-block: 2.5rem;
	}

	.section--cat {
		padding-block: 1.5rem;
	}

	.section-label {
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-text-muted);
		margin-bottom: 0.9rem;
	}

	.top-grid {
		display: grid;
		grid-template-columns: 5fr 7fr;
		gap: 2rem;
		align-items: start;
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1rem;
	}

	.card-grid--dense {
		grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
	}

	.cat-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: 1rem;
	}

	.cat-head h2 {
		font-size: 1.05rem;
		padding-left: 0.75rem;
		border-left: 4px solid var(--cat-color);
	}

	.cat-head a {
		font-size: 0.8rem;
	}

	.foundation {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		justify-content: space-between;
		align-items: center;
		padding: 1.75rem 2rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 12px;
	}

	.foundation__text {
		font-size: 0.85rem;
		color: var(--color-text-muted);
		max-width: 480px;
	}

	.foundation__links {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.88rem;
		font-weight: 500;
	}

	.empty {
		font-size: 0.9rem;
		color: var(--color-text-muted);
	}

	@media (max-width: 860px) {
		.top-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
