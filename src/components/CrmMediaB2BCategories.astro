---
import { B2B_CATEGORIES, type Article } from '../lib/crm-media';
interface Props { a: Article }
const { a } = Astro.props;
const categories = a.data.segment === 'b2b' ? a.data.b2b_categories ?? [] : [];
---
{categories.length > 0 && <div class="b2b-categories"><span>{a.data.lang === 'ja' ? '対象：' : 'For: '}</span>{categories.map((id, i) => <><span>{i > 0 && ' / '}{B2B_CATEGORIES[id][a.data.lang]}</span></>)}</div>}
<style>
  .b2b-categories { margin:0 0 .75rem; color:var(--color-text-muted); font-size:.875rem; line-height:1.7; overflow-wrap:anywhere; }
</style>
