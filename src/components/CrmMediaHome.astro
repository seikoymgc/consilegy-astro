---
// /crm/media/ の入口。
// 配置: タグライン → 読者のナビ → 新着記事（大きいカード3枚） → 読者×カテゴリのブロック（小さい行3本＋もっと見る）。
import BaseLayout from '../layouts/BaseLayout.astro';
import CrmMediaCard from './CrmMediaCard.astro';
import CrmMediaRow from './CrmMediaRow.astro';
import {
  CATEGORIES, CATEGORY_ORDER, COPY, SEGMENTS, SEGMENT_ORDER,
  crmMediaArticles, mediaPath, mediaRoot, type Lang,
} from '../lib/crm-media';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = COPY[lang];
const all = await crmMediaArticles(lang);
const latest = all.slice(0, 3);

// 読者 × カテゴリ。記事が無い組は出さない。
const blocks = SEGMENT_ORDER.flatMap((segment) =>
  CATEGORY_ORDER.map((category) => ({
    segment,
    category,
    list: all.filter((a) => a.data.segment === segment && a.data.category === category).slice(0, 3),
  })),
).filter((b) => b.list.length > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t.homeMetaTitle,
  description: t.homeMetaDesc,
  inLanguage: lang,
  url: new URL(mediaRoot(lang), Astro.site ?? 'https://consilegy.com').href,
  about: { '@type': 'SoftwareApplication', name: 'Revenue CRM', url: 'https://consilegy.com/crm/' },
};
---

<BaseLayout chrome="media" title={t.homeMetaTitle} description={t.homeMetaDesc} lang={lang} alternateUrl={mediaRoot(lang === 'ja' ? 'en' : 'ja')}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="media-page">
    <div class="main">
    <header class="media-head">
      <h1>{t.homeTitle}</h1>
      <p class="lead">{t.homeLead}</p>
    </header>

    {latest.length > 0 && (
      <section class="latest">
        <h2 class="rule"><span>{t.latest}</span></h2>
        <div class="cards">{latest.map((a) => <CrmMediaCard a={a} />)}</div>
      </section>
    )}

    {blocks.length > 0 && (
      <section class="blocks">
        {blocks.map(({ segment, category, list }) => (
          <div class="block">
            <h2 class="rule">
              <span>
                <small>{SEGMENTS[segment][lang]}</small>
                {CATEGORIES[category][lang]}
              </span>
            </h2>
            <ul class="rows">{list.map((a) => <li><CrmMediaRow a={a} /></li>)}</ul>
            <p class="more"><a href={`${mediaPath(lang, segment)}#${category}`}>{t.more}</a></p>
          </div>
        ))}
      </section>
    )}

    <p class="why"><a href="https://media.consilegy.com/">{t.why}</a></p>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* 使い方メディアは白地。サイト共通の stone-50 を使わない。 */
  html { background: #fff; }
</style>

<style>
  .media-page { max-width:72rem; margin:0 auto; padding:3.5rem 1.25rem 5rem; }
  .main { min-width:0; }
  .media-head { max-width:52rem; margin:0 0 3.5rem; }
  h1 { font-size:clamp(2rem,4vw,3rem); line-height:1.4; letter-spacing:-.035em; color:var(--color-navy); margin:0 0 1.5rem; font-weight:800; text-wrap:balance; }
  .lead { max-width:46rem; margin:0; line-height:1.9; color:var(--color-text-muted); }
  .rule { margin:0 0 1.5rem; color:var(--color-navy); font-size:1.5rem; font-weight:700; line-height:1.5; }
  .rule span { display:flex; flex-direction:column; align-items:flex-start; gap:.35rem; }
  .rule small { font-size:.875rem; font-weight:500; color:var(--color-text-muted); }
  .latest { padding-bottom:3.5rem; margin-bottom:3.5rem; border-bottom:1px solid var(--color-border); }
  .cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; }
  .blocks { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:3rem; }
  .block { padding:1.75rem; background:var(--color-bg-subtle); border:1px solid var(--color-border); border-radius:6px; }
  .rows { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:1.5rem; }
  .more { margin:1.5rem 0 0; } .more a { display:inline-flex; padding:.5rem 0; font-weight:600; color:var(--color-primary); text-underline-offset:4px; }
  .why { margin-top:4rem; color:var(--color-text-muted); } .why a { color:inherit; }
  @media(max-width:800px) { .cards { grid-template-columns:repeat(2,minmax(0,1fr)); } .blocks { grid-template-columns:minmax(0,1fr); } }
  @media(max-width:600px) { .media-page { padding-top:2rem; } .media-head { margin-bottom:2.5rem; } .cards { grid-template-columns:minmax(0,1fr); } .block { padding:1.25rem; } }

</style>
