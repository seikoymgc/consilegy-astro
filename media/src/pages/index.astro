---
import '../styles/journal-home.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, type CategoryKey } from '../content.config';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const lead = notes[0];
const secondary = notes.slice(1, 4);
const rest = notes.slice(4, 12);

const recommended = notes.slice(12, 17);

const fmt = (d: Date) =>
	`${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
	title="B2Bレベニュー戦略ジャーナル | マーケティング・営業・CRMから考える、B2Bの売上設計"
	description="CRMが定着しない、商談が読めない、数字が合わない、MAが成果につながらない。B2Bの収益にまつわる悩みを、原因の構造から解決手順まで解説する教育メディアです。"
	jaPath="/"
	enPath="/en/"
>
	<div class="wrap edition-line"><h1>現場の知見を、次の判断に。</h1><span>REVENUE / OPERATIONS / STRATEGY</span></div>

	{
		notes.length === 0 ? (
			<div class="wrap"><p class="empty">最初の記事を準備中です。</p></div>
		) : (
			<>
				<section class="wrap hero">
					{lead && (
						<a href={`/notes/${lead.id}/`} class="lead"><span class="feature-label">LATEST INSIGHT</span>
							<img src={`/images/eyecatch/${lead.id}.webp`} alt="" width="1200" height="630" fetchpriority="high" decoding="async" />
							<p class="kicker">{categories[lead.data.category]}</p>
							<h2 class="lead-title">{lead.data.title}</h2>
							<p class="lead-desc">{lead.data.description}</p>
							<time class="date" datetime={lead.data.publishedAt.toISOString()}>{fmt(lead.data.publishedAt)}</time>
						</a>
					)}
					<div class="hero-side"><p class="side-heading">RECENT ARTICLES</p>
						{secondary.map(n => (
							<a href={`/notes/${n.id}/`} class="sec">
								<img src={`/images/eyecatch/${n.id}.webp`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
								<p class="kicker">{categories[n.data.category]}</p>
								<h3 class="sec-title">{n.data.title}</h3>
								<time class="date" datetime={n.data.publishedAt.toISOString()}>{fmt(n.data.publishedAt)}</time>
							</a>
						))}
					</div>
				</section>


				<section class="wrap topic-directory" aria-labelledby="topics-heading">
					<div class="topic-intro"><span>EXPLORE TOPICS</span><h2 id="topics-heading">課題から、知見を探す</h2></div>
					<div class="topic-grid">{(Object.keys(categories) as CategoryKey[]).map((key, i) => <a href={`/notes/category/${key}/`}><span class="topic-number">0{i + 1}</span><span>{categories[key]}</span><span aria-hidden="true">↗</span></a>)}</div>
				</section>
				<div class="wrap main-grid">
					<section class="latest">
						<h2 class="rail-head"><small>LATEST ARTICLES</small>新着記事</h2>
						<ul>
							{rest.map(n => (
								<li>
									<a href={`/notes/${n.id}/`}>
										<img src={`/images/eyecatch/${n.id}.webp`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
										<div>
											<p class="kicker">{categories[n.data.category]}</p>
											<h3 class="row-title">{n.data.title}</h3>
											<p class="row-desc">{n.data.description}</p>
											<time class="date" datetime={n.data.publishedAt.toISOString()}>{fmt(n.data.publishedAt)}</time>
										</div>
									</a>
								</li>
							))}
						</ul>
						<a href="/notes/" class="more">すべての記事を見る →</a>
					</section>

					<aside class="rail">
						<section class="rail-box">
							<h2 class="rail-head"><small>MORE INSIGHTS</small>あわせて読みたい</h2>
							<ol class="rank">
								{recommended.map(n => (
									<li>
										<a href={`/notes/${n.id}/`}>
											<span class="num" />
											<span>{n.data.title}</span>
										</a>
									</li>
								))}
							</ol>
						</section>

						<section class="rail-box promo">
							<p class="promo-lead">収益の取りこぼしを診断</p>
							<p class="promo-text">CRM・商談・データの現状から、どこで売上を落としているかを3分で。</p>
							<a href="https://consilegy.com/diagnostic/" class="promo-btn">無料で診断する</a>
						</section>

						<section class="rail-box">
							<h2 class="rail-head"><small>ABOUT THIS JOURNAL</small>売上の課題を、構造から。</h2>
							<p class="run">
								本メディアは、B2BのRevOps・Revenue Architecture設計を手がける
								<a href="https://consilegy.com/">Consilegy合同会社</a>が運営しています。
							</p>
						</section>
					</aside>
				</div>
			</>
		)
	}
</BaseLayout>
