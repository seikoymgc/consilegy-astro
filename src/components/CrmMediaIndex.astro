---
// /crm/media/<segment>/ の一覧。読者（法人営業 / スクール・教室）ごとに1ページ。カテゴリ3つの順に並べる。
import BaseLayout from '../layouts/BaseLayout.astro';
import CrmMediaCard from './CrmMediaCard.astro';
import CrmMediaSegmentTabs from './CrmMediaSegmentTabs.astro';
import { CATEGORIES, CATEGORY_ORDER, COPY, SEGMENTS, crmMediaArticles, mediaPath, type Lang, type Segment } from '../lib/crm-media';

interface Props { lang: Lang; segment: Segment }
const { lang, segment } = Astro.props;
const t = COPY[lang];
const sg = SEGMENTS[segment];
const title = lang === 'ja' ? sg.jaTitle : sg.enTitle;
const lead = lang === 'ja' ? sg.jaLead : sg.enLead;
const metaTitle = lang === 'ja' ? sg.jaMetaTitle : sg.enMetaTitle;
const metaDesc = lang === 'ja' ? sg.jaMetaDesc : sg.enMetaDesc;
const all = await crmMediaArticles(lang, segment);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: metaTitle,
  description: metaDesc,
  inLanguage: lang,
  url: new URL(mediaPath(lang, segment), Astro.site ?? 'https://consilegy.com').href,
  about: { '@type': 'SoftwareApplication', name: 'Revenue CRM', url: 'https://consilegy.com/crm/' },
};
---

<BaseLayout chrome="media" title={metaTitle} description={metaDesc} lang={lang} alternateUrl={mediaPath(lang === 'ja' ? 'en' : 'ja', segment)}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="media-page">
    <div class="main">
    <header class="media-head">
      <p class="kicker">{t.kicker}</p>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
    </header>

    <CrmMediaSegmentTabs lang={lang} current={segment} />

    {CATEGORY_ORDER.map((c) => {
      const list = all.filter((a) => a.data.category === c);
      if (list.length === 0) return null;
      return (
        <section class="media-group" id={c}>
          <h2>{CATEGORIES[c][lang]}</h2>
          <p class="group-lead">{CATEGORIES[c].lead[segment][lang]}</p>
          <div class="cards">{list.map((a) => <CrmMediaCard a={a} />)}</div>
        </section>
      );
    })}

    <p class="why"><a href="https://media.consilegy.com/">{t.why}</a></p>
    </div>
  </div>
</BaseLayout>

<style is:global>
  /* 使い方メディアは白地。サイト共通の stone-50 を使わない。 */
  html { background: #fff; }
</style>

<style>
  .media-page { max-width:72rem; margin:0 auto; padding:3rem 1.25rem 5rem; }
  .main { min-width:0; }
  .media-head { max-width:52rem; margin-bottom:2rem; }
  .kicker { margin:0 0 .75rem; font-size:.875rem; font-weight:700; color:var(--color-text-muted); letter-spacing:.1em; text-transform:uppercase; }
  h1 { font-size:clamp(2rem,4vw,3rem); line-height:1.4; margin:0 0 1.25rem; letter-spacing:-.035em; font-weight:800; color:var(--color-navy); text-wrap:balance; }
  .lead { margin:0; line-height:1.9; color:var(--color-text-muted); }
  .media-group { margin-top:3.5rem; padding-top:2.5rem; border-top:1px solid var(--color-border); scroll-margin-top:2rem; }
  .media-group h2 { margin:0 0 .75rem; font-size:1.75rem; color:var(--color-navy); font-weight:700; }
  .group-lead { margin:0 0 1.75rem; max-width:46rem; line-height:1.8; color:var(--color-text-muted); }
  .cards { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:1.5rem; }
  .why { margin-top:3.5rem; } .why a { color:var(--color-text-muted); }
  @media(max-width:800px) { .cards { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media(max-width:600px) { .media-page { padding-top:2rem; } .cards { grid-template-columns:minmax(0,1fr); } }

</style>
