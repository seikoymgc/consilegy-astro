---
import '../styles/global.css';

interface Crumb {
	name: string;
	url?: string;
}

interface Props {
	title: string;
	description: string;
	ogType?: 'website' | 'article';
	noindex?: boolean;
	publishedAt?: Date;
	updatedAt?: Date;
	lang?: 'ja' | 'en';
	ogImage?: string;
	/** 対になる日本語ページのパス。無い場合は hreflang を出さない */
	jaPath?: string;
	/** 対になる英語ページのパス。無い場合は hreflang を出さない */
	enPath?: string;
	/** パンくず。先頭から順に並べる。最後の要素は url 省略可 */
	breadcrumbs?: Crumb[];
	/** Article schema の articleSection に入れるカテゴリ名 */
	section?: string;
	/** Article schema の headline。省略時は title（サイト名付き）を使う */
	headline?: string;
}

const {
	title,
	description,
	ogType = 'website',
	noindex = false,
	publishedAt,
	updatedAt,
	lang = 'ja',
	ogImage: ogImageProp,
	jaPath,
	enPath,
	breadcrumbs,
	section,
	headline,
} = Astro.props;
const isEn = lang === 'en';

const site = Astro.site ?? new URL('https://media.consilegy.com');
const abs = (path: string) => new URL(path, site).href;
const canonical = abs(Astro.url.pathname);
const ogImage = abs(ogImageProp ?? '/images/og-default.png');

// hreflang: 日英の対になるURLが両方揃っているときだけ出す。
// 片側しか無い状態で出すと相互参照にならず、Googleに無視される。
const hasPair = Boolean(jaPath && enPath);

const organizationSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': 'https://consilegy.com/#organization',
	name: 'Consilegy合同会社',
	alternateName: 'Consilegy LLC',
	url: 'https://consilegy.com',
	sameAs: ['https://www.linkedin.com/company/consilegy', 'https://note.com/consilegy'],
	founder: {
		'@type': 'Person',
		'@id': 'https://consilegy.com/company/#founder',
		name: '山口 聖子',
		alternateName: 'Seiko Yamaguchi',
		jobTitle: 'Founder / Revenue Architect',
		sameAs: ['https://www.linkedin.com/company/consilegy', 'https://note.com/consilegy'],
	},
};

const articleSchema =
	ogType === 'article'
		? {
				'@context': 'https://schema.org',
				'@type': 'Article',
				headline: headline ?? title,
				description,
				url: canonical,
				mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
				image: [ogImage],
				inLanguage: isEn ? 'en' : 'ja',
				...(section ? { articleSection: section } : {}),
				datePublished: publishedAt?.toISOString(),
				dateModified: (updatedAt ?? publishedAt)?.toISOString(),
				author: {
					'@type': 'Person',
					'@id': 'https://consilegy.com/company/#founder',
					name: '山口 聖子',
					alternateName: 'Seiko Yamaguchi',
					url: isEn ? abs('/en/about/') : abs('/about/'),
				},
				publisher: { '@id': 'https://consilegy.com/#organization' },
				isPartOf: {
					'@type': 'Blog',
					'@id': isEn ? abs('/en/') : abs('/'),
					name: 'Consilegy Media',
				},
			}
		: null;

// 記事の isPartOf が指している Blog ノードを、トップページ側で実際に定義する。
// 定義しないと @id の参照先が存在せず、構造化データのグラフがつながらない。
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/en/';
const blogSchema = isHome
	? {
			'@context': 'https://schema.org',
			'@graph': [
				{
					'@type': 'WebSite',
					'@id': `${abs('/')}#website`,
					url: abs('/'),
					name: 'Consilegy Media',
					inLanguage: isEn ? 'en' : 'ja',
					publisher: { '@id': 'https://consilegy.com/#organization' },
				},
				{
					'@type': 'Blog',
					'@id': canonical,
					url: canonical,
					name: 'Consilegy Media',
					description,
					inLanguage: isEn ? 'en' : 'ja',
					isPartOf: { '@id': `${abs('/')}#website` },
					publisher: { '@id': 'https://consilegy.com/#organization' },
					author: { '@id': 'https://consilegy.com/company/#founder' },
				},
			],
		}
	: null;

const breadcrumbSchema =
	breadcrumbs && breadcrumbs.length > 1
		? {
				'@context': 'https://schema.org',
				'@type': 'BreadcrumbList',
				itemListElement: breadcrumbs.map((crumb, i) => ({
					'@type': 'ListItem',
					position: i + 1,
					name: crumb.name,
					...(crumb.url ? { item: abs(crumb.url) } : {}),
				})),
			}
		: null;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		{
			hasPair && (
				<>
					<link rel="alternate" hreflang="ja" href={abs(jaPath!)} />
					<link rel="alternate" hreflang="en" href={abs(enPath!)} />
					<link rel="alternate" hreflang="x-default" href={abs(jaPath!)} />
				</>
			)
		}

		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content={isEn ? 'en_US' : 'ja_JP'} />
		{hasPair && <meta property="og:locale:alternate" content={isEn ? 'ja_JP' : 'en_US'} />}
		<meta property="og:site_name" content="Consilegy Media" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@600;700&display=swap"
		/>
		<link rel="icon" type="image/svg+xml" href="/favicon-2026.svg" />
		{
			isEn ? (
				<link rel="alternate" type="application/rss+xml" title="Consilegy Media (English)" href="/en/rss.xml" />
			) : (
				<link rel="alternate" type="application/rss+xml" title="Consilegy Media" href="/rss.xml" />
			)
		}

		<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
		{blogSchema && <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} />}
		{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
		{breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
		<slot name="head" />
	</head>
	<body>
		<header class="site-header">
			<div class="container site-header__inner">
				<a href="/" class="site-brand">
					<img src="/images/consilegy-logo-2026.svg" alt="Consilegy" width="150" height="26" />
					<span class="site-brand__tag">MEDIA</span>
				</a>
				<nav class="site-nav" aria-label={isEn ? 'Site navigation' : 'サイト内ナビゲーション'}>
					{isEn ? (
						<>
							<a href="/en/">Articles</a>
							<a href="https://consilegy.com/en/">Consilegy ↗</a>
							<a href="/">日本語</a>
							<a href="https://consilegy.com/en/contact-en/" class="site-nav__btn">Talk to us</a>
						</>
					) : (
						<>
							<a href="/notes/">記事一覧</a>
							<a href="https://consilegy.com/" class="site-nav__ext">運営会社 ↗</a>
							<a href="/en/">EN</a>
							<a href="https://consilegy.com/contact/" class="site-nav__btn">お問い合わせ</a>
						</>
					)}
				</nav>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			{isEn ? (
				<div class="container site-footer__cols">
					<div>
						<p class="site-footer__brand">Consilegy Media</p>
						<p class="site-footer__desc">Practical education on B2B revenue operations, from a consultancy working across Japanese and global companies.</p>
					</div>
					<nav aria-label="Articles">
						<p class="site-footer__head">Read</p>
						<a href="/en/">All articles</a>
						<a href="/en/about/">Author</a>
						<a href="/en/rss.xml">RSS</a>
						<a href="/">日本語版</a>
					</nav>
					<nav aria-label="Company">
						<p class="site-footer__head">Consilegy</p>
						<a href="https://consilegy.com/en/">Corporate site</a>
						<a href="https://consilegy.com/en/services-en/japan-market-gtm-messaging/">Japan Market GTM</a>
						<a href="https://consilegy.com/en/contact-en/">Contact</a>
					</nav>
				</div>
			) : (
				<div class="container site-footer__cols">
					<div>
						<p class="site-footer__brand">Consilegy Media</p>
						<p class="site-footer__desc">B2Bの収益のつまずきを、構造から解決する教育メディア。運営はConsilegy合同会社。</p>
					</div>
					<nav aria-label="カテゴリ">
						<p class="site-footer__head">カテゴリ</p>
						<a href="/notes/category/crm/">CRM・SFAが定着しない</a>
						<a href="/notes/category/sales/">商談が進まない・受注が読めない</a>
						<a href="/notes/category/data/">数字が部署ごとに合わない</a>
						<a href="/notes/category/japan-gtm/">日本市場で成果が出ない</a>
						<a href="/notes/category/adoption/">導入したのに使われない</a>
						<a href="/notes/category/marketing/">リードが商談につながらない</a>
					</nav>
					<nav aria-label="サイト">
						<p class="site-footer__head">サイト</p>
						<a href="/notes/">記事一覧</a>
						<a href="/about/">著者について</a>
						<a href="/en/">English edition</a>
						<a href="/rss.xml">RSS</a>
					</nav>
					<nav aria-label="Consilegy">
						<p class="site-footer__head">Consilegy</p>
						<a href="https://consilegy.com/">本体サイト</a>
						<a href="https://consilegy.com/revenue-architecture/">レベニューアーキテクチャとは</a>
						<a href="https://consilegy.com/diagnostic/">収益構造の無料診断</a>
						<a href="https://consilegy.com/newsletter/">ニュースレター</a>
						<a href="https://consilegy.com/free-consultation/">無料相談</a>
					</nav>
				</div>
			)}
			<div class="container site-footer__bottom">
				<p>&copy; 2025 Consilegy LLC.</p>
			</div>
		</footer>
	</body>
</html>
