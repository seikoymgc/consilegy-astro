---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categoriesEn, type CategoryKey } from '../../../content.config';

const notes = (await getCollection('notesEn', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const counts = Object.keys(categoriesEn).reduce<Record<string, number>>((acc, key) => {
	acc[key] = notes.filter(n => n.data.category === key).length;
	return acc;
}, {});

const formatDate = (d: Date) =>
	d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
	lang="en"
	title="All articles | Consilegy Media"
	description="Every article in the English edition, scoped to entering and operating in the Japanese market: ringi approval, CRM adoption, sales process, revenue data, and change management. Written from implementation work, with sourced Japanese data throughout."
	jaPath="/notes/"
	enPath="/en/articles/"
	breadcrumbs={[{ name: 'Home', url: '/en/' }, { name: 'All articles' }]}
>
	<section class="page-head">
		<div class="container">
			<p class="eyebrow">Articles</p>
			<h1>All articles</h1>
			<p class="page-lead">
				Written for global SaaS companies and their headquarters, on what changes when
				revenue work has to run in Japan. Not a translation of the Japanese library.
				{notes.length} articles.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<ul class="cat-legend">
				{
					(Object.keys(categoriesEn) as CategoryKey[]).map(key => (
						<li>
							<a href={`/en/category/${key}/`}>
								<span class="cat-label">{categoriesEn[key]}</span>
								<span class="cat-count">{counts[key] ?? 0}</span>
							</a>
						</li>
					))
				}
			</ul>

			{
				notes.length === 0 ? (
					<p class="empty">First articles are in preparation.</p>
				) : (
					<ul class="note-list">
						{notes.map(note => (
							<li>
								<a href={`/en/articles/${note.id}/`} class="note-row">
									<div class="note-meta">
										<time datetime={note.data.publishedAt.toISOString()}>
											{formatDate(note.data.publishedAt)}
										</time>
										<span class="note-cat">{categoriesEn[note.data.category as CategoryKey]}</span>
									</div>
									<div>
										<p class="note-title">{note.data.title}</p>
										<p class="note-desc">{note.data.description}</p>
									</div>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>
</BaseLayout>

<style>
	.page-head {
		padding-block: 3.5rem 2.5rem;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.page-head h1 {
		font-size: clamp(1.4rem, 3vw, 1.9rem);
		margin-top: 0.5rem;
	}

	.page-lead {
		margin-top: 1rem;
		max-width: 660px;
		font-size: 0.92rem;
		color: var(--color-text-muted);
	}

	.section {
		padding-block: 2.5rem 4rem;
	}

	.cat-legend {
		list-style: none;
		margin: 0 0 2.5rem;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.cat-legend a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		background: var(--color-surface);
		font-size: 0.75rem;
		color: var(--color-text);
	}

	.cat-legend a:hover {
		text-decoration: none;
		border-color: var(--color-text-muted);
	}

	.cat-count {
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.note-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--color-border);
	}

	.note-list li {
		border-bottom: 1px solid var(--color-border);
	}

	.note-row {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 1.5rem;
		padding-block: 1.25rem;
		color: var(--color-text);
	}

	.note-row:hover {
		text-decoration: none;
	}

	.note-row:hover .note-title {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.note-meta {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.note-meta time {
		font-variant-numeric: tabular-nums;
	}

	.note-title {
		font-size: 0.98rem;
		font-weight: 500;
		line-height: 1.6;
	}

	.note-desc {
		margin-top: 0.35rem;
		font-size: 0.83rem;
		line-height: 1.8;
		color: var(--color-text-muted);
	}

	.empty {
		font-size: 0.88rem;
		color: var(--color-text-muted);
	}

	@media (max-width: 720px) {
		.note-row {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}

		.note-meta {
			flex-direction: row;
			gap: 0.75rem;
		}
	}
</style>
