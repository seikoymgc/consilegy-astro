---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products } from '../../data/products';

// 製品ショーケース。並べる製品は src/data/products.ts で管理する（製品を足すときはそちらに1件足す）。
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<BaseLayout
	title="製品一覧 | Consilegy"
	description={`Consilegyが作っている製品の一覧です。${products.map((p) => p.name).join('・')}の画面と使い方を紹介します。`}
	lang="ja"
>
<div class="pd-page">

<section class="pd-hero">
	<div class="container">
		<h1>Consilegyの製品</h1>
		<p class="pd-lead">現場で「続かない」「忘れる」を減らすための道具を作っています。実際の画面と、どう使うかをまとめました。</p>
		<nav class="pd-index" aria-label="製品">
			{products.map((p) => <a href={`#${p.slug}`}>{p.name}{p.status && `（${p.status}）`}</a>)}
		</nav>
		<figure class="pd-figure" aria-labelledby="pd-figure-caption">
			<svg class="fig-pc" viewBox="0 0 1120 340" role="img" aria-label="製品の関係図：Revenue CRMと4つのエディション、おたより秘書、支援サービス">
				<g font-family="inherit">
				<rect x="40" y="30" width="1050" height="82" rx="6" fill="#0F172A"/>
				<text x="64" y="60" font-size="14" fill="rgba(255,255,255,0.6)" letter-spacing="1">PRODUCT</text>
				<text x="64" y="92" font-size="22" font-weight="700" fill="#fff">Revenue CRM</text>
				<text x="1066" y="92" font-size="16" fill="rgba(255,255,255,0.8)" text-anchor="end">AIと仕組みが代わりに働く顧客管理システム。用途で4つのエディション</text>
				<rect x="40" y="150" width="236" height="76" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="58" y="183" font-size="17" font-weight="600" fill="#0F172A">B2B版</text><text x="58" y="208" font-size="16" fill="#475569">法人営業</text><line x1="158" y1="112" x2="158" y2="146" stroke="#CBD5E1" stroke-width="2"/><rect x="302" y="150" width="236" height="76" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="320" y="183" font-size="17" font-weight="600" fill="#0F172A">受託開発版</text><text x="320" y="208" font-size="16" fill="#475569">案件・見積・稼働</text><line x1="420" y1="112" x2="420" y2="146" stroke="#CBD5E1" stroke-width="2"/><rect x="564" y="150" width="236" height="76" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="582" y="183" font-size="17" font-weight="600" fill="#0F172A">代理店版</text><text x="582" y="208" font-size="16" fill="#475569">契約・更新</text><line x1="682" y1="112" x2="682" y2="146" stroke="#CBD5E1" stroke-width="2"/><rect x="826" y="150" width="236" height="76" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="844" y="183" font-size="17" font-weight="600" fill="#0F172A">スクール版</text><text x="844" y="208" font-size="16" fill="#475569">生徒・LINE</text><line x1="944" y1="112" x2="944" y2="146" stroke="#CBD5E1" stroke-width="2"/>
				<line x1="158" y1="226" x2="158" y2="266" stroke="#CBD5E1" stroke-width="2"/>
				<line x1="944" y1="226" x2="944" y2="266" stroke="#CBD5E1" stroke-width="2"/>
				<rect x="40" y="266" width="512" height="56" rx="6" fill="#F1F5F9"/>
				<text x="60" y="289" font-size="14" fill="#2563EB" font-weight="600" letter-spacing="1">SERVICES</text>
				<text x="60" y="312" font-size="16" fill="#0F172A">設定・定着・運用の支援。今お使いのシステムの再設計も</text>
				<rect x="578" y="266" width="512" height="56" rx="6" fill="#F1F5F9"/>
				<text x="598" y="289" font-size="14" fill="#2563EB" font-weight="600" letter-spacing="1">ADD-ON</text>
				<text x="598" y="312" font-size="16" fill="#0F172A">おたより秘書：教室のお知らせ配信を手伝う（スクール版）</text>
				</g>
			</svg>
			<svg class="fig-sp" viewBox="0 0 360 570" role="img" aria-label="製品の関係図：Revenue CRMと4つのエディション、おたより秘書、支援サービス">
				<g font-family="inherit">
					<rect x="16" y="20" width="328" height="146" rx="6" fill="#0F172A"/>
					<text x="32" y="46" font-size="14" fill="rgba(255,255,255,0.6)" letter-spacing="1">PRODUCT</text>
					<text x="32" y="76" font-size="22" font-weight="700" fill="#fff">Revenue CRM</text>
					<g font-size="16" fill="rgba(255,255,255,0.8)"><text x="32" y="104">AIと仕組みが代わりに働く</text><text x="32" y="126">顧客管理システム。</text><text x="32" y="148">用途で4つのエディション</text></g>
					<line x1="94" y1="166" x2="94" y2="190" stroke="#CBD5E1" stroke-width="2"/><line x1="266" y1="166" x2="266" y2="190" stroke="#CBD5E1" stroke-width="2"/>
					<rect x="16" y="190" width="156" height="72" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="30" y="220" font-size="17" font-weight="600" fill="#0F172A">B2B版</text><text x="30" y="244" font-size="16" fill="#475569">法人営業</text>
					<rect x="188" y="190" width="156" height="72" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="202" y="220" font-size="17" font-weight="600" fill="#0F172A">受託開発版</text><text x="202" y="244" font-size="16" fill="#475569">案件・見積・稼働</text>
					<rect x="16" y="274" width="156" height="72" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="30" y="304" font-size="17" font-weight="600" fill="#0F172A">代理店版</text><text x="30" y="328" font-size="16" fill="#475569">契約・更新</text>
					<rect x="188" y="274" width="156" height="72" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="202" y="304" font-size="17" font-weight="600" fill="#0F172A">スクール版</text><text x="202" y="328" font-size="16" fill="#475569">生徒・LINE</text>
					<line x1="94" y1="346" x2="94" y2="370" stroke="#CBD5E1" stroke-width="2"/>
					<rect x="16" y="370" width="328" height="84" rx="6" fill="#F1F5F9"/>
					<text x="32" y="394" font-size="14" fill="#2563EB" font-weight="600" letter-spacing="1">SERVICES</text>
					<g font-size="16" fill="#0F172A"><text x="32" y="418">設定・定着・運用の支援。</text><text x="32" y="440">今お使いのシステムの再設計も</text></g>
					<rect x="16" y="470" width="328" height="84" rx="6" fill="#F1F5F9"/>
					<text x="32" y="494" font-size="14" fill="#2563EB" font-weight="600" letter-spacing="1">ADD-ON</text>
					<g font-size="16" fill="#0F172A"><text x="32" y="518">おたより秘書：教室のお知らせ</text><text x="32" y="540">配信を手伝う（スクール版）</text></g>
				</g>
			</svg>
			<figcaption id="pd-figure-caption">中心は Revenue CRM。用途ごとのエディションと、周辺の道具・支援サービスがつながっています。</figcaption>
		</figure>
	</div>
</section>

{products.map((p) => (
	<section class="pd-product" id={p.slug}>
		<div class="container">
			<div class="pd-head">
				<div>
					<h2>{p.name}{p.status && <span class="pd-status">{p.status}</span>}</h2>
					<p class="pd-summary">{p.summary}</p>
					<ul class="pd-facts">
						{p.facts.map((f) => <li>{f}</li>)}
					</ul>
				</div>
				<div class="pd-links">
					{p.links.map((l) => (
						<a
							href={l.href}
							class:list={['btn', l.primary ? 'btn--primary' : 'btn--secondary']}
							{...(isExternal(l.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
						>{l.label}</a>
					))}
				</div>
			</div>

			{p.editions?.map((e) => (
				<div class="pd-edition">
					<div class="pd-edition-head">
						<h3>{e.name}</h3>
						<p>{e.lead}</p>
						<a href={e.href}>{e.name}のページを見る</a>
					</div>
					<div class="pd-screens">
						{e.screens.map((s) => (
							<figure class:list={['pd-screen', { 'pd-screen--phone': s.phone }]}>
								<a href={s.src} target="_blank" rel="noopener">
									<img src={s.src} alt={s.alt} width={s.width} height={s.height} loading="lazy" decoding="async" />
								</a>
								<figcaption>
									<strong>{s.title}</strong>
									<span>{s.desc}</span>
								</figcaption>
							</figure>
						))}
					</div>
				</div>
			))}

			{p.example && (
				<div class="pd-example">
					<div class="pd-chat" aria-label="LINEに返ってくる内容の表示例">
						<pre>{p.example.text}</pre>
					</div>
					<p>{p.example.caption}</p>
				</div>
			)}
		</div>
	</section>
))}

</div>
</BaseLayout>

<style>
	:global(body:has(.pd-page)) { background: #fff; }
	.pd-page { background: #fff; }
	.pd-page p { color: var(--color-text); }

	.pd-hero { padding: var(--space-xl) 0 var(--space-lg); }
	.pd-hero h1 { margin: 0; font-size: clamp(2rem, 3.6vw, 2.75rem); font-weight: 700; line-height: 1.35; color: var(--color-text); }
	.pd-lead { margin: var(--space-sm) 0 0; max-width: 40em; font-size: 1.05rem; line-height: 1.9; }
	.pd-index { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: var(--space-md); }
	.pd-index a { padding: 0.45rem 0.95rem; border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text); font-weight: 600; font-size: 0.95rem; text-decoration: none; }
	.pd-index a:hover { border-color: var(--color-primary); color: var(--color-primary); }

	.pd-product { padding: var(--space-xl) 0; border-top: 1px solid var(--color-border); scroll-margin-top: 5rem; }
	.pd-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-md) var(--space-xl); align-items: start; }
	.pd-head h2 { margin: 0; font-size: clamp(1.6rem, 3vw, 2.1rem); font-weight: 700; color: var(--color-text); }
	.pd-status { display: inline-block; margin-left: 0.75rem; padding: 0.15rem 0.6rem; border: 1px solid var(--color-text); border-radius: 4px; font-size: 0.85rem; font-weight: 700; vertical-align: middle; color: var(--color-text); }
	.pd-summary { margin: 0.75rem 0 0; max-width: 42em; font-size: 1.05rem; line-height: 1.9; }
	.pd-facts { margin: 0.9rem 0 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; }
	.pd-facts li { position: relative; padding-left: 1rem; color: var(--color-text); font-size: 0.95rem; }
	.pd-facts li::before { content: ''; position: absolute; left: 0; top: 0.65em; width: 0.4rem; height: 0.4rem; border-radius: 50%; background: var(--color-navy); }
	.pd-links { display: flex; flex-direction: column; gap: 0.6rem; min-width: 13rem; }
	.pd-links .btn { text-align: center; }

	.pd-edition { margin-top: var(--space-xl); }
	.pd-edition-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; margin-bottom: var(--space-md); }
	.pd-edition-head h3 { margin: 0; font-size: 1.25rem; color: var(--color-text); }
	.pd-edition-head p { margin: 0; flex: 1 1 24rem; line-height: 1.8; }
	.pd-edition-head a { color: var(--color-primary); font-weight: 600; font-size: 0.95rem; }

	.pd-screens { display: grid; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); gap: var(--space-md); align-items: start; }
	.pd-screen { margin: 0; }
	.pd-screen a { display: block; }
	.pd-screen img { display: block; width: 100%; height: auto; border: 1px solid var(--color-border); border-radius: 8px; }
	.pd-screen--phone img { width: auto; max-width: 100%; height: 22rem; margin: 0 auto; border: 5px solid #1C1917; border-radius: 18px; }
	.pd-screen figcaption { margin-top: 0.6rem; line-height: 1.75; }
	.pd-screen figcaption strong { display: block; color: var(--color-text); font-weight: 700; }
	.pd-screen figcaption span { color: var(--color-text-muted); font-size: 0.92rem; }

	.pd-example { display: grid; grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); gap: var(--space-lg); align-items: center; margin-top: var(--space-lg); }
	.pd-chat { padding: 1.25rem; border-radius: 18px; background: #8CABD8; }
	.pd-chat pre { margin: 0; padding: 1rem 1.1rem; border-radius: 14px; background: #fff; color: #1C1917; font-family: inherit; font-size: 0.92rem; line-height: 1.7; white-space: pre-wrap; }
	.pd-example p { margin: 0; line-height: 1.9; }

	@media (max-width: 860px) {
		.pd-head { grid-template-columns: 1fr; }
		.pd-links { flex-direction: row; flex-wrap: wrap; min-width: 0; }
		.pd-links .btn { flex: 1 1 12rem; }
		.pd-example { grid-template-columns: 1fr; }
	}
	@media (max-width: 560px) {
		.pd-screen--phone img { height: 20rem; }
	}

	.pd-figure { margin: var(--space-lg) 0 0; }
	.pd-figure svg { display: block; width: 100%; height: auto; }
	.pd-figure figcaption { margin-top: 0.75rem; font-size: 0.875rem; color: var(--color-text-muted); }
</style>
