---
// サイト共通の計測。GTM(GTM-T2FNKSK) の dataLayer に流す。
//
// 設計（サイト設計改訂案 §5）
//   主CV : diagnostic_lead_submit（収益診断フォーム送信）— 1本だけ
//   副CV : download_submit（資料DL）、newsletter_submit（ニュースレター登録）
//   参考 : contact_submit（お問い合わせ。フッター導線のみ）
//
// 貢献度を測るために、全CVへ以下を添付する。
//   entry_page / entry_referrer … セッションの入口（初回接触ページ）
//   source_page                … 診断CTAを踏んだページ（どのページが診断を連れてくるか）
//
// Revenue CRM が受付を確認した時だけ送信完了を計測する。
// 氏名・メール・本文・コンタクトIDは dataLayer に渡さない。
---

<script is:inline>
(function () {
	var dl = (window.dataLayer = window.dataLayer || []);
	// 既存の完了イベントはGTMの公開済みタグが送る。新しい補助イベントだけ
	// 同じGoogleタグに直接渡す（GTMにも同名タグを追加すると二重になる）。
	function googleEvent() { dl.push(arguments); }
	function push(event, params) {
		try {
			dl.push(Object.assign({ event: event }, params || {}));
			if (/^lead_form_/.test(event) || /^(contact|consultation|download)_cta_click$/.test(event) || event === 'crm_trial_click' || event === 'partner_submit') {
				googleEvent('event', event, Object.assign({}, params, { send_to: 'G-EZS96GZ6K7' }));
			}
		} catch (err) { /* 計測の障害でフォーム受付を止めない。 */ }
	}

	// ── セッションの入口を1度だけ記録 ──────────────────────
	var S;
	try { S = window.sessionStorage; } catch (e) {}
	function get(k) { try { return S.getItem(k) || ''; } catch (e) { return ''; } }
	function set(k, v) { try { S.setItem(k, v); } catch (e) {} }

	if (!get('cslg_entry_page')) {
		set('cslg_entry_page', location.pathname);
		var ref = document.referrer || '';
		// 自サイト内遷移は入口扱いしない
		if (ref && ref.indexOf(location.origin) === 0) ref = '';
		set('cslg_entry_referrer', ref || '(direct)');
	}

	function attribution() {
		return {
			entry_page: get('cslg_entry_page'),
			entry_referrer: get('cslg_entry_referrer'),
			source_page: get('cslg_source_page') || '(none)'
		};
	}
	window.cslgAttribution = attribution;

	// 共通の受付処理。HTTP成功と、受付APIの ok: true を確認する。
	// 問い合わせは受信箱で受け付け、コンタクトを作らない場合もある。
	// タイムアウトは受付不明。成功と数えず、画面も完了に進めない。
	window.cslgSubmitForm = async function (url, options, meta) {
		var params = Object.assign({
			form_name: meta.name, conversion_kind: meta.kind, page_path: location.pathname
		}, attribution());
		push('lead_form_attempt', params);
		var timer;
		var reason = 'network';
		try {
			var response = await Promise.race([
				(async function () {
					var res = await fetch(url, Object.assign({}, options, { mode: 'cors' }));
					if (!res.ok) { reason = 'http_' + res.status; throw new Error(reason); }
					var data = await res.json();
					if (!data || data.ok !== true) {
						reason = 'unconfirmed'; throw new Error(reason);
					}
					return res;
				})(),
				new Promise(function (_, reject) {
					timer = setTimeout(function () { reason = 'unconfirmed'; reject(new Error('unconfirmed')); }, 30000);
				})
			]);
			var submitted = {};
			try { submitted = JSON.parse(options.body || '{}'); } catch (err) {}
			if (meta.event && !submitted.hp) push(meta.event, params);
			return response;
		} catch (error) {
			push('lead_form_error', Object.assign({}, params, { error_type: reason }));
			throw error;
		} finally { clearTimeout(timer); }
	};

	// 入力開始。入力値は読まず、フォームの種別だけを記録する。
	var started = new WeakSet();
	document.addEventListener('focusin', function (e) {
		var form = e.target && e.target.closest ? e.target.closest('form[data-form-name]') : null;
		if (!form || started.has(form)) return;
		started.add(form);
		push('lead_form_start', Object.assign({ form_name: form.dataset.formName, page_path: location.pathname }, attribution()));
	});

	// 相談予約は外部カレンダー内で完了する。クリックを予約完了とは数えない。
	document.addEventListener('click', function (e) {
		var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
		if (!a) return;
		var url;
		try { url = new URL(a.href, location.href); } catch (err) { return; }
		var event;
		if (url.origin === location.origin) {
			var path = url.pathname.replace(/^\/en(?=\/)/, '');
			if (path.indexOf('/diagnostic/') === 0) {
				set('cslg_source_page', location.pathname);
				event = 'diagnostic_cta_click';
			} else if (path === '/contact/') event = 'contact_cta_click';
			else if (path === '/free-consultation/' || (path === location.pathname && url.hash === '#booking')) event = 'consultation_cta_click';
			else if (/\/download\/$/.test(path)) event = 'download_cta_click';
		} else if (url.hostname === 'crm.consilegy.com' && url.pathname === '/signup') event = 'crm_trial_click';
		else if (url.hostname === 'calendar.google.com' && url.pathname.indexOf('/calendar/appointments/') === 0) event = 'consultation_cta_click';
		if (event) push(event, Object.assign({}, attribution(), { source_page: location.pathname, destination_path: url.pathname }));
	}, true);
})();
</script>

{/*
  HubSpot のトラッキングは 2026-10-24 に外した（代表の判断：HubSpot は使わない）。
  フォームの送信先はすでに Revenue CRM（crm.consilegy.com/api/forms）。
  閲覧の記録は GA4 で見る。戻さないこと。
*/}
