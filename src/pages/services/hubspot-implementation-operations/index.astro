---
import ConsultationOutcomes from '../../../components/ConsultationOutcomes.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const faqItems = [
	{
		q: 'HubSpot導入だけ依頼できますか？',
		a: 'はい、新規導入も対応しています。ただし、Consilegyではツールの設定代行を主目的とせず、営業プロセス・KPI定義・マーケティング連携・RunOps設計を前提にHubSpotを設計します。「HubSpotをどう設定するか」よりも「HubSpotを使って売上管理にどう機能させるか」を起点に支援します。',
	},
	{
		q: 'Salesforce連携にも対応できますか？',
		a: 'はい。HubSpot ↔ Salesforceの双方向連携設計に対応しています。連携設計と実装支援では、主系をどちらにするか、どのデータを同期するかを決めます。重複データの処理や、KPIをどちらで計測するかも含みます。',
	},
	{
		q: 'Marketing Hubにも対応していますか？',
		a: 'はい。Marketing Hub（リード管理・ナーチャリング・スコアリング・メール・フォーム・ランディングページ・レポート）、Sales Hub（パイプライン・シーケンス・商談管理）、Operations Hub（データ同期・ワークフロー・データクレンジング）のいずれにも対応しています。',
	},
	{
		q: 'RevOpsとは何ですか？',
		a: 'RevOps（営業・マーケティングの運用）は、営業・マーケティング・カスタマーサクセスなど収益に関わる部門を横断して、プロセス・データ・ツール・KPIを統合的に運用・改善する機能です。HubSpotはRevOpsを実現するためのプラットフォームの一つですが、RevOpsはツール導入だけでは実現しません。業務プロセス設計・KPI定義・会議体設計が伴って初めて機能します。',
	},
	{
		q: 'レベニューアーキテクチャとの違いは何ですか？',
		a: 'レベニューアーキテクチャは、営業・マーケ・CS・CRM・KPI・会議体を含む収益構造全体の設計を指します。HubSpot導入・運用支援は、レベニューアーキテクチャの設計をHubSpotというプラットフォーム上に実装し、現場で運用できる状態に落とし込む支援です。設計から実装・定着まで一気通貫で支援する場合、レベニューアーキテクチャ設計と組み合わせてご提案します。',
	},
	{
		q: '定着支援まで依頼できますか？',
		a: 'はい。HubSpotの設計・実装完了後、現場定着と継続改善を支援する伴走支援も提供しています。月次KPIレビュー・ダッシュボード改善・ワークフロー改善から、営業・マーケチームへの定例支援まで対応します。設計で終わらず、現場の使用定着と成果創出まで責任を持って支援します。',
	},
	{
		q: 'ワークフロー整理も含まれますか？',
		a: 'はい。複雑化・スパゲッティ化したワークフローの整理・再設計は支援範囲に含まれます。どのワークフローが有効・無効か、何を目的としているか、想定通りに動いているかを分析します。そのうえで、シンプルで運用可能な状態に再設計します。',
	},
	{
		q: '既存のHubSpot環境を活かせますか？',
		a: 'はい。原則として既存のHubSpot環境を前提に設計します。プロパティ・ワークフロー・連絡先データ・レポートを分析し、何を活かし何を整理・削除するかを設計した上で、段階的に改善します。既存環境をすべて白紙にする必要はありません。',
	},
	{
		q: 'HubSpot専門代理店との違いは何ですか？',
		a: 'HubSpot専門代理店は、HubSpotの設定・実装を主なサービスとしています。ConsilegyはHubSpotをツールの一つとして捉え、営業・マーケ・CS・KPI・営業・マーケティングの運用全体を前提に設計します。「HubSpotをどう設定するか」ではなく「売上につながる運用構造を、HubSpotを使ってどう実現するか」が出発点です。',
	},
];

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map(({ q, a }) => ({
		'@type': 'Question',
		name: q,
		acceptedAnswer: { '@type': 'Answer', text: a },
	})),
};

const deliverables = [
	{ num: '01', title: 'HubSpot設計方針書', desc: 'CRM / MA / RevOpsを前提にしたHubSpot設計の基本方針' },
	{ num: '02', title: 'KPI定義書', desc: '営業・マーケ・CS各層の共通KPI体系と測定定義' },
	{ num: '03', title: 'プロパティ設計書', desc: 'データ項目・プロパティ・グループ構造の整理と設計' },
	{ num: '04', title: 'ワークフロー設計図', desc: '整理されたワークフロー構造とトリガー・アクション定義' },
	{ num: '05', title: 'MQL / SQL定義書', desc: '部門共通のリード評価基準と営業への引き継ぎ条件' },
	{ num: '06', title: 'ダッシュボード要件定義書', desc: '経営・営業・マーケ用の可視化要件と優先順位' },
	{ num: '07', title: '営業マーケ連携定義書', desc: 'ハンドオフルール・責任分担・共通指標の設計' },
	{ num: '08', title: 'RevOps運用ルール', desc: '入力ルール・更新タイミング・データガバナンス設計' },
	{ num: '09', title: '定着化運用計画書', desc: '現場定着のための段階的トレーニングと改善計画' },
	{ num: '10', title: 'データクレンジング設計書', desc: '重複排除・名寄せ・データ品質改善の方針と手順' },
	{ num: '11', title: 'データ移行・マッピング設計書', desc: '既存システムからのデータ移行設計とフィールドマッピング' },
	{ num: '12', title: '権限・チーム設計書', desc: 'ユーザー権限、チーム分割、レコードのアクセス範囲の設計' },
];

const scopeItems = [
	{ label: 'HubSpot CRM設計', desc: 'コンタクト・会社・取引オブジェクトの設計と最適化' },
	{ label: 'Marketing Hub設計', desc: 'リード管理・スコアリング・ナーチャリング・フォーム設計' },
	{ label: 'Sales Hub設計', desc: 'パイプライン・シーケンス・商談管理の設計と定着' },
	{ label: 'KPI / ダッシュボード設計', desc: '経営・営業・マーケが判断できる可視化基盤の構築' },
	{ label: '営業マーケ連携設計', desc: 'MQL/SQL定義・ハンドオフ・共通KPIの整備' },
	{ label: 'ワークフロー設計', desc: '複雑化したワークフローの整理・再設計・最適化' },
	{ label: 'Salesforce連携', desc: 'HubSpot ↔ Salesforce双方向連携設計と実装' },
	{ label: 'RevOps運用設計', desc: '入力ルール・データガバナンス・会議体設計' },
	{ label: '定着支援', desc: 'HubSpot定着化に向けた現場支援・トレーニング' },
	{ label: 'データクレンジング・名寄せ', desc: '重複データ排除・データ品質改善・統一化' },
	{ label: 'データ移行設計', desc: '既存システムからの安全なデータ移行設計と実行支援' },
	{ label: '権限・チーム設計', desc: 'ユーザー権限・チーム分割・レコードのアクセス範囲の設計' },
];
---

<BaseLayout
	title="HubSpot導入・運用支援 | Consilegy"
	description="HubSpot CRM / Marketing Hub / Sales Hubの導入・再設計・RevOps整備を支援。営業・マーケ・CS連携、KPI設計、Salesforce連携まで含む上流支援。HubSpot代理店ではなく、レベニューアーキテクチャ起点で設計します。"
	lang="ja"
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'BreadcrumbList',
			itemListElement: [
				{ '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://consilegy.com/' },
				{ '@type': 'ListItem', position: 2, name: 'サービス', item: 'https://consilegy.com/services/' },
				{ '@type': 'ListItem', position: 3, name: 'HubSpot導入・運用支援', item: 'https://consilegy.com/services/hubspot-implementation-operations/' },
			],
		})} />
	</Fragment>

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container">
		<div class="hero-nav">
			<a href="/services/" class="back-link">← サービス一覧</a>
			<span class="hero-tag">HubSpot Implementation &amp; Operations</span>
		</div>
		<div class="hero-service-name">
			<span class="hero-service-ja">HubSpot導入・運用支援</span>

		</div>
		<h1>HubSpotを入れたのに、<br /><span class="accent">営業・マーケ・売上管理がつながらない</span></h1>
		<p class="hero-sub">
			HubSpotを導入しても、営業が入力しない。<br />
			リードが商談につながらない。ダッシュボードが信用されない。
		</p>
		<p class="hero-lead">
          HubSpotを運用する営業・マーケティングの責任者、システム担当の方へ。<br />
          見込み客の評価・担当者への割り当て・営業の対応結果が戻る流れを整えます。<br />
          Salesforceとの連携も含め、業務ルールと設定の見直しから実装・定着まで支援します。
        </p>
		<div class="hero-cta">
			<a href="/contact/" class="btn btn--primary btn--lg">お問い合わせ</a>
			<a href="/download/" class="btn btn--outline btn--lg">サービス資料をダウンロード</a>
		</div>
		<div class="hero-tools">
			<span class="tools-label">対応ツール</span>
			<div class="tools-pills">
				<span class="tool-pill tool-pill--primary">HubSpot</span>
				<span class="tool-pill">Salesforce</span>
				<span class="tool-pill">Kintone</span>
				<span class="tool-pill">Marketo</span>
				<span class="tool-pill">ServiceNow</span>
				<span class="tool-pill">Account Engagement</span>
				<span class="tool-pill">Slack</span>
				<span class="tool-pill">Notion</span>
			</div>
		</div>
	</div>
</section>

<!-- ===================== よくある状態 ===================== -->
<section class="symptoms">
	<div class="container">
		<div class="section-header">
			<p class="eyebrow-label">Symptoms</p>
			<h2>こんな状態なら、HubSpot再設計が必要です。</h2>
		</div>
		<div class="symptoms-grid">
			<div class="symptom-card">HubSpotが<strong>営業日報化している</strong></div>
			<div class="symptom-card">リードは増えているが<strong>商談化しない</strong></div>
			<div class="symptom-card">営業が<strong>HubSpotを入力しない</strong></div>
			<div class="symptom-card"><strong>MQL / SQL定義</strong>が曖昧</div>
			<div class="symptom-card"><strong>ワークフローが複雑化</strong>している</div>
			<div class="symptom-card">レポートが<strong>経営判断に使えない</strong></div>
			<div class="symptom-card"><strong>プロパティが乱立</strong>している</div>
			<div class="symptom-card"><strong>Salesforceとの連携が崩れている</strong></div>
			<div class="symptom-card"><strong>顧客データが重複</strong>している</div>
			<div class="symptom-card">HubSpotを導入したが<strong>定着していない</strong></div>
		</div>
	</div>
</section>

<!-- ===================== 問題の本質 ===================== -->
<section class="root-cause">
	<div class="container">
		<div class="section-header">
			<p class="eyebrow-label">Root Cause</p>
			<h2>問題はHubSpotではなく、運用構造です。</h2>
		</div>
		<div class="cause-grid">
			<div class="cause-card">
				<div class="cause-card__num">01</div>
				<h3>ツールだけ導入している</h3>
				<p>営業プロセスやKPI設計なしにHubSpotだけ導入している。ツールが揃っても、運用構造がなければ機能しない。</p>
			</div>
			<div class="cause-card">
				<div class="cause-card__num">02</div>
				<h3>営業とマーケが分断している</h3>
				<p>リード定義、引き継ぎ条件、KPIが統一されていない。同じHubSpotを見ているのに、解釈が部門ごとに異なる。</p>
			</div>
			<div class="cause-card">
				<div class="cause-card__num">03</div>
				<h3>部門をまたぐ仕事の流れが決まっていない</h3>
				<p>CRM / MA / KPI / 会議体 / データ構造が接続されていない。設定はされているが、売上構造として機能していない。</p>
			</div>
		</div>
	</div>
</section>

<!-- ===================== 定義 ===================== -->
<section class="definition" id="hubspot-implementation-operations">
	<div class="container">
		<div class="definition-inner">
			<p class="eyebrow-label">Definition</p>
			<h2>HubSpot導入・運用支援とは</h2>
			<p class="definition-body">
				HubSpot導入・運用支援はHubSpot CRM・Marketing Hub・Sales Hubを中心に、
				営業・マーケ・CS・RevOps運用を再設計し、売上につながる運用基盤へ整備する支援です。
				HubSpotの設定代行ではなく、営業・マーケティングの運用全体を前提に設計・実装・定着まで支援します。
			</p>
			<div class="definition-oneliner">
				HubSpotを「入力ツール」ではなく、<br />
				売上改善の運用基盤へ再設計するサービスです。
			</div>
		</div>
	</div>
</section>

<!-- ===================== 解決する課題 ===================== -->
<section class="problems">
	<div class="container">
		<div class="section-header">
			<p class="eyebrow-label">Problems We Solve</p>
			<h2>解決する課題</h2>
		</div>
		<div class="problems-grid">
			<div class="problem-card">
				<div class="problem-card__en">Adoption Failure</div>
				<h3>HubSpot定着不足</h3>
				<p>営業が入力せず、運用ルールが形骸化している。</p>
			</div>
			<div class="problem-card">
				<div class="problem-card__en">KPI Misalignment</div>
				<h3>部門ごとに数字の見方が違う</h3>
				<p>営業・マーケで数字の定義と計算が一致していない。</p>
			</div>
			<div class="problem-card">
				<div class="problem-card__en">Conversion Gap</div>
				<h3>商談化不足</h3>
				<p>リード獲得はできているが、受注につながらない。</p>
			</div>
			<div class="problem-card">
				<div class="problem-card__en">Report Distrust</div>
				<h3>レポート不信</h3>
				<p>ダッシュボードの数字が経営判断に使われていない。</p>
			</div>
			<div class="problem-card">
				<div class="problem-card__en">Workflow Collapse</div>
				<h3>ワークフロー崩壊</h3>
				<p>複雑化・スパゲッティ化し、誰も把握できていない。</p>
			</div>
		</div>
	</div>
</section>

<!-- ===================== 支援範囲 ===================== -->
<section class="scope">
	<div class="container">
		<div class="section-header">
			<p class="eyebrow-label">Scope</p>
			<h2>支援領域</h2>
		</div>
		<div class="scope-grid">
			{scopeItems.map(item => (
				<div class="scope-card">
					<div class="scope-card__label">{item.label}</div>
					<p>{item.desc}</p>
				</div>
			))}
		</div>
	</div>
</section>

<!-- ===================== 支援プロセス ===================== -->
<section class="process">
	<div class="container">
		<div class="section-header">
			<p class="eyebrow-label">Process</p>
			<h2>支援プロセス</h2>
			<p class="section-note">単なるHubSpot設定代行ではなく、営業・マーケティングの運用全体を前提に再設計する支援です。</p>
		</div>

		<figure class="hs-figure" aria-labelledby="hs-figure-caption">
			<svg class="fig-pc" viewBox="0 0 1120 210" role="img" aria-label="HubSpot導入の段取り。設計、設定、移行、教育、運用の5段階" font-family="inherit">
				<defs><marker id="hs-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<rect x="40" y="40" width="200" height="150" rx="6" fill="#fff" stroke="#E2E8F0"/>

				<text x="56" y="72" font-size="14" fill="#64748b" letter-spacing="1">01 DESIGN</text>
				<text x="56" y="108" font-size="20" font-weight="600" fill="#0F172A">設計</text>
				<text x="56" y="142" font-size="16" fill="#475569">業務の流れと項目、</text>
				<text x="56" y="168" font-size="16" fill="#475569">商談の段階を決める</text>
				<line x1="241" y1="115" x2="249" y2="115" stroke="#0F172A" stroke-width="2" marker-end="url(#hs-arr)"/>
				<rect x="250" y="40" width="200" height="150" rx="6" fill="#fff" stroke="#E2E8F0"/>

				<text x="266" y="72" font-size="14" fill="#64748b" letter-spacing="1">02 SETUP</text>
				<text x="266" y="108" font-size="20" font-weight="600" fill="#0F172A">設定</text>
				<text x="266" y="142" font-size="16" fill="#475569">パイプライン・自動化・</text>
				<text x="266" y="168" font-size="16" fill="#475569">権限を入れる</text>
				<line x1="451" y1="115" x2="459" y2="115" stroke="#0F172A" stroke-width="2" marker-end="url(#hs-arr)"/>
				<rect x="460" y="40" width="200" height="150" rx="6" fill="#fff" stroke="#E2E8F0"/>

				<text x="476" y="72" font-size="14" fill="#64748b" letter-spacing="1">03 MIGRATE</text>
