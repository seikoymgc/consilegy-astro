---
import JournalArticle from '../../../components/JournalArticle.astro';
import { eyecatchPath } from '../../../data/eyecatch.mjs';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { categoriesEn, type CategoryKey } from '../../../content.config';

export async function getStaticPaths() {
	const notes = await getCollection('notesEn', ({ data }) => !data.draft);
	const jaIds = new Set((await getCollection('notes', ({ data }) => !data.draft)).map(n => n.id));
	return notes.map(note => ({
		params: { slug: note.id },
		props: { note, hasJa: jaIds.has(note.id) },
	}));
}

const { note, hasJa } = Astro.props;
const { Content, headings } = await render(note);
const d = note.data;
const toc = headings.filter(h => h.depth === 2);
const cat = d.category as CategoryKey;

const all = (await getCollection('notesEn', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const related = all.filter(n => n.id !== note.id && n.data.category === cat).slice(0, 3);

const fmt = (date: Date) =>
	date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
	lang="en"
	title={d.title.length > 52 ? d.title : `${d.title} | B2B Revenue Strategy Journal`}
	headline={d.title}
	description={d.description}
	ogType="article"
	publishedAt={d.publishedAt}
	updatedAt={d.updatedAt}
	ogImage={eyecatchPath(note.id, 'jpg')}
	section={categoriesEn[cat]}
	jaPath={hasJa ? `/${note.id}/` : undefined}
	enPath={hasJa ? `/en/articles/${note.id}/` : undefined}
	breadcrumbs={[
		{ name: 'Home', url: '/en/' },
		{ name: 'Articles', url: '/en/' },
		{ name: categoriesEn[cat], url: `/en/category/${cat}/` },
		{ name: d.title },
	]}
>
	<JournalArticle note={note} headings={toc} related={related} lang="en">
		<Content />
	</JournalArticle>
</BaseLayout>
