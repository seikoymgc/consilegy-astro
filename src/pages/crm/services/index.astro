				<g font-family="inherit">
				<rect x="40" y="110" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="58" y="144" font-size="14" fill="#64748b" letter-spacing="1">Win</text><text x="58" y="174" font-size="18" font-weight="600" fill="#0F172A">受注</text>
				<text x="58" y="234" font-size="16" fill="#475569">空きを見てから受ける</text>
				<line x1="228" y1="158" x2="252" y2="158" stroke="#0F172A" stroke-width="2" marker-end="url(#sv-arr)"/>
				<rect x="256" y="110" width="188" height="96" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="274" y="144" font-size="14" fill="#64748b" letter-spacing="1">Delivery</text><text x="274" y="174" font-size="18" font-weight="600" fill="#0F172A">支援</text>
				<text x="274" y="234" font-size="16" fill="#475569">稼働を週ごとに割当</text>
