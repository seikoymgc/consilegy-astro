---
// 一覧と記事ページの右サイドバー。新着 → よく読まれている → 読者 → カテゴリ。
import {
  CATEGORIES, CATEGORY_ORDER, COPY, SEGMENTS, SEGMENT_ORDER,
  articlePath, crmMediaArticles, featuredArticles, fmtDate, mediaPath,
  type Lang, type Segment,
} from '../lib/crm-media';

interface Props { lang: Lang; segment: Segment; currentSlug?: string }
const { lang, segment, currentSlug } = Astro.props;
const t = COPY[lang];
const latest = (await crmMediaArticles(lang, segment)).filter((a) => a.data.slug !== currentSlug).slice(0, 3);
const popular = (await featuredArticles(lang, 6)).filter((a) => a.data.slug !== currentSlug).slice(0, 3);
---
<aside class="side">
  {latest.length > 0 && (
    <section>
      <h2>{t.latest}</h2>
      <ul>
        {latest.map((a) => (
          <li>
            <a href={articlePath(a)}>
              <span>
                <b>{a.data.title}</b>
                <time datetime={a.data.date.toISOString()}>{fmtDate(a.data.date, lang)}</time>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {popular.length > 0 && (
    <section>
      <h2>{t.popular}</h2>
      <ol class="ranked">
        {popular.map((a) => (
          <li>
            <a href={articlePath(a)}>
              <span><b>{a.data.title}</b></span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section>
    <h2>{t.segmentLabel}</h2>
    <ul class="links">
      {SEGMENT_ORDER.map((s) => (
        <li><a href={mediaPath(lang, s)} aria-current={s === segment ? 'page' : undefined}>{SEGMENTS[s][lang]}</a></li>
      ))}
    </ul>
  </section>

  <section>
    <h2>{t.categoriesLabel}</h2>
    <ul class="links">
      {CATEGORY_ORDER.map((c) => (
        <li><a href={`${mediaPath(lang, segment)}#${c}`}>{CATEGORIES[c][lang]}</a></li>
      ))}
    </ul>
  </section>
</aside>

<style>
  .side { display:flex; flex-direction:column; gap:2.5rem; padding-top:.25rem; }
  h2 { margin:0 0 1.25rem; font-size:1rem; font-weight:700; color:var(--color-navy); }
  ul, ol { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; }
  li + li { margin-top:1rem; padding-top:1rem; border-top:1px solid var(--color-border); }
  li a { display:block; text-decoration:none; color:inherit; }
  li img { display:none; }
  li b { display:block; font-size:1rem; font-weight:600; line-height:1.7; color:var(--color-text); }
  li a:hover b { color:var(--color-primary); }
  li time { display:block; margin-top:.5rem; font-size:.875rem; color:var(--color-text-muted); }
  .links { display:flex; flex-direction:row; flex-wrap:wrap; gap:.5rem; }
  .links li + li { margin:0; padding:0; border:0; }
  .links a { padding:.5rem .75rem; border:1px solid var(--color-border); border-radius:4px; font-size:.875rem; }
  .links a:hover, .links a[aria-current='page'] { border-color:var(--color-primary); color:var(--color-primary); }
  @media(max-width:1000px) { .side { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem; border-top:1px solid var(--color-border); padding-top:2rem; } }
  @media(max-width:600px) { .side { grid-template-columns:minmax(0,1fr); } }

</style>
