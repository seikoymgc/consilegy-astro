---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CrmSubnav from '../../../../components/CrmSubnav.astro';
import '../../../../styles/school-brand.css';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// Mirrors the Japanese page. Only what is actually built into the product's
// school shell (edition=b2c + shell='school') is listed here.
const screens = [
	{ src: 'students', title: 'Students', desc: 'Trial, enrolled, on hold, graduated, withdrawn. Where each student stands, at a glance.', alt: 'The student list, filtered by enrolled, trialing, near graduation, on hold, and graduated, with a status badge on each student.' },
	{ src: 'schedule', title: 'Weekly schedule', desc: 'Lessons managed by the week, tied to the closure-day calendar. Connect a Google account and each teacher gets the lessons on their own Google Calendar.', alt: 'The weekly schedule: lessons this week, teachers working, and a day-by-day list of times, students, and assigned teachers.' },
	{ src: 'lessons', title: 'Lesson records', desc: 'What was taught, kept per student. The history survives a change of teacher.', alt: 'Lesson history listing student name, assigned teacher, course, and date in chronological order.' },
	{ src: 'hearing-ai', title: 'Intake notes', desc: 'Paste the trial transcript and AI sorts it into the student record. A teacher can correct it afterwards.', alt: 'The intake form, with a transcript paste box and a fill-with-AI button above fields for how they found us, basic details, current level, and goals, each already filled in.' },
	{ src: 'report', title: 'Monthly report', desc: 'AI drafts it from the student’s lesson records. A teacher checks it before using it.', alt: 'The monthly report screen, showing an AI-drafted progress comment with regenerate and confirm buttons.' },
	{ src: 'knowledge', title: 'Knowledge base', desc: 'Teacher manuals and operating rules synced from Google Drive, so teachers can look them up fast. The AI cites them when it answers.', alt: 'The knowledge base, listing articles for common questions, operating rules, and manuals.' },
	{ src: 'billing', title: 'Billing', desc: 'Paying and failed payments in one place. Unpaid tuition is flagged, and you can send the reminder on LINE.', alt: 'The billing screen showing MRR, paying, and failed counts, with paying, cancelled, and failed badges on each contract.' },
];

const highlights = [
	{
		title: 'Homework and bookings, from LINE',
		text: 'Students hand in homework on the LINE app they already use, no new app to install, and book lessons from the LINE menu. Bookings go onto Google Calendar, and each submission is logged per student (text can be read in the CRM; photos and audio stay in LINE). The CRM can also nudge students who have not handed in their homework.',
	},
	{
		title: 'Unpaid tuition, chased on LINE',
		text: 'Enrolled, on hold, and withdrawn students in one list. The CRM flags unpaid tuition, and the reminder goes out on LINE.',
	},
	{
		title: 'AI writes the report',
		text: "The monthly report is drafted from each student's lesson records. Teachers review it before using it.",
	},
];

const problems = [
	{
		title: 'Bookings are taken by hand',
		text: 'Lesson bookings go back and forth on LINE, and each one is taken by hand.',
	},
	{
		title: 'Homework checks rely on read receipts',
		text: 'Whether a teacher has checked the homework is tracked by who has read what in the LINE group.',
	},
	{
		title: 'The last tool did not stick',
		text: 'You tried school management software, but nobody kept up with the data entry and it never took hold.',
	},
];

const roles = [
	{ name: 'Manager', scope: 'Students, tuition, and permission settings' },
	{ name: 'Office', scope: 'Students and day-to-day office work' },
	{ name: 'Teacher', scope: 'Gets the tasks and homework for their own students' },
];
---

<BaseLayout
	title="Revenue CRM for schools | Make your day 48 hours long"
	description="Open the home screen and today's work is already there. A CRM for schools and studios that connects to your official LINE account. Students hand in homework and book lessons on LINE; homework is saved per student and bookings go to Google Calendar. Enrollment status, the weekly schedule, lesson records, and AI-drafted monthly reports in one place, built mobile first. 30-day free trial, no card required."
	lang="en"
	alternateUrl="/crm/school/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://consilegy.com/en/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/en/crm/"},
		{"@type": "ListItem", "position": 3, "name": "School Edition", "item": "https://consilegy.com/en/crm/school/"}
	]
})} />

<link slot="head" rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&display=swap" />

<CrmSubnav lang="en" />

<div class="school-brand">

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">
				<img class="eyebrow-mark" src="/images/crm/logo/revenue-crm-school-logo-orange.svg" alt="" width="26" height="26" decoding="async" />
				Revenue CRM School Edition
			</p>
			<h1>Make your day<br />48 hours long.</h1>
			<p class="hero-lead">
				Open the home screen and today's work is already there.
				Students keep talking to you on your official LINE account. <strong>Homework and bookings arrive on LINE,
				and homework is saved to each student's record automatically</strong>.
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">See the demo</a>
				<a href={SIGNUP_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">Start free</a>
				<a href="#screens" class="btn btn--secondary">See the screens</a>
			</div>
			<ul class="hero-points" aria-label="What the school edition does">
				<li>Works with your official LINE account</li>
				<li>Lessons go straight to Google Calendar</li>
				<li>Free for the first 30 days</li>
			</ul>
		</div>
		<figure class="hero-media">
			<img
				src="/videos/school-demo-en.gif"
				alt="A walkthrough of the Revenue CRM school edition, moving through the home screen, student list, student detail, billing, the weekly schedule, and the monthly report."
				width="820"
				height="462"
				decoding="async"
			/>
			<figcaption>The screens: home, student list, student detail, billing, weekly schedule</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">Everything a team-run school manages, in one place.</p>
			<div class="pos-copy">
				<p>
					<strong>Bookings, homework, lesson records, and tuition</strong> on one screen.
					Every teacher sees the same picture, and the home screen tells you what to do today:
					today's lessons, students to contact, and homework waiting for review.
				</p>
				<p>
					The screens are built <strong>for the phone first</strong>. What mattered was a teacher
					opening it between the classroom and the train, recording what just happened, and
					checking who is next, right there.
				</p>
				<p>
					The same foundation works for any business built on recurring payments, subscriptions
					and repeat orders included. Take the student, lesson, and teacher parts out and it
					watches contracts and retention instead. Ask us.
				</p>
				<a href="/en/services/revenue-architecture-design/" class="pos-link">Read about this approach →</a>
			</div>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Sound familiar?</p>
			<h2 class="prob-title">Bookings and homework checks still run on manual work and LINE read receipts.</h2>
		</div>
		<div class="prob-grid">
			{problems.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`Item ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>

		<figure class="prob-shot">
			<img
				src="/images/common/school-student-detail-en.jpg"
				alt="A student detail page, showing the assigned teacher, lesson history, intake notes, and billing status on one screen."
				width="1600"
				height="1000"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>
				One screen per student. <strong>Who is responsible, what was done and when, and how it
				went</strong> on a single page. When the teacher changes, this screen tells the story.
			</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== WHY ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">Why we built the school edition.<br />Give society more choices.</p>
			<div class="pos-copy">
				<p>
					For 8 years we have built customer management systems, helping more than 40 companies put them in place.
					What we saw again and again was a tool going unused because entering data was too much work.
					Not more features, but a system that keeps running without people straining to enter data. That is why we built it.
				</p>
				<p>
					The school edition grew out of how a friend runs an English school. Raising a child while teaching
					about 40 students, the owner was so buried in admin that new enrollment had been put on hold.
					Since starting to use it, the school has been able to take new students again.
				</p>
				<p>Let the CRM take on the admin work, and give the school a 48-hour day.</p>
			</div>
		</div>
	</div>
</section>

<!-- ===================== HIGHLIGHTS ===================== -->
<section class="problem highlights">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">What it does</p>
			<h2 class="prob-title">Let the CRM do the searching, compiling, and chasing.</h2>
		</div>
		<div class="prob-grid">
			{highlights.map((item) => (
				<article class="prob-item">
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">The screens</p>
			<h2 class="sc-title">Everything you open daily, organized around the student.</h2>
		</div>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img
							src={`/images/crm/school/en/screen-${s.src}.webp`}
							alt={s.alt}
							width="1600"
							height="1000"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== SUPPORT ===================== -->
<section class="support">
	<div class="container support-inner">
		<div>
			<p class="section-eyebrow">Running the school</p>
			<h2>Month-end reporting and the daily checks, done on the screen.</h2>
			<p class="support-lead">
				The month-end report, who has not been contacted, and this week's schedule all run
				straight off the student data. The point is not to produce a document. It is to leave
				something the next person can act on.
			</p>
			<p class="support-lead">
				The monthly progress report is drafted by AI from each student's lesson records.
				A teacher checks it and decides whether it is ready to use.
			</p>
		</div>
		<div class="support-list">
			<h3>What you check most</h3>
			<ul>
				<li><span>Attention</span><strong>Students to contact today</strong></li>
				<li><span>Enrollment</span><strong>Enrolled, on hold, and withdrawn this month</strong></li>
				<li><span>Schedule</span><strong>This week's lessons</strong></li>
				<li><span>Reporting</span><strong>The monthly report draft</strong></li>
			</ul>
		</div>
	</div>
	<div class="container engine-fig">
		<figure class="en-fig" aria-labelledby="en-sc-caption">
			<svg class="fig-pc" viewBox="40 0 1040 278" role="img" aria-label="Student flow: trial lesson, enrolled, lessons, continue or pause, all through LINE" font-family="inherit">
				<defs><marker id="en-sc-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<text x="40" y="26" font-size="14" letter-spacing="1.5" fill="#64748b">STUDENT FLOW</text>
				<rect x="40" y="50" width="240" height="136" rx="6" fill="#fff" stroke="#E2E8F0"/>
		<rect x="40" y="50" width="240" height="3" fill="#FF5C3E"/>
		<text x="56" y="80" font-size="14" letter-spacing="1.5" fill="#64748b">TRIAL</text>
		<text x="56" y="108" font-size="18" font-weight="600" fill="#0F172A">Trial lesson</text>
		<text x="56" y="136" font-size="16" fill="#475569">Booked from</text>
		<text x="56" y="160" font-size="16" fill="#475569">LINE</text>
		<line x1="282" y1="98" x2="304" y2="98" stroke="#0F172A" stroke-width="2" marker-end="url(#en-sc-arr)"/>
		<rect x="306" y="50" width="240" height="136" rx="6" fill="#fff" stroke="#E2E8F0"/>
		<rect x="306" y="50" width="240" height="3" fill="#FF5C3E"/>
		<text x="322" y="80" font-size="14" letter-spacing="1.5" fill="#64748b">JOIN</text>
		<text x="322" y="108" font-size="18" font-weight="600" fill="#0F172A">Enrolled</text>
		<text x="322" y="136" font-size="16" fill="#475569">Student record</text>
		<text x="322" y="160" font-size="16" fill="#475569">created</text>
		<line x1="548" y1="98" x2="570" y2="98" stroke="#0F172A" stroke-width="2" marker-end="url(#en-sc-arr)"/>
		<rect x="572" y="50" width="240" height="136" rx="6" fill="#fff" stroke="#E2E8F0"/>
		<rect x="572" y="50" width="240" height="3" fill="#FF5C3E"/>
		<text x="588" y="80" font-size="14" letter-spacing="1.5" fill="#64748b">LEARN</text>
		<text x="588" y="108" font-size="18" font-weight="600" fill="#0F172A">Lessons</text>
		<text x="588" y="136" font-size="16" fill="#475569">Homework arrives</text>
		<text x="588" y="160" font-size="16" fill="#475569">via LINE</text>
		<line x1="814" y1="98" x2="836" y2="98" stroke="#0F172A" stroke-width="2" marker-end="url(#en-sc-arr)"/>
		<rect x="838" y="50" width="240" height="136" rx="6" fill="#0F172A" stroke="#E2E8F0"/>
		<rect x="838" y="50" width="240" height="3" fill="#FF5C3E"/>
		<text x="854" y="80" font-size="14" letter-spacing="1.5" fill="rgba(255,255,255,0.7)">STAY</text>
		<text x="854" y="108" font-size="18" font-weight="600" fill="#fff">Continue / pause</text>
		<text x="854" y="136" font-size="16" fill="rgba(255,255,255,0.85)">Reminders for</text>
		<text x="854" y="160" font-size="16" fill="rgba(255,255,255,0.85)">missed homework</text>
		<rect x="40" y="206" width="1040" height="52" rx="6" fill="#0F172A"/><text x="560" y="238" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">Students keep using the official LINE account; everything is recorded per student</text>
			</svg>
			<svg class="fig-sp" viewBox="0 0 360 668" role="img" aria-label="Student flow: trial lesson, enrolled, lessons, continue or pause, all through LINE">
				<defs><marker id="en-sc-sp-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<g font-family="inherit">
				<text x="16" y="30" font-size="14" letter-spacing="1.5" fill="#64748b">STUDENT FLOW</text>
				<rect x="16" y="48" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<rect x="16" y="48" width="328" height="3" fill="#FF5C3E"/>
				<text x="32" y="76" font-size="14" letter-spacing="1.5" fill="#64748b">TRIAL</text>
				<text x="32" y="104" font-size="18" font-weight="600" fill="#0F172A">Trial lesson</text>
				<text x="32" y="132" font-size="16" fill="#475569">Booked from LINE</text>
				<line x1="180" y1="150" x2="180" y2="172" stroke="#0F172A" stroke-width="2" marker-end="url(#en-sc-sp-arr)"/>
				<rect x="16" y="176" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<rect x="16" y="176" width="328" height="3" fill="#FF5C3E"/>
				<text x="32" y="204" font-size="14" letter-spacing="1.5" fill="#64748b">JOIN</text>
				<text x="32" y="232" font-size="18" font-weight="600" fill="#0F172A">Enrolled</text>
				<text x="32" y="260" font-size="16" fill="#475569">Student record created</text>
				<line x1="180" y1="278" x2="180" y2="300" stroke="#0F172A" stroke-width="2" marker-end="url(#en-sc-sp-arr)"/>
				<rect x="16" y="304" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<rect x="16" y="304" width="328" height="3" fill="#FF5C3E"/>
				<text x="32" y="332" font-size="14" letter-spacing="1.5" fill="#64748b">LEARN</text>
				<text x="32" y="360" font-size="18" font-weight="600" fill="#0F172A">Lessons</text>
				<text x="32" y="388" font-size="16" fill="#475569">Homework arrives via LINE</text>
				<line x1="180" y1="406" x2="180" y2="428" stroke="#0F172A" stroke-width="2" marker-end="url(#en-sc-sp-arr)"/>
				<rect x="16" y="432" width="328" height="100" rx="6" fill="#0F172A" stroke="#0F172A"/>
				<rect x="16" y="432" width="328" height="3" fill="#FF5C3E"/>
				<text x="32" y="460" font-size="14" letter-spacing="1.5" fill="rgba(255,255,255,0.7)">STAY</text>
				<text x="32" y="488" font-size="18" font-weight="600" fill="#fff">Continue / pause</text>
				<text x="32" y="516" font-size="16" fill="rgba(255,255,255,0.85)">Reminders for missed homework</text>
				<rect x="16" y="552" width="328" height="100" rx="6" fill="#0F172A"/>
				<text x="180" y="582" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">Students keep using the official</text>
				<text x="180" y="606" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">LINE account; everything is</text>
				<text x="180" y="630" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">recorded per student</text>
				</g>
			</svg>
			<figcaption id="en-sc-caption">Students never install an app. Bookings, homework, and reminders run through LINE and land on each student record.</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== AI ===================== -->
<section class="ai">
	<div class="container ai-inner">
		<div>
			<p class="section-eyebrow">AI</p>
			<h2>Ask in plain language,<br />get the answer back.</h2>
			<p class="ai-lead">
				You do not have to build a report to find something out.
				Ask it the way you would say it, and it searches the student data and answers.
			</p>
			<p class="ai-lead">
				Paste a trial-lesson transcript and it sorts what was said into fields: how they found
				you, their level, what they are after, and what the trial exposed. The writing-up afterwards goes away.
			</p>
			<p class="ai-lead">
				Nothing AI writes is sent to a student or a guardian without a teacher seeing it first.
				For now, AI answers and drafts are in Japanese.
			</p>
		</div>
		<ul class="ai-examples">
			<li>Which students need attention today?</li>
			<li>Who hasn't paid yet?</li>
			<li>Who is on hold?</li>
			<li>Draft a reply to this student.</li>
		</ul>
	</div>
</section>

<!-- ===================== ROLES ===================== -->
<section class="roles">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Permissions</p>
			<h2 class="ro-title">Each teacher gets only what they need.</h2>
		</div>
		<p class="ro-lead">
			Every teacher can see student information. The assigned teacher gets that student's tasks
			and homework, and nothing more. Who sees amounts such as tuition is set per role.
		</p>
		<dl class="ro-list">
			{roles.map((r) => (
				<div class="ro-row">
					<dt>{r.name}</dt>
					<dd>{r.scope}</dd>
				</div>
			))}
		</dl>
		<p class="ro-note">Actions are logged, so you can trace who changed what, and when.</p>
	</div>
</section>

<!-- ===================== FINAL CTA ===================== -->
<section class="final-cta">
	<div class="container cta-inner">
		<div>
			<p class="cta-eyebrow">30 days free</p>
			<h2>See whether it fits your school<br />on the real screens.</h2>
			<p class="cta-lead">
				No setup fee, and every plan comes with a 30-day free trial, no card required.
				The demo opens with just an email address.
				How-to videos and help articles are free for everyone. If you want us to set it up and get it running for you,
				hands-on onboarding is available from ¥120,000.
				Refer another school and, for 12 months after it starts paying, 20% of its base plan fee (tax excluded) comes off your bill.
			</p>
			<div class="cta-actions">
				<a href={SIGNUP_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">Start free</a>
				<a href={DEMO_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">See the demo</a>
				<a href="/en/crm/" class="btn btn--secondary">See the B2B edition</a>
			</div>
		</div>
		<div class="cta-card">
			<h4>What we show you</h4>
			<ul class="cta-list">
				<li>The student list and how enrollment status reads</li>
				<li>The weekly schedule and closure-day management</li>
				<li>How lesson records and intake notes accumulate</li>
				<li>The AI-drafted monthly report</li>
				<li>Role permissions and the audit log</li>
			</ul>
		</div>
	</div>
</section>

</div>
</BaseLayout>

<style>
	/* html[lang="en"] の --container は 72ch（記事の読み物幅）。このページは
	   カードを並べるLPなので、そのままだと英文が単語単位で折り返して壊れる。
	   ページ内だけ 1120px に戻す。global.css には触らない。 */
	.container {
		max-width: 1120px;
	}

	.section-eyebrow,
	.eyebrow,
	.cta-eyebrow {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		margin: 0;
		color: var(--color-text);
		font-size: 2rem;
