---
import BaseLayout from '../../../layouts/BaseLayout.astro';

// プロダクトの school shell（edition=b2c + shell='school'）に実装済みの機能のみ記載。
// LINE連携は現時点でシミュレーション（実API未接続）のため、意図的に載せていない。
const screens = [
	{ title: '生徒', desc: '体験中・支払中・休止中・解約済を一覧で。誰が今どの状態かが、探さなくても分かります。' },
	{ title: '週間スケジュール', desc: 'レッスンの予定を週単位で。休校日カレンダーと連動します。' },
	{ title: 'レッスン記録', desc: '実施したレッスンの内容を生徒ごとに蓄積。担当が替わっても経緯が残ります。' },
	{ title: '架電確認', desc: '連絡すべき生徒と、まだ連絡できていない生徒を分けて管理します。' },
	{ title: 'ヒアリング', desc: '入会時や面談で聞いた内容を構造化して保存。次の担当が読んで動けます。' },
	{ title: '月次レポート', desc: 'AIが生徒ごとの進捗レポートを下書き。ゼロから書かずに、直して出せます。' },
	{ title: 'ナレッジベース', desc: '指導方針や運用ルールを記事として蓄積。属人化を防ぎます。' },
	{ title: '請求', desc: '支払中・支払失敗を把握。止まっている入金に気づけます。' },
];

const roles = [
	{ name: 'オーナー', scope: 'すべて' },
	{ name: '管理者', scope: '運用全般と権限設定' },
	{ name: 'マネージャー', scope: '担当生徒とチームの生徒データを閲覧・編集' },
	{ name: 'メンバー（コーチ）', scope: '担当生徒のみ' },
];
---

<BaseLayout
	title="Revenue CRM スクール版（β版） | 生徒の状況が、探さなくても分かる"
	description="スクール・教室向けの画面構成。生徒の在籍状況、週間スケジュール、レッスン記録、架電確認、AIによる月次レポート下書きまで。スマホ前提のUIで、コーチが移動中でも扱えます。定期課金の事業にも同じ土台が使えます。現在クローズドβ。"
	lang="ja"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/crm/"},
		{"@type": "ListItem", "position": 3, "name": "スクール版", "item": "https://consilegy.com/crm/school/"}
	]
})} />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container">
		<span class="eyebrow"><span class="eyebrow__dot"></span>Product · Closed Beta</span>
		<h1>生徒の状況が、<br />探さなくても分かる。<span class="hero-edition">スクール版</span></h1>
		<p class="hero-lead">
			生徒名簿はスプレッドシート、レッスンの記録はコーチの手元、
			入金状況は別のツール。誰かに聞かないと今の状態が分からない——
			スクール運営でいちばん時間を溶かすのは、この「探す時間」です。
			スクール版は、<strong>生徒を軸に全部を1か所に集めた画面構成</strong>です。
		</p>
		<div class="hero-actions">
			<a href="/contact/" class="btn btn--hero-primary btn--lg">βパートナーに応募する →</a>
			<a href="#screens" class="btn btn--hero-outline btn--lg">画面を見る</a>
		</div>
		<p class="hero-switch">法人のお客様を相手にする事業の方は <a href="/crm/">法人向けはこちら →</a></p>
		<p class="hero-note">※ 現在クローズドβ。数社限定で、一緒に育てていただけるパートナーを探しています。仕様は予告なく変更される場合があります。</p>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">
				スクール版は、Revenue CRM のスクール向け画面構成です。
				別プロダクトではなく、同じCRMの上に載っています。
			</p>
			<p>
				法人向けが「受注できるか」を追うのに対し、スクール版が追うのは「今月も通ってもらえるか」です。
				契約の継続に、<strong>生徒・レッスン・コーチ</strong>の3つを重ねています。
				在籍しているかどうかだけでなく、誰がいつ何を受けて、どう進んでいるかまで残ります。
			</p>
			<p>
				画面は<strong>スマホを前提</strong>に作ってあります。コーチが教室と移動の合間に開いて、
				その場で記録し、その場で次の生徒を確認できることを優先しました。
			</p>
			<p>
				定期課金で成り立つ事業（サブスク・定期購入など）にも、同じ土台が使えます。
				生徒・レッスン・コーチの部分を外し、契約と継続率だけを見る構成にできます。
				ご相談ください。
			</p>
			<a href="/revenue-architecture/" class="pos-link">この考え方について読む →</a>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<p class="section-eyebrow">Why it breaks</p>
		<h2 class="prob-title">こんな課題、ありませんか。</h2>
		<div class="prob-grid">
			<div class="prob-item">
				<p>やめそうな生徒に気づくのが、いつも辞めた後になっている。</p>
			</div>
			<div class="prob-item">
				<p>コーチが替わると、その生徒の経緯が引き継がれない。前回何を話したか誰も知らない。</p>
			</div>
			<div class="prob-item">
				<p>月末に「今、何人在籍しているか」を数え直している。</p>
			</div>
		</div>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<p class="section-eyebrow">Screens</p>
		<h2 class="sc-title">生徒を軸に、必要なものが揃っています。</h2>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<h3>{s.title}</h3>
					<p>{s.desc}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== AI ===================== -->
<section class="ai">
	<div class="container ai-inner">
		<div>
			<p class="section-eyebrow">AI</p>
			<h2>日本語で聞けば、答えが返ります。</h2>
			<p class="ai-lead">
				レポートを作らなくても、知りたいことをそのまま聞けます。
				生徒データを検索して、その場で答えます。
			</p>
			<p class="ai-lead">
				月次の進捗レポートも、AIが生徒ごとに下書きします。
				ゼロから書く作業がなくなり、確認して直すだけになります。
			</p>
		</div>
		<ul class="ai-examples">
			<li>今日、要対応の生徒は？</li>
			<li>今月の在籍率は？</li>
			<li>今週のレッスン予定は？</li>
			<li>未架電の生徒をリストして</li>
		</ul>
	</div>
</section>

<!-- ===================== ROLES ===================== -->
<section class="roles">
	<div class="container">
		<p class="section-eyebrow">Permissions</p>
		<h2 class="ro-title">コーチには、担当の生徒だけ。</h2>
		<p class="ro-lead">
			業務委託のコーチが多いスクールでは、誰がどこまで見られるかが実務上の問題になります。
			役割ごとに範囲を分けられます。
		</p>
		<dl class="ro-list">
			{roles.map((r) => (
				<div class="ro-row">
					<dt>{r.name}</dt>
					<dd>{r.scope}</dd>
				</div>
			))}
		</dl>
		<p class="ro-note">操作ログが残るので、誰がいつ何を変更したかを後から追えます。</p>
	</div>
</section>

<!-- ===================== FINAL CTA ===================== -->
<section class="final-cta">
	<div class="container cta-inner">
		<div>
			<p class="cta-eyebrow">Get Started</p>
			<h2>一緒に育てていただける<br />スクールを探しています。</h2>
			<p class="cta-lead">
				クローズドβは、完成品を売る段階ではありません。
				実際の運営で使っていただき、足りないものを教えていただきながら仕上げていく段階です。
				その代わり、御校の運営に合わせて機能の優先順位を決められます。
			</p>
			<div class="cta-actions">
				<a href="/contact/" class="btn btn--cta-primary btn--lg">βパートナーに応募する →</a>
				<a href="/crm/" class="btn btn--cta-outline btn--lg">法人向けを見る</a>
			</div>
		</div>
		<div class="cta-card">
			<h4>デモでお見せする内容</h4>
			<ul class="cta-list">
				<li>生徒一覧と在籍状況の見え方</li>
				<li>週間スケジュールと休校日の管理</li>
				<li>レッスン記録・ヒアリングの残り方</li>
				<li>AIによる月次レポートの下書き</li>
				<li>コーチ向けの権限設定と操作ログ</li>
			</ul>
		</div>
	</div>
</section>

</BaseLayout>

<style>
/* ── Shared ──────────────────────────────────────────── */
.section-eyebrow {
	font-size: 0.8125rem; font-weight: 600; color: var(--color-primary);
	letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 0.75rem;
}
.btn--lg { padding: 1.0625rem 1.875rem; font-size: 1rem; }

/* ── Hero ──────────────────────────────────────────── */
.hero {
	background: linear-gradient(180deg, var(--color-bg-subtle) 0%, var(--color-bg) 100%);
	border-bottom: 1px solid var(--color-border);
	padding-block: var(--space-2xl) var(--space-xl);
}
.eyebrow {
	display: inline-flex; align-items: center; gap: 0.5rem;
	font-size: 0.8125rem; font-weight: 600; color: var(--color-primary);
	background: rgba(30,64,175,0.08); padding: 0.375rem 0.875rem; border-radius: 4px;
	letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 1.25rem;
}
.eyebrow__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-primary); display: inline-block; }
.hero h1 {
	font-size: clamp(2.25rem, 4vw, 3.25rem); font-weight: 600;
	letter-spacing: 0.01em; margin: 0 0 1rem; color: var(--color-text); line-height: 1.25;
}
.hero-edition {
	display: inline-block; margin-left: 0.75rem; vertical-align: 0.35em;
	font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em;
	color: var(--color-primary); background: rgba(30,64,175,0.08);
	padding: 0.25rem 0.7rem; border-radius: 4px;
}
.hero-lead { font-size: 1.125rem; line-height: 1.8; color: var(--color-text-muted); max-width: 740px; margin: 0 0 2rem; }
.hero-lead strong { color: var(--color-text); font-weight: 700; }
.hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.hero-switch { margin: 1.5rem 0 0; font-size: 0.9375rem; color: var(--color-text-muted); }
.hero-switch a { color: var(--color-primary); font-weight: 700; text-decoration: none; border-bottom: 1px solid currentColor; }
.hero-note { font-size: 0.8125rem; color: var(--color-text-muted); margin: 0.75rem 0 0; }

.btn--hero-primary {
	display: inline-flex; align-items: center;
	background: var(--color-primary); color: #fff;
	padding: 1.0625rem 1.875rem; border-radius: var(--radius);
	font-weight: 700; font-size: 1rem; text-decoration: none; border: none;
	transition: background 0.15s ease;
}
.btn--hero-primary:hover { background: var(--color-primary-dark); color: #fff; }
.btn--hero-outline {
	display: inline-flex; align-items: center;
	background: transparent; color: var(--color-primary);
	padding: 1.0625rem 1.875rem; border-radius: var(--radius);
	font-weight: 600; font-size: 1rem; text-decoration: none;
	border: 1.5px solid var(--color-primary);
	transition: all 0.15s ease;
}
.btn--hero-outline:hover { background: rgba(30,64,175,0.06); }

/* ── Positioning ───────────────────────────────────── */
.positioning {
	background: var(--color-bg-subtle);
	border-bottom: 1px solid var(--color-border);
	padding-block: var(--space-xl);
}
.pos-body { max-width: 760px; }
.pos-lead {
	font-size: 1.125rem; font-weight: 600; line-height: 1.8;
	color: var(--color-text); margin: 0 0 1.25rem;
	padding-left: 1rem; border-left: 3px solid var(--color-primary);
}
.pos-body p { font-size: 0.9375rem; line-height: 1.9; color: var(--color-text-muted); margin: 0 0 1rem; }
.pos-body strong { color: var(--color-text); font-weight: 700; }
.pos-link {
	display: inline-block; margin-top: 0.5rem;
	font-size: 0.9375rem; font-weight: 700; color: var(--color-primary);
	text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px;
}

/* ── Problem ───────────────────────────────────────── */
.problem { padding-block: var(--space-2xl); background: var(--color-bg); }
.prob-title { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 700; color: var(--color-text); margin: 0 0 2rem; }
.prob-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
.prob-item {
	border: 1px solid var(--color-border); border-left: 3px solid var(--color-primary);
	border-radius: 0 8px 8px 0; padding: 1.5rem; background: var(--color-bg-subtle);
}
.prob-item p { margin: 0; font-size: 0.9375rem; line-height: 1.8; color: var(--color-text); }

/* ── Screens ───────────────────────────────────────── */
.screens {
	padding-block: var(--space-2xl); background: var(--color-bg-subtle);
	border-top: 1px solid var(--color-border); scroll-margin-top: 80px;
}
.sc-title { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 700; color: var(--color-text); margin: 0 0 2rem; }
.sc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
.sc-card {
	border: 1px solid var(--color-border); border-radius: 8px;
	padding: 1.5rem; background: var(--color-bg);
}
.sc-card h3 { margin: 0 0 0.5rem; font-size: 1rem; font-weight: 700; color: var(--color-primary); }
.sc-card p { margin: 0; font-size: 0.875rem; line-height: 1.75; color: var(--color-text-muted); }

/* ── AI ────────────────────────────────────────────── */
.ai { padding-block: var(--space-2xl); background: var(--color-bg); border-top: 1px solid var(--color-border); }
.ai-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3.5rem; align-items: center; }
.ai-inner h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 700; color: var(--color-text); margin: 0 0 1rem; }
.ai-lead { font-size: 0.9375rem; line-height: 1.9; color: var(--color-text-muted); margin: 0 0 1rem; }
.ai-examples { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
.ai-examples li {
	background: var(--color-bg-subtle); border: 1px solid var(--color-border);
	border-radius: 100px; padding: 0.75rem 1.25rem;
	font-size: 0.9375rem; color: var(--color-text);
}
.ai-examples li::before { content: "「"; color: var(--color-primary); }
.ai-examples li::after { content: "」"; color: var(--color-primary); }

/* ── Roles ─────────────────────────────────────────── */
.roles { padding-block: var(--space-2xl); background: var(--color-bg-subtle); border-top: 1px solid var(--color-border); }
.ro-title { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 700; color: var(--color-text); margin: 0 0 0.75rem; }
.ro-lead { font-size: 1rem; line-height: 1.85; color: var(--color-text-muted); margin: 0 0 2rem; max-width: 720px; }
.ro-list {
	margin: 0; max-width: 720px; border: 1px solid var(--color-border);
	border-radius: 8px; overflow: hidden; background: var(--color-bg);
}
.ro-row {
	display: grid; grid-template-columns: 14rem 1fr; gap: 1.25rem;
	padding: 1rem 1.25rem; align-items: baseline;
}
.ro-row + .ro-row { border-top: 1px solid var(--color-border); }
.ro-row dt { font-size: 0.9375rem; font-weight: 700; color: var(--color-primary); }
.ro-row dd { margin: 0; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.7; }
.ro-note { margin: 1.5rem 0 0; font-size: 0.9375rem; color: var(--color-text-muted); }

/* ── Final CTA ─────────────────────────────────────── */
.final-cta {
	background:
		radial-gradient(800px 360px at 85% -5%, rgba(124,92,191,0.35), transparent 55%),
		linear-gradient(135deg, #1e40af 0%, #1d4ed8 100%);
	color: #fff; padding-block: var(--space-2xl);
}
.cta-inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: 4rem; align-items: center; }
.cta-eyebrow { font-size: 0.8125rem; font-weight: 600; color: #93c5fd; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 1rem; }
.cta-inner h2 { color: #fff; font-size: clamp(1.75rem, 2.5vw, 2.25rem); line-height: 1.3; font-weight: 700; margin: 0 0 1.25rem; }
.cta-lead { color: #bfdbfe; font-size: 1.0625rem; line-height: 1.75; margin: 0 0 2rem; }
.cta-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.btn--cta-primary {
	display: inline-flex; align-items: center; justify-content: center;
	padding: 1.0625rem 1.875rem; border-radius: var(--radius);
	font-weight: 700; font-size: 1rem; text-decoration: none;
	background: #fff; color: var(--color-primary); border: none;
	transition: background 0.15s ease;
}
.btn--cta-primary:hover { background: #e0eaff; color: var(--color-primary); }
.btn--cta-outline {
	display: inline-flex; align-items: center; justify-content: center;
	padding: 1.0625rem 1.875rem; border-radius: var(--radius);
	font-weight: 600; font-size: 1rem; text-decoration: none;
	background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.45);
	transition: all 0.15s ease;
}
.btn--cta-outline:hover { border-color: #fff; background: rgba(255,255,255,0.1); }
.cta-card {
	background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
	border-radius: 8px; padding: 2rem; backdrop-filter: blur(10px);
}
.cta-card h4 { margin: 0 0 1rem; font-size: 0.8125rem; color: #93c5fd; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; }
.cta-list { list-style: none; padding: 0; margin: 0; }
.cta-list li {
	display: flex; gap: 0.75rem; align-items: flex-start;
	padding: 0.5rem 0; font-size: 0.9375rem; color: #e0eaff;
	border-bottom: 1px solid rgba(255,255,255,0.1); line-height: 1.6;
}
.cta-list li:last-child { border-bottom: none; }
.cta-list li::before { content: ""; flex-shrink: 0; margin-top: 9px; width: 5px; height: 5px; border-radius: 50%; background: #93c5fd; }

/* ── Responsive ─────────────────────────────────────── */
@media (max-width: 1024px) { .sc-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 900px) {
	.prob-grid { grid-template-columns: 1fr; }
	.ai-inner, .cta-inner { grid-template-columns: 1fr; gap: 2rem; }
	.ro-row { grid-template-columns: 1fr; gap: 0.25rem; }
}
@media (max-width: 560px) {
	.sc-grid { grid-template-columns: 1fr; }
	.hero-actions, .cta-actions { flex-direction: column; align-items: stretch; }
}
</style>
