---
import { featureCount } from '../../data/crm-features';
import BaseLayout from '../../layouts/BaseLayout.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';

const proofStats = [
	{ figure: '40社以上', label: 'Consilegyが設計してきたB2Bの収益プロセス' },
	{ figure: '175本', label: '標準搭載のRevOpsワークフロー' },
	{ figure: '3言語', label: '日本語 / English / 繁體中文をUIごと切替' },
	{ figure: '掲載', label: 'See News（花蓮視新聞）2026年6月25日' },
];

const journeySteps = [
	{
		label: '顧客情報',
		title: 'Excel・メールから移す',
		text: '会社、担当者、名刺、会話メモを顧客履歴として残します。',
	},
	{
		label: '商談管理',
		title: '進捗と売上見込みを見る',
		text: 'ステージ、金額、確度、次アクションを同じ画面で確認します。',
	},
	{
		label: '追客・更新',
		title: 'フォローを止めない',
		text: '問い合わせ、メール配信、更新期日、停滞通知をワークフローで回します。',
	},
];

const serviceAreas = [
	{
		label: '営業管理',
		title: '顧客・商談・活動履歴',
		text: '顧客、会社、商談、メール、メモをひとつの履歴にまとめます。担当が変わっても、過去の経緯を追える状態を作ります。',
		image: '/images/crm/screen-dashboard.webp',
		alt: 'Revenue CRMのダッシュボード。パイプライン総額、加重フォーキャスト、期限切れタスク、注目の商談を表示している。',
		features: ['顧客・会社管理', '商談カンバン', '活動履歴', '売上見込み'],
	},
	{
		label: '追客',
		title: 'フォーム・メール配信',
		text: '問い合わせ、リスト、メール配信、追客タスクを分けずに扱えます。別のMAツールを足す前に、最初の追客を回せます。',
		image: '/images/crm/screen-deals.webp',
		alt: 'Revenue CRMの商談カンバン。ステージごとに商談カードと金額、確度、クローズ予定日を表示している。',
		features: ['フォーム', 'リスト', 'メール配信', '追客タスク'],
	},
	{
		label: '運用',
		title: 'RevOpsワークフロー',
		text: 'フォロー、更新、停滞、通知の型を標準で用意しています。必要なワークフローをONにして、抜け漏れを人の記憶に寄せません。',
		image: '/videos/revenue-crm-demo.gif',
		alt: 'Revenue CRMの操作デモ。ダッシュボード、商談カンバン、自動化ライブラリ、Jade（AIエージェント）、3言語切替を順に操作している。',
		features: ['175本の標準フロー', '停滞通知', '更新商談', 'タスク作成'],
	},
	{
		label: 'AIエージェント',
		title: 'Jade（AIエージェント）・名刺・通話メモ',
		text: '日本語で検索し、名刺や会話の記録を下書きします。保存と送信の前には、必ず人が確認します。',
		image: '/images/crm/screen-jade.webp',
		alt: 'Jade（AIエージェント）の画面。日本語の質問に対して商談の集計と一覧を返している。',
		features: ['日本語検索', '名刺読み取り', '通話メモ構造化', '下書き確認'],
	},
	{
		label: '多言語',
		title: '日本語・English・繁體中文',
		text: '同じ顧客データを、使う人ごとの言語で表示します。海外メンバーと同じレコードを見ながら会話できます。',
		image: '/images/crm/screen-dashboard-en.webp',
		alt: 'Revenue CRMの英語UI。同じダッシュボードをEnglishに切り替えた画面。',
		features: ['日本語', 'English', '繁體中文', '同一データ'],
	},
];

const outcomes = [
	{
		problem: '顧客リストがExcelとメールに散らばっている',
		answer: '顧客、会社、商談、やりとりが1本の履歴に集まります。',
	},
	{
		problem: '案件の状況が担当者の頭の中にしかない',
		answer: 'ステージ、確度、次アクションをチーム全員が同じ画面で見られます。',
	},
	{
		problem: '来月いくら入るかを毎回手で集計している',
		answer: 'パイプラインから加重フォーキャストが自動で出ます。',
	},
	{
		problem: '受注した後のフォローと契約更新が後手に回る',
		answer: '更新期日と停滞をワークフローが検知して、担当者に通知します。',
	},
	{
		problem: '問い合わせ後の追客がメールと個人メモに埋もれる',
		answer: 'フォーム、リスト、メール配信、追客タスクを同じ場所でつなげます。',
	},
	{
		problem: '海外メンバーと同じ情報を見ているのに、言語が揃わない',
		answer: '同じデータを日本語、English、繁體中文で扱えます。',
	},
];

const safeguards = [
	{
		label: '学習に使われない',
		text: '名刺や手書きの読み取り、文字起こしでは、送信した内容を学習に使わない条件のサービスを利用しています。自社のAPIキーを持ち込んで、送信先を自社契約にすることもできます。',
	},
	{
		label: '他社に見えない',
		text: '会社ごとの隔離は、データベースの行単位のアクセス制御で行っています。アプリ側の絞り込みには頼りません。新しいテーブルへの入れ忘れは、リリース前の自動チェックで止めます。',
	},
	{
		label: '見せる範囲を決められる',
		text: '役割ごとに、誰がどのデータを見て操作できるかを設定できます。誰がいつ何を変更したかは監査ログに残ります。',
	},
	{
		label: '消しても戻せる',
		text: '削除したレコードはゴミ箱に入り、そこから戻せます。データベースは日次でバックアップを取得しています。',
	},
	{
		label: '東京に置いてある',
		text: 'データは東京リージョンに保存しています。海外に出ることはありません。作っているのは日本の会社です。',
	},
	{
		label: '持ち出しは自由',
		text: 'コンタクト、会社、商談をCSVで書き出せます。解約後に取り出せなくなることはありません。自社のデータは自社のものです。',
	},
];

const editions = [
	{
		noun: '商談',
		title: '法人営業',
		text: '見込み客を商談として管理。パイプライン、見積、フォーキャスト、停滞アラートに対応。',
	},
	{
		noun: '案件',
		title: '支援会社・受託開発',
		text: '見積、受注、納品、請求、保守更新までを案件単位で管理。受託開発版として別ページで提供。',
		href: '/crm/contractor/',
		linkLabel: '受託開発版を見る',
	},
	{
		noun: '契約',
		title: 'SaaS代理店・リセラー',
		text: '契約更新、解約リスク、更新商談、クロスセル候補を追跡。代理店版として別ページで提供。',
		href: '/crm/reseller/',
		linkLabel: '代理店版を見る',
	},
	{
		noun: '在籍',
		title: '教室・スクール',
		text: '生徒の在籍、継続、休会、退会を管理。スクール版として別ページで提供。',
		href: '/crm/school/',
		linkLabel: 'スクール版を見る',
	},
];

const reasons = [
	{
		title: '最初の設定が軽い',
		text: 'まだCRMがない会社を前提に、顧客・商談・活動履歴の最初の型を用意しています。',
		href: '#features',
		label: '主な機能を見る',
	},
	{
		title: '記録の入口を増やす',
		text: '名刺は撮る、会話は貼る、通話は話す。Jade（AIエージェント）が記録の下書きと検索を支えます。',
		href: '#input-assist',
		label: 'AIエージェントを見る',
	},
	{
		title: '運用の型が入っている',
		text: '175本のRevOpsワークフローで、追客、フォロー、更新、通知の抜け漏れを減らします。',
		href: '/crm/features/',
		label: '全機能を見る',
	},
];

const faqs = [
	{
		q: 'いま使っているCRMからデータを移行できますか。',
		a: 'Revenue CRMは、まだCRMを持っていない会社のために作っています。Salesforce・HubSpot・kintoneなどがすでに動いている場合は、乗り換えではなく、そのツールを活かした収益プロセスの再設計をご提案します。',
	},
	{
		q: 'デモを見るのに登録は必要ですか。',
		a: 'メールアドレスのみです。パスワードの登録も、審査もありません。法人営業、支援会社・受託開発、SaaS代理店の3つから、近いものを選んでご覧いただけます。',
	},
	{
		q: '日本語以外でも使えますか。',
		a: '日本語、English、繁體中文をボタンひとつで切り替えられます。同じデータを、メンバーごとに別の言語で見られます。',
	},
	{
		q: '料金はいくらですか。',
		a: '1席あたり月額3,000円、10席目からは1席あたり月額2,500円です。初期費用はなく、初回30日間は無料。1席から利用でき、最低利用席数の条件もありません。クローズドβ期間中の条件は個別にご相談させてください。',
	},
];

---

<BaseLayout
	title="国産CRM「Revenue CRM」法人向けβ版 | まだCRMがない会社の最初の1つに"
	description="顧客の一覧はExcel、やりとりはメール、案件の温度感は担当者の頭の中。そういう会社のために、Consilegyが自社で開発した法人向けの国産CRMです。Jade（AIエージェント）と175本のRevOpsワークフローを標準搭載。メールアドレスだけでデモをご覧いただけます。現在クローズドβ。"
	ogImage="/images/crm/og-crm.png"
	lang="ja"
	alternateUrl="/en/crm/"
>

<!-- ===================== 1. HERO ===================== -->
<section class="crm-hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">
				<img class="eyebrow-mark" src="/images/crm/logo/revenue-crm-logo.svg" alt="" width="26" height="26" decoding="async" />
				Revenue CRM法人向けβ版
			</p>
			<h1>まだCRMがない会社のための、<br class="br-wide" />最初のCRMを作りました。</h1>
			<p class="hero-lead">
				顧客の一覧はExcel。やりとりはメール。案件の温度感は担当者の頭の中。
				そういう会社に40社以上入りました。そのたびに、ここに入れられるCRMがない。
				だから、自分たちで作りました。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href="/contact/" class="btn btn--secondary">β参加を相談する</a>
			</div>
			<p class="hero-note">メールアドレスだけで実際の画面に入れます。パスワード登録も営業連絡もありません。</p>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/screen-dashboard.webp"
				alt="Revenue CRMのダッシュボード。パイプライン総額、加重フォーキャスト、勝率、期限切れタスク、ステージ別パイプライン、注目の商談を一画面に表示。"
				width="1600"
				height="1000"
				decoding="async"
				fetchpriority="high"
			/>
			<figcaption>ダッシュボード：最初に見る数字と、次に動く相手を同じ画面で</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 2. PRODUCT STORY ===================== -->
<section class="crm-story">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">Revenue CRMひとつで</p>
			<h2>営業活動の入口から、受注後の更新まで。</h2>
		</div>
		<div class="story-board">
			<div class="story-board__copy">
				<p>
					顧客、商談、追客、更新を別々の表で管理しない。
					最初のCRMに必要な基本機能を、業務の流れに沿ってまとめています。
				</p>
				<ol class="journey-list">
					{journeySteps.map((item) => (
						<li>
							<span>{item.label}</span>
							<strong>{item.title}</strong>
							<p>{item.text}</p>
						</li>
					))}
				</ol>
			</div>
			<figure class="story-board__media">
				<img
					src="/videos/revenue-crm-demo.gif"
					alt="Revenue CRMの操作デモ。ダッシュボード、商談カンバン、自動化ライブラリ、Jade（AIエージェント）、3言語切替を順に操作している。"
					width="800"
					height="585"
					loading="lazy"
					decoding="async"
				/>
			</figure>
		</div>
	</div>
</section>

<!-- ===================== 3. SERVICES ===================== -->
<section class="crm-services" id="features">
	<div class="container">
		<div class="crm-section-head crm-section-head--center">
			<p class="kicker">Revenue CRMのサービス</p>
			<h2>必要な機能を、最初からひとつに。</h2>
		</div>
		<div class="service-area-list">
			{serviceAreas.map((item) => (
				<article class="service-area">
					<div class="service-area__copy">
						<p class="service-area__label">{item.label}</p>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
						<ul class="service-feature-list">
							{item.features.map((feature) => <li>{feature}</li>)}
						</ul>
					</div>
					<figure class="service-area__media">
						<img
							src={item.image}
							alt={item.alt}
							width="1600"
							height="1000"
							loading="eager"
							decoding="async"
						/>
					</figure>
				</article>
			))}
		</div>
		<div class="service-more">
			<p>CRMコアから権限・運用まで、全{featureCount()}項目を整理しています。</p>
			<a href="/crm/features/">機能一覧をすべて見る（全{featureCount()}項目）</a>
		</div>
	</div>
</section>

<!-- ===================== 4. PROBLEMS ===================== -->
<section class="crm-problems">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">課題を解決するならRevenue CRM</p>
			<h2>最初のCRMで、まず解く課題。</h2>
		</div>
		<ol class="problem-table">
			{outcomes.map((item) => (
				<li>
					<strong>{item.problem}</strong>
					<span>{item.answer}</span>
				</li>
			))}
		</ol>
	</div>
</section>

<!-- ===================== 5. EDITIONS ===================== -->
<section class="crm-editions">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">事業タイプ別</p>
			<h2>商売の形に合わせて、最初から設定済み。</h2>
		</div>
		<div class="edition-list">
			{editions.map((item) => (
				<article class="edition-item">
					<span>{item.noun}</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					{item.href && <a href={item.href}>{item.linkLabel}</a>}
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== 6. PROOF ===================== -->
<section class="crm-proof">
	<div class="container">
		<ul class="proof-strip">
			{proofStats.map((item) => (
				<li>
					<strong>{item.figure}</strong>
					<span>{item.label}</span>
				</li>
			))}
		</ul>
		<p class="proof-note">
			※「40社以上」は、Consilegy合同会社がマーケティング・営業・カスタマーサクセス領域で設計支援を行った累計社数です。
			Revenue CRMはクローズドβのため、導入社数は公開していません。
		</p>
	</div>
</section>

<!-- ===================== 7. ADOPTION ===================== -->
<section class="crm-adoption" id="input-assist">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">現場に残る理由</p>
			<h2>入力を増やさず、記録を残す。</h2>
		</div>
		<ol class="adoption-list">
			{reasons.map((item) => (
				<li>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					<a href={item.href}>{item.label}</a>
				</li>
			))}
		</ol>
		<div class="assist-panel">
			<div>
				<p class="kicker">AIエージェント</p>
				<h3>Jadeは、記録の入口です。</h3>
			</div>
			<p>
				日本語で聞く。名刺を撮る。会話を貼る。通話を残す。
				作成された文面やデータは、保存と送信の前に必ず人が確認します。
				APIキーは自社のもの（Anthropic / OpenAI / Gemini / Azure OpenAI）を持ち込めます。
			</p>
		</div>
	</div>
</section>

<!-- ===================== 8. SECURITY ===================== -->
<section class="crm-security">
	<div class="container">
		<div class="crm-section-head">
			<p class="kicker">安心して導入・運用いただくために</p>
			<h2>データは会社ごとに分けて管理します。</h2>
		</div>
		<dl class="security-table">
			{safeguards.map((item) => (
				<div>
					<dt>{item.label}</dt>
					<dd>{item.text}</dd>
				</div>
			))}
		</dl>
		<p class="safe-note">
			詳しくは<a href="/crm/faq/">よくあるご質問</a>のデータとセキュリティをご覧ください。
			2要素認証とシングルサインオンは、現時点では提供していません。
		</p>
	</div>
</section>

<!-- ===================== 9. ORIGIN ===================== -->
<section class="crm-origin">
	<div class="container origin-grid">
		<div class="origin-copy">
			<p class="kicker">開発背景</p>
			<h2>台湾・花蓮のノマド拠点から生まれました。</h2>
			<p>
				構想が形になったのは、台湾・花蓮県が運営するデジタルノマド拠点「Nomad Hualien 花蓮雲基地」です。
				代表の山口聖子が第1期メンバーとして滞在し、各国の起業家やリモートワーカーとの協働から
				CRMにAIエージェントを組み合わせたこのプロダクトの形が固まりました。
			</p>
			<p>
				AIエージェントの名前を「Jade」としたのは、翡翠が花蓮の名産だからです。
				この経緯は、See News（花蓮視新聞）2026年6月25日の記事で紹介されています。
			</p>
			<a
				href="https://www.seenews.com.tw/news_data.php?news_id=2325&amp;k_code=A"
				target="_blank"
				rel="noopener noreferrer"
				class="text-link"
			>掲載記事を読む</a>
		</div>
		<figure class="origin-image">
			<img
				src="/images/common/seenews-hualien-2026.jpg"
				alt="See News（花蓮視新聞）2026年6月25日の掲載記事。花蓮雲基地での活動が紹介されている。"
				width="1000"
				height="1026"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>See News（花蓮視新聞）2026年6月25日掲載</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 10. PRICING ===================== -->
<section class="pricing">
	<div class="container">
		<div class="section-head">
			<p class="kicker">料金</p>
			<h2>使う人の数だけ、席を増やす。</h2>
		</div>
		<div class="price-grid">
			<div class="price-card">
				<p class="price-tier">1〜9席</p>
				<p class="price-figure"><span class="price-yen">¥</span>3,000<span class="price-unit">/ 席 / 月</span></p>
			</div>
			<div class="price-card">
				<p class="price-tier">10席目から</p>
				<p class="price-figure"><span class="price-yen">¥</span>2,500<span class="price-unit">/ 席 / 月</span></p>
			</div>
			<div class="price-note">
				<p>10席目以降だけが2,500円になる累進方式です。9席までの分は3,000円のまま変わりません。</p>
