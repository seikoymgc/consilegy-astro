---
import { featureCount } from '../../../data/crm-features';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrmSubnav from '../../../components/CrmSubnav.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// Same eight-section structure as /crm/. Feature detail lives on /en/crm/features/,
// pricing detail and terms on /en/crm/pricing/, the school edition on /en/crm/school/.

const proofStats = [
	{ figure: '40+', label: 'CRM / MA / SFA implementations supported' },
	{ figure: '175', label: 'RevOps workflows shipped with the product' },
	{ figure: '3', label: 'Languages: 日本語 / English / 繁體中文, UI and all' },
	{ figure: 'Press', label: 'See News (花蓮視新聞), 25 June 2026' },
];

const outcomes = [
	{
		problem: 'The customer list is spread across spreadsheets and inboxes',
		answer: 'Contacts, companies, deals, and correspondence collect into one history.',
	},
	{
		problem: 'Next month’s number gets added up by hand every time',
		answer: 'A weighted forecast comes straight off the pipeline.',
	},
	{
		problem: 'Follow-up and renewals slip once the deal is won',
		answer: 'Workflows catch renewal dates and stalled work, and tell the owner.',
	},
];

// Only the School edition has an English page, so the agency and reseller cards carry no link.
const editions = [
	{
		noun: 'Deals',
		title: 'B2B sales',
		text: 'Manage prospects as deals. Pipeline, quotes, forecast, and stalled-deal alerts.',
		href: '/en/crm/features/',
		linkLabel: `See all ${featureCount()} features`,
	},
	{
		noun: 'Projects',
		title: 'Agencies & contract work',
		text: 'Quote, win, deliver, invoice, and renew maintenance, tracked per project.',
	},
	{
		noun: 'Contracts',
		title: 'SaaS resellers',
		text: 'Track renewals, churn risk, renewal deals, and cross-sell candidates.',
	},
	{
		noun: 'Enrollment',
		title: 'Schools & studios',
		text: 'Manage enrollment, retention, holds, and withdrawals.',
		href: '/en/crm/school/',
		linkLabel: 'See the school edition',
	},
];

const plans = [
	{ tier: 'User plan', for: 'B2B edition. For companies that use the CRM every day.', figure: '3,000', unit: '/ user / month' },
	{ tier: 'Student plan', for: 'School edition (B2C). For schools that run on it every day.', figure: '9,800', unit: '/ month and up' },
	{
		tier: 'Prepaid plan',
		status: 'Coming soon',
		for: 'B2B and School editions. For companies and schools that use it rarely, or more in some months than others.',
		figure: '3,000',
		unit: '/ month',
	},
];

const safeguards = [
	{
		label: 'Never trained on',
		text: 'The outside AI services behind card scanning, handwriting, and transcription are used under terms that exclude what you send from training.',
	},
	{
		label: 'Invisible to other tenants',
		text: 'Companies are separated by row-level access control in the database, not by filtering in the application.',
	},
	{
		label: 'Held in Tokyo',
		text: 'Data is stored in the Tokyo region. It does not leave the country.',
	},
];

const faqs = [
	{
		q: 'What does it cost?',
		a: 'There are three plans. The User plan is ¥3,000 per user per month. The Student plan for schools starts at ¥9,800 per month for up to 50 enrolled students. The Prepaid plan, coming soon, is ¥3,000 per month with 100 Fuel, topped up as needed. No setup fee, and every plan is free of the monthly fee for the first 30 days. All prices exclude tax.',
	},
	{
		q: 'How are users counted?',
		a: 'By the members who have joined the workspace, including accounts that were invited but are not in use. Changes apply from the next invoice.',
	},
	{
		q: 'How do we cancel?',
		a: 'Plans renew monthly. Let us know at least 14 days before your next renewal date. If we hear from you later than that, the contract ends on the renewal date after that one. Payment is monthly in advance, so cancelling mid-month does not refund the remaining days.',
	},
	{
		q: 'Can we take our data out?',
		a: 'Export contacts, companies, and deals to CSV at any time, and for 30 days after the contract ends. It is your data.',
	},
	{
		q: 'Can we migrate from the CRM we use today?',
		a: 'Revenue CRM is built for companies that do not have a CRM yet. If Salesforce, HubSpot, or kintone is already running, we do not recommend switching. We would redesign the revenue process around the tool you already pay for.',
	},
];
---

<BaseLayout
	title="Revenue CRM for B2B (beta) | The first CRM for companies that don't have one yet"
	description="The customer list is a spreadsheet, the correspondence is in an inbox, and who to follow up with next lives in one person's head. Revenue CRM is the CRM Consilegy built for those companies. An AI agent and 175 RevOps workflows ship with it. An email address is enough to open the demo. Currently in closed beta. Launches September 28, 2026."
	ogImage="/images/crm/og-crm-en.png"
	lang="en"
	alternateUrl="/crm/"
>

<CrmSubnav lang="en" />

<!-- ===================== 1. HERO ===================== -->
<section class="crm-hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">
				<img class="eyebrow-mark" src="/images/crm/logo/revenue-crm-logo-teal.svg" alt="" width="26" height="26" decoding="async" />
				Revenue CRM for B2B, in beta
			</p>
			<h1>The first CRM for companies<br class="br-wide" />that don't have one yet.</h1>
			<p class="hero-lead">
				The customer list is a spreadsheet. The correspondence is in an inbox. Who to follow up with
				next lives in one person's head. We took the pattern of a CRM that actually works, learned from
				more than 40 CRM implementations, and made it the first CRM for companies like that.
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">See the demo</a>
				<a href="/en/contact/" class="btn btn--secondary">Talk to us about the beta</a>
			</div>
			<p class="hero-note">An email address opens the real product. No password to set, no sales call.</p>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/screen-dashboard-2026-09-en.webp"
				alt="The Revenue CRM dashboard: open pipeline, weighted forecast, win rate, overdue tasks, and an insights list with suggested next actions, on one screen."
				width="1600"
				height="1000"
				decoding="async"
				fetchpriority="high"
			/>
			<figcaption>Dashboard: the number you read first and the person you move on next, together</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 2. WHAT IT SOLVES ===================== -->
<section class="outcomes" id="problems">
	<div class="container">
		<div class="section-head">
			<p class="kicker">What changes</p>
			<h2>What you do in a spreadsheet today becomes the team's record.</h2>
		</div>
		<ul class="outcome-grid">
			{outcomes.map((item) => (
				<li class="outcome-card">
					<p class="outcome-problem">{item.problem}</p>
					<p class="outcome-answer">{item.answer}</p>
				</li>
			))}
		</ul>
	</div>
</section>

<!-- ===================== 3. USE CASES ===================== -->
<section class="editions" id="use-cases">
	<div class="container">
		<div class="section-head">
			<p class="kicker">Use cases</p>
			<h2>Set up for the shape of your business from the start.</h2>
		</div>
		<div class="edition-grid">
			{editions.map((item) => (
				<article class="edition-card">
					<span class="edition-noun">{item.noun}</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					{item.href && <a href={item.href}>{item.linkLabel}</a>}
				</article>
			))}
		</div>
		<figure class="view-demo">
			<img
				src="/videos/revenue-crm-demo-2026-09-en.gif"
				alt="A walkthrough of Revenue CRM, moving through the dashboard, the deal kanban, the automation library, the AI agent, and the three-language switch."
				width="800"
				height="585"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>Walkthrough: dashboard, deal kanban, automation library, AI agent, language switch</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 4. LESS TYPING ===================== -->
<section class="ai" id="ai">
	<div class="container">
		<div class="section-head">
			<p class="kicker">AI agent</p>
			<h2>Not a CRM you type into. One you ask, photograph, and paste into.</h2>
		</div>
		<p class="ai-lead">
			CRMs stop being used for one reason. Entering data is always the last thing on the list.
			So we took the typing out. The AI agent inside answers when you ask in plain language.
			Cards get photographed, threads get pasted, calls get spoken.
		</p>
		<p class="ai-note">
			Anything AI writes waits for a person before it is saved or sent. Nothing goes out on its own.
			You can bring your own API key (Anthropic / OpenAI / Gemini / Azure OpenAI).
		</p>
		<ul class="proof-grid">
			{proofStats.map((item) => (
				<li>
					<strong>{item.figure}</strong>
					<span>{item.label}</span>
				</li>
			))}
		</ul>
		<p class="proof-note">
			"40+" is the number of companies our founder, Seiko Yamaguchi, has supported on CRM, MA, and SFA
			implementation, including her years as an independent consultant. Revenue CRM is in closed beta, so we do not publish a customer count for it.
		</p>
	</div>
</section>

<!-- ===================== ORIGIN ===================== -->
<section class="crm-origin" id="origin">
	<div class="container origin-inner">
		<div class="origin-copy">
			<p class="kicker">Where it came from</p>
			<h2>Built at a digital nomad hub in Hualien, Taiwan.</h2>
			<p>
				The product took shape at Nomad Hualien (花蓮雲基地), the digital nomad hub run by Hualien County.
				Our founder, Seiko Yamaguchi, stayed there with the first cohort, and the shape of this product,
				CRM and AI together, came out of working alongside founders and remote workers from several countries.
			</p>
			<p>See News (花蓮視新聞) covered the stay and the build in its 25 June 2026 edition.</p>
			<a
				href="https://www.seenews.com.tw/news_data.php?news_id=2325&amp;k_code=A"
				target="_blank"
				rel="noopener noreferrer"
				class="origin-link"
			>Read the article (Traditional Chinese)</a>
		</div>
		<figure class="origin-press">
			<img
				src="/images/common/seenews-hualien-2026-photo.jpg"
				alt="See News (花蓮視新聞) article of 25 June 2026, with a photo of founder Seiko Yamaguchi in front of the Hualien Cloud Hub sign and text on the CRM and AI product she built there."
				width="1000"
				height="1760"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>See News (花蓮視新聞), 25 June 2026</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 5. PRICING ===================== -->
<section class="pricing" id="pricing">
	<div class="container">
		<div class="section-head">
			<p class="kicker">Pricing</p>
			<h2>Three plans. Pick the one that fits how you work.</h2>
		</div>
		<div class="price-grid">
			{plans.map((plan) => (
				<div class="price-card">
					<p class="price-tier">{plan.tier}{plan.status && <span class="price-status">{plan.status}</span>}</p>
					<p class="plan-for">{plan.for}</p>
					<p class="price-figure"><span class="price-yen">&yen;</span>{plan.figure}<span class="price-unit">{plan.unit}</span></p>
				</div>
			))}
			<div class="price-note">
				<p>No setup fee. Every plan is free of the monthly fee for the first 30 days from the day you start.</p>
			</div>
		</div>
		<div class="hero-actions">
			<a href="/en/crm/pricing/" class="btn btn--secondary">Pricing details</a>
		</div>
		<p class="proof-note">All prices exclude consumption tax.</p>
	</div>
</section>

<!-- ===================== 6. SECURITY ===================== -->
<section class="safeguards" id="security">
	<div class="container">
		<div class="section-head">
			<p class="kicker">Your data</p>
			<h2>Read by AI, still yours alone.</h2>
		</div>
		<dl class="safe-list">
			{safeguards.map((item) => (
				<div class="safe-row">
					<dt>{item.label}</dt>
					<dd>{item.text}</dd>
				</div>
			))}
		</dl>
		<p class="safe-note">
			Two-factor authentication and single sign-on are not offered at this stage.
		</p>
	</div>
</section>

<!-- ===================== 7. FAQ ===================== -->
<section class="faq" id="faq">
	<div class="container">
		<div class="section-head">
			<p class="kicker">Questions</p>
			<h2>What people ask before they start.</h2>
		</div>
		<dl class="faq-list">
			{faqs.map((item) => (
				<div class="faq-item">
					<dt>{item.q}</dt>
					<dd>{item.a}</dd>
				</div>
			))}
		</dl>
	</div>
</section>

<!-- ===================== 8. START ===================== -->
<section class="beta" id="start">
	<div class="container">
		<div class="section-head">
			<p class="kicker">Start free</p>
			<h2>The first CRM for a company that has none.</h2>
		</div>
		<div class="cta-head">
			<p>Built for companies moving off spreadsheet-based sales management to their first CRM.</p>
			<p>
				If Salesforce, HubSpot, kintone, or Marketo is already running, don't switch.
				<a href="/en/services/">See how we redesign an existing CRM</a>.
			</p>
		</div>
		<div class="hero-actions">
			<a href={SIGNUP_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">Start free</a>
			<a href={DEMO_URL} class="btn btn--secondary" target="_blank" rel="noopener noreferrer">See the demo</a>
			<a href="/en/contact/" class="btn btn--secondary">Talk to us about the beta</a>
		</div>
	</div>
</section>

</BaseLayout>

<style>
	/* html[lang="en"] の --container は 72ch（記事の読み物幅）。このページは
	   カードを並べるLPなので、そのままだと英文が単語単位で折り返して壊れる。
	   ページ内だけ 1120px に戻す。global.css には触らない。 */
	.container {
		max-width: 1120px;
	}

	.kicker,
	.eyebrow {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: none;
	}

	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		margin: 0;
		color: var(--color-text);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.4;
		text-wrap: balance;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0.8rem 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.25;
		text-decoration: none;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.btn--primary {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
	}

	.btn--primary:hover {
		background: var(--color-primary-dark);
		border-color: var(--color-primary-dark);
		color: #fff;
	}

	.btn--secondary {
		background: transparent;
		color: var(--color-text);
	}

	.btn--secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-lg);
	}

	.crm-hero {
		padding: calc(var(--space-2xl) + 0.5rem) 0 var(--space-xl);
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.25fr) minmax(330px, 0.8fr);
		gap: var(--space-xl);
		align-items: end;
	}

	.hero-copy {
		max-width: 720px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: var(--space-md);
		padding-top: 0.875rem;
		border-top: 1px solid var(--color-border);
	}

	.eyebrow-mark {
		width: 26px;
		height: 26px;
		border-radius: 6px;
		flex-shrink: 0;
	}

	.crm-hero h1 {
		max-width: 100%;
		margin: 0;
		color: var(--color-text);
		font-size: clamp(2rem, 3vw, 2.625rem);
		font-weight: 500;
		line-height: 1.24;
		letter-spacing: -0.01em;
	}

	.hero-lead {
		max-width: 43em;
		margin: var(--space-md) 0 0;
		color: var(--color-text);
		font-size: 1.0625rem;
		line-height: 2;
	}

	.hero-media {
		margin: 0;
		min-width: 0;
	}

	.hero-media img {
		width: 100%;
		height: auto;
		border: 1px solid var(--color-border);
		border-radius: 0;
		background: #fff;
		box-shadow: none;
	}

	.hero-media figcaption {
		margin-top: 0.65rem;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.ai,
	.safeguards,
	.editions,
	.beta {
		padding: var(--space-2xl) 0;
		background: var(--color-bg);
	}

	.ai,
	.beta {
		background: var(--color-bg-subtle);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.section-head {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		gap: var(--space-lg);
		align-items: start;
		margin-bottom: var(--space-lg);
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	.edition-grid {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--color-border);
	}

	.edition-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.edition-card {
		min-width: 0;
		padding: 1.35rem 1.5rem 1.35rem 0;
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--color-border);
		border-radius: 0;
	}

	.edition-card {
		padding-right: var(--space-lg);
	}

	.edition-card:nth-child(even) {
		padding-right: 0;
		padding-left: var(--space-lg);
		border-left: 1px solid var(--color-border);
	}

	.edition-card h3 {
		margin: 0;
		color: var(--color-text);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.55;
	}

	.edition-card p {
		margin: 0.6rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.85;
	}

	.beta .kicker {
		margin-bottom: var(--space-sm);
	}

	.view-demo {
		margin: var(--space-xl) auto 0;
		max-width: 800px;
	}

	.view-demo img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--color-border);
		border-radius: 10px;
		background: #fff;
	}

	.view-demo figcaption {
		margin-top: 0.6rem;
		color: var(--color-text-muted);
		font-size: 0.8125rem;
		line-height: 1.7;
		text-align: center;
	}

	.edition-noun {
		display: block;
		margin: 0 0 0.7rem;
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
	}

	.edition-card a {
		display: inline-flex;
		margin-top: 0.85rem;
		color: var(--color-primary);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
	}

	.beta p {
		margin: 1rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.85;
	}

	@media (max-width: 980px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}

		.crm-hero h1 {
			font-size: 2.75rem;
		}

		.hero-media {
			justify-self: start;
			max-width: 680px;
		}
	}

	@media (max-width: 760px) {
		.crm-hero,
		.editions,
		.beta {
			padding-block: var(--space-xl);
		}

		.section-head,
		.edition-grid {
			grid-template-columns: 1fr;
		}

		.section-head {
			gap: 0.75rem;
		}

		h2 {
			font-size: 1.625rem;
		}

		.crm-hero h1 {
			font-size: 2.25rem;
		}

		.hero-lead {
			font-size: 1rem;
		}

		.edition-card,
		.edition-card:nth-child(even) {
			padding-left: 0;
			padding-right: 0;
			border-left: 0;
		}

		.hero-actions {
			flex-direction: column;
		}

		.btn {
			width: 100%;
		}
	}

	/* ── 2. PROOF band ───────────────────────────────────── */
	.proof-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-md);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.proof-grid li {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding-left: var(--space-md);
		border-left: 2px solid var(--color-border);
	}
	.proof-grid li:first-child { border-left-color: var(--color-primary); }
	.proof-grid strong {
		font-size: clamp(1.35rem, 2.2vw, 1.75rem);
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--color-text);
	}
	.proof-grid span {
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--color-text-muted);
	}
	.proof-note {
		margin: var(--space-md) 0 0;
		font-size: 0.78rem;
		line-height: 1.7;
