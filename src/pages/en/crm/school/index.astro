---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

// Mirrors the JA page at /crm/school/. Only features actually shipped in the product's
// school shell (edition=b2c + shell='school') are listed here.
// LINE integration is still simulated (no live API), so it is deliberately left out.
const screens = [
	{ src: 'students', title: 'Students', desc: 'Trialing, paying, paused, and cancelled in one list. Who is in which state right now, without going to look for it.', alt: 'Students list with Enrolled, Trialing, Graduating, Paused, and Alumni filters and a status badge on each student.' },
	{ src: 'schedule', title: 'Weekly schedule', desc: 'Lessons laid out by the week, linked to the closure calendar.', alt: 'Weekly schedule showing lessons this week, active coaches, and each day\'s lessons with time, student, and coach.' },
	{ src: 'lessons', title: 'Lesson records', desc: 'What was covered in each lesson, accumulated per student. The history stays even when the coach changes.', alt: 'Lesson history listing student, coach, course, and date in order.' },
	{ src: 'calls', title: 'Call tracking', desc: 'Students you need to contact kept separate from students you have not reached yet.', alt: 'Home screen with enrolled count, needs-action count, calls today, retention rate, and a "Needs action now" list of overdue homework and LINE replies.' },
	{ src: 'hearing-ai', title: 'Intake notes', desc: 'Paste a trial-lesson transcript and AI sorts it into fields. A coach edits it before it saves.', alt: 'Intake notes screen with a box to paste a transcript and a Fill with AI button, above filled-in fields for how they found you, background, current level, and their goal.' },
	{ src: 'report', title: 'Monthly reports', desc: 'AI drafts a progress report from that month\'s lesson records and call history. You edit and send instead of writing from scratch.', alt: 'Monthly report screen with an AI draft of the student\'s progress and Regenerate and Finalize buttons.' },
	{ src: 'knowledge', title: 'Knowledge base', desc: 'Teaching policies and operating rules kept as articles, so nothing depends on one person.', alt: 'Knowledge base with FAQ, operating rules, and manuals grouped as article lists.' },
	{ src: 'billing', title: 'Billing', desc: 'See who is paying and whose payment failed. Notice the money that has stopped coming in.', alt: 'Billing screen with MRR, paying and payment-failed counts, and each student\'s subscription with a Paying, Canceled, or Payment failed badge.' },
];

const roles = [
	{ name: 'Owner', scope: 'Everything' },
	{ name: 'Admin', scope: 'Day-to-day operations and permission settings' },
	{ name: 'Manager', scope: 'View and edit their own students and their team’s students' },
	{ name: 'Member (coach)', scope: 'Their own students only' },
];
---

<BaseLayout
	title="Revenue CRM School Edition (Beta) | The state of every student, without going to look for it"
	description="A screen layout built for schools and studios: enrollment status, weekly schedules, lesson records, call tracking, and AI-drafted monthly reports. A mobile-first UI coaches can use between lessons. The same foundation works for any recurring-revenue business. Currently in closed beta."
	lang="en"
	alternateUrl="/crm/school/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://consilegy.com/en/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/en/crm/"},
		{"@type": "ListItem", "position": 3, "name": "School Edition", "item": "https://consilegy.com/en/crm/school/"}
	]
})} />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container">
		<span class="eyebrow"><span class="eyebrow__dot"></span>Product · Closed Beta</span>
		<h1>The state of every student,<br />without going to look for it.<span class="hero-edition">School edition</span></h1>
		<p class="hero-lead">
			The student roster is a spreadsheet, the lesson records are on each coach's own device,
			and payment status is in yet another tool. You have to ask someone to find out where
			things stand. In running a school, that searching is what eats the most time.
			The school edition is <strong>a screen layout that pulls all of it together around the student</strong>.
		</p>
		<div class="hero-actions">
			<a href="/en/contact/" class="btn btn--hero-primary btn--lg">Apply as a beta partner →</a>
			<a href="#screens" class="btn btn--hero-outline btn--lg">See the screens</a>
		</div>
		<p class="hero-switch">Selling to companies instead? <a href="/en/crm/">See the B2B edition →</a></p>
		<p class="hero-note">* Currently in closed beta. We are looking for a small number of partners to build this with. Features may change without notice.</p>
	</div>
</section>

<!-- ===================== DEMO ===================== -->
<section class="demo">
	<div class="container">
		<div class="demo-frame">
			<img
				src="/videos/school-demo-en.gif"
				alt="The school edition in the English UI. The home screen shows enrolled student count, students needing attention, and retention rate; the student list is filtered by enrolled and trialing; a student detail page shows the assigned coaches and lesson history; the menu leads to billing, the weekly schedule, and the AI assistant; and finally the UI switches to Traditional Chinese and back to English."
				width="820"
				height="462"
				loading="lazy"
				decoding="async"
			/>
		</div>
		<p class="demo-caption">The actual screens: home → student list → student detail → menu → language switch.</p>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">
				What you are following is not "can we close this,"<br />
				but "will they still be coming next month."
			</p>
			<p>
				So the three things at the center are <strong>students, lessons, and coaches</strong>.
				Not just whether someone is enrolled, but who took what and when, and how far along they are.
			</p>
			<p>
				The screens are built <strong>mobile first</strong>. The priority was a coach being able
				to open it between the classroom and the train, record what just happened, and check
				who is next, right there.
			</p>
			<p>
				The same foundation works for any business built on recurring payments, such as
				subscriptions and repeat orders. The student, lesson, and coach parts come out, and
				it becomes a setup that watches contracts and retention only. Get in touch.
			</p>
			<a href="/en/services/revenue-architecture-design/" class="pos-link">Read about this approach →</a>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<p class="section-eyebrow">The problem</p>
		<h2 class="prob-title">What drives retention is scattered around the school.</h2>
		<div class="prob-grid">
			<div class="prob-item">
				<h3>You find out after they leave</h3>
				<p>Absences, unanswered messages, a failed payment, a change in how they reply. You notice once they have already quit.</p>
			</div>
			<div class="prob-item">
				<h3>Handover lives in one person</h3>
				<p>When the coach changes, what happened last time, what the guardian said, and what to watch next all go with them.</p>
			</div>
			<div class="prob-item">
				<h3>Enrollment and billing become month-end work</h3>
				<p>Enrolled, on hold, withdrawn, paid. Counted again in a spreadsheet at the end of every month.</p>
			</div>
		</div>

		<figure class="prob-shot">
			<img
				src="/images/common/school-student-detail-en.jpg"
				alt="The student detail screen in the school edition. Start date, call streak, and monthly fee, the four assigned coaches and their roles (main, sub 1, sub 2, director), and a timeline of lesson history all sit on one screen."
				width="1100"
				height="744"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>
				One screen for one student. <strong>Who is responsible, what was done and when, and how it progressed</strong> all on a single page.
				When the coach changes, opening this screen tells the whole story.
			</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<p class="section-eyebrow">Screens</p>
		<h2 class="sc-title">Everything you need, organized around the student.</h2>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img
							src={`/images/crm/school/en/screen-${s.src}.webp`}
							alt={s.alt}
							width="1600"
							height="1000"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<h3>{s.title}</h3>
					<p>{s.desc}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== AI ===================== -->
<section class="ai">
	<div class="container ai-inner">
		<div>
			<p class="section-eyebrow">AI</p>
			<h2>Ask in plain language, get an answer.</h2>
			<p class="ai-lead">
				You do not have to build a report to find something out. Ask the question as you
				would say it, and it searches the student data and answers on the spot.
			</p>
			<p class="ai-lead">
				Monthly progress reports are drafted per student too, from that month's lesson records
				and call history. Counts come from the data as they are, and a month with too little
				recorded is left as a list of records rather than written up.
			</p>
			<p class="ai-lead">
				Paste a trial-lesson transcript and it sorts what was said into fields: how they found
				you, their level, what they are aiming for, and what the trial exposed. The writing-up
				afterwards disappears.
			</p>
			<p class="ai-lead">
				Anything AI writes stops at a draft. Nothing reaches a student or a guardian until a
				coach has checked it and finalized it.
			</p>
		</div>
		<ul class="ai-examples">
			<li>Which students need attention today?</li>
			<li>What is this month's retention rate?</li>
			<li>What lessons are scheduled this week?</li>
			<li>List the students we haven't called</li>
		</ul>
	</div>
</section>

<!-- ===================== ROLES ===================== -->
<section class="roles">
	<div class="container">
		<p class="section-eyebrow">Permissions</p>
		<h2 class="ro-title">Coaches see their own students, and no one else's.</h2>
		<p class="ro-lead">
			In schools that work with a lot of contract coaches, how far each person can see is a
			practical problem, not a theoretical one. Scope is set per role.
		</p>
		<dl class="ro-list">
			{roles.map((r) => (
				<div class="ro-row">
					<dt>{r.name}</dt>
					<dd>{r.scope}</dd>
				</div>
			))}
		</dl>
		<p class="ro-note">Actions are logged, so you can trace who changed what and when after the fact.</p>
	</div>
</section>

<!-- ===================== FINAL CTA ===================== -->
<section class="final-cta">
	<div class="container cta-inner">
		<div>
			<p class="cta-eyebrow">Get Started</p>
			<h2>We're looking for schools<br />to build this with.</h2>
			<p class="cta-lead">
				A closed beta is not the stage where a finished product gets sold. It is the stage
				where you use it in real operations, tell us what is missing, and we finish it together.
				In exchange, you get to set the priority of what we build next around how your school runs.
			</p>
			<div class="cta-actions">
				<a href="/en/contact/" class="btn btn--cta-primary btn--lg">Apply as a beta partner →</a>
				<a href="/en/crm/" class="btn btn--cta-outline btn--lg">See the B2B edition</a>
			</div>
		</div>
		<div class="cta-card">
			<h4>What we'll show you</h4>
			<ul class="cta-list">
				<li>The student list and how enrollment status reads</li>
				<li>Weekly scheduling and closure-day management</li>
				<li>How lesson records and intake notes accumulate</li>
				<li>AI-drafted monthly reports</li>
				<li>Permission settings and audit logs for coaches</li>
			</ul>
		</div>
	</div>
</section>

</BaseLayout>

<style>
/* ── Container ───────────────────────────────────────────
   EN サイトは global.css で --container: 72ch（読み物用の狭い段）になっている。
   このLPはカードを4列に並べるので、JA版と同じ 1120px に戻す。
   ページスコープなので他のENページには影響しない。 */
.container { max-width: 1120px; }

/* ── Shared ──────────────────────────────────────────── */
.section-eyebrow {
	font-size: 0.8125rem; font-weight: 600; color: var(--color-primary);
	letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 0.75rem;
}
.btn--lg { padding: 1.0625rem 1.875rem; font-size: 1rem; }

/* ── Hero ──────────────────────────────────────────── */
.hero {
	background: linear-gradient(180deg, var(--color-bg-subtle) 0%, var(--color-bg) 100%);
	border-bottom: 1px solid var(--color-border);
	padding-block: var(--space-2xl) var(--space-xl);
}
.eyebrow {
	display: inline-flex; align-items: center; gap: 0.5rem;
	font-size: 0.8125rem; font-weight: 600; color: var(--color-primary);
	background: rgba(30,64,175,0.08); padding: 0.375rem 0.875rem; border-radius: 4px;
	letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 1.25rem;
}
.eyebrow__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-primary); display: inline-block; }
.hero h1 {
	font-size: clamp(2.25rem, 4vw, 3.25rem); font-weight: 600;
	letter-spacing: 0.01em; margin: 0 0 1rem; color: var(--color-text); line-height: 1.25;
}
.hero-edition {
	display: inline-block; margin-left: 0.75rem; vertical-align: 0.35em;
	font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.08em;
	color: var(--color-primary); background: rgba(30,64,175,0.08);
	padding: 0.25rem 0.7rem; border-radius: 4px;
}
.hero-lead { font-size: 1.125rem; line-height: 1.8; color: var(--color-text-muted); max-width: 740px; margin: 0 0 2rem; }
.hero-lead strong { color: var(--color-text); font-weight: 700; }
.hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.hero-switch { margin: 1.5rem 0 0; font-size: 0.9375rem; color: var(--color-text-muted); }
.hero-switch a { color: var(--color-primary); font-weight: 700; text-decoration: none; border-bottom: 1px solid currentColor; }
.hero-note { font-size: 0.8125rem; color: var(--color-text-muted); margin: 0.75rem 0 0; }

.btn--hero-primary {
	display: inline-flex; align-items: center;
	background: var(--color-primary); color: #fff;
	padding: 1.0625rem 1.875rem; border-radius: var(--radius);
	font-weight: 700; font-size: 1rem; text-decoration: none; border: none;
	transition: background 0.15s ease;
}
.btn--hero-primary:hover { background: var(--color-primary-dark); color: #fff; }
.btn--hero-outline {
	display: inline-flex; align-items: center;
	background: transparent; color: var(--color-primary);
	padding: 1.0625rem 1.875rem; border-radius: var(--radius);
	font-weight: 600; font-size: 1rem; text-decoration: none;
	border: 1.5px solid var(--color-primary);
	transition: all 0.15s ease;
}
.btn--hero-outline:hover { background: rgba(30,64,175,0.06); }

/* ── Positioning ───────────────────────────────────── */
.positioning {
	background: var(--color-bg-subtle);
	border-bottom: 1px solid var(--color-border);
	padding-block: var(--space-xl);
}
.pos-body { max-width: 760px; }
.pos-lead {
	font-size: 1.125rem; font-weight: 600; line-height: 1.8;
	color: var(--color-text); margin: 0 0 1.25rem;
	padding-left: 1rem; border-left: 3px solid var(--color-primary);
}
.pos-body p { font-size: 0.9375rem; line-height: 1.9; color: var(--color-text-muted); margin: 0 0 1rem; }
.pos-body strong { color: var(--color-text); font-weight: 700; }
.pos-link {
	display: inline-block; margin-top: 0.5rem;
	font-size: 0.9375rem; font-weight: 700; color: var(--color-primary);
	text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px;
}

/* ── Problem ───────────────────────────────────────── */
.problem { padding-block: var(--space-2xl); background: var(--color-bg); }
.prob-title { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 700; color: var(--color-text); margin: 0 0 2rem; }
.prob-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
.prob-item {
	border: 1px solid var(--color-border); border-left: 3px solid var(--color-primary);
	border-radius: 0 8px 8px 0; padding: 1.5rem; background: var(--color-bg-subtle);
}
.prob-item h3 {
	margin: 0 0 0.5rem; font-size: 1rem; font-weight: 600;
	line-height: 1.55; color: var(--color-text);
}
.prob-item p { margin: 0; font-size: 0.9375rem; line-height: 1.8; color: var(--color-text); }


/* ── Demo / screenshots ────────────────────────────── */
.demo { padding-block: var(--space-xl); background: var(--color-bg); border-bottom: 1px solid var(--color-border); }
.demo-frame {
	max-width: 900px; margin: 0 auto;
	border: 1px solid var(--color-border); border-radius: 12px;
	overflow: hidden; background: var(--color-bg-subtle);
	box-shadow: var(--shadow-md);
}
.demo-frame img { width: 100%; height: auto; display: block; }
.demo-caption { margin: 0.875rem auto 0; max-width: 640px; text-align: center; font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.7; }

.prob-shot { margin: 2.5rem 0 0; max-width: 900px; }
.prob-shot img {
	width: 100%; height: auto; display: block;
	border: 1px solid var(--color-border); border-radius: 10px;
	box-shadow: var(--shadow-sm);
}
.prob-shot figcaption {
	margin-top: 0.875rem; font-size: 0.9375rem; line-height: 1.8; color: var(--color-text-muted);
}
.prob-shot strong { color: var(--color-text); font-weight: 700; }

/* ── Screens ───────────────────────────────────────── */
.screens {
	padding-block: var(--space-2xl); background: var(--color-bg-subtle);
	border-top: 1px solid var(--color-border); scroll-margin-top: 80px;
}
.sc-title { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 700; color: var(--color-text); margin: 0 0 2rem; }
.sc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
.sc-card {
	border: 1px solid var(--color-border); border-radius: 8px;
	padding: 1rem 1rem 1.25rem; background: var(--color-bg);
}
.sc-shot { margin: 0 0 0.9rem; overflow: hidden; border: 1px solid var(--color-border); border-radius: 8px; background: #fff; box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07); }
.sc-shot img { display: block; width: 100%; height: auto; }
.sc-card h3 { margin: 0 0 0.5rem; font-size: 1rem; font-weight: 700; color: var(--color-primary); }
.sc-card p { margin: 0; font-size: 0.875rem; line-height: 1.75; color: var(--color-text-muted); }

/* ── AI ────────────────────────────────────────────── */
.ai { padding-block: var(--space-2xl); background: var(--color-bg); border-top: 1px solid var(--color-border); }
.ai-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3.5rem; align-items: center; }
.ai-inner h2 { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 700; color: var(--color-text); margin: 0 0 1rem; }
.ai-lead { font-size: 0.9375rem; line-height: 1.9; color: var(--color-text-muted); margin: 0 0 1rem; }
.ai-examples { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.75rem; }
.ai-examples li {
	background: var(--color-bg-subtle); border: 1px solid var(--color-border);
	border-radius: 100px; padding: 0.75rem 1.25rem;
	font-size: 0.9375rem; color: var(--color-text);
}
.ai-examples li::before { content: "“"; color: var(--color-primary); }
.ai-examples li::after { content: "”"; color: var(--color-primary); }

/* ── Roles ─────────────────────────────────────────── */
.roles { padding-block: var(--space-2xl); background: var(--color-bg-subtle); border-top: 1px solid var(--color-border); }
.ro-title { font-size: clamp(1.5rem, 2.5vw, 2rem); font-weight: 700; color: var(--color-text); margin: 0 0 0.75rem; }
.ro-lead { font-size: 1rem; line-height: 1.85; color: var(--color-text-muted); margin: 0 0 2rem; max-width: 720px; }
.ro-list {
	margin: 0; max-width: 720px; border: 1px solid var(--color-border);
	border-radius: 8px; overflow: hidden; background: var(--color-bg);
}
.ro-row {
	display: grid; grid-template-columns: 14rem 1fr; gap: 1.25rem;
	padding: 1rem 1.25rem; align-items: baseline;
}
.ro-row + .ro-row { border-top: 1px solid var(--color-border); }
.ro-row dt { font-size: 0.9375rem; font-weight: 700; color: var(--color-primary); }
.ro-row dd { margin: 0; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.7; }
.ro-note { margin: 1.5rem 0 0; font-size: 0.9375rem; color: var(--color-text-muted); }

/* ── Final CTA ─────────────────────────────────────── */
.final-cta {
	background:
		radial-gradient(800px 360px at 85% -5%, rgba(124,92,191,0.35), transparent 55%),
		linear-gradient(135deg, #1e40af 0%, #1d4ed8 100%);
	color: #fff; padding-block: var(--space-2xl);
}
.cta-inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: 4rem; align-items: center; }
.cta-eyebrow { font-size: 0.8125rem; font-weight: 600; color: #93c5fd; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 1rem; }
.cta-inner h2 { color: #fff; font-size: clamp(1.75rem, 2.5vw, 2.25rem); line-height: 1.3; font-weight: 700; margin: 0 0 1.25rem; }
.cta-lead { color: #bfdbfe; font-size: 1.0625rem; line-height: 1.75; margin: 0 0 2rem; }
.cta-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.btn--cta-primary {
	display: inline-flex; align-items: center; justify-content: center;
	padding: 1.0625rem 1.875rem; border-radius: var(--radius);
	font-weight: 700; font-size: 1rem; text-decoration: none;
	background: #fff; color: var(--color-primary); border: none;
	transition: background 0.15s ease;
}
.btn--cta-primary:hover { background: #e0eaff; color: var(--color-primary); }
.btn--cta-outline {
	display: inline-flex; align-items: center; justify-content: center;
	padding: 1.0625rem 1.875rem; border-radius: var(--radius);
	font-weight: 600; font-size: 1rem; text-decoration: none;
	background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.45);
	transition: all 0.15s ease;
}
.btn--cta-outline:hover { border-color: #fff; background: rgba(255,255,255,0.1); }
.cta-card {
	background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
	border-radius: 8px; padding: 2rem; backdrop-filter: blur(10px);
}
.cta-card h4 { margin: 0 0 1rem; font-size: 0.8125rem; color: #93c5fd; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; }
.cta-list { list-style: none; padding: 0; margin: 0; }
.cta-list li {
	display: flex; gap: 0.75rem; align-items: flex-start;
	padding: 0.5rem 0; font-size: 0.9375rem; color: #e0eaff;
