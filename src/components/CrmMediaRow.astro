---
// 入口ページのブロック用。サムネ左＋タイトル＋矢印の小さい行。
import { articlePath, eyecatchPath, type Article } from '../lib/crm-media';
interface Props { a: Article }
const { a } = Astro.props;
---
<a class="row" href={articlePath(a)}>
  <img src={eyecatchPath(a.data.lang, a.data.slug)} alt="" width="1200" height="630" loading="lazy" />
  <span class="title">{a.data.title}</span>
  <span class="chev" aria-hidden="true">›</span>
</a>

<style>
  .row { display:grid; grid-template-columns:6rem minmax(0,1fr) auto; align-items:center; gap:1rem; text-decoration:none; color:inherit; }
  .row img { width:100%; height:auto; display:block; aspect-ratio:1200/630; object-fit:cover; border-radius:4px; }
  .title { font-size:1rem; font-weight:600; line-height:1.7; color:var(--color-text); }
  .row:hover .title { color:var(--color-primary); } .chev { font-size:1.5rem; color:var(--color-text-muted); }
  @media(max-width:400px) { .row { grid-template-columns:4.5rem minmax(0,1fr); gap:.75rem; } .chev { display:none; } }

</style>
