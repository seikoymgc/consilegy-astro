---
import { insightPhoto } from '../../../lib/editorial-photos';
import NewsletterSidebar from '../../../components/NewsletterSidebar.astro';
import InsightHead from '../../../components/InsightHead.astro';
import InsightByline from '../../../components/InsightByline.astro';
import InsightContents from '../../../components/InsightContents.astro';
import '../../../styles/insight-evidence.css';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const slug = 'sfa-ranking';
const pubDate = '2026-11-19';

const title = "SFAランキングを見る前に、導入条件で6製品を比較する";
const metaTitle = "SFAランキングを見る前に、導入条件で6製品を比較する | Consilegy";
const metaDescription = "SFA（営業支援システム）のランキングと比較。Salesforce、HubSpot、Mazrica Sales、Pipedrive、Zoho CRM、Revenue CRMを、案件を把握したいのか、記録の負担を減らしたいのかという導入条件で比べます。料金の見方とデモの試し方も解説します。";
const category = 'CRM';

const articleSchema = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description: metaDescription,
	datePublished: pubDate,
	dateModified: '2026-11-20',
	author: { '@type': 'Organization', name: 'Consilegy メディア編集部', url: 'https://media.consilegy.com/about/' },
	publisher: { '@type': 'Organization', name: 'Consilegy', url: 'https://consilegy.com' },
	url: `https://consilegy.com/insights/${slug}/`,
	inLanguage: 'ja',
};

const breadcrumbSchema = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'ホーム', item: 'https://consilegy.com/' },
		{ '@type': 'ListItem', position: 2, name: 'コラム', item: 'https://consilegy.com/insights/' },
		{ '@type': 'ListItem', position: 3, name: title, item: `https://consilegy.com/insights/${slug}/` },
	],
};

const headings = [{"id": "営業が記録し上司が支援を決める場面で候補を絞る", "text": "営業が記録し、上司が支援を決める場面で候補を絞る"}, {"id": "sfaランキングは何を集計した順位かを見る", "text": "SFAランキングは、何を集計した順位かを見る"}, {"id": "salesforce十分な予算を持ち権限や業務を作り込みたい場合", "text": "Salesforce：十分な予算を持ち、権限や業務を作り込みたい場合"}, {"id": "hubspot親しみやすい画面と豊富な機能を両立したい場合", "text": "HubSpot：親しみやすい画面と、豊富な機能を両立したい場合"}, {"id": "mazrica-sales案件の動きを見えるようにし営業チームでフォローしたい場合", "text": "Mazrica Sales：案件の動きを見えるようにし、営業チームでフォローしたい場合"}, {"id": "pipedrive案件と次の活動を中心に始めたい場合", "text": "Pipedrive：案件と次の活動を中心に始めたい場合"}, {"id": "zoho-crmaiより基本の顧客商談管理を低予算で使いたい場合", "text": "Zoho CRM：AIより、基本の顧客・商談管理を低予算で使いたい場合"}, {"id": "revenue-crmaiによる記録要約を普段の仕事で比較する場合", "text": "Revenue CRM：AIによる記録・要約を、普段の仕事で比較する場合"}, {"id": "料金は入口の単価と必要な仕事ができる総額を分ける", "text": "料金は入口の単価と、必要な仕事ができる総額を分ける"}, {"id": "デモでは今の案件を使って営業と上司の両方を試す", "text": "デモでは、今の案件を使って営業と上司の両方を試す"}, {"id": "既存システムが使われないなら切り替えの前に原因を分ける", "text": "既存システムが使われないなら、切り替えの前に原因を分ける"}];
---

<BaseLayout
	title={metaTitle}
	description={metaDescription}
	hasTranslation={false}
	ogType="article"
	lang="ja"
>
	<Fragment slot="head">
		<InsightHead schema={articleSchema} />
		<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
	</Fragment>

<div class="article-wrap">

	<header class="article-head container">
		<nav class="breadcrumb" aria-label="パンくずリスト">
			<a href="/">ホーム</a>
			<span aria-hidden="true">›</span>
			<a href="/insights/">コラム</a>
			<span aria-hidden="true">›</span>
			<span aria-current="page">{title}</span>
		</nav>
		<div class="article-meta">
			<span class="article-cat">{category}</span>
		</div>
		<h1>{title}</h1>
		<InsightByline published={articleSchema.datePublished} modified={articleSchema.dateModified} />
		<p><a href="https://media.consilegy.com/about/">Consilegy メディア編集部</a></p>
	</header>

	<article class="article-body container" id="article">

		<InsightContents headings={headings} />
		<div class="article-eyecatch">
			<img src={insightPhoto(slug)} alt="" width="1200" height="630" class="article-eyecatch__img" loading="eager" aria-hidden="true" />
		</div>

<section class="article-section article-lead">
<p>SFA（営業支援システム）のランキングで候補を探している方へ。この記事では総合順位を付けず、導入条件ごとに比較する6製品を整理します。営業支援システムを選ぶなら、最初に「案件を把握したい」のか、「営業が記録する負担を減らしたい」のかを分けてください。案件一覧がきれいに見えても、更新が止まれば判断には使えません。反対に、入力が楽でも、上司が支援すべき案件を見つけられなければ、営業管理は変わりません。</p>
<p>この記事では、Salesforce、HubSpot、Mazrica Sales、Pipedrive、Zoho CRM、Revenue CRMを比較します。対象は、B2Bの営業チームで案件・活動・次の対応を共有したい会社です。販売時点情報や消費者向け購買分析を中心に選ぶ場合とは、比較の前提が異なります。</p>
<p><strong>編集方針・利害関係：</strong> ConsilegyはRevenue CRMを開発・提供しています。以下は各社の公式資料から編集部が整理した比較と、条件別の選定判断です。利用者評価の集計、全製品の実機試験、導入経験に基づく総合ランキングではありません。製品情報と価格の確認日は2026年11月20日です。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="営業が記録し上司が支援を決める場面で候補を絞る">営業が記録し、上司が支援を決める場面で候補を絞る</h2>
<p>営業支援システムの候補は、営業が情報を更新する場面と、その情報を上司が使う場面をつなげて選びます。自社で設定を維持できる範囲も条件に入れます。その条件が違えば、最初に試す製品も変わります。</p>








































<div class="insight-evidence-table" role="region" aria-label="営業が記録し、上司が支援を決める場面で候補を絞る" tabindex="0"><table><thead><tr><th>いま変えたいこと</th><th>比較を始める候補</th><th>選定を左右する条件</th></tr></thead><tbody><tr><td>大企業で、厳しい権限・セキュリティ要件に合わせて作り込みたい</td><td>Salesforce</td><td>ライセンスに加え、カスタマイズ・管理・追加の保護機能に予算を持てるか</td></tr><tr><td>親しみやすい画面と、幅広い機能を両立したい</td><td>HubSpot</td><td>現場が使う操作を試し、必要な機能別製品・利用者の契約枠を含む費用を持てるか</td></tr><tr><td>営業チームで、動いていない案件を見つけてフォローしたい</td><td>Mazrica Sales</td><td>案件ボードの見せ方が営業に合い、最低契約人数・費用を受け入れられるか</td></tr><tr><td>案件の進捗と次の活動を、パイプライン中心に扱いたい</td><td>Pipedrive</td><td>メール連携・自動化など、必要な機能をどのプランで揃えるか</td></tr><tr><td>AIの高度な機能より、基本の顧客・商談管理を低予算で使いたい</td><td>Zoho CRM</td><td>必要な機能が低価格プランに収まるか。AIを追加する場合の条件は何か</td></tr><tr><td>AIによる記録・要約を、普段の業務で試して比較したい</td><td>Revenue CRM</td><td>AI処理の利用枠、業務との適合、契約・個別支援を含む総額</td></tr></tbody></table></div>
<p>これは機能の優劣を採点した表ではありません。たとえば営業だけの案件管理を始めたい会社が、部門横断の仕組みを一度に導入すれば、使い始める前の設定が重くなることがあります。一方、複雑な権限が必要な会社が最初の手軽さだけで選ぶと、必要な統制を後から作り直すことになります。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="sfaランキングは何を集計した順位かを見る">SFAランキングは、何を集計した順位かを見る</h2>
<p>ランキングは候補を知る入口として使えます。ただし、満足度、レビュー数、使いやすさ、資料請求数では、測っているものが違います。</p>
<p>その順位は、自社の導入条件で全製品を比べた結果ではありません。「上位だから選ぶ」より、自社と近い業務・利用方法のレビューを読み、試す候補を見つけるために使う方が役立ちます。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="salesforce十分な予算を持ち権限や業務を作り込みたい場合">Salesforce：十分な予算を持ち、権限や業務を作り込みたい場合</h2>
<p>Salesforceを勧めたい代表的なケースは、企業規模が大きく、厳しい権限・セキュリティ要件に合わせて業務を作り込む会社です。この使い方では、ライセンスだけでなく、カスタマイズと導入後の管理にも十分な予算を持てることが条件になります。</p>
<p>ただし、大企業専用という意味ではありません。Salesforceは<a href="https://www.salesforce.com/jp/small-business/">中堅・中小企業向けの製品</a>も提供しています。会社の規模だけで候補から外さず、必要な設計と運用体制があるかで判断します。</p>
<p><a href="https://www.salesforce.com/jp/sales/pricing/">公式価格表</a>には、営業・サービス・マーケティングなどを含むStarter Suiteと、機能を拡張した上位構成が掲載されています。最も安いプランの価格に、上位の自動化や分析機能まで含まれていると考えてはいけません。</p>
<p>比較では、現在の案件だけでなく、例外になる案件を扱えるかを見ます。たとえば、複数部署が同じ会社へ提案する場合に、誰が何を閲覧・更新するのか。<a href="https://www.salesforce.com/jp/platform/shield/">Salesforce Shield</a>のような監視・暗号化・監査の製品もあるため、必要な保護と追加契約を具体的に照合します。導入するだけで社内のセキュリティ要件を満たすわけではありません。</p>
<p>一方、設定の判断をすべて外部に任せ、営業方法が変わるたびに改修を待つ状態では、柔軟性を日常業務に生かせません。必要な変更を誰が判断し、誰が反映するかまで決められることが、柔軟性を生かす条件です。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="hubspot親しみやすい画面と豊富な機能を両立したい場合">HubSpot：親しみやすい画面と、豊富な機能を両立したい場合</h2>
<p>HubSpotを勧めたいのは、現場が親しみを持って使える画面を重視しながら、機能の幅も求める会社です。画面を触るハードルと、業務を広げるときの選択肢を、両方見たい場合の候補になります。使いやすさの感じ方は人によるため、実際に使う営業担当者の操作で確かめます。</p>
<p><a href="https://www.hubspot.jp/products/crm">HubSpotの顧客データ基盤と製品群</a>には、営業・マーケティング・サービス向けの製品が案内されています。営業だけで完結しない仕事を、共通の顧客情報で扱いたい場合に比較する理由があります。</p>
<p>ここで確認したいのは、「情報が同じ場所にある」ことと「必要な処理を実行できる」ことの違いです。資料請求を確認できても、その後の割り当てや追客まで自動化するには、契約構成の確認が必要です。</p>
<p><a href="https://www.hubspot.jp/pricing/sales">公式価格表</a>では、利用者の契約枠、導入支援、AI処理などの利用枠の条件を確認できます。確認した日本語ページの価格は米ドル表示でした。円換算した最安単価を置くより、必要な機能・利用者・支払期間を揃えた見積もりで比べてください。</p>
<p>営業の案件表だけを置き換えるなら、部門をまたぐ構成の価値を使い切れない可能性があります。すでに問い合わせから営業への受け渡しで情報が欠けているなら、営業機能だけの比較から一歩広げる意味があります。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="mazrica-sales案件の動きを見えるようにし営業チームでフォローしたい場合">Mazrica Sales：案件の動きを見えるようにし、営業チームでフォローしたい場合</h2>
<p>Mazrica Salesは、営業チームで案件を共有し、対応が止まっている案件を見つけたい場合の候補です。<a href="https://help-sales.mazrica.com/ja/articles/4189977-%E6%A1%88%E4%BB%B6%E3%83%9C%E3%83%BC%E3%83%89%E3%81%AE%E8%A1%A8%E7%A4%BA%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6">公式マニュアル</a>では、直近のアクションからの経過によって案件を色分けする仕組みが説明されています。担当者への聞き取りだけに頼らず、確認すべき案件を画面から探す使い方を検討できます。</p>
<p>ただし、記録上の動きがないことと、失注しそうなことは同じではありません。顧客側の決裁待ちなのか、自社の対応が止まっているのかは、記録の中身で確かめます。この区別をした上で、営業のフォローに使えるかを見ます。</p>
<p><a href="https://mazrica.com/product/pricing/">公式料金</a>では、最低契約単位と組織単位の料金も確認します。下の料金比較表に同じ条件で整理しました。</p>
<p>少人数で始める会社には、この最低契約単位が選定を左右します。利用人数が合う会社では、普段の記録から案件を更新し、チームが確認するまでの流れを試すと、導入目的に合うか判断できます。</p>
<p>複数の営業プロセス、API連携、細かな権限が必要なら、対象プランと利用条件を個別に確認します。機能名が製品紹介に載っているだけで、入口のプランに含まれるとは判断しません。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="pipedrive案件と次の活動を中心に始めたい場合">Pipedrive：案件と次の活動を中心に始めたい場合</h2>
<p>Pipedriveは、案件の進捗と日々の活動を中心に比較したい場合の候補です。<a href="https://www.pipedrive.com/ja/pricing">公式価格ページ</a>では、リード・取引・連絡先・予定の管理などが案内されています。</p>
<p>公式の<a href="https://www.pipedrive.com/ja/features/pipeline-management">パイプライン機能</a>では、カンバン表示やドラッグ操作を案内しています。営業の仕事を「どの案件を、次にどう動かすか」から整理したい会社に向く、というのがここでの選定判断です。</p>
<p>試す際は、案件を右へ動かせるかだけで終わらせません。「提案済み」の案件を開き、前回何を約束したか、次に誰が何をするかを確認し、そのまま更新するところまで見ます。案件ボードと活動が分断されていると、進捗を確認するたびに担当者へ聞く仕事が残るからです。</p>
<p>メール同期や自動化まで使うなら、入口のLiteだけで費用を判断せず、Growthなど必要な機能を含むプランで比較します。パイプラインの扱いが目的に合うことと、マーケティングから受注後まで必要な業務が揃うことは、別の評価です。</p>
<p>まず営業の仕事を揃えたい会社には、試す理由があります。部門横断の統合が主目的なら、追加する仕組みや連携も含めて比較します。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="zoho-crmaiより基本の顧客商談管理を低予算で使いたい場合">Zoho CRM：AIより、基本の顧客・商談管理を低予算で使いたい場合</h2>
<p>Zoho CRMを勧めたいのは、高度なAI機能を選定の中心に置かず、まず顧客・商談管理を低予算で使いたい会社です。AIまで含めた費用と、基本機能を使う費用を分けて比較します。</p>
<p><a href="https://www.zoho.com/jp/crm/comparison.html">公式比較表</a>では、年間契約の場合、スタンダードは1人月額換算1,760円、エンタープライズは5,660円、いずれも税別です。予測ビルダーなどのAI機能には上位プランの条件があります。必要なAI機能がどのプランに含まれるかは、機能ごとの欄で確認します。</p>
<p>基本の顧客管理で十分なら、低価格プランを比較する意味があります。AIが導入の主目的なら、必要な機能のプラン・人数・日本語対応を先に確認します。公式比較表にもデータセンターによる差異の注意書きがあるため、契約前に自社の評価環境で確かめてください。</p>
<p>上位プランが必要になることと、他社より高額であることは別です。AIを含めた費用対効果は、同じ処理・利用人数の構成を揃えて比べます。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="revenue-crmaiによる記録要約を普段の仕事で比較する場合">Revenue CRM：AIによる記録・要約を、普段の仕事で比較する場合</h2>
<p>Revenue CRMは、Consilegyが提供する顧客管理・営業支援システムです。<a href="https://consilegy.com/crm/features/">公開機能一覧</a>では、日本語での検索・作成指示、音声やメモからの記録、AIによる要約・下書きなどを案内しています。AI機能の掲載だけで利用条件まで同じとは判断せず、処理ごとの利用枠と契約条件を確認します。</p>
<p>AIによる記録・要約が、自社の入力作業をどう変えるかを試す際の比較対象になります。これは公開機能からの編集上の整理であり、第三者が効果を検証したという意味ではありません。初心者に向くことや、他製品より使いやすいことも、この機能一覧だけでは判断できません。</p>
<p>自社製品だからという理由で、既存システムからの入れ替えを勧めるものではありません。すでに必要な情報が揃い、現場が使っているなら、移行で失うものも比較してください。複雑な既存連携や統制要件がある場合も、対応範囲を個別に確かめる必要があります。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="料金は入口の単価と必要な仕事ができる総額を分ける">料金は入口の単価と、必要な仕事ができる総額を分ける</h2>
<p>以下は2026年11月20日に公式ページで確認した有料プランの表示例です。機能・税・契約条件が違うため、金額の小さい順が製品の優劣を示すものではありません。HubSpotとPipedriveは公式の米ドル表示を残し、為替換算による見かけの安さで比較しないようにしています。</p>








































<div class="insight-evidence-table" role="region" aria-label="料金は入口の単価と、必要な仕事ができる総額を分ける" tabindex="0"><table><thead><tr><th>製品・公式価格表</th><th>表示価格の例</th><th>総額を比べるときの条件</th></tr></thead><tbody><tr><td><a href="https://www.salesforce.com/jp/sales/pricing/">Salesforce</a></td><td>Starter Suite：1人月額3,000円。月払いまたは年払いの表示</td><td>高度な設計・自動化・保護機能は対象プランと追加契約を確認。入口価格で全要件を見積もらない</td></tr><tr><td><a href="https://www.hubspot.jp/pricing/sales">HubSpot Sales Hub</a></td><td>Starter：1シート月額US$7からの新規顧客向け割引表示、US$20も併記（値引きは新規顧客のみ）</td><td>契約・請求期間と割引適用を確認。Professionalには別途必須の導入支援費US$1,500。Hubとシートの構成も揃える</td></tr><tr><td><a href="https://mazrica.com/product/pricing/">Mazrica Sales</a></td><td>Starter：最低月額70,000円（税抜）</td><td>6,500円×10IDと組織単位のSales Agent料金5,000円を含む。少人数でも最低契約単位で比較する</td></tr><tr><td><a href="https://www.pipedrive.com/ja/pricing">Pipedrive</a></td><td>Lite：1シート月額換算US$14、年間US$168一括払い。VAT別</td><td>メール同期・自動化はGrowthなど対象プランを確認。米ドルの表示価格をそのまま円の単価と比べない</td></tr><tr><td><a href="https://www.zoho.com/jp/crm/comparison.html">Zoho CRM</a></td><td>スタンダード：1人月額換算1,760円、年間契約・税抜</td><td>エンタープライズは同条件で5,660円。必要なAI機能の対象プラン・人数・言語を確認</td></tr><tr><td><a href="https://consilegy.com/crm/pricing/">Revenue CRM</a></td><td>ユーザープラン：1人月額3,000円、税抜</td><td>1年契約・途中解約なし。AI処理の利用枠と追加購入、有償の個別支援を含めて比較する</td></tr></tbody></table></div>
<p>Revenue CRMのユーザープランには毎月1人30燃料、最低100燃料が付与され、追加は税抜3,000円で400燃料です。「燃料」はAI処理などに使う利用枠で、人が画面を操作するだけでは減りません。プリペイドプランでは追加単価や基本的な自動処理の扱いが異なるため、ユーザープランと混同しないでください。ソフトウェアの初期費用はなく、個別の初期設定支援は希望に応じて税抜120,000円からです。これらは<a href="https://consilegy.com/crm/pricing/">公式料金ページ</a>で区別されています。</p>
<p>たとえば、閲覧だけの上司と、案件を編集する営業では必要な契約枠が異なることがあります。HubSpotのシートは利用者に割り当てる契約枠で、種類によって使える機能・操作が異なります。人数だけでなく、誰が何をするかを揃えて見積もります。</p>
<p><a href="https://community.hubspot.com/t/can-i-restore-legacy-free-seats-after-upgrading-plans-in-hubspot/142891">HubSpot Communityの2025年11月19日の相談</a>では、旧無料契約から有料契約へ移った後、他のメンバーが閲覧専用になり業務に支障が出たと投稿されています。これは個別契約の利用者申告で、現行プラン全体の問題を示す調査ではありません。比較では、人数の合計だけを揃えても操作権限まで同じにならない例として読みます。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="デモでは今の案件を使って営業と上司の両方を試す">デモでは、今の案件を使って営業と上司の両方を試す</h2>
<p>製品ごとに用意されたデモだけでは、違いが見えにくくなります。自社の同じ案件を使い、営業が記録し、その情報で上司が支援を決めるところまでを比べてください。顧客の機密情報は持ち込まず、必要に応じて匿名化したサンプルを使います。</p>
<p>たとえば、提案後に顧客から返答を待っている案件。営業が面談の内容を残したとき、次の連絡日や確認事項を別の表へ書き直さずに済むか。上司はその記録から、価格の相談が必要なのか、意思決定者への接点が足りないのかを判断できるか。この一往復で、自社が求める使い方に合うかを見ます。</p>
<p>Consilegy代表の山口聖子は<a href="https://note.com/seiko_consilegy/n/n8d0fcb5ff641">顧客管理システムの導入についての公開文章</a>で、慣れた表と新しい画面を並べ、共通点を残しながら不要なものを減らす考えを述べています。比較でも、現場が今どのように仕事を終えているかを基準にすると、単なる新機能の見学で終わりません。</p>
<p>使い慣れた方法をすべて残す必要はありません。ただし、置き換える操作が何の役に立っていたかを知らないまま消すと、現場は別の表で補います。その結果、システムへの記録だけが追加作業になります。</p>

</section>
<hr class="article-hr" />
<section class="article-section">
<h2 id="既存システムが使われないなら切り替えの前に原因を分ける">既存システムが使われないなら、切り替えの前に原因を分ける</h2>
<p>記録が古い原因が、不要な入力項目や二重報告であれば、製品を替えて同じ運用を作っても改善しません。一方、必要な連携や権限を現行の契約構成で実現できず、追加費用や維持の負担が大きすぎるなら、切り替えを比較する理由があります。</p>
<p>営業支援システムの選定は、人気製品を決める作業ではありません。営業が残せる記録で、次の商談と上司の支援が変わる製品を選ぶ作業です。</p>
<p>比較を始めるなら、今困っている案件を一つ選び、その案件の更新から確認までを候補製品で試してください。すでに導入済みで、切り替えと運用改善のどちらが必要か迷う場合は、<a href="https://consilegy.com/services/sfa-adoption-support/">ConsilegyのSFA定着支援</a>で、現行環境を前提に整理できます。</p>
</section>
