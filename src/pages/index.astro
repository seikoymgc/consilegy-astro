---
import { insightPhoto } from '../lib/editorial-photos';
import PhotoIntro from '../components/PhotoIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles } from '../data/insights';

// 最新コラムはコラム一覧の先頭5件。一覧に足せばトップも追従する。
// PCは先頭が2列幅なので、5件で2行がちょうど埋まる（3件だと2行目に1枚だけ残る）。スマホは3件まで。
const insightsPosts = articles.slice(0, 5);
import NewsLatest from '../components/NewsLatest.astro';
import { commonProblems } from '../data/common-problems';
import { getServiceGuide } from '../data/service-guide';
import { timeTables, timeSavedNote } from '../data/crm-time-saved';

const CRM_SIGNUP_URL = 'https://crm.consilegy.com/signup';
---

<BaseLayout
	title="売上が伸びる。仕事が楽になる。「あの人しか知らない」が、なくなる。 | Consilegy"
	description="「顧客情報がスプレッドシートとメールにしかない」「入れたはずのMA/SFAに入力されない」。原因は営業力ではなく、収益構造の設計にあります。Salesforce・HubSpot・kintone・MarketoとAIを組み合わせ、マーケ・営業・CSをつなぐ収益プロセスを設計し、現場で回るところまで伴走します。CRM / MA / SFAの導入支援実績40社以上。"
	lang="ja"
>
	<link
		rel="preload"
		as="image"
		href="/images/common/hero-visual.webp"
		type="image/webp"
		fetchpriority="high"
		slot="head"
	/>
	<script slot="head">
		if (window.location.pathname === '/' || window.location.pathname === '') {
			const pref = localStorage.getItem('languagePreference');
			if (!pref) {
				const lang = navigator.language || 'ja';
				if (!lang.toLowerCase().startsWith('ja')) {
					window.location.replace('/en/');
				}
			}
		}
	</script>

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="hero-bg" aria-hidden="true">
		<div class="hero-orb hero-orb--1"></div>
		<div class="hero-orb hero-orb--2"></div>
		<div class="hero-grid"></div>
	</div>
	<div class="container hero-inner">
		<div class="hero-copy">
			<h1 class="hero-h1--v2">
				売上が伸びる。<br />
				仕事が楽になる。<br />
				<span class="hero-phrase hero-phrase--hang">「あの人しか知らない」が、</span><span class="hero-phrase">なくなる。</span>
			</h1>
			<p class="hero-lead hero-lead--short">
				集客から受注、成約後のフォローまで。マーケティング・営業・顧客対応の進め方と、それを支える仕組み（業務フロー・システム・AI）を設計し、定着まで支援します。
			</p>
			<div class="hero-actions">
				<a href="/contact/" class="btn btn--cta btn--lg">お問い合わせ</a>
				<a href="/download/" class="btn btn--hero-outline btn--lg">資料ダウンロード</a>
			</div>
			<p class="hero-proof">顧客管理やマーケ・営業の仕組みづくり 代表の支援実績 <strong>40社以上</strong></p>
		</div>

	</div>
</section>


<!-- ===================== ENTRY（入口2つ：ファーストビューの直下） ===================== -->
<section class="entry-band">
	<div class="container">
		<div class="hero-entries hero-entries--band" aria-label="あなたの会社はどちらですか">
			<a href="/crm/" class="hero-entry">
				<span class="hero-entry__tag">まだ仕組みがない</span>
				<span class="hero-entry__for">従業員100名までの会社向け</span>
				<span class="hero-entry__state">AIと仕組みが代わりに働く、入力がめんどくさくない顧客管理システム。</span>
				<span class="hero-entry__cta">Revenue CRM →</span>
			</a>
			<a href="/services/" class="hero-entry hero-entry--consulting">
				<span class="hero-entry__tag">仕組みを変えたい</span>
				<span class="hero-entry__for">従業員20〜300名の会社向け</span>
				<span class="hero-entry__state">今のツールで、マーケと営業の連携を直す。</span>
				<span class="hero-entry__cta">支援サービス →</span>
				<span class="hero-entry__tools" aria-label="対応ツールの一例">
					<span>Salesforce</span><span>HubSpot</span><span>kintone</span><span>Marketo</span><span>ServiceNow</span><span>Zoho CRM</span><span>Tableau / Looker</span>
				</span>
			</a>
		</div>
	</div>
</section>

<!-- ===================== MISSION（志。会社概要の「Our Mission」と同じ言葉を使う） ===================== -->
<section class="mission-strip mission-strip--photo" aria-labelledby="mission-strip-title">
	<div class="mission-photo" aria-hidden="true"></div>
	<div class="container mission-strip__inner">
		<div class="mission-strip__body">
			<p class="section-eyebrow">Our Mission</p>
			<h2 id="mission-strip-title">社会に、<span class="mission-strip__phrase">選択肢を増やす。</span></h2>
			<p>時間に余白ができると、いろいろなことを試せます。試せると、自分は選べるのだと分かる。自分の未来を選べたとき、人は未来にワクワクできます。</p>
			<p>だからConsilegyは、売上と仕事の仕組みを整えて、会社とそこで働く人に余白をつくります。</p>
			<a href="/company/" class="mission-strip__link">会社とミッションについて →</a>
		</div>
	</div>
	<img class="mission-photo--sp" src="/images/common/mission-choices-2026-11c-800.webp" alt="空に浮かぶたくさんのガラスの箱を、広場の人々が見上げるイメージ（生成画像）" width="800" height="520" loading="lazy" decoding="async" />
</section>

<NewsLatest lang="ja" />

<!-- ===================== PROBLEMS（こんなお悩みありませんか） ===================== -->
<section class="why problems-section">
	<div class="container">
		<PhotoIntro subject="consultation" lang="ja" priority={false}>
<header class="problems-overview">
			<div class="why-head">
				<p class="section-eyebrow">Common Problems</p>
				<h2>こんなことで、<br /><span class="text-emph">困っていませんか。</span></h2>
				<p class="section-lead">困りごとに合わせて、必要な支援をご案内します。</p>
			</div>
		</header>
</PhotoIntro>
		<div class="problem-rows">
			{commonProblems.map((item, i) => (
				<article class="problem-row">
					<div><p class="problem-num">{String(i + 1).padStart(2, '0')}</p><h3>{item.problem}</h3></div>
					<div class="problem-response">
						<p class="problem-text">{item.response}</p>
						<ul class="problem-services">
							{item.services.map((slug) => <li><a href={`/services/${slug}/`}>{getServiceGuide(slug).name} →</a></li>)}{(item.links ?? []).map((l) => <li><a href={l.href}>{l.label} →</a></li>)}
						</ul>
					</div>
				</article>
			))}
		</div>
		<p class="problems-more"><a href="/services/#needs" class="btn btn--outline-primary">支援内容を見る →</a></p>
	</div>
</section>

<!-- ===================== REVENUE CRM（AI。表は /crm/ と共通の data/crm-time-saved.ts。試算の注記を必ず出す） ===================== -->
<section class="home-crm" aria-labelledby="home-crm-title">
	<div class="container">
		<div class="home-crm__top">
			<header class="home-crm__head">
				<p class="section-eyebrow">Revenue CRM</p>
				<h2 id="home-crm-title">AIが代わりに働く、<span class="home-crm__name">Revenue CRM</span></h2>
				<p class="section-lead">入力がめんどくさくない、新時代の顧客管理・営業支援システムです。名刺は撮るだけ、商談のあとは話すだけ、議事録は貼るだけ。記録はAIが下書きし、人が確かめて保存します。従業員100名までの会社向けです。</p>
				<div class="home-crm__actions">
					<a href="/crm/" class="btn btn--cta">Revenue CRMを見る</a>
					<a href={CRM_SIGNUP_URL} class="btn btn--outline-primary">30日間無料で試す</a>
				</div>
				<p class="home-crm__price">1人あたり月額3,000円から。初期費用はありません。</p>
			</header>
			<div class="home-crm__shots" aria-label="Revenue CRMの画面">
				<figure class="home-crm__shot home-crm__shot--b2b">
					<img src="/images/crm/screen-dashboard-2026-10c.webp" alt="Revenue CRMのダッシュボード。パイプライン総額・加重フォーキャスト・勝率・期限切れタスク・ステージ別パイプライン・注目の商談を一画面に表示。" width="1600" height="1000" loading="lazy" decoding="async" />
				</figure>
				<figure class="home-crm__shot home-crm__shot--school">
					<img src="/images/crm/school/screen-students-v3.webp" alt="Revenue CRMスクール版の生徒管理。生徒ごとの課題の提出状況とLINEの返信状況を一覧で表示。" width="1200" height="750" loading="lazy" decoding="async" />
				</figure>
				<figure class="home-crm__shot home-crm__shot--mobile">
					<img src="/images/crm/screen-mobile-dashboard-2026-10c.webp" alt="スマートフォンで開いたRevenue CRMのダッシュボード。" width="780" height="1688" loading="lazy" decoding="async" />
				</figure>
			</div>
		</div>
		<p class="home-crm__lead-figure">営業もマーケティングも、手作業が月に十数時間減る。</p>
		<div class="time-grid">
			{timeTables.map((t) => (
				<div class="time-card">
					<p class="time-card__head"><span>{t.role}（1人・1か月）</span><strong>{t.total}<small>時間</small></strong></p>
					<table class="time-table">
						<thead><tr><th scope="col">作業と使う機能</th><th scope="col" class="time-per">1件で減る時間</th><th scope="col">月の件数</th><th scope="col">月に減る時間</th></tr></thead>
						<tbody>
							{t.rows.map((r) => (
								<tr><td>{r.task}<span class="time-feature">{r.feature}</span></td><td class="time-per">{r.per}</td><td>{r.count}</td><td><strong>{r.saved}</strong></td></tr>
							))}
						</tbody>
					</table>
				</div>
			))}
		</div>
		<p class="time-note">{timeSavedNote}</p>
	</div>
</section>

<!-- ===================== FLAG（考え方：レベニューアーキテクチャ） ===================== -->
<section class="why why--flag-only">
	<div class="container">
		<div class="why-flag">
			<div>
				<p class="section-eyebrow">Our Approach</p>
				<h2>この設計を、<br /><span class="text-emph">レベニューアーキテクチャ</span>と呼んでいます。</h2>
			</div>
			<div class="flag-body">
				<p>
見込み客の獲得から受注・継続までを、部門の境目を越えて、一つの流れとして設計する考え方です。海外のB2B SaaSで生まれたこの方法を、日本の稟議・合意形成に合わせて作り直し、日本の会社向けに体系化したのがConsilegyです。
					日本の稟議は、待ち時間の塊。だから転換率だけでなく<strong>「待ち時間」も指標に入れ</strong>ます。
				</p>
				<a href="/revenue-architecture/" class="btn btn--outline-primary">レベニューアーキテクチャとは →</a>
			</div>
		</div>

		<figure class="revenue-map" aria-labelledby="revenue-map-caption">
			<p class="revenue-map__label">売上は、部門をまたいで一周する。どこで止まっているかを見る</p>
			<div class="revenue-cycle-wrap"><svg class="revenue-cycle" viewBox="0 0 960 680" role="img" aria-label="マーケティング、営業、カスタマーサクセスが一周する循環図。中心に全部門で共有する顧客データと運用がある。">
