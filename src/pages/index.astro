---
import BaseLayout from '../layouts/BaseLayout.astro';
import { articles } from '../data/insights';

// 最新コラムはコラム一覧の先頭5件。一覧に足せばトップも追従する。
// PCは先頭が2列幅なので、5件で2行がちょうど埋まる（3件だと2行目に1枚だけ残る）。スマホは3件まで。
const insightsPosts = articles.slice(0, 5);
import NewsLatest from '../components/NewsLatest.astro';
---

<BaseLayout
	title="使われていない顧客データを、売上が動く仕組みへ | Consilegy"
	description="「顧客情報がスプレッドシートとメールにしかない」「入れたはずのMA/SFAに入力されない」。原因は営業力ではなく、収益構造の設計にあります。Salesforce・HubSpot・kintone・MarketoとAIを組み合わせ、マーケ・営業・CSをつなぐ収益プロセスを設計し、現場で回るところまで伴走します。CRM / MA / SFAの導入支援実績40社以上。"
	lang="ja"
>
	<link
		rel="preload"
		as="image"
		href="/images/common/hero-visual.webp"
		type="image/webp"
		fetchpriority="high"
		slot="head"
	/>
	<script slot="head">
		if (window.location.pathname === '/' || window.location.pathname === '') {
			const pref = localStorage.getItem('languagePreference');
			if (!pref) {
				const lang = navigator.language || 'ja';
				if (!lang.toLowerCase().startsWith('ja')) {
					window.location.replace('/en/');
				}
			}
		}
	</script>

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="hero-bg" aria-hidden="true">
		<div class="hero-orb hero-orb--1"></div>
		<div class="hero-orb hero-orb--2"></div>
		<div class="hero-grid"></div>
	</div>
	<div class="container hero-inner">
		<div class="hero-copy">
			<h1 class="hero-h1--v2">
				使われていない<span class="hero-subject">顧客データを、</span><br />
				<span class="hero-accent">売上が動く仕組みへ。</span>
			</h1>
			<p class="hero-lead hero-lead--short">
				CRMを入れても、結局スプレッドシート。その状態を、設定と業務の両方から直します。
			</p>
			<div class="hero-actions">
				<a href="/contact/" class="btn btn--cta btn--lg">お問い合わせ</a>
				<a href="/download/" class="btn btn--hero-outline btn--lg">資料ダウンロード</a>
			</div>
			<p class="hero-proof">CRM・MA・SFAの導入支援実績 <strong>40社以上</strong></p>
		</div>

		<div class="hero-entries" aria-label="あなたの会社はどちらですか">
			<a href="/crm/" class="hero-entry">
				<span class="hero-entry__tag">まだ仕組みがない</span>
				<span class="hero-entry__state">AIと仕組みが代わりに働く、入力がめんどくさくない顧客管理システム。</span>
				<span class="hero-entry__cta">Revenue CRM →</span>
			</a>
			<a href="/services/" class="hero-entry hero-entry--consulting">
				<span class="hero-entry__tag">仕組みを変えたい</span>
				<span class="hero-entry__state">今のツールで、マーケと営業の連携を直す。</span>
				<span class="hero-entry__cta">支援サービス →</span>
				<span class="hero-entry__tools" aria-label="対応ツールの一例">
					<span>Salesforce</span><span>HubSpot</span><span>kintone</span><span>Marketo</span><span>ServiceNow</span><span>Zoho CRM</span><span>Tableau / Looker</span>
				</span>
			</a>
		</div>
	</div>
</section>

<NewsLatest lang="ja" />

<!-- ===================== ASSURANCE（一文：使われるまでが、仕事です） ===================== -->
<section class="founder founder--slim">
	<div class="container">
		<div class="founder-assurance founder-assurance--solo">
			<header class="sub-head">
				<p class="section-eyebrow">Why It Works</p>
				<h2 class="assurance-ja assurance-ja--main">導入して終わりにしない。<br />使われるまでが、仕事です。</h2>
			</header>
			<p class="assurance-body">
戦略レポートも設計図も、それ自体は1円も生みません。現場が使い始め、使い続けて、初めて数字が動きます。
ダッシュボードの読み方、営業会議での使い方、1on1での問いの立て方まで一緒に設計し、「これがないと仕事が回らない」と現場が言う状態まで並走します。
			</p>
		</div>
			<figure class="assurance-figure sflow" aria-labelledby="assurance-figure-caption">
				<div class="sflow__grid" role="img" aria-label="設計、導入、定着の3段階。多くの支援は導入で終わるが、Consilegyは定着までを支援の範囲にする">
					<p class="sflow__scope sflow__scope--others"><span>多くの支援はここまで</span></p>
					<p class="sflow__scope sflow__scope--ours"><span>Consilegy はここまでが、仕事です</span></p>
					<div class="sflow__step sflow__step--1"><p class="sflow__en">Design</p><p class="sflow__name">設計</p><p class="sflow__desc">流れとデータを決める</p></div>
					<div class="sflow__step sflow__step--2"><p class="sflow__en">Implement</p><p class="sflow__name">導入</p><p class="sflow__desc">設定して、現場に渡す</p></div>
					<div class="sflow__step sflow__step--3 sflow__step--dark"><p class="sflow__en">Adoption</p><p class="sflow__name">定着</p><p class="sflow__desc">使われるまで並走する</p></div>
				</div>
				<p class="sflow__note">数字が動くのは、導入の先。使われて初めて、売上が動きます。</p>
				<figcaption id="assurance-figure-caption">設計図を渡して終わりではなく、導入から定着までを支援の範囲にしています。</figcaption>
			</figure>
	</div>
</section>

<!-- ===================== PROBLEMS（こんなお悩みありませんか） ===================== -->
<section class="why problems-section">
	<div class="container">
		<header class="problems-overview">
			<div class="why-head">
				<p class="section-eyebrow">Common Problems</p>
				<h2>リードが、<br /><span class="text-emph">商談にならない。</span></h2>
				<p class="section-lead">部門をまたぐルールとデータを、一緒に整えます。</p>
			</div>
		</header>
		<div class="problem-rows">
			<article class="problem-row">
				<div><p class="problem-topic">引き継ぎ</p><h3>渡した見込み客が、<br />追われていない。</h3></div>
				<div class="problem-response"><p class="problem-topic">整えること</p><p>誰に渡すか、いつまでに連絡するかを決める。今すぐ買わない人のフォローも、両部門で揃えます。</p></div>
			</article>
			<article class="problem-row">
				<div><p class="problem-topic">営業からのフィードバック</p><h3>「質が悪い」の理由が、<br />戻ってこない。</h3></div>
				<div class="problem-response"><p class="problem-topic">整えること</p><p>対象外・時期尚早・失注の理由をCRMに残す。営業の対応結果を、次の集客に活かします。</p></div>
			</article>
			<article class="problem-row">
				<div><p class="problem-topic">施策と受注のつながり</p><h3>どの施策が受注につながったか、<br />分からない。</h3></div>
				<div class="problem-response"><p class="problem-topic">整えること</p><p>集客・商談・受注のデータをつなぐ。施策ごとの結果を、同じ画面で確認できるようにします。</p></div>
			</article>
		</div>
		<p class="problems-more"><a href="/services/" class="btn btn--outline-primary">支援内容を見る →</a></p>
	</div>
</section>

<!-- ===================== RESULTS（事例3つ：動き出すと、こう変わる） ===================== -->
<section class="how how--after-only">
	<div class="container">
		<div class="how-after">
			<header class="sub-head">
				<p class="section-eyebrow">After</p>
				<h2>動き出すと、こう変わります。</h2>
			</header>
			<div class="after-list after-list--three">
				<article class="after-item after-item--metric">
					<h3>売上が伸びる</h3>
					<p class="result-metric"><strong><span>最大</span>20<span>%向上</span></strong><span class="result-metric__note">リードから商談への転換率</span></p>
					<p>ITバックオフィスSaaS（約200名）。見込み客の取りこぼしを減らし、マーケが渡したリードが商談になる割合を改善。</p>
				</article>
				<article class="after-item after-item--metric">
					<h3>時間が戻る</h3>
					<p class="result-metric"><strong><span>約</span>65<span>%削減</span></strong><span class="result-metric__note">月約100時間を創出</span></p>
					<p>「あの件、どうなった？」を聞かなくてよくなります。医療テック企業（約150名）のデータ管理・抽出業務を改善。</p>
				</article>
				<article class="after-item after-item--metric">
					<h3>部門の摩擦が消える</h3>
					<p class="result-metric"><strong>2<span>か月</span></strong><span class="result-metric__note">3名の兼務チームで仕組みを構築</span></p>
					<p>全員が同じ顧客の情報を見るので、押し付け合いがなくなります。コンサル会社の新規AI部門で、3名のまま回る仕組みを構築。</p>
				</article>
			</div>
			<p class="track-more"><a class="btn btn--secondary" href="/case-studies/">導入事例を見る</a></p>
			<div class="service-summary">
				<h3>費用の目安</h3>
				<dl>
					<div><dt><a href="/crm/">入力がめんどくさくない顧客管理システム「Revenue CRM」→</a></dt><dd>名刺を撮る、声で話す、議事録を貼る。記録はAIが作る。<br />1人あたり月額3,000円〜・30日間無料</dd></div>
					<div><dt><a href="/services/">支援サービス →</a></dt><dd>現状分析 10万円〜／再設計 300万円〜／伴走 月額30万円〜</dd></div>
				</dl>
				<p>価格は税抜です。</p>
				<p class="service-summary__links"><a href="/contact/">お問い合わせ</a><a href="/download/">資料ダウンロード</a></p>
			</div>
		</div>
	</div>
</section>

<!-- ===================== TRACK RECORD（実績＋代表） ===================== -->
<section class="track">
	<div class="container">
		<header class="section-head track-head">
			<p class="section-eyebrow">Track Record</p>
			<h2>支援実績40社以上。</h2>
			<p class="section-lead">
代表・山口聖子が、個人事業時代から現在までに手がけたCRM / MA / SFA導入の累計です。SaaS・EC / D2C・メーカーなど業種は問いません。
			</p>
		</header>

		<ul class="track-list track-list--tags">
			<li class="track-item"><span class="track-who">医療テック企業<span class="track-size">約150名</span></span></li>
			<li class="track-item"><span class="track-who">ITバックオフィスSaaS<span class="track-size">約200名</span></span></li>
			<li class="track-item"><span class="track-who">グローバルDTCブランド<span class="track-size">約20,000名</span></span></li>
			<li class="track-item"><span class="track-who">大手食品メーカー<span class="track-size">HubSpot導入</span></span></li>
			<li class="track-item"><span class="track-who">コンサル新規AIプロダクト部門<span class="track-size">3名の兼務チーム</span></span></li>
		</ul>

		<div class="track-founder">
			<p>
設計するのは、代表の山口聖子です。B2Bマーケティング歴10年以上。Moloco・Kaizen Platform・アリババなどでマーケ・営業・CRMの設計と実装を担当してきました。
				<a href="/company/">会社概要 →</a>
			</p>
		</div>
		<p class="supported-tools"><span>対応ツール（一部）</span>Salesforce・HubSpot・kintone・Marketo・ServiceNow・Zoho CRM・Tableau / Looker<br />今お使いのツールを前提に設計します。</p>
	</div>
</section>

<!-- ===================== FLAG（考え方：レベニューアーキテクチャ） ===================== -->
<section class="why why--flag-only">
	<div class="container">
		<div class="why-flag">
			<div>
				<p class="section-eyebrow">Revenue Architecture</p>
				<h2>この設計を、<br /><span class="text-emph">レベニューアーキテクチャ</span>と呼んでいます。</h2>
			</div>
			<div class="flag-body">
				<p>
見込み客の獲得から受注・継続までを、部門ごとではなく一つの流れとして設計する考え方です。海外のB2B SaaSで体系化された方法を、日本の稟議・合意形成に合わせて作り直しました。
					日本の稟議は、待ち時間の塊。だから転換率だけでなく<strong>「待ち時間」も指標に入れ</strong>ます。
				</p>
				<a href="/revenue-architecture/" class="btn btn--outline-primary">レベニューアーキテクチャとは →</a>
			</div>
		</div>

		<figure class="revenue-map" aria-labelledby="revenue-map-caption">
			<p class="revenue-map__label">獲得から継続まで、どこで止まっているかを見る</p>
			<ol class="revenue-flow">
				<li>
					<p class="revenue-flow__department">マーケティング</p>
					<h3>見込み客を、営業へ。</h3>
					<ul class="revenue-flow__issues"><li>マーケ→営業の受け渡し</li></ul>
				</li>
				<li>
					<p class="revenue-flow__department">営業</p>
					<h3>商談を、受注へ。</h3>
					<ul class="revenue-flow__issues"><li>営業の属人化</li><li>商談ステージのズレ</li></ul>
				</li>
				<li>
					<p class="revenue-flow__department">カスタマーサクセス</p>
					<h3>受注を、次の取引へ。</h3>
					<ul class="revenue-flow__issues"><li>受注後の継続・拡大</li></ul>
				</li>
			</ol>
			<div class="revenue-map__foundation">
				<p>全部門で共有する顧客データと運用</p>
				<ul class="revenue-flow__issues"><li>データの分断</li><li>システムの非定着</li></ul>
			</div>
			<p class="revenue-map__feedback">↶ 営業・顧客対応の結果を、マーケティングへ返す</p>
			<figcaption id="revenue-map-caption">引き継ぎ、商談、継続、データと運用。上の6つの課題を、一つの流れとして見直します。</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== BLOG ===================== -->
<section class="blog-section">
	<div class="container">
		<header class="section-head">
			<p class="section-eyebrow">Insights</p>
			<h2>最新コラム</h2>
			<p class="section-lead">マーケと営業の連携、CRMの運用について書いています。</p>
		</header>
		<div class="blog-grid">
			{insightsPosts.map((post) => (
				<article class="blog-card">
					<a href={`/insights/${post.slug}/`} class="blog-card__link">
						<div class="blog-img">
							<img
								src={`/images/insights/${post.slug}-2026b.svg`}
								alt={post.cat}
								loading="lazy"
								width="1200"
								height="630"
								class="blog-img__asset"
							/>
							<span class="blog-new">新着</span>
						</div>
						<div class="blog-body">
							<span class="blog-cat">{post.cat}</span>
							<h3 class="blog-title">{post.title}</h3>
							<p class="blog-desc">{post.desc}</p>
							<div class="blog-foot">
								<span class="blog-arrow" aria-hidden="true">→</span>
							</div>
						</div>
					</a>
				</article>
			))}
		</div>
		<p style="margin-top: var(--space-lg); text-align: center;">
			<a class="btn btn--secondary" href="/insights/">コラム一覧へ</a>
		</p>

	</div>
</section>

<!-- ===================== FINAL CTA ===================== -->
<section class="final-cta">
	<div class="container cta-inner cta-inner--single">
		<div class="cta-copy">
			<p class="cta-eyebrow">Get Started</p>
			<h2>マーケと営業の間のこと、<br />ご相談ください。</h2>
			<p class="cta-lead">
				「営業に渡した後が分からない」「どの施策が効いたか知りたい」。
				まず3分の収益診断で、どこで止まっているかを見ます。
				その結果をもとに、30分の無料相談で優先順位を一緒に整理できます。
			</p>
			<p class="cta-lead cta-lead--close">
				診断は、質問が価値ではありません。結果が価値です。<br />
				<strong>止まっている場所さえ分かれば、事業は動き出します。</strong>
			</p>
			<div class="cta-actions">
				<a href="/diagnostic/" class="btn btn--cta-primary btn--lg">
					3分の収益診断（無料）
				</a>
				<a href="/free-consultation/" class="btn btn--cta-outline btn--lg">
					30分無料相談を予約する
				</a>
			</div>
		</div>
	</div>
</section>

</BaseLayout>

<style>
/* ── Shared ──────────────────────────────────────────── */
.container { max-width: 1160px; margin-inline: auto; padding-inline: 2rem; }
section { padding-block: var(--space-2xl); }
.section-head { max-width: 640px; margin-bottom: var(--space-xl); }
.section-eyebrow {
	display: block; font-size: 0.625rem; font-weight: 500; color: var(--color-text-muted);
	letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 1.25rem;
	padding-top: 0.875rem; border-top: 1.5px solid var(--color-border);
}
/* Editorial: section headings at display scale */
.section-head h2 {
	font-size: clamp(2rem, 3.5vw, 3.25rem); font-weight: 500;
	line-height: 1.1; letter-spacing: -0.02em; color: var(--color-text);
	margin: 0 0 1.25rem;
}
.section-lead { font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.8; margin: 0; }
.text-emph { color: var(--color-text); }
.btn--lg { padding: 0.875rem 1.75rem; font-size: 0.9375rem; }

/* ── Hero ──────────────────────────────────────────── */
.hero {
	position: relative; overflow: hidden;
	background-image: url('/images/common/hero-visual-720.webp');
	background-size: cover;
	background-position: center;
	background-repeat: no-repeat;
	border-bottom: 1px solid var(--color-border);
	padding-block: 0;
}
@media (min-width: 769px) {
	.hero { background-image: url('/images/common/hero-visual.webp'); }
}
/* Glass: gradient orbs floating over the hero visual */
.hero-bg { position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
.hero-orb { position: absolute; border-radius: 50%; filter: blur(90px); }
.hero-orb--1 {
	width: 560px; height: 560px; top: -180px; right: -120px;
	background: radial-gradient(circle, rgba(96,165,250,0.4) 0%, transparent 70%);
}
.hero-orb--2 {
	width: 440px; height: 440px; bottom: -140px; left: -100px;
	background: radial-gradient(circle, rgba(167,139,250,0.32) 0%, transparent 70%);
}
.hero-grid { display: none; }

.hero-inner {
	position: relative; z-index: 1;
	padding-block: 6rem 4rem;
}
.hero-copy { max-width: 660px; }

.hero-eyebrow {
	display: inline-flex; align-items: center; gap: 0.5rem;
	font-size: 0.625rem; font-weight: 500; color: #fff;
	background: rgba(255,255,255,0.12); padding: 0.375rem 0.875rem;
	letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 1.5rem;
}
.eyebrow-dot { width: 4px; height: 4px; background: #fff; display: inline-block; }

.hero-copy h1 {
	font-size: clamp(2rem, 4.5vw, 4rem); font-weight: 500;
	line-height: 1.1; letter-spacing: -0.03em; color: #fff;
	margin: 0 0 1.75rem;
}
.hero-accent { color: #fff; display: block; }

.hero-sub {
	font-size: 1.0625rem; font-weight: 400; line-height: 1.7; color: rgba(255,255,255,0.92);
	margin: 0 0 0.875rem;
}

/* Symptoms = はしごの段。訪問者はこの3行のどれかで自分を見つける */
.hero-symptoms {
	list-style: none; padding: 0; margin: 0 0 1.75rem;
	display: flex; flex-direction: column; gap: 0.5rem;
}
.hero-symptoms li {
	font-size: 1.0625rem; font-weight: 400; line-height: 1.6;
	color: rgba(255,255,255,0.92);
	padding-left: 1rem; border-left: 2px solid rgba(255,255,255,0.35);
}

.hero-lead {
	font-size: 1.0625rem; line-height: 1.85; color: rgba(255,255,255,0.92);
	max-width: 600px; margin: 0 0 2rem;
}

.hero-inline-link {
	color: rgba(255,255,255,0.92); text-decoration: underline; text-underline-offset: 3px;
	text-decoration-color: rgba(255,255,255,0.35);
}
.hero-inline-link:hover { color: #fff; text-decoration-color: #fff; }

.hero-tagline {
	font-size: 1.125rem; font-weight: 500; letter-spacing: 0.02em;
	color: #fff; margin: 1.5rem 0 2rem;
}

.hero-proof {
	display: flex; flex-wrap: wrap; gap: 0.6rem;
	margin: 1.25rem 0 0; font-size: 0.75rem; letter-spacing: 0.08em;
	color: rgba(255,255,255,0.92);
}
.hero-proof__sep { color: rgba(255,255,255,0.45); }

.hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

.btn--hero-primary {
	display: inline-flex; align-items: center;
	background: #fff; color: #1C1917;
	padding: 0.875rem 1.5rem;
	font-weight: 500; font-size: 0.9375rem; text-decoration: none; border: none;
	transition: background 0.15s ease; white-space: nowrap;
}
.btn--hero-primary:hover { background: #F5F5F4; color: #1C1917; }

.btn--hero-outline {
	display: inline-flex; align-items: center;
	background: transparent; color: #fff;
	padding: 0.875rem 1.5rem;
	font-weight: 400; font-size: 0.9375rem; text-decoration: none;
	border: 1px solid rgba(255,255,255,0.5);
	transition: all 0.15s ease; white-space: nowrap;
}
.btn--hero-outline:hover { background: rgba(255,255,255,0.07); border-color: rgba(255,255,255,0.92); }

/* Stats */
.hero-stats { display: flex; flex-direction: column; gap: 1rem; }
.stat-card {
	background: var(--color-bg); border: 1px solid var(--color-border);
	padding: 1.5rem 1.75rem;
}
.stat-card--accent { border-color: var(--color-navy); }
.stat-num {
	font-size: 2rem; font-weight: 500; color: var(--color-navy);
	letter-spacing: -0.03em; line-height: 1; margin-bottom: 0.5rem;
}
.stat-unit { font-size: 1rem; font-weight: 400; margin-left: 0.25rem; }
.stat-label { font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.5; }

/* Tools ribbon */
.hero-tools {
	position: relative; z-index: 1;
	border-top: 1px solid rgba(255,255,255,0.18);
	padding: 1rem 0; background: rgba(28,25,23,0.3);
	backdrop-filter: blur(14px) saturate(1.3);
	-webkit-backdrop-filter: blur(14px) saturate(1.3);
}
.tools-label {
	font-size: 0.625rem; font-weight: 500; color: rgba(255,255,255,0.92);
	text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 0.5rem;
}
.tools-row {
	display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.625rem;
	font-size: 0.75rem; color: rgba(255,255,255,0.92); font-weight: 400;
}
.tools-sep { color: rgba(255,255,255,0.4); }

/* ── Fork（はしご：訪問者を2つの入口に振り分ける） ──── */
.fork {
	background:
		radial-gradient(800px 420px at 50% 0%, rgba(59,130,246,0.07), transparent 60%),
		var(--color-bg);
	border-bottom: 1px solid var(--color-border);
}
.fork-head { margin-bottom: var(--space-xl); }
.fork-head h2 {
	font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 500;
	line-height: 1.15; letter-spacing: -0.02em; color: var(--color-text); margin: 0;
}
.fork-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
.fork-card {
	display: flex; flex-direction: column;
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 2.25rem;
}
.fork-card--consulting { border-top-color: var(--color-border-strong); }
.fork-tag {
	display: block; font-size: 0.6875rem; font-weight: 600;
	color: var(--color-text); letter-spacing: 0.08em;
	margin-bottom: 1rem;
}
.fork-state {
	margin: 0 0 1.25rem; font-size: 1rem; font-weight: 500;
	color: var(--color-text); line-height: 1.7;
}
.fork-body { margin: 0 0 0.875rem; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.85; }
.fork-body strong { color: var(--color-text); font-weight: 500; }
.fork-card .fork-body:last-of-type { margin-bottom: 1.5rem; flex: 1; }
.fork-answer {
	display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem 0.75rem;
	margin: 0.25rem 0 0.9rem; font-size: 0.9375rem; font-weight: 600; color: var(--color-text);
}
.fork-answer span {
	font-size: 0.625rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
	color: var(--color-navy);
}
.fork-shot {
	display: block; position: relative; overflow: hidden; margin: 0 0 1rem;
	height: 220px; border: 1px solid var(--color-border); border-radius: 8px; background: #fff;
	box-shadow: 0 10px 26px rgba(15, 23, 42, 0.08);
}
.fork-shot__bar {
	display: flex; gap: 5px; align-items: center; height: 24px; padding: 0 10px;
	background: #f3f4f6; border-bottom: 1px solid var(--color-border);
}
.fork-shot__bar i { width: 7px; height: 7px; border-radius: 50%; background: #d6d9de; }
.fork-shot img { display: block; width: 100%; height: auto; }
.fork-tools {
	display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0 0 1rem; padding: 0;
}
.fork-tools li {
	font-size: 0.75rem; font-weight: 500; color: var(--color-text);
	padding: 0.3rem 0.65rem; border: 1px solid var(--color-border); border-radius: 999px; background: #fff;
}
.fork-steps {
	list-style: none; margin: 0 0 1rem; padding: 0;
	display: grid; gap: 0.55rem;
}
.fork-steps li {
	display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 0.75rem; align-items: baseline;
	padding: 0.65rem 0; border-top: 1px solid var(--color-border);
	font-size: 0.875rem; line-height: 1.7;
}
.fork-steps li:last-child { border-bottom: 1px solid var(--color-border); }
.fork-steps strong { color: var(--color-text); font-weight: 600; }
.fork-steps span { color: var(--color-text-muted); }
.fork-links { display: flex; flex-direction: column; gap: 0.5rem; align-items: flex-start; }
.fork-link {
	align-self: flex-start; font-size: 0.9375rem; font-weight: 500;
	color: var(--color-primary); text-decoration: none;
	border-bottom: 1px solid currentColor; padding-bottom: 2px;
}
.fork-link:hover { color: var(--color-primary-dark); }
.fork-media { margin: 1rem 0 0; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.75; }
.fork-media a, .journal-link a { color: var(--color-primary); }
.journal-link { margin: var(--space-sm) 0 0; text-align: center; font-size: 0.875rem; color: var(--color-text-muted); }

.fork-third {
	margin-top: 1.5rem; padding: 1.5rem 2rem;
	background: rgba(15, 23, 42, 0.04); border: 1px solid var(--color-border);
	border-radius: var(--radius-card);
	display: flex; align-items: center; justify-content: space-between;
	gap: 1.5rem; flex-wrap: wrap;
}
.fork-third p { margin: 0; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.75; }
.fork-third__btn {
	flex-shrink: 0; display: inline-flex; align-items: center;
	background: var(--color-primary); color: #fff;
	padding: 0.75rem 1.5rem; font-weight: 500; font-size: 0.875rem;
	text-decoration: none; border: none; transition: background 0.15s;
}
.fork-third__btn:hover { background: var(--color-primary-dark); }

/* ── Why ──────────────────────────────────────────── */
.why {
	background:
		radial-gradient(900px 480px at 88% 0%, rgba(124,92,191,0.08), transparent 60%),
		radial-gradient(720px 420px at 0% 100%, rgba(59,130,246,0.09), transparent 60%),
		linear-gradient(180deg, #F7F8FC 0%, #EFF2F9 100%);
	border-top: 1px solid var(--color-border);
	border-bottom: 1px solid var(--color-border);
}
.why-grid {
	display: grid; grid-template-columns: 1fr 1.1fr; gap: 5rem; align-items: start;
}
.why-head h2 {
	font-size: clamp(1.625rem, 2.4vw, 2.125rem); font-weight: 500;
	line-height: 1.2; letter-spacing: -0.02em; color: var(--color-text);
	margin: 0 0 1.75rem;
}

.why-claim {
	margin: 0 0 1.5rem; font-size: 1.125rem; font-weight: 500;
	line-height: 1.75; color: var(--color-text); letter-spacing: -0.01em;
}
.why-anecdote {
	margin: 0 0 1.75rem; padding: 1.25rem 1.5rem;
	background: rgba(15, 23, 42, 0.05); border-left: 3px solid var(--color-border-strong);
}
.why-anecdote p { margin: 0; font-size: 0.9375rem; line-height: 1.8; color: var(--color-text); }
.why-anecdote strong { font-weight: 600; color: var(--color-text); }
.why-stat {
	margin: 1.25rem 0 0; padding-top: 1.25rem; border-top: 1px solid var(--color-border);
	font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.8;
}
.why-stat strong { font-weight: 600; color: var(--color-text); font-size: 1rem; }
.why-stat__src { display: block; margin-top: 0.375rem; font-size: 0.75rem; color: var(--color-text-muted); }

.why-problems { display: flex; flex-direction: column; gap: 0.875rem; }
.why-problems__label {
	margin: 0 0 0.25rem; font-size: 0.8125rem; font-weight: 500;
	color: var(--color-text-muted); letter-spacing: 0.02em;
}
.why-close {
	margin: 0.75rem 0 0; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.85;
}
.why-close strong { color: var(--color-text); font-weight: 500; }
.layer-desc { margin: 0; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.75; }

/* Symptom layers */
.layer-card {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 1.5rem 1.75rem;
	transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.layer-card:hover {
	transform: translateY(-2px);
	background: var(--glass-bg-strong);
	box-shadow: var(--glass-shadow-hover);
}
.layer-tag {
	display: block; font-size: 0.5625rem; font-weight: 500;
	color: var(--color-text-muted); letter-spacing: 0.14em; text-transform: uppercase;
	border-top: 1.5px solid var(--color-border); padding-top: 0.75rem; margin-bottom: 0.75rem;
}
.layer-title {
	margin: 0 0 0.875rem; font-size: 1.125rem; font-weight: 500;
	letter-spacing: -0.01em; color: var(--color-text);
}
.layer-items { list-style: none; padding: 0; margin: 0 0 1rem; display: flex; flex-direction: column; gap: 0.375rem; }
.layer-items li {
	font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.65;
	padding-left: 1.125rem; position: relative;
}
.layer-items li::before {
	content: ""; position: absolute; left: 0; top: 0.6em;
	width: 5px; height: 5px; background: var(--color-navy); opacity: 0.4;
}
.layer-cause {
	margin: 0; padding-top: 0.75rem; border-top: 1px solid var(--color-border);
	font-size: 0.8125rem; color: var(--color-text); line-height: 1.65;
}
.layer-cause span {
	display: inline-block; margin-right: 0.625rem;
	font-size: 0.625rem; font-weight: 500; letter-spacing: 0.08em;
	color: var(--color-navy); background: rgba(15, 23, 42, 0.08);
	padding: 0.15rem 0.5rem; vertical-align: 0.1em;
}

/* ── How ──────────────────────────────────────────── */
.how {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
}
.how-grid {
	display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center;
}
.how-copy h2 {
	font-size: clamp(1.75rem, 2.6vw, 2.5rem); font-weight: 500;
	line-height: 1.2; letter-spacing: -0.02em; color: var(--color-text);
	margin: 0 0 1.75rem;
}

/* Flow diagram */
.flow-diagram {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 2rem;
	display: flex; flex-direction: column; align-items: center; gap: 0.5rem;
}
.flow-step {
	width: 100%;
	background: rgba(255,255,255,0.5); border: 1px solid rgba(255,255,255,0.7);
	border-radius: var(--radius);
	padding: 0.875rem 1.25rem;
	display: flex; flex-direction: column; align-items: flex-start; gap: 0.25rem;
}
.flow-step--top { background: rgba(59,130,246,0.09); border-color: rgba(96,165,250,0.3); }
.flow-step--mid { background: rgba(59,130,246,0.06); border-color: rgba(96,165,250,0.22); }
.flow-step--bot { background: rgba(124,92,191,0.07); border-color: rgba(167,139,250,0.25); }
.flow-label { font-size: 0.625rem; font-weight: 500; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.08em; }
.flow-tools { font-size: 0.8125rem; font-weight: 500; color: var(--color-text); }
.flow-arrow { font-size: 1rem; color: var(--color-primary); opacity: 0.35; line-height: 1; }
.flow-center {
	width: 100%;
	background: linear-gradient(135deg, rgba(112,66,172,0.92), rgba(29,78,216,0.88));
	backdrop-filter: blur(8px);
	-webkit-backdrop-filter: blur(8px);
	border-radius: var(--radius);
	box-shadow: 0 8px 24px rgba(112,66,172,0.25);
	padding: 1rem 1.25rem; text-align: center;
	display: flex; flex-direction: column; gap: 0.25rem;
}
.flow-center-label { font-size: 0.8125rem; font-weight: 500; color: #fff; }
.flow-center-sub { font-size: 0.6875rem; color: rgba(255,255,255,0.92); }
.flow-kpi {
	margin-top: 0.25rem; width: 100%;
	display: flex; align-items: center; gap: 0.5rem;
	font-size: 0.6875rem; color: var(--color-text-muted);
	background: rgba(255,255,255,0.45); padding: 0.625rem 1rem;
	border: 1px solid rgba(255,255,255,0.65);
	border-radius: var(--radius);
}
.flow-kpi-arrow { color: var(--color-primary); font-weight: 500; }

.how-points { list-style: none; padding: 0; margin: 1.75rem 0 2rem; display: flex; flex-direction: column; gap: 2rem; }
.how-points li { display: flex; gap: 1.5rem; align-items: flex-start; }
/* Editorial: ghosted large number as visual anchor */
.how-num {
	flex-shrink: 0; min-width: 3rem;
	color: var(--color-navy); opacity: 0.18;
	display: inline-flex; align-items: flex-start; justify-content: flex-end;
	font-size: 3rem; font-weight: 500; letter-spacing: -0.05em;
	line-height: 0.85; margin-top: 0.125rem; border: none;
}
.how-points strong { display: block; font-size: 0.9375rem; font-weight: 500; color: var(--color-text); margin-bottom: 0.25rem; }
.how-points p { margin: 0; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.75; }
.how-points .how-terms { margin-top: 0.5rem; font-size: 0.8125rem; color: var(--color-text-muted); letter-spacing: 0.01em; }

.btn--outline-primary {
	display: inline-flex; align-items: center;
	background: transparent; color: var(--color-primary);
	padding: 0.75rem 1.25rem;
	font-weight: 500; font-size: 0.875rem; text-decoration: none;
	border: 1px solid var(--color-primary);
	transition: all 0.15s ease;
}
.btn--outline-primary:hover { background: rgba(15, 23, 42, 0.05); }

/* ── After（動き出したあと） ─────────────────────────── */
.after {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
}
.after-head { max-width: 640px; }
.after-list {
	display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem;
}
.after-item {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 1.875rem;
}
/* 最初の2つは全員に共通する日常なので、幅を取って先に読ませる */
.after-item:first-child { grid-column: span 2; }
.after-item h3 {
	margin: 0 0 0.75rem; font-size: 1.0625rem; font-weight: 500;
	line-height: 1.5; letter-spacing: -0.01em; color: var(--color-text);
}
.after-item p { margin: 0; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.85; }
.after-item strong { font-weight: 600; color: var(--color-text); }
.after-item--metric { border-top: 2px solid rgba(112,66,172,0.25); }

.after-close {
	margin: var(--space-xl) 0 0; text-align: center;
	font-size: clamp(1.25rem, 2.2vw, 1.75rem); font-weight: 500;
	line-height: 1.5; letter-spacing: -0.02em; color: var(--color-text);
}
.after-close span { color: var(--color-text-muted); font-size: 0.9375rem; font-weight: 400; letter-spacing: 0; }

/* ── Assurance（担保） ─────────────────────────────── */
.assurance {
	background:
		radial-gradient(820px 460px at 100% 0%, rgba(59,130,246,0.07), transparent 60%),
		linear-gradient(180deg, #F4F6FB 0%, var(--color-bg) 100%);
	border-top: 1px solid var(--color-border);
}
.assurance-head { max-width: 760px; }
.assurance-tagline {
	font-size: clamp(1.75rem, 3.2vw, 3rem) !important;
	font-weight: 500; line-height: 1.15; letter-spacing: -0.02em;
	color: var(--color-navy); margin: 0 0 0.75rem !important;
}
.assurance-ja {
	margin: 0 0 1.5rem; font-size: 1rem; font-weight: 500;
	color: var(--color-text); letter-spacing: -0.01em;
}
.assurance-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; margin-top: var(--space-xl); }
.as-card {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 2rem;
	transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.as-card:hover {
	transform: translateY(-3px);
	background: var(--glass-bg-strong);
	box-shadow: var(--glass-shadow-hover);
}
.as-num {
	display: block; font-size: 2.5rem; font-weight: 500;
	color: var(--color-navy); opacity: 0.18;
	letter-spacing: -0.05em; line-height: 0.9; margin-bottom: 0.875rem;
}
.as-card h3 {
	margin: 0 0 0.75rem; font-size: 1.0625rem; font-weight: 500;
	line-height: 1.45; letter-spacing: -0.01em; color: var(--color-text);
}
.as-card p { margin: 0; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.8; }

/* ── Track record（実績） ──────────────────────────── */
.track {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
}
.track-head { max-width: 680px; }
.track-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--color-border); }
.track-item {
	display: grid; grid-template-columns: 320px 1fr; gap: 2rem; align-items: baseline;
	padding: 1.5rem 0; border-bottom: 1px solid var(--color-border);
}
.track-who {
	display: flex; flex-direction: column; gap: 0.25rem;
	font-size: 0.9375rem; font-weight: 500; color: var(--color-text);
}
.track-size { font-size: 0.75rem; font-weight: 400; color: var(--color-text-muted); letter-spacing: 0.04em; }
.track-result { margin: 0; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.75; }
.track-result strong { font-weight: 600; color: var(--color-text); }
.track-foot { margin: 1.5rem 0 0; font-size: 0.875rem; color: var(--color-text-muted); }
.track-more { margin: var(--space-lg) 0 0; }

/* ── Founder（誰がやるか） ─────────────────────────── */
.founder {
	background:
		radial-gradient(700px 400px at 0% 0%, rgba(124,92,191,0.07), transparent 60%),
		linear-gradient(180deg, #F3F5FB 0%, #EEF2F9 100%);
	border-top: 1px solid var(--color-border);
}
.founder-inner { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 4rem; align-items: center; }
.founder-photo {
	border-radius: var(--radius-card); overflow: hidden;
	box-shadow: var(--glass-shadow); background: var(--color-bg-subtle);
}
.founder-photo img { width: 100%; height: auto; display: block; aspect-ratio: 4/5; object-fit: cover; }
.founder-copy h2 {
	font-size: clamp(1.75rem, 3vw, 2.75rem); font-weight: 500;
	line-height: 1.2; letter-spacing: -0.02em; color: var(--color-text); margin: 0 0 1.5rem;
}
.founder-bio { margin: 0 0 1rem; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.9; }
.founder-quote {
	margin: 1.75rem 0; padding: 1.25rem 1.5rem;
	background: rgba(255,255,255,0.55); border-left: 3px solid var(--color-border-strong);
	font-size: 1rem; font-weight: 500; color: var(--color-text); line-height: 1.75;
}

/* ── Pricing（料金） ───────────────────────────────── */
.pricing {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
}
.pricing-head { max-width: 640px; margin-bottom: var(--space-lg); }
.pricing-block {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 2rem 2.25rem; margin-bottom: 1.25rem;
}
.pricing-for {
	margin: 0 0 1.25rem; padding-bottom: 0.875rem;
	border-bottom: 1px solid var(--color-border);
	font-size: 1rem; font-weight: 500; color: var(--color-text);
	display: flex; align-items: baseline; gap: 0.875rem; flex-wrap: wrap;
}
.pricing-for__note { font-size: 0.75rem; font-weight: 400; color: var(--color-text-muted); }
.price-rows { display: flex; flex-direction: column; }
.price-row {
	display: grid; grid-template-columns: 5rem 1fr auto; gap: 1rem;
	align-items: baseline; padding: 0.75rem 0;
}
.price-row + .price-row { border-top: 1px solid var(--color-border); }
.price-row--single { grid-template-columns: 1fr auto; padding-top: 0; }
.price-step {
	font-size: 0.625rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase;
	color: var(--color-navy);
}
.price-name { font-size: 0.9375rem; color: var(--color-text); }
.price-amount { font-size: 1rem; font-weight: 500; color: var(--color-text); white-space: nowrap; }
.pricing-note { margin: 0.5rem 0 0; font-size: 0.8125rem; color: var(--color-text-muted); }

.pricing-guide { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--color-border); }
.pricing-guide__label { margin: 0 0 0.75rem; font-size: 0.8125rem; font-weight: 500; color: var(--color-text-muted); }
.pricing-guide ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
.pricing-guide li {
	display: flex; align-items: baseline; gap: 0.875rem; flex-wrap: wrap;
	font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.6;
}
.pricing-guide li::before { content: "→"; color: var(--color-navy); opacity: 0.5; }
.pricing-guide em {
	font-style: normal; font-size: 0.75rem; font-weight: 500; color: var(--color-navy);
	background: rgba(15, 23, 42, 0.08); padding: 0.15rem 0.5rem;
}
.pricing-diag {
	margin: 1.25rem 0 0; padding: 0.875rem 1.125rem;
	background: rgba(15, 23, 42, 0.05); border-left: 3px solid var(--color-border-strong);
	font-size: 0.8125rem; color: var(--color-text-muted); line-height: 1.75;
}
.pricing-diag strong { color: var(--color-text); font-weight: 500; }
.pricing-link {
	display: inline-block; margin-top: 1.25rem;
	font-size: 0.9375rem; font-weight: 500; color: var(--color-primary);
	text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 2px;
}
.pricing-link:hover { color: var(--color-primary-dark); }

/* ── Industries（業界） ────────────────────────────── */
.industries {
	background: linear-gradient(180deg, #F2F5FB 0%, #EDF1F9 100%);
	border-top: 1px solid var(--color-border);
}
.industries-head { max-width: 640px; }
.ind-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; }
.ind-card {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	padding: 2rem;
}
.ind-card h3 {
	margin: 0 0 1rem; font-size: 1.0625rem; font-weight: 500;
	color: var(--color-text); letter-spacing: -0.01em;
}
.ind-card p { margin: 0 0 0.875rem; font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.85; }
.ind-card p:last-child { margin-bottom: 0; }

.fork-src, .ind-src {
	display: block; margin-top: 0.5rem;
	font-size: 0.75rem; color: var(--color-text-muted); line-height: 1.7;
}
.fork-body strong, .ind-stat strong { color: var(--color-text); font-weight: 600; }
.ind-stat {
	margin: 0 0 0.875rem; padding: 0.875rem 1rem;
	background: rgba(15, 23, 42, 0.05); border-left: 3px solid var(--color-border-strong);
	font-size: 0.875rem !important; color: var(--color-text) !important; line-height: 1.75;
}

/* ── Flag（旗） ────────────────────────────────────── */
.flag {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
}
.flag-inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: 4rem; align-items: start; }
.flag-inner h2 {
	font-size: clamp(1.625rem, 2.8vw, 2.5rem); font-weight: 500;
	line-height: 1.2; letter-spacing: -0.02em; color: var(--color-text); margin: 0;
}
.flag-body p { margin: 0 0 1rem; font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.9; }
.flag-body strong { color: var(--color-text); font-weight: 600; }
.flag-claim {
	font-size: 1.125rem !important; font-weight: 500; color: var(--color-text) !important;
	letter-spacing: -0.01em; margin: 1.5rem 0 !important;
	padding-left: 1rem; border-left: 3px solid var(--color-border-strong);
}
.flag-body .btn--outline-primary { margin-top: 0.75rem; }

/* ── Blog ──────────────────────────────────────────── */
.blog-section {
	background:
		radial-gradient(820px 480px at 5% 100%, rgba(124,92,191,0.07), transparent 60%),
		radial-gradient(700px 400px at 100% 0%, rgba(59,130,246,0.07), transparent 55%),
		linear-gradient(180deg, #F3F5FB 0%, #EEF2F9 100%);
	border-top: 1px solid var(--color-border);
	border-bottom: 1px solid var(--color-border);
}
.blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
/* Editorial: first card is a featured wide card */
@media (min-width: 769px) {
	.blog-card:first-child { grid-column: span 2; }
	.blog-card:first-child .blog-card__link { flex-direction: row; }
	/* アイキャッチはタイトル文字を含むので、切ると読めなくなる。比率を維持する */
	.blog-card:first-child .blog-card__link { align-items: stretch; }
	.blog-card:first-child .blog-img { flex: 0 0 54%; aspect-ratio: 1200 / 630; align-self: center; }
	.blog-card:first-child .blog-body { padding: 2rem; justify-content: center; }
	.blog-card:first-child .blog-title { font-size: 1.25rem; line-height: 1.4; }
	.blog-card:first-child .blog-desc { -webkit-line-clamp: 3; }
}
.blog-card {
	background: var(--glass-bg);
	backdrop-filter: var(--glass-blur);
	-webkit-backdrop-filter: var(--glass-blur);
	border: 1px solid var(--glass-border);
	border-radius: var(--radius-card);
	box-shadow: var(--glass-shadow);
	overflow: hidden;
	display: flex; flex-direction: column;
	transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.blog-card:hover {
	transform: translateY(-3px);
	background: var(--glass-bg-strong);
	box-shadow: var(--glass-shadow-hover);
}
.blog-card__link {
	display: flex; flex-direction: column;
	height: 100%; text-decoration: none; color: inherit;
}
.blog-img {
	position: relative;
	aspect-ratio: 1200 / 630;
	overflow: hidden;
	background: #1C1917;
	flex-shrink: 0;
}
.blog-img__asset {
	width: 100%; height: 100%;
	object-fit: cover; display: block;
	transition: transform .3s ease;
}
.blog-card:hover .blog-img__asset { transform: scale(1.02); }
.blog-new {
	position: absolute; top: 10px; right: 10px;
	font-size: .5625rem; font-weight: 500; letter-spacing: .08em;
	background: var(--color-navy); color: #fff; padding: 3px 8px;
}
.blog-cat {
	display: inline-block; align-self: flex-start;
	margin-bottom: 0.5rem;
	font-size: .625rem; font-weight: 500; letter-spacing: .1em;
	color: var(--color-navy); background: rgba(15, 23, 42, 0.08);
	padding: 0.2rem 0.6rem;
}
.blog-body {
	display: flex; flex-direction: column; gap: 0;
	padding: 1.25rem 1.5rem; flex-grow: 1;
}
.blog-title {
	margin: 0 0 0.5rem; font-size: .9375rem; font-weight: 400;
	line-height: 1.55; color: var(--color-text); flex-grow: 1;
}
.blog-card:hover .blog-title { color: var(--color-primary); }
.blog-desc {
	margin: 0 0 0.875rem; font-size: .8125rem; color: var(--color-text-muted); line-height: 1.75;
	display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
	overflow: hidden;
}
.blog-foot {
	display: flex; align-items: center; gap: 10px;
	padding-top: 0.75rem; border-top: 1px solid var(--color-border);
	margin-top: auto;
}
.blog-arrow {
	margin-left: auto; font-size: .8125rem; color: var(--color-primary);
	transition: transform .18s ease;
}
.blog-card:hover .blog-arrow { transform: translateX(4px); }

/* ── Newsletter CTA strip ──────────────────────────── */
.nl-cta-strip {
	background:
		radial-gradient(600px 300px at 80% 50%, rgba(96,165,250,0.12), transparent 65%),
		linear-gradient(135deg, #F5F7FD 0%, #EDF2FB 100%);
	
	border-bottom: 1px solid var(--color-border);
	padding-block: 3rem;
}
.nl-cta-strip__inner {
	display: flex;
	align-items: center;
	justify-content: space-between;
	gap: 2rem;
	flex-wrap: wrap;
}
.nl-cta-strip__eyebrow {
	display: block; font-size: 0.5625rem; font-weight: 500; letter-spacing: 0.14em;
	text-transform: uppercase; color: var(--color-text-muted);
	margin: 0 0 0.875rem;
	border-top: 1.5px solid var(--color-border); padding-top: 0.75rem;
}
.nl-cta-strip__copy h2 {
	font-size: clamp(1.5rem, 2.5vw, 2.5rem); font-weight: 500;
	color: var(--color-text); margin: 0 0 0.5rem; line-height: 1.2; letter-spacing: -0.02em;
}
.nl-cta-strip__copy p {
	font-size: 0.875rem; color: var(--color-text-muted);
	margin: 0; line-height: 1.7;
}
.nl-cta-strip__btn {
	display: inline-flex; align-items: center; white-space: nowrap; flex-shrink: 0;
	background: var(--color-primary); color: #fff;
	padding: 0.75rem 1.5rem;
	font-weight: 500; font-size: 0.875rem; text-decoration: none;
	border: none; transition: background 0.15s;
}
.nl-cta-strip__btn:hover { background: var(--color-primary-dark); }
@media (max-width: 640px) {
	.nl-cta-strip__inner { flex-direction: column; align-items: flex-start; }
}

/* ── Final CTA ─────────────────────────────────────── */
.final-cta {
	background:
		radial-gradient(800px 400px at 85% -5%, rgba(167,139,250,0.35), transparent 60%),
		radial-gradient(600px 360px at 0% 100%, rgba(96,165,250,0.25), transparent 55%),
		linear-gradient(135deg, #1e40af 0%, #1d4ed8 100%);
	color: #fff;
}
.cta-inner {
	display: grid; grid-template-columns: 1.2fr 1fr;
	gap: 4rem; align-items: center;
}
.cta-eyebrow {
	display: block; font-size: 0.625rem; font-weight: 500; color: rgba(255,255,255,0.92);
	letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 1.25rem;
	border-top: 1px solid rgba(255,255,255,0.15); padding-top: 0.875rem;
}
.cta-copy h2 {
	color: #fff; font-size: clamp(2.5rem, 4.5vw, 5rem);
	line-height: 1.05; font-weight: 500; margin: 0 0 1.75rem; letter-spacing: -0.03em;
}
.cta-lead { color: rgba(255,255,255,0.92); font-size: 1rem; line-height: 1.8; margin: 0 0 1rem; }
.cta-lead--close { margin-bottom: 2rem; }
.cta-lead--close strong { color: #fff; font-weight: 500; }
.cta-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }

.btn--cta-primary {
	display: inline-flex; align-items: center; justify-content: center;
	padding: 0.875rem 1.75rem;
	font-weight: 500; font-size: 0.9375rem; text-decoration: none;
	background: #fff; color: var(--color-primary); border: none;
	transition: background 0.15s ease; white-space: nowrap;
}
.btn--cta-primary:hover { background: #F5F5F4; color: var(--color-primary); }

.btn--cta-outline {
	display: inline-flex; align-items: center; justify-content: center;
	padding: 0.875rem 1.75rem;
	font-weight: 400; font-size: 0.9375rem; text-decoration: none;
	background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.38);
	transition: all 0.15s ease; white-space: nowrap;
}
.btn--cta-outline:hover { border-color: #fff; background: rgba(255,255,255,0.07); }

.cta-checklist {
	background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.22);
	border-radius: var(--radius-card);
	backdrop-filter: blur(16px) saturate(1.3);
	-webkit-backdrop-filter: blur(16px) saturate(1.3);
	box-shadow: 0 8px 32px rgba(0,0,0,0.12);
	padding: 2rem;
}
.cta-checklist h4 {
	margin: 0 0 1rem; font-size: 0.5625rem; color: rgba(255,255,255,0.78);
	letter-spacing: 0.1em; text-transform: uppercase; font-weight: 500;
}
.cta-checklist ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0; }
.cta-checklist li {
	display: flex; align-items: flex-start; gap: 0.75rem;
	padding: 0.5625rem 0; font-size: 0.875rem; color: rgba(255,255,255,0.92);
	border-bottom: 1px solid rgba(255,255,255,0.07); line-height: 1.55;
}
.cta-checklist li:last-child { border-bottom: none; }
.cta-checklist li::before {
	content: ""; flex-shrink: 0; margin-top: 9px;
	width: 4px; height: 4px; background: rgba(255,255,255,0.35);
}

/* ── Responsive ─────────────────────────────────────── */

/* ── 構成統合（2026-08-20）：サブ見出し・統合ブロック ── */
.proof { display: grid; gap: 0.75rem; }
.proof__row .tools-label { margin-bottom: 0.35rem; }
.tools-note { font-size: 0.6875rem; color: rgba(255,255,255,0.78); margin-left: 0.25rem; }
.sub-head { margin-bottom: var(--space-lg); }
.sub-head .section-eyebrow, .why-flag .section-eyebrow { border-top: 0; padding-top: 0; margin-bottom: 0.75rem; }
.sub-head h3 {
	font-size: clamp(1.375rem, 2.2vw, 1.875rem); font-weight: 500;
	line-height: 1.25; letter-spacing: -0.02em; color: var(--color-text); margin: 0;
}
.why-flag {
	display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 2rem 4rem; align-items: start;
	margin-top: var(--space-xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border);
}
.why-flag h3 {
	font-size: clamp(1.25rem, 1.8vw, 1.5rem); font-weight: 500;
	line-height: 1.25; letter-spacing: -0.02em; color: var(--color-text); margin: 0;
}
.how-after { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border); }
.after-list--three { grid-template-columns: repeat(3, 1fr); }
.after-list--three .after-item:first-child { grid-column: auto; }
.track-industries { margin-top: var(--space-xl); }
.track-more { margin-top: var(--space-xl); }
.founder-assurance { margin-top: var(--space-2xl); padding-top: var(--space-xl); border-top: 1px solid var(--color-border); }
.founder-assurance .assurance-grid { margin-top: var(--space-lg); }
.nl-cta-strip--inline { margin-top: var(--space-2xl); padding: 2rem 2rem; border-radius: var(--radius-card); }
.nl-cta-strip--inline h3 {
	font-size: clamp(1.25rem, 2vw, 1.75rem); font-weight: 500;
	color: var(--color-text); margin: 0 0 0.5rem; line-height: 1.2; letter-spacing: -0.02em;
}

/* ── Design tuning: FV画像は残しつつ、過剰な光・ガラス表現を抑える ── */
.hero::before {
	content: "";
	position: absolute;
	inset: 0;
	z-index: 0;
	background: rgba(12, 17, 28, 0.62);
}
.hero-bg { display: none; }
.hero-inner { padding-block: 5.25rem 4.25rem; }
.hero-copy { max-width: 620px; }
.hero-copy h1 {
	font-size: clamp(2.25rem, 4.25vw, 4.125rem);
	line-height: 1.12;
	letter-spacing: 0;
	margin-bottom: 1.5rem;
}
.hero-symptoms {
	gap: 0;
	margin-bottom: 1.5rem;
	border-top: 1px solid rgba(255,255,255,0.18);
	border-bottom: 1px solid rgba(255,255,255,0.18);
}
.hero-symptoms li {
	padding: 0.58rem 0;
	border-left: 0;
	border-bottom: 1px solid rgba(255,255,255,0.14);
	color: rgba(255,255,255,0.92);
	font-size: 1rem;
}
.hero-symptoms li:last-child { border-bottom: 0; }
.hero-lead {
	max-width: 560px;
	margin-bottom: 1.55rem;
	color: rgba(255,255,255,0.92);
	font-size: 1rem;
	line-height: 1.78;
}
.hero-proof {
	margin-top: 1rem;
	color: rgba(255,255,255,0.78);
	letter-spacing: 0.06em;
}
.hero-inline-link {
	color: rgba(255,255,255,0.92);
	text-decoration-color: rgba(255,255,255,0.78);
}
.btn--hero-primary,
.btn--hero-outline,
.btn--cta,
.btn--cta-primary,
.btn--cta-outline,
.fork-third__btn,
.nl-cta-strip__btn {
	border-radius: 4px;
}
.btn--hero-primary { color: #111827; }
.btn--hero-outline {
	border-color: rgba(255,255,255,0.78);
	color: rgba(255,255,255,0.92);
}
.hero-tools {
	background: rgba(18, 24, 36, 0.92);
	backdrop-filter: none;
	-webkit-backdrop-filter: none;
	border-top-color: rgba(255,255,255,0.14);
}
.tools-label { color: rgba(255,255,255,0.78); }
.tools-row { color: rgba(255,255,255,0.92); }
.tools-sep { color: rgba(255,255,255,0.4); }

.fork,
.why,
.how,
.after,
.assurance,
.track,
.pricing,
.industries,
.blog-section {
	background: var(--color-bg);
	border-top: 1px solid var(--color-border);
	border-bottom: 0;
}
.why,
.assurance,
.industries,
.nl-cta-strip {
	background: var(--color-bg-subtle);
}
.fork-card,
.layer-card,
.flow-diagram,
.after-item,
.as-card,
.pricing-block,
.ind-card,
.blog-card {
	background: #fff;
	backdrop-filter: none;
	-webkit-backdrop-filter: none;
	border: 1px solid var(--color-border);
	border-radius: 6px;
	box-shadow: none;
}
.fork-card { border-top: 2px solid var(--color-border); }
.fork-card--consulting { border-top-color: var(--color-border-strong); }
.layer-card:hover,
.as-card:hover,
.blog-card:hover {
	transform: none;
	box-shadow: none;
	background: #fff;
}
.flow-center {
	background: var(--color-navy);
	backdrop-filter: none;
	-webkit-backdrop-filter: none;
	box-shadow: none;
}
.nl-cta-strip {
	border-top: 1px solid var(--color-border);
	background: var(--color-bg-subtle);
}
.final-cta {
	background: #0F172A;
}
.cta-copy h2 { letter-spacing: 0; }
.cta-checklist {
	background: rgba(255,255,255,0.08);
	backdrop-filter: none;
	-webkit-backdrop-filter: none;
	box-shadow: none;
	border-radius: 6px;
}

@media (max-width: 1024px) {
	.why-flag { grid-template-columns: 1fr; gap: 1.25rem; }
	.after-list--three { grid-template-columns: 1fr; }
}

@media (max-width: 1024px) {
	.why-grid { grid-template-columns: 1fr; gap: 2.5rem; }
	.how-grid { grid-template-columns: 1fr; gap: 2.5rem; }
	.fork-grid { grid-template-columns: 1fr; }
	.after-list { grid-template-columns: 1fr; }
	.after-item:first-child { grid-column: auto; }
	.founder-inner { grid-template-columns: 1fr; gap: 2.5rem; }
	.founder-photo { max-width: 320px; }
	.flag-inner { grid-template-columns: 1fr; gap: 2rem; }
}
@media (max-width: 768px) {
	.blog-grid { grid-template-columns: 1fr; }
	.blog-card:nth-child(n+4) { display: none; }
	.cta-inner { grid-template-columns: 1fr; gap: 2rem; }
	.tools-row { gap: 0.25rem 0.5rem; font-size: 0.75rem; }
	.assurance-grid { grid-template-columns: 1fr; }
	.ind-grid { grid-template-columns: 1fr; }
	.track-item { grid-template-columns: 1fr; gap: 0.5rem; }
	.price-row { grid-template-columns: 1fr auto; }
	.price-step { grid-column: 1 / -1; }
	.pricing-block { padding: 1.5rem 1.375rem; }
}
@media (max-width: 560px) {
	.hero-inner { padding-block: 4.5rem 3.25rem; }
	.hero-copy h1 { font-size: 2.25rem; line-height: 1.14; }
	.hero-lead { font-size: 0.9375rem; }
	.hero-actions, .cta-actions { flex-direction: column; }
	.btn--hero-primary, .btn--hero-outline,
	.btn--cta-primary, .btn--cta-outline { width: 100%; justify-content: center; }
}

@media (prefers-reduced-motion: reduce) {
	.layer-card, .as-card, .blog-card,
	.blog-img__asset, .blog-arrow { transition: none; }
	.layer-card:hover, .as-card:hover, .blog-card:hover { transform: none; }
}

/* ===== v2 追加（2026-10-18） ===== */
.hero-symptoms {
	list-style: none;
	padding: 0;
	margin: var(--space-md) 0 var(--space-sm);
	display: grid;
	gap: 0.35rem;
	font-size: 1.05rem;
	color: var(--color-text-muted, #475569);
}
.fork-price {
