---
import BaseLayout from '../../../../layouts/BaseLayout.astro';

const DEMO_URL = 'https://crm.consilegy.com/crm#demo';

// Mirrors the Japanese page. Only what is actually built into the product's
// school shell (edition=b2c + shell='school') is listed here. The LINE
// integration is still simulated, so it is deliberately left out.
const screens = [
	{ src: 'students', title: 'Students', desc: 'Trialing, paying, on hold, withdrawn. Where each student stands, at a glance.', alt: 'The student list, filtered by enrolled, trialing, near graduation, on hold, and graduated, with a status badge on each student.' },
	{ src: 'schedule', title: 'Weekly schedule', desc: 'Lessons managed by the week, tied to the closure-day calendar.', alt: 'The weekly schedule: lessons this week, coaches working, and a day-by-day list of times, students, and assigned coaches.' },
	{ src: 'lessons', title: 'Lesson records', desc: 'What was taught, kept per student. The history survives a change of coach.', alt: 'Lesson history listing student name, assigned coach, course, and date in chronological order.' },
	{ src: 'calls', title: 'Call tracking', desc: 'Who to contact, who is still waiting, and who has been handled, kept apart.', alt: 'The home screen: enrolled students, items needing attention, calls today, and retention rate, with a list of what needs handling now.' },
	{ src: 'hearing-ai', title: 'Intake notes', desc: 'Paste the trial transcript and AI sorts it into fields. A coach corrects it before it is saved.', alt: 'The intake form, with a transcript paste box and a fill-with-AI button above fields for how they found us, basic details, current level, and goals, each already filled in.' },
	{ src: 'report', title: 'Monthly report', desc: 'Drafted from that month’s lesson records and calls. Check it, fix it, send it.', alt: 'The monthly report screen, showing an AI-drafted progress comment with regenerate and confirm buttons.' },
	{ src: 'knowledge', title: 'Knowledge base', desc: 'Teaching policy and operating rules written down, so running the school stops depending on one person.', alt: 'The knowledge base, listing articles for common questions, operating rules, and manuals.' },
	{ src: 'billing', title: 'Billing', desc: 'Paying and failed payments in one place, so a stalled payment gets noticed early.', alt: 'The billing screen showing MRR, paying, and failed counts, with paying, cancelled, and failed badges on each contract.' },
];

const problems = [
	{
		title: 'You find out after they leave',
		text: 'Absences, unanswered messages, a failed payment, a change in how they reply. You notice once they have already quit.',
	},
	{
		title: 'Handover lives in one person',
		text: 'When the coach changes, what happened last time, what the guardian said, and what to watch next all go with them.',
	},
	{
		title: 'Enrollment and billing become month-end work',
		text: 'Enrolled, on hold, withdrawn, paid. Counted again in a spreadsheet at the end of every month.',
	},
];

const roles = [
	{ name: 'Owner', scope: 'Every school, every student, billing, and permissions' },
	{ name: 'School admin', scope: 'Day-to-day operations and permissions' },
	{ name: 'Manager', scope: 'View and edit student data for their school or team' },
	{ name: 'Coach', scope: 'Only their own students and lesson records' },
];
---

<BaseLayout
	title="Revenue CRM School Edition (beta) | The state of every student, without going to look for it"
	description="A screen layout for schools and studios. Enrollment status, the weekly schedule, lesson records, call tracking, and AI-drafted monthly reports. Built mobile first, so a coach can use it between the classroom and the train. The same foundation works for any recurring-payment business. Currently in closed beta."
	lang="en"
	alternateUrl="/crm/school/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://consilegy.com/en/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/en/crm/"},
		{"@type": "ListItem", "position": 3, "name": "School Edition", "item": "https://consilegy.com/en/crm/school/"}
	]
})} />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM School Edition, in beta</p>
			<h1>The state of every student,<br />without going to look.</h1>
			<p class="hero-lead">
				The roster is a spreadsheet. The lesson records are on each coach's own device.
				Payments are in a third tool. The school edition is <strong>one screen layout that
				puts status, records, and billing around the student</strong>.
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">Request a demo</a>
				<a href="#screens" class="btn btn--secondary">See the screens</a>
			</div>
			<ul class="hero-points" aria-label="What the school edition does">
				<li>Students, lessons, and billing in one place</li>
				<li>Mobile-first UI for coaches</li>
				<li>In closed beta</li>
			</ul>
		</div>
		<figure class="hero-media">
			<img
				src="/videos/school-demo-en.gif"
				alt="A walkthrough of the Revenue CRM school edition, moving through the home screen, student list, student detail, billing, the weekly schedule, and the monthly report."
				width="820"
				height="462"
				decoding="async"
			/>
			<figcaption>The screens: home, student list, student detail, billing, weekly schedule</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">
				What you follow is not "can we close this."<br />
				It is "will they still be coming next month."
			</p>
			<div class="pos-copy">
				<p>
					So the three things at the center are <strong>students, lessons, and coaches</strong>.
					Not just whether someone is enrolled, but who took what and when, and how far they got.
				</p>
				<p>
					The screens are built <strong>for the phone first</strong>. What mattered was a coach
					opening it between the classroom and the train, recording what just happened, and
					checking who is next, right there.
				</p>
				<p>
					The same foundation works for any business built on recurring payments, subscriptions
					and repeat orders included. Take the student, lesson, and coach parts out and it
					watches contracts and retention instead. Ask us.
				</p>
				<a href="/en/services/revenue-architecture-design/" class="pos-link">Read about this approach →</a>
			</div>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">The problem</p>
			<h2 class="prob-title">What drives retention is scattered around the school.</h2>
		</div>
		<div class="prob-grid">
			{problems.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`Item ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>

		<figure class="prob-shot">
			<img
				src="/images/common/school-student-detail-en.jpg"
				alt="A student detail page, showing the assigned coach, lesson history, intake notes, and billing status on one screen."
				width="1600"
				height="1000"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>
				One screen per student. <strong>Who is responsible, what was done and when, and how it
				went</strong> on a single page. When the coach changes, this screen tells the story.
			</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">The screens</p>
			<h2 class="sc-title">Everything you open daily, organized around the student.</h2>
		</div>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img
							src={`/images/crm/school/en/screen-${s.src}.webp`}
							alt={s.alt}
							width="1600"
							height="1000"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== SUPPORT ===================== -->
<section class="support">
	<div class="container support-inner">
		<div>
			<p class="section-eyebrow">Running the school</p>
			<h2>Month-end reporting and the daily checks, done on the screen.</h2>
			<p class="support-lead">
				The month-end report, who has not been contacted, and this week's schedule all run
				straight off the student data. The point is not to produce a document. It is to leave
				something the next person can act on.
			</p>
			<p class="support-lead">
				The monthly progress report is drafted by AI from that month's lesson records and call
				history. Counts come from the data as they stand. In a month with too little recorded,
				it does not invent anything; it lists the records. A coach checks it, corrects it, and submits it.
			</p>
		</div>
		<div class="support-list">
			<h3>What you check most</h3>
			<ul>
				<li><span>Attention</span><strong>Students to contact today</strong></li>
				<li><span>Enrollment</span><strong>Enrolled, on hold, and withdrawn this month</strong></li>
				<li><span>Schedule</span><strong>This week's lessons</strong></li>
				<li><span>Reporting</span><strong>The monthly report draft</strong></li>
			</ul>
		</div>
	</div>
</section>

<!-- ===================== AI ===================== -->
<section class="ai">
	<div class="container ai-inner">
		<div>
			<p class="section-eyebrow">AI</p>
			<h2>Ask in plain language,<br />get the answer back.</h2>
			<p class="ai-lead">
				You do not have to build a report to find something out.
				Ask it the way you would say it, and it searches the student data and answers.
			</p>
			<p class="ai-lead">
				Paste a trial-lesson transcript and it sorts what was said into fields: how they found
				you, their level, what they are after, and what the trial exposed. The writing-up afterwards goes away.
			</p>
			<p class="ai-lead">
				Anything AI writes stops at a draft. Nothing reaches a student or a guardian until a
				coach has checked it and confirmed it.
			</p>
		</div>
		<ul class="ai-examples">
			<li>Which students need attention today?</li>
			<li>What is this month's retention rate?</li>
			<li>What lessons are scheduled this week?</li>
			<li>List the students we haven't called</li>
		</ul>
	</div>
</section>

<!-- ===================== ROLES ===================== -->
<section class="roles">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Permissions</p>
			<h2 class="ro-title">Coaches see their own students. No one else's.</h2>
		</div>
		<p class="ro-lead">
			In schools that work with a lot of contract coaches, how far each person can see is a
			practical problem. Scope is set per role.
		</p>
		<dl class="ro-list">
			{roles.map((r) => (
				<div class="ro-row">
					<dt>{r.name}</dt>
					<dd>{r.scope}</dd>
				</div>
			))}
		</dl>
		<p class="ro-note">Actions are logged, so you can trace who changed what, and when.</p>
	</div>
</section>

<!-- ===================== FINAL CTA ===================== -->
<section class="final-cta">
	<div class="container cta-inner">
		<div>
			<p class="cta-eyebrow">Closed beta</p>
			<h2>We are looking for schools<br />to build this with.</h2>
			<p class="cta-lead">
				A closed beta is not where a finished product gets sold. It is where you run it in real
				operations, tell us what is missing, and we finish it together.
				For a demo, please use the form.
			</p>
			<div class="cta-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">Request a demo</a>
				<a href="/en/crm/" class="btn btn--secondary">See the B2B edition</a>
			</div>
		</div>
		<div class="cta-card">
			<h4>What we show you</h4>
			<ul class="cta-list">
				<li>The student list and how enrollment status reads</li>
				<li>The weekly schedule and closure-day management</li>
				<li>How lesson records and intake notes accumulate</li>
				<li>The AI-drafted monthly report</li>
				<li>Coach permissions and the audit log</li>
			</ul>
		</div>
	</div>
</section>

</BaseLayout>

<style>
	.section-eyebrow,
	.eyebrow,
	.cta-eyebrow {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		margin: 0;
		color: var(--color-text);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.4;
		text-wrap: balance;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0.8rem 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.25;
		text-decoration: none;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.btn--primary {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
	}

	.btn--primary:hover {
		background: var(--color-primary-dark);
		border-color: var(--color-primary-dark);
		color: #fff;
	}

	.btn--secondary {
		background: transparent;
		color: var(--color-text);
	}

	.btn--secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	.hero-actions,
	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-md);
	}

	.hero {
		padding: var(--space-lg) 0 var(--space-md);
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.78fr);
		gap: var(--space-xl);
		align-items: start;
	}

	.hero-copy {
		max-width: 720px;
	}

	.eyebrow {
		display: block;
		margin-bottom: var(--space-md);
		padding-top: 0.875rem;
		border-top: 1px solid var(--color-border);
	}

	.hero h1 {
		max-width: 13em;
		margin: 0;
		color: var(--color-text);
		font-size: 3.125rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.hero-lead {
		max-width: 43em;
		margin: var(--space-md) 0 0;
		color: var(--color-text);
		font-size: 1.0625rem;
		line-height: 2;
	}

	.hero-lead strong {
		font-weight: 700;
	}

	.hero-points {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
		margin: var(--space-md) 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-points li {
		min-width: 0;
		padding: 0.85rem 1rem;
		color: var(--color-text-muted);
		font-size: 0.8125rem;
		line-height: 1.6;
	}

	.hero-points li + li {
		border-left: 1px solid var(--color-border);
	}

	.pos-link {
		color: var(--color-primary);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
	}

	.hero-media {
		margin: 0;
		min-width: 0;
	}

	.hero-media img,
	.prob-shot img {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid var(--color-border);
		border-radius: 0;
		background: #fff;
		box-shadow: none;
	}

	.hero-media figcaption,
	.prob-shot figcaption {
		margin-top: 0.65rem;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.positioning,
	.problem,
	.screens,
	.support,
	.ai,
	.roles,
	.final-cta {
		padding: var(--space-2xl) 0;
		background: var(--color-bg);
	}

	.screens,
	.roles {
		background: var(--color-bg-subtle);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.prob-shot {
		max-width: 900px;
		margin: 0;
		background: transparent;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}

	.positioning {
		border-bottom: 1px solid var(--color-border);
	}

	.pos-body {
		display: grid;
		grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
		gap: var(--space-xl);
		align-items: start;
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	.pos-lead {
		margin: 0;
		color: var(--color-text);
		font-size: 1.375rem;
		font-weight: 500;
		line-height: 1.7;
		text-wrap: balance;
	}

	.pos-copy p {
		margin: 0 0 1rem;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.9;
	}

	.pos-body strong {
		color: var(--color-text);
		font-weight: 700;
	}

	.pos-link {
		display: inline-flex;
		margin-top: 0.25rem;
		font-size: 0.9375rem;
	}

	.section-head {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		gap: var(--space-lg);
		align-items: start;
		margin-bottom: var(--space-lg);
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	.prob-grid,
	.sc-grid {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--color-border);
	}

	.prob-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.prob-item,
	.sc-card {
		min-width: 0;
		padding: 1.35rem 1.5rem 1.35rem 0;
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--color-border);
		border-radius: 0;
	}

	.prob-item:nth-child(2),
	.prob-item:nth-child(3) {
		padding-left: var(--space-md);
		border-left: 1px solid var(--color-border);
	}

	.issue-label {
		display: flex;
		align-items: flex-end;
		gap: 0.85rem;
		margin-bottom: 0.9rem;
		color: var(--color-primary);
	}

	.issue-label::after {
		content: "";
		flex: 1;
		height: 1px;
		margin-bottom: 0.34rem;
		background: var(--color-border);
	}

	.issue-label__number {
		color: rgba(30, 64, 175, 0.24);
		font-size: 2.45rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		line-height: 0.82;
		letter-spacing: 0;
	}

	.prob-item h3,
	.sc-card h3 {
		margin: 0;
		color: var(--color-text);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.55;
	}

	.prob-item p,
	.sc-card p {
		margin: 0.6rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.85;
	}

	.prob-shot {
		margin-top: var(--space-xl);
	}

	.prob-shot strong {
		color: var(--color-text);
		font-weight: 700;
	}

	.screens {
		scroll-margin-top: 80px;
	}

	.sc-grid {
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.sc-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.9rem;
		align-content: start;
		padding-right: var(--space-md);
	}

	.sc-shot {
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: 8px;
		background: #fff;
		box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
	}

	.sc-shot img {
		display: block;
		width: 100%;
		height: auto;
	}

	.sc-card:nth-child(4n + 2),
	.sc-card:nth-child(4n + 3),
	.sc-card:nth-child(4n + 4) {
		padding-left: var(--space-md);
		border-left: 1px solid var(--color-border);
	}

	.support {
		border-bottom: 1px solid var(--color-border);
	}

	.support-inner,
	.ai-inner,
	.cta-inner {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: var(--space-xl);
		align-items: start;
	}

	.support-inner > div:first-child,
	.ai-inner > div:first-child,
	.cta-inner > div:first-child {
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	.support .section-eyebrow,
	.ai .section-eyebrow,
	.cta-eyebrow {
		margin-bottom: var(--space-sm);
	}

	.support-lead,
	.ai-lead,
	.ro-lead,
	.cta-lead {
		margin: 1rem 0 0;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.85;
	}

	.support-list {
		border-top: 1px solid var(--color-border);
	}

	.support-list h3,
	.cta-card h4 {
		margin: 0;
		padding: 0.95rem 0;
		border-bottom: 1px solid var(--color-border);
		color: var(--color-primary);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.5;
	}

	.support-list ul,
	.cta-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.support-list li {
