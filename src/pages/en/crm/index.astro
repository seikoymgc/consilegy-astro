				<rect x="16" y="144" width="328" height="100" rx="6" fill="#fff" stroke="#E2E8F0"/>
				<text x="32" y="172" font-size="14" letter-spacing="1.5" fill="#64748b">AI</text>
				<text x="32" y="200" font-size="18" font-weight="600" fill="#0F172A">AI drafts the record</text>
				<text x="32" y="228" font-size="16" fill="#475569">Contacts, deals, tasks</text>
				<line x1="180" y1="246" x2="180" y2="268" stroke="#0F172A" stroke-width="2" marker-end="url(#in-sp-arr)"/>
