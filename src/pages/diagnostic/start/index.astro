---
// 売上の取りこぼし診断 — interactive flow: 12 scored questions → tiebreak pick → lead gate → result map.
// All quiz logic is client-side (static site). Lead capture posts the email
// directly to a dedicated, captcha-free HubSpot form via the Submissions API
// (no iframe, no reCAPTCHA), so submission is reliable and the result shows
// instantly. The diagnostic summary rides along in a hidden "message" field —
// it is never rendered to the user. Set HS_DIAGNOSTIC_FORM_ID below.
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
	title="売上の取りこぼし診断 | 12〜14問・約3分 | Consilegy"
	description="マーケ・営業・CSの「境目」を6つの観点で診断します。12〜14問・選択式・約3分。"
	lang="ja"
	noindex={true}
>

<section class="rd-stage">
	<div class="rd-container" id="rd-app">
		<noscript>
			<p style="padding: 2rem; text-align: center;">
				この診断はJavaScriptが必要です。ブラウザの設定をご確認ください。
			</p>
		</noscript>
	</div>
</section>

</BaseLayout>

<script>
	import { CATEGORIES, CHANNELS, CHANNEL_QUESTION, EXCLUDED_LABEL, EXPANSION_ONE_SHOT, REFERRAL_SCOPE_NOTE, SIGNAL_META, isExcluded, signalOf, bandOf, patternOf } from '../../../lib/diagnostic-data';

	// ── Config ──────────────────────────────────────────────
	const HS_PORTAL_ID = '46498743';
	// Dedicated, captcha-free diagnostic form (Email + hidden "message"), submitted
	// via the Submissions API below. While empty, the diagnostic still works (the
	// result shows) but no lead is captured — fill in the GUID to turn capture on.
	const HS_DIAGNOSTIC_FORM_ID = 'df40a4b0-05e6-4fef-af58-633c398a619e';
	const BOOK_URL = '/free-consultation/';
	const CONTACT_URL = '/revops-assessment/';
	const PRODUCT_URL = '/crm/';
	const STORAGE_KEY = 'rd-state-v3';

	// ── State ───────────────────────────────────────────────
	interface State {
		step: 'channel' | 'quiz' | 'pain' | 'lead' | 'result';
		current: number;
		channel?: string; // Q1: where deals come from; decides which seams apply
		answers: (number | null)[]; // selected option index per flat question
		painCat?: string; // tiebreak: self-reported most painful seam ('' = none)
		industry?: string; // from the lead form; switches one-shot-sale result copy
		leadDone: boolean;
		shared?: boolean; // opened from a shared result link, not taken here
		email?: string;
	}

	function loadState(): State {
		try {
			const raw = sessionStorage.getItem(STORAGE_KEY);
			if (raw) {
				const s = JSON.parse(raw);
				if (Array.isArray(s.answers)) return s;
			}
		} catch { /* fresh start */ }
		return { step: 'channel', current: 0, answers: [], leadDone: false };
	}

	function saveState() {
		try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch { /* ignore */ }
	}

	let state = loadState();

	// Questions in play depend on the channel: seams that don't apply are dropped
	// entirely rather than asked and scored as leaking.
	let ACTIVE_CATS = CATEGORIES;
	let FLAT: { cat: (typeof CATEGORIES)[number]; qi: number; text: string; options: (typeof CATEGORIES)[number]['questions'][number]['options']; catName: string }[] = [];
	let TOTAL_Q = 0;

	function rebuildFlat() {
		ACTIVE_CATS = CATEGORIES.filter((c) => !isExcluded(c.id, state.channel));
		FLAT = ACTIVE_CATS.flatMap((c) =>
			c.questions.map((q, qi) => ({ cat: c, qi, text: q.text, options: q.options, catName: c.name }))
		);
		TOTAL_Q = FLAT.length;
		if (state.answers.length !== TOTAL_Q) {
			state.answers = Array(TOTAL_Q).fill(null);
			state.current = 0;
		}
	}

	rebuildFlat();

	// ── GA4 (via GTM dataLayer) ─────────────────────────────
	function track(event: string, params: Record<string, unknown> = {}) {
		(window as any).dataLayer = (window as any).dataLayer || [];
		(window as any).dataLayer.push({ event, ...params });
	}

	function trackOnce(event: string, params: Record<string, unknown> = {}) {
		const key = `rd-evt-${event}`;
		try {
			if (sessionStorage.getItem(key)) return;
			sessionStorage.setItem(key, '1');
		} catch { /* still fire */ }
		track(event, params);
	}

	// ── Scoring ─────────────────────────────────────────────
	// ── Shareable result link ───────────────────────────────
	// The link carries only the chosen option indices, never the email address.
	// Someone a result is shared with sees it without going through the lead gate;
	// taking their own diagnostic still does.
	const CH_TO_CODE: Record<string, string> = { marketing: 'm', referral: 'r', mixed: 'x' };
	const CODE_TO_CH: Record<string, string> = { m: 'marketing', r: 'referral', x: 'mixed' };
	const IND_TO_CODE: Record<string, string> = { saas: 'a', manufacturing: 'b', wholesale: 'c', prof_services: 'd', retail_ec: 'e', education: 'f', other: 'g' };
	const CODE_TO_IND: Record<string, string> = { a: 'saas', b: 'manufacturing', c: 'wholesale', d: 'prof_services', e: 'retail_ec', f: 'education', g: 'other', z: '' };

	function catsFor(channel?: string) {
		return CATEGORIES.filter((c) => !isExcluded(c.id, channel));
	}

	function resultCode(): string {
		const ch = CH_TO_CODE[state.channel ?? ''] ?? 'm';
		const ind = IND_TO_CODE[state.industry ?? ''] ?? 'z';
		const ans = state.answers.map((a) => (a === null ? 0 : a)).join('');
		const painIdx = state.painCat ? ACTIVE_CATS.findIndex((c) => c.id === state.painCat) : -1;
		return `${ch}${ind}${ans}${painIdx >= 0 ? painIdx : 'z'}`;
	}

	function shareUrl(): string {
		return `${location.origin}${location.pathname}?r=${resultCode()}`;
	}

	function applyCode(code: string): boolean {
		const ch = CODE_TO_CH[code[0]];
		const ind = CODE_TO_IND[code[1]];
		if (!ch || ind === undefined) return false;
		const cats = catsFor(ch);
		const questions = cats.flatMap((c) => c.questions);
		const body = code.slice(2);
		if (body.length !== questions.length + 1) return false;
		const answers: number[] = [];
		for (let i = 0; i < questions.length; i++) {
			const n = Number(body[i]);
			if (!Number.isInteger(n) || n < 0 || n >= questions[i].options.length) return false;
			answers.push(n);
		}
		const painChar = body[body.length - 1];
		const painIdx = Number(painChar);
		const painCat = painChar !== 'z' && Number.isInteger(painIdx) && cats[painIdx] ? cats[painIdx].id : '';
		state = { step: 'result', current: 0, channel: ch, answers, painCat, industry: ind, leadDone: true, shared: true };
		rebuildFlat();
		return true;
	}

	// null = this seam is out of scope for the chosen channel.
	function categoryScores(): (number | null)[] {
		return CATEGORIES.map((c) => {
			if (isExcluded(c.id, state.channel)) return null;
			return c.questions.reduce((sum, q, qi) => {
				const flatIdx = FLAT.findIndex((f) => f.cat.id === c.id && f.qi === qi);
				const sel = state.answers[flatIdx];
				return sum + (sel !== null && sel !== undefined ? q.options[sel].score : 0);
			}, 0);
		});
	}

	function activeScores(): number[] {
		return categoryScores().filter((s): s is number => s !== null);
	}

	function totalScore(): number {
		return activeScores().reduce((a, b) => a + b, 0);
	}

	function maxScore(): number {
		return ACTIVE_CATS.length * 4;
	}

	function summaryText(): string {
		const scores = categoryScores();
		const total = totalScore();
		const band = bandOf(activeScores());
		const lines = CATEGORIES.map((c, i) => {
			const s = scores[i];
			if (s === null) return `— ${c.name}: ${EXCLUDED_LABEL}`;
			return `${SIGNAL_META[signalOf(s)].emoji} ${c.name}: ${s}/4`;
		});
		const painName = state.painCat
			? CATEGORIES.find((c) => c.id === state.painCat)?.name ?? state.painCat
			: '特にない／わからない';
		const channelName = CHANNELS.find((c) => c.id === state.channel)?.label ?? '未回答';
		return [
			'【売上の取りこぼし診断 結果】',
			`案件の主な経路: ${channelName}`,
			`総合スコア: ${total}/${maxScore()}（${band.label}）`,
			...lines,
			`一番痛い（自己申告）: ${painName}`,
			'',
			'※このメッセージは診断結果から自動入力されています。',
		].join('\n');
	}

	// ── Rendering ───────────────────────────────────────────
	const app = document.getElementById('rd-app')!;

	function esc(s: string) {
		return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
	}

	function render() {
		saveState();
		if (state.step === 'channel') renderChannel();
		else if (state.step === 'quiz') renderQuiz();
		else if (state.step === 'pain') renderPain();
		else if (state.step === 'lead') renderLead();
		else renderResult();
		window.scrollTo({ top: 0 });
		// Each step replaces the whole view, so move focus to the new heading —
		// otherwise keyboard and screen-reader users are left where the old page was.
		const heading = app.querySelector<HTMLElement>('h1');
		if (heading) {
			heading.setAttribute('tabindex', '-1');
			heading.focus({ preventScroll: true });
		}
	}

	// Q1 — not scored. Decides which seams are in scope, so it runs before the quiz.
	function renderChannel() {
		app.innerHTML = `
			<div class="rd-progress">
				<div class="rd-progress-meta">
					<span class="rd-progress-label">最初に1問</span>
					<span class="rd-progress-count">Q1</span>
				</div>
				<div class="rd-progress-bar"><div class="rd-progress-fill" style="width:0%"></div></div>
			</div>
			<h1 class="rd-question">${esc(CHANNEL_QUESTION)}</h1>
			<p class="rd-pain-note">この回答で、診断する境目を決めます。当てはまらない設問は表示しません。</p>
			<div class="rd-options">
				${CHANNELS.map((c) => `
					<button type="button" class="rd-option${state.channel === c.id ? ' is-selected' : ''}" data-channel="${c.id}">${esc(c.label)}</button>`).join('')}
			</div>
		`;

		app.querySelectorAll<HTMLButtonElement>('[data-channel]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const next = btn.dataset.channel!;
				if (next !== state.channel) {
					state.channel = next;
					state.answers = [];
					state.painCat = undefined;
				}
				rebuildFlat();
				state.step = 'quiz';
				state.current = 0;
				track('diagnostic_channel', { channel: state.channel });
				render();
			});
		});
	}

	function renderQuiz() {
		const q = FLAT[state.current];
		const n = state.current + 2; // Q1 is the channel question
		const progress = Math.round(((state.current + 1) / (TOTAL_Q + 2)) * 100);
		const selected = state.answers[state.current];

		app.innerHTML = `
			<div class="rd-progress">
				<div class="rd-progress-meta">
					<span class="rd-progress-label">${esc(q.catName)}</span>
					<span class="rd-progress-count">Q${n} / ${TOTAL_Q + 2}</span>
				</div>
				<div class="rd-progress-bar"><div class="rd-progress-fill" style="width:${progress}%"></div></div>
			</div>
			<h1 class="rd-question">${esc(q.text)}</h1>
			<div class="rd-options">
				${q.options
					.map(
						(o, i) => `
					<button type="button" class="rd-option${selected === i ? ' is-selected' : ''}" data-opt="${i}">
						${esc(o.label)}
					</button>`
					)
					.join('')}
			</div>
			<div class="rd-nav">
				<button type="button" class="rd-back" data-back>← 前の質問へ</button>
			</div>
		`;

		app.querySelectorAll<HTMLButtonElement>('.rd-option').forEach((btn) => {
			btn.addEventListener('click', () => {
				state.answers[state.current] = Number(btn.dataset.opt);
				if (state.current < TOTAL_Q - 1) {
					state.current += 1;
				} else {
					track('diagnostic_complete', { score_total: totalScore() });
					state.step = 'pain';
				}
				render();
			});
		});

		app.querySelector('[data-back]')?.addEventListener('click', () => {
			if (state.current === 0) state.step = 'channel';
			else state.current -= 1;
			render();
		});
	}

	// Q13 — not scored. Breaks ties between same-score seams, and rides along
	// to HubSpot in the summary as self-reported pain.
	function renderPain() {
		app.innerHTML = `
			<div class="rd-progress">
				<div class="rd-progress-meta">
					<span class="rd-progress-label">最後に1問</span>
					<span class="rd-progress-count">Q${TOTAL_Q + 2} / ${TOTAL_Q + 2}</span>
				</div>
				<div class="rd-progress-bar"><div class="rd-progress-fill" style="width:${Math.round(((TOTAL_Q + 1) / (TOTAL_Q + 2)) * 100)}%"></div></div>
			</div>
			<h1 class="rd-question">この${ACTIVE_CATS.length}つのうち、いま一番「痛い」のはどれですか？</h1>
			<p class="rd-pain-note">スコアが同点の境目があったとき、この回答で優先順位を決めます。</p>
			<div class="rd-options">
				${ACTIVE_CATS.map((c) => `
					<button type="button" class="rd-option${state.painCat === c.id ? ' is-selected' : ''}" data-pain="${c.id}">${esc(c.name)}</button>`).join('')}
				<button type="button" class="rd-option${state.painCat === '' ? ' is-selected' : ''}" data-pain="">特にない／わからない</button>
			</div>
			<div class="rd-nav">
				<button type="button" class="rd-back" data-back>← 前の質問へ</button>
			</div>
		`;

		app.querySelectorAll<HTMLButtonElement>('[data-pain]').forEach((btn) => {
			btn.addEventListener('click', () => {
				state.painCat = btn.dataset.pain ?? '';
				state.step = state.leadDone ? 'result' : 'lead';
				render();
			});
		});
		app.querySelector('[data-back]')?.addEventListener('click', () => {
			state.step = 'quiz';
			state.current = TOTAL_Q - 1;
			render();
		});
	}

	function renderLead() {
		app.innerHTML = `
			<div class="rd-lead-head">
				<p class="rd-lead-eyebrow">診断完了</p>
				<h1 class="rd-lead-title">結果の表示まで、あと1ステップ</h1>
				<p class="rd-lead-desc">
					メールアドレスをご入力ください。送信後すぐに「取りこぼしマップ」が表示されます。
				</p>
			</div>
			<form class="rd-lead-form" id="rd-lead-form" novalidate>
				<label class="rd-field">
					<span class="rd-field-label">メールアドレス</span>
					<input type="email" name="email" inputmode="email" autocomplete="email"
						required placeholder="you@company.com" class="rd-input" />
				</label>
				<label class="rd-field">
					<span class="rd-field-label">従業員規模<span class="rd-field-opt">（任意）</span></span>
					<select name="employee_size" class="rd-input rd-select">
						<option value="">選択してください</option>
						<option value="1-50">1〜50名</option>
						<option value="51-100">51〜100名</option>
						<option value="101-300">101〜300名</option>
						<option value="301-1000">301〜1000名</option>
						<option value="1001+">1001名以上</option>
					</select>
				</label>
				<label class="rd-field">
					<span class="rd-field-label">業種<span class="rd-field-req">必須</span></span>
					<select name="industry" class="rd-input rd-select" required>
						<option value="">選択してください</option>
						<option value="saas">SaaS・IT</option>
						<option value="manufacturing">製造</option>
						<option value="wholesale">商社・卸</option>
						<option value="prof_services">専門サービス</option>
						<option value="retail_ec">小売・EC</option>
						<option value="education">スクール・教室（生徒向け）</option>
						<option value="other">その他</option>
					</select>
				</label>
				<fieldset class="rd-field rd-fieldset">
					<span class="rd-field-label">使っているツール<span class="rd-field-opt">（任意・複数可）</span></span>
					<div class="rd-check-grid">
						<label class="rd-check"><input type="checkbox" name="current_tools" value="hubspot" /> HubSpot</label>
						<label class="rd-check"><input type="checkbox" name="current_tools" value="salesforce" /> Salesforce</label>
						<label class="rd-check"><input type="checkbox" name="current_tools" value="kintone" /> kintone</label>
						<label class="rd-check"><input type="checkbox" name="current_tools" value="zoho" /> Zoho</label>
						<label class="rd-check"><input type="checkbox" name="current_tools" value="ma_other" /> MA各種</label>
						<label class="rd-check"><input type="checkbox" name="current_tools" value="bi" /> BIツール</label>
						<label class="rd-check"><input type="checkbox" name="current_tools" value="excel_only" /> Excel・スプレッドシートのみ</label>
						<label class="rd-check"><input type="checkbox" name="current_tools" value="none" /> 特に無い</label>
					</div>
				</fieldset>
				<p class="rd-lead-error" id="rd-lead-error" role="alert" hidden></p>
				<button type="submit" class="rd-lead-submit">結果を見る →</button>
			</form>
			<p class="rd-privacy">
				ご入力いただいた情報は、診断結果のご案内およびサービスのご案内に利用します。
				詳細は<a href="/privacy-policy/" target="_blank" rel="noopener">プライバシーポリシー</a>をご確認ください。
			</p>
		`;

		const form = document.getElementById('rd-lead-form') as HTMLFormElement;
		const errEl = document.getElementById('rd-lead-error')!;
		const input = form.querySelector<HTMLInputElement>('input[name="email"]')!;
		const btn = form.querySelector<HTMLButtonElement>('.rd-lead-submit')!;

		const showError = (msg: string) => { errEl.textContent = msg; errEl.hidden = false; };

		const sizeSel = form.querySelector<HTMLSelectElement>('select[name="employee_size"]')!;
		const indSel = form.querySelector<HTMLSelectElement>('select[name="industry"]')!;

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const email = input.value.trim();
			if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
				showError('メールアドレスの形式をご確認ください。');
				input.focus();
				return;
			}
			if (!indSel.value) {
				showError('業種を選択してください。結果の精度と、お返しする内容が変わります。');
				indSel.focus();
				return;
			}
			const tools = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="current_tools"]:checked')).map((el) => el.value);
			const extra: Record<string, string> = {};
			if (sizeSel.value) extra.employee_size = sizeSel.value;
			extra.consilegy_industry = indSel.value;
			if (state.channel) extra.consilegy_lead_channel = state.channel;
			if (tools.length) extra.current_tools = tools.join(';');
			errEl.hidden = true;
			btn.disabled = true;
			btn.textContent = '送信中…';
			try {
				await submitLead(email, extra);
				const TIER1 = ['saas', 'retail_ec'];
				const attr = (window as any).cslgAttribution ? (window as any).cslgAttribution() : {};
				const payload = {
					conversion_kind: 'primary',
					form_name: 'revenue_diagnostic',
					employee_size: extra.employee_size ?? '',
					industry: extra.consilegy_industry,
					lead_channel: state.channel ?? '',
					lead_tier: TIER1.includes(extra.consilegy_industry) ? 'tier1' : 'tier2',
					tools_count: tools.length,
					...attr,
				};
				track('diagnostic_lead_submit', payload);
				track('lead_submit', payload); // 旧イベント名。GA4の既存設定が切り替わるまで併走
				state.leadDone = true;
				state.email = email;
				state.industry = indSel.value;
				state.step = 'result';
				render();
			} catch (err) {
				console.error(err);
				btn.disabled = false;
				btn.textContent = '結果を見る →';
				showError('送信に失敗しました。通信環境をご確認のうえ、もう一度お試しください。');
			}
		});
	}

	function getCookie(name: string): string | undefined {
		return document.cookie.split('; ').find((c) => c.startsWith(name + '='))?.split('=')[1];
	}

	// Post the lead straight to a dedicated, captcha-free HubSpot form via the
	// Submissions API — no iframe, no reCAPTCHA. The diagnostic summary goes into
	// the hidden "message" field; it is never shown on screen.
	async function submitLead(email: string, extra: Record<string, string> = {}): Promise<void> {
		if (!HS_DIAGNOSTIC_FORM_ID) {
			// Form not configured yet — don't block the user from seeing their result.
			console.warn('HS_DIAGNOSTIC_FORM_ID is not set; skipping lead capture.');
			return;
		}
		const hutk = getCookie('hubspotutk');
		const fields = [
			{ name: 'email', value: email },
			{ name: 'message', value: summaryText() },
		];
		for (const [name, value] of Object.entries(extra)) {
			if (value) fields.push({ name, value });
		}
		const payload = {
			fields,
			context: {
				pageUri: location.href,
				pageName: '売上の取りこぼし診断',
				...(hutk ? { hutk } : {}),
			},
		};
		const res = await fetch(
			`https://api.hsforms.com/submissions/v3/integration/submit/${HS_PORTAL_ID}/${HS_DIAGNOSTIC_FORM_ID}`,
			{
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			}
		);
		if (!res.ok) {
			const text = await res.text().catch(() => '');
			throw new Error(`HubSpot submit failed: ${res.status} ${text}`);
		}
	}

	function renderResult() {
		const scores = categoryScores();
		const total = totalScore();
		const band = bandOf(activeScores());
		const redCount = activeScores().filter((s) => s >= 4).length;

		// Leaking categories (yellow/red), worst first. Out-of-scope seams are skipped.
		const leaks = CATEGORIES.map((c, i) => ({ c, score: scores[i] }))
			.filter((x): x is { c: (typeof CATEGORIES)[number]; score: number } => x.score !== null)
			.map((x) => ({ c: x.c, score: x.score, signal: signalOf(x.score) }))
			.filter((x) => x.signal !== 'green')
			.sort((a, b) => b.score - a.score);

		// Tiebreak: when the top score is shared, the seam the user named as most
		// painful (Q13) goes first — the order is a judgment, not a sort artifact.
		let tiebroken = false;
		if (state.painCat && leaks.length > 1) {
			const i = leaks.findIndex((x) => x.c.id === state.painCat);
			if (i > 0 && leaks[i].score === leaks[0].score) {
				leaks.unshift(leaks.splice(i, 1)[0]);
				tiebroken = true;
			}
		}
		const worst = leaks[0];

		// One-shot-sale industries get expansion copy without the LTV/CS frame.
		const oneShot = state.industry === 'manufacturing' || state.industry === 'wholesale';
		// Student-facing schools belong on the school edition, not the B2B product page.
		const isSchool = state.industry === 'education';
		const productUrl = isSchool ? '/crm/school/' : PRODUCT_URL;
		const forkCopy = isSchool
			? 'CSVや紙で生徒の在籍を管理している場合は、スクール版から始める選択肢もあります。'
			: state.channel === 'referral'
				? 'CRMがまだない、または案件・契約の記録が個人任せになっている場合は、自社プロダクトから始める選択肢もあります。支援会社向けの案件管理、代理店向けの契約更新管理のエディションがあります。'
				: 'CRMがまだない、またはExcelに戻っている場合は、自社プロダクトから始める選択肢もあります。';
		const forkLink = isSchool ? 'Revenue CRM スクール版を見る →' : 'Revenue CRM を見る →';
		const copyOf = (c: (typeof CATEGORIES)[number]) =>
			c.id === 'expansion' && oneShot ? EXPANSION_ONE_SHOT : c;

		// Leak pattern: which leaking (non-green) seams overlap, worst-first.
		const leakIds = leaks.map((x) => x.c.id);
		const greens = CATEGORIES.filter((c, i) => scores[i] !== null && signalOf(scores[i] as number) === 'green');
		const pattern = worst ? patternOf(leakIds, worst.c.id, redCount) : null;

		app.innerHTML = `
			<div class="rd-result-head">
				<p class="rd-result-eyebrow">売上の取りこぼし診断 結果</p>
				<div class="rd-result-score">
					<span class="rd-score-num">${total}</span><span class="rd-score-den">/ ${maxScore()}</span>
					<span class="rd-score-band rd-band-${band.key}">${esc(band.label)}</span>
				</div>
				<h1 class="rd-result-headline">${esc(band.headline)}</h1>
				<p class="rd-score-note">スコアは低いほど健全です（取りこぼしリスクの合計）。</p>
			</div>

			${pattern ? `
			<div class="rd-pattern">
				<p class="rd-pattern-label">あなたの取りこぼしの型</p>
				<h2 class="rd-pattern-headline">${esc(pattern.headline)}</h2>
				<p class="rd-pattern-body">${esc(pattern.body)}</p>
			</div>
			` : ''}

			<div class="rd-map">
				${CATEGORIES.map((c, i) => {
					const s = scores[i];
					if (s === null) {
						return `
					<div class="rd-map-card rd-sig-off">
						<span class="rd-map-emoji">—</span>
						<div>
							<span class="rd-map-name">${esc(c.name)}</span>
							<span class="rd-map-state">${esc(EXCLUDED_LABEL)}</span>
						</div>
					</div>`;
					}
					const sig = SIGNAL_META[signalOf(s)];
					return `
					<div class="rd-map-card rd-sig-${signalOf(s)}">
						<span class="rd-map-emoji">${sig.emoji}</span>
						<div>
							<span class="rd-map-name">${esc(c.name)}</span>
							<span class="rd-map-state">${sig.label} ${s}/4</span>
						</div>
					</div>`;
				}).join('')}
			</div>

			${state.channel === 'referral' ? `
			<div class="rd-scopenote">
				<p class="rd-scopenote-text">${esc(REFERRAL_SCOPE_NOTE)}</p>
			</div>
			` : ''}

			${greens.length > 0 && leaks.length > 0 ? `
			<div class="rd-strength">
				<p class="rd-strength-text"><span class="rd-strength-emoji">🟢</span> 機能している境目もあります：${greens.map((c) => esc(c.name)).join('・')}。ここは土台。崩さずに、漏れている所から直すのが最短です。</p>
			</div>
			` : ''}

			${leaks.length > 0 ? `
			<div class="rd-insights">
				<h2 class="rd-insights-title">取りこぼしている境目と、推奨施策<span class="rd-insights-sub">（優先順）</span></h2>
				<p class="rd-insights-note">※ 数値は、Consilegyが40社の支援で繰り返し見てきた目安と、一般に知られる相場です。いずれも御社固有の実数ではありません。</p>
				${tiebroken ? '<p class="rd-insights-note">※ スコアが同点の境目は、「一番痛い」とお答えいただいた所を優先しています。</p>' : ''}
				${leaks.map((x, i) => `
					<div class="rd-insight">
						<span class="rd-insight-rank">${i + 1}</span>
						<div>
							<span class="rd-insight-cat">${SIGNAL_META[x.signal].emoji} ${esc(x.c.name)}</span>
							<p class="rd-insight-text">${esc(copyOf(x.c).insight)}</p>
							<p class="rd-insight-quant">${esc(copyOf(x.c).quant)}</p>
							${copyOf(x.c).actions?.length ? `
							<p class="rd-insight-actions-label">推奨施策</p>
							<ul class="rd-insight-actions">
								${copyOf(x.c).actions.map((a) => `<li>${esc(a)}</li>`).join('')}
							</ul>` : ''}
						</div>
					</div>`).join('')}
			</div>

			${leakIds.includes('handoff') ? `
			<div class="rd-calc">
				<p class="rd-calc-label">入口の漏れを、金額で見る（任意）</p>
				<p class="rd-calc-desc">御社の数字を3つ入れると、入口（マーケ→営業の受け渡し）で消えている商談機会を金額の幅で試算します。数字はこの画面の計算にだけ使い、送信されません。</p>
				<div class="rd-calc-grid">
					<label class="rd-calc-field"><span>月間の新規リード数（件）</span><input id="rd-calc-leads" type="number" min="0" inputmode="numeric" class="rd-input" placeholder="例: 100" /></label>
					<label class="rd-calc-field"><span>商談からの受注率（%）</span><input id="rd-calc-win" type="number" min="0" max="100" inputmode="numeric" class="rd-input" placeholder="例: 25" /></label>
					<label class="rd-calc-field"><span>平均受注単価（万円）</span><input id="rd-calc-price" type="number" min="0" inputmode="numeric" class="rd-input" placeholder="例: 150" /></label>
				</div>
				<button type="button" id="rd-calc-run" class="rd-probe-send">試算する</button>
				<p class="rd-calc-out" id="rd-calc-out" hidden></p>
				<p class="rd-calc-note">※「渡したリードの3〜5割が商談の手前で消える」という典型値に、御社の受注率・単価を掛けた上限の目安です。消えたリードがすべて商談化した場合の金額であり、実際に取り戻せる幅はこれより小さくなります。</p>
			</div>
			` : ''}

			<div class="rd-firststep">
				<p class="rd-firststep-label">最初の一手</p>
				<p class="rd-firststep-text">${esc(copyOf(worst.c).firstStep)}</p>
				<p class="rd-firststep-note">まずはこの一手から動けます。設計と現場定着まで通すと、漏れは元に戻りにくくなります。</p>
			</div>
			` : `
			<div class="rd-firststep">
				<p class="rd-firststep-label">次の一手</p>
				<p class="rd-firststep-text">取りこぼしは小さい状態です。次は「拡大」設計です。受注後のLTV最大化と再現性の強化に投資する段階です。</p>
			</div>
			`}

			<div class="rd-promise">
				<p class="rd-promise-text">Consilegyは、この境目を<strong>一本の収益プロセス</strong>に設計し、CRMに実態が映って<strong>現場で回り出すまで伴走</strong>します。設計図を渡して終わりにしません。</p>
			</div>

			<div class="rd-cta">
				<a href="${BOOK_URL}" class="rd-cta-primary" data-cta="book">この取りこぼしを「直す」なら｜30分無料相談を予約する →</a>
				<p class="rd-cta-note">診断結果をもとに、どこから直すかを30分で一緒に整理します。オンライン・完全無料。</p>
				<a href="${CONTACT_URL}" class="rd-cta-secondary" data-cta="contact">収益構造の現状分析（有償）の内容を見る</a>
				<p class="rd-cta-fork">${esc(forkCopy)}<a href="${productUrl}" data-cta="product">${esc(forkLink)}</a></p>
			</div>

			<div class="rd-probe" id="rd-probe">
				<p class="rd-probe-q">あと1問だけ（任意）：この収益の漏れを、<strong>毎月可視化して直し続ける仕組み</strong>に関心はありますか？</p>
				<div class="rd-probe-opts">
					<label class="rd-check"><input type="radio" name="dashboard_demand" value="want" /> 使いたい</label>
					<label class="rd-check"><input type="radio" name="dashboard_demand" value="conditional" /> 条件次第</label>
					<label class="rd-check"><input type="radio" name="dashboard_demand" value="not_now" /> いまは不要</label>
				</div>
				<input type="text" id="rd-pain" class="rd-input" maxlength="120" placeholder="いま一番困っていることを一言で（任意）" />
				<button type="button" id="rd-probe-send" class="rd-probe-send">送信する</button>
				<p class="rd-probe-thanks" id="rd-probe-thanks" hidden>ありがとうございます。診断当日により具体的にお話しできます。</p>
			</div>

			<div class="rd-share">
				<p class="rd-share-label">結果を共有する</p>
				<p class="rd-share-desc">社内で共有できるリンクです。回答した内容だけを含み、メールアドレスは含みません。</p>
				<div class="rd-share-row">
					<input type="text" id="rd-share-url" class="rd-input" readonly value="${esc(shareUrl())}" />
					<button type="button" id="rd-share-copy" class="rd-probe-send">コピー</button>
				</div>
			</div>

			<p class="rd-retry"><button type="button" data-retry>${state.shared ? '自分の会社で診断する' : 'もう一度診断する'}</button></p>
		`;

		track('result_view', { score_total: total, band: band.label, pattern_id: pattern?.id ?? 'none', worst_cat: worst?.c.id ?? 'none', pain_cat: state.painCat || 'none', industry: state.industry || 'none', channel: state.channel || 'none', max_score: maxScore() });

		app.querySelector('[data-cta="book"]')?.addEventListener('click', () => track('cta_book_click'));
		app.querySelector('[data-cta="contact"]')?.addEventListener('click', () => track('cta_contact_click'));

		app.querySelector('#rd-calc-run')?.addEventListener('click', () => {
			const num = (sel: string) => Number((app.querySelector<HTMLInputElement>(sel)?.value ?? '').trim());
			const leadsN = num('#rd-calc-leads');
			const win = num('#rd-calc-win');
			const price = num('#rd-calc-price');
			const out = app.querySelector<HTMLElement>('#rd-calc-out')!;
			if (!(leadsN > 0) || !(win > 0) || !(price > 0)) {
				out.textContent = '3つの数字をすべて入れてください（概算で構いません）。';
				out.hidden = false;
				return;
			}
			const lo = Math.round(leadsN * 0.3 * (win / 100) * price);
			const hi = Math.round(leadsN * 0.5 * (win / 100) * price);
			const yen = (man: number) =>
				man >= 10000
					? `${(man / 10000).toLocaleString('ja-JP', { maximumFractionDigits: 1 })}億円`
					: `${man.toLocaleString('ja-JP')}万円`;
			out.textContent = `月あたり 約${yen(lo)}〜${yen(hi)}（年間 約${yen(lo * 12)}〜${yen(hi * 12)}）の商談機会が、入口で消えている計算になります（上限の目安）。`;
			out.hidden = false;
			track('calc_run', { calc_monthly_min: lo, calc_monthly_max: hi });
		});

		app.querySelector('#rd-probe-send')?.addEventListener('click', async () => {
			const probe = app.querySelector<HTMLElement>('#rd-probe')!;
			const demand = probe.querySelector<HTMLInputElement>('input[name="dashboard_demand"]:checked')?.value ?? '';
			const pain = probe.querySelector<HTMLInputElement>('#rd-pain')!.value.trim();
			if (!demand && !pain) return;
			const extra: Record<string, string> = {};
			if (demand) extra.dashboard_demand = demand;
			if (pain) extra.pain_point = pain;
			const sendBtn = probe.querySelector<HTMLButtonElement>('#rd-probe-send')!;
			sendBtn.disabled = true;
			sendBtn.textContent = '送信中…';
			try {
				if (state.email) await submitLead(state.email, extra);
				track('probe_submit', { dashboard_demand: demand });
				probe.querySelector<HTMLElement>('#rd-probe-thanks')!.hidden = false;
				sendBtn.hidden = true;
			} catch (err) {
				console.error(err);
				sendBtn.disabled = false;
				sendBtn.textContent = '送信する';
			}
		});
		app.querySelector('#rd-share-copy')?.addEventListener('click', async () => {
			const input = app.querySelector<HTMLInputElement>('#rd-share-url')!;
			const btn = app.querySelector<HTMLButtonElement>('#rd-share-copy')!;
			try {
				await navigator.clipboard.writeText(input.value);
			} catch {
				input.select();
			}
			btn.textContent = 'コピーしました';
			track('share_copy', { channel: state.channel ?? '' });
			setTimeout(() => { btn.textContent = 'コピー'; }, 2000);
		});

		app.querySelector('[data-retry]')?.addEventListener('click', () => {
			// A shared viewer has not given an email, so their own run is gated again.
			const keepLead = state.shared ? false : state.leadDone;
			history.replaceState({}, '', location.pathname);
			state = { step: 'channel', current: 0, answers: [], leadDone: keepLead, industry: state.shared ? undefined : state.industry, channel: state.channel };
			rebuildFlat();
			render();
		});
	}

	// ── Boot ────────────────────────────────────────────────
	const sharedCode = new URLSearchParams(location.search).get('r');
	if (sharedCode && applyCode(sharedCode)) {
		track('result_shared_view', { channel: state.channel ?? '' });
	} else {
		trackOnce('diagnostic_start');
	}
	render();
</script>

