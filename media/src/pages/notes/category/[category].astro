---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { categories, categoryColors, type CategoryKey } from '../../../content.config';

export async function getStaticPaths() {
	return (Object.keys(categories) as CategoryKey[]).map(category => ({
		params: { category },
	}));
}

const { category } = Astro.params as { category: CategoryKey };
const label = categories[category];
const color = categoryColors[category];

const notes = (await getCollection('notes', ({ data }) => !data.draft && data.category === category)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
---

<BaseLayout
	title={`${label} | Consilegy Media`}
	description={`「${label}」という悩みに対する解決記事の一覧です。原因の構造、解決の手順、実務での実例の順で解説しています。`}
>
	<section class="page-head">
		<div class="container">
			<nav class="breadcrumb" aria-label="パンくずリスト">
				<a href="/">ホーム</a>
				<span aria-hidden="true">›</span>
				<a href="/notes/">記事一覧</a>
				<span aria-hidden="true">›</span>
				<span aria-current="page">{label}</span>
			</nav>
			<h1 style={`--cat-color: ${color};`}>{label}</h1>
			<p class="page-lead">全{notes.length}本</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			{
				notes.length === 0 ? (
					<p class="empty">このカテゴリの記事を準備中です。</p>
				) : (
					<div class="card-grid">
						{notes.map(n => (
							<ArticleCard
								href={`/notes/${n.id}/`}
								title={n.data.title}
								description={n.data.description}
								categoryLabel={label}
								color={color}
								date={n.data.publishedAt}
							/>
						))}
					</div>
				)
			}
		</div>
	</section>
</BaseLayout>

<style>
	.page-head {
		padding-block: 2.5rem 2rem;
		border-bottom: 1px solid var(--color-border);
		background: var(--color-surface);
	}

	.breadcrumb {
		font-size: 0.78rem;
		color: var(--color-text-muted);
		display: flex;
		gap: 0.5rem;
		margin-bottom: 1.5rem;
	}

	.breadcrumb a {
		color: var(--color-text-muted);
	}

	.page-head h1 {
		font-size: clamp(1.25rem, 3vw, 1.7rem);
		padding-left: 0.85rem;
		border-left: 5px solid var(--cat-color);
	}

	.page-lead {
		margin-top: 0.75rem;
		font-size: 0.82rem;
		color: var(--color-text-muted);
	}

	.section {
		padding-block: 2.5rem 4rem;
	}

	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1rem;
	}

	.empty {
		font-size: 0.88rem;
		color: var(--color-text-muted);
	}
</style>
