---
import { featureCount } from '../../data/crm-features';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CrmSubnav from '../../components/CrmSubnav.astro';
import CrmLanguages from '../../components/CrmLanguages.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// 概要ページは10セクション（スマートフォンを2026-09-29、言語の切り替えを2026-10-20に追加）。機能の詳細は /crm/features/、料金の詳細と契約条件は /crm/pricing/、
// 質問の全件は /crm/faq/、事業タイプ別の説明は各エディションのページに任せる。

const supports = [
	{ tier: '操作動画・ヘルプ記事', figure: '無料', text: 'どのプランでも無料で見られます。社内で進める場合は、ここから始められます。' },
	{ tier: '初期設定', figure: '120,000円〜', text: '項目や商談の段階、自動化を、貴社の業務に合わせて設定します。操作説明会は3回。' },
	{ tier: '定着支援（3か月）', figure: '300,000円〜', text: '週1回の定例で、設定を見直しながら使い方の相談に乗ります。' },
	{ tier: '運用支援', figure: '月額30,000円〜', text: '設定の変更を代わりに行い、質問にもお答えします（月2時間まで）。' },
	{ tier: '追加開発', figure: '要見積', text: '貴社の運用に合わせて、機能を足します。' },
];

const mobilePoints = [
	{ title: '専用アプリは不要', text: 'ブラウザで開くだけ。画面はスマートフォンの幅に合わせて切り替わります。' },
	{ title: '名刺はその場で撮る', text: 'カメラで撮った名刺をAIが読み取り、訪問先や展示会でそのまま登録できます。' },
	{ title: '外出先で商談を確認', text: '金額・段階・次の予定まで、移動中に確かめられます。' },
	{ title: 'パソコンと同じデータ', text: 'スマートフォンで直した内容は、そのままパソコンにも反映されます。' },
];

// 課題は左右で対応させる。左＝よくある戻り方、右＝Revenue CRMではどうなるか。
const problems = [
	{ topic: '入力', problem: '商談のあとに、記録を書く時間がない', answer: 'AIが記録を下書きします。電話のあとは話すだけ、名刺は撮るだけ、議事録は貼るだけで、連絡先とタスクができます。担当者は内容を確かめて保存します。' },
	{ topic: '立ち上げ', problem: '操作を覚えるまでに時間がかかる', answer: '業態に合った画面と自動化を、最初から。エディションを選べば、案件・稼働・契約・在籍など、扱うものに合わせた画面から始められます。' },
	{ topic: '属人化', problem: '設定を知っている担当者が辞めると、誰も直せない', answer: '設定は画面に残るので、引き継いだ担当者も同じ内容を確かめられます。自動化は175本の中から選んでONにします。操作動画とヘルプ記事は、どのプランでも無料です。' },
];

const afters = [
	{ title: '売上が伸びる', figure: '175', unit: '本', note: '止まった商談や期日を知らせる自動化', text: '顧客ごとに、AIが次の行動を提案します。マーケティングから渡した見込み客が、そのあとどうなったかを追えます。稟議待ちの商談も、決まったのに計上は来期の商談も、そのまま追えます。' },
	{ title: '時間が戻る', figure: '3', unit: 'つ', note: '名刺の撮影・音声・議事録から、AIが記録を下書き', text: '「あの件、電話した？」「誰が持ってる？」と聞いて回る時間が減ります。' },
	{ title: '部門の摩擦が消える', figure: '1', unit: 'つ', note: 'マーケ・営業・顧客管理を一つの顧客データに', text: 'マーケティングと営業が同じ顧客の情報を見るので、引き継ぎのたびに経緯を説明し直す必要がありません。' },
];


// 手作業が減る時間の試算（2026-10-24 の試算。数字は仮置きで、実測値ではない）。
// Gmailの同期は動いていることを 2026-10-26 に代表が確認。
const timeSales = [
	{ task: '名刺の登録・会社の調べもの・1通目のメール', feature: '名刺の読み取り', per: '9分', count: '20枚', saved: '3.0時間' },
	{ task: '商談後の議事録・入力・タスク登録', feature: '会議の取り込み', per: '17分', count: '30件', saved: '8.5時間' },
	{ task: '電話・訪問後の活動記録', feature: '音声入力', per: '3.5分', count: '40件', saved: '2.3時間' },
	{ task: 'チャットのやり取りの要約と記録', feature: '会話の取り込み', per: '8分', count: '10件', saved: '1.3時間' },
	{ task: '次の行動を考えて、文面を書く', feature: '次の一手の提案', per: '7分', count: '20件', saved: '2.3時間' },
	{ task: '止まっている商談を探す', feature: '停滞の知らせ', per: '週30分', count: '4週', saved: '2.0時間' },
	{ task: '連絡先の作成・タスク登録・検索', feature: 'AIエージェント', per: '1.5分', count: '40件', saved: '1.0時間' },
	{ task: 'メールのやり取りを記録に残す', feature: 'Gmailの同期', per: '2分', count: '60通', saved: '2.0時間' },
];
const timeMarketing = [
	{ task: '展示会やイベントで集めた名刺の登録', feature: '名刺の一括読み取り', per: '2.5分', count: '60枚', saved: '2.5時間' },
	{ task: '問い合わせの登録（重複の確認・会社とのひも付け）', feature: 'フォームからの自動登録', per: '4分', count: '30件', saved: '2.0時間' },
	{ task: '会社情報の調べもの', feature: '会社情報の補完', per: '4.5分', count: '50社', saved: '3.8時間' },
	{ task: '見込み客の振り分け', feature: '分類とスコアリング', per: '1.5分', count: '80件', saved: '2.0時間' },
	{ task: '商談の候補を営業に渡す', feature: '自動の引き渡し', per: '5分', count: '15件', saved: '1.3時間' },
	{ task: '見込み客への初回メールを書く', feature: '初回メールの下書き', per: '4分', count: '30件', saved: '2.0時間' },
	{ task: '追いかけのメールを送る', feature: 'シーケンス', per: '3分', count: '60通', saved: '3.0時間' },
];
const timeTables = [
	{ role: '営業', total: '約22', rows: timeSales },
	{ role: 'マーケティング', total: '約16', rows: timeMarketing },
];

const editions = [
	{ noun: '商談', title: '法人営業', href: '/crm/standard/' },
	{ noun: '案件', title: '受託開発・制作', href: '/crm/contractor/' },
	{ noun: '稼働', title: '支援会社', href: '/crm/services/' },
	{ noun: '契約', title: '代理店', href: '/crm/reseller/' },
	{ noun: '在籍', title: 'スクール', href: '/crm/school/' },
];

// ファーストビュー直下の業態選択。説明文は各エディションのLPの説明（description）から取る。
const editionCards = [
	{ who: 'スタートアップ・中小企業', tag: '標準版', text: '名刺や議事録から、AIが顧客情報を記録。商談管理もシンプルに。', href: '/crm/standard/' },
	{ who: 'システム開発・Web制作', text: '案件・見積・納品をまとめて管理。メンバーの空き状況もひと目で。', href: '/crm/contractor/' },
	{ who: 'コンサル・マーケティング支援', text: '案件・契約・稼働をまとめて管理。継続契約の更新も見逃さない。', href: '/crm/services/' },
	{ who: 'SaaS販売代理店', text: '契約・売上・更新をまとめて管理。MRRやARRもひと目で把握。', href: '/crm/reseller/' },
	{ who: 'オンラインスクール', text: 'LINEで予約、カレンダーに自動登録。レッスン記録もAIにお任せ。', href: '/crm/school/' },
];
// 特長の4点（見出しは 2026-10-25 代表決定）。説明文は LP に既にある事実だけで書く。「使い放題」「追加料金なし」「設定済み」「AIが学習」は使わない。
const features = [
	{ title: '高機能もAIも、手の届く価格で。', text: 'AIエージェントと175本の自動化を、1人あたり月額3,000円から。AIの処理に使う「燃料」も毎月付きます。初期費用はなく、30日間無料で試せます。' },
	{ title: '言語も商習慣も、使う人に合わせて。', text: '日本語・English・繁體中文を、使う人ごとに切り替えられます。稟議待ちの商談も、決まったのに計上は来期の商談も、そのまま扱えます。' },
	{ title: '業態に合った画面と自動化を、最初から。', text: '法人営業、受託開発・制作、支援会社、代理店、スクール。エディションごとに、扱うもの（商談・案件・稼働・契約・在籍）に合わせた画面と自動化を用意しています。' },
	{ title: '社内の知識と営業の経験を、AIで次の一手に。', text: 'やり取りの記録から、AIが顧客ごとに次の行動を提案します。人が直した判断を手本にして、自社専用のAIに育っていきます。育つのは自社の中だけです。' },
];
const plans = [
	{ tier: 'ユーザープラン', figure: '3,000円', unit: '/ 人 / 月', for: 'B2B・受託開発・制作・支援会社・代理店版。毎日使う会社に' },
	{ tier: '生徒数プラン', figure: '9,800円', unit: '/ 月〜', for: 'スクール版。在籍生徒50人まで' },
	{ tier: 'プリペイドプラン', figure: '3,000円', unit: '/ 月', for: '全エディション。使う頻度が低い会社に' },
];

// 文面は /crm/school/ の safeguards と同じ系統。全6項目のうち、導入前に聞かれる3つだけを出す。
const safeguards = [
	{ label: '学習に使われない', text: '名刺や手書きの読み取り、文字起こしには、送った内容を学習に使わない条件のサービスを使っています。' },
	{ label: '他社に見えない', text: '会社ごとのデータは、データベースの行単位で切り分けています。アプリ側の絞り込みには頼りません。' },
	{ label: '東京に置いてある', text: 'データは東京リージョンに置いています。AIの処理はAnthropic・OpenAI・Google（米国）を通りますが、送った内容を学習に使わせない契約です。' },
];

// 全件は src/data/crm-faq.ts（/crm/faq/）。ここは購入前に最も聞かれる5問だけ。
const faqs = [
	{ q: '料金はいくらですか。', a: 'プランは3つです。ユーザープランは1人あたり月額3,000円、スクール向けの生徒数プランは在籍生徒50人まで月額9,800円からです。使う頻度が低い会社には、月額3,000円（燃料100付き）に必要な分だけ追加するプリペイドプランがあります。初期費用はありません。どのプランも30日間の無料トライアル付きで、カード登録なしで始められます。価格はすべて税抜です。' },
	{ q: 'ユーザー数はどう数えますか。', a: 'ワークスペースに参加しているメンバーの数です。招待したまま使っていないアカウントも含みます。人数の増減は、次回の請求から反映されます。' },
	{ q: '解約はどうすればいいですか。', a: 'ユーザープランと生徒数プランの契約期間は1年で、以後1年ごとに自動更新します。契約期間の途中で解約することはできません。終了する場合は、契約期間の満了日の1か月前までにご連絡ください。プリペイドプランは1か月ごとの自動更新で、次の契約更新日の14日前までのご連絡で終了できます。お支払いは毎月の前払いで、お支払い済みの料金は返金しません。' },
	{ q: 'データを取り出せますか。', a: 'コンタクト、会社、商談に加えて、活動・メモ・タスク・メール・添付ファイルまで、設定画面からCSVで書き出せます。ご契約終了日から30日間も書き出せます。自社のデータは自社のものです。' },
	{ q: 'HubSpot・Salesforceから乗り換えられますか。', a: 'はい。HubSpotやSalesforceなど、いまお使いのシステムからの乗り換えもご検討いただけます。現在の管理項目や業務フローを確認し、Revenue CRMで実現できることをご案内します。表計算で管理している顧客リストはCSVで取り込めます。HubSpotのデータは読み取って取り込めます。データ移行や外部サービスとの連携設定は、件数や連携先によって工数が変わるため、別途お見積りします。' },
];

const readings = [
	{ href: '/insights/why-crm-adoption-fails/', title: 'CRMが定着しない本当の理由' },
	{ href: '/insights/why-companies-cannot-stop-using-excel-after-crm/', title: 'CRMを導入してもExcelが止まらない理由' },
	{ href: '/insights/why-sfa-becomes-just-a-pipeline-sheet/', title: 'SFAがパイプライン管理表になってしまう理由' },
	{ href: '/insights/what-changes-in-crm-design-when-ai-writes-records/', title: 'AIが記録を書くようになると、CRM設計は何が変わるか' },
];

---

<BaseLayout
	title="AIが代わりに働く、Revenue CRM。入力がめんどくさくない顧客管理システム（CRM・SFA）"
	description="AIが代わりに働く、Revenue CRM。入力がめんどくさくない、新時代の顧客管理・営業支援システムです。名刺は撮るだけ、商談メモは貼るだけ、議事録は自動で入る。AIが記録の下書きを作ります。マーケティング・営業・顧客管理を一つの顧客データでつなぐ中小企業向けのCRM/SFA（顧客管理・営業支援システム）。スタートアップ・中小企業（標準版）、システム開発・Web制作、コンサル・マーケティング支援、SaaS販売代理店、オンラインスクールの5エディション。1アカウント月額3,000円（税抜）、30日間無料。"
	ogImage="/images/og/crm-ja-2026f.png"
	lang="ja"
	alternateUrl="/en/crm/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "Revenue CRM",
	"alternateName": ["レベニューCRM", "レベニューシーアールエム"],
	"applicationCategory": "BusinessApplication",
	"applicationSubCategory": "CRM/SFA（顧客管理・営業支援システム）",
	"keywords": "CRM, SFA, 顧客管理システム, 営業支援システム, 営業管理, 中小企業, 入力しない, AI",
	"operatingSystem": "Web",
	"url": "https://consilegy.com/crm/",
	"sameAs": [
		"https://www.itreview.jp/products/revenue-crm/profile",
		"https://www.g2.com/products/revenue-crm/reviews",
		"https://boxil.jp/service/51195/",
		"https://cloud-radar.jp/detail1783.html",
		"https://cloud-radar.jp/detail1784.html"
	],
	"subjectOf": {
		"@type": "NewsArticle",
		"headline": "中小企業向け顧客管理システム「Revenue CRM」正式提供開始。入力がめんどくさくない、AIが記録する顧客管理へ",
		"url": "https://prtimes.jp/main/html/rd/p/000000002.000191457.html",
		"datePublished": "2026-09-28",
		"publisher": { "@type": "Organization", "name": "PR TIMES" }
	},
	"description": "入力がめんどくさくない顧客管理システム「Revenue CRM」。名刺は撮るだけ、商談メモは貼るだけ、議事録は自動で入る。AIが記録の下書きを作る。マーケティング（MA）・営業（SFA）・顧客管理（CRM）を一つの顧客データでつなぐ中小企業向けのCRM/SFA（顧客管理・営業支援システム）。スタートアップ・中小企業（標準版）、システム開発・Web制作、コンサル・マーケティング支援、SaaS販売代理店、オンラインスクールの5エディション。175本の自動化付き。2026年9月28日正式提供開始。",
	"inLanguage": ["ja", "en", "zh-Hant"],
	"offers": {
		"@type": "Offer",
		"price": "3000",
		"priceCurrency": "JPY",
		"description": "ユーザープラン1人あたり月額3,000円（税抜）。生徒数プランは月額9,800円から、プリペイドプランは月額3,000円（燃料100付き）。初期費用なし。30日間の無料トライアル（カード登録不要）。"
	},
	"author": { "@type": "Organization", "name": "Consilegy合同会社", "url": "https://consilegy.com/" }
})} />

<CrmSubnav lang="ja" />

<!-- ===================== HERO（2026-10-25 代表決定のコピー。法人営業とスクールの画面を1つのファーストビューに） ===================== -->
<section class="hero hero--unified">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="hero-kicker">システムが、人に合わせる。</p>
			<h1>AIが代わりに働く、<br /><span class="hero-name">Revenue CRM。<span class="hero-kana">（レベニューシーアールエム）</span></span></h1>
			<p class="hero-lead">入力がめんどくさくない、新時代の顧客管理・営業支援システムです。</p>
			<div class="hero-actions">
				<a href={SIGNUP_URL} class="btn btn--cta btn--lg" target="_blank" rel="noopener noreferrer">無料で始める</a>
				<a href={DEMO_URL} class="btn btn--outline-dark btn--lg" target="_blank" rel="noopener noreferrer">デモを見る</a>
			</div>
			<p class="hero-download"><a href="/crm/download/">資料をダウンロード →</a></p>
			<p class="hero-proof">1人あたり月額<strong>3,000円〜</strong><span class="hero-proof__sep">・</span>30日間無料<span class="hero-proof__sep">・</span>カード登録不要</p>
		</div>
		<div class="hero-shots">
			<figure class="hero-shot hero-shot--b2b">
				<img
					src="/images/crm/screen-dashboard-2026-10c.webp"
					alt="Revenue CRMのダッシュボード。パイプライン総額・加重フォーキャスト・勝率・期限切れタスク・ステージ別パイプライン・注目の商談を一画面に表示。"
					width="1600"
					height="1000"
					decoding="async"
					fetchpriority="high"
				/>
				<figcaption>法人営業</figcaption>
			</figure>
			<figure class="hero-shot hero-shot--school">
				<img
					src="/images/crm/school/screen-students-v3.webp"
					alt="Revenue CRMスクール版の生徒管理。生徒ごとの課題の提出状況とLINEの返信状況を一覧で表示。"
					width="1200"
					height="750"
					decoding="async"
				/>
				<figcaption>スクール</figcaption>
			</figure>
			<figure class="hero-shot hero-shot--mobile">
				<img
					src="/images/crm/screen-mobile-dashboard-2026-10c.webp"
					alt="スマートフォンで開いたRevenue CRMのダッシュボード。"
					width="780"
					height="1688"
					decoding="async"
				/>
				<figcaption>スマートフォン</figcaption>
			</figure>
		</div>
	</div>
</section>

<!-- ===================== EDITIONS（ファーストビューの直下。業態を選ぶ入口。受託開発・制作と支援会社は別のLP） ===================== -->
<section class="edition-strip" aria-labelledby="edition-strip-title">
	<div class="container">
		<header class="section-head">
			<p class="section-eyebrow">Editions</p>
			<h2 id="edition-strip-title">あなたのビジネスに合った、<br class="br-sp" />Revenue CRMを。</h2>
		</header>
		<ul class="edition-list">
			{editionCards.map((e) => (
				<li><a href={e.href} class="edition-card"><span class="edition-card__who">{e.who}{e.tag && <span class="edition-card__tag">{e.tag}</span>}</span><span class="edition-card__text">{e.text}</span><span class="edition-card__go btn">詳しく見る</span></a></li>
			))}
		</ul>
	</div>
</section>

<!-- ===================== FEATURES（特長の4点。見出しは 2026-10-25 代表決定。説明文は事実だけ） ===================== -->
<section class="features" aria-labelledby="features-title">
	<div class="container">
		<header class="section-head">
			<p class="section-eyebrow">Why Revenue CRM</p>
			<h2 id="features-title">Revenue CRMの、4つの特長。</h2>
