---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { categoriesEn, categoryColors, type CategoryKey } from '../../../content.config';

export async function getStaticPaths() {
	const notes = await getCollection('notesEn', ({ data }) => !data.draft);
	return notes.map(note => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const d = note.data;
const toc = headings.filter(h => h.depth === 2);
const cat = d.category as CategoryKey;

const all = (await getCollection('notesEn', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);
const related = all.filter(n => n.id !== note.id && n.data.category === cat).slice(0, 3);

const fmt = (date: Date) =>
	date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
	lang="en"
	title={`${d.title} | Consilegy Media`}
	description={d.description}
	ogType="article"
	publishedAt={d.publishedAt}
	updatedAt={d.updatedAt}
	ogImage={`/images/eyecatch/${note.id}.png`}
>
	<article class="note">
		<div class="container container--narrow">
			<nav class="breadcrumb" aria-label="Breadcrumb">
				<a href="/en/">Home</a>
				<span aria-hidden="true">›</span>
				<span aria-current="page">Article</span>
			</nav>

			<p class="note-cat" style={`color: ${categoryColors[cat]};`}>{categoriesEn[cat]}</p>
			<h1>{d.title}</h1>

			<div class="note-dates">
				<time datetime={d.publishedAt.toISOString()}>Published {fmt(d.publishedAt)}</time>
				{d.updatedAt && <time datetime={d.updatedAt.toISOString()}>Updated {fmt(d.updatedAt)}</time>}
			</div>

			{
				toc.length >= 2 && (
					<nav class="toc" aria-label="Table of contents">
						<p class="toc__label">In this article</p>
						<ol>
							{toc.map(h => (
								<li>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ol>
					</nav>
				)
			}

			<div class="note-body">
				<Content />
			</div>

			<aside class="principle">
				<p class="principle__label">The takeaway</p>
				<p class="principle__text">{d.principle}</p>
			</aside>

			<aside class="canon-ref">
				<p class="canon-ref__label">The underlying framework</p>
				<a href={d.canonUrl}>{d.canonLabel} ↗</a>
			</aside>

			<aside class="author">
				<p class="author__name">Seiko Yamaguchi</p>
				<p class="author__bio">
					Founder of Consilegy LLC. Revenue architecture, RevOps, and CRM implementation for Japanese enterprises and global SaaS companies entering Japan.
				</p>
				<a href="/en/about/">About the author →</a>
			</aside>

			{
				related.length > 0 && (
					<aside class="related">
						<p class="related__label">Related articles</p>
						<ul>
							{related.map(r => (
								<li>
									<a href={`/en/articles/${r.id}/`}>{r.data.title}</a>
								</li>
							))}
						</ul>
					</aside>
				)
			}

			<aside class="cta">
				<p>Entering the Japanese market, or fixing revenue operations there? We offer a free 30-minute consultation.</p>
				<a href="https://consilegy.com/en/contact-en/" class="btn btn--primary">Talk to us ↗</a>
			</aside>
		</div>
	</article>
</BaseLayout>

<style>
	.note {
		padding-block: 2.5rem 4rem;
	}

	.breadcrumb {
		font-size: 0.78rem;
		color: var(--color-text-muted);
		display: flex;
		gap: 0.5rem;
		margin-bottom: 2rem;
	}

	.breadcrumb a {
		color: var(--color-text-muted);
	}

	.note-cat {
		font-size: 0.75rem;
		font-weight: 600;
	}

	.note h1 {
		font-size: clamp(1.35rem, 3.2vw, 1.85rem);
		margin-top: 0.5rem;
		letter-spacing: -0.01em;
	}

	.note-dates {
		display: flex;
		gap: 1rem;
		margin-top: 1rem;
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--color-border);
		font-size: 0.76rem;
		color: var(--color-text-muted);
	}

	.toc {
		margin-top: 2rem;
		padding: 1.25rem 1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
	}

	.toc__label {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: 0.5rem;
	}

	.toc ol {
		margin: 0;
		padding-left: 1.25rem;
	}

	.toc li {
		font-size: 0.85rem;
		line-height: 2;
	}

	.note-body {
		margin-top: 2rem;
		font-size: 0.95rem;
		line-height: 1.9;
	}

	.note-body :global(h2) {
		font-size: 1.05rem;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--color-border);
	}

	.note-body :global(p) {
		margin-top: 1.1rem;
	}

	.note-body :global(ul),
	.note-body :global(ol) {
		margin-top: 1.1rem;
		padding-left: 1.4rem;
	}

	.note-body :global(li) {
		margin-top: 0.4rem;
	}

	.note-body :global(strong) {
		font-weight: 600;
	}

	.note-body :global(blockquote) {
		margin: 1.5rem 0;
		padding: 0.25rem 0 0.25rem 1.25rem;
		border-left: 3px solid var(--color-border-strong);
		color: var(--color-text-muted);
	}

	.principle {
		margin-top: 3rem;
		padding: 1.5rem;
		background: var(--color-surface);
		border-left: 3px solid var(--color-accent);
	}

	.principle__label {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--color-accent);
	}

	.principle__text {
		margin-top: 0.6rem;
		font-size: 0.95rem;
		line-height: 1.8;
		font-weight: 500;
	}

	.canon-ref {
		margin-top: 1.5rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.canon-ref__label {
		font-size: 0.72rem;
		color: var(--color-text-muted);
		margin-bottom: 0.4rem;
	}

	.author {
		margin-top: 3rem;
		padding-top: 1.75rem;
		border-top: 1px solid var(--color-border);
	}

	.author__name {
		font-size: 0.92rem;
		font-weight: 600;
	}

	.author__bio {
		margin-block: 0.5rem 0.75rem;
		font-size: 0.83rem;
		line-height: 1.8;
		color: var(--color-text-muted);
	}

	.related {
		margin-top: 2.5rem;
	}

	.related__label {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--color-text-muted);
		margin-bottom: 0.6rem;
	}

	.related ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.related li {
		border-bottom: 1px solid var(--color-border);
	}

	.related li a {
		display: block;
		padding-block: 0.7rem;
		font-size: 0.88rem;
	}

	.cta {
		margin-top: 3rem;
		padding: 1.75rem;
		background: var(--color-bg-subtle);
		border-radius: 12px;
		text-align: center;
	}

	.cta p {
		font-size: 0.86rem;
		color: var(--color-text-muted);
		margin-bottom: 1.1rem;
	}
</style>
