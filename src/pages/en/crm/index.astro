<text x="330" y="130" font-size="16" fill="#475569">Contacts, deals, tasks</text>
<line x1="548" y1="90" x2="580" y2="90" stroke="#0F172A" stroke-width="2" marker-end="url(#in-arr)"/>
<rect x="584" y="20" width="236" height="140" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="602" y="56" font-size="14" fill="#64748b" letter-spacing="1">CHECK</text><text x="602" y="90" font-size="18" font-weight="600" fill="#0F172A">A person checks it</text>
<text x="602" y="130" font-size="16" fill="#475569">Fix only what's off</text>
<line x1="820" y1="90" x2="852" y2="90" stroke="#0F172A" stroke-width="2" marker-end="url(#in-arr)"/>
<rect x="856" y="20" width="236" height="140" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="874" y="56" font-size="14" fill="#64748b" letter-spacing="1">NEXT</text><text x="874" y="90" font-size="18" font-weight="600" fill="#0F172A">Next step suggested</text>
<text x="874" y="130" font-size="16" fill="#475569">175 automations watch</text>
				<rect x="40" y="190" width="1052" height="50" rx="6" fill="#0F172A"/>
				<text x="566" y="221" font-size="16" font-weight="600" fill="#fff" text-anchor="middle">AI takes on the typing. People make the calls.</text>
				</g>
			</svg>
			<svg class="fig-sp" viewBox="0 0 360 612" role="img" aria-label="How a record gets made: snap, speak, or paste; AI drafts it; a person checks it; the next step is suggested">
				<defs><marker id="in-sp-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" fill="#0F172A"/></marker></defs>
				<g font-family="inherit">
