---
// /crm/media/ の入口。
// 配置: タグライン → 読者のナビ → 新着記事（大きいカード3枚） → 読者×カテゴリのブロック（小さい行3本＋もっと見る）。
import BaseLayout from '../layouts/BaseLayout.astro';
import CrmSubnav from './CrmSubnav.astro';
import CrmMediaCard from './CrmMediaCard.astro';
import CrmMediaRow from './CrmMediaRow.astro';
import {
  CATEGORIES, CATEGORY_ORDER, COPY, SEGMENTS, SEGMENT_ORDER,
  crmMediaArticles, mediaPath, mediaRoot, type Lang,
} from '../lib/crm-media';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = COPY[lang];
const all = await crmMediaArticles(lang);
const latest = all.slice(0, 3);

// 読者 × カテゴリ。記事が無い組は出さない。
const blocks = SEGMENT_ORDER.flatMap((segment) =>
  CATEGORY_ORDER.map((category) => ({
    segment,
    category,
    list: all.filter((a) => a.data.segment === segment && a.data.category === category).slice(0, 3),
  })),
).filter((b) => b.list.length > 0);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: t.homeMetaTitle,
  description: t.homeMetaDesc,
  inLanguage: lang,
  url: new URL(mediaRoot(lang), Astro.site ?? 'https://consilegy.com').href,
  about: { '@type': 'SoftwareApplication', name: 'Revenue CRM', url: 'https://consilegy.com/crm/' },
};
---

<BaseLayout title={t.homeMetaTitle} description={t.homeMetaDesc} lang={lang} alternateUrl={mediaRoot(lang === 'ja' ? 'en' : 'ja')}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <CrmSubnav lang={lang} />

  <div class="media-page">
    <header class="media-head">
      <p class="kicker">{t.kicker}</p>
      <h1>{t.homeTitle}</h1>
      <p class="lead">{t.homeLead}</p>
      <nav class="seg-nav" aria-label={t.segmentLabel}>
        {SEGMENT_ORDER.map((s) => <a href={mediaPath(lang, s)}>{SEGMENTS[s][lang]}</a>)}
      </nav>
    </header>

    {latest.length > 0 && (
      <section class="latest">
        <h2 class="rule"><span>{t.latest}</span></h2>
        <div class="cards">{latest.map((a) => <CrmMediaCard a={a} />)}</div>
      </section>
    )}

    {blocks.length > 0 && (
      <section class="blocks">
        {blocks.map(({ segment, category, list }) => (
          <div class="block">
            <h2 class="rule">
              <span>
                <small>{SEGMENTS[segment][lang]}</small>
                {CATEGORIES[category][lang]}
              </span>
            </h2>
            <ul class="rows">{list.map((a) => <li><CrmMediaRow a={a} /></li>)}</ul>
            <p class="more"><a href={`${mediaPath(lang, segment)}#${category}`}>{t.more}</a></p>
          </div>
        ))}
      </section>
    )}

    <p class="why"><a href="https://media.consilegy.com/">{t.why}</a></p>
  </div>
</BaseLayout>

<style is:global>
  /* 使い方メディアは白地。サイト共通の stone-50 を使わない。 */
  html { background: #fff; }
</style>

<style>
  .media-page { max-width: 68rem; margin: 0 auto; padding: 3.5rem 1.25rem 5rem; }
  .media-head { text-align: center; max-width: 46rem; margin: 0 auto 3rem; }
  .kicker { margin: 0 0 0.5rem; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-primary); }
  h1 { font-size: clamp(1.5rem, 3.5vw, 2.1rem); line-height: 1.4; margin: 0 0 1rem; letter-spacing: -0.02em; }
  .lead { margin: 0 0 1.5rem; color: var(--color-text-muted); line-height: 1.9; text-align: left; }
  .seg-nav { display: flex; justify-content: center; flex-wrap: wrap; gap: 0.5rem 2.25rem; }
  .seg-nav a { font-weight: 600; text-decoration: none; color: var(--color-text); padding: 0.25rem 0; border-bottom: 2px solid transparent; }
  .seg-nav a:hover { color: var(--color-primary); border-bottom-color: var(--color-primary); }

  /* 「—— 見出し ——」 */
  .rule { display: flex; align-items: center; gap: 1rem; margin: 0 0 1.25rem; font-size: 1.15rem; font-weight: 700; }
  .rule::before, .rule::after { content: ''; flex: 1; height: 1px; background: var(--color-border); }
  .rule span { display: inline-flex; flex-direction: column; align-items: center; text-align: center; }
  .rule small { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; color: var(--color-primary); }

  .latest { margin-bottom: 3.5rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }

  .blocks { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 3rem 2.5rem; }
  .rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1rem; }
  .more { margin: 1.5rem 0 0; text-align: center; }
  .more a {
    display: inline-block; padding: 0.55rem 2rem; border: 1px solid var(--color-text); border-radius: 999px;
    font-size: 0.9rem; font-weight: 600; color: var(--color-text); text-decoration: none;
  }
  .more a:hover { background: var(--color-text); color: #fff; }

  .why { margin-top: 4rem; font-size: 0.875rem; text-align: center; }
  .why a { color: var(--color-text-muted); }
</style>
