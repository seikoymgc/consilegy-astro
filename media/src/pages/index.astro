---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categories, type CategoryKey } from '../content.config';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const lead = notes[0];
const secondary = notes.slice(1, 3);
const rest = notes.slice(3);

const popular = notes.slice(0, 5);

const fmt = (d: Date) =>
	`${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout
	title="Consilegy Media | B2Bの収益のつまずきを、構造から解決する"
	description="CRMが定着しない、商談が読めない、数字が合わない、MAが成果につながらない。B2Bの収益にまつわる悩みを、原因の構造から解決手順まで解説する教育メディアです。"
>
	<div class="wrap">
		<nav class="cats" aria-label="カテゴリ">
			{
				(Object.keys(categories) as CategoryKey[]).map(key => (
					<a href={`/notes/category/${key}/`}>{categories[key]}</a>
				))
			}
		</nav>
	</div>

	{
		notes.length === 0 ? (
			<div class="wrap"><p class="empty">最初の記事を準備中です。</p></div>
		) : (
			<>
				<section class="wrap hero">
					{lead && (
						<a href={`/notes/${lead.id}/`} class="lead">
							<img src={`/images/eyecatch/${lead.id}.png`} alt="" width="1200" height="630" decoding="async" />
							<p class="kicker">{categories[lead.data.category]}</p>
							<h2 class="lead-title">{lead.data.title}</h2>
							<p class="lead-desc">{lead.data.description}</p>
							<time class="date" datetime={lead.data.publishedAt.toISOString()}>{fmt(lead.data.publishedAt)}</time>
						</a>
					)}
					<div class="hero-side">
						{secondary.map(n => (
							<a href={`/notes/${n.id}/`} class="sec">
								<img src={`/images/eyecatch/${n.id}.png`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
								<p class="kicker">{categories[n.data.category]}</p>
								<h3 class="sec-title">{n.data.title}</h3>
								<time class="date" datetime={n.data.publishedAt.toISOString()}>{fmt(n.data.publishedAt)}</time>
							</a>
						))}
					</div>
				</section>

				<div class="wrap main-grid">
					<section class="latest">
						<h2 class="rail-head">新着記事</h2>
						<ul>
							{rest.map(n => (
								<li>
									<a href={`/notes/${n.id}/`}>
										<img src={`/images/eyecatch/${n.id}.png`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
										<div>
											<p class="kicker">{categories[n.data.category]}</p>
											<h3 class="row-title">{n.data.title}</h3>
											<time class="date" datetime={n.data.publishedAt.toISOString()}>{fmt(n.data.publishedAt)}</time>
										</div>
									</a>
								</li>
							))}
						</ul>
						<a href="/notes/" class="more">記事一覧をすべて見る</a>
					</section>

					<aside class="rail">
						<section class="rail-box">
							<h2 class="rail-head">人気の記事</h2>
							<ol class="rank">
								{popular.map(n => (
									<li>
										<a href={`/notes/${n.id}/`}>
											<span class="num" />
											<span>{n.data.title}</span>
										</a>
									</li>
								))}
							</ol>
						</section>

						<section class="rail-box promo">
							<p class="promo-lead">収益の取りこぼしを診断</p>
							<p class="promo-text">CRM・商談・データの現状から、どこで売上を落としているかを3分で。</p>
							<a href="https://consilegy.com/diagnostic/" class="promo-btn">無料で診断する</a>
						</section>

						<section class="rail-box">
							<h2 class="rail-head">運営</h2>
							<p class="run">
								本メディアは、B2BのRevOps・Revenue Architecture設計を手がける
								<a href="https://consilegy.com/">Consilegy合同会社</a>が運営しています。
							</p>
						</section>
					</aside>
				</div>
			</>
		)
	}
</BaseLayout>

<style>
	.wrap {
		max-width: 1060px;
		margin-inline: auto;
		padding-inline: 1.5rem;
	}

	/* カテゴリ（罫線なし、テキストのみ） */
	.cats {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		padding-block: 1.1rem;
		border-bottom: 1px solid var(--ink);
		margin-bottom: 2.5rem;
	}

	.cats a {
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--ink);
		letter-spacing: 0.02em;
	}

	.cats a:hover {
		text-decoration: none;
		opacity: 0.5;
	}

	.kicker {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		color: var(--color-text-muted);
		text-transform: uppercase;
		margin-top: 0.9rem;
	}

	.date {
		display: block;
		margin-top: 0.6rem;
		font-size: 0.72rem;
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.03em;
	}

	/* ヒーロー: 大きなリード記事 + 右に2本 */
	.hero {
		display: grid;
		grid-template-columns: 1.55fr 1fr;
		gap: 3rem;
		margin-bottom: 3.5rem;
	}

	.lead,
	.sec,
	.latest a {
		color: var(--ink);
		display: block;
	}

	.lead:hover,
	.sec:hover,
	.latest a:hover {
		text-decoration: none;
	}

	.lead img {
		width: 100%;
		height: auto;
		display: block;
	}

	.lead-title {
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		line-height: 1.5;
		font-weight: 700;
		margin-top: 0.6rem;
	}

	.lead:hover .lead-title {
		opacity: 0.65;
	}

	.lead-desc {
		margin-top: 0.7rem;
		font-size: 0.9rem;
		line-height: 1.9;
		color: #46403a;
	}

	.hero-side {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.sec img {
		width: 100%;
		height: auto;
		display: block;
	}

	.sec-title {
		font-size: 1.08rem;
		line-height: 1.6;
		font-weight: 600;
		margin-top: 0.5rem;
	}

	.sec:hover .sec-title {
		opacity: 0.65;
	}

	/* 本文グリッド: 記事リスト + 右レール */
	.main-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 280px;
		gap: 3.5rem;
		padding-bottom: 4rem;
	}

	.rail-head {
		font-size: 1.05rem;
		font-weight: 700;
		padding-bottom: 0.6rem;
		border-bottom: 2px solid var(--ink);
		margin-bottom: 1.25rem;
	}

	.latest ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.latest li {
		padding-block: 1.5rem;
		border-bottom: 1px solid var(--color-border);
	}

	.latest li:first-child {
		padding-top: 0;
	}

	.latest li a {
		display: grid;
		grid-template-columns: 220px minmax(0, 1fr);
		gap: 1.5rem;
		align-items: start;
	}

	.latest li img {
		width: 100%;
		height: auto;
		display: block;
	}

	.row-title {
		font-size: 1.12rem;
		line-height: 1.6;
		font-weight: 600;
		margin-top: 0.35rem;
	}

	.latest li a:hover .row-title {
		opacity: 0.6;
	}

	.latest li .kicker {
		margin-top: 0;
	}

	.more {
		display: inline-block;
		margin-top: 2rem;
		font-size: 0.85rem;
		font-weight: 500;
		color: var(--ink);
		border-bottom: 1px solid var(--ink);
		padding-bottom: 2px;
	}

	.more:hover {
		text-decoration: none;
		opacity: 0.6;
	}

	/* 右レール */
	.rail {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		position: sticky;
		top: 84px;
		align-self: start;
	}

	.rank {
		list-style: none;
		margin: 0;
		padding: 0;
		counter-reset: r;
	}

	.rank li {
		border-bottom: 1px solid var(--color-border);
	}

	.rank li:last-child {
		border-bottom: 0;
	}

	.rank a {
		display: flex;
		gap: 0.8rem;
		padding-block: 0.8rem;
		color: var(--ink);
		align-items: baseline;
	}

	.rank a:hover {
		text-decoration: none;
		opacity: 0.6;
	}

	.num::before {
		counter-increment: r;
		content: counter(r);
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--ink);
		min-width: 1.1rem;
		display: inline-block;
	}

	.rank a span:last-child {
		font-size: 0.83rem;
		line-height: 1.65;
		font-weight: 500;
	}

	.promo {
		background: var(--ink);
		color: #fff;
		padding: 1.4rem 1.3rem;
	}

	.promo-lead {
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 700;
	}

	.promo-text {
		margin-top: 0.6rem;
		font-size: 0.78rem;
		line-height: 1.8;
		color: #cfc8bf;
	}

	.promo-btn {
		display: block;
		margin-top: 1rem;
		text-align: center;
		background: #fff;
		color: var(--ink);
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.7rem;
	}

	.promo-btn:hover {
		text-decoration: none;
		background: #ede9e2;
	}

	.run {
		font-size: 0.82rem;
		line-height: 1.9;
		color: #46403a;
	}

	.run a {
		color: var(--ink);
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	.empty {
		font-size: 0.9rem;
		color: var(--color-text-muted);
		padding-block: 3rem;
	}

	@media (max-width: 900px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.hero-side {
			flex-direction: row;
			gap: 1.5rem;
		}

		.sec {
			flex: 1;
		}

		.main-grid {
			grid-template-columns: 1fr;
			gap: 3rem;
		}

		.rail {
			position: static;
		}
	}

	@media (max-width: 600px) {
		.hero-side {
			flex-direction: column;
		}

		.latest li a {
			grid-template-columns: 120px minmax(0, 1fr);
			gap: 1rem;
		}
	}
</style>
