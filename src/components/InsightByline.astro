---
interface Props {
  published: string;
  modified?: string;
}
const { published, modified } = Astro.props;
const updated = modified ?? published;
function formatDate(value: string) {
  const [y, m, d] = value.split('-');
  return `${y}年${Number(m)}月${Number(d)}日`;
}
---
<p class="insight-byline">更新日：<time datetime={updated}>{formatDate(updated)}</time></p>
<style>
  .insight-byline { margin: 1.25rem 0 0; color: var(--color-text-muted); font-size: 1rem; line-height: 1.8; }
</style>
