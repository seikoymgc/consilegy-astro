				<g font-family="inherit">
<rect x="40" y="20" width="236" height="140" rx="6" fill="#fff" stroke="#E2E8F0"/><text x="58" y="56" font-size="14" fill="#64748b" letter-spacing="1">INPUT</text><text x="58" y="90" font-size="18" font-weight="600" fill="#0F172A">Snap, speak, paste</text>
<text x="58" y="130" font-size="16" fill="#475569">Cards, voice, notes</text>
<line x1="276" y1="90" x2="308" y2="90" stroke="#0F172A" stroke-width="2" marker-end="url(#in-arr)"/>
