		margin-bottom: 2rem;
	}

	.breadcrumb a { color: inherit; text-decoration: none; }
	.breadcrumb a:hover { color: var(--color-primary, #1e40af); }

	/* ── Article header ────────────────────────────────────── */
	.article-head {
		padding-top: 3rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid var(--color-border, #e2e8f0);
	}

	.article-meta {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
		flex-wrap: wrap;
	}

	.article-cat {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-primary, #1e40af);
		background: rgba(30, 64, 175, 0.07);
		padding: 0.2em 0.7em;
		border-radius: 4px;
	}

