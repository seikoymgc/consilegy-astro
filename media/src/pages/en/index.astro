---
import '../../styles/journal-home.css';
import { MEDIA_DESCRIPTION_EN } from '../../site-config';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { categoriesEn, type CategoryKey } from '../../content.config';

const notes = (await getCollection('notesEn', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
);

const lead = notes[0];
const secondary = notes.slice(1, 4);
const rest = notes.slice(4, 12);
const recommended = notes.slice(12, 17);
const hasSide = secondary.length > 0;

const fmt = (d: Date) =>
	d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
	lang="en"
	title="B2B Revenue Strategy Journal | Marketing, sales and CRM in Japan"
	description={MEDIA_DESCRIPTION_EN}
	jaPath="/"
	enPath="/en/"
>
	<div class="wrap edition-line"><h1>Insights for your next decision.</h1><span>JAPAN / REVENUE / OPERATIONS</span></div>

	{
		notes.length === 0 ? (
			<div class="wrap"><p class="empty">First articles are in preparation. In the meantime, see <a href="https://consilegy.com/en/">consilegy.com/en</a>.</p></div>
		) : (
			<>
				<section class={`wrap hero ${hasSide ? '' : 'hero--solo'}`}>
					{lead && (
						<a href={`/en/articles/${lead.id}/`} class="lead"><span class="feature-label">LATEST INSIGHT</span>
							<img src={`/images/eyecatch/${lead.id}-2026jp2.webp`} alt="" width="1200" height="630" fetchpriority="high" decoding="async" />
							<p class="kicker">{categoriesEn[lead.data.category as CategoryKey]}</p>
							<h2 class="lead-title">{lead.data.title}</h2>
							<p class="lead-desc">{lead.data.description}</p>
							<time class="date" datetime={lead.data.publishedAt.toISOString()}>{fmt(lead.data.publishedAt)}</time>
						</a>
					)}
					{hasSide && (
						<div class="hero-side"><p class="side-heading">RECENT ARTICLES</p>
							{secondary.map(n => (
								<a href={`/en/articles/${n.id}/`} class="sec">
									<img src={`/images/eyecatch/${n.id}-2026jp2.webp`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
									<p class="kicker">{categoriesEn[n.data.category as CategoryKey]}</p>
									<h3 class="sec-title">{n.data.title}</h3>
									<time class="date" datetime={n.data.publishedAt.toISOString()}>{fmt(n.data.publishedAt)}</time>
								</a>
							))}
						</div>
					)}
				</section>


				<section class="wrap topic-directory" aria-labelledby="topics-heading">
					<div class="topic-intro"><span>EXPLORE TOPICS</span><h2 id="topics-heading">Find your next insight</h2></div>
					<div class="topic-grid">{(Object.keys(categoriesEn) as CategoryKey[]).map((key, i) => <a href={`/en/category/${key}/`}><span class="topic-number">0{i + 1}</span><span>{categoriesEn[key]}</span><span aria-hidden="true">↗</span></a>)}</div>
				</section>
				<div class="wrap main-grid">
					<section class="latest">
						{rest.length > 0 && (
							<>
								<h2 class="rail-head"><small>LATEST ARTICLES</small>More articles</h2>
								<ul>
									{rest.map(n => (
										<li>
											<a href={`/en/articles/${n.id}/`}>
												<img src={`/images/eyecatch/${n.id}-2026jp2.webp`} alt="" width="1200" height="630" loading="lazy" decoding="async" />
												<div>
													<p class="kicker">{categoriesEn[n.data.category as CategoryKey]}</p>
													<h3 class="row-title">{n.data.title}</h3>
											<p class="row-desc">{n.data.description}</p>
													<time class="date" datetime={n.data.publishedAt.toISOString()}>{fmt(n.data.publishedAt)}</time>
												</div>
											</a>
										</li>
									))}
								</ul>
							</>
						)}
						{rest.length === 0 && (
							<p class="soon">More Japan-market guides are on the way. Follow along via <a href="/en/rss.xml">RSS</a> or the <a href="https://consilegy.com/en/">corporate site</a>.</p>
						)}
						<a href="/en/articles/" class="more">View all articles →</a>
					</section>

					<aside class="rail">
						{recommended.length >= 3 && (
							<section class="rail-box">
								<h2 class="rail-head"><small>MORE INSIGHTS</small>More perspectives</h2>
								<ol class="rank">
									{recommended.map(n => (
										<li>
											<a href={`/en/articles/${n.id}/`}>
												<span class="num" />
												<span>{n.data.title}</span>
											</a>
										</li>
									))}
								</ol>
							</section>
						)}

						<section class="rail-box promo">
							<p class="promo-lead">Entering the Japanese market?</p>
							<p class="promo-text">We help global SaaS and enterprise teams build revenue operations that work in Japan. Free 30-minute consultation.</p>
							<a href="https://consilegy.com/en/contact-en/" class="promo-btn">Talk to us</a>
						</section>

						<section class="rail-box">
							<h2 class="rail-head">About</h2>
							<p class="run">
								This edition is published by
								<a href="https://consilegy.com/en/">Consilegy LLC</a>, a RevOps and Revenue Architecture consultancy working across Japanese enterprises and global SaaS companies. <a href="/en/about/">About the editorial team →</a>
							</p>
						</section>
					</aside>
				</div>
			</>
		)
	}
</BaseLayout>
