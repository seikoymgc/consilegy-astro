---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';

// プロダクトの contractor エディション（src/lib/editions/index.ts）に実装済みの
// ものだけ記載。用語は商談→案件に差し替わる。coreNav は /deals・/companies・
// /quotes・/delivery・/resources、既定の自動化は sal-31/37/39/41 と cs-30。
const screens = [
	{
		src: 'resources',
		title: '空き枠カレンダー',
		desc: 'メンバー×週で、割り当て人日とキャパを並べます。いつ誰が空くかを、感覚ではなく数字で見られます。',
		alt: '空き枠カレンダーの画面。今週の稼働率54%、今週の空き人日7.8、逼迫週0、余剰週7のカード。その下にメンバー4名×13週の表があり、各セルに割当人日／キャパが入っている。',
	},
	{
		src: 'delivery',
		title: 'デリバリー',
		desc: 'キックオフ・制作・レビュー・納品の工程を案件ごとに持ちます。滞留日数と期限、想定と実績の人日が同じ行に出ます。',
		alt: 'デリバリーの画面。案件・会社・金額・デリバリー工程・滞留・期限・想定/実績（人日）の列が並び、6件の受注案件が工程ごとに表示されている。',
	},
	{
		src: 'quotes',
		title: '見積書',
		desc: '下書き、送付済み、承認のステータスで管理します。明細は人日×単価で積み上げます。',
		alt: '見積書の一覧画面。4件の見積が、承認・下書き・送付済みのステータスバッジ、コンタクト、会社、合計金額、有効期限つきで並んでいる。',
	},
	{
		src: 'deals',
		title: '案件',
		desc: '商談ではなく「案件」で呼びます。アプローチから見積までのステージごとに、金額と件数が出ます。',
		alt: '案件のカンバン画面。アプローチ・ヒアリング・提案・見積のステージに案件カードが並び、各ステージの合計金額と確度、案件ごとの金額とクローズ予定日が出ている。',
	},
];

const problems = [
	{
		title: '受注してから、回せないと気づく',
		text: '見積を出すときに手が空いているかを確かめていない。取れてから、誰も入れられないことが分かる。',
	},
	{
		title: '誰がいつ空くか分からない',
		text: '稼働の見通しがPMの頭の中にしかない。前倒しできる案件も、断るべき案件も判断できない。',
	},
	{
		title: '納品後がそのまま流れる',
		text: '検収、請求、保守契約の更新。受注の熱が引いた後の工程が、誰の担当でもなくなっている。',
	},
];

// 既定で入る5本（contractor の defaultAutomations = sal-31/37/39/41 と cs-30）。
// text は src/lib/revops/outcomes.ts の日本語。ただしこのエディションでは
// 商談を「案件」と呼ぶので、そこだけ用語を合わせている。
const projectEngine = [
	{ label: '見積', text: '見積の依頼が来たら、作成タスクを自動で作成' },
	{ label: '停滞', text: '止まっている案件を自動で見つけて知らせる' },
	{ label: '予測', text: '案件の変更を、売上予測に自動で反映' },
	{ label: '受注後', text: '受注したら、後続の処理を自動で開始' },
	{ label: '保守更新', text: '契約更新日を自動で管理してリマインド' },
];

const roles = [
	{ name: 'オーナー', scope: '全案件・稼働・請求・権限設定' },
	{ name: '管理者', scope: '運用全般と権限設定' },
	{ name: 'PM', scope: '担当チームの案件・見積・稼働を閲覧・編集' },
	{ name: 'メンバー', scope: '自分が入っている案件のみ' },
];
---

<BaseLayout
	title="Revenue CRM 受託開発版（β版） | 見積を出す前に、空きが見えている"
	description="受託開発・制作会社向けの画面構成。案件・見積・稼働・納品を1か所で管理。メンバー×週の空き枠カレンダー、工程ごとの滞留と期限、保守契約の更新リマインドまで。現在クローズドβ。"
	lang="ja"
	alternateUrl="/en/crm/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	"itemListElement": [
		{"@type": "ListItem", "position": 1, "name": "ホーム", "item": "https://consilegy.com/"},
		{"@type": "ListItem", "position": 2, "name": "Revenue CRM", "item": "https://consilegy.com/crm/"},
		{"@type": "ListItem", "position": 3, "name": "受託開発版", "item": "https://consilegy.com/crm/contractor/"}
	]
})} />

<!-- ===================== HERO ===================== -->
<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM 受託開発版 <span class="no-upper">β版</span></p>
			<h1>見積を出す前に、<br />空きが見えている。</h1>
			<p class="hero-lead">
				案件はスプレッドシート。稼働はPMの感覚。見積はその都度Excel。
				受託開発版は、<strong>案件・見積・稼働・納品を1か所で見て、着手できる時期から逆算して見積を出せる</strong>構成です。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href="#screens" class="btn btn--secondary">画面を見る</a>
			</div>
			<ul class="hero-points" aria-label="受託開発版の特徴">
				<li>商談ではなく「案件」で管理</li>
				<li>メンバー×週で空きを可視化</li>
				<li>クローズドβで開発中</li>
			</ul>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/contractor/screen-resources.webp"
				alt="空き枠カレンダーの画面。今週の稼働率54%、空き人日7.8、逼迫週0、余剰週7のカードと、メンバー4名×13週の割当表。"
				width="1432"
				height="840"
				decoding="async"
			/>
			<figcaption>空き枠カレンダー：メンバー×週で、割り当てと空きを同じ画面で</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== POSITIONING ===================== -->
<section class="positioning">
	<div class="container">
		<div class="pos-body">
			<p class="pos-lead">
				追いかけるのは「受注できるか」ではなく、<br />
				「受けて回せるか」です。
			</p>
			<div class="pos-copy">
				<p>
					だから中心に置いたのは<strong>案件</strong>です。このエディションでは商談を案件と呼びます。
					画面の言葉が変わるだけでなく、見積、受注、納品、請求、保守更新までを1本の案件で追えます。
				</p>
				<p>
					受託の粗利は、取れたかどうかより<strong>誰をいつ入れたか</strong>で決まります。
					稼働をメンバー×週の表で持っているので、見積を出す前に着手できる時期を確かめられます。
					前倒しできる案件と、断るべき案件が分かります。
				</p>
				<p>
					保守契約は受注のあとに続く売上です。更新日を持たせて、期日が来る前にリマインドします。
				</p>
				<a href="/revenue-architecture/" class="pos-link">この考え方について読む →</a>
			</div>
		</div>
	</div>
</section>

<!-- ===================== PROBLEM ===================== -->
<section class="problem">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">こんな課題に</p>
			<h2 class="prob-title">案件は取れているのに、利益が残っていませんか。</h2>
		</div>
		<div class="prob-grid">
			{problems.map((item, index) => (
				<article class="prob-item">
					<span class="issue-label" aria-label={`項目 ${index + 1}`}>
						<span class="issue-label__number">{String(index + 1).padStart(2, '0')}</span>
					</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== SCREENS ===================== -->
<section class="screens" id="screens">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">画面構成</p>
			<h2 class="sc-title">案件を軸に、日々見る画面を揃えています。</h2>
		</div>
		<div class="sc-grid">
			{screens.map((s) => (
				<article class="sc-card">
					<figure class="sc-shot">
						<img
							src={`/images/crm/contractor/screen-${s.src}.webp`}
							alt={s.alt}
							width="1432"
							height="840"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div>
						<h3>{s.title}</h3>
						<p>{s.desc}</p>
					</div>
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== 案件エンジン ===================== -->
<section class="support">
	<div class="container support-inner">
		<div>
			<p class="section-eyebrow">案件エンジン</p>
			<h2>取りこぼしを、人の記憶から外します。</h2>
			<p class="support-lead">
				受託開発版を作ると、案件まわりの自動化が最初からONになっています。
				見積依頼からタスクを作り、止まった案件を拾い、受注後の処理を起こし、
				保守契約の更新日を管理するところまで、毎晩の処理として走ります。
			</p>
			<p class="support-lead">
				自動化が作るのはタスクと通知と下書きです。顧客に何かが自動で送られることはありません。
				担当者が中身を見て、直してから動かします。
			</p>
		</div>
		<div class="support-list">
			<h3>既定でONになるもの</h3>
			<ul>
				{projectEngine.map((r) => (
					<li><span>{r.label}</span><strong>{r.text}</strong></li>
				))}
			</ul>
		</div>
	</div>
</section>

<!-- ===================== AI ===================== -->
<section class="ai">
	<div class="container ai-inner">
		<div>
			<p class="section-eyebrow">AI</p>
			<h2>日本語で聞けば、<br />その場で返ってきます。</h2>
			<p class="ai-lead">
				知りたいことのために、集計を組み立てる必要はありません。
				話すとおりに聞けば、案件と稼働のデータを探して答えます。
			</p>
			<p class="ai-lead">
				来月の空き、期限が近い案件、止まっている案件、更新が近い保守契約。
				どれも表を作らずに、その場で確認できます。
			</p>
			<p class="ai-lead">
				AIが書いたものは、すべて下書きのまま止まります。
				担当者が確認して確定するまで、顧客には出ません。
			</p>
		</div>
		<ul class="ai-examples">
			<li>今週の空き人日は？</li>
			<li>期限が近い案件は？</li>
			<li>止まっている案件は？</li>
			<li>保守契約の更新はいつ？</li>
		</ul>
	</div>
</section>

<!-- ===================== ROLES ===================== -->
<section class="roles">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">権限管理</p>
			<h2 class="ro-title">担当案件の外は、見えないようにできます。</h2>
		</div>
		<p class="ro-lead">
			顧客・会社・案件のそれぞれについて、見える範囲を「全体・チーム・自分」から選べます。
			協力会社のメンバーを入れる場合も、担当案件だけに絞れます。エクスポートの可否は別に設定できます。
			下は設定例です。
		</p>
		<dl class="ro-list">
			{roles.map((r) => (
				<div class="ro-row">
					<dt>{r.name}</dt>
					<dd>{r.scope}</dd>
				</div>
			))}
		</dl>
		<p class="ro-note">操作ログが残るので、誰がいつ何を変更したかを後から追えます。</p>
	</div>
</section>

<!-- ===================== FINAL CTA ===================== -->
<section class="final-cta">
	<div class="container cta-inner">
		<div>
			<p class="cta-eyebrow"><span class="no-upper">クローズドβ</span></p>
			<h2>一緒に育てていただける<br />制作会社を探しています。</h2>
			<p class="cta-lead">
				クローズドβは、完成品を売る段階ではありません。
				実際の案件で使っていただき、足りないものを教えていただきながら仕上げていく段階です。
				デモはメールアドレスだけで、その場でご覧いただけます。
			</p>
			<div class="cta-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href="/crm/" class="btn btn--secondary">法人向けを見る</a>
			</div>
		</div>
		<div class="cta-card">
			<h4>デモでお見せする内容</h4>
			<ul class="cta-list">
				<li>空き枠カレンダーと稼働率の見え方</li>
				<li>案件ごとのデリバリー工程と滞留</li>
				<li>見積の作成と人日×単価の積み上げ</li>
				<li>受注後に自動で起きる処理</li>
				<li>メンバー向けの権限設定と操作ログ</li>
			</ul>
		</div>
	</div>
</section>

</BaseLayout>

<style>
	.section-eyebrow,
	.eyebrow,
	.cta-eyebrow {
		margin: 0;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	/* uppercase はギリシャ文字も変えるので β が B になる。
	   ラテン文字だけ大文字にしたいので、日本語まじりの語は除外する。 */
	.section-eyebrow .no-upper,
	.eyebrow .no-upper,
	.cta-eyebrow .no-upper {
		text-transform: none;
	}

	h2,
	h3 {
		letter-spacing: 0;
	}

	h2 {
		margin: 0;
		color: var(--color-text);
		font-size: 2rem;
		font-weight: 500;
		line-height: 1.4;
		text-wrap: balance;
	}

	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 46px;
		padding: 0.8rem 1.35rem;
		border: 1px solid var(--color-border);
		border-radius: 4px;
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.25;
		text-decoration: none;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.btn--primary {
		background: var(--color-primary);
		border-color: var(--color-primary);
		color: #fff;
	}

	.btn--primary:hover {
		background: var(--color-primary-dark);
		border-color: var(--color-primary-dark);
		color: #fff;
	}

	.btn--secondary {
		background: transparent;
		color: var(--color-text);
	}

	.btn--secondary:hover {
		border-color: var(--color-primary);
		color: var(--color-primary);
	}

	.hero-actions,
	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: var(--space-md);
	}

	.hero {
		padding: var(--space-lg) 0 var(--space-md);
		background: var(--color-bg);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 0.95fr) minmax(360px, 0.78fr);
		gap: var(--space-xl);
		align-items: start;
	}

	.hero-copy {
		max-width: 720px;
	}

	.eyebrow {
		display: block;
		margin-bottom: var(--space-md);
		padding-top: 0.875rem;
		border-top: 1px solid var(--color-border);
	}

	.hero h1 {
		max-width: 13em;
		margin: 0;
		color: var(--color-text);
		font-size: 3.125rem;
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: 0;
		text-wrap: balance;
	}

	.hero-lead {
		max-width: 43em;
		margin: var(--space-md) 0 0;
		color: var(--color-text);
		font-size: 1.0625rem;
		line-height: 2;
	}

	.hero-lead strong {
		font-weight: 700;
	}

	.hero-points {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0;
		margin: var(--space-md) 0 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.hero-points li {
		min-width: 0;
		padding: 0.85rem 1rem;
		color: var(--color-text-muted);
		font-size: 0.8125rem;
		line-height: 1.6;
	}

	.hero-points li + li {
		border-left: 1px solid var(--color-border);
	}

	.pos-link {
		color: var(--color-primary);
		font-weight: 600;
		text-decoration: none;
		border-bottom: 1px solid currentColor;
	}

	.hero-media {
		margin: 0;
		min-width: 0;
	}

	.hero-media img,
	.prob-shot img {
		width: 100%;
		height: auto;
		display: block;
		border: 1px solid var(--color-border);
		border-radius: 0;
		background: #fff;
		box-shadow: none;
	}

	.hero-media figcaption,
	.prob-shot figcaption {
		margin-top: 0.65rem;
		color: var(--color-text-muted);
		font-size: 0.75rem;
		line-height: 1.6;
	}

	.positioning,
	.problem,
	.screens,
	.support,
	.ai,
	.roles,
	.final-cta {
		padding: var(--space-2xl) 0;
		background: var(--color-bg);
	}

	.screens,
	.roles {
		background: var(--color-bg-subtle);
		border-top: 1px solid var(--color-border);
		border-bottom: 1px solid var(--color-border);
	}

	.prob-shot {
		max-width: 900px;
		margin: 0;
		background: transparent;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}

	.positioning {
		border-bottom: 1px solid var(--color-border);
	}

	.pos-body {
		display: grid;
		grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
		gap: var(--space-xl);
		align-items: start;
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	.pos-lead {
		margin: 0;
		color: var(--color-text);
		font-size: 1.375rem;
		font-weight: 500;
		line-height: 1.7;
		text-wrap: balance;
	}

	.pos-copy p {
		margin: 0 0 1rem;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.9;
	}

	.pos-body strong {
		color: var(--color-text);
		font-weight: 700;
	}

	.pos-link {
		display: inline-flex;
		margin-top: 0.25rem;
		font-size: 0.9375rem;
	}

	.section-head {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		gap: var(--space-lg);
		align-items: start;
		margin-bottom: var(--space-lg);
		padding-top: var(--space-sm);
		border-top: 1px solid var(--color-border);
	}

	.prob-grid,
	.sc-grid {
		display: grid;
		gap: 0;
		border-top: 1px solid var(--color-border);
	}

	.prob-grid {
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.prob-item,
	.sc-card {
		min-width: 0;
		padding: 1.35rem 1.5rem 1.35rem 0;
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--color-border);
		border-radius: 0;
	}

	.prob-item:nth-child(2),
	.prob-item:nth-child(3) {
		padding-left: var(--space-md);
		border-left: 1px solid var(--color-border);
	}

	.issue-label {
		display: flex;
		align-items: flex-end;
		gap: 0.85rem;
		margin-bottom: 0.9rem;
		color: var(--color-primary);
	}

