---
import SitePhoto from './SitePhoto.astro';
import type { PhotoSubject } from '../lib/editorial-photos';
interface Props { subject: PhotoSubject; lang?: string; priority?: boolean; caption?: string; }
const { subject, lang = 'ja', priority = true, caption } = Astro.props;
---
<div class="photo-intro">
  <div class="photo-intro__copy"><slot /></div>
  <SitePhoto subject={subject} lang={lang} priority={priority} caption={caption} />
</div>
<style>
  .photo-intro { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: clamp(2rem, 4vw, 4rem); align-items: center; }
  .photo-intro__copy { min-width: 0; }
  .photo-intro .photo-intro__copy :global(h1) { font-size: clamp(1.85rem, 2.4vw, 2.4rem); line-height: 1.45; }
  @media (max-width: 900px) { .photo-intro { grid-template-columns: minmax(0, 1fr); gap: 1.75rem; } }
</style>
