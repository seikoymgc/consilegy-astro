		vertical-align: middle;
	}

	.article-head h1 {
		font-size: clamp(1.5rem, 3vw, 2.1rem);
		font-weight: 600;
		color: var(--color-navy, #0f172a);
		line-height: 1.35;
		margin: 0 0 1rem;
	}

	.article-desc {
		font-size: 1rem;
		line-height: 1.75;
		color: var(--color-charcoal, #334155);
		margin: 0;
	}

	/* ── Article body ──────────────────────────────────────── */
	.article-body { padding-block: 3rem; }

	.article-section { margin-bottom: 0; }

	.article-section h2 {
		font-size: clamp(1.15rem, 2.2vw, 1.4rem);
		font-weight: 600;
		color: var(--color-navy, #0f172a);
		margin: 0 0 1.25rem;
		line-height: 1.45;
		padding-bottom: 0.6rem;
		border-bottom: 2px solid var(--color-border, #e2e8f0);
	}

