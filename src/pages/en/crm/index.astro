---
import SitePhoto from '../../../components/SitePhoto.astro';
import { featureCount } from '../../../data/crm-features';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CrmSubnav from '../../../components/CrmSubnav.astro';
import CrmLanguages from '../../../components/CrmLanguages.astro';
import { timeTablesEn, timeSavedNoteEn } from '../../../data/crm-time-saved';

const DEMO_URL = 'https://crm.consilegy.com/demos?lang=en';
const SIGNUP_URL = 'https://crm.consilegy.com/signup';

// Mirrors /crm/ section for section, in the same order and with the same styles (2026-11-26):
// hero, editions, 4 features, pricing, Made in Japan (EN only), problems, founder's note, after,
// time saved, AI learning, demo, mobile, languages, support + security, FAQ, final CTA.
// When /crm/ changes, change this page too. There is no English download page, FAQ page,
// or standard-edition page yet, so those links point to /en/crm/pricing/ and /en/crm/features/.

const supports = [
	{ tier: 'Videos & help articles', figure: 'Free', text: 'Free on every plan. Where teams that set it up themselves start.' },
	{ tier: 'Initial setup', figure: '¥120,000 and up', text: 'Fields, deal stages, and automations set to how your team works. 3 walkthrough sessions.' },
	{ tier: 'Adoption support (3 months)', figure: '¥300,000 and up', text: 'A weekly meeting, review of settings, and one-on-one help with how to use it.' },
	{ tier: 'Operations support', figure: '¥30,000 / month and up', text: 'We make settings changes for you and answer your questions (up to 2 hours a month).' },
	{ tier: 'Custom development', figure: 'Quoted', text: 'We add features to fit the way your company runs.' },
];

const mobilePoints = [
	{ title: 'No app to install', text: 'Open it in the browser. The screens switch to fit the width of your phone.' },
	{ title: 'Scan cards on the spot', text: 'Photograph a business card and AI reads it, so you can add contacts at a client site or a trade show.' },
	{ title: 'Check deals on the go', text: 'Amount, stage, and the next appointment, all checkable between meetings.' },
	{ title: 'Same data as your PC', text: 'What you change on your phone shows up on your computer straight away.' },
];

// Left: how a rollout usually slides back. Right: what Revenue CRM does about it.
const problems = [
	{ topic: 'Data entry', problem: 'No time to write up<br />the record after a meeting.', answer: 'AI drafts the record. After a call, just speak. Snap a business card, paste the meeting notes, and the contacts and tasks are made. The person in charge checks it and saves.' },
	{ topic: 'Getting started', problem: 'Learning the system<br />takes too long.', answer: 'Screens and automations that fit your business, from day one. Choose an edition and start with screens built around what you manage: deals, projects, capacity, contracts, or enrollment.' },
	{ topic: 'Knowledge silos', problem: 'When the one person who set it up leaves, nobody can fix it.', answer: 'Settings stay visible in the screens, so whoever takes over can see exactly how it works. Automations are picked from a library of 175 and switched on. How-to videos and help articles are free on every plan.' },
];

const afters = [
	{ title: 'Revenue grows', figure: '175', unit: 'automations', note: 'Watching for stalled deals and due dates', text: 'AI suggests the next action for each customer. You can follow what happened to every lead marketing handed over. Deals waiting on sign-off, or won now but booked next period, stay tracked as they are.' },
	{ title: 'Time comes back', figure: '3', unit: 'ways in', note: 'Snap a card, speak, or paste notes. AI drafts the record', text: 'Less time spent asking around: “Did anyone call them?” “Who owns this account?”' },
	{ title: 'Friction between teams fades', figure: '1', unit: 'record', note: 'Marketing, sales, and customer success on one customer record', text: 'Marketing and sales see the same customer, so nobody has to explain the history again at every handoff.' },
];

// Cards right below the hero. Text follows each edition page's description.
const editionCards = [
	{ who: 'Startups', tag: 'CRM for Startups', text: 'Plenty of ready-made automations for startups that want to focus on selling.', href: '/en/crm/startups/' },
	{ who: 'Small and mid-sized companies', tag: 'Standard', text: 'AI records customer details from business cards and meeting notes. Deal management, kept simple.', href: '/en/crm/features/' },
	{ who: 'Development & web production', text: 'Projects, quotes, and delivery in one place, with who is free at a glance.', href: '/en/crm/contractor/' },
	{ who: 'Consulting & marketing agencies', text: 'Projects, contracts, and capacity in one place. Retainer renewals never slip by.', href: '/en/crm/services/' },
	{ who: 'SaaS resellers', text: 'Contracts, revenue, and renewals in one place. MRR and ARR at a glance.', href: '/en/crm/reseller/' },
	{ who: 'Online schools', text: 'Bookings on LINE go straight to the calendar. AI writes up the lesson notes.', href: '/en/crm/school/' },
];

// Same four points as /crm/ (headings decided 2026-10-25). Facts only.
const features = [
	{ title: 'Full features and AI, at a price within reach.', text: 'An AI agent and 175 automations from ¥3,000 per user per month. Monthly “Fuel” for AI processing is included. No setup fee, and you can try it free for 30 days.' },
	{ title: 'Fits each person’s language and the way business is done in Japan.', text: 'Each person switches between 日本語, English, and 繁體中文. Deals waiting on internal approval (ringi), or won now but booked next fiscal year, are handled as they are.' },
	{ title: 'Screens and automations for your business, from day one.', text: 'B2B sales, development and production, consulting, resellers, and schools. Each edition has screens and automations built around what it manages: deals, projects, capacity, contracts, or enrollment.' },
	{ title: 'Your team’s knowledge and sales experience, turned into the next move by AI.', text: 'From the record of every exchange, AI suggests the next action for each customer. It takes the calls people corrected as examples and grows into an AI that fits your company. That learning stays inside your company.' },
];

const plans = [
	{ tier: 'User plan', figure: '¥3,000', unit: '/ user / month', for: 'B2B, development, consulting, and reseller editions. For teams that use it every day' },
	{ tier: 'Student plan', figure: '¥9,800', unit: '/ month and up', for: 'School edition. Up to 50 enrolled students' },
	{ tier: 'Prepaid plan', figure: '¥3,000', unit: '/ month', for: 'All editions. For teams that use it less often' },
];

// Same family as the safeguards on /en/crm/school/. Only the three asked about before buying.
const safeguards = [
	{ label: 'Never trained on', text: 'Card scanning, handwriting recognition, and transcription run on services under terms that exclude what you send from training.' },
	{ label: 'Invisible to other companies', text: 'Each company is isolated by row-level access control in the database, not by application filtering alone.' },
	{ label: 'Held in Tokyo', text: 'Data is stored in the Tokyo region. AI processing goes through Anthropic, OpenAI, and Google (US), under contracts that exclude what you send from training.' },
];

const faqs = [
	{ q: 'What does it cost?', a: 'There are three plans. The User plan is ¥3,000 per user per month. The Student plan for schools starts at ¥9,800 per month for up to 50 enrolled students. For teams that use it less often, the Prepaid plan is ¥3,000 per month with 100 Fuel, topped up as needed. No setup fee. Every plan comes with a 30-day free trial, no card required. All prices exclude tax.' },
	{ q: 'How are users counted?', a: 'By the members who have joined the workspace, including accounts that were invited but are not in use. Changes apply from the next invoice.' },
	{ q: 'How do we cancel?', a: 'The User and Student plans run for 1 year and renew automatically each year. They cannot be cancelled mid-term; to end one, let us know at least 1 month before the term ends. The Prepaid plan renews monthly and ends if you tell us at least 14 days before the next renewal date. Payment is monthly in advance, and fees already paid are not refunded.' },
	{ q: 'Can we take our data out?', a: 'Export contacts, companies, and deals, plus activities, notes, tasks, emails, and attachments, to CSV from Settings at any time, and for 30 days after the contract ends. Your data is yours.' },
	{ q: 'Can we migrate from Salesforce, HubSpot, or our current system?', a: 'Yes. We can review your current fields and workflows and explain what Revenue CRM can support. Customer lists kept in spreadsheets can be imported as CSV, and HubSpot data can be read in. Data migration and integrations are quoted separately based on the data volume and services involved.' },
];

const readings = [
	{ href: '/en/insights/why-crm-implementation-fails-without-revenue-architecture/', title: 'Why CRM implementation fails without revenue architecture' },
	{ href: '/en/insights/where-japan-gtm-breaks-after-lead-generation/', title: 'Where Japan GTM breaks after lead generation' },
	{ href: '/en/insights/lead-handoff-rules-for-japan-gtm-teams/', title: 'Lead handoff rules for Japan GTM teams' },
];
---

<BaseLayout
	title="Revenue CRM: AI does the work for you. A CRM your team won't hate updating"
	description="Revenue CRM: AI does the work for you. A customer relationship management and sales system (CRM / SFA) where data entry isn't a chore. Snap a business card, paste meeting notes, and AI drafts the record. Marketing, sales, and customer success on one customer record. Five editions: startups and small and mid-sized companies (standard), development and web production, consulting and marketing agencies, SaaS resellers, and online schools. From ¥3,000 per user per month, 30 days free. Made in Japan."
	ogImage="/images/og/crm-en-2026c.png"
	lang="en"
	alternateUrl="/crm/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify({
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "Revenue CRM",
	"applicationCategory": "BusinessApplication",
	"applicationSubCategory": "CRM / SFA (customer relationship management and sales force automation)",
	"keywords": "CRM, SFA, sales CRM, small business CRM, AI CRM, business card scanning, meeting notes",
	"operatingSystem": "Web",
	"url": "https://consilegy.com/en/crm/",
	"sameAs": [
		"https://www.itreview.jp/products/revenue-crm/profile",
		"https://www.g2.com/products/revenue-crm/reviews",
		"https://boxil.jp/service/51195/",
		"https://cloud-radar.jp/detail1783.html",
		"https://cloud-radar.jp/detail1784.html"
	],
	"subjectOf": {
		"@type": "NewsArticle",
		"headline": "中小企業向け顧客管理システム「Revenue CRM」正式提供開始。入力がめんどくさくない、AIが記録する顧客管理へ",
		"url": "https://prtimes.jp/main/html/rd/p/000000002.000191457.html",
		"datePublished": "2026-09-28",
		"publisher": { "@type": "Organization", "name": "PR TIMES" }
	},
	"description": "Revenue CRM is a customer relationship management and sales system with five editions: B2B sales, development and production, consulting and marketing agencies, SaaS resellers, and schools. AI drafts records from business cards, voice notes, and meeting notes for people to check and save. The four business editions share a library of 175 automations; the school edition has dedicated classroom workflows. Generally available since 28 September 2026.",
	"inLanguage": ["ja", "en", "zh-Hant"],
	"offers": {
		"@type": "Offer",
		"price": "3000",
		"priceCurrency": "JPY",
		"description": "User plan ¥3,000 per user per month (excl. tax). Student plan from ¥9,800 per month; Prepaid plan ¥3,000 per month with 100 Fuel. No setup fee. 30-day free trial, no card required."
	},
	"author": { "@type": "Organization", "name": "Consilegy LLC", "url": "https://consilegy.com/en/" }
})} />

<CrmSubnav lang="en" />

<!-- ===================== HERO (same layout as /crm/: copy on the left, B2B, school, and phone screens on the right) ===================== -->
<section class="hero hero--unified">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="hero-kicker">The system fits the people.</p>
			<h1>AI does the work<br />for you.<br /><span class="hero-name">Revenue CRM</span></h1>
			<p class="hero-lead">A new kind of CRM and sales system, where data entry isn't a chore.</p>
			<div class="hero-actions">
				<a href={SIGNUP_URL} class="btn btn--cta btn--lg" target="_blank" rel="noopener noreferrer">Start free</a>
				<a href={DEMO_URL} class="btn btn--outline-dark btn--lg" target="_blank" rel="noopener noreferrer">See the demo</a>
			</div>
			<p class="hero-proof">From <strong>¥3,000</strong> per user / month<span class="hero-proof__sep">·</span>30-day free trial<span class="hero-proof__sep">·</span>No card required<span class="hero-proof__sep">·</span>Made in Japan</p>
		</div>
		<div class="hero-shots">
			<figure class="hero-shot hero-shot--b2b">
				<img
					src="/images/crm/screen-dashboard-2026-10c-en.webp"
					alt="The Revenue CRM dashboard: open pipeline, weighted forecast, win rate, overdue tasks, pipeline by stage, and deals to watch, on one screen."
					width="1600"
					height="1000"
					decoding="async"
					fetchpriority="high"
				/>
				<figcaption>B2B sales</figcaption>
			</figure>
			<figure class="hero-shot hero-shot--school">
				<img
					src="/images/common/school-student-detail-en.jpg"
					alt="Revenue CRM school edition: a student's record with assignment submissions and LINE messages in one place."
					width="1100"
					height="744"
					decoding="async"
				/>
				<figcaption>Schools</figcaption>
			</figure>
			<figure class="hero-shot hero-shot--mobile">
				<img
					src="/images/crm/screen-mobile-dashboard-2026-10c-en.webp"
					alt="The Revenue CRM dashboard opened on a smartphone."
					width="780"
					height="1688"
					decoding="async"
				/>
				<figcaption>Smartphone</figcaption>
			</figure>
		</div>
	</div>
</section>

<!-- ===================== EDITIONS (right below the hero: choose your business) ===================== -->
<section class="edition-strip" aria-labelledby="edition-strip-title">
	<div class="container">
		<header class="section-head">
			<p class="section-eyebrow">Editions</p>
			<h2 id="edition-strip-title">A Revenue CRM<br class="br-sp" /> that fits your business.</h2>
		</header>
		<ul class="edition-list">
			{editionCards.map((e) => (
				<li><a href={e.href} class="edition-card"><span class="edition-card__who">{e.who}{e.tag && <span class="edition-card__tag">{e.tag}</span>}</span><span class="edition-card__text">{e.text}</span><span class="edition-card__go btn">Learn more</span></a></li>
			))}
		</ul>
	</div>
</section>

<!-- ===================== FEATURES (the same four points as /crm/) ===================== -->
<section class="features" aria-labelledby="features-title">
	<div class="container">
		<header class="section-head">
			<p class="section-eyebrow">Why Revenue CRM</p>
			<h2 id="features-title">Four things that set Revenue CRM apart.</h2>
		</header>
		<SitePhoto subject="crm" lang="en" panorama />
		<ol class="feature-list">
			{features.map((f, i) => (
				<li class="feature-card"><span class="feature-card__num">{String(i + 1).padStart(2, '0')}</span><h3>{f.title}</h3><p>{f.text}</p></li>
			))}
		</ol>
	</div>
</section>

<!-- ===================== PRICING (pricing at a glance. Details on /en/crm/pricing/) ===================== -->
<section class="pricing-band" aria-label="Pricing at a glance">
	<div class="container">
		<div class="service-summary" id="pricing">
			<p class="section-eyebrow">Pricing</p>
			<h3>Pricing at a glance</h3>
			<dl>
				{plans.map((plan) => (
					<div><dt>{plan.tier}</dt><dd><strong>{plan.figure}</strong> {plan.unit}<br />{plan.for}</dd></div>
				))}
			</dl>
			<p>No setup fee. Every plan comes with a 30-day free trial, no card required. All prices exclude tax.</p>
			<p class="service-summary__links"><a href="/en/crm/pricing/">Pricing details →</a></p>
		</div>
	</div>
</section>

<!-- ===================== MADE IN JAPAN (EN only. Same copy as /en/crm/startups/) ===================== -->
<section class="intl" id="made-in-japan">
	<div class="container">
		<div class="section-head">
			<p class="section-eyebrow">Made in Japan</p>
			<h2>Built for teams that sell in Japan,<br class="br-sp" /> in any language.</h2>
		</div>
		<p class="intl-lead">
			Each member chooses English, Japanese, or Traditional Chinese. The data is shared, so everyone sees the same customers and the same deals. Deals waiting on internal approval (ringi), or won now but booked next fiscal year, are handled as they are.
		</p>
	</div>
</section>

