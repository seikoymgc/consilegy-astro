.btn { border-radius: 4px; }
.btn--lg { padding: 0.875rem 1.75rem; font-size: var(--fs-small); }
.btn--cta { background: #8758C9; color: #fff; border: 1px solid #8758C9; font-weight: 600; font-size: var(--fs-body); transition: background 0.15s, border-color 0.15s; }
.btn--cta:hover { background: #6f45ad; border-color: #6f45ad; color: #fff; }
.btn--hero-outline { background: transparent; color: rgba(255,255,255,0.92); font-weight: 400; font-size: var(--fs-small); border: 1px solid rgba(255,255,255,0.78); white-space: nowrap; }
.btn--hero-outline:hover { background: rgba(255,255,255,0.07); border-color: #fff; color: #fff; }
.btn--outline-primary { background: transparent; color: var(--color-primary); padding: 0.75rem 1.25rem; font-weight: 500; font-size: var(--fs-small); border: 1px solid var(--color-primary); }
.btn--outline-primary:hover { background: rgba(15, 23, 42, 0.05); color: var(--color-primary); }

/* ── Hero（紹介パートナーページ /crm/referral/ の rf-split と同じ配色・構造） ── */
.hero { padding: 0; background: #fff; }
.hero-split { display: grid; grid-template-columns: 1fr 1fr; }
.hero-half { display: flex; padding: var(--space-lg) var(--space-lg) 0; }
.hero-half--b2b { justify-content: flex-end; background: #0B1F44; }
.hero-half--school { justify-content: flex-start; background: #fff; }
.hero-half__inner { display: flex; flex-direction: column; width: 100%; max-width: 560px; }
.hero-half__tag { align-self: flex-start; margin: 0 0 0.75rem; padding: 0.25rem 0.8rem; border-radius: 999px; font-size: var(--fs-small); font-weight: 700; background: #fff; color: var(--color-navy); }
.hero-half--school .hero-half__tag { background: #FF5C3E; color: #fff; }
.hero-half__title { margin: 0; font-size: var(--fs-h2); font-weight: 800; line-height: 1.45; color: #fff; }
.hero-half--school .hero-half__title { color: #10212F; }
.hero-half__text { margin: 0.6rem 0 0; font-size: var(--fs-small); line-height: 1.85; color: rgba(255,255,255,0.9); }
.hero-half--school .hero-half__text { color: #4A5965; }
.hero-half__btn { align-self: flex-start; margin-top: 1rem; padding: 0.7rem 1.25rem; font-size: var(--fs-small); font-weight: 600; background: #fff; color: #0B1F44; border: 1px solid #fff; }
.hero-half__btn:hover { background: #E8EDF7; color: #0B1F44; }
.hero-half--school .hero-half__btn { background: #FF5C3E; color: #fff; border-color: #FF5C3E; }
.hero-half--school .hero-half__btn:hover { background: #E4482C; color: #fff; }
.hero-half__shot { display: block; width: 100%; height: auto; margin-top: var(--space-md); border-radius: 10px 10px 0 0; box-shadow: 0 -8px 40px rgba(0,0,0,0.22); }
.hero-half--school .hero-half__shot { box-shadow: 0 -8px 40px rgba(14,36,56,0.16); }
.hero-base { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-md) var(--space-lg); padding-top: var(--space-lg); padding-bottom: var(--space-lg); border-bottom: 1px solid var(--color-border); }
.hero-eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0 0 0.75rem; font-size: var(--fs-small); font-weight: 600; letter-spacing: 0.08em; color: var(--color-text-muted); }
.hero-eyebrow img { width: 22px; height: 22px; border-radius: 4px; }
.hero-h1__lead { display: inline-block; margin-bottom: 0.2rem; font-size: 0.78em; font-weight: 500; color: var(--color-navy); }
.hero-copy h1 { font-size: var(--fs-h2); font-weight: 500; line-height: 1.35; letter-spacing: -0.01em; color: var(--color-text); margin: 0 0 0.6rem; }
.hero-lead { margin: 0; font-size: var(--fs-body); line-height: 1.78; color: var(--color-text-muted); }
.hero-lead strong { color: var(--color-text); font-weight: 700; }
.hero-kana { display: block; margin-top: 0.35rem; font-size: var(--fs-small); font-weight: 500; letter-spacing: 0.02em; color: var(--color-text-muted); }
.hero-eyebrow__kana { margin-left: -0.5rem; font-weight: 500; letter-spacing: 0; }
.hero-cta { flex: 0 0 auto; }
.hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.hero-actions .btn--cta { padding: 0.95rem 1.6rem; font-size: var(--fs-body); }
.btn--outline-dark { background: transparent; color: #0B1F44; border: 1px solid #0B1F44; font-weight: 500; font-size: var(--fs-small); white-space: nowrap; }
.btn--outline-dark:hover { background: #0B1F44; color: #fff; }
.hero-proof { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem; margin: 0.9rem 0 0; font-size: var(--fs-small); letter-spacing: 0.06em; color: var(--color-text-muted); }
.hero-proof strong { font-size: var(--fs-small); font-weight: 600; color: var(--color-text); letter-spacing: 0; }
.hero-proof__sep { color: var(--color-border); }

/* ── Assurance（紺の帯） ── */
.assurance { background: #0F172A; color: #fff; padding-block: var(--space-xl); }
.assurance-inner { max-width: 44rem; margin: 0 auto; }
.assurance .section-eyebrow { color: rgba(255,255,255,0.65) !important; }
.assurance h2 { font-size: var(--fs-h2); font-weight: 800; line-height: 1.4; margin: 0; color: #fff; }
.assurance-body { margin: var(--space-md) 0 0; line-height: 1.9; color: rgba(255,255,255,0.85); }
.assurance-ways { list-style: none; padding: 0; margin: var(--space-lg) 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
.assurance-ways li { display: grid; gap: 0.2rem; padding: 1rem 1.1rem; border: 1px solid rgba(255,255,255,0.18); border-radius: 6px; background: rgba(255,255,255,0.06); font-size: var(--fs-small); color: rgba(255,255,255,0.8); }
.assurance-ways__k { font-size: var(--fs-h3); font-weight: 700; color: #fff; }

/* ── Problems（薄いグレー帯＋白カードの対応表） ── */
.why { background: #F1F5F9; }
.problems-overview { display: grid; grid-template-columns: 1.3fr 0.9fr; gap: 3rem; align-items: center; margin-bottom: 2.5rem; }
.problem-example { margin: 0; padding: 1.25rem 1.5rem; border-left: 3px solid var(--color-border-strong); background: #fff; border-radius: 0 6px 6px 0; }
.problem-example p { margin: 0; color: var(--color-text-muted); font-size: var(--fs-small); line-height: 1.9; }
.problem-example strong { color: var(--color-text); font-weight: 600; }
.problem-rows { display: grid; gap: 1rem; margin-top: 2rem; }
.problem-row { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2.5rem; padding: 1.5rem 1.75rem; background: #fff; border-radius: 6px; box-shadow: 0 1px 2px rgba(15,23,42,0.06); }
.problem-topic { margin: 0 0 0.6rem; font-size: var(--fs-small); color: var(--color-text-muted); display: flex; align-items: center; gap: 0.5rem; }
.problem-num { font-weight: 700; color: var(--color-navy); letter-spacing: 0.05em; }
.problem-row h3 { margin: 0; font-size: var(--fs-h3); line-height: 1.6; }
.problem-response { padding-left: 1.5rem; border-left: 2px solid #E9E0F5; }
.problem-response .problem-topic { color: var(--color-navy); font-weight: 600; }
.problem-response > p:last-child { margin: 0; font-size: var(--fs-small); line-height: 1.9; color: var(--color-text); }
.problems-more { margin: var(--space-lg) 0 0; }

/* ── After（白カード、数字は紫） ── */
.how { background: var(--color-bg); }
.after-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
.after-item { background: #fff; border: 1px solid var(--color-border);  border-radius: 6px; padding: 1.875rem; box-shadow: 0 1px 2px rgba(15,23,42,0.05); }
.after-item h3 { margin: 0 0 0.75rem; font-size: var(--fs-lead); line-height: 1.5; letter-spacing: -0.01em; }
.after-item p { margin: 0; font-size: var(--fs-small); color: var(--color-text-muted); line-height: 1.85; }
.result-metric { display: flex; flex-direction: column; gap: 0.4rem; margin: 1.25rem 0 !important; }
.result-metric strong { font-size: var(--fs-figure); font-weight: 600; line-height: 1.2; letter-spacing: -0.035em; font-variant-numeric: tabular-nums; color: var(--color-navy); }
.result-metric strong span { font-size: var(--fs-small); font-weight: 400; letter-spacing: 0; margin-inline: 0.2rem; color: var(--color-text); }
.result-metric__note { font-size: var(--fs-small); font-weight: 500; color: var(--color-text-muted); }
.service-summary { margin-top: 3rem; padding: 2rem; background: #F1F5F9; border-radius: 6px; }
.service-summary h3 { font-size: var(--fs-body); margin: 0 0 1rem; }
.service-summary dl { margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
.service-summary dl > div { display: grid; gap: 0.35rem; padding: 1.1rem 1.25rem; background: #fff; border-radius: 6px; }
.service-summary dt, .service-summary dd { margin: 0; font-size: var(--fs-small); line-height: 1.7; }
.service-summary dt { font-weight: 600; }
.service-summary dd { color: var(--color-text-muted); }
.service-summary dd strong { font-weight: 700; color: var(--color-text); font-size: var(--fs-h3); }
.service-summary > p { font-size: var(--fs-small); color: var(--color-text-muted); margin: 1rem 0 0; }
.service-summary__links { display: flex; flex-wrap: wrap; gap: 1.5rem; margin-top: 1rem !important; }
.service-summary__links a { font-size: var(--fs-small) !important; font-weight: 600; }

/* ── Editions（4枚のカード＋ブラウザ枠のデモ） ── */
/* ── Learning（判断材料が貯まる） ── */
.learning { background: var(--color-bg); border-top: 1px solid var(--color-border); }
.learning-inner { max-width: 52rem; }
.learning-body { margin: 0; line-height: 1.9; color: var(--color-text); }
.learning-list { list-style: none; padding: 0; margin: var(--space-lg) 0 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
.learning-list li { padding: 0.9rem 1rem; border: 1px solid var(--color-border); border-radius: 6px; background: #fff; font-size: var(--fs-small); font-weight: 600; color: var(--color-text); }
.hero--unified { padding: var(--space-2xl) 0; background: #fff; color: var(--color-text); overflow: hidden; }
.hero-grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 3rem; align-items: center; }
.hero--unified .hero-kicker { margin: 0 0 0.75rem; font-size: var(--fs-lead); font-weight: 600; letter-spacing: 0.04em; color: var(--color-navy) !important; opacity: 1; }
.hero--unified h1 { margin: 0 0 1rem; font-size: var(--fs-h1); font-weight: 700; line-height: 1.3; letter-spacing: -0.01em; color: var(--color-navy); }
.hero--unified .hero-lead { margin: 0 0 1.75rem; font-size: var(--fs-lead); line-height: 1.85; color: var(--color-text-muted); }
.hero--unified .hero-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
.hero--unified .hero-actions .btn--cta { padding: 0.95rem 1.6rem; font-size: var(--fs-body); }
.btn--outline-light { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.7); border-radius: 4px; }
.btn--outline-light:hover { background: rgba(255,255,255,0.08); color: #fff; }
.hero--unified .hero-download { margin: 1rem 0 0; font-size: var(--fs-body); }
.hero--unified .hero-download a { color: var(--color-primary); text-decoration: underline; text-underline-offset: 3px; }
.hero--unified .hero-proof { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem; margin: 0.9rem 0 0; font-size: var(--fs-small); color: var(--color-text-muted); }
.hero--unified .hero-proof strong { font-size: var(--fs-body); font-weight: 600; color: var(--color-navy); }
.hero--unified .hero-proof__sep { color: #CBD5E1; }
.hero-shots { position: relative; padding-bottom: 18%; }
.hero-shot { margin: 0; }
.hero-shot img { display: block; width: 100%; height: auto; border-radius: 8px; box-shadow: 0 16px 40px rgba(15,23,42,0.14); border: 1px solid #E2E8F0; }
.hero-shot figcaption { margin-top: 0.4rem; font-size: var(--fs-small); color: var(--color-text-muted); }
.hero-shot--b2b { width: 88%; margin-left: auto; display: flex; flex-direction: column-reverse; }
.hero-shot--b2b figcaption { margin: 0 0 0.4rem; text-align: right; }
.hero-shot--school { position: absolute; left: 0; bottom: 0; width: 56%; }
.hero-shot--school img { border: 1px solid #E2E8F0; }
.hero-shot--mobile { position: absolute; right: 2%; bottom: -4%; width: 20%; }
.hero-shot--mobile img { border-radius: 18px; border: 4px solid #1E293B; box-shadow: 0 20px 40px rgba(15,23,42,0.2); }
.hero-shot--mobile figcaption { text-align: center; white-space: nowrap; }
.edition-strip { padding: var(--space-lg) 0; background: #F1F5F9; }
.edition-strip { padding: var(--space-xl) 0; }
.edition-strip .section-head { max-width: none; }
.edition-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(6, 1fr); gap: 1rem; }
.edition-list > li { grid-column: span 2; }
.edition-list > li:nth-child(n+4) { grid-column: span 3; }
.edition-list > li:nth-child(n+4) .edition-card__text { min-height: 0; }
.edition-card { display: flex; flex-direction: column; gap: 0.6rem; height: 100%; padding: 1.5rem 1.35rem; background: #fff; border: 1px solid var(--color-border); border-radius: 6px; box-shadow: 0 1px 3px rgba(15,23,42,0.06); color: var(--color-text); text-decoration: none; transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s; }
.edition-card:hover { border-color: var(--color-primary); box-shadow: 0 6px 18px rgba(15,23,42,0.10); transform: translateY(-2px); color: var(--color-text); }
.edition-card__who { font-size: var(--fs-lead); font-weight: 700; line-height: 1.45; color: var(--color-navy); }
.edition-card__tag { display: inline-block; margin-left: 0.5rem; padding: 0.1rem 0.5rem; vertical-align: 0.15em; font-size: var(--fs-small); font-weight: 600; color: var(--color-navy); background: #F1F5F9; border-radius: 4px; }
.edition-card__text { flex: 1; min-height: 3.5em; font-size: var(--fs-body); line-height: 1.75; color: var(--color-text-muted); }
.edition-card__go { display: block; margin-top: 0.4rem; padding: 0.65rem 1rem; text-align: center; font-size: var(--fs-body); font-weight: 700; color: var(--color-primary); background: #fff; border: 1px solid var(--color-primary); border-radius: 4px; transition: background 0.15s, color 0.15s; }
.edition-card:hover .edition-card__go { background: var(--color-primary); color: #fff; }

@media (max-width: 760px) { .edition-list { grid-template-columns: 1fr; } .edition-list > li, .edition-list > li:nth-child(n+4) { grid-column: auto; } }
.features { padding: var(--space-2xl) 0; background: #fff; }
.pricing-band { padding: 0 0 var(--space-2xl); background: #fff; }
.feature-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
.feature-card { padding: 1.5rem 1.35rem; background: #fff; border: 1px solid var(--color-border); border-radius: 6px; box-shadow: 0 1px 3px rgba(15,23,42,0.06); }
.feature-card__num { display: block; font-size: var(--fs-small); font-weight: 700; letter-spacing: 0.08em; color: var(--color-navy); }
.feature-card h3 { margin: 0.5rem 0 0.75rem; font-size: var(--fs-lead); line-height: 1.5; color: var(--color-navy); }
.feature-card p { margin: 0; font-size: var(--fs-body); line-height: 1.8; color: var(--color-text-muted); }
@media (max-width: 1024px) { .feature-list { grid-template-columns: 1fr 1fr; } }
@media (max-width: 860px) {
	.hero-grid { grid-template-columns: 1fr; gap: 2rem; }
	.hero-shots { padding-bottom: 24%; }
}
@media (max-width: 640px) {
	.hero--unified { padding: var(--space-xl) 0; }
	.hero--unified .hero-actions { flex-direction: column; }
	.feature-list { grid-template-columns: 1fr; }
}
.track { background: #F1F5F9; }
.track-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
.track-item { display: block; }
.track-who { display: grid; gap: 0.25rem; height: 100%; padding: 1.25rem 1.35rem; border: 1px solid var(--color-border);  border-radius: 6px; background: #fff; color: var(--color-text); text-decoration: none; transition: border-color 0.15s, transform 0.15s; }
.track-who:hover { border-color: #c7b2e3; transform: translateY(-2px); color: var(--color-text); }
.track-noun { font-size: var(--fs-small); letter-spacing: 0.1em; color: var(--color-text-muted); }
.track-title { font-size: var(--fs-h3); font-weight: 700; }
.track-size { margin-top: 0.4rem; font-size: var(--fs-small); font-weight: 600; color: var(--color-navy); }
.demo-media { margin: var(--space-lg) 0 0; }
.demo-media img { display: block; width: 100%; max-width: 820px; height: auto; border: 1px solid var(--color-border); border-top: 10px solid #E2E8F0; border-radius: 8px; background: #fff; box-shadow: 0 20px 50px rgba(15,23,42,0.12); }
.demo-media figcaption { margin-top: 0.75rem; font-size: var(--fs-small); color: var(--color-text-muted); }
.track-founder { margin-top: var(--space-lg); max-width: 52rem; line-height: 1.9; padding: 1.25rem 1.5rem; background: #fff; border-left: 3px solid var(--color-border-strong); border-radius: 0 6px 6px 0; }
.track-founder p { margin: 0; font-size: var(--fs-small); color: var(--color-text-muted); }
.track-founder strong { display: block; font-weight: 600; color: var(--color-text); font-size: var(--fs-lead); margin-bottom: 0.25rem; }
.supported-tools { margin: var(--space-lg) 0 0; font-size: var(--fs-small); line-height: 1.9; color: var(--color-text-muted); }
.supported-tools span { display: block; font-size: var(--fs-small); letter-spacing: 0.1em; margin-bottom: 0.25rem; }

/* ── Mobile（紺のパネルに端末） ── */
.mobile { background: var(--color-bg); }
.mobile-inner { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 3rem; align-items: center; }
.mobile-shots { display: flex; gap: 1.25rem; justify-content: center; padding: 2.5rem 1.5rem; background: radial-gradient(400px 260px at 30% 20%, rgba(135,88,201,0.35), transparent 60%), #0F172A; border-radius: 10px; }
.mobile-shots img { width: 44%; max-width: 210px; height: auto; border-radius: 14px; border: 3px solid #1E293B; background: #fff; box-shadow: 0 20px 40px rgba(0,0,0,0.35); }
.mobile-shots img:last-child { transform: translateY(1.5rem); }

/* ── Row list（支援・安心・スマホの項目） ── */
.row-list { margin: 0; border-top: 1px solid var(--color-border); }
.row-list > div { display: grid; grid-template-columns: 11rem 1fr; gap: 0.25rem 1.5rem; padding-block: 0.9rem; border-bottom: 1px solid var(--color-border); }
.row-list dt { margin: 0; font-size: var(--fs-small); font-weight: 500; color: var(--color-text); }
.row-list dt span { display: block; margin-top: 0.15rem; font-size: var(--fs-small); font-weight: 700; color: var(--color-navy); }
.row-list dd { margin: 0; font-size: var(--fs-small); line-height: 1.8; color: var(--color-text-muted); }
.row-list__foot { margin: 1rem 0 0; font-size: var(--fs-small); line-height: 1.8; color: var(--color-text-muted); }
.row-list__foot a { margin-left: 0.5rem; font-weight: 600; }
.two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; align-items: start; }
.two-col > div { padding: 2rem; background: #fff; border-radius: 6px; border: 1px solid var(--color-border); }
.two-col .sub-head { margin-bottom: var(--space-md); }
/* 直前の LANGUAGES（CrmLanguages）がグレーの帯なので、SUPPORT は白の帯にして交互を保つ。カードは枠線で区切る（After と同じ組み方）。 */
section#support { background: #fff; }

/* ── FAQ ── */
.faq { background: #fff; border-top: 1px solid var(--color-border); }
.faq-list { margin: 0; max-width: 52rem; border-top: 1px solid var(--color-border); }
.faq-item { padding-block: 1.25rem; border-bottom: 1px solid var(--color-border); }
.faq-item dt { margin: 0 0 0.4rem; font-size: var(--fs-body); font-weight: 500; color: var(--color-text); }
.faq-item dd { margin: 0; font-size: var(--fs-small); line-height: 1.85; color: var(--color-text-muted); }
.faq-more { margin: var(--space-lg) 0 0; }
.readings { margin: var(--space-lg) 0 0; padding-top: 1.25rem; border-top: 1px solid var(--color-border); font-size: var(--fs-body); line-height: 2; color: var(--color-text-muted); display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
.readings span { display: block; width: 100%; font-size: var(--fs-small); letter-spacing: 0.1em; }
.readings a { white-space: normal; overflow-wrap: anywhere; }

/* ── Final CTA ── */
.final-cta { background: #0F172A; color: #fff; }
.cta-inner { max-width: 56rem; }
.cta-eyebrow { display: block; font-size: var(--fs-small); font-weight: 500; color: rgba(255,255,255,0.92); letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 1.25rem; border-top: 1px solid rgba(255,255,255,0.15); padding-top: 0.875rem; }
.cta-copy h2 { font-size: var(--fs-h1); line-height: 1.2; color: #fff; margin: 0 0 1.25rem; }
.cta-lead { color: rgba(255,255,255,0.92); font-size: var(--fs-body); line-height: 1.8; margin: 0 0 1rem; }
.cta-lead a { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
