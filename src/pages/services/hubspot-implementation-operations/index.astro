/* Mockup */
.deliverables-mockup { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 2rem; }
.doc-mock { background: #fff; border: 1px solid var(--color-border); border-radius: 8px; overflow: hidden; box-shadow: var(--shadow-sm); }
.doc-mock__header { background: var(--color-bg-subtle); border-bottom: 1px solid var(--color-border); padding: 0.75rem 1rem; display: flex; flex-direction: column; gap: 0.25rem; }
.doc-mock__logo-bar { width: 3rem; height: 4px; background: var(--color-navy); border-radius: 2px; margin-bottom: 0.375rem; }
.doc-mock__label { font-size: 0.6875rem; font-weight: 700; color: var(--color-navy); font-family: var(--font-sans); letter-spacing: 0.06em; text-transform: uppercase; }
.doc-mock__subtitle { font-size: 0.625rem; color: var(--color-text-subtle); font-family: var(--font-sans); }
.doc-mock__body { padding: 1rem; }
.doc-mock__section-title { height: 6px; background: var(--color-border); border-radius: 3px; width: 40%; margin-bottom: 0.75rem; }
.doc-mock__table { display: flex; flex-direction: column; gap: 1px; }
.doc-mock__row { display: grid; grid-template-columns: 1.5fr 2fr; gap: 1px; }
.doc-mock__row--head .doc-mock__cell { background: var(--color-border); }
.doc-mock__cell { height: 14px; background: var(--color-bg-subtle); border-radius: 2px; }

/* Workflow mockup */
.wf-mock { display: flex; flex-direction: column; align-items: center; gap: 0; }
.wf-trigger {
	font-size: 0.625rem; font-weight: 700; font-family: var(--font-sans);
	background: rgba(15, 23, 42, .1); border: 1px solid rgba(112,66,172,.3);
	color: var(--color-navy); padding: 4px 12px; border-radius: 4px;
}
.wf-arrow-v { width: 1px; height: 14px; background: var(--color-border-strong); }
.wf-arrow-v--sm { height: 10px; }
.wf-row { display: flex; justify-content: center; }
.wf-action {
	font-size: 0.625rem; font-weight: 600; font-family: var(--font-sans);
	background: var(--color-bg-subtle); border: 1px solid var(--color-border);
	color: var(--color-text-muted); padding: 4px 10px; border-radius: 4px;
}
.wf-action--sm { font-size: 0.5625rem; }
.wf-action--accent { background: #f0fdf4; border-color: #86efac; color: #166534; }
.wf-branches { display: flex; gap: 1rem; }
.wf-branch { display: flex; flex-direction: column; align-items: center; gap: 0; }

/* ── Why Us ──────────────────────────────────────────── */
.why-us { background: var(--color-bg-subtle); padding: 5rem 0; }
.why-us-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
.why-card { background: #fff; border: 1px solid var(--color-border); border-radius: 8px; padding: 1.75rem; }
.why-card h3 { font-size: 1.0625rem; color: var(--color-text); margin-bottom: 0.75rem; font-family: var(--font-serif); }
.why-card p { font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.8; margin-bottom: 1rem; }
.why-card__notes { display: flex; flex-direction: column; gap: 0.25rem; }
.why-card__notes span { font-size: 0.75rem; font-weight: 600; color: var(--color-navy); font-family: var(--font-sans); }
.why-card__notes span::before { content: '✓ '; }

/* ── Cases ──────────────────────────────────────────── */
.cases { background: #fff; padding: 5rem 0; }
.cases-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2.5rem; }
.case-card { background: var(--color-bg-subtle); border: 1px solid var(--color-border); border-radius: 8px; padding: 1.75rem; display: flex; flex-direction: column; gap: 1rem; transition: box-shadow 0.2s; }
.case-card:hover { box-shadow: var(--shadow-sm); border-color: var(--color-primary); }
.case-card__meta { display: flex; align-items: center; gap: 0.625rem; flex-wrap: wrap; }
.case-tag { font-size: 0.75rem; font-weight: 600; color: var(--color-navy); background: rgba(15, 23, 42, .07); padding: 0.2rem 0.6rem; border-radius: 4px; font-family: var(--font-sans); }
.case-size { font-size: 0.75rem; color: var(--color-text-muted); font-family: var(--font-sans); }
.case-card__title { font-size: 0.9375rem; font-weight: 700; color: var(--color-text); line-height: 1.55; margin: 0; font-family: var(--font-serif); }
.case-card__body { font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.75; margin: 0; flex: 1; }
.case-card__footer { display: flex; flex-direction: column; gap: 0.75rem; margin-top: auto; }
.case-tools { display: flex; flex-wrap: wrap; gap: 0.375rem; }
.case-tools span { font-size: 0.7rem; color: var(--color-text-muted); background: #fff; border: 1px solid var(--color-border); padding: 0.15rem 0.5rem; border-radius: 4px; font-family: var(--font-sans); }
.case-link { font-size: 0.8125rem; font-weight: 600; color: var(--color-primary); text-decoration: none; font-family: var(--font-sans); }
.case-link:hover { text-decoration: underline; }
.cases-cta { text-align: center; }

/* ── Fit ──────────────────────────────────────────── */
.fit { background: var(--color-bg-subtle); padding: 5rem 0; }
.fit-inner { max-width: 680px; }
.fit-list { list-style: none; }
.fit-list li { font-size: 0.9375rem; color: var(--color-text-muted); padding: 0.875rem 0; border-bottom: 1px solid var(--color-border); display: flex; gap: 0.875rem; font-family: var(--font-sans); line-height: 1.6; }
.fit-list li:last-child { border-bottom: none; }
.fit-list li::before { content: ''; display: block; width: 6px; height: 6px; background: var(--color-navy); border-radius: 50%; flex-shrink: 0; margin-top: 0.45rem; }

/* ── Approach ──────────────────────────────────────────── */
.approach { background: #fff; padding: 5rem 0; }
.approach-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
.approach-copy h2 { font-size: 1.625rem; color: var(--color-text); margin-bottom: 1.25rem; }
.approach-copy p { font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.85; margin-bottom: 1rem; }
.approach-copy .btn { margin-top: 1rem; }
.checklist-label { font-size: 0.8125rem; font-weight: 700; color: var(--color-text); margin-bottom: 1rem; font-family: var(--font-sans); }
.approach-checklist ul { list-style: none; }
.approach-checklist li { font-size: 0.9375rem; color: var(--color-text-muted); padding: 0.75rem 0; border-bottom: 1px solid var(--color-border); display: flex; gap: 0.875rem; font-family: var(--font-sans); line-height: 1.6; }
.approach-checklist li:last-child { border-bottom: none; }
.approach-checklist li::before { content: '✓'; color: var(--color-navy); font-weight: 700; flex-shrink: 0; font-size: 0.875rem; }

/* ── Pricing ──────────────────────────────────────────── */
.pricing { background: var(--color-bg-subtle); padding: 5rem 0; }
.pricing-pretext { font-size: 0.9375rem; color: var(--color-text-muted); line-height: 1.9; margin-bottom: 2.5rem; font-family: var(--font-sans); }
.pricing-phases { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
.pricing-phase {
	background: #fff; border: 1px solid var(--color-border); border-radius: 8px; overflow: hidden;
}
.pricing-phase--featured { border-color: var(--color-navy); }
.pricing-phase__header { padding: 2rem; border-bottom: 1px solid var(--color-border); }
.pricing-phase--featured .pricing-phase__header { background: rgba(15, 23, 42, .03); border-color: rgba(112,66,172,.15); }
.pricing-phase__label { font-size: 0.6875rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-navy); font-family: var(--font-sans); margin-bottom: 0.375rem; }
.pricing-phase__name { font-size: 0.9375rem; font-weight: 700; color: var(--color-text); font-family: var(--font-sans); margin-bottom: 0.75rem; line-height: 1.4; }
.pricing-phase__amount { font-size: 2rem; font-weight: 900; color: var(--color-text); font-family: var(--font-serif); }
.pricing-phase__items { list-style: none; padding: 1.5rem; display: flex; flex-direction: column; gap: 0.75rem; }
.pricing-phase__items li { font-size: 0.875rem; color: var(--color-text-muted); font-family: var(--font-sans); display: flex; gap: 0.625rem; align-items: flex-start; }
.pricing-phase__items li::before { content: '-'; color: var(--color-navy); flex-shrink: 0; font-weight: 700; }
.pricing-note-full { font-size: 0.8125rem; color: var(--color-text-subtle); margin-bottom: 2rem; font-family: var(--font-sans); }
.pricing-cta { display: flex; gap: 1rem; flex-wrap: wrap; }

/* ── Related ──────────────────────────────────────────── */
.related { background: #fff; padding: 5rem 0; }
.related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
.related-card { background: var(--color-bg-subtle); border: 1px solid var(--color-border); border-radius: 8px; padding: 1.25rem; text-decoration: none; display: block; transition: all 0.2s; }
.related-card:hover { box-shadow: var(--shadow-sm); border-color: var(--color-primary); }
.related-card__num { font-size: 0.6875rem; font-weight: 700; color: var(--color-navy); font-family: var(--font-sans); margin-bottom: 0.5rem; }
.related-card h3 { font-size: 0.9375rem; font-weight: 700; color: var(--color-text); margin: 0 0 0.375rem; line-height: 1.45; font-family: var(--font-serif); }
.related-card p { font-size: 0.8125rem; color: var(--color-text-muted); margin: 0; }

/* ── FAQ ──────────────────────────────────────────── */
.faq { background: var(--color-bg-subtle); padding: 5rem 0; }
.faq-list { max-width: 720px; }
.faq-item { border-bottom: 1px solid var(--color-border); }
.faq-item:first-of-type { border-top: 1px solid var(--color-border); }
.faq-q { font-size: 0.9375rem; font-weight: 700; color: var(--color-text); font-family: var(--font-sans); padding: 1.25rem 0; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
.faq-q::after { content: '+'; font-size: 1.25rem; color: var(--color-navy); flex-shrink: 0; }
details[open] .faq-q::after { content: '−'; }
.faq-a { padding: 0 0 1.25rem; }
.faq-a p { font-size: 0.875rem; color: var(--color-text-muted); line-height: 1.85; margin: 0; }

/* ── Final CTA ──────────────────────────────────────────── */
.cta-final {
	background:
		radial-gradient(800px 360px at 85% -5%, rgba(124,92,191,0.35), transparent 55%),
		linear-gradient(135deg, #1e40af 0%, #1d4ed8 100%);
	padding: 5rem 0;
}
.cta-inner { display: grid; grid-template-columns: 1fr auto; gap: 3rem; align-items: center; }
.cta-copy h2 { font-size: 2rem; color: #fff; margin-bottom: 1rem; line-height: 1.4; }
.cta-copy p { font-size: 0.9375rem; color: rgba(255,255,255,.8); line-height: 1.85; margin: 0; }
.cta-actions { display: flex; flex-direction: column; gap: 0.875rem; }

/* ── Responsive ──────────────────────────────────────── */
@media (max-width: 1024px) {
	.symptoms-grid { grid-template-columns: repeat(3, 1fr); }
	.problems-grid { grid-template-columns: repeat(3, 1fr); }
	.scope-grid { grid-template-columns: repeat(3, 1fr); }
	.cases-grid { grid-template-columns: 1fr; }
	.related-grid { grid-template-columns: repeat(2, 1fr); }
	.deliverables-layout { grid-template-columns: 1fr; }
	.deliverables-mockup { flex-direction: row; position: static; }
	.process-flow { flex-direction: column; gap: 0.5rem; }
	.pstep-arrow { transform: rotate(90deg); margin: 0 auto; }
}
@media (max-width: 860px) {
	.hero h1 { font-size: 1.875rem; }
	.symptoms-grid { grid-template-columns: repeat(2, 1fr); }
	.cause-grid { grid-template-columns: 1fr; }
	.problems-grid { grid-template-columns: repeat(2, 1fr); }
	.why-us-grid { grid-template-columns: 1fr; }
	.ba-diagram { grid-template-columns: 1fr; }
	.ba-arrow { flex-direction: row; justify-content: center; }
	.ba-arrow__label { writing-mode: horizontal-tb; }
	.approach-inner { grid-template-columns: 1fr; gap: 2rem; }
	.pricing-phases { grid-template-columns: 1fr; }
	.cta-inner { grid-template-columns: 1fr; gap: 2rem; }
	.scope-grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 560px) {
	.hero h1 { font-size: 1.625rem; }
	.hero-cta { flex-direction: column; align-items: flex-start; }
	.symptoms-grid { grid-template-columns: repeat(2, 1fr); }
	.problems-grid { grid-template-columns: 1fr; }
	.scope-grid { grid-template-columns: 1fr; }
	.related-grid { grid-template-columns: 1fr; }
	.deliverables-mockup { flex-direction: column; }
	.chaos-grid { grid-template-columns: 1fr; }
	.pricing-cta { flex-direction: column; }
}
	.hs-figure { margin: var(--space-lg) 0; }
	.hs-figure svg { display: block; width: 100%; height: auto; }
	.hs-figure figcaption { margin-top: 0.75rem; font-size: 0.875rem; color: var(--color-text-muted); }

/* Primary consultation actions follow the site's button palette. */
.btn--primary, .btn--white, .btn--cta, .btn--cta-primary { background: #8758C9; color: #fff; border-radius: 4px; }
.btn--primary:hover, .btn--white:hover, .btn--cta:hover, .btn--cta-primary:hover { background: #7042ac; color: #fff; }
</style>
</BaseLayout>
