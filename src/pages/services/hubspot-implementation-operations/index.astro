				<text x="686" y="72" font-size="14" fill="#64748b" letter-spacing="1">04 TRAIN</text>
				<text x="686" y="108" font-size="20" font-weight="600" fill="#0F172A">教育</text>
				<text x="686" y="142" font-size="16" fill="#475569">役割ごとの使い方を</text>
				<text x="686" y="168" font-size="16" fill="#475569">現場で覚えてもらう</text>
				<line x1="871" y1="115" x2="879" y2="115" stroke="#0F172A" stroke-width="2" marker-end="url(#hs-arr)"/>
				<rect x="880" y="40" width="200" height="150" rx="6" fill="#0F172A" stroke="#E2E8F0"/>

				<text x="896" y="72" font-size="14" fill="#CBD5E1" letter-spacing="1">05 OPERATE</text>
				<text x="896" y="108" font-size="20" font-weight="600" fill="#fff">運用</text>
				<text x="896" y="142" font-size="16" fill="#E2E8F0">定例で見直し、</text>
				<text x="896" y="168" font-size="16" fill="#E2E8F0">改善し続ける</text>
			</svg>
