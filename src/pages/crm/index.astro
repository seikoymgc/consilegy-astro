---
import { CRM_FEATURES, featureCount } from '../../data/crm-features';
import BaseLayout from '../../layouts/BaseLayout.astro';

const DEMO_URL = 'https://crm.consilegy.com/demos';

const featureGlyphs = {
	contacts: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="9" y="10" width="34" height="44" rx="3"></rect>
			<circle class="glyph-strong" cx="23" cy="25" r="6"></circle>
			<path class="glyph-line" d="M15 42c2.2-5.2 13.8-5.2 16 0"></path>
			<path class="glyph-line" d="M32 21h6M32 28h6M15 48h18"></path>
			<rect class="glyph-accent" x="38" y="18" width="17" height="23" rx="3"></rect>
			<path class="glyph-line" d="M42 27h9M42 33h6"></path>
		</svg>
	`,
	kanban: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="8" y="12" width="48" height="36" rx="3"></rect>
			<path class="glyph-line" d="M24 12v36M40 12v36"></path>
			<rect class="glyph-accent" x="13" y="19" width="8" height="8" rx="1.5"></rect>
			<rect class="glyph-strong-fill" x="29" y="25" width="7" height="11" rx="1.5"></rect>
			<rect class="glyph-accent" x="45" y="18" width="6" height="16" rx="1.5"></rect>
			<path class="glyph-strong" d="M13 55l10-8 8 4 10-11 10 5"></path>
		</svg>
	`,
	jade: `
		<svg viewBox="0 0 64 64" focusable="false">
			<path class="glyph-accent" d="M32 8l17 18-17 30-17-30L32 8Z"></path>
			<path class="glyph-line" d="M15 26h34M24 26l8 30 8-30M24 17h16"></path>
			<rect class="glyph-panel" x="10" y="40" width="27" height="14" rx="3"></rect>
			<path class="glyph-strong" d="M16 47h7M27 47h4"></path>
		</svg>
	`,
	workflow: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="8" y="12" width="18" height="14" rx="3"></rect>
			<rect class="glyph-panel" x="38" y="12" width="18" height="14" rx="3"></rect>
			<rect class="glyph-accent" x="23" y="39" width="18" height="14" rx="3"></rect>
			<path class="glyph-line" d="M26 19h12M17 26v8c0 3 2 5 5 5h10M47 26v8c0 3-2 5-5 5H32"></path>
			<path class="glyph-strong" d="M13 19h8M43 19h8M28 46h8"></path>
		</svg>
	`,
	mail: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="8" y="12" width="31" height="39" rx="3"></rect>
			<path class="glyph-line" d="M15 22h17M15 30h17M15 38h11"></path>
			<rect class="glyph-accent" x="32" y="24" width="24" height="17" rx="3"></rect>
			<path class="glyph-strong" d="M32 28l12 8 12-8"></path>
			<path class="glyph-line" d="M42 48h10"></path>
		</svg>
	`,
	language: `
		<svg viewBox="0 0 64 64" focusable="false">
			<rect class="glyph-panel" x="7" y="13" width="15" height="30" rx="3"></rect>
			<rect class="glyph-accent" x="24.5" y="18" width="15" height="30" rx="3"></rect>
			<rect class="glyph-panel" x="42" y="13" width="15" height="30" rx="3"></rect>
			<path class="glyph-line" d="M12 22h5M12 28h4M12 34h6M29.5 27h5M29.5 33h4M47 22h5M47 28h4M47 34h6"></path>
			<path class="glyph-strong" d="M19 51h26"></path>
			<path class="glyph-strong" d="M38 46l7 5-7 5"></path>
		</svg>
	`,
};

const proofStats = [
	{ figure: '40社以上', label: 'Consilegyが設計してきたB2Bの収益プロセス' },
	{ figure: '175本', label: '標準搭載のRevOpsワークフロー' },
	{ figure: '3言語', label: '日本語 / English / 繁體中文をUIごと切替' },
	{ figure: '掲載', label: 'See News（花蓮視新聞）2026年6月25日' },
];

const outcomes = [
	{
		problem: '顧客リストがExcelとメールに散らばっている',
		answer: '顧客、会社、商談、やりとりが1本の履歴に集まります。',
	},
	{
		problem: '案件の状況が担当者の頭の中にしかない',
		answer: 'ステージ、確度、次アクションをチーム全員が同じ画面で見られます。',
	},
	{
		problem: '来月いくら入るかを毎回手で集計している',
		answer: 'パイプラインから加重フォーキャストが自動で出ます。',
	},
	{
		problem: '受注した後のフォローと契約更新が後手に回る',
		answer: '更新期日と停滞をワークフローが検知して、担当者に通知します。',
	},
];

const aiMoves = [
	{
		act: '日本語で聞く',
		text: '顧客、商談、ファネルを検索して集計して返します。コンタクトとタスクの作成もその場で。⌘Jでどの画面からでも呼べます。',
	},
	{
		act: '名刺を撮る',
		text: '写真1枚から17項目を読み取ります。登録の前に必ず確認画面が入ります。',
	},
	{
		act: '会話を貼る',
		text: 'LINE、Slack、Chatworkのやりとりから、要約、次アクション、金額やステージの兆しを抜き出します。',
	},
	{
		act: '通話を残す',
		text: '文字起こしをMEDDPICC / BANT / CHAMP / SPINの型で構造化して、商談に書き戻します。',
	},
	{
		act: '手書きを写す',
		text: 'ホワイトボードや紙のメモを文字に起こし、タスクの候補まで出します。採用するかは人が選びます。',
	},
	{
		act: '直すほど合ってくる',
		text: '一度直せば、その判断が残ります。次に同じことを聞かれたときは、そちらを材料にします。ICPの判定から始めています。',
	},
];

const safeguards = [
	{
		label: '学習に使われない',
		text: '名刺や手書きの読み取り、文字起こしに使う外部AIは、送信した内容を学習に使わない条件で利用しています。自社のAPIキーを持ち込んで、送信先を自社契約にすることもできます。',
	},
	{
		label: '他社に見えない',
		text: '会社ごとの隔離は、データベースの行単位のアクセス制御で行っています。アプリ側の絞り込みには頼りません。新しいテーブルへの入れ忘れは、リリース前の自動チェックで止めます。',
	},
	{
		label: '見せる範囲を決められる',
		text: '役割ごとに、誰がどのデータを見て操作できるかを設定できます。誰がいつ何を変更したかは監査ログに残ります。',
	},
	{
		label: '消しても戻せる',
		text: '削除したレコードはゴミ箱に入り、そこから戻せます。データベースは日次でバックアップを取得しています。',
	},
	{
		label: '東京に置いてある',
		text: 'データは東京リージョンに保存しています。海外に出ることはありません。',
	},
	{
		label: '持ち出しは自由',
		text: 'コンタクト、会社、商談をCSVで書き出せます。解約後に取り出せなくなることはありません。自社のデータは自社のものです。',
	},
];

const capabilities = [
	{
		icon: 'contacts',
		title: '顧客の履歴が、担当者から独立する',
		text: 'コンタクト、会社、商談、活動履歴、メモをひとつの画面に集約。担当が変わっても文脈が残ります。',
	},
	{
		icon: 'kanban',
		title: '売上見込みを、集計しないで確認する',
		text: '商談カンバンで進捗と確度を更新すると、パイプライン総額と加重フォーキャストがそのまま更新されます。',
	},
	{
		icon: 'jade',
		title: '入力ではなく、質問で使う',
		text: 'AIエージェントJadeに日本語で聞くと、検索、集計、要約、分類、次アクションの提案まで返します。',
	},
	{
		icon: 'workflow',
		title: '抜け漏れを、人の記憶で防がない',
		text: '通知、タスク、フォロー、更新商談の作成を自動化。175本のワークフローから必要なものをONにするだけです。',
	},
	{
		icon: 'mail',
		title: 'リード獲得から追客までを、同じ場所で',
		text: 'フォーム、メール配信、リスト、シーケンスを標準搭載。別のMAツールを足す必要がありません。',
	},
	{
		icon: 'language',
		title: '海外メンバーと、同じデータを別の言語で',
		text: '日本語、English、繁體中文をボタンひとつで切替。同じレコードを、それぞれの言語で扱えます。',
	},
];

const screens = [
	{
		src: '/images/crm/screen-dashboard.webp',
		alt: 'Revenue CRMのダッシュボード。パイプライン総額、加重フォーキャスト、勝率、期限切れタスク、ステージ別パイプライン、注目の商談を一画面に表示。',
		title: 'ダッシュボード',
		text: 'パイプライン総額、加重フォーキャスト、対応優先度を確認',
	},
	{
		src: '/images/crm/screen-deals.webp',
		alt: 'Revenue CRMの商談カンバン。アプローチ、ヒアリング、提案、見積のステージごとに商談カードと金額、確度、クローズ予定日を表示。',
		title: '商談カンバン',
		text: 'ステージ、確度、次アクションをドラッグ操作で更新',
	},
	{
		src: '/images/crm/screen-jade.webp',
		alt: 'AIエージェントJadeの画面。「今日やるべきことは？」と日本語で質問し、ファネルの集計と進行中の商談10件を表で返している。',
		title: 'AIエージェントJade',
		text: '日本語で質問し、集計・要約・提案まで実行',
	},
	{
		src: '/images/crm/screen-dashboard-en.webp',
		alt: 'Revenue CRMの英語UI。同じダッシュボードをEnglishに切り替えた画面。サイドバーにJA / EN / 繁中の切替ボタンがある。',
		title: '多言語UI',
		text: '日本語、English、繁體中文を画面ごと切り替え',
	},
];

const editions = [
	{
		noun: '商談',
		title: '法人営業',
		text: '見込み客を商談として管理。パイプライン、見積、フォーキャスト、停滞アラートに対応。',
	},
	{
		noun: '案件',
		title: '支援会社・受託開発',
		text: '見積、受注、納品、請求、保守更新までを案件単位で管理。',
	},
	{
		noun: '契約',
		title: 'SaaS代理店・リセラー',
		text: '契約更新、解約リスク、更新商談、クロスセル候補を追跡。',
	},
	{
		noun: '在籍',
		title: '教室・スクール',
		text: '生徒の在籍、継続、休会、退会を管理。スクール版として別ページで提供。',
		href: '/crm/school/',
	},
];

const faqs = [
	{
		q: 'いま使っているCRMからデータを移行できますか。',
		a: 'Revenue CRMは、まだCRMを持っていない会社のために作っています。Salesforce・HubSpot・kintoneなどがすでに動いている場合は、乗り換えではなく、そのツールを活かした収益プロセスの再設計をご提案します。',
	},
	{
		q: 'デモを見るのに登録は必要ですか。',
		a: 'メールアドレスのみです。パスワードの登録も、審査もありません。法人営業、支援会社・受託開発、SaaS代理店の3つから、近いものを選んでご覧いただけます。',
	},
	{
		q: '日本語以外でも使えますか。',
		a: '日本語、English、繁體中文をボタンひとつで切り替えられます。同じデータを、メンバーごとに別の言語で見られます。',
	},
	{
		q: '料金はいくらですか。',
		a: '1席あたり月額3,000円、10席目からは1席あたり月額2,500円です。クローズドβ期間中の条件は個別にご相談させてください。',
	},
];

const featureGroups = CRM_FEATURES.map((g) => ({ title: g.title.ja }));
---

<BaseLayout
	title="Revenue CRM法人向け（β版） | まだCRMがない会社のための、最初のCRM"
	description="顧客の一覧はExcel、やりとりはメール、案件の温度感は担当者の頭の中。そういう会社のために、Consilegyが自社で作った法人向けCRMです。AIエージェントJadeと175本のRevOpsワークフローを標準搭載。メールアドレスだけでデモをご覧いただけます。現在クローズドβ。"
	lang="ja"
	alternateUrl="/en/crm/"
>

<!-- ===================== 1. HERO ===================== -->
<section class="crm-hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<p class="eyebrow">Revenue CRM法人向けβ版</p>
			<h1>まだCRMがない会社のための、<br class="br-wide" />最初のCRMを作りました。</h1>
			<p class="hero-lead">
				顧客の一覧はExcel。やりとりはメール。案件の温度感は担当者の頭の中。
				そういう会社に40社以上入りました。そのたびに、ここに入れられるCRMがない。
				だから、自分たちで作りました。
			</p>
			<div class="hero-actions">
				<a href={DEMO_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">デモを見る</a>
				<a href="/contact/" class="btn btn--secondary">β参加を相談する</a>
			</div>
			<p class="hero-note">メールアドレスだけで実際の画面に入れます。パスワード登録も営業連絡もありません。</p>
		</div>
		<figure class="hero-media">
			<img
				src="/images/crm/screen-dashboard.webp"
				alt="Revenue CRMのダッシュボード。パイプライン総額、加重フォーキャスト、勝率、期限切れタスク、ステージ別パイプライン、注目の商談を一画面に表示。"
				width="1600"
				height="1000"
				decoding="async"
				fetchpriority="high"
			/>
			<figcaption>ダッシュボード：最初に見る数字と、次に動く相手を同じ画面で</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 2. PROOF ===================== -->
<section class="proof">
	<div class="container">
		<ul class="proof-grid">
			{proofStats.map((item) => (
				<li>
					<strong>{item.figure}</strong>
					<span>{item.label}</span>
				</li>
			))}
		</ul>
		<p class="proof-note">
			※「40社以上」は、Consilegy合同会社がマーケティング・営業・カスタマーサクセス領域で設計支援を行った累計社数です。
			Revenue CRMはクローズドβのため、導入社数は公開していません。
		</p>
	</div>
</section>

<!-- ===================== 3. PROBLEM → OUTCOME ===================== -->
<section class="outcomes">
	<div class="container">
		<div class="section-head">
			<p class="kicker">導入して変わること</p>
			<h2>いまExcelでやっていることが、そのままチームの記録になる。</h2>
		</div>
		<ul class="outcome-grid">
			{outcomes.map((item) => (
				<li class="outcome-card">
					<p class="outcome-problem">{item.problem}</p>
					<p class="outcome-answer">{item.answer}</p>
				</li>
			))}
		</ul>
	</div>
</section>

<!-- ===================== 3b. AI ===================== -->
<section class="ai" id="ai">
	<div class="container">
		<div class="section-head">
			<p class="kicker">AI / Jade</p>
			<h2>入力するCRMではなく、聞いて、撮って、貼るCRM。</h2>
		</div>
		<p class="ai-lead">
			CRMが続かない一番の理由は、入力が仕事の後回しになることです。
			だから入力を減らしました。JadeというAIが中に入っていて、日本語で聞けば探して数えて返します。
			名刺は撮る、会話は貼る、通話は話すだけで記録になります。
		</p>
		<ul class="ai-grid">
			{aiMoves.map((item) => (
				<li class="ai-card">
					<span class="ai-act">{item.act}</span>
					<p>{item.text}</p>
				</li>
			))}
		</ul>
		<p class="ai-note">
			AIが作った文面やデータは、保存と送信の前に必ず人が確認します。勝手に送ることはありません。
			AIのAPIキーは自社のもの（Anthropic / OpenAI / Gemini / Azure OpenAI）を持ち込めます。
			外部のAIからCRMを操作するためのMCPサーバーも標準で用意しています。
		</p>
	</div>
</section>

<!-- ===================== 3c. SECURITY ===================== -->
<section class="safeguards">
	<div class="container">
		<div class="section-head">
			<p class="kicker">データの扱い</p>
			<h2>AIに読ませても、データは自社のものから出ません。</h2>
		</div>
		<dl class="safe-list">
			{safeguards.map((item) => (
				<div class="safe-row">
					<dt>{item.label}</dt>
					<dd>{item.text}</dd>
				</div>
			))}
		</dl>
		<p class="safe-note">
			詳しくは<a href="/crm/faq/">よくあるご質問</a>のデータとセキュリティをご覧ください。
			2要素認証とシングルサインオンは、現時点では提供していません。
		</p>
	</div>
</section>

<!-- ===================== 4. PRODUCT VIEW ===================== -->
<section class="product-view">
	<div class="container">
		<div class="section-head">
			<p class="kicker">画面イメージ</p>
			<h2>最初に見る数字と、次に動く相手を同じ画面で確認。</h2>
		</div>
		<ul class="view-grid">
			{screens.map((item) => (
				<li class="view-card">
					<figure>
						<img
							src={item.src}
							alt={item.alt}
							width="1600"
							height="1000"
							loading="lazy"
							decoding="async"
						/>
					</figure>
					<div class="view-caption">
						<strong>{item.title}</strong>
						<span>{item.text}</span>
					</div>
				</li>
			))}
		</ul>

		<figure class="view-demo">
			<img
				src="/videos/revenue-crm-demo.gif"
				alt="Revenue CRMの操作デモ。ダッシュボード、商談カンバン、自動化ライブラリ、AIエージェントJade・3言語切替を順に操作している。"
				width="800"
				height="585"
				loading="lazy"
				decoding="async"
			/>
			<figcaption>操作デモ：ダッシュボード → 商談カンバン → 自動化ライブラリ → Jade → 言語切替</figcaption>
		</figure>
	</div>
</section>

<!-- ===================== 5. CAPABILITIES ===================== -->
<section class="features" id="features">
	<div class="container">
		<div class="section-head">
			<p class="kicker">できること</p>
			<h2>営業・マーケ・CSの情報を、1つの収益基盤に。</h2>
		</div>
		<div class="feature-grid">
			{capabilities.map((item) => (
				<article class="feature-card">
					<span class="feature-glyph" aria-hidden="true">
						<Fragment set:html={featureGlyphs[item.icon]} />
					</span>
					<div>
						<h3>{item.title}</h3>
						<p>{item.text}</p>
					</div>
				</article>
			))}
		</div>
		<div class="feature-more">
			<p class="feature-more-note">{featureGroups.map((group) => group.title).join(' / ')}</p>
			<a class="feature-more-link" href="/crm/features/">機能一覧をすべて見る（全{featureCount()}項目）</a>
		</div>
	</div>
</section>

<!-- ===================== 6. EDITIONS ===================== -->
<section class="editions">
	<div class="container">
		<div class="section-head">
			<p class="kicker">事業タイプ別</p>
			<h2>商売の形に合わせて、最初から設定済み。</h2>
		</div>
		<div class="edition-grid">
			{editions.map((item) => (
				<article class:list={['edition-card', item.href && 'edition-card--muted']}>
					<span class="edition-noun">{item.noun}</span>
					<h3>{item.title}</h3>
					<p>{item.text}</p>
					{item.href && <a href={item.href}>スクール版を見る</a>}
				</article>
			))}
		</div>
	</div>
</section>

<!-- ===================== 7. PRICING ===================== -->
<section class="pricing">
	<div class="container">
		<div class="section-head">
			<p class="kicker">料金</p>
