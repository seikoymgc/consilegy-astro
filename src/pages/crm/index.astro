		gap: 1px;
		margin: 1.35rem 0 0;
		padding: 0;
		list-style: none;
		background: var(--color-border);
		border: 1px solid var(--color-border);
	}

	.hero-link-grid li {
		min-width: 0;
		background: #fff;
	}

	.hero-link-grid a {
		display: grid;
		gap: 0.25rem;
		min-height: 5.25rem;
		padding: 1rem;
		color: var(--color-text);
		text-decoration: none;
	}

	.hero-link-grid a:hover {
		color: var(--color-primary);
		background: #f8fafc;
	}

	.hero-link-grid strong {
		font-size: 0.95rem;
		line-height: 1.45;
	}

	.hero-link-grid span {
		color: var(--color-text-muted);
		font-size: 0.78rem;
